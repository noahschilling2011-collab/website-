{
  "name": "terminassistent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:push": "drizzle-kit push",
    "seed": "tsx scripts/seed.ts",
    "tick": "tsx scripts/tick.ts",
    "db:sql": "tsx scripts/schema-sql.ts",
    "db:generate": "drizzle-kit generate && tsx scripts/schema-sql.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electric-sql/pglite": "^0.5.4",
    "drizzle-orm": "^0.45.2",
    "ical-generator": "^11.1.0",
    "next": "^16.3.0",
    "node-ical": "^0.27.1",
    "postal-mime": "^2.7.5",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3"
  }
