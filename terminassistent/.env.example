# Kopieren nach .env.local. Ohne diese Datei laeuft die App im Demo-Modus:
# eingebettete Datenbank, keine Modellaufrufe, keine echten Mails.

# --- Pflicht, sobald es echt wird ------------------------------------------

# Beliebige lange Zufallszeichenkette. Verschluesselt Zugangsdaten in der
# Datenbank und signiert das Sitzungs-Cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# Domain der Weiterleitungsadressen: <handle>@<MAIL_DOMAIN>
MAIL_DOMAIN=assistent.example
MAIL_ABSENDER="Assistenz <assistenz@assistent.example>"
APP_URL=https://assistent.example

# --- Datenbank --------------------------------------------------------------
# Ohne DATABASE_URL nutzt die App PGlite in .pglite/ — gut fuer die
# Entwicklung, ungeeignet fuer den Betrieb.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Modell -----------------------------------------------------------------
# Ohne Schluessel werden Texte regelbasiert erzeugt und jede Analyse
# bekommt "vertrauen: niedrig", damit nichts ungeprueft passiert.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Mailversand ------------------------------------------------------------
# Ohne Schluessel landen Mails auf der Konsole statt im Netz.
# Resend Pro, 20 USD/Monat. Der Free-Plan hat ein hartes Tageslimit von 100.
# RESEND_API_KEY=re_...

# --- Maileingang ------------------------------------------------------------
# Gemeinsames Geheimnis zwischen dem Cloudflare Email Worker und /api/mail/eingang.
# Dasselbe Geheimnis schuetzt /api/takt.
# MAIL_WEBHOOK_SECRET=

# --- Kalender ueber Google (Weg A) ------------------------------------------
# Scopes: calendar.freebusy (lesen) und calendar.events (schreiben).
# Publishing-Status "In production", ohne Verifizierungsantrag: dann laufen
# Tokens nicht nach 7 Tagen ab. Grenze: 100 Nutzer, projektgebunden und
# nicht ruecksetzbar. Entwicklung deshalb in einem SEPARATEN Projekt.
# Rueckleitung im OAuth-Client eintragen: <APP_URL>/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Bezahlung --------------------------------------------------------------
# ACHTUNG: dieser Teil ist als einziger im Projekt nie gegen echte
# Stripe-Endpunkte gelaufen. Vor dem ersten Einsatz im Testmodus durchspielen.
# Ohne diese beiden Werte laeuft alles ausser der Freischaltung.
# Bewusst OHNE Webhook: freigeschaltet wird bei der Rueckkehr aus dem Checkout,
# durch eine Rueckfrage bei Stripe — nicht durch das, was in der URL steht.
# STRIPE_SECRET_KEY=
# STRIPE_PREIS_ID=

# --- Stellschrauben ---------------------------------------------------------
# HALTEZEIT_SEKUNDEN=60
# TERMIN_DAUER_MINUTEN=45
# PUFFER_MINUTEN=15
# NACHFASSEN_NACH_TAGEN=3
# MAX_ERINNERUNGEN=2
