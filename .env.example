# --- Frontend (öffentlich, landen im Browser-Bundle) ---
# Diese zwei kommen auch in die Netlify Environment Variables.
VITE_SUPABASE_URL=https://DEINPROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# --- NUR für lokale Scripts (seed.ts, rls-test.ts) ---
# NIEMALS in Netlify, NIEMALS ins Frontend, NIEMALS committen.
# Der service_role-Key umgeht RLS komplett — er darf den Server/dein Terminal nie verlassen.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key
