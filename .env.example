# Kopieren nach .env. Die .env ist in .gitignore und gehoert nie ins Repo.

# fake     = deterministische Antworten, kein Netz, keine Kosten. Voreinstellung.
# anthropic = echtes Modell. Kostet Geld.
JARVIS_PROVIDER=fake

# Nur noetig, wenn JARVIS_PROVIDER=anthropic.
# Key besorgen: console.anthropic.com
ANTHROPIC_API_KEY=

# Modell-ID. Preise je eine Million Token (Eingabe/Ausgabe):
#   claude-opus-5     5 $ / 25 $   - Voreinstellung
#   claude-sonnet-5   2 $ / 10 $
#   claude-haiku-4-5  1 $ /  5 $
JARVIS_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Hoeher = mehr Nachdenken, mehr Kosten.
JARVIS_EFFORT=high

# Obergrenze der Antwortlaenge.
JARVIS_MAX_TOKENS=16000

# Wie viele vorherige Nachrichten mitgeschickt werden.
# Ein echtes Gedaechtnis kommt in Phase 3.
JARVIS_HISTORY_LIMIT=40

# JARVIS_DB_PATH=data/jarvis.db
