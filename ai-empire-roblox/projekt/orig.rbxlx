	local bill=Instance.new("SurfaceGui");bill.Name="Sign";bill.Face=Enum.NormalId.Front;bill.CanvasSize=Vector2.new(1200,300);bill.MaxDistance=180;bill.LightInfluence=.4;bill.Parent=anchor
	local title=Instance.new("TextLabel");title.Name="Label";title.Size=UDim2.fromScale(1,1);title.BackgroundTransparency=1;title.TextScaled=true;title.TextColor3=paper;title.Font=Enum.Font.BuilderSansExtraBold;title.Parent=bill
 -- Timber sun screens, a stone entrance and a real facade sign establish one coherent material palette.
 for _,side in {-1,1} do for n=1,7 do add("TimberSunScreen",Vector3.new(.65,floors*16,1.3),side*(24+n*7),floors*8,-49.2,wood,Enum.Material.Wood) end end
 add("EntryStoneReveal",Vector3.new(2,14,3),-17,7,-48,stone,Enum.Material.Concrete);add("EntryStoneReveal",Vector3.new(2,14,3),17,7,-48,stone,Enum.Material.Concrete)
 Departments.build(office,cf,session,accent)
 Design.staff(office,cf,session)
 -- Operations employees are seated, animated and scheduled by the same task service.
 local support=Instance.new("Folder");support.Name="OperationsEmployees";support.Parent=office
 for i=1,12 do
  local x=if i&lt;=6 then -52+(i-1)%3*8 else 33+(i-7)%3*16
  local z=if i&lt;=6 then -24.5+math.floor((i-1)/3)*15 else -15.5+math.floor((i-7)/3)*52
  local station=K.activity(office,cf,"OperationsStation"..i,"Service","operations","support",CFrame.new(x,2.8,z),0,owner)
  local e=Rig.build(support,owner,300+i,"support",cf*CFrame.new(x,3,z));e:SetAttribute("HomeWorkstation",station:GetAttribute("WorkstationId"));e:SetAttribute("WorkCFrame",cf*CFrame.new(x,3,z));e:SetAttribute("CampusCFrame",cf);e:SetAttribute("StaffFloor",0);e:SetAttribute("StaffX",x);e:SetAttribute("StaffZ",z)
 end
	FacilitiesDesign.build(office,cf,session,accent)
	return office
end
return Design
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000024"><Properties><string name="Name">FacilityService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Card authority, elevators, shop economy and real consumable snack tools.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Prompts=game:GetService("ProximityPromptService")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Math=require(ReplicatedStorage.Shared.CampusMath)
local Departments=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local TweenService=game:GetService("TweenService")
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Lift=require(script.Parent.LiftService)
local Sound=require(script.Parent.CampusSoundService)
local Facility={}
local cards: {[Instance]:any}={}
local snackTools: {[Instance]:any}={}
local guests: {[number]:{[number]:number}}={}
local doors: {[Instance]:any}={}
local connections: {[Player]:RBXScriptConnection}={}
local guardClock=0
local effects: {[Instance]:any}={}
local routines: {[Player]:any}={}
local promptTimes: {[Player]:number}={}
local routineCooldown: {[Player]:number}={}
local function notify(player: Player,text: string,kind: string?)
	Remote.fire(player,"Notify",kind or "CAMPUS_NOTICE",{text=text})
end
local function backpack(player: Player): Instance?
	return player:FindFirstChildOfClass("Backpack")
end
local function carried(player: Player,tool: Instance): boolean
	return tool.Parent~=nil and (tool.Parent==backpack(player) or tool.Parent==player.Character)
end
function Facility.hasCard(player: Player,owner: number,executive: boolean?): boolean
	for tool,record in cards do
		if record.holder==player and record.owner==owner and carried(player,tool) and (record.expires==0 or record.expires&gt;os.time()) then
			if not executive or player.UserId==owner then return true end
		end
	end
	return false
end
function Facility.issueCard(player: Player,owner: number,expires: number?): boolean
	local bag=backpack(player);if not bag then return false end
	for tool,record in cards do if record.holder==player and record.owner==owner then tool:Destroy();cards[tool]=nil end end
	local tool=Instance.new("Tool");tool.Name=if owner==player.UserId then "Employee Card" else "Guest Card";tool.CanBeDropped=false;tool.ToolTip="Scan at the door reader. Carry in your backpack or hand."
	local handle=Instance.new("Part");handle.Name="Handle";handle.Size=Vector3.new(1.6,.12,1);handle.Color=Color3.fromRGB(225,222,205);handle.CanCollide=false;handle.Massless=true;handle.Parent=tool
	local stripe=Instance.new("Part");stripe.Name="CardStripe";stripe.Size=Vector3.new(1.6,.02,.24);stripe.CFrame=handle.CFrame*CFrame.new(0,.08,.25);stripe.Color=Color3.fromRGB(82,110,85);stripe.CanCollide=false;stripe.Massless=true;stripe.Parent=tool
	local weld=Instance.new("WeldConstraint");weld.Part0=handle;weld.Part1=stripe;weld.Parent=handle
	tool:SetAttribute("CardOwner",owner);tool:SetAttribute("CardHolder",player.UserId)
	cards[tool]={holder=player,owner=owner,expires=expires or 0};tool.Parent=bag
	return true
end
local function rootOf(player: Player): BasePart?
	local character=player.Character
	return if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end
local function nearby(player: Player,p: BasePart,maxDistance: number): boolean
	local root=rootOf(player);return root~=nil and (root.Position-p.Position).Magnitude&lt;=maxDistance
end
local function ownerSession(owner: number): any
	for _,s in Session.all() do if s.userId==owner and not s.closed then return s end end
	return nil
end
local function consume(player: Player,tool: Instance)
	local record=snackTools[tool];local s=Session.get(player)
	if not record or record.holder~=player or not s or s.closed or not carried(player,tool) then return end
	local c=s.data.empire.campus;local n=c.snacks[record.id] or 0;if n&lt;1 then return end
	snackTools[tool]=nil;c.snacks[record.id]=n-1
	local def=Config.find(Config.SNACKS,record.id);c.boostUntil=os.time()+def.seconds;c.boostSpeed=def.speed
	tool:Destroy();Session.markDirty(s);notify(player,def.name.." enjoyed. Walk speed "..def.speed.." for "..def.seconds.."s.")
end
local function issueSnack(s: any,id: string)
	local bag=backpack(s.player);if not bag or s.closed then return end
	local def=Config.find(Config.SNACKS,id);if not def then return end
	local tool=Instance.new("Tool");tool.Name=def.name;tool.CanBeDropped=false;tool.ToolTip="Equip, then click or tap to eat."
	local handle=Instance.new("Part");handle.Name="Handle";handle.Size=if def.shape=="cup" then Vector3.new(.9,1.3,.9) else Vector3.new(1.7,.5,1)
	handle.Color=Color3.fromRGB(unpack(def.color));handle.Massless=true;handle.CanCollide=false;handle.Parent=tool
	snackTools[tool]={holder=s.player,id=id};tool.Activated:Connect(function()consume(s.player,tool)end);tool.Parent=bag
end
local function restore(s: any)
	if s.closed or not s.player.Parent then return end
	Facility.issueCard(s.player,s.userId)
	for owner,list in guests do if list[s.userId] and list[s.userId]&gt;os.time() then Facility.issueCard(s.player,owner,list[s.userId]) end end
	for tool,record in snackTools do if record.holder==s.player then tool:Destroy();snackTools[tool]=nil end end
	for id,count in s.data.empire.campus.snacks do for _=1,count do issueSnack(s,id) end end
end
local function buySnack(s: any,p: any): any
	local def=Config.find(Config.SNACKS,p.snackId);if not def then return {ok=false,err="BAD_INPUT"} end
	local c=s.data.empire.campus;local total=0;for _,count in c.snacks do total+=count end
	if total&gt;=16 then return {ok=false,err="SNACK_FULL"} end
	local delivery=if p.atCounter==true then 0 else 15
	-- atCounter is only accepted from the server prompt route, never from remote payloads.
	if not Economy.spend(s,def.price+delivery) then return {ok=false,err="NO_MONEY"} end
	c.snacks[def.id]=(c.snacks[def.id] or 0)+1;issueSnack(s,def.id)
	local seller=if delivery==0 and typeof(p.shopOwnerId)=="number" then ownerSession(p.shopOwnerId) else nil
	if seller and seller~=s then
		local net=def.price*.55;Economy.grant(seller,net);seller.data.empire.campus.retailRevenue+=net;seller.data.empire.campus.retailSales+=1;Session.markDirty(seller)
	end
	Session.markDirty(s);return {ok=true}
end
local function grantGuest(s: any,p: any): any
	if typeof(p.userId)~="number" or p.userId~=math.floor(p.userId) or p.userId==s.userId then return {ok=false,err="BAD_INPUT"} end
	local peer=ownerSession(p.userId);if not peer then return {ok=false,err="PLAYER_OFFLINE"} end
	guests[s.userId]=guests[s.userId] or {};guests[s.userId][p.userId]=os.time()+3600
	Facility.issueCard(peer.player,s.userId,guests[s.userId][p.userId]);notify(peer.player,s.player.DisplayName.." gave you a one-hour guest card. Founder office and compute lab stay private.")
	Session.markDirty(s);return {ok=true}
end
local function revokeGuest(s: any,p: any): any
	if typeof(p.userId)~="number" then return {ok=false,err="BAD_INPUT"} end
	if guests[s.userId] then guests[s.userId][p.userId]=nil end
	for tool,record in cards do if record.owner==s.userId and record.holder.UserId==p.userId then tool:Destroy();cards[tool]=nil end end
	Session.markDirty(s);return {ok=true}
end
local function upgradeRetail(s: any,_p: any): any
	local c=s.data.empire.campus;local cost=Config.RETAIL[c.retailLevel];if not cost then return {ok=false,err="MAX_RETAIL"} end
	if not Economy.spend(s,cost) then return {ok=false,err="NO_MONEY"} end
	c.retailLevel+=1;Session.markDirty(s);return {ok=true}
end
local function useLift(s: any,payload: any): any return Lift.request(s,payload) end
local function openSecurity(s: any,payload: any): any
	if payload.ownerId~=nil and payload.ownerId~=s.userId then return {ok=false,err="OWNER_ONLY"} end
	local p=Plot.get(s.player)
	if not p or not p.office then return {ok=false,err="LOADING"} end
	if not Facility.hasCard(s.player,s.userId,true) then return {ok=false,err="CARD_REQUIRED"} end
	local channels={}
	for _,c in p.office:GetChildren() do if c:IsA("BasePart") and c:GetAttribute("CameraId") then
		table.insert(channels,{id=c:GetAttribute("CameraId"),name=c:GetAttribute("CameraName"),cframe=c:GetAttribute("ViewCFrame")})
	end end
	table.sort(channels,function(a,b)return a.id&lt;b.id end)
	return {ok=true,ownerId=s.userId,channels=channels}
end
local function openDoor(office: Model,door: BasePart)
	Sound.play(door,"door")
 local record={closed=door:GetAttribute("ClosedCFrame"),untilTime=os.clock()+7,details={}}
	if door.Name=="SecretBookcase" then for _,p in office:GetChildren() do if p:IsA("BasePart") and p:GetAttribute("SecretDetail") then
		local home=p:GetAttribute("SecretHome");table.insert(record.details,{part=p,home=home});p.CFrame=door:GetAttribute("DoorOpenCFrame")*record.closed:Inverse()*home
	end end end
	record.office=office;doors[door]=record;door.CanCollide=false
 if door.Name=="SecretBookcase" then door.CFrame=door:GetAttribute("DoorOpenCFrame") else
  local ok=pcall(function()TweenService:Create(door,TweenInfo.new(.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=door:GetAttribute("DoorOpenCFrame")}):Play()end)
  if not ok then door.CFrame=door:GetAttribute("DoorOpenCFrame") end
 end
end
-- Internal employee route: identity comes from the current server-built office, never a player payload.
function Facility.openEmployeeDoor(npc: Model,door: BasePart): boolean
 local office=npc:FindFirstAncestor("Office");if not office or door:FindFirstAncestor("Office")~=office then return false end
 local parent=npc.Parent;if not parent or (parent.Name~="Employees" and parent.Name~="OperationsEmployees") then return false end
 if npc:GetAttribute("OwnerUserId")~=office:GetAttribute("OwnerUserId") or door:GetAttribute("OwnerOnly") then return false end
 if not Departments.doorAllowed(npc:GetAttribute("RoleId") or "support",door:GetAttribute("AccessClass")) then return false end
 if not door:GetAttribute("DoorOpenCFrame") then return false end
 if (npc.PrimaryPart.Position-door.Position).Magnitude&gt;8 then return false end
 openDoor(office,door);return true
end
local function sameToilet(a: Instance,b: Instance): boolean
	return a:GetAttribute("ToiletX")==b:GetAttribute("ToiletX") and a:GetAttribute("ToiletY")==b:GetAttribute("ToiletY") and a:GetAttribute("ToiletZ")==b:GetAttribute("ToiletZ")
end
local function fixture(s: any,q: ProximityPrompt,office: Model,owner: number,action: string): boolean
	local p=q.Parent :: BasePart
	local known=action=="roomDoor" or action=="security" or action=="ownerComputer" or action=="toilet" or action=="cubicle" or action=="flush" or action=="tap" or action=="shower" or action=="sauna" or action=="workout" or action=="vault" or action=="report" or action=="departmentDoor" or action=="fridge"
	if not known then return false end
	if (promptTimes[s.player] or 0)&gt;os.clock() then return true end;promptTimes[s.player]=os.clock()+.35
	local h=if s.player.Character then s.player.Character:FindFirstChildOfClass("Humanoid") else nil
	if action=="fridge" then openDoor(office,p)
 elseif action=="departmentDoor" then
  if p:GetAttribute("OwnerOnly") and s.userId~=owner then return true end
  if p:GetAttribute("AccessClass")=="compute" or p:GetAttribute("AccessClass")=="research" then if s.userId~=owner then notify(s.player,"This lab requires founder clearance.");return true end end
  openDoor(office,p)
 elseif action=="roomDoor" then
		local room=Config.find(Config.ROOMS,q:GetAttribute("Value"));if not room then return true end
		if room.access=="owner" and s.userId~=owner then notify(s.player,"Founder-only room. Your employee or guest pass does not open it.");return true end
		local door=office:FindFirstChild(if room.hidden then "SecretBookcase" else "RoomDoor_"..room.id)
		if door and door:IsA("BasePart") then openDoor(office,door) end
	elseif action=="security" then
		if s.userId~=owner then notify(s.player,"Camera control belongs to the campus founder.");return true end
		local result=openSecurity(s,{ownerId=owner});if result.ok then Remote.fire(s.player,"Notify","SECURITY_OPEN",result) end
	elseif action=="ownerComputer" then
		if s.userId==owner then Remote.fire(s.player,"Notify","OWNER_COMPUTER",{app=q:GetAttribute("Value") or "empire"}) end
	elseif action=="toilet" then
		if not h or not p:IsA("Seat") then return true end
		if p.Occupant and p.Occupant~=h then notify(s.player,"This cubicle is occupied.");return true end
		if h.SeatPart==p then h.Sit=false;p.Disabled=true
		else p.Disabled=false;p:Sit(h) end
	elseif action=="cubicle" then
		for _,seat in office:GetChildren() do if seat.Name=="ToiletSeat" and seat:GetAttribute("ToiletX")==p:GetAttribute("CubicleX") and seat:GetAttribute("ToiletY")==0 and seat.Occupant and seat.Occupant~=h then notify(s.player,"Occupied. Please use another cubicle.");return true end end
		if doors[p] then p.CFrame=doors[p].closed;p.CanCollide=true;doors[p]=nil else openDoor(office,p) end
	elseif action=="flush" then
  Sound.play(p,"flush")
		for _,w in office:GetChildren() do if w.Name=="ToiletWater" and sameToilet(p,w) then
			p:SetAttribute("FlushCount",(p:GetAttribute("FlushCount") or 0)+1)
			effects[w]={kind="flush",untilTime=os.clock()+2,home=w.CFrame,size=w.Size};notify(s.player,"Toilet flushed.");break
		end end
	elseif action=="tap" or action=="shower" then
		local home=p:GetAttribute("EffectHome")
		for _,w in office:GetChildren() do if w:IsA("BasePart") and w.Name==(if action=="tap" then "TapWater" else "ShowerWater") and (w.Position-home.Position).Magnitude&lt;.1 then
			if effects[w] then w.Transparency=1;effects[w]=nil
			else w.Transparency=.5;effects[w]={kind="water",untilTime=os.clock()+(if action=="tap" then 6 else 15)} end
			break
		end end
	elseif action=="workout" or action=="sauna" then
		if routines[s.player] or (routineCooldown[s.player] or 0)&gt;os.clock() then notify(s.player,"Finish your session or take a short break before the next one.");return true end
		if action=="workout" then for _,job in routines do if job.part==p then notify(s.player,"This machine is in use.");return true end end end
		local seconds=if action=="workout" then 18 else 12
		routines[s.player]={part=p,kind=action,left=seconds,seconds=seconds,owner=owner,machine=q:GetAttribute("Value"),office=office}
		if action=="sauna" then local steam=p:FindFirstChild("Steam");if steam then steam.Enabled=true;effects[steam]={kind="steam",untilTime=os.clock()+20} end end
		notify(s.player,if action=="workout" then "Exercise started · stay at this machine for 18 seconds." else "Sauna started · relax close to the heater for 12 seconds.")
	elseif action=="vault" then
		if owner==s.userId then notify(s.player,string.format("Company vault · $%.0f cash · best trained AI %.1f",s.data.money,s.data.stats.bestOverall or 0)) end
	elseif action=="report" and owner==s.userId then
		local bag=backpack(s.player);if not bag then return true end
		local old=bag:FindFirstChild("Company Report");if old then old:Destroy() end;local equipped=if s.player.Character then s.player.Character:FindFirstChild("Company Report") else nil;if equipped then equipped:Destroy() end
		local tool=Instance.new("Tool");tool.Name="Company Report";tool.CanBeDropped=false;tool.RequiresHandle=false;tool.ToolTip=string.format("$%.0f · AI %.1f · office %d",s.data.money,s.data.stats.bestOverall or 0,s.data.empire.office)
		local report=tool.ToolTip;tool.Activated:Connect(function()if tool.Parent and carried(s.player,tool) then notify(s.player,report) end end);tool.Parent=bag;notify(s.player,"Company report printed to your backpack.")
	end
	return true
end
function Facility.handle(player: Player,q: ProximityPrompt)
	local action=q:GetAttribute("CampusAction");if not action or action=="spawnCar" then return end
	local s=Session.get(player);if not s or s.closed or not q.Parent or not q.Parent:IsA("BasePart") or not nearby(player,q.Parent,16) then return end
	local office=q:FindFirstAncestor("Office");if not office then return end
	local owner=office:GetAttribute("OwnerUserId");local own=ownerSession(owner);local p=if own then Plot.get(own.player) else nil
	if not own or not p or p.office~=office then return end
	if action=="snack" then
		local localPos=p.cframe:PointToObjectSpace(q.Parent.Position)
		if Math.inside(localPos.X,localPos.Y,localPos.Z,own.data.empire.office) and not Facility.hasCard(player,owner) then notify(player,"The house kitchen requires a company or guest card.");return end
		local result=buySnack(s,{snackId=q:GetAttribute("Value"),shopOwnerId=owner,atCounter=true})
		notify(player,if result.ok then "Snack added to your backpack. Equip it to eat." else (if result.err=="NO_MONEY" then "Not enough money for this snack." else "Your snack bag is full."))
		return
	end
	if action=="card" and owner==player.UserId then Facility.issueCard(player,owner);notify(player,"Replacement employee card issued.");return end
	if not Facility.hasCard(player,owner,action=="ceo" or q:GetAttribute("OwnerOnly")==true) then notify(player,"Access denied. You need a valid card for this company.");return end
	if fixture(s,q,office,owner,action) then return end
	if action=="door" or action=="ceo" then
		for _,door in office:GetChildren() do
			if door:IsA("BasePart") and door:GetAttribute("DoorOwner")==owner and (if action=="ceo" then door.Name=="CEODoor" else door.Name=="CardDoor" or door.Name=="GarageGate") then
				openDoor(office,door)
			end
		end
	elseif action=="card" and owner==player.UserId then Facility.issueCard(player,owner);notify(player,"Replacement employee card issued.")
	elseif action=="liftMenu" then
		Remote.fire(player,"Notify","LIFT_MENU",{ownerId=owner,tier=own.data.empire.office,floors=Config.FLOORS[own.data.empire.office]})
	elseif action=="lift" or action=="roof" then
		local destination=if action=="roof" then Config.FLOORS[own.data.empire.office] else q:GetAttribute("Value")
		if typeof(destination)~="number" or destination~=math.floor(destination) or destination&lt; -1 or destination&gt;Config.FLOORS[own.data.empire.office] then return end
		local result=useLift(s,{ownerId=owner,floor=destination});notify(player,if result.ok then "Lift requested. Wait by the panel." else result.err)
	end
end
local function atRoutine(player: Player,job: any): boolean
	if job.kind~="sauna" then return nearby(player,job.part,7) end
	local root=rootOf(player);local cf=job.office:GetAttribute("CampusCFrame");if not root or not cf then return false end
	local pos=cf:PointToObjectSpace(root.Position);local room=Config.find(Config.ROOMS,"sauna")
	return pos.X&gt;room.x1 and pos.X&lt;room.x2 and pos.Z&gt;room.z1 and pos.Z&lt;room.z2 and pos.Y&gt;0 and pos.Y&lt;14
end
function Facility.tick(dt: number)
	Lift.tick(dt)
	for door,record in doors do
		if not door.Parent then doors[door]=nil elseif os.clock()&gt;=record.untilTime then
   local occupied=false
   for _,s in Session.all() do local root=rootOf(s.player);if root and (root.Position-record.closed.Position).Magnitude&lt;5 then occupied=true;break end end
   if not occupied and record.office and record.office.Parent then for _,groupName in {"Employees","OperationsEmployees"} do local folder=record.office:FindFirstChild(groupName);if folder then for _,npc in folder:GetChildren() do if npc.PrimaryPart and (npc.PrimaryPart.Position-record.closed.Position).Magnitude&lt;5 then occupied=true;break end end end end end
   if occupied then record.untilTime=os.clock()+1 else
    local ok=pcall(function()TweenService:Create(door,TweenInfo.new(.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=record.closed}):Play()end)
    if not ok then door.CFrame=record.closed end
    door.CanCollide=true;for _,d in record.details or {} do if d.part.Parent then d.part.CFrame=d.home end end;doors[door]=nil
   end
  end
	end
	for part,record in effects do
		if not part.Parent then effects[part]=nil
		elseif os.clock()&gt;=record.untilTime then
			if record.kind=="steam" then part.Enabled=false elseif record.kind=="water" then part.Transparency=1 elseif record.kind=="flush" then part.CFrame=record.home;part.Size=record.size end
			effects[part]=nil
		elseif record.kind=="flush" then part.CFrame=record.home*CFrame.new(0,-.35*math.sin((record.untilTime-os.clock())*math.pi/2),0) end
	end
	for player,job in routines do
		local s=Session.get(player)
		if not s or s.closed or not job.part.Parent or not atRoutine(player,job) or not Facility.hasCard(player,job.owner) then
			routines[player]=nil;notify(player,"Session stopped because you left the station.")
		else
			job.left-=dt
			if job.kind=="workout" then for _,detail in job.office:GetChildren() do
				if detail:GetAttribute("BeltMachine")==job.machine then detail.CFrame=detail:GetAttribute("BeltHome")*CFrame.new(0,0,(os.clock()*3)%1.6-.8) end
				if detail:GetAttribute("BikeMachine")==job.machine then detail.CFrame=detail:GetAttribute("SpinBase")*CFrame.Angles((job.seconds-job.left)*3,0,0) end
			end end
			if job.left&lt;=1e-6 then
				local c=s.data.empire.campus;local active=c.boostUntil&gt;os.time();c.boostUntil=math.max(c.boostUntil,os.time()+90);local speed=if job.kind=="workout" then 20 else 18;c.boostSpeed=if active then math.max(c.boostSpeed,speed) else speed
				routines[player]=nil;routineCooldown[player]=os.clock()+60;Session.markDirty(s);notify(player,"Session complete · refreshed for 90 seconds.")
			end
		end
	end
	for tool,record in cards do if not tool.Parent or (record.expires&gt;0 and record.expires&lt;=os.time()) then tool:Destroy();cards[tool]=nil end end
	for tool,_ in snackTools do if not tool.Parent then snackTools[tool]=nil end end
	guardClock+=dt;local guard=guardClock&gt;=.25;if guard then guardClock=0 end
	for _,s in Session.all() do
		if s.closed then continue end
		local c=s.data.empire.campus;local root=rootOf(s.player)
		local h=if s.player.Character then s.player.Character:FindFirstChildOfClass("Humanoid") else nil
		if h and not Lift.riding(s.player) then h.WalkSpeed=if c.boostUntil&gt;os.time() then c.boostSpeed else 16 end
		if guard and root then for _,p in Plot.all() do if p.owner and p.office then
			local localPos=p.cframe:PointToObjectSpace(root.Position);local tier=p.office:GetAttribute("OfficeTier")
			if (Math.inside(localPos.X,localPos.Y,localPos.Z,tier) or Math.garage(localPos.X,localPos.Y,localPos.Z)) and not Facility.hasCard(s.player,p.owner.UserId,(Math.privateZone(localPos.X,localPos.Y,localPos.Z,tier) or not Departments.employeeAllowed("marketer",localPos.X,localPos.Y,localPos.Z,tier))) then
				if h then h.Sit=false end
				s.player.Character:PivotTo(p.cframe*CFrame.new(0,4,-92));notify(s.player,"This area requires your company card. Guest cards do not open private rooms.");break
			end
		end end end
	end
end
function Facility.economyTick(s: any,dt: number)
	local c=s.data.empire.campus
	if s.data.company then
		c.retailClock+=dt
		if c.retailClock&gt;=30 then
			c.retailClock-=30
			local staff=0;for _,count in s.data.empire.employees do staff+=count end
			local tickets=c.retailLevel+math.floor(staff/24)
			local net=tickets*12
			c.retailSales+=tickets;c.retailRevenue+=net;Economy.grant(s,net);Session.markDirty(s)
		end
	end
	local online={};local passes={}
	for _,peer in Session.all() do if not peer.closed and peer.userId~=s.userId then table.insert(online,{id=peer.userId,name=peer.player.DisplayName}) end end
	for id,expires in guests[s.userId] or {} do if expires&gt;os.time() then table.insert(passes,{id=id,expires=expires}) end end
	local job=routines[s.player]
	s.live.campus={hasCard=Facility.hasCard(s.player,s.userId),online=online,passes=passes,supportStaff=12,retailNetPerTicket=12,routine=if job then {kind=job.kind,remaining=job.left,seconds=job.seconds} else nil}
end
function Facility.init()
	Lift.init(function(player,owner)return Facility.hasCard(player,owner) end)
	local limits={burst=3,perSecond=1,company=true}
	Remote.bind("UseCampusLift",{burst=2,perSecond=1},useLift)
	Remote.bind("OpenSecurity",{burst=2,perSecond=.5},openSecurity)
	Remote.bind("BuySnack",limits,function(s,p)return buySnack(s,{snackId=p.snackId})end)
	Remote.bind("GrantGuestCard",limits,grantGuest);Remote.bind("RevokeGuestCard",limits,revokeGuest);Remote.bind("UpgradeRetail",limits,upgradeRetail)
	Remote.bind("ReplaceCard",{burst=2,perSecond=.25},function(s,_p)return {ok=Facility.issueCard(s.player,s.userId)}end)
	Prompts.PromptTriggered:Connect(Facility.handle)
	Session.onLoaded(function(s)
		connections[s.player]=s.player.CharacterAdded:Connect(function()task.delay(.5,restore,s)end)
		task.delay(.5,restore,s)
	end)
	Session.onClosing(function(s)
		routines[s.player]=nil;routineCooldown[s.player]=nil;promptTimes[s.player]=nil
		if connections[s.player] then connections[s.player]:Disconnect();connections[s.player]=nil end
		guests[s.userId]=nil
		for _,list in guests do list[s.userId]=nil end
		for tool,record in cards do if record.holder==s.player or record.owner==s.userId then tool:Destroy();cards[tool]=nil end end
		for tool,record in snackTools do if record.holder==s.player then tool:Destroy();snackTools[tool]=nil end end
	end)
end
return Facility
