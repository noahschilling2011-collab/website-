local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Departments=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local Sound=require(script.Parent.CampusSoundService)
local Facility=require(script.Parent.FacilityService)
local Workstations={}
local registries: {[Instance]:any}=setmetatable({},{__mode="k"}) :: any
function Workstations.scan(office: Model): any
 local existing=registries[office];if existing then return existing end
 local registry={all={},byId={},doors={},nodes={}}
 for _,m in office:GetDescendants() do
  if m:IsA("Model") and m:GetAttribute("WorkstationId") then
   local seat=m:FindFirstChildWhichIsA("Seat",true)
   local screens={};for _,p in m:GetDescendants() do if p:IsA("BasePart") and p:GetAttribute("LiveScreen") then table.insert(screens,p) end end
   local w={model=m,id=m:GetAttribute("WorkstationId"),kind=m:GetAttribute("WorkstationType"),department=m:GetAttribute("Department"),role=m:GetAttribute("Role"),floor=m:GetAttribute("Floor") or 0,access=m:GetAttribute("RoomAccess"),position=m:GetAttribute("InteractionPosition"),seat=seat,screens=screens}
   registry.byId[w.id]=w;table.insert(registry.all,w)
  elseif m:IsA("BasePart") and (m:GetAttribute("DepartmentDoor") or m.Name=="CardDoor") then table.insert(registry.doors,m)
  elseif m:IsA("BasePart") and m:GetAttribute("NavigationNode") then table.insert(registry.nodes,m) end
 end
 table.sort(registry.all,function(a,b)return a.id&lt;b.id end)
 registries[office]=registry;return registry
end
function Workstations.reset(office: Model) registries[office]=nil end
function Workstations.allowed(w: any,e: any): boolean
 if not w.model.Parent or not Departments.doorAllowed(e.role,w.access) then return false end
 if w.role~="any" and w.role~=e.role then return false end
 local p=e.cf:PointToObjectSpace(w.position)
 return Departments.employeeAllowed(e.role,p.X,p.Y,p.Z,e.tier)
end
function Workstations.available(w: any,e: any): boolean
 return Workstations.allowed(w,e) and (not w.reserved or w.reserved==e) and (not w.seat or not w.seat.Occupant or w.seat.Occupant==e.humanoid)
end
function Workstations.reserve(w: any,e: any): boolean
 if not Workstations.available(w,e) then return false end
 w.reserved=e;w.model:SetAttribute("ReservedBy",e.index);e.station=w;return true
end
function Workstations.release(e: any)
 local w=e.station
 if w and w.reserved==e then
  w.reserved=nil;w.model:SetAttribute("ReservedBy",nil);w.model:SetAttribute("OccupiedBy",nil);w.model:SetAttribute("EmployeeName",nil);w.model:SetAttribute("Software",nil);w.model:SetAttribute("LoginUntil",nil)
 end
 if e.humanoid and e.humanoid.Parent then e.humanoid.Sit=false end
 if e.root and e.root.Parent then e.root.Anchored=false end
 local cup=e.model:FindFirstChild("EmployeeCup");if cup and (not e.carryCupUntil or workspace:GetServerTimeNow()&gt;=e.carryCupUntil) then cup:Destroy();e.model:SetAttribute("HoldingCup",false) end
 e.station=nil
end
function Workstations.choose(e: any,taskDef: any): any
 local best=nil;local score=-math.huge
 for _,w in Workstations.scan(e.office).all do
  if w.kind==taskDef.type and Workstations.available(w,e) then
   local value=(if w.department==taskDef.department then 120 else 0)+(if w.id==e.home then 45 else 0)-(w.position-e.root.Position).Magnitude*.15
   if taskDef.room and w.model:GetAttribute("MeetingRoom")~=taskDef.room then continue end
   if value&gt;score then best=w;score=value end
  end
 end
 return best
end
function Workstations.perform(e: any,time: number): boolean
 local w=e.station;if not w or w.reserved~=e or not Workstations.available(w,e) then return false end
 if e.task.id=="Coffee" then local machine=e.office:FindFirstChild("KitchenCoffeeMachine");if machine then Sound.play(machine,"coffee") end end
 if e.task.id=="FridgeDrink" then local door=e.office:FindFirstChild("KitchenFridgeDoor");if door then Facility.openEmployeeDoor(e.model,door) end end
 w.model:SetAttribute("OccupiedBy",e.index);w.model:SetAttribute("EmployeeName",e.name);w.model:SetAttribute("Software",e.task.id);w.model:SetAttribute("LoginUntil",workspace:GetServerTimeNow()+1.8)
 e.model:SetAttribute("Workstation",w.id);e.model:SetAttribute("WorkstationType",w.kind);e.model:SetAttribute("Task",e.task.id)
 if w.seat then
  -- Sit is the engine's real seat weld, rather than a character placed in front of a desk.
  e.humanoid.AutoRotate=false;e.root.Anchored=false;w.seat:Sit(e.humanoid)
  e.root.Anchored=true
 else
  e.humanoid:MoveTo(e.root.Position);e.humanoid.AutoRotate=false
  if w.model.PrimaryPart then
   local target=w.model:GetAttribute("FacingPosition") or w.model.PrimaryPart.Position;local delta=Vector3.new(target.X-e.root.Position.X,0,target.Z-e.root.Position.Z)
   if delta.Magnitude&gt;.2 then e.root.CFrame=CFrame.lookAt(e.root.Position,e.root.Position+delta) end
  end
  e.root.Anchored=true
 end
 return true
end
return Workstations
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000008"><Properties><string name="Name">EmployeeNavigation</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Bounded asynchronous path jobs. Ordinary travel is Humanoid movement, never PivotTo.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Pathfinding=game:GetService("PathfindingService")
local Departments=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Workstations=require(script.Parent.WorkstationService)
local Facility=require(script.Parent.FacilityService)
local Lift=require(script.Parent.LiftService)
local Nav={}
local queue={};local activeJobs=0
local function allowed(e: any,p: Vector3): boolean
 local v=e.cf:PointToObjectSpace(p);return Departments.employeeAllowed(e.role,v.X,v.Y,v.Z,e.tier)
end
local function disconnect(e: any)
 if e.blocked then e.blocked:Disconnect();e.blocked=nil end
 if e.moveFinished then e.moveFinished:Disconnect();e.moveFinished=nil end
end
function Nav.cancel(e: any)
 e.navToken=(e.navToken or 0)+1;e.nav=nil;e.queued=false;disconnect(e)
 if e.humanoid and e.humanoid.Parent and not e.root.Anchored then e.humanoid:MoveTo(e.root.Position) end
end
local function enqueue(e: any,time: number)
 if e.queued then return end;e.queued=true;e.nav.retryAt=time;table.insert(queue,{employee=e,token=e.navToken})
end
local function fail(e: any,time: number,reason: string)
 disconnect(e);if not e.nav then return end
 e.nav.retries+=1;e.nav.points=nil;e.nav.doorWait=nil;e.humanoid:MoveTo(e.root.Position);e.model:SetAttribute("NavigationIssue",reason)
 if e.nav.retries&gt;=3 then local cb=e.nav.callback;Nav.cancel(e);e.model:SetAttribute("NavigationIssue","Waiting for a clear route");cb(false)
 else enqueue(e,time+.5*e.nav.retries) end
end
local function nextWaypoint(e: any,time: number)
 local n=e.nav;if not n or not n.points then return end
 while n.index&lt;=#n.points and (n.points[n.index].Position-e.root.Position).Magnitude&lt;2.3 do n.index+=1 end
 if n.index&gt;#n.points then
  disconnect(e)
  if n.transport then
   n.points=nil;n.waitingLift=true;n.liftStart=time;e.model:SetAttribute("Activity","ELEVATOR")
  else local cb=n.callback;e.nav=nil;e.model:SetAttribute("NavigationIssue",nil);cb(true) end
  return
 end
 local point=n.points[n.index]
 if not allowed(e,point.Position) then fail(e,time,"Restricted area on path");return end
 n.lastPosition=e.root.Position;n.deadline=time+math.max(3,(point.Position-e.root.Position).Magnitude/e.personality.walkSpeed+3)
 e.humanoid:MoveTo(point.Position)
end
function Nav.go(e: any,target: Vector3,time: number,callback: (boolean)-&gt;())
 Nav.cancel(e)
 if not allowed(e,target) then callback(false);return end
 e.humanoid.EvaluateStateMachine=true;e.root.Anchored=false;e.humanoid.Sit=false;e.humanoid.AutoRotate=true;e.humanoid.WalkSpeed=e.personality.walkSpeed
 pcall(function()e.root:SetNetworkOwner(nil)end)
 local v=e.cf:PointToObjectSpace(e.root.Position);local t=e.cf:PointToObjectSpace(target)
 local source=if v.Y&lt; -3 then -1 else math.floor((v.Y-1)/16)
 local destination=if t.Y&lt; -3 then -1 else math.floor((t.Y-1)/16)
 local transport=source~=destination and (e.personality.seed%4==0 or (source==-1 or destination==-1) and e.personality.seed%2==0)
 e.nav={target=target,callback=callback,retries=0,index=1,retryAt=time,source=source,destination=destination,transport=transport,token=e.navToken}
 if transport then e.nav.pathTarget=(e.cf*CFrame.new(0,(if source==-1 then -24 else source*16)+2.8,60)).Position end
 enqueue(e,time)
end
function Nav.pump(time: number)
 local launched=0
 for i=#queue,1,-1 do
  local entry=queue[i];local e=entry.employee
  if entry.token~=e.navToken then table.remove(queue,i)
  elseif not e.nav or not e.model.Parent then table.remove(queue,i);e.queued=false
  elseif time&gt;=e.nav.retryAt and activeJobs&lt;Config.MAX_PATH_JOBS and launched&lt;Config.MAX_PATH_JOBS then
   table.remove(queue,i);e.queued=false;activeJobs+=1;launched+=1
   local token=e.navToken;local start=e.root.Position;local target=e.nav.pathTarget or e.nav.target
   task.spawn(function()
    local costs={OwnerOnly=math.huge,ComputeAccess=if e.role=="engineer" then 1 else math.huge,ResearchAccess=if e.role=="researcher" or e.role=="engineer" then 1 else math.huge,StaffDoor=1,TeamRoom=1}
    local path=Pathfinding:CreatePath({AgentRadius=1.3,AgentHeight=5.6,AgentCanJump=false,AgentCanClimb=false,WaypointSpacing=5,Costs=costs})
    local ok=pcall(function()path:ComputeAsync(start,target)end)
    activeJobs-=1
    if not e.nav or token~=e.navToken or not e.model.Parent then return end
    if not ok or path.Status~=Enum.PathStatus.Success then fail(e,time,"Path unavailable");return end
    local points=path:GetWaypoints()
    if #points&lt;1 then fail(e,time,"Empty route");return end
    for _,p in points do if not allowed(e,p.Position) then fail(e,time,"Restricted waypoint");return end end
    e.nav.points=points;e.nav.index=1
    e.blocked=path.Blocked:Connect(function(index)if e.nav and index&gt;=e.nav.index then fail(e,e.now or time,"Path blocked") end end)
    e.moveFinished=e.humanoid.MoveToFinished:Connect(function(reached)
     if not e.nav or not e.nav.points then return end
     if reached then e.nav.index+=1;nextWaypoint(e,e.now or time) else fail(e,e.now or time,"Move timed out") end
    end)
    nextWaypoint(e,time)
   end)
  end
 end
end
function Nav.tick(e: any,time: number)
 local n=e.nav;if not n then return end
 if n.waitingLift then
  if Lift.riding(e.model) then return end
  if n.inLift then
   n.inLift=false;n.transport=false;n.waitingLift=false;n.pathTarget=nil;n.retries=0;enqueue(e,time);e.model:SetAttribute("Activity","WALKING")
  elseif time-n.liftStart&gt;25 then
   -- A busy cabin falls back to the real emergency stairs.
   n.transport=false;n.waitingLift=false;n.pathTarget=nil;enqueue(e,time)
  elseif Lift.requestEmployee(e.office,e.cf,e.model,n.source,n.destination) then n.inLift=true end
  return
 end
 if n.points then
  for _,door in Workstations.scan(e.office).doors do
   if (door.Position-e.root.Position).Magnitude&lt;7 and door.CanCollide then
    if Facility.openEmployeeDoor(e.model,door) then n.doorWait=time+.4;n.deadline=math.max(n.deadline or time,time+4);e.humanoid:MoveTo(e.root.Position)
    elseif door:GetAttribute("AccessClass")=="owner" then fail(e,time,"Door access denied");return end
   end
  end
  if n.doorWait then
   if time&lt;n.doorWait then return end;n.doorWait=nil;nextWaypoint(e,time);return
  end
  if n.deadline and time&gt;n.deadline then fail(e,time,"Stuck; recomputing");return end
  local point=n.points[n.index];if point and (point.Position-e.root.Position).Magnitude&lt;2.3 then n.index+=1;nextWaypoint(e,time) end
 end
end
return Nav
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000012"><Properties><string name="Name">OfficeKit</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Small reusable architectural pieces; monitors use GUI lines rather than hundreds of tiny Parts.
local Collection=game:GetService("CollectionService")
local K={}
K.ink=Color3.fromRGB(37,46,44);K.paper=Color3.fromRGB(235,233,219);K.stone=Color3.fromRGB(190,188,174)
K.wood=Color3.fromRGB(151,113,77);K.fabric=Color3.fromRGB(107,122,110);K.glass=Color3.fromRGB(175,196,189)
function K.part(parent: Instance,cf: CFrame,name: string,size: Vector3,at: CFrame,color: Color3,material: Enum.Material?,detail: boolean?): Part
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf*at;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
 if detail then p.CanCollide=false;p.CanTouch=false end
 return p
end
function K.text(part: BasePart,text: string): TextLabel
 local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(960,420);gui.LightInfluence=.25;gui.MaxDistance=100;gui.Parent=part
 local label=Instance.new("TextLabel");label.Name="Label";label.BackgroundTransparency=1;label.Size=UDim2.fromScale(1,1);label.Text=text;label.TextWrapped=true;label.TextScaled=true;label.TextColor3=K.paper;label.Font=Enum.Font.BuilderSansBold;label.Parent=gui
 return label
end
function K.screen(parent: Instance,cf: CFrame,name: string,size: Vector3,at: CFrame,kind: string,accent: Color3): Part
 local screen=K.part(parent,cf,name,size,at,K.ink,nil,true);screen:SetAttribute("LiveScreen",kind);Collection:AddTag(screen,"CompanyScreen")
 local gui=Instance.new("SurfaceGui");gui.Name="Desktop";gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(800,480);gui.LightInfluence=.15;gui.MaxDistance=120;gui.Parent=screen
 local function text(name: string,x: number,y: number,w: number,h: number,size: number,color: Color3): TextLabel
  local t=Instance.new("TextLabel");t.Name=name;t.Position=UDim2.fromOffset(x,y);t.Size=UDim2.fromOffset(w,h);t.BackgroundTransparency=1;t.Text="";t.TextSize=size;t.TextColor3=color;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Top;t.Font=Enum.Font.BuilderSans;t.TextWrapped=true;t.Parent=gui;return t
 end
 text("Header",40,30,720,50,32,accent).Font=Enum.Font.BuilderSansBold
 text("Body",40,105,720,280,27,K.paper)
 text("Footer",40,416,720,40,20,Color3.fromRGB(159,176,168))
 local bar=Instance.new("Frame");bar.Name="ProgressTrack";bar.Position=UDim2.fromOffset(40,390);bar.Size=UDim2.fromOffset(720,8);bar.BackgroundColor3=Color3.fromRGB(65,78,70);bar.BorderSizePixel=0;bar.Parent=gui
 local fill=Instance.new("Frame");fill.Name="Fill";fill.Size=UDim2.fromScale(0,1);fill.BackgroundColor3=accent;fill.BorderSizePixel=0;fill.Parent=bar
 return screen
end
function K.prompt(p: BasePart,text: string,owner: number,app: string?,section: string?): ProximityPrompt
 local q=Instance.new("ProximityPrompt");q.ObjectText=text;q.ActionText="Open";q.MaxActivationDistance=10;q.RequiresLineOfSight=true;q.HoldDuration=0;q:SetAttribute("OwnerUserId",owner)
 if app then q:SetAttribute("App",app) end;if section then q:SetAttribute("Section",section) end;q.Parent=p;return q
end
function K.plant(parent: Instance,cf: CFrame,x: number,y: number,z: number,seed: number)
 K.part(parent,cf,"CeramicPlanter",Vector3.new(2,1.8,2),CFrame.new(x,y+.9,z),K.stone,Enum.Material.Concrete)
 K.part(parent,cf,"Stem",Vector3.new(.25,3.5,.25),CFrame.new(x,y+3,z),K.wood,Enum.Material.Wood,true)
 local leaf=K.part(parent,cf,"LeafCanopy",Vector3.new(2.4,2.7,2.1),CFrame.new(x,y+4,z)*CFrame.Angles(0,seed*.7,.12),Color3.fromRGB(95,124,83),Enum.Material.Grass,true);leaf.Shape=Enum.PartType.Ball
end
function K.station(parent: Instance,cf: CFrame,id: string,department: string,role: string,at: CFrame,floor: number,style: number,owner: number,accent: Color3,app: string?,section: string?): Model
 local station=Instance.new("Model");station.ModelStreamingMode=Enum.ModelStreamingMode.Atomic;station.Name=id;station.Parent=parent
 station:SetAttribute("WorkstationId",id);station:SetAttribute("WorkstationType","Computer");station:SetAttribute("Department",department);station:SetAttribute("Role","any");station:SetAttribute("PreferredRole",role);station:SetAttribute("Capacity",1);station:SetAttribute("Floor",floor)
 station:SetAttribute("RoomAccess","staff");station:SetAttribute("OwnerUserId",owner)
 local base=cf*at
 station:SetAttribute("InteractionPosition",(base*CFrame.new(3.8,2.8,-2.9)).Position);station:SetAttribute("SeatPosition",base*CFrame.new(0,2,-2.9)*CFrame.Angles(0,math.pi,0))
 local top=K.part(station,base,"StaffDesk",Vector3.new(9,.4,4.6),CFrame.new(0,3,0),if style%3==1 then K.paper else K.wood,Enum.Material.Wood);station.PrimaryPart=top
 for _,x in {-3.6,3.6} do K.part(station,base,"DeskFrame",Vector3.new(.35,2.8,3.5),CFrame.new(x,1.45,0),K.ink,Enum.Material.Metal) end
 K.part(station,base,"MonitorStand",Vector3.new(.3,.8,.4),CFrame.new(0,3.6,.8),K.ink,nil,true)
 local screen=K.screen(station,base,"DisplayContent",Vector3.new(3.6,2.2,.18),CFrame.new(0,4.5,.8),department,accent)
 screen:SetAttribute("WorkstationId",id);screen:SetAttribute("JourneyStep",({data=1,compute=2,design=3,training=4,evaluation=5,deployment=6,growth=7})[department]);if app then K.prompt(screen,"Workstation · "..department,owner,app,section) end
 if style%3==0 then
  local second=K.screen(station,base,"SecondaryDisplay",Vector3.new(2.8,1.9,.18),CFrame.new(-3.1,4.4,.5)*CFrame.Angles(0,.24,0),"secondary",accent);second:SetAttribute("WorkstationId",id)
 elseif style%3==1 then
  K.part(station,base,"LaptopBase",Vector3.new(2.5,.12,1.6),CFrame.new(-2.8,3.27,-.5),K.ink,nil,true)
	K.screen(station,base,"LaptopDisplay",Vector3.new(2.5,1.5,.12),CFrame.new(-2.8,4,.15)*CFrame.Angles(-.1,0,0),"secondary",accent)
 end
 K.part(station,base,"Keyboard",Vector3.new(2.7,.12,.85),CFrame.new(0,3.27,-1),K.ink,nil,true)
 K.part(station,base,"MousePad",Vector3.new(1.2,.03,1.1),CFrame.new(2.25,3.23,-1),K.fabric,Enum.Material.Fabric,true)
 K.part(station,base,"Mouse",Vector3.new(.4,.12,.65),CFrame.new(2.25,3.32,-1),K.paper,nil,true)
 K.part(station,base,"Notebook",Vector3.new(1.3,.1,1.8),CFrame.new(3.4,3.28,.4)*CFrame.Angles(0,style*.15,0),K.paper,nil,true)
 if style%2==0 then
  K.part(station,base,"Mug",Vector3.new(.55,.7,.55),CFrame.new(-3.7,3.6,-1),accent,nil,true)
 else K.part(station,base,"DeskPlant",Vector3.new(.8,1.2,.8),CFrame.new(-3.7,3.9,-1),Color3.fromRGB(97,125,85),Enum.Material.Grass,true).Shape=Enum.PartType.Ball end
 local seat=Instance.new("Seat");seat.Name="ChairSeat";seat.Size=Vector3.new(2.6,.4,2.6);seat.CFrame=station:GetAttribute("SeatPosition");seat.Anchored=true;seat.CanTouch=false;seat.Color=if style%2==0 then K.fabric else Color3.fromRGB(123,113,99);seat.Material=Enum.Material.Fabric;seat.Parent=station
 K.part(station,base,"ChairBack",Vector3.new(2.6,2.2,.35),CFrame.new(0,3.15,-4.1),seat.Color,Enum.Material.Fabric,true)
 K.part(station,base,"ChairBase",Vector3.new(2.3,.2,2.1),CFrame.new(0,.4,-2.9),K.ink,Enum.Material.Metal,true)
 K.part(station,base,"ChairStem",Vector3.new(.25,1.6,.25),CFrame.new(0,1.2,-2.9),K.ink,Enum.Material.Metal,true)
 Collection:AddTag(station,"Workstation")
 return station
end
function K.activity(parent: Instance,cf: CFrame,id: string,kind: string,department: string,role: string,at: CFrame,floor: number,owner: number,seat: Seat?): Model
 local m=Instance.new("Model");m.Name=id;m.Parent=parent;m:SetAttribute("WorkstationId",id);m:SetAttribute("WorkstationType",kind);m:SetAttribute("Department",department);m:SetAttribute("Role",role);m:SetAttribute("Capacity",1);m:SetAttribute("Floor",floor);m:SetAttribute("OwnerUserId",owner);m:SetAttribute("RoomAccess","staff")
 local anchor=K.part(m,cf,"InteractionPoint",Vector3.new(.2,.2,.2),at,K.paper,nil,true);anchor.Transparency=1;m.PrimaryPart=anchor;m:SetAttribute("InteractionPosition",anchor.Position)
 if seat then seat.Parent=m;m:SetAttribute("SeatPosition",seat.CFrame) end
 Collection:AddTag(m,"Workstation");return m
end
function K.node(parent: Instance,cf: CFrame,id: string,x: number,y: number,z: number,kind: string,floor: number): Part
 local p=K.part(parent,cf,id,Vector3.new(.2,.2,.2),CFrame.new(x,y+2.8,z),K.paper,nil,true);p.Transparency=1;p:SetAttribute("NavigationNode",kind);p:SetAttribute("Floor",floor);Collection:AddTag(p,"NavigationNode");return p
end
return K
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000013"><Properties><string name="Name">DepartmentDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Collection=game:GetService("CollectionService")
local Config=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local K=require(script.Parent.OfficeKit)
local Design={}
local function rgb(c: {number}): Color3 return Color3.fromRGB(c[1],c[2],c[3]) end
local function wall(parent: Instance,cf: CFrame,name: string,size: Vector3,x: number,y: number,z: number,glass: boolean?): Part
 local p=K.part(parent,cf,name,size,CFrame.new(x,y,z),if glass then K.glass else K.paper,if glass then Enum.Material.Glass else Enum.Material.Concrete)
 if glass then p.Transparency=.55 end;return p
end
local function door(parent: Instance,cf: CFrame,id: string,x: number,y: number,z: number,alongX: boolean,access: string,owner: number): Part
 local p=K.part(parent,cf,"DepartmentDoor_"..id,if alongX then Vector3.new(8,10,.3) else Vector3.new(.3,10,8),CFrame.new(x,y+5,z),K.glass,Enum.Material.Glass);p.Transparency=.4
 p:SetAttribute("DepartmentDoor",true);p:SetAttribute("AccessClass",access);p:SetAttribute("DoorOwner",owner);p:SetAttribute("OwnerOnly",access=="owner");p:SetAttribute("ClosedCFrame",p.CFrame)
 p:SetAttribute("DoorOpenCFrame",cf*CFrame.new(x+(if alongX then 8.5 else 0),y+5,z+(if alongX then 0 else 8.5)))
 local modifier=Instance.new("PathfindingModifier");modifier.PassThrough=access~="owner";modifier.Label=if access=="owner" then "OwnerOnly" elseif access=="compute" then "ComputeAccess" elseif access=="research" then "ResearchAccess" else "StaffDoor";modifier.Parent=p
 local q=K.prompt(p,id.." · scan card",owner);q:SetAttribute("CampusAction","departmentDoor");q:SetAttribute("Public",true)
 Collection:AddTag(p,"CampusDoor");return p
end
local function camera(office: Model,cf: CFrame,id: string,name: string,position: Vector3,target: Vector3)
 local view=cf*CFrame.lookAt(position,target)
 local p=K.part(office,cf,"DepartmentCamera",Vector3.new(.8,.5,1.1),CFrame.lookAt(position,target),K.ink,Enum.Material.Metal,true)
 p:SetAttribute("CameraId",id);p:SetAttribute("CameraName",name);p:SetAttribute("ViewCFrame",view*CFrame.new(0,0,-.8))
end
local function bounds(parent: Instance,cf: CFrame,r: any,y: number)
 local b=K.part(parent,cf,"RoomNavigationBounds",Vector3.new(r.x2-r.x1,12,r.z2-r.z1),CFrame.new((r.x1+r.x2)/2,y+6,(r.z1+r.z2)/2),K.paper,nil,true);b.Transparency=1
 local modifier=Instance.new("PathfindingModifier");modifier.Label=if r.access=="research" then "ResearchAccess" else "TeamRoom";modifier.Parent=b
end
local function faceSeat(office: Model,cf: CFrame,seat: Seat,towardPositiveZ: boolean)
 local v=cf:PointToObjectSpace(seat.Position)
 seat.CFrame=cf*CFrame.new(v.X,v.Y,v.Z)*CFrame.Angles(0,if towardPositiveZ then math.pi else 0,0)
 for _,back in office:GetChildren() do if back:IsA("BasePart") and back.Name=="ChairBack" then
  local p=cf:PointToObjectSpace(back.Position)
  if math.abs(p.X-v.X)&lt;.1 and math.abs(p.Y-v.Y-1.3)&lt;.1 and math.abs(p.Z-v.Z)&lt;1.5 then back.CFrame=cf*CFrame.new(p.X,p.Y,v.Z+(if towardPositiveZ then -1.3 else 1.3));break end
 end end
end
function Design.build(office: Model,cf: CFrame,s: any,accent: Color3)
 local tier=s.data.empire.office;local floors=({3,4,5,7})[tier];local owner=s.userId
 local departments=Instance.new("Folder");departments.Name="Departments";departments.Parent=office
 local nav=Instance.new("Folder");nav.Name="Navigation";nav.Parent=office
 local common=Instance.new("Folder");common.Name="SharedWorkstations";common.Parent=office
 for f=1,floors-2 do
  local y=f*16
  for _,r in Config.rooms(tier,f) do
   local def=Config.DEPARTMENTS[r.department];local color=rgb(def.color);local cx=(r.x1+r.x2)/2;local cz=(r.z1+r.z2)/2;local west=cx&lt;0;local edge=if west then r.x2 else r.x1
   local room=Instance.new("Model");room.Name=r.id;room.Parent=departments;room:SetAttribute("Department",r.department);room:SetAttribute("RoomId",r.id);room:SetAttribute("Floor",f);room:SetAttribute("AccessClass",r.access);room:SetAttribute("RoomMin",Vector3.new(r.x1,y,r.z1));room:SetAttribute("RoomMax",Vector3.new(r.x2,y+14,r.z2))
   K.part(room,cf,"RoomFloor",Vector3.new(50,.14,26),CFrame.new(cx,y+.08,cz),if r.style==1 then Color3.fromRGB(161,151,132) else Color3.fromRGB(133,145,137),if r.style==1 then Enum.Material.WoodPlanks else Enum.Material.Fabric)
   wall(room,cf,"AcousticRoomWall",Vector3.new(50,13.6,.4),cx,y+6.8,r.z1)
   wall(room,cf,"TeamRoomGlass",Vector3.new(50,13.6,.3),cx,y+6.8,r.z2,true)
   -- Eight-stud door opening lies at the clear aisle between the two desk rows.
   local dz=cz-1.5;local a=dz-4-r.z1;local b=r.z2-(dz+4)
   wall(room,cf,"CorridorGlass",Vector3.new(.3,13.6,a),edge,y+6.8,r.z1+a/2,true)
   wall(room,cf,"CorridorGlass",Vector3.new(.3,13.6,b),edge,y+6.8,dz+4+b/2,true)
   wall(room,cf,"DoorTransom",Vector3.new(.3,3.6,8),edge,y+11.8,dz,true)
   door(room,cf,r.id,edge,y,dz,false,r.access,owner)
   K.part(room,cf,"AcousticCeiling",Vector3.new(48,.25,24),CFrame.new(cx,y+13.8,cz),if r.department=="engineering" then K.stone else K.paper,Enum.Material.Concrete)
   for _,dx in {-15,15} do
    local light=K.part(room,cf,"RecessedLight",Vector3.new(18,.1,.7),CFrame.new(cx+dx/2,y+13.55,cz),Color3.fromRGB(235,237,225),Enum.Material.Neon,true)
    local spot=Instance.new("SurfaceLight");spot.Face=Enum.NormalId.Bottom;spot.Range=17;spot.Angle=105;spot.Brightness=.55;spot.Color=if r.department=="research" then Color3.fromRGB(217,232,235) else Color3.fromRGB(245,237,219);spot.Shadows=false;spot.Parent=light
   end
   -- Personal desks use different screens, finishes, laptop layouts and objects.
   for row=1,2 do for col=1,3 do
    local x=cx+(col-2)*16;local z=cz+(if row==1 then -6 else 6);local number=(row-1)*3+col
    local station=K.station(room,cf,r.id.."_Desk"..number,r.department,def.role,CFrame.new(x,y,z),f,r.style+col+row+f,owner,color,def.app,def.section)
    station:SetAttribute("RoomAccess",r.access);station:SetAttribute("HomeRoom",r.id)
   end end
   local board=K.screen(room,cf,"TeamBoard",Vector3.new(10,3.8,.18),CFrame.new(cx,y+8.6,r.z1+.3)*CFrame.Angles(0,math.pi,0),def.screen,color)
   K.prompt(board,def.name,owner,def.app,def.section)
   -- Window-side storage and acoustic panels keep furniture out of the central aisles.
   K.part(room,cf,"LowStorage",Vector3.new(2,2.8,6),CFrame.new(if west then -78 else 78,y+1.4,cz),K.wood,Enum.Material.Wood)
   for _,dz in {-2,0,2} do K.part(room,cf,"CabinetHandle",Vector3.new(.12,.15,.7),CFrame.new(if west then -76.9 else 76.9,y+2,cz+dz),K.ink,Enum.Material.Metal,true) end
   K.plant(room,cf,if west then -78 else 78,y,cz+10,f+r.style)
   K.part(room,cf,"RoomSkirting",Vector3.new(49,.35,.12),CFrame.new(cx,y+.32,r.z1+.26),K.wood,Enum.Material.Wood,true)
   local identity=K.part(room,cf,"DepartmentIdentity",Vector3.new(10,3.5,.12),CFrame.new(cx+17,y+7.8,r.z1+.29)*CFrame.Angles(0,math.pi,0),color,nil,true)
   K.text(identity,if r.department=="data" then "RAW → CURATED\nQUALITY FIRST" elseif r.department=="research" then "ASK / EXPERIMENT / LEARN\nNEXT GENERATION" elseif r.department=="engineering" then "CODE / MONITOR / IMPROVE\nRELIABLE SYSTEMS" elseif r.department=="growth" then "CUSTOMERS / VALUE\nSUSTAINABLE GROWTH" elseif r.department=="evaluation" then "CODE / MATH / REASONING\nTEST BEFORE LAUNCH" elseif r.department=="training" then "DATA + COMPUTE\nTRAINING CONTROL" elseif r.department=="deployment" then "MODEL / PRICE / MARKET\nREADY TO LAUNCH" else "SIZE / FOCUS / STRATEGY\nMODEL ARCHITECTURE")
   for n=1,3 do K.part(room,cf,"AcousticPanel",Vector3.new(3,3,.18),CFrame.new(cx-7+n*4,y+8.5,r.z1+.28),color,Enum.Material.Fabric,true) end
   local sign=K.part(room,cf,"RoomNameplate",Vector3.new(12,1.8,.12),CFrame.new(edge+(if west then 1.2 else -1.2),y+9.7,cz+6.5)*CFrame.Angles(0,if west then math.pi/2 else -math.pi/2,0),K.ink,nil,true)
   K.text(sign,string.format("%d.%02d  /  %s",f,(if west then 1 else 5)+math.floor((r.z1+44)/32),def.name))
   bounds(room,cf,r,y)
   camera(office,cf,"dept_"..r.id,string.format("F%d / %s / %s",f,def.name,r.id),Vector3.new(if west then r.x1+2 else r.x2-2,y+12,r.z1+2),Vector3.new(cx,y+4,cz+3))
   K.node(nav,cf,r.id.."_Corridor",if west then -22 else 22,y,dz,"Corridor",f)
   K.node(nav,cf,r.id.."_Entry",edge+(if west then -4 else 4),y,dz,"RoomEntry",f)
   if r.department=="data" or r.department=="research" then
    local kind=if r.department=="data" then "Pipeline" else "Whiteboard"
    local ax=if west then -75 else 75
    local activity=K.activity(room,cf,r.id.."_"..kind,kind,r.department,def.role,CFrame.new(ax,y+2.8,cz),f,owner)
    activity:SetAttribute("FacingPosition",(cf*CFrame.new(if west then -79.3 else 79.3,y+5.5,cz)).Position)
    activity:SetAttribute("RoomAccess",r.access)
    local panel=K.part(room,cf,kind.."Board",Vector3.new(7,4,.15),CFrame.new(if west then -79.5 else 79.5,y+5.7,cz)*CFrame.Angles(0,if west then math.pi/2 else -math.pi/2,0),K.paper,nil,true)
    K.text(panel,if kind=="Whiteboard" then "ARCHITECTURE REVIEW\nDATA → MODEL → EVALUATION" else "DATA PIPELINE\nCOLLECT / FILTER / CLEAN / TOKENIZE").TextColor3=color
   end
  end
  for _,x in {-22,22} do
   for side=1,2 do
    local sx=x+(if side==1 then -2 else 2)
    local station=K.activity(common,cf,"HallConversation"..f.."_"..x.."_"..side,"Conversation","social","any",CFrame.new(sx,y+2.8,-15),f,owner)
    station:SetAttribute("ConversationGroup",f.."_"..x);station:SetAttribute("FacingPosition",(cf*CFrame.new(x+(if side==1 then 2 else -2),y+2.8,-15)).Position)
   end
   K.part(office,cf,"HallRunner",Vector3.new(8,.08,122),CFrame.new(x,y+.04,16),Color3.fromRGB(194,193,178),Enum.Material.Concrete,true)
   for _,z in {-34,62} do K.node(nav,cf,"Floor"..f.."_Hall"..x.."_"..z,x,y,z,"Corridor",f) end
  end
  local directory=K.part(office,cf,"DepartmentDirectory",Vector3.new(15,4,.18),CFrame.new(23,y+7,77.6),K.ink,nil,true)
  K.text(directory,if f==1 then "← DATA  /  COMPUTE B1,G\nMODEL → EVALUATION → LAUNCH\nLIFT ←   /   WELLNESS G" else string.format("LEVEL %d\n%s\n← STAIRS    LIFT →",f,({"Data &amp; Model","Engineering","Research","Product &amp; Growth","Advanced AI"})[f]))
  K.node(nav,cf,"F"..f.."_Lift",0,y,60,"Elevator",f)
  K.node(nav,cf,"F"..f.."_Stair",-92,y,if f%2==1 then 4 else -36,"Stairs",f)
 end
 -- Real ground-floor rooms: the compute enclosure and a glass project room.
 wall(office,cf,"ComputeFront",Vector3.new(41,13,.4),-59.5,6.5,40,true)
 local oldPartition=office:FindFirstChild("LabPartition");if oldPartition then oldPartition:Destroy() end
 wall(office,cf,"ComputeSideA",Vector3.new(.3,13,15),-39,6.5,47.5,true)
 wall(office,cf,"ComputeSideB",Vector3.new(.3,13,15),-39,6.5,70.5,true)
 door(office,cf,"Compute",-39,0,59,false,"compute",owner)
 wall(office,cf,"ComputeCeiling",Vector3.new(40,.3,38),-60,13.7,59)
 for i=1,6 do
  local x=-73+(i-1)*6
  local station=K.activity(common,cf,"ClusterRack"..i,"ServerRack","compute","engineer",CFrame.new(x,2.8,62),0,owner);station:SetAttribute("RoomAccess","compute");station:SetAttribute("FacingPosition",(cf*CFrame.new(x,5,68)).Position)
