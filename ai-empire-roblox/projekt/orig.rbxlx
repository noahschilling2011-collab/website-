</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000015"><Properties><string name="Name">AdminService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The Roblox server supplies Player.Name; a display name or a remote payload grants no rights.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local DataConfig=require(ReplicatedStorage.Shared.Config.DataConfig)
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Facility=require(script.Parent.FacilityService)
local AI=require(script.Parent.AIModelService)
local Admin={}
local ACCOUNT="nonortrttrt"
function Admin.allowed(player: Player): boolean
	return string.lower(player.Name)==ACCOUNT
end
local function campus(s: any)
	s.data.empire.office=#EmpireConfig.OFFICES
	s.data.empire.campus.retailLevel=#CampusConfig.RETAIL+1
	Facility.issueCard(s.player,s.userId)
end
local function staff(s: any)
	campus(s)
	local e=s.data.empire;local total=0
	for _,r in EmpireConfig.ROLES do total+=e.employees[r.id] or 0 end
	while total&lt;EmpireConfig.OFFICES[e.office].staff do
		local lowest=EmpireConfig.ROLES[1]
		for _,r in EmpireConfig.ROLES do if (e.employees[r.id] or 0)&lt;(e.employees[lowest.id] or 0) then lowest=r end end
		e.employees[lowest.id]=(e.employees[lowest.id] or 0)+1;total+=1
	end
end
local function research(s: any)
	for _,r in EmpireConfig.RESEARCH do s.data.empire.research[r.id]=true end
	s.data.empire.researchJob=nil
	s.data.empire.points=math.max(s.data.empire.points,10000)
	s.data.empire.infrastructure.cooling=8
end
local function hardware(s: any)
	campus(s);s.data.empire.infrastructure.cooling=8
	local used=0;for _,g in HardwareConfig.GPUS do if not g.starter then used+=s.data.gpus[g.id] or 0 end end
	local count=s.data.gpus.superpod or 0
	s.data.gpus.superpod=count+math.min(math.max(0,2-count),math.max(0,HardwareConfig.slots(s.data.empire)-used))
end
local function fleet(s: any)
	for _,car in CampusConfig.CARS do s.data.empire.campus.cars[car.id]=true end
end
local function data(s: any)
	for _,d in DataConfig.TYPES do ModelMath.addTokens(s.data.data,d.id,1e10,.9) end
end
local function run(s: any,p: any): any
	if s.userId~=s.player.UserId or not Admin.allowed(s.player) then return {ok=false,err="ADMIN_ONLY"} end
	local cmd=p.cmd
	if cmd=="campus" then campus(s)
	elseif cmd=="staff" then staff(s)
	elseif cmd=="hardware" then hardware(s)
	elseif cmd=="research" then research(s)
	elseif cmd=="fleet" then fleet(s)
	elseif cmd=="money" then Economy.grant(s,1000000)
	elseif cmd=="data" then data(s)
	elseif cmd=="finish" then if not AI.finishNow(s) then return {ok=false,err="NO_TRAINING"} end
	elseif cmd=="setup" then campus(s);staff(s);research(s);hardware(s);fleet(s);data(s);Economy.grant(s,1000000)
	else return {ok=false,err="BAD_INPUT"} end
	Plot.refresh(s);Session.markDirty(s)
	print(`[Admin] {s.player.Name} ({s.userId}): {cmd}`)
	return {ok=true,cmd=cmd}
end
function Admin.init()
	Remote.bind("AdminAction",{burst=3,perSecond=.5},run)
	Session.onLoaded(function(s)
		s.live.admin=Admin.allowed(s.player);Session.markDirty(s)
	end)
end
return Admin
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000016"><Properties><string name="Name">StaffService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One employee identity owns a real workstation, a bounded navigator and a role-specific task state machine.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Physics=game:GetService("PhysicsService")
local Prompts=game:GetService("ProximityPromptService")
local Lighting=game:GetService("Lighting")
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Departments=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local Workforce=require(ReplicatedStorage.Shared.WorkforceMath)
local Plot=require(script.Parent.PlotService)
local Session=require(script.Parent.SessionService)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Workstations=require(script.Parent.WorkstationService)
local Nav=require(script.Parent.EmployeeNavigation)
local Staff={}
local caches: {[Instance]:any}={}
local records: {[Model]:any}={}
local time=54;local accumulator=0
local function state(e: any,name: string)
 e.state=name;e.model:SetAttribute("Activity",name)
end
local function jitter(e: any,max: number): number
 e.sequence+=1;return ((e.personality.seed+e.sequence*3571)%1000)/1000*max
end
local function nearest(position: Vector3,positions: {Vector3}): number
 local best=math.huge;for _,p in positions do best=math.min(best,(p-position).Magnitude) end;return best
end
local function destroy(e: any)
 Nav.cancel(e);Workstations.release(e);records[e.model]=nil
end
local function sync(p: any,s: any): any
 local folder=p.office:FindFirstChild("Employees");local cached=caches[p.model]
 if cached and cached.office==p.office and cached.folder==folder then return cached end
 if cached then for _,e in cached.all do destroy(e) end end
 Workstations.reset(p.office)
 local c={office=p.office,folder=folder,all={},session=s,event={},lastTraining=s.data.training~=nil,lastResearch=if s.data.empire.researchJob then s.data.empire.researchJob.id else nil,lastReleased=s.data.stats.modelsReleased,lastTrained=s.data.stats.modelsTrained,lastHardware=ModelMath.fleet(s.data.gpus).slotsUsed,lastData=ModelMath.dataSummary(s.data.data).total,nextMeeting=time+55,nextSocial=time+40,moving=0}
 caches[p.model]=c
 for _,group in {folder,p.office:FindFirstChild("OperationsEmployees")} do if group then for _,m in group:GetChildren() do
  if not m:IsA("Model") or not m.PrimaryPart then continue end
  local h=m:FindFirstChildOfClass("Humanoid");if not h then continue end
  local index=m:GetAttribute("StaffIndex");local e={model=m,root=m.PrimaryPart,humanoid=h,index=index,name=m:GetAttribute("EmployeeName"),role=m:GetAttribute("RoleId"),home=m:GetAttribute("HomeWorkstation"),cf=p.cframe,tier=s.data.empire.office,office=p.office,session=s,personality=Config.personality(index,s.userId),sequence=0,state="SELECT_TASK",next=time+index%5*.7,lastBreak=time-index%80,lastMeeting=-200,now=time,taskStarted=time,cache=c}
  e.homePosition=m:GetAttribute("WorkCFrame").Position
  for _,part in m:GetDescendants() do if part:IsA("BasePart") then part.CollisionGroup="CompanyEmployees" end end
  records[m]=e;table.insert(c.all,e)
  local home=Workstations.scan(p.office).byId[e.home]
  if home and Workstations.reserve(home,e) then
   e.task={id=if e.role=="researcher" then "RunExperiment" elseif e.role=="engineer" then "WriteCode" elseif e.role=="curator" then "CleanDataset" else "AnalyzeMarket",state=if e.role=="researcher" then "RESEARCH" elseif e.role=="curator" then "DATA_REVIEW" elseif e.role=="marketer" then "MARKETING" else "WORKING"}
   if Workstations.perform(e,time) then state(e,e.task.state);e.next=time+35+jitter(e,100) end
  end
  -- A small staggered group arrives from the street or garage. Everyone else starts at their real desk.
  if e.role~="support" and index%24&lt;3 then
   Nav.cancel(e);Workstations.release(e)
   local spawn=p.cframe*CFrame.new(if index%2==0 then -25 else 0,if index%2==0 then -21 else 3,if index%2==0 then 58 else -65)
   m:PivotTo(spawn);e.root.Anchored=false;state(e,"ARRIVING");e.next=time+index%12*.8
  end
 end end end
 return c
end
local function cup(e: any,snack: boolean?)
 if e.model:FindFirstChild("EmployeeCup") then return end
 local arm=e.model:FindFirstChild("Right Arm");if not arm then return end
 local p=Instance.new("Part");p.Name="EmployeeCup";p.Size=if snack then Vector3.new(.8,.3,.5) else Vector3.new(.5,.7,.5);p.Color=if snack then Color3.fromRGB(175,141,91) else Color3.fromRGB(230,225,210);p.CanCollide=false;p.CanTouch=false;p.Massless=true;p.CFrame=arm.CFrame*CFrame.new(0,-.8,-.55);p.Parent=e.model
 e.model:SetAttribute("HoldingCup",true)
 if not snack then e.carryCupUntil=workspace:GetServerTimeNow()+90 end
 local weld=Instance.new("WeldConstraint");weld.Part0=arm;weld.Part1=p;weld.Parent=p
end
local function begin(e: any,def: any,w: any)
 if e.cache.moving&gt;=Config.MAX_MOVING_PER_OFFICE then e.next=time+3;return end
 if not w then e.next=time+4+jitter(e,6);state(e,"WAIT_AT_DESK");return end
 Nav.cancel(e);Workstations.release(e)
 if not Workstations.reserve(w,e) then e.next=time+3;state(e,"SELECT_TASK");return end
 e.cache.moving+=1
 e.task=def;e.taskStarted=time;e.next=math.huge;e.model:SetAttribute("Task",def.id);state(e,"WALKING")
 Nav.go(e,w.position,time,function(ok)
  if not e.model.Parent then return end
  if ok and Workstations.perform(e,time) then
   state(e,def.state);local duration=def.seconds or {45,100};e.next=time+duration[1]+jitter(e,duration[2]-duration[1]);e.taskStarted=time
   if def.state=="COFFEE_BREAK" then e.lastBreak=time;if def.id=="Coffee" or def.id=="Snack" or def.id=="FridgeDrink" then e.cupAt=time+4 end
   elseif def.state=="LUNCH" then e.lastLunch=math.floor(time/1200);e.cupAt=time+2
   elseif def.state=="MEETING" or def.state=="TALKING" then e.lastMeeting=time;e.next=def.untilTime or e.next end
  else Workstations.release(e);state(e,"SELECT_TASK");e.next=time+5+jitter(e,8) end
 end)
end
local function selectTask(e: any,c: any,hour: number)
 if c.moving&gt;=Config.MAX_MOVING_PER_OFFICE then e.next=time+2+jitter(e,3);return end
 if e.forced then local forced=e.forced;e.forced=nil;begin(e,forced.task,forced.station);return end
 local day=math.floor(time/1200)
 if e.role~="support" and hour&gt;=e.personality.lunch and hour&lt;e.personality.lunch+1.1 and e.lastLunch~=day then
  local def={id="Lunch",type="Dining",department="kitchen",seconds={120,230},state="LUNCH"};local w=Workstations.choose(e,def)
  if w then begin(e,def,w);return end
 end
 if time-e.lastBreak&gt;e.personality.breakEvery then
  local roof=e.personality.seed%7==0;local lounge=not roof and e.personality.seed%5==0;local drink=not roof and not lounge and e.personality.seed%4==0
  local def={id=if roof then "RoofBreak" elseif lounge then "LoungeBreak" elseif drink then "FridgeDrink" elseif e.personality.coffee then "Coffee" else "Snack",type=if roof or lounge then "Lounge" elseif drink then "Fridge" elseif e.personality.coffee then "Coffee" else "Snack",department=if roof then "roof" elseif lounge then "lounge" else "kitchen",seconds={20,55},state="COFFEE_BREAK"}
  local w=Workstations.choose(e,def);if w then begin(e,def,w);return end
 end
 local best,station=nil,nil;local score=-math.huge
 for _,def in Config.TASKS[e.role] or Config.TASKS.support do
  local w=Workstations.choose(e,def)
  if w then
   local load=0;for _,other in c.all do if other.task and other.task.id==def.id and other~=e then load+=1 end end
   local p=Config.priority(e.role,def,c.event)+jitter(e,28)-load*1.6+(if w.department==def.department then 8 else -10)
   if p&gt;score then best=def;station=w;score=p end
  end
 end
 if best then begin(e,best,station) else e.next=time+6;state(e,"WAIT_AT_DESK") end
end
local function meeting(c: any,review: boolean)
 local registry=Workstations.scan(c.office);local room=if review then "ProjectRoom" else "Boardroom";local available={}
 for _,w in registry.all do if w.kind=="Meeting" and w.model:GetAttribute("MeetingRoom")==room and not w.reserved and not (w.seat and w.seat.Occupant) then table.insert(available,w) end end
 local selected={};local roles={researcher=0,engineer=0,marketer=0,curator=0};local quota={researcher=2,engineer=2,marketer=1,curator=1}
 for _,e in c.all do
  if e.role=="support" or roles[e.role]&gt;=(quota[e.role] or 0) or time-e.lastMeeting&lt;160 or e.nav or e.state=="LUNCH" or e.state=="OFF_DUTY" or e.lod=="sleep" then continue end
  table.insert(selected,e);roles[e.role]+=1;if #selected&gt;=math.min(5,#available) then break end
 end
 if #selected&lt;2 or #available&lt;2 then return end
 local untilTime=time+150
 for i,e in selected do e.forced={task={id=if review then "ModelReviewMeeting" else "TeamMeeting",state="MEETING",seconds={80,160},untilTime=untilTime},station=available[i]};e.next=math.min(e.next,time+i*1.3) end
 c.office:SetAttribute("MeetingTopic",if review then "MODEL REVIEW" else "TEAM REVIEW");c.office:SetAttribute("MeetingUntil",untilTime)
end
local function conversation(c: any)
 local groups={}
 for _,w in Workstations.scan(c.office).all do if w.kind=="Conversation" and not w.reserved then local id=w.model:GetAttribute("ConversationGroup");groups[id]=groups[id] or {};table.insert(groups[id],w) end end
 for _,seats in groups do if #seats&gt;=2 then
  local selected={}
  for _,e in c.all do
   if e.role~="support" and e.personality.social&gt;.55 and not e.nav and e.lod~="sleep" and time-e.lastMeeting&gt;100 and e.state~="OFF_DUTY" and e.state~="LEAVING" and e.state~="LUNCH" and e.state~="COFFEE_BREAK" and (e.root.Position-seats[1].position).Magnitude&lt;80 then table.insert(selected,e);if #selected==2 then break end end
  end
  if #selected==2 then for i,e in selected do e.forced={task={id="DiscussWork",state="TALKING",seconds={25,45},untilTime=time+55},station=seats[i]};e.next=math.min(e.next,time+i) end;return end
 end end
end
local function events(c: any,s: any)
 local d=s.data;local trained=d.stats.modelsTrained;local hardware=ModelMath.fleet(d.gpus).slotsUsed;local data=ModelMath.dataSummary(d.data).total
 local review=trained&gt;c.lastTrained
 if review then c.reviewUntil=time+150;c.nextMeeting=time+2 end
 if hardware&gt;c.lastHardware then c.hardwareUntil=time+80 end
 if data&gt;c.lastData+1e8 then c.dataUntil=time+80 end
 local live=false;for _,model in d.models do if model.status=="live" then live=true;break end end
 c.event={training=d.training~=nil,research=d.empire.researchJob~=nil,review=(c.reviewUntil or 0)&gt;time,live=live,hardware=(c.hardwareUntil or 0)&gt;time,data=(c.dataUntil or 0)&gt;time}
 local research=if d.empire.researchJob then d.empire.researchJob.id else nil
 local changed=(research~=c.lastResearch) or d.stats.modelsReleased&gt;c.lastReleased or (c.lastTraining~=(d.training~=nil)) or review or hardware&gt;c.lastHardware
 if changed then for _,e in c.all do if (e.role=="engineer" or e.role=="researcher" or e.role=="marketer") and not e.nav and time-e.taskStarted&gt;10 and e.state~="LUNCH" then e.next=math.min(e.next,time+e.index%9) end end end
 c.lastResearch=research;c.lastReleased=d.stats.modelsReleased
 c.lastTraining=d.training~=nil;c.lastTrained=trained;c.lastHardware=hardware;c.lastData=data
 if time&gt;=c.nextMeeting then meeting(c,c.event.review);c.nextMeeting=time+180 end
 if time&gt;=c.nextSocial then conversation(c);c.nextSocial=time+75 end
end
local function leave(e: any)
 if e.nav then return end
 Workstations.release(e);e.task={id="Leaving",state="LEAVING"};state(e,"LEAVING");e.next=math.huge
 local target=(e.cf*CFrame.new(if e.index%3==0 then -25 else 0,if e.index%3==0 then -21 else 3,if e.index%3==0 then 58 else -65)).Position
 Nav.go(e,target,time,function(ok)
  if ok then state(e,"OFF_DUTY");e.model:SetAttribute("OffDuty",true);e.root.Anchored=true;e.next=time+8
  else state(e,"SELECT_TASK");e.next=time+12 end
 end)
end
function Staff.init()
 pcall(function()Physics:RegisterCollisionGroup("CompanyEmployees")end)
 pcall(function()Physics:RegisterCollisionGroup("CompanyPlayers")end)
 Physics:CollisionGroupSetCollidable("CompanyEmployees","CompanyEmployees",false)
 Physics:CollisionGroupSetCollidable("CompanyEmployees","CompanyPlayers",false)
 local function bindCharacter(char: Model)
  local function set(p: Instance)if p:IsA("BasePart") then p.CollisionGroup="CompanyPlayers" end end
  for _,p in char:GetDescendants() do set(p) end;char.DescendantAdded:Connect(set)
 end
 Session.onLoaded(function(s)if s.player.Character then bindCharacter(s.player.Character) end;s.player.CharacterAdded:Connect(bindCharacter)end)
 Session.onClosing(function(s)
  Workforce.set(s.data.empire,nil)
  for model,c in caches do if c.session==s then for _,e in c.all do destroy(e) end;caches[model]=nil end end
 end)
 Prompts.PromptTriggered:Connect(function(q,player)
  local index=q:GetAttribute("EmployeeTalk");if not index or not q.Parent then return end
  local model=q.Parent.Parent;local e=records[model];local s=Session.get(player)
  if not e or not s or s.closed or player.UserId~=e.session.userId or not player.Character or not player.Character.PrimaryPart or (player.Character.PrimaryPart.Position-e.root.Position).Magnitude&gt;12 then return end
  if (e.talkCooldown or 0)&gt;time then return end;e.talkCooldown=time+6
  local d=e.session.data;local message="My workstation and current task are part of your company's team."
  if e.role=="engineer" then message=if d.training then "I am monitoring the current training run. More GPUs speed up training; a bigger model still needs enough VRAM." else "No training is running. Install enough VRAM in Hardware, then design and train a model in the Lab."
  elseif e.role=="curator" then message=string.format("Your dataset has %.1f%% quality. Good data matters more than choosing a huge model too early.",ModelMath.dataSummary(d.data).quality*100)
  elseif e.role=="researcher" then message=if d.empire.researchJob then "Research is active. Our lab and architecture work generate the same research points shown on your company computer." else "Data and compute come first. Research improves your next generation; evaluation shows the strengths of the model you already trained."
  elseif e.role=="marketer" then message=if e.cache.event.live then string.format("Your live models currently serve %.0f users. Pricing, marketing and target customers all influence growth.",e.session.live.users) else "Train and evaluate a model first. Deployment lets you choose subscription price, API price, target market and marketing." end
  Remote.fire(player,"Notify","CAMPUS_NOTICE",{text=e.name..": "..message})
 end)
end
function Staff.tick(dt: number)
 time+=dt;accumulator+=dt;if accumulator&lt;.2 then return end;accumulator=0
 local positions={};for _,s in Session.all() do if not s.closed and s.player.Character and s.player.Character.PrimaryPart then table.insert(positions,s.player.Character.PrimaryPart.Position) end end
 local hour=Config.hour(time);Lighting.ClockTime=hour
 for _,p in Plot.all() do if p.office and p.owner then
  local s=Session.get(p.owner);if not s or s.closed then continue end
  local c=sync(p,s);events(c,s);c.moving=0;for _,e in c.all do if e.nav then c.moving+=1 end end
  local counts={researcher=0,engineer=0,curator=0,marketer=0};local states={};local visible=0
  for _,e in c.all do
   e.now=time
   local held=e.model:FindFirstChild("EmployeeCup")
   if held and e.carryCupUntil and workspace:GetServerTimeNow()&gt;=e.carryCupUntil then held:Destroy();e.model:SetAttribute("HoldingCup",false);e.carryCupUntil=nil end
   local distance=nearest(e.root.Position,positions);local lod=if distance&gt;Config.FAR then "sleep" elseif distance&gt;Config.NEAR then "reduced" else "full"
   if lod~=e.lod then
    e.lod=lod;e.model:SetAttribute("SimulationLOD",lod)
    if lod=="sleep" then e.humanoid.EvaluateStateMachine=false;Nav.cancel(e);e.root.Anchored=true;e.next=time+4
    elseif e.state~="OFF_DUTY" then e.humanoid.EvaluateStateMachine=true;e.root.Anchored=e.station~=nil and e.station.seat~=nil;e.next=math.min(e.next,time+e.index%11) end
   end
   local productive=1
   if lod~="sleep" then
    visible+=1
    local pos=e.cf:PointToObjectSpace(e.root.Position)
    if not Departments.employeeAllowed(e.role,pos.X,pos.Y,pos.Z,e.tier) then
     -- Security recovery only. This is never used for ordinary movement or a failed path.
     Nav.cancel(e);Workstations.release(e);e.model:PivotTo(e.model:GetAttribute("WorkCFrame"));e.next=time+5;state(e,"SELECT_TASK")
    end
    Nav.tick(e,time)
    local onDuty=e.role=="support" or (hour&gt;=e.personality.start and hour&lt;e.personality.finish)
    if not onDuty and e.state~="OFF_DUTY" and e.state~="LEAVING" and not e.nav then leave(e)
    elseif onDuty and (e.state=="OFF_DUTY" or e.state=="ARRIVING") and not e.nav and time&gt;=e.next then
     e.model:SetAttribute("OffDuty",false);local def=Config.TASKS[e.role][1];local home=Workstations.scan(e.office).byId[e.home] or Workstations.choose(e,def);begin(e,def,home)
    elseif onDuty and not e.nav and time&gt;=e.next then selectTask(e,c,hour) end
    if e.cupAt and time&gt;=e.cupAt then cup(e,e.state=="LUNCH");e.cupAt=nil end
    productive=Config.productive(e.state)
   end
   if counts[e.role] then counts[e.role]+=productive end
   states[e.state]=(states[e.state] or 0)+1
  end
  Workforce.set(s.data.empire,counts)
  s.live.workforce={researcher=counts.researcher,engineer=counts.engineer,curator=counts.curator,marketer=counts.marketer,visible=visible,total=#c.all,hour=hour,states=states}
  c.office:SetAttribute("CompanyHour",hour)
  local machine=c.office:FindFirstChild("KitchenCoffeeMachine");local steam=if machine then machine:FindFirstChild("CoffeeSteam") else nil
  if steam then local brewing=false;for _,e in c.all do if e.state=="COFFEE_BREAK" and e.task and e.task.id=="Coffee" and time-e.taskStarted&lt;4 then brewing=true;break end end;steam.Enabled=brewing end
 end end
 for model,c in caches do if not c.office.Parent then for _,e in c.all do destroy(e) end;caches[model]=nil end end
 Nav.pump(time)
end
function Staff.inspect(office: Model): {any}
 for _,c in caches do if c.office==office then return c.all end end;return {}
end
return Staff
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000017"><Properties><string name="Name">LiftService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One moving cabin per headquarters. Recall, board, travel and release all run on the server.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Departments=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local Plot=require(script.Parent.PlotService)
local Session=require(script.Parent.SessionService)
local Lift={}
local rides: {[Instance]:any}={}
local openDoors: {[Instance]:any}={}
local access: (Player,number)-&gt;boolean=function()return false end
local function height(floor: number): number return if floor==-1 then -24 else floor*16 end
local function landing(office: Model,floor: number,open: boolean)
	for _,door in office:GetChildren() do if door.Name=="LiftLandingDoor" and door:GetAttribute("LiftFloor")==floor then
		local closed=door:GetAttribute("ClosedCFrame");door.CFrame=if open then closed*CFrame.new(9,0,0) else closed;door.CanCollide=not open
		if open then openDoors[door]={left=4,closed=closed} else openDoors[door]=nil end
	end end
end
local function restore(r: any,arrival: boolean)
	if r.root and r.root.Parent then r.root.Anchored=r.anchored end
	if r.humanoid and r.humanoid.Parent then r.humanoid.WalkSpeed=r.speed;r.humanoid.JumpPower=r.jump;r.humanoid.JumpHeight=r.jumpHeight;r.humanoid.AutoRotate=r.autoRotate end
	if r.character and r.character.Parent and (not r.player or r.player.Character==r.character) then
		r.character:PivotTo(if arrival then r.cf*CFrame.new(0,height(r.destination)+4,60) else r.cf*CFrame.new(0,4,-92))
	end
end
local function board(r: any): boolean
	local character=if r.player then r.player.Character else r.npc;local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
	local h=if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not h or h.SeatPart or (root.Position-r.panel.Position).Magnitude&gt;18 or (r.player and not access(r.player,r.owner)) then return false end
	r.root=root;r.character=character;r.humanoid=h;r.anchored=root.Anchored==true;r.speed=h.WalkSpeed or 16;r.jump=h.JumpPower or 50;r.jumpHeight=h.JumpHeight or 7.2;r.autoRotate=h.AutoRotate~=false
	h.Sit=false;root.Anchored=true;h.WalkSpeed=0;h.JumpPower=0;h.JumpHeight=0;h.AutoRotate=false
	character:PivotTo(r.cf*CFrame.new(0,height(r.source)+3.4,69.5))
	return true
end
function Lift.init(check: (Player,number)-&gt;boolean)
	access=check
	Session.onClosing(function(s)
		for office,r in rides do if r.player==s.player or r.owner==s.userId then restore(r,false);rides[office]=nil end end
	end)
end
function Lift.request(s: any,payload: any): any
	local owner=payload.ownerId;local destination=payload.floor
	if typeof(owner)~="number" or typeof(destination)~="number" or destination~=math.floor(destination) then return {ok=false,err="BAD_INPUT"} end
	local p=nil;local tier=0
	for _,peer in Session.all() do if peer.userId==owner and not peer.closed then p=Plot.get(peer.player);tier=peer.data.empire.office;break end end
	if not p or not p.office then return {ok=false,err="PLAYER_OFFLINE"} end
	if destination&lt; -1 or destination&gt;Config.FLOORS[tier] then return {ok=false,err="BAD_INPUT"} end
	if not access(s.player,owner) then return {ok=false,err="CARD_REQUIRED"} end
	local character=s.player.Character;local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
	local h=if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not h then return {ok=false,err="LOADING"} end
	if h.SeatPart then return {ok=false,err="LIFT_SEATED"} end
	local panel=nil;local distance=18
	for _,candidate in p.office:GetChildren() do
		if candidate:IsA("BasePart") and (candidate.Name=="LiftPanel" or candidate.Name=="LiftPanelB1" or candidate.Name=="RoofAccess") then
			local d=(root.Position-candidate.Position).Magnitude
			if d&lt;distance then panel=candidate;distance=d end
		end
	end
	if not panel then return {ok=false,err="LIFT_DISTANCE"} end
	if rides[p.office] then return {ok=false,err="LIFT_BUSY"} end
	local source=panel:GetAttribute("LiftFloor");local cabin=p.office:FindFirstChild("LiftCabin")
	if typeof(source)~="number" or not cabin or not cabin.PrimaryPart then return {ok=false,err="SERVER_ERROR"} end
	if source==destination then character:PivotTo(p.cframe*CFrame.new(0,height(destination)+4,60));return {ok=true} end
	local current=cabin:GetAttribute("CurrentFloor") or 0
	local r={player=s.player,owner=owner,cf=p.cframe,cabin=cabin,panel=panel,office=p.office,source=source,destination=destination,phase="recall",from=height(current),to=height(source),elapsed=0,duration=math.max(.3,math.abs(height(source)-height(current))/22),current=current}
	landing(p.office,current,false);rides[p.office]=r;cabin:SetAttribute("Busy",true)
	return {ok=true,seconds=r.duration+.6+math.abs(height(destination)-height(source))/22}
end
function Lift.requestEmployee(office: Model,cf: CFrame,npc: Model,source: number,destination: number): boolean
 if rides[office] or not office.Parent or npc:FindFirstAncestor("Office")~=office or not npc.PrimaryPart then return false end
 if not npc.Parent or (npc.Parent.Name~="Employees" and npc.Parent.Name~="OperationsEmployees") or npc:GetAttribute("OwnerUserId")~=office:GetAttribute("OwnerUserId") then return false end
 local floors=office:GetAttribute("FloorCount")
 if source&lt; -1 or destination&lt; -1 or source&gt;floors or destination&gt;floors or source==destination then return false end
 local v=cf:PointToObjectSpace(npc.PrimaryPart.Position)
 if math.abs(v.X)&gt;9 or math.abs(v.Y-(height(source)+3))&gt;5 or math.abs(v.Z-60)&gt;10 then return false end
 if not Departments.employeeAllowed(npc:GetAttribute("RoleId") or "support",0,height(destination)+3,60,office:GetAttribute("OfficeTier")) then return false end
 local cabin=office:FindFirstChild("LiftCabin");if not cabin or not cabin.PrimaryPart then return false end
 local panel=nil
 for _,p in office:GetChildren() do if p:IsA("BasePart") and p:GetAttribute("LiftFloor")==source and (p.Name=="LiftPanel" or p.Name=="LiftPanelB1" or p.Name=="RoofAccess") then panel=p;break end end
 if not panel then return false end
 local current=cabin:GetAttribute("CurrentFloor") or 0
 local r={npc=npc,owner=office:GetAttribute("OwnerUserId"),cf=cf,cabin=cabin,panel=panel,office=office,source=source,destination=destination,phase="recall",from=height(current),to=height(source),elapsed=0,duration=math.max(.3,math.abs(height(source)-height(current))/22),current=current}
 rides[office]=r;cabin:SetAttribute("Busy",true);landing(office,current,false);return true
end
function Lift.riding(player: Player): boolean
	for _,r in rides do if r.npc==player or (r.player==player and r.root) then return true end end
	return false
end
function Lift.tick(dt: number)
	for door,record in openDoors do
		if not door.Parent then openDoors[door]=nil
		else record.left-=dt;if record.left&lt;=0 then door.CFrame=record.closed;door.CanCollide=true;openDoors[door]=nil end end
	end
	for office,r in rides do
		if not office.Parent or not r.cabin.Parent or (r.player and (not r.player.Parent or not access(r.player,r.owner))) or (r.npc and not r.npc.Parent)
			or (r.character and ((r.player and r.player.Character~=r.character) or not r.root.Parent or (r.humanoid.Health and r.humanoid.Health&lt;=0))) then
			restore(r,false);rides[office]=nil
			if r.cabin.Parent then r.cabin:SetAttribute("Busy",false);r.cabin:PivotTo(r.cf*CFrame.new(0,height(r.source)-.25,69.5));r.cabin:SetAttribute("CurrentFloor",r.source);landing(office,r.source,false) end
			continue
		end
		r.elapsed+=dt
		if r.phase=="board" then
			if r.elapsed&gt;=.6 then
				landing(office,r.source,false);r.phase="travel";r.elapsed=0;r.from=height(r.source);r.to=height(r.destination);r.duration=math.max(.5,math.abs(r.to-r.from)/22)
			end
		else
			local alpha=math.clamp(r.elapsed/r.duration,0,1);local y=r.from+(r.to-r.from)*alpha
			r.cabin:PivotTo(r.cf*CFrame.new(0,y-.25,69.5))
			if r.root then r.character:PivotTo(r.cf*CFrame.new(0,y+3.4,69.5)) end
			if alpha&gt;=1 then
				if r.phase=="recall" then
					r.cabin:SetAttribute("CurrentFloor",r.source)
					if not board(r) then rides[office]=nil;r.cabin:SetAttribute("Busy",false);continue end
					landing(office,r.source,true);r.phase="board";r.elapsed=0
				else
					r.cabin:SetAttribute("CurrentFloor",r.destination);r.cabin:SetAttribute("Busy",false)
					landing(office,r.destination,true);restore(r,true);rides[office]=nil
				end
			end
		end
	end
end
return Lift
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000018"><Properties><string name="Name">OfficeFacilitiesDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- An original two-storey pavilion: warm stone, cedar, practical fixtures and founder-only rooms.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local K=require(script.Parent.OfficeKit)
local Design={}
local ink=Color3.fromRGB(41,49,46)
local stone=Color3.fromRGB(210,208,193)
local paper=Color3.fromRGB(238,235,221)
local cedar=Color3.fromRGB(165,115,73)
local green=Color3.fromRGB(82,110,85)
local glass=Color3.fromRGB(155,185,176)
local water=Color3.fromRGB(137,193,202)
function Design.build(office: Model,cf: CFrame,session: any,accent: Color3)
	local owner=session.userId
	local function add(name: string,size: Vector3,x: number,y: number,z: number,color: Color3,material: Enum.Material?): Part
		local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf*CFrame.new(x,y,z);p.Anchored=true;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=office;return p
	end
	local function sign(p: BasePart,text: string)
		local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(720,220);gui.LightInfluence=.35;gui.Parent=p
		local label=Instance.new("TextLabel");label.BackgroundTransparency=1;label.Size=UDim2.fromScale(1,1);label.Text=text;label.TextScaled=true;label.TextColor3=paper;label.Font=Enum.Font.BuilderSansBold;label.Parent=gui
	end
	local function action(p: BasePart,id: string,title: string,value: any?,ownerOnly: boolean?): ProximityPrompt
		local q=Instance.new("ProximityPrompt");q.ActionText="Use";q.ObjectText=title;q.MaxActivationDistance=10;q.RequiresLineOfSight=false;q.HoldDuration=.25
		q:SetAttribute("CampusAction",id);q:SetAttribute("Value",value);q:SetAttribute("OwnerOnly",ownerOnly==true);q:SetAttribute("Public",true);q.Parent=p;return q
	end
	local function seat(name: string,x: number,y: number,z: number,width: number?): Seat
		local s=Instance.new("Seat");s.Name=name;s.Size=Vector3.new(width or 3,.5,3);s.CFrame=cf*CFrame.new(x,y+2,z);s.Anchored=true;s.Color=green;s.Material=Enum.Material.Fabric;s.Parent=office
		add("SeatBack",Vector3.new(width or 3,2.5,.5),x,y+3.25,z+1.25,green,Enum.Material.Fabric)
		for _,dx in {-1,1} do add("SeatLeg",Vector3.new(.35,1.75,.35),x+dx,y+1,z,ink,Enum.Material.Metal) end
		return s
	end
	local function sliding(p: BasePart,open: CFrame,room: string,hidden: boolean?)
		p:SetAttribute("ClosedCFrame",p.CFrame);p:SetAttribute("DoorOpenCFrame",cf*open);p:SetAttribute("DoorOwner",owner);p:SetAttribute("RoomId",room)
		action(p,"roomDoor",if hidden then "Founder archive · inspect shelf" else Config.find(Config.ROOMS,room).name,room)
	end
	for f=0,1 do
		local y=f*16
		add("PavilionFloor",Vector3.new(164,.7,80),0,y-.35,120,stone,Enum.Material.Concrete)
		add("PavilionBackWall",Vector3.new(164,15,.8),0,y+7.5,160,stone,Enum.Material.Concrete)
		for _,x in {-82,82} do
			add("PavilionSideGlass",Vector3.new(.4,13,78),x,y+7.5,120,glass,Enum.Material.Glass).Transparency=.3
			for z=88,152,16 do add("PavilionColumn",Vector3.new(1,16,1),x,y+8,z,ink,Enum.Material.Metal) end
		end
		add("PavilionBand",Vector3.new(164,1.2,1),0,y+15.4,160,ink,Enum.Material.Metal)
		local way=add("PavilionWayfinding",Vector3.new(17,3,.3),0,y+7,158.8,green)
		sign(way,if f==0 then "MOVEMENT · WELLNESS" else "FOUNDER SERVICES")
		for _,x in {-68,-21,28,64} do add("PavilionLight",Vector3.new(16,.2,.6),x,y+14,94,paper,Enum.Material.Neon) end
	end
	add("PavilionRoof",Vector3.new(168,.8,82),0,32,120,ink,Enum.Material.Metal)
	for _,r in Config.ROOMS do
		local x=(r.x1+r.x2)/2;local z=(r.z1+r.z2)/2;local y=r.floor*16;local w=r.x2-r.x1;local d=r.z2-r.z1
		add("RoomFloor_"..r.id,Vector3.new(w,.12,d),x,y+.08,z,if r.id=="gym" then ink else cedar,if r.id=="gym" then Enum.Material.SmoothPlastic else Enum.Material.Wood)
		for _,edge in {r.x1,r.x2} do add("RoomWall_"..r.id,Vector3.new(.6,12,d),edge,y+6,z,if r.id=="sauna" then cedar else paper,if r.id=="sauna" then Enum.Material.Wood else Enum.Material.SmoothPlastic) end
		local doorway=if r.hidden then 8 else 7
		for _,side in {-1,1} do add("RoomFront_"..r.id,Vector3.new((w-doorway)/2,12,.6),x+side*(w+doorway)/4,y+6,r.z1,paper) end
		add("RoomLintel_"..r.id,Vector3.new(doorway,2,.6),x,y+11,r.z1,paper)
		if r.id=="archive" or r.id=="sauna" then
			for _,side in {-1,1} do add("RoomBack_"..r.id,Vector3.new((w-8)/2,12,.6),x+side*(w+8)/4,y+6,r.z2,paper) end
		else add("RoomBack_"..r.id,Vector3.new(w,12,.6),x,y+6,r.z2,paper) end
		local door=add(if r.hidden then "SecretBookcase" else "RoomDoor_"..r.id,Vector3.new(doorway,10,.55),x,y+5,r.z1,if r.hidden then cedar else green,if r.hidden then Enum.Material.Wood else Enum.Material.SmoothPlastic)
		door:SetAttribute("DepartmentDoor",true);door:SetAttribute("AccessClass",r.access);door:SetAttribute("OwnerOnly",r.access=="owner")
		local modifier=Instance.new("PathfindingModifier");modifier.PassThrough=r.access~="owner";modifier.Label=if r.access=="owner" then "OwnerOnly" else "StaffDoor";modifier.Parent=door
		sliding(door,CFrame.new(x+doorway+1,y+5,r.z1),r.id,r.hidden)
		if not r.hidden then sign(add("RoomSign_"..r.id,Vector3.new(math.min(w-3,24),2.2,.2),x,y+12.6,r.z1-.35,ink),r.name..(if r.access=="owner" then "  /  PRIVATE" else "")) end
		add("RoomCeilingLight_"..r.id,Vector3.new(w*.65,.18,.7),x,y+13.8,z,paper,Enum.Material.Neon)
		add("InteriorCeiling_"..r.id,Vector3.new(w-.8,.2,d-.8),x,y+14.1,z,paper,Enum.Material.Concrete)
		local light=Instance.new("SurfaceLight");light.Face=Enum.NormalId.Bottom;light.Range=18;light.Brightness=.6;light.Color=if r.id=="sauna" or r.id=="quiet" then Color3.fromRGB(255,223,177) else Color3.fromRGB(239,240,226);light.Shadows=false;light.Parent=office:FindFirstChild("RoomCeilingLight_"..r.id)
	end
	-- Treadmills, bikes and a dumbbell rack. Their prompts run timed, proximity-checked exercises.
	for i=1,3 do
		local x=-74+(i-1)*12
