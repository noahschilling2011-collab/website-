	add("SecretDesk",Vector3.new(25,.6,6),-8,19.1,145,cedar);seat("SecretSeat",-8,16,140,9)
	local secretPC=K.screen(office,cf,"SecretComputer",Vector3.new(9,5,.6),CFrame.new(-8,22,147),"research",accent);action(secretPC,"ownerComputer","Private research computer","lab",true)
	add("SecretKeyboard",Vector3.new(3,.15,1),-8,19.55,144,ink);add("SecretResearchNotes",Vector3.new(2.2,.13,2.7),0,19.5,145,paper)
