local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local ModelMath=require(Shared.ModelMath)
local MarketMath=require(Shared.MarketMath)
local ModelConfig=require(Shared.Config.ModelConfig)
local Hardware=require(Shared.Config.HardwareConfig)
local StudioMath=require(Shared.StudioMath)
local Template=require(script.Parent.Parent.Lib.Template)
local Economy=require(script.Parent.EconomyService)
local NPC={sessions={} :: {any},activities={} :: {any}}
local elapsed=0
local signs: {[number]:TextLabel}={}
local identities={{id=-100000001,name="Morrow Labs",focus="coding",color={126,155,177}},
	{id=-100000002,name="Fern Intelligence",focus="balanced",color={139,166,131}},
	{id=-100000003,name="Kiln Research",focus="reasoning",color={189,141,108}}}
local function note(s: any,text: string)
	s.activity=text
	table.insert(NPC.activities,1,{company=s.data.company.name,text=text,time=workspace:GetServerTimeNow()})
	while #NPC.activities&gt;12 do table.remove(NPC.activities) end
end
local function part(parent: Instance,name: string,size: Vector3,position: Vector3,color: Color3): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;position=Vector3.new(position.X-115,position.Y+24,position.Z-500);p.Position=position;p.CFrame=CFrame.new(position.X,position.Y,position.Z);p.Anchored=true
	p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function office(s: any,index: number)
	local root=workspace:FindFirstChild("RivalQuarter")
	if not root then root=Instance.new("Folder");root.Name="RivalQuarter";root.Parent=workspace end
	local m=Instance.new("Model");m.Name=s.data.company.name;m.Parent=root
	local x=60+(index-1)*55
	local stone=Color3.fromRGB(186,184,169);local dark=Color3.fromRGB(39,51,49);local accent=Color3.fromRGB(unpack(s.rgb))
	part(m,"Foundation",Vector3.new(42,1,34),Vector3.new(x,.6,-148),stone)
	part(m,"Facade",Vector3.new(38,14,1),Vector3.new(x,8,-163),dark)
	part(m,"Roof",Vector3.new(42,1,34),Vector3.new(x,15,-148),stone)
	for _, dx in {-19,19} do part(m,"Column",Vector3.new(1.2,14,32),Vector3.new(x+dx,8,-148),stone) end
	part(m,"SignBand",Vector3.new(36,2,.3),Vector3.new(x,12,-130.5),accent)
	local board=part(m,"CompanyBoard",Vector3.new(30,5,.3),Vector3.new(x,8,-130.3),dark)
	local gui=Instance.new("SurfaceGui");gui.Name="CompanyPrint";gui.Face=Enum.NormalId.Front;gui.PixelsPerStud=28;gui.Parent=board
	local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.TextColor3=Color3.fromRGB(239,235,220);text.Font=Enum.Font.BuilderSansBold;text.TextSize=23;text.TextWrapped=true;text.Text=s.data.company.name;text.Parent=gui;signs[s.userId]=text
	board.CFrame=board.CFrame*CFrame.Angles(0,math.pi,0)
	for unit=1,2 do
		part(m,"RoofVent",Vector3.new(5,.7,4),Vector3.new(x-8+(unit-1)*15,15.9,-152),dark)
		for slat=1,4 do part(m,"VentSlat",Vector3.new(.35,.15,3.5),Vector3.new(x-10+(unit-1)*15+slat*.8,16.3,-152),stone) end
	end
	part(m,"EntryPath",Vector3.new(38,.25,9),Vector3.new(x,.85,-126),Color3.fromRGB(163,172,152))
	for planter=1,2 do
		local px=x-15+(planter-1)*30
		part(m,"Planter",Vector3.new(3,1.4,3),Vector3.new(px,1.5,-126),Color3.fromRGB(147,112,83))
		part(m,"Foliage",Vector3.new(3.8,2.5,3.8),Vector3.new(px,3.2,-126),Color3.fromRGB(99,135,91))
	end
	for slat=1,6 do part(m,"TimberScreen",Vector3.new(.55,5,.5),Vector3.new(x-17+slat,4,-131),Color3.fromRGB(166,128,88)) end
	local light=part(m,"EntryLight",Vector3.new(4,.25,.3),Vector3.new(x,11,-130),Color3.fromRGB(221,199,151));light.Material=Enum.Material.Neon
	local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Inspect rival";prompt.ObjectText=s.data.company.name;prompt.MaxActivationDistance=10;prompt:SetAttribute("Public",true);prompt:SetAttribute("App","arena");prompt.Parent=board
	for desk=1,3 do
		part(m,"Worktable",Vector3.new(8,.5,4),Vector3.new(x-13+(desk-1)*13,3,-151),Color3.fromRGB(162,125,91))
		part(m,"Screen",Vector3.new(3.6,2.3,.25),Vector3.new(x-13+(desk-1)*13,4.5,-152),dark)
		part(m,"Rack",Vector3.new(3,8,3),Vector3.new(x-13+(desk-1)*13,4.8,-159),dark)
		for blade=1,5 do part(m,"ServerFace",Vector3.new(2.5,.5,.25),Vector3.new(x-13+(desk-1)*13,1.5+blade,-157.3),accent) end
	end
end
function NPC.init()
	if #NPC.sessions&gt;0 then return end
	for i,def in identities do
		local d=Template.new();d.company={name=def.name,logo="N",color="mint",spec="general",reputation=15,foundedAt=os.time()}
		d.money=25000+i*5000;d.gpus={workstation=1};d.data={general={tokens=3e9,quality=.7},code={tokens=1e9,quality=.8}}
		d.empire.office=2
		local stats,overall=ModelMath.computeStats("s500m",def.focus,ModelMath.dataSummary(d.data),"general",1,nil)
		local id="npc"..tostring(i)
		d.models[id]={id=id,name=({"Morrow Code","Fern One","Kiln Logic"})[i],version=1,sizeId="s500m",focusId=def.focus,status="live",createdAt=os.time(),trainedAt=os.time(),stats=stats,overall=overall,trainCost=0,dataUsed=ModelMath.dataSummary(d.data),release={subPrice=10,apiPrice=1.5,marketing=0,target="general",releasedAt=os.time()},market=MarketMath.newMarketState("general",0)}
		d.modelOrder={id};d.stats.bestOverall=overall
		local s={userId=def.id,data=d,player={Name=def.name},closed=false,live={revenue=0,cost=0,users=0,perModel={},npcUsers={}},rgb=def.color,focus=def.focus,index=i,iteration=0,pending=nil,activity="Opened the lab",isNPC=true}
		Economy.spend(s,900)
		s.portfolio={id="npc-site-"..tostring(i),name=def.name,kind="website",style=({"paper","slate","brick"})[i],status="published",quality=StudioMath.quality(stats,{stat="coding"}),content=StudioMath.content(def.name,"website",nil),modelName=d.models[id].name,providerId=s.userId}
		table.insert(NPC.sessions,s);office(s,i);note(s,"Opened a self-funded lab")
	end
end
function NPC.tick(dt: number)
	elapsed+=dt
	for _, s in NPC.sessions do
		local d=s.data;local m=d.models[d.modelOrder[1]]
		local pending=s.pending
		if pending then
			pending.remaining-=dt*ModelMath.fleet(d.gpus).throughput
			if pending.remaining&lt;=0 then
				for _,stat in ModelConfig.STATS do
					if stat.weight&gt;0 and stat.id~="reliability" then m.stats[stat.id]+= (2+6*pending.quality)/math.sqrt(1+s.iteration) end
				end
				m.overall=ModelMath.overall(m.stats);m.version+=1;m.iterations=(m.iterations or 0)+1;s.iteration+=1;s.pending=nil;d.training=nil
				d.stats.bestOverall=m.overall;note(s,"Released "..m.name.." v"..tostring(m.version).." · "..tostring(m.overall).." pts")
			end
		end
		local label=signs[s.userId]
		if label then label.Text=d.company.name.."\n"..string.format("%.1f intelligence pts  /  %s",m.overall,s.activity) end
	end
	if elapsed&lt;45 then return end
	elapsed=0
	for _,s in NPC.sessions do
		local d=s.data;local m=d.models[d.modelOrder[1]]
		if s.pending then continue end
		local fleet=ModelMath.fleet(d.gpus)
		local desired=if fleet.throughput&lt;12 then Hardware.getGPU("accelerator") else Hardware.getGPU("datacenter")
		if Hardware.thermal(d.empire,fleet.throughput)&lt;.8 and d.empire.infrastructure.cooling&lt;8 and d.money&gt;12000 then
			if Economy.spend(s,8000) then d.empire.infrastructure.cooling+=1;note(s,"Invested in cooling for sustained compute") end
		elseif desired and d.money&gt;desired.price*1.5 and fleet.slotsUsed&lt;Hardware.slots(d.empire) then
			if Economy.spend(s,desired.price) then d.gpus[desired.id]=(d.gpus[desired.id] or 0)+1;note(s,"Bought "..desired.label.." from its operating budget") end
		elseif d.money&gt;6000+(s.iteration*700) then
			local cost=math.floor(2500+s.iteration*900)
			if Economy.spend(s,cost) then
				ModelMath.addTokens(d.data,"code",8e8,.72+.02*math.min(s.iteration,8))
				d.training={npc=true}
				s.pending={remaining=140+s.iteration*60,quality=ModelMath.dataSummary(d.data).quality}
				note(s,"Training a new checkpoint with fresh data")
			end
		elseif not s.portfolio and d.money&gt;1600 then
			Economy.spend(s,900)
			s.portfolio={id="npc-site-"..tostring(s.index),name=d.company.name,kind="website",style=({"paper","slate","brick"})[s.index],status="published",quality=StudioMath.quality(m.stats,{stat="coding"}),content=StudioMath.content(d.company.name,"website",nil),modelName=m.name,providerId=s.userId}
			note(s,"Built its own company website")
		else
			m.release.apiPrice=math.max(.25,m.release.apiPrice-.1)
			note(s,"Adjusted API price to attract customers")
		end
	end
end
return NPC
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000033"><Properties><string name="Name">StudioService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local Config=require(Shared.Config.StudioConfig)
local Math=require(Shared.StudioMath)
local ModelMath=require(Shared.ModelMath)
local GameConfig=require(Shared.Config.GameConfig)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Guard=require(script.Parent.Parent.Lib.Guard)
local TextFilter=require(script.Parent.Parent.Lib.TextFilter)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local NPC=require(script.Parent.NPCService)
local Service={gallery={} :: {any}}
local function source(data: any,modelId: any): (any,string?)
	if modelId=="licensed" then
		local sub=data.empire.subscriptions
		if not sub.expires or sub.expires&lt;=os.time() then return nil,nil end
		return sub.stats or {coding=sub.score,creativity=sub.score,reliability=60,reasoning=sub.score},sub.name
	end
	local id=Guard.id(modelId);local m=if id then data.models[id] else nil
	if not m or (m.status~="trained" and m.status~="live") then return nil,nil end
	return m.stats,m.name
end
local function build(s: any,p: any): any
	local e=s.data.empire
	if e.projectJob then return {ok=false,err="PROJECT_ACTIVE"} end
	if #e.projectOrder&gt;=30 then return {ok=false,err="PROJECT_LIMIT"} end
	local kind=Config.find(Config.KINDS,p.kind);local style=Config.find(Config.STYLES,p.style)
	local title=Guard.text(p.name,3,28)
	local brief=if p.briefId then Config.find(Config.BRIEFS,p.briefId) else nil
	if not kind or not style or not title or (p.briefId and not brief) or (brief and brief.kind~=kind.id) then return {ok=false,err="BAD_INPUT"} end
	local stats,modelName=source(s.data,p.modelId)
	if not stats then return {ok=false,err="NO_PROJECT_MODEL"} end
	local filtered=TextFilter.forBroadcast(title,s.userId)
	if filtered==nil then return {ok=false,err="FILTER_DOWN"} end
	if filtered~=title then return {ok=false,err="NAME_FILTERED"} end
	-- Text filtering yields, so re-check every mutable precondition before charging.
	if s.closed then return {ok=false,err="LOADING"} end
	if e.projectJob then return {ok=false,err="PROJECT_ACTIVE"} end
	if #e.projectOrder&gt;=30 then return {ok=false,err="PROJECT_LIMIT"} end
	stats,modelName=source(s.data,p.modelId)
	if not stats then return {ok=false,err="NO_PROJECT_MODEL"} end
	if not Economy.spend(s,kind.cost) then return {ok=false,err="NO_MONEY"} end
	local id="project-"..game:GetService("HttpService"):GenerateGUID(false)
	local item={id=id,name=title,kind=kind.id,style=style.id,briefId=if brief then brief.id else nil,
		status="building",quality=Math.quality(stats,kind),content=Math.content(title,kind.id,p.briefId),
		modelName=modelName,sourceId=p.modelId,createdAt=os.time(),visitors=0,revenueTotal=0,delivered=false}
	e.projects[id]=item;table.insert(e.projectOrder,id)
	e.projectJob={id=id,total=kind.work,done=0}
	Session.markDirty(s);return {ok=true,projectId=id}
end
local function project(s: any,p: any): any
	local id=Guard.id(p.projectId)
	return if id then s.data.empire.projects[id] else nil
end
local function publish(s: any,p: any): any
	local item=project(s,p)
	if not item or item.status~="ready" then return {ok=false,err="PROJECT_NOT_READY"} end
	item.status="published";Session.markDirty(s);return {ok=true}
end
local function deliver(s: any,p: any): any
	local item=project(s,p)
	if not item or (item.status~="ready" and item.status~="published") then return {ok=false,err="PROJECT_NOT_READY"} end
	local brief=Config.find(Config.BRIEFS,item.briefId)
	if not brief or item.quality&lt;brief.minimum then return {ok=false,err="PROJECT_QUALITY"} end
	local day=math.floor(os.time()/86400)
	if item.delivered or s.data.empire.deliveries[brief.id]==day then return {ok=false,err="ALREADY_DONE"} end
	item.delivered=true;s.data.empire.deliveries[brief.id]=day
	Economy.applyFlow(s,brief.reward,0);s.data.empire.xp+=100
	Session.markDirty(s);return {ok=true,reward=brief.reward}
end
local function cancel(s: any,_p: any): any
	local e=s.data.empire
	if not e.projectJob then return {ok=false,err="PROJECT_NOT_READY"} end
	local item=e.projects[e.projectJob.id]
	if item then item.status="cancelled" end
	e.projectJob=nil;Session.markDirty(s);return {ok=true}
end
local function archive(s: any,p: any): any
	local item=project(s,p)
	if not item or item.status=="building" then return {ok=false,err="PROJECT_NOT_READY"} end
	local e=s.data.empire;local index=table.find(e.projectOrder,item.id)
	if index then table.remove(e.projectOrder,index) end
	e.projects[item.id]=nil;Session.markDirty(s);return {ok=true}
end
function Service.tick(s: any,dt: number)
	if not s.data.company then return end
	local e=s.data.empire;local job=e.projectJob
	if job then
		local item=e.projects[job.id]
		if not item then e.projectJob=nil
		else
			local stats=source(s.data,item.sourceId)
			if stats then
				local rate=Math.rate(s.data.gpus,e)*(if s.data.training then 1-e.infrastructure.trainingShare else 1)
				job.done=math.min(job.total,job.done+rate*dt)
				if job.done&gt;=job.total then item.status="ready";e.projectJob=nil;Remote.fire(s.player,"Notify","EMPIRE_NOTICE",{text="Project ready: "..item.name}) end
			end
		end
	end
	local revenue=0
	for _,id in e.projectOrder do
		local item=e.projects[id]
		if item and item.status=="published" then
			local rate=math.max(0,item.quality-20)*2/GameConfig.GAME_MONTH_SECONDS
			item.visitors+=item.quality*dt/30;item.revenueTotal+=rate*dt;revenue+=rate
		end
	end
	if revenue&gt;0 then Economy.applyFlow(s,revenue*dt,0);s.live.revenue+=revenue end
	Session.markDirty(s)
end
function Service.refresh()
	local list={}
	for _, s in Session.all() do
		if not s.closed and s.data.company then
			for _, id in s.data.empire.projectOrder do
				local item=s.data.empire.projects[id]
				if item and item.status=="published" then local copy=table.clone(item);copy.company=s.data.company.name;copy.providerId=s.userId;table.insert(list,copy) end
			end
		end
	end
	for _, s in NPC.sessions do
		if s.portfolio then local copy=table.clone(s.portfolio);copy.company=s.data.company.name;table.insert(list,copy) end
	end
	while #list&gt;36 do table.remove(list) end
	Service.gallery=list
	for _, s in Session.all() do s.live.studio={gallery=list} end
end
function Service.init()
	local limit={burst=2,perSecond=.5,company=true}
	Remote.bind("BuildProject",limit,build);Remote.bind("CancelProject",limit,cancel);Remote.bind("ArchiveProject",limit,archive);Remote.bind("PublishProject",limit,publish);Remote.bind("DeliverProject",limit,deliver)
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000034"><Properties><string name="Name">ArenaService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Math=require(ReplicatedStorage.Shared.ArenaMath)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Guard=require(script.Parent.Parent.Lib.Guard)
local Session=require(script.Parent.SessionService)
local NPC=require(script.Parent.NPCService)
local Arena={runs={} :: {[number]:any}}
local lanes={} :: {any}
local function part(parent: Instance,name: string,size: Vector3,x: number,y: number,z: number,color: Color3): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=CFrame.new(x-840,y+24,z);p.Anchored=true;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function pose(lane: any,cell: any,robot: Model?)
	local x=lane.x+(cell.x-5)*4;local z=lane.z+(cell.z-4)*4
	for _, p in (robot or lane.robot):GetChildren() do
		if p:IsA("BasePart") then local offset=p:GetAttribute("Offset");p.CFrame=CFrame.new(x-840,24,z)*CFrame.Angles(0,cell.yaw or 0,0)*CFrame.new(offset.X,offset.Y,offset.Z) end
	end
end
local function makeRobot(parent: Instance,color: Color3): Model
	local robot=Instance.new("Model");robot.Name="CourierRobot";robot.Parent=parent
	for _,def in {{"Body",2.2,2.4,1.5,0,2.2,0},{"Head",2,1.3,1.4,0,4.1,0},{"EyeL",.3,.25,.08,-.5,4.2,-.73},{"EyeR",.3,.25,.08,.5,4.2,-.73},{"LegL",.7,1.1,.8,-.65,.65,0},{"LegR",.7,1.1,.8,.65,.65,0},{"Package",1.6,1.2,1,0,2,-1.2}} do
		local c=if string.sub(def[1],1,3)=="Eye" then Color3.fromRGB(241,232,208) elseif def[1]=="Package" then Color3.fromRGB(173,128,84) else color
		local p=part(robot,def[1],Vector3.new(def[2],def[3],def[4]),def[5],def[6],def[7],c);p.CanCollide=false;p:SetAttribute("Offset",Vector3.new(def[5],def[6]+.8,def[7]))
	end
	return robot
end
local function run(s: any,p: any): any
	if Arena.runs[s.userId] then return {ok=false,err="ARENA_ACTIVE"} end
	local id=Guard.id(p.modelId);local model=if id then s.data.models[id] else nil
	if not model or (model.status~="trained" and model.status~="live") then return {ok=false,err="BAD_MODEL"} end
	local lane:any=nil
	for _, candidate in lanes do if not candidate.owner then lane=candidate;break end end
	if not lane then return {ok=false,err="ARENA_BUSY"} end
	local plan=Math.route(model.stats,#s.data.empire.arenaHistory+1)
	local peer=NPC.sessions[(#s.data.empire.arenaHistory%math.max(1,#NPC.sessions))+1]
	local rival=if peer then peer.data.models[peer.data.modelOrder[1]] else nil
	local opponent=if rival then {name=peer.data.company.name,score=Math.route(rival.stats,1).score} else {name="House courier",score=130}
	local rivalPlan=Math.route(if rival then rival.stats else {reasoning=35,coding=35,reliability=50,speed=50},1)
	local active={lane=lane,plan=plan,rivalPlan=rivalPlan,duration=math.max(plan.seconds,rivalPlan.seconds),elapsed=0,modelId=model.id,modelName=model.name,opponent=opponent,player=s.player}
	lane.owner=s.userId;Arena.runs[s.userId]=active
	pose(lane,plan.path[1]);pose(lane,rivalPlan.path[1],lane.rivalRobot);Session.markDirty(s)
	return {ok=true,lane=lane.index}
end
function Arena.tick(dt: number)
	for userId,runInfo in Arena.runs do
		local s:any=nil
		for _,candidate in Session.all() do if candidate.userId==userId and not candidate.closed then s=candidate;break end end
		if not s then runInfo.lane.owner=nil;Arena.runs[userId]=nil;continue end
		runInfo.elapsed=math.min(runInfo.duration,runInfo.elapsed+dt)
		local step=math.min(runInfo.elapsed/runInfo.plan.stepSeconds,#runInfo.plan.path-1)
		local index=math.min(#runInfo.plan.path,math.floor(step)+1)
		local a=runInfo.plan.path[index];local b=runInfo.plan.path[math.min(#runInfo.plan.path,index+1)]
		local blend=step%1
		pose(runInfo.lane,{x=a.x+(b.x-a.x)*blend,z=a.z+(b.z-a.z)*blend,yaw=if a~=b then math.atan2(-(b.x-a.x),-(b.z-a.z)) else 0})
		local rivalStep=math.min(runInfo.elapsed/runInfo.rivalPlan.stepSeconds,#runInfo.rivalPlan.path-1)
		local ri=math.min(#runInfo.rivalPlan.path,math.floor(rivalStep)+1)
		local ra=runInfo.rivalPlan.path[ri];local rb=runInfo.rivalPlan.path[math.min(#runInfo.rivalPlan.path,ri+1)]
		pose(runInfo.lane,{x=ra.x+(rb.x-ra.x)*(rivalStep%1),z=ra.z+(rb.z-ra.z)*(rivalStep%1),yaw=if ra~=rb then math.atan2(-(rb.x-ra.x),-(rb.z-ra.z)) else 0},runInfo.lane.rivalRobot)
		if runInfo.elapsed&gt;=runInfo.duration then
			local result={name=runInfo.modelName,score=runInfo.plan.score,moves=runInfo.plan.moves,seconds=math.round(runInfo.plan.seconds*10)/10,
				winner=runInfo.plan.score&gt;=runInfo.opponent.score,opponent=runInfo.opponent.name,opponentScore=runInfo.opponent.score,time=os.time()}
			table.insert(s.data.empire.arenaHistory,1,result)
			while #s.data.empire.arenaHistory&gt;12 do table.remove(s.data.empire.arenaHistory) end
			s.data.empire.arenaBest=math.max(s.data.empire.arenaBest,result.score)
			runInfo.lane.owner=nil;Arena.runs[userId]=nil
			Remote.fire(s.player,"Notify","EMPIRE_NOTICE",{text="Courier test complete: "..tostring(result.score).." points"})
		end
		Session.markDirty(s)
	end
	for _,s in Session.all() do
		local info=Arena.runs[s.userId]
		s.live.arena={active=if info then {model=info.modelName,lane=info.lane.index,progress=info.elapsed/info.duration,moves=info.plan.moves,opponent=info.opponent.name} else nil,
			rivals=NPC.activities}
	end
end
function Arena.init()
	local old=workspace:FindFirstChild("TestGrounds");if old then old:Destroy() end
	local root=Instance.new("Model");root.Name="TestGrounds";root.Parent=workspace
	local cream=Color3.fromRGB(194,192,171);local dark=Color3.fromRGB(44,61,52);local green=Color3.fromRGB(118,155,130)
	part(root,"Walkway",Vector3.new(85,.4,20),-222,.3,-61,cream)
	local terminal=part(root,"ArenaTerminal",Vector3.new(4,4,2),-202,2.5,-59,dark)
	local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Open test arena";prompt.ObjectText="Courier Lab";prompt.MaxActivationDistance=12;prompt:SetAttribute("Public",true);prompt:SetAttribute("App","arena");prompt.Parent=terminal
	for laneIndex=1,3 do
		local lane={index=laneIndex,x=-230,z=-91-(laneIndex-1)*34,owner=nil}
		part(root,"CourseDeck",Vector3.new(42,.5,30),lane.x,.4,lane.z,cream)
		for x=1,Math.WIDTH do for z=1,Math.HEIGHT do
			local px=lane.x+(x-5)*4;local pz=lane.z+(z-4)*4
			if Math.blocked(x,z) then part(root,"MazeBarrier",Vector3.new(3.7,2.6,3.7),px,1.95,pz,dark)
			else part(root,"RouteTile",Vector3.new(3.7,.15,3.7),px,.75,pz,if (x==1 or x==9) and z==4 then green else Color3.fromRGB(166,174,155)) end
		end end
		lane.robot=makeRobot(root,({green,Color3.fromRGB(129,153,172),Color3.fromRGB(182,133,94)})[laneIndex])
		lane.rivalRobot=makeRobot(root,Color3.fromRGB(168,133,102))
		for _, p in lane.rivalRobot:GetChildren() do if p:IsA("BasePart") then local v=p:GetAttribute("Offset");p:SetAttribute("Offset",Vector3.new(v.X+.6,v.Y,v.Z+.6)) end end
		pose(lane,{x=1,z=4});pose(lane,{x=1,z=4},lane.rivalRobot);table.insert(lanes,lane)
	end
	Remote.bind("RunArena",{burst=2,perSecond=.25,company=true},run)
end
return Arena
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000035"><Properties><string name="Name">LeaderboardService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Cached cross-server rankings. All DataStore calls run outside the simulation heartbeat.
local DataStoreService=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local Session=require(script.Parent.SessionService)
local Save=require(script.Parent.SaveService)
local Board={boards={} :: {[string]:any},status="Server preview"}
local modes={"overall","coding","math","reasoning","creativity","arena"}
local stores={} :: {[string]:any}
local profiles:any=nil
local busy=false
local elapsed=170
local sent: {[number]:any}={}
local function values(s: any): any
	local result={overall=s.data.stats.bestOverall,arena=s.data.empire.arenaBest,coding=0,math=0,reasoning=0,creativity=0}
	for _, model in s.data.models do
		if model.trainedAt and model.status~="training" then
			for _,mode in {"coding","math","reasoning","creativity"} do result[mode]=math.max(result[mode],model.stats[mode] or 0) end
		end
	end
	return result
end
local function fallback()
	for _,mode in modes do
		local list={}
		for _,s in Session.all() do
			if not s.closed and s.data.company then table.insert(list,{name=s.data.company.name,userId=s.userId,score=values(s)[mode]}) end
		end
		table.sort(list,function(a,b) if a.score==b.score then return a.userId&lt;b.userId end;return a.score&gt;b.score end)
		while #list&gt;10 do table.remove(list) end
		Board.boards[mode]=list
	end
end
function Board.init()
	if RunService:IsStudio() or not Save.enabled then return end
	local ok=pcall(function()
		profiles=DataStoreService:GetDataStore("AIEmpire_BoardProfiles_v1")
		for _,mode in modes do stores[mode]=DataStoreService:GetOrderedDataStore("AIEmpire_Best_"..mode.."_v1") end
	end)
	if ok then Board.status="Global leaderboard" else stores={};Board.status="Server preview · rankings offline" end
end
local function refresh()
	local ok=pcall(function()
		for _,s in Session.all() do
			if not s.closed and s.data.company then
				local scores=values(s);local previous=sent[s.userId] or {};local changed=false
				for _,mode in modes do
					local value=math.min(9007199254740991,math.floor(scores[mode]*10))
					if value&gt;0 and value&gt;(previous[mode] or 0) then
						stores[mode]:UpdateAsync(tostring(s.userId),function(old) return math.max(tonumber(old) or 0,value) end)
						previous[mode]=value;changed=true
					end
				end
				if changed then profiles:SetAsync(tostring(s.userId),{name=s.data.company.name});sent[s.userId]=previous end
			end
		end
		local newBoards={}
		local profileCache={}
		for _,mode in modes do
			local page=stores[mode]:GetSortedAsync(false,10);local list={}
			for _,row in page:GetCurrentPage() do
				local profile=profileCache[row.key]
				if not profile then local readOk,value=pcall(function() return profiles:GetAsync(row.key) end);profile=if readOk and typeof(value)=="table" then value else {name="Company "..row.key};profileCache[row.key]=profile end
				table.insert(list,{userId=tonumber(row.key) or 0,name=profile.name,score=row.value/10})
			end
			newBoards[mode]=list
		end
		Board.boards=newBoards;Board.status="Global leaderboard"
	end)
	if not ok then fallback();Board.status="Global rankings unavailable · server preview" end
	busy=false
end
function Board.tick(dt: number)
	elapsed+=dt
	if next(stores)==nil then fallback()
	elseif elapsed&gt;=180 and not busy then elapsed=0;busy=true;task.spawn(refresh) end
	for _,s in Session.all() do s.live.rankings={status=Board.status,boards=Board.boards} end
end
return Board
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000039"><Properties><string name="Name">EmpireService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config.EmpireConfig)
local Math = require(Shared.EmpireMath)
local ModelMath = require(Shared.ModelMath)
local Workforce=require(Shared.WorkforceMath)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local Economy = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local Empire = {}
local function success(session: any): any
	SessionService.markDirty(session)
	return { ok = true }
end
local function hire(session: any, payload: any): any
	local role = Config.find(Config.ROLES, payload.roleId)
	if not role then return {ok=false, err="BAD_INPUT"} end
	local e = session.data.empire
	local count=if payload.count==nil then 1 else payload.count
	if typeof(count)~="number" or count~=math.floor(count) or count&lt;1 or count&gt;10 then return {ok=false,err="BAD_INPUT"} end
	if Math.staff(e)+count &gt; Config.OFFICES[e.office].staff then return {ok=false, err="STAFF_FULL"} end
	local cost=0
	local owned=e.employees[role.id] or 0
	for i=0,count-1 do cost+=Math.hireCost({employees={[role.id]=owned+i}},role) end
	if not Economy.spend(session,cost) then return {ok=false, err="NO_MONEY"} end
	e.employees[role.id]=owned+count
	PlotService.refresh(session)
	return success(session)
end
local function fire(session: any, payload: any): any
	local role = Config.find(Config.ROLES, payload.roleId)
	if not role then return {ok=false, err="BAD_INPUT"} end
	local e = session.data.empire
	if (e.employees[role.id] or 0) &lt; 1 then return {ok=false, err="NOT_OWNED"} end
	e.employees[role.id] -= 1
	PlotService.refresh(session)
	return success(session)
end
local function research(session: any, payload: any): any
	local def = Config.find(Config.RESEARCH, payload.researchId)
	if not def then return {ok=false, err="BAD_INPUT"} end
	local e = session.data.empire
	if e.research[def.id] then return {ok=false, err="ALREADY_DONE"} end
	if e.researchJob then return {ok=false, err="RESEARCH_ACTIVE"} end
	if def.prereq and not e.research[def.prereq] then return {ok=false, err="PREREQUISITE"} end
	if e.points &lt; def.points then return {ok=false, err="NO_POINTS"} end
	if not Economy.spend(session, def.cost) then return {ok=false, err="NO_MONEY"} end
	e.points -= def.points
	e.researchJob = { id = def.id, elapsed = 0, seconds = def.seconds }
	return success(session)
end
local function upgrade(session: any, _payload: any): any
	local e = session.data.empire
	local def = Config.OFFICES[e.office + 1]
	if not def then return {ok=false, err="MAX_OFFICE"} end
	if not Economy.spend(session, def.price) then return {ok=false, err="NO_MONEY"} end
	e.office += 1
	e.xp += 100
	PlotService.refresh(session)
	Remote.fire(session.player, "Notify", "EMPIRE_NOTICE", { text = "New office unlocked: " .. def.name })
	return success(session)
end
local function quest(session: any, payload: any): any
	local def = Config.find(Config.QUESTS, payload.questId)
	if not def then return {ok=false, err="BAD_INPUT"} end
	local data = session.data
	if data.empire.quests[def.id] then return {ok=false, err="ALREADY_DONE"} end
	if Math.progress(data, def) &lt; def.target then return {ok=false, err="NOT_READY"} end
	-- No yields between eligibility and grant: one reward per quest.
	data.empire.quests[def.id] = true
	data.empire.xp += def.xp
	Economy.grant(session, def.reward)
	return success(session)
end
local function deliver(session: any, payload: any): any
	local def = Config.find(Config.CONTRACTS, payload.contractId)
	if not def or typeof(payload.modelId) ~= "string" then return {ok=false, err="BAD_INPUT"} end
	local data = session.data
	local day = math.floor(os.time() / 86400)
	if data.empire.contracts[def.id] == day then return {ok=false, err="ALREADY_DONE"} end
	if data.empire.office &lt; def.office then return {ok=false, err="OFFICE_REQUIRED"} end
	local model = data.models[payload.modelId]
	if not model or not Math.eligible(model, def) then return {ok=false, err="CONTRACT_REQUIREMENTS"} end
	data.empire.contracts[def.id] = day
	data.empire.contractsCompleted += 1
	data.empire.xp += 90
	data.company.reputation = math.min(100, data.company.reputation + 1.5)
	Economy.grant(session, def.reward)
	Remote.fire(session.player, "Notify", "EMPIRE_NOTICE", {text = def.name .. " accepted your model! +$" .. tostring(def.reward)})
	return success(session)
end
local function daily(session: any, _payload: any): any
	local e = session.data.empire
	local day = math.floor(os.time() / 86400)
	if e.daily.day &gt;= day then return {ok=false, err="ALREADY_DONE"} end
	local streak = if e.daily.day == day - 1 then math.min(7, e.daily.streak + 1) else 1
	e.daily = {day = day, streak = streak}
	local reward = 1000 + (streak - 1) * 500
	e.points += 15
	e.xp += 50
	Economy.grant(session, reward)
	return success(session)
end
function Empire.tick(session: any, dt: number)
	local data = session.data
	if not data.company then return end
	local e = data.empire
	local b = Math.bonuses(e)
	e.seconds += dt
	e.points = math.min(100000, e.points + b.points * dt * (if data.company.spec == "research" then 1.2 else 1))
	local access = e.subscriptions
	if access.expires and access.expires &gt; os.time() then
		e.points = math.min(100000,e.points + math.min(3,access.score/100) * dt)
	end
	e.lastSeen = os.time()
	local job = e.researchJob
	if job then
		job.elapsed = math.min(job.seconds, job.elapsed + dt)
		if job.elapsed &gt;= job.seconds then
			e.research[job.id] = true
			e.researchJob = nil
			e.xp += 150
			local def = Config.find(Config.RESEARCH, job.id)
			Remote.fire(session.player, "Notify", "EMPIRE_NOTICE", {text = "Research complete: " .. (if def then def.name else job.id)})
		end
	end
	local curators = Workforce.count(e,"curator")
	if curators &gt; 0 then
		local total = ModelMath.dataSummary(data.data).total
		local tokens = math.min(curators * 300000 * dt, math.max(0, 1e12 - total))
		if tokens &gt; 0 then
			local quality = if e.research.cleaning then 0.85 else 0.65
			for _, id in {"general", "code", "math"} do ModelMath.addTokens(data.data, id, tokens / 3, quality) end
		end
	end
	-- MarketService sets the model flow first. Staff costs are added once.
	Economy.applyFlow(session, 0, b.wage * dt)
	session.live.cost += b.wage
	e.historyClock += dt
	if e.historyClock &gt;= 10 then
		e.historyClock = 0
		table.insert(e.history, {
			time = workspace:GetServerTimeNow(),
			profit = math.round((session.live.revenue - session.live.cost) * 600) / 10,
			users = math.round(session.live.users),
		})
		while #e.history &gt; 36 do table.remove(e.history, 1) end
	end
	SessionService.markDirty(session)
end
function Empire.init()
	local limit = {burst=3, perSecond=1, company=true}
	Remote.bind("HireEmployee", limit, hire)
	Remote.bind("FireEmployee", limit, fire)
	Remote.bind("StartResearch", limit, research)
	Remote.bind("UpgradeOffice", limit, upgrade)
	Remote.bind("ClaimQuest", limit, quest)
	Remote.bind("DeliverContract", limit, deliver)
	Remote.bind("ClaimDaily", limit, daily)
end
return Empire
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000040"><Properties><string name="Name">OfficeDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Human-scale details: timber desks, cable management, plants and readable signs.
local Design = {}
local INK=Color3.fromRGB(37,44,43)
local TIMBER=Color3.fromRGB(158,119,83)
local PAPER=Color3.fromRGB(218,212,193)
local MINT=Color3.fromRGB(120,200,174)
local function create(parent: Instance,name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?): Part
	local p=Instance.new("Part")
	p.Name=name
	p.Anchored=true
	p.Size=size
	p.CFrame=cf
	p.Color=color
	p.Material=material or Enum.Material.SmoothPlastic
	p.TopSurface=Enum.SurfaceType.Smooth
	p.BottomSurface=Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end
local function words(p: BasePart,text: string,background: Color3,color: Color3)
	local g=Instance.new("SurfaceGui")
	g.Name="Print"
	g.Face=Enum.NormalId.Front
	g.CanvasSize=Vector2.new(900,450)
	g.LightInfluence=0.3
	g.Parent=p
	local label=Instance.new("TextLabel")
	label.Size=UDim2.fromScale(1,1)
	label.BackgroundColor3=background
	label.BorderSizePixel=0
	label.Text=text
	label.TextColor3=color
	label.TextSize=54
	label.Font=Enum.Font.BuilderSansBold
	label.TextWrapped=true
	label.Parent=g
end
function Design.decorate(office: Model,cf: CFrame,tier: number)
	local cooling=office:GetAttribute("CoolingLevel") or 1
	if tier&gt;=2 then
		for rack=1,math.min(3,tier-1) do
			local x=14-rack*5
			create(office,"ComputeCabinet",Vector3.new(3.8,8.5,3),cf*CFrame.new(x,5.2,18.6),INK,Enum.Material.Metal)
			for blade=1,6 do create(office,"ComputeModule",Vector3.new(3.3,.8,.25),cf*CFrame.new(x,1.3+blade*1.15,16.95),Color3.fromRGB(71,88,80),Enum.Material.Metal) end
		end
	end
	for fan=1,math.min(3,cooling) do
		local y=if tier==1 then 1.8 elseif tier==2 then 14.4 elseif tier==3 then 24.1 else 25.4
		local z=if tier==1 then -18 else 17
		create(office,"CoolingUnit",Vector3.new(5,1.6,4),cf*CFrame.new(-15+(fan-1)*6,y,z),Color3.fromRGB(171,174,157),Enum.Material.Metal)
		for slat=1,5 do create(office,"CoolingGrille",Vector3.new(.35,.1,3.4),cf*CFrame.new(-17+(fan-1)*6+slat*.65,y+.85,z),INK,Enum.Material.Metal) end
	end
	local portfolio=create(office,"StudioPortfolio",Vector3.new(5.2,3,.25),cf*CFrame.new(-14,5.2,20.8),PAPER)
	words(portfolio,"PROJECT STUDIO\nBuild something useful.",PAPER,INK)
	local studioPrompt=Instance.new("ProximityPrompt");studioPrompt.ActionText="Open project studio";studioPrompt.ObjectText="Portfolio";studioPrompt.MaxActivationDistance=9;studioPrompt:SetAttribute("OwnerUserId",office:GetAttribute("OwnerUserId"));studioPrompt:SetAttribute("App","studio");studioPrompt.Parent=portfolio

	local function add(name: string,size: Vector3,offset: CFrame,color: Color3,mat: Enum.Material?): Part
		return create(office,name,size,cf*offset,color,mat)
	end
	local back=office:FindFirstChild("BackWall") :: BasePart
	back.Material=Enum.Material.Concrete
	back.Color=Color3.fromRGB(98,105,97)
	local side=office:FindFirstChild("SideWall") :: BasePart
	side.Color=Color3.fromRGB(76,84,80)
	side.Material=Enum.Material.Concrete
	for _,name in {"Strip","UpperStrip","CampusCrown","ClusterLED"} do
		for _,p in office:GetChildren() do
			if p.Name==name and p:IsA("BasePart") then
				p.Material=Enum.Material.Metal
				p.Color=if name=="CampusCrown" then INK else MINT
				if name=="ClusterLED" then p.Size=Vector3.new(3.5,0.18,0.15) end
			end
		end
	end
	local desk=office:FindFirstChild("Desk") :: BasePart
	desk.Size=Vector3.new(9,0.4,3.6)
	desk.CFrame=cf*CFrame.new(-8,4,15)
	desk.Color=TIMBER
	for _,x in {-11.6,-4.4} do add("FounderDeskLeg",Vector3.new(0.35,2.8,2.5),CFrame.new(x,2.6,15),INK,Enum.Material.Metal) end
	local chair=office:FindFirstChild("Chair") :: BasePart
	chair.Size=Vector3.new(2.3,0.35,2.1)
	chair.CFrame=cf*CFrame.new(-8,2.9,11.4)
	add("FounderChairBack",Vector3.new(2.3,2.5,0.4),CFrame.new(-8,4.2,10.5),INK)
	add("ChairStem",Vector3.new(0.45,1.7,0.45),CFrame.new(-8,1.9,11.4),INK,Enum.Material.Metal)
	add("ChairFoot",Vector3.new(2.5,0.2,2.5),CFrame.new(-8,1.15,11.4),INK,Enum.Material.Metal)
	add("MouseMat",Vector3.new(1.6,0.03,1.7),CFrame.new(-5.2,4.22,14.9),Color3.fromRGB(58,70,64)).CanCollide=false
	local mouse=add("Mouse",Vector3.new(0.38,0.18,0.65),CFrame.new(-5.2,4.35,14.9),INK)
	mouse.Shape=Enum.PartType.Ball
	add("Notebook",Vector3.new(1.8,0.13,1.3),CFrame.new(-11,4.3,15.1)*CFrame.Angles(0,math.rad(12),0),PAPER).CanCollide=false
	add("NotebookSpine",Vector3.new(0.12,0.15,1.3),CFrame.new(-11.8,4.3,15.1)*CFrame.Angles(0,math.rad(12),0),INK).CanCollide=false
	local mug=add("Mug",Vector3.new(0.6,0.5,0.5),CFrame.new(-10.7,4.6,13.8)*CFrame.Angles(0,0,math.rad(90)),PAPER)
	mug.Shape=Enum.PartType.Cylinder
	local coffee=add("Coffee",Vector3.new(0.03,0.38,0.38),CFrame.new(-10.7,4.92,13.8)*CFrame.Angles(0,0,math.rad(90)),Color3.fromRGB(60,39,25))
	coffee.Shape=Enum.PartType.Cylinder
	add("CableTray",Vector3.new(7,0.3,0.6),CFrame.new(-8,3.5,16),INK,Enum.Material.Metal)
	add("DeskCable",Vector3.new(0.12,2.5,0.12),CFrame.new(-11.4,2.6,15.9),INK)
	-- Founder wall: timber slats, task board and a numbered room plate.
	for i=1,9 do add("AcousticSlat",Vector3.new(0.35,9,0.3),CFrame.new(-20+i,6.5,20.8),TIMBER,Enum.Material.Wood) end
	local whiteboard=office:FindFirstChild("Whiteboard") :: BasePart
	whiteboard.Color=PAPER
	words(whiteboard,"THIS WEEK\n01  Build the model\n02  Find the customer\n03  Make it better",PAPER,INK)
	local notes={{-0.7,0.5},{0.9,0.2},{0.1,-0.6}}
	for i,xy in notes do
		add("PinnedNote",Vector3.new(0.9,0.8,0.03),CFrame.new(8.1+xy[1],6.7+xy[2],20.7),if i==2 then MINT else Color3.fromRGB(210,178,111)).CanCollide=false
	end
	local room=add("OfficePlate",Vector3.new(3.5,1.4,0.2),CFrame.new(-18,9.2,20.7),INK)
	words(room,string.format("LAB / %02d",tier),INK,PAPER)
	-- Clear ownership-aware interactions for the room's actual stations.
	for _,def in {{"Rack","Hardware","compute"},{"Whiteboard","Company plan","empire"}} do
		local p=office:FindFirstChild(def[1])
		if p then
			local prompt=Instance.new("ProximityPrompt")
			prompt.ActionText="Open"
			prompt.ObjectText=def[2]
			prompt.HoldDuration=0
			prompt.RequiresLineOfSight=false
			prompt.MaxActivationDistance=7
			prompt:SetAttribute("OwnerUserId",office:GetAttribute("OwnerUserId"))
			prompt:SetAttribute("App",def[3])
			prompt.Parent=p
		end
	end
	-- Plants are kept below eye height near paths, taller in unused corners.
	for _,pos in {{-18,16},{if tier&gt;=3 then -20 else 18,-13}} do
		add("PlantPot",Vector3.new(2,1.8,2),CFrame.new(pos[1],1.9,pos[2]),Color3.fromRGB(151,122,98),Enum.Material.Concrete)
		add("PlantStem",Vector3.new(0.18,3.5,0.18),CFrame.new(pos[1],4,pos[2]),TIMBER,Enum.Material.Wood)
		for i=1,3 do
			local leaf=add("PlantLeaf",Vector3.new(2.6,0.3,1.3),CFrame.new(pos[1],3.2+i*0.7,pos[2])*CFrame.Angles(0,i*2,math.rad(20)),Color3.fromRGB(82,116,83))
			leaf.CanCollide=false
		end
	end
	if tier==1 then
		for i=1,3 do add("GarageShelf",Vector3.new(6,0.3,2),CFrame.new(-17,2+i*2.5,17.5),INK,Enum.Material.Metal) end
		add("ShelfBook",Vector3.new(2,0.6,1.4),CFrame.new(-17,7.8,17.5),Color3.fromRGB(156,164,129))
		local poster=add("FounderPoster",Vector3.new(4,5,0.15),CFrame.new(10,7.5,20.8),INK)
		words(poster,"START\nSMALL.\nBUILD\nWELL.",INK,PAPER)
	else
		for _,name in {"Box1","Box2"} do local box=office:FindFirstChild(name);if box then box:Destroy()end end
		add("ReceptionDesk",Vector3.new(6,3,2.4),CFrame.new(-17,2.5,-17),INK,Enum.Material.Wood)
		add("ReceptionTop",Vector3.new(6.3,0.25,2.7),CFrame.new(-17,4.1,-17),TIMBER,Enum.Material.Wood)
		local sign=add("ReceptionPlate",Vector3.new(4,1,0.15),CFrame.new(-17,3.2,-18.3),INK)
		words(sign,"RECEPTION",INK,PAPER)
		add("AreaRug",Vector3.new(25,0.04,10),CFrame.new(0,1.03,1),Color3.fromRGB(71,87,79),Enum.Material.Fabric)
	end
	if tier&gt;=3 then
		-- A useful upstairs meeting space, deliberately separate from server racks.
		add("MeetingTable",Vector3.new(13,0.5,5),CFrame.new(-8,17,5),TIMBER,Enum.Material.Wood)
		for _,z in {1.5,8.5} do
			for _,x in {-12,-8,-4} do
				add("MeetingChair",Vector3.new(2,0.4,2),CFrame.new(x,15.6,z),INK)
				add("MeetingChairLeg",Vector3.new(0.4,1.1,0.4),CFrame.new(x,14.9,z),INK,Enum.Material.Metal)
				add("MeetingChairBack",Vector3.new(2,1.6,0.25),CFrame.new(x,16.5,z+(if z&lt;5 then -0.9 else 0.9)),Color3.fromRGB(72,83,76))
			end
		end
		add("MeetingTableLeg",Vector3.new(1,2.4,1),CFrame.new(-12,15.6,5),INK,Enum.Material.Metal)
		add("MeetingTableLeg",Vector3.new(1,2.4,1),CFrame.new(-4,15.6,5),INK,Enum.Material.Metal)
		for _,x in {-5,2,9} do
			for i=1,6 do
				add("ServerVent",Vector3.new(3.5,0.1,0.12),CFrame.new(x,16+i*0.6,15.2),INK)
			end
		end
	end
	-- Seated Roblox-style staff with faces, chairs and subtle local typing motion.
	local index=0
	for _,head in office:GetChildren() do
		if head.Name=="EmployeeHead" and head:IsA("BasePart") then
			index+=1
			local h=head.CFrame
			local hair=create(office,"StaffHair",Vector3.new(1.04,0.24,1.04),h*CFrame.new(0,0.48,0),if index%2==0 then TIMBER else INK)
			hair.CanCollide=false
			for _,x in {-0.22,0.22} do create(office,"StaffEye",Vector3.new(0.08,0.1,0.03),h*CFrame.new(x,0.04,0.515),INK).CanCollide=false end
			create(office,"StaffSmile",Vector3.new(0.23,0.04,0.03),h*CFrame.new(0,-0.2,0.515),INK).CanCollide=false
			for _,x in {-0.98,0.98} do
				local arm=create(office,"TypingArm",Vector3.new(0.45,1.2,0.5),h*CFrame.new(x,-1.5,0.5)*CFrame.Angles(math.rad(52),0,0),head.Color)
				arm.CanCollide=false
				arm:SetAttribute("RestCFrame",arm.CFrame)
				arm:SetAttribute("IdleArm",true)
			end
			for _,x in {-0.45,0.45} do
				create(office,"StaffLeg",Vector3.new(0.6,1.4,0.6),h*CFrame.new(x,-3,0.25),INK).CanCollide=false
				create(office,"StaffShoe",Vector3.new(0.65,0.3,1),h*CFrame.new(x,-3.8,0.55),Color3.fromRGB(30,34,33)).CanCollide=false
			end
			create(office,"StaffChairSeat",Vector3.new(2,0.3,1.8),h*CFrame.new(0,-2.35,0),INK)
			create(office,"StaffChairBack",Vector3.new(2,1.8,0.3),h*CFrame.new(0,-1.4,-0.65),Color3.fromRGB(72,83,76))
		end
	end
end
return Design
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000041"><Properties><string name="Name">CampusService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- A large drivable tech district. Raised streets leave usable space below each campus.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local SessionService=require(script.Parent.SessionService)
local Campus={board={}}
local boardLabel: TextLabel?=nil
local elapsed=10
local function part(root: Instance,name: string,size: Vector3,x: number,y: number,z: number,color: Color3,material: Enum.Material?): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=CFrame.new(x,y,z);p.Anchored=true;p.Color=color;p.Material=material or Enum.Material.Concrete;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=root;return p
end
local function sign(p: BasePart,text: string): TextLabel
	local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Front;g.CanvasSize=Vector2.new(1200,650);g.LightInfluence=.3;g.Parent=p
	local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1);t.Text=text;t.TextScaled=true;t.TextWrapped=true;t.Font=Enum.Font.BuilderSansBold;t.TextColor3=Color3.fromRGB(235,231,216);t.Parent=g;return t
end
function Campus.init()
	local old=workspace:FindFirstChild("TechDistrict");if old then old:Destroy() end
	local root=Instance.new("Model");root.Name="TechDistrict";root.Parent=workspace
	local ink=Color3.fromRGB(43,51,47);local stone=Color3.fromRGB(186,188,169);local green=Color3.fromRGB(88,117,85);local wood=Color3.fromRGB(158,119,78)
	part(root,"DistrictFoundation",Vector3.new(2300,2,1600),0,-3,0,stone)
	for _,z in {0,-515,515} do
		part(root,"BoulevardSupport",Vector3.new(2100,24,54),0,12,z,stone)
		part(root,"InnovationAvenue",Vector3.new(2100,.2,50),0,24.12,z,ink,Enum.Material.Asphalt)
		for x=-990,990,44 do
			part(root,"LaneMark",Vector3.new(13,.035,.3),x,24.25,z,Color3.fromRGB(229,223,199))
		end
		for _,side in {-1,1} do
			part(root,"Sidewalk",Vector3.new(2100,.65,8),0,24.15,z+side*31,stone)
			for x=-960,960,160 do
				part(root,"LightPost",Vector3.new(.65,16,.65),x,32.5,z+side*31,ink,Enum.Material.Metal)
				local light=part(root,"StreetLight",Vector3.new(6,.35,1.2),x,40.5,z+side*29,Color3.fromRGB(238,220,184),Enum.Material.Neon)
				local point=Instance.new("PointLight");point.Range=28;point.Brightness=.7;point.Color=Color3.fromRGB(238,220,184);point.Parent=light
			end
		end
	end
	for _,x in {-1016,1016} do
		part(root,"LoopSupport",Vector3.new(52,24,1080),x,12,0,stone)
		part(root,"RingRoad",Vector3.new(48,.2,1080),x,24.12,0,ink,Enum.Material.Asphalt)
		for z=-480,480,48 do part(root,"RingMark",Vector3.new(.3,.035,14),x,24.25,z,Color3.fromRGB(229,223,199)) end
	end
	-- Street trees, shaded benches, bicycle racks and crossings give the district a lived-in rhythm.
	for _,z in {-76,76,-574,574} do
		for x=-880,880,160 do
			part(root,"TreeBed",Vector3.new(15,24,15),x,12,z,stone)
			part(root,"TreeTrunk",Vector3.new(1.4,12,1.4),x,30,z,wood,Enum.Material.Wood)
			part(root,"TreeCanopy",Vector3.new(12,9,12),x,38,z,green,Enum.Material.Grass)
			part(root,"Bench",Vector3.new(10,2.2,3),x+22,25.4,z,wood,Enum.Material.Wood)
		end
	end
	for _,x in {-480,160,800} do for i=-3,3 do part(root,"Crosswalk",Vector3.new(2,.04,50),x+i*3,24.28,0,stone) end end
	part(root,"FounderSquare",Vector3.new(104,24,120),1070,12,0,stone)
	local board=part(root,"FounderBoard",Vector3.new(60,28,1.2),1062,41,33,ink,Enum.Material.Metal)
	boardLabel=sign(board,"AI EMPIRE / FOUNDER DISTRICT\nTrain. Build. Grow.")
	local directory=part(root,"DistrictDirectory",Vector3.new(28,14,.7),1062,32,-38,green)
	sign(directory,"CAMPUS DISTRICT\n01—06  NORTH HEADQUARTERS\n07—12  SOUTH HEADQUARTERS\nWEST  COURIER TEST GROUNDS\nNORTH  RIVAL COMPANIES\nRING ROAD  ↔  COMPANY GARAGES")
	for i,def in {{"COMPANY OS","empire"},{"CAMPUS &amp; FLEET","campus"},{"MODEL LAB","lab"}} do
		local terminal=part(root,"PublicTerminal",Vector3.new(7,6,2),1040+(i-1)*16,27.5,-10,ink)
		sign(terminal,def[1]);local q=Instance.new("ProximityPrompt");q.ActionText="Open";q.ObjectText=def[1];q.MaxActivationDistance=12;q.RequiresLineOfSight=false;q:SetAttribute("Public",true);q:SetAttribute("App",def[2]);q.Parent=terminal
	end
	part(root,"WestLabPlatform",Vector3.new(110,24,190),-1070,12,-130,stone)
	part(root,"RivalPromenade",Vector3.new(400,24,128),0,12,-650,stone)
	part(root,"RivalLink",Vector3.new(24,24,150),0,12,-585,stone)
	for _,x in {-48,48} do part(root,"SquarePlanter",Vector3.new(8,2,8),1062+x,25,52,green,Enum.Material.Grass) end
	-- A distant skyline stays clear of the twelve playable campuses.
	for i=1,12 do
		local x=-900+(i-1)*160;local h=44+(i%4)*14
		part(root,"SkylineTower",Vector3.new(48,h,42),x,h/2,-750,Color3.fromRGB(112,123,109))
		for y=10,h-5,12 do part(root,"SkylineWindow",Vector3.new(40,3,.2),x,y,-728.8,Color3.fromRGB(166,181,169),Enum.Material.Glass).CanCollide=false end
	end
end
function Campus.tick(dt: number)
	elapsed+=dt
	if elapsed&gt;=5 then
		elapsed=0
		local board={}
		for _,session in SessionService.all() do
			if not session.closed and session.data.company then
				local data=session.data
				table.insert(board,{name=data.company.name,revenue=data.stats.totalRevenue,users=data.stats.peakUsers,best=data.stats.bestOverall,office=data.empire.office,userId=session.userId})
			end
		end
		table.sort(board,function(a,b)
			if a.best==b.best then return a.userId&lt;b.userId end
			return a.best&gt;b.best
		end)
		Campus.board=board
		local label=boardLabel
		if label then
			local lines={"AI EMPIRE  /  STRONGEST TRAINED AI",""}
			for i=1,math.min(8,#board) do
				local entry=board[i]
				table.insert(lines,string.format("%d. %s  |  %s",i,entry.name,string.format("%.1f pts",entry.best)))
			end
			if #board==0 then table.insert(lines,"Your company could be first.") end
			label.Text=table.concat(lines,"\n")
		end
	end
	for _,session in SessionService.all() do
		session.live.empire={board=Campus.board}
	end
end
return Campus
</ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX00000034"><Properties><string name="Name">Main</string><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">--!strict
-- Server-Einstieg. Reihenfolge ist wichtig:
--   1. Remotes anlegen (Client wartet darauf)
--   2. Speichern prüfen, Welt bauen, Services binden ihre Remotes
--   3. SessionService zuletzt: ab dann werden Spieler geladen
-- Danach ein einziger Heartbeat-Takt für Training, Markt, Autosave und State-Versand.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Server = script.Parent
local Remote = require(Server.Lib.Remote)
local Services = Server.Services
local SaveService = require(Services.SaveService)
local SessionService = require(Services.SessionService)
local PlotService = require(Services.PlotService)
local CompanyService = require(Services.CompanyService)
local DatasetService = require(Services.DatasetService)
local ComputeService = require(Services.ComputeService)
local AIModelService = require(Services.AIModelService)
local MarketService = require(Services.MarketService)
local DebugService = require(Services.DebugService)

local EmpireService = require(Services.EmpireService)
local CampusService = require(Services.CampusService)

local NPCService=require(Services.NPCService)
local StudioService=require(Services.StudioService)
local ArenaService=require(Services.ArenaService)
local LeaderboardService=require(Services.LeaderboardService)

local FacilityService=require(Services.FacilityService)
local VehicleService=require(Services.VehicleService)
local AdminService=require(Services.AdminService)
local StaffService=require(Services.StaffService)
local BuildingStateService=require(Services.BuildingStateService)

local MAX_STEP = 5 -- nach einem Server-Hänger nicht mehr als 5 s auf einmal simulieren

Remote.setup()
SaveService.init()
PlotService.init()
CompanyService.init()
DatasetService.init()
ComputeService.init()
AIModelService.init()
MarketService.init()
DebugService.init()
EmpireService.init()
CampusService.init()
NPCService.init()
StudioService.init()
ArenaService.init()
LeaderboardService.init()
FacilityService.init()
VehicleService.init()
AdminService.init()
StaffService.init()
SessionService.init()

-- Ein Fehler bei einem Spieler darf den Takt der anderen nicht stoppen
local function safely(label: string, fn: () -&gt; ())
	local ok, err = pcall(fn :: () -&gt; any)
	if not ok then
		warn(`[Tick] {label}: {err}`)
	end
end

local function simulate(step: number)
	safely("NPC companies",function() NPCService.tick(step) end)
	safely("Shared market",function() MarketService.tickGlobal(step) end)
	for _, session in SessionService.all() do
		if not session.closed then
			safely("Training " .. session.player.Name, function()
				AIModelService.tick(session, step)
			end)
			safely("Markt " .. session.player.Name, function()
				MarketService.tick(session, step)
			end)
			safely("Empire " .. session.player.Name, function()
				StudioService.tick(session,step)
				EmpireService.tick(session, step)
				FacilityService.economyTick(session,step)
			end)
		end
	end
	StudioService.refresh()
	LeaderboardService.tick(step)
	CampusService.tick(step)
end

local accumulator = 0
local arenaAccumulator=0
local campusAccumulator=0
RunService.Heartbeat:Connect(function(dt: number)
	accumulator += dt
	campusAccumulator+=dt
	if campusAccumulator&gt;=.05 then
		local campusStep=math.min(campusAccumulator,.25);campusAccumulator=0
		safely("Campus access",function()FacilityService.tick(campusStep)end)
		safely("Campus employees",function()StaffService.tick(campusStep)end)
  safely("Company displays",function()BuildingStateService.tick(campusStep)end)
		safely("Company cars",function()VehicleService.tick(campusStep)end)
	end
	arenaAccumulator+=dt
	if arenaAccumulator&gt;=.1 then
		local arenaStep=math.min(arenaAccumulator,.5);arenaAccumulator=0
		safely("Arena animation",function() ArenaService.tick(arenaStep) end)
	end
	if accumulator &gt;= GameConfig.TICK_SECONDS then
		local step = math.min(accumulator, MAX_STEP)
		accumulator = 0
		simulate(step)
		SessionService.autosave(os.clock())
	end
	SessionService.flush(os.clock())
end)

print(`[AI Empire] Server bereit (Speichern: {if SaveService.enabled then "AN" else "AUS"})`)
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000036"><Properties><string name="Name">StarterPlayer</string><bool name="Archivable">true</bool></Properties><Item class="StarterPlayerScripts" referent="RBX00000037"><Properties><string name="Name">StarterPlayerScripts</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000058"><Properties><string name="Name">Client</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000041"><Properties><string name="Name">Controllers</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">ActionController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Einziger Weg, wie die UI den Server um etwas bittet. Schützt vor Doppelklicks und übersetzt
-- Fehlercodes vom Server in verständliche Meldungen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local HardwareConfig = require(ReplicatedStorage.Shared.Config.HardwareConfig)
local Toast = require(script.Parent.Parent.UI.Toast)

export type Result = { [string]: any }

local ActionController = {}

local MESSAGES: { [string]: string } = {
	ADMIN_ONLY="Dieses Admin-Panel gehört dem Roblox-Konto Nonortrttrt.",
	OWNER_ONLY="Nur der Besitzer dieses Grundstücks hat hier Zugriff.",
	LIFT_BUSY="Der Aufzug ist unterwegs. Warte kurz am Bedienfeld.",
	LIFT_DISTANCE="Walk to the lift panel before choosing a floor.",
	LIFT_SEATED="Leave your vehicle before using the lift.",
	CARD_REQUIRED="You need a valid card for this company.",
	SNACK_FULL="Your snack bag holds 16 items. Eat a snack first.",
	MAX_RETAIL="Your stores are fully upgraded.",
	CAR_OCCUPIED="Leave your current car before collecting another.",
	PLAYER_OFFLINE="This player is no longer on the server.",
	PROJECT_ACTIVE="A project is already using your compute.",
	PROJECT_LIMIT="Your studio has reached its 30-project limit.",
	PROJECT_NOT_READY="Wait for this project to finish building.",
	PROJECT_QUALITY="This project does not meet the client quality requirement.",
	NO_PROJECT_MODEL="Train a model or buy an active AI subscription first.",
	ARENA_ACTIVE="Your model is already running a test.",
	ARENA_BUSY="All three courier courses are in use. Try again shortly.",
	MAX_COOLING="Your cooling system is fully upgraded.",
	RATE_LIMIT = "Slow down a little.",
	LOADING = "Still loading your company...",
	SERVER_ERROR = "Something went wrong on the server. Try again.",
	NETWORK = "Connection problem. Try again.",
	NO_COMPANY = "Found your company first.",
	ALREADY_FOUNDED = "Your company already exists.",
	NAME_FILTERED = "That name isn't allowed. Try another one.",
	FILTER_DOWN = "Name check is unavailable right now. Try again in a moment.",
	BAD_INPUT = "That didn't work. Check your input.",
	NO_MONEY = "Not enough money.",
	COOLDOWN = "The scraper is cooling down.",
	RACK_FULL = "Your compute room is full. Expand your office or research Cluster Operations.",
	NEW_DATA = "Add at least 100M new tokens before another refinement run.",
	QUOTE_CHANGED = "The offer changed. Check the new monthly price and try again.",
	SELF_PURCHASE = "This is your own model. Publish it to find customers.",
	ACCESS_ACTIVE = "You already have an active API subscription.",
	SELLER_OFFLINE = "The provider must be on this server to buy or renew access.",
	NOT_OWNED = "You don't own that.",
	TRAINING_ACTIVE = "A training run is already in progress.",
	NO_GPU = "You need a GPU to train.",
	VRAM = "Not enough VRAM for this model size. Buy more GPUs.",
	NO_DATA = "Not enough training data.",
	NO_EVENT = "There is nothing to decide right now.",
	BAD_MODEL = "That model isn't available.",
	NOT_ALLOWED = "Debug tools only work in Studio.",
	NO_TRAINING = "No training is running.",
	STAFF_FULL = "All desks are filled. Upgrade your office or dismiss an employee.",
	ALREADY_DONE = "This reward has already been collected or this upgrade is complete.",
	RESEARCH_ACTIVE = "One research project is already running.",
	PREREQUISITE = "Finish the required research first.",
	NO_POINTS = "Not enough research points. Hire researchers to generate more.",
	MAX_OFFICE = "You already own the largest office.",
	NOT_READY = "Complete this milestone first.",
	OFFICE_REQUIRED = "This customer requires a larger office.",
	CONTRACT_REQUIREMENTS = "Your live model does not meet this contract's requirements.",
	MODEL_LIMIT = "Your company reached the 80-model limit.",
}

local busy: { [string]: boolean } = {}

function ActionController.message(err: string?): string
	if err == "BAD_NAME" then
		return `Company names need {GameConfig.COMPANY_NAME_MIN}-{GameConfig.COMPANY_NAME_MAX} characters, model names {GameConfig.MODEL_NAME_MIN}-{GameConfig.MODEL_NAME_MAX}. No invisible symbols.`
	end
	return if err and MESSAGES[err] then MESSAGES[err] else "Something went wrong."
end

-- Ruft ein Remote auf. Gibt (ok, Antwort) zurück. silent = keine Fehler-Toasts.
function ActionController.call(name: string, payload: { [string]: any }?, silent: boolean?): (boolean, Result)
	if busy[name] then
		return false, { ok = false, err = "BUSY" }
	end
	busy[name] = true
	local remote = Net.getFunction(name)
	local ok, result = pcall(function(): any
		return remote:InvokeServer(payload or {})
	end)
	busy[name] = nil

	if not ok or typeof(result) ~= "table" then
		if not silent then
			Toast.show("error", MESSAGES.NETWORK)
		end
		return false, { ok = false, err = "NETWORK" }
	end
	local response: Result = result
	if response.ok ~= true then
		if not silent then
			Toast.show("error", ActionController.message(response.err))
		end
		return false, response
	end
	return true, response
end

return ActionController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">StateController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Hält den letzten Snapshot vom Server und verteilt Änderungen an die UI.
-- Zwischen zwei Snapshots (1 s) rechnet der Client Geld und Trainingsfortschritt mit denselben
-- Formeln weiter, damit Zahlen flüssig laufen. Wahrheit bleibt immer der Server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local EmpireMath = require(ReplicatedStorage.Shared.EmpireMath)
local Workforce=require(ReplicatedStorage.Shared.WorkforceMath)

local StateController = {}

StateController.snapshot = nil :: Types.Snapshot?
StateController.receivedAt = 0

-- Auswahl im Lab, die auch DATA/COMPUTE für ihre Vorschau nutzen
StateController.ui = {
	sizeId = "s100m",
	focusId = "balanced",
	recipeId = "steady",
}

local changeListeners: { (Types.Snapshot) -&gt; () } = {}
local notifyListeners: { (string, { [string]: any }) -&gt; () } = {}
local uiListeners: { () -&gt; () } = {}

local MAX_EXTRAPOLATE = 3 -- Sekunden; danach lieber stehen bleiben als raten

local function safeCall(label: string, fn: () -&gt; ())
	local ok, err = pcall(fn :: () -&gt; any)
	if not ok then
		warn(`[State] {label}: {err}`)
	end
end

local function apply(snapshot: Types.Snapshot)
	StateController.snapshot = snapshot
 Workforce.set(snapshot.data.empire,snapshot.live.workforce)
	StateController.receivedAt = os.clock()
	for _, listener in changeListeners do
		safeCall("onChange", function()
			listener(snapshot)
		end)
	end
end

function StateController.onChange(listener: (Types.Snapshot) -&gt; ())
	table.insert(changeListeners, listener)
	local current = StateController.snapshot
	if current then
		safeCall("onChange", function()
			listener(current)
		end)
	end
end

function StateController.onNotify(listener: (string, { [string]: any }) -&gt; ())
	table.insert(notifyListeners, listener)
end

function StateController.onUiChange(listener: () -&gt; ())
	table.insert(uiListeners, listener)
end

function StateController.setSelection(sizeId: string, focusId: string)
	local ui = StateController.ui
	if ui.sizeId == sizeId and ui.focusId == focusId then
		return
	end
	ui.sizeId = sizeId
	ui.focusId = focusId
	for _, listener in uiListeners do
		safeCall("onUiChange", listener)
	end
end

function StateController.setRecipe(id: string)
	StateController.ui.recipeId=id
	for _,fn in uiListeners do safeCall("UI recipe",fn) end
end

function StateController.elapsed(): number
	return math.min(MAX_EXTRAPOLATE, os.clock() - StateController.receivedAt)
end

-- Geld inkl. laufender Einnahmen seit dem letzten Snapshot
function StateController.money(): number
	local snapshot = StateController.snapshot
	if not snapshot then
		return 0
	end
	return snapshot.data.money + (snapshot.live.revenue - snapshot.live.cost) * StateController.elapsed()
end

-- (erledigte Arbeit, Gesamtarbeit) mit Vorhersage; pausiert bei offener Entscheidung
function StateController.trainingWork(): (number, number)
	local snapshot = StateController.snapshot
	local training = if snapshot then snapshot.data.training else nil
	if not snapshot or not training then
		return 0, 1
	end
	local event = training.event
	if event and event.pending then
		return training.workDone, training.workTotal
	end
	local rate = EmpireMath.trainingRate(snapshot.data.gpus, training.workTotal, snapshot.data.empire)
	return math.min(training.workTotal, training.workDone + rate * StateController.elapsed()), training.workTotal
end

-- Restsekunden des laufenden Trainings
function StateController.trainingEta(): number
	local snapshot = StateController.snapshot
	local training = if snapshot then snapshot.data.training else nil
	if not snapshot or not training then
		return 0
	end
	local done, total = StateController.trainingWork()
	local rate = EmpireMath.trainingRate(snapshot.data.gpus, training.workTotal, snapshot.data.empire)
	return if rate &gt; 0 then (total - done) / rate else 0
end

function StateController.init()
	Net.getEvent("State").OnClientEvent:Connect(function(snapshot: any)
		if typeof(snapshot) == "table" then
			apply(snapshot :: Types.Snapshot)
		end
	end)
	Net.getEvent("Notify").OnClientEvent:Connect(function(kind: any, payload: any)
		if typeof(kind) ~= "string" then
			return
		end
		local data: { [string]: any } = if typeof(payload) == "table" then payload else {}
		for _, listener in notifyListeners do
			safeCall("onNotify " .. kind, function()
				listener(kind, data)
			end)
		end
	end)

	-- Erster Stand aktiv anfragen (falls das erste State-Event vor unserem Listener kam)
	task.spawn(function()
		local requestState = Net.getFunction("RequestState")
		for attempt = 1, 60 do
			if StateController.snapshot then
				return
			end
			local ok, result = pcall(function(): any
				return requestState:InvokeServer({})
			end)
			if ok and typeof(result) == "table" and result.ok == true and typeof(result.state) == "table" then
				if not StateController.snapshot then
					apply(result.state :: Types.Snapshot)
				end
				return
			end
			task.wait(math.min(2, 0.5 * attempt))
		end
	end)
end

return StateController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">WorldController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Verbindung zur 3D-Welt:
--   - Nur der eigene Laptop zeigt "Use Computer" (fremde Prompts werden lokal ausgeblendet)
--   - Prompt öffnet den Computer
--   - GPU-Blades im Rack pulsieren, solange im Büro trainiert wird (Attribut "Training")

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local State=require(script.Parent.StateController)

local WorldController = {}

local player = Players.LocalPlayer
local armCache: {[Instance]: {BasePart}} = setmetatable({}, {__mode="k"}) :: any

local function isOwn(prompt: ProximityPrompt): boolean
	return prompt:GetAttribute("OwnerUserId") == player.UserId or prompt:GetAttribute("Public") == true
end

local function setupPrompt(inst: Instance)
	if inst:IsA("ProximityPrompt") then
		inst.Enabled = isOwn(inst)
	end
end

local function pulseBlades(plots: Instance, t: number)
	for _, plot in plots:GetChildren() do
		local office = plot:FindFirstChild("Office")
		local blades = if office then office:FindFirstChild("Blades") else nil
		if office and blades then
			local arms = armCache[office]
			if not arms then
				arms = {}
				for _,p in office:GetChildren() do
					if p:IsA("BasePart") and p:GetAttribute("IdleArm") == true then table.insert(arms,p) end
				end
				armCache[office] = arms
			end
			for i,arm in arms do
				local rest = arm:GetAttribute("RestCFrame")
				if typeof(rest) == "CFrame" then
					arm.CFrame = rest * CFrame.Angles(0.03 * math.sin(t * 3.5 + i * 0.8), 0, 0)
				end
			end
			local training = office:GetAttribute("Training") == true
			for _, blade in blades:GetChildren() do
				if blade:IsA("BasePart") then
					if training and blade:GetAttribute("Lit") == true then
						local index = tonumber(string.match(blade.Name, "%d+")) or 1
						blade.Transparency = 0.5 * (0.5 + 0.5 * math.sin(t * 7 + index * 0.9))
					elseif blade.Transparency ~= 0 then
						blade.Transparency = 0
					end
				end
			end
		end
	end
end

function WorldController.init(openComputer: (string?,string?) -&gt; ())
	State.onNotify(function(kind,payload)
		if kind=="OWNER_COMPUTER" and typeof(payload.app)=="string" then openComputer(payload.app) end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who == player and isOwn(prompt) then
			local app = prompt:GetAttribute("App")
			if typeof(app) == "string" then openComputer(app,prompt:GetAttribute("Section")) end
		end
	end)

	task.spawn(function()
		local plots = workspace:WaitForChild("Plots")
		for _, inst in workspace:GetDescendants() do
			setupPrompt(inst)
		end
		workspace.DescendantAdded:Connect(setupPrompt)
		while true do
			pulseBlades(plots, os.clock())
			task.wait(0.1)
		end
	end)
end

return WorldController
