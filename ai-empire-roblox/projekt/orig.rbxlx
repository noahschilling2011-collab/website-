-- A concrete route planner. Skill changes detours and decisions; every move stays inside the course.
local Math={}
Math.WIDTH=9
Math.HEIGHT=7
local walls={"3:1","3:2","3:3","3:5","3:6","5:2","5:3","5:4","5:5","7:1","7:3","7:4","7:6"}
function Math.blocked(x: number,z: number): boolean
	if x&lt;1 or x&gt;Math.WIDTH or z&lt;1 or z&gt;Math.HEIGHT then return true end
	return table.find(walls,tostring(x)..":"..tostring(z))~=nil
end
function Math.route(stats: any,seed: number): any
	local start={x=1,z=4};local goal={x=9,z=4}
	local queue={start};local seen={['1:4']=true};local parent={};local i=1
	while i&lt;=#queue do
		local cell=queue[i];i+=1
		if cell.x==goal.x and cell.z==goal.z then break end
		for _, d in {{1,0},{0,-1},{0,1},{-1,0}} do
			local x,z=cell.x+d[1],cell.z+d[2];local key=tostring(x)..":"..tostring(z)
			if not Math.blocked(x,z) and not seen[key] then
				seen[key]=true;parent[key]=cell;table.insert(queue,{x=x,z=z})
			end
		end
	end
	local path={goal};local cell=goal
	while cell.x~=start.x or cell.z~=start.z do
		cell=parent[tostring(cell.x)..":"..tostring(cell.z)]
		assert(cell,"arena must have a legal route")
		table.insert(path,1,cell)
	end
	local shortest=#path
	local skill=(stats.reasoning or 0)*0.6+(stats.coding or 0)*0.25+(stats.reliability or 0)*0.15
	local detours=math.max(0,math.floor(5/(1+skill/35)+(seed%3)/2)-1)
	for _=1,detours do
		-- Two legal moves away from and back to an existing cell.
		for n=2,#path-1 do
			local p=path[n]
			if not Math.blocked(p.x,p.z+1) then table.insert(path,n+1,{x=p.x,z=p.z+1});table.insert(path,n+2,{x=p.x,z=p.z});break end
		end
	end
	local secondsPerStep=math.clamp(1.8-(stats.speed or 40)/100,0.55,1.5)
	local score=math.round(skill*0.45+100*shortest/#path+20/secondsPerStep)
	return {path=path,shortest=shortest,moves=#path-1,seconds=(#path-1)*secondsPerStep,stepSeconds=secondsPerStep,score=score,detours=detours}
end
function Math.cargo(stats: any): any
	local correct=math.clamp(math.floor((stats.coding or 0)/15),1,8)
	return {correct=correct,total=8,score=correct*12.5}
end
return Math
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000038"><Properties><string name="Name">EmpireMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local Config = require(script.Parent.Config.EmpireConfig)
local ModelMath = require(script.Parent.ModelMath)
local HardwareConfig = require(script.Parent.Config.HardwareConfig)
local ModelConfig = require(script.Parent.Config.ModelConfig)
local CampusMath=require(script.Parent.CampusMath)
local Workforce=require(script.Parent.WorkforceMath)
local Math = {}
function Math.new(): any
	return { campus = CampusMath.new(), office = 1, employees = {}, research = {}, points = 25, researchJob = nil,
		quests = {}, contracts = {}, contractsCompleted = 0, xp = 0, seconds = 0,
		daily = { day = -1, streak = 0 }, lastSeen = 0, history = {}, historyClock = 0, subscriptions = {}, invoices = {}, customers = {}, businessRevenue = 0, projects = {}, projectOrder = {}, projectJob = nil, deliveries = {}, arenaHistory = {}, arenaBest = 0, infrastructure = {cooling=1,trainingShare=0.7} }
end
function Math.staff(e: any): number
	local n = 0
	for _, def in Config.ROLES do n += e.employees[def.id] or 0 end
	return n
end
function Math.hireCost(e: any, role: any): number
	return math.floor(role.price * (1 + 0.05 * (e.employees[role.id] or 0) + 0.001 * (e.employees[role.id] or 0)^2))
end
function Math.bonuses(e: any): any
	local r = e.research
	local speed = 1 + Workforce.count(e,"engineer") * 0.15 + (if r.pipeline then 0.2 else 0) + (if r.cluster then 0.35 else 0)
	local wage = 0
	for _, def in Config.ROLES do wage += (e.employees[def.id] or 0) * def.wage end
	return { speed = speed, wage = wage, revenue = 1 + Workforce.count(e,"marketer") * 0.08 + (if r.distribution then 0.15 else 0),
		serving = if r.quantization then 0.85 else 1,
		core = (if r.architecture then 4 else 0) + (if r.frontier then 6 else 0),
		reliability = if r.alignment then 8 else 0,
		points = Config.OFFICES[e.office].points + Workforce.count(e,"researcher") * 0.6 }
end
function Math.trainingRate(gpus: any, total: number, e: any): number
	return math.min(ModelMath.fleet(gpus).throughput * Math.bonuses(e).speed * HardwareConfig.thermal(e,ModelMath.fleet(gpus).throughput) * (if #(e.customers or {}) &gt; 0 or e.projectJob then e.infrastructure.trainingShare else 1), total / ModelConfig.TRAINING.minSeconds)
end
function Math.boostStats(stats: any, e: any): (any, number)
	local b = Math.bonuses(e)
	for _, stat in ModelConfig.STATS do
		if stat.weight &gt; 0 then
			local value = math.round(((stats[stat.id] or 0) + b.core + (if stat.id == "reliability" then b.reliability else 0)) * 10) / 10
			stats[stat.id] = if stat.id == "reliability" then math.min(99, value) else value
		end
	end
	return stats, ModelMath.overall(stats)
end
function Math.progress(data: any, quest: any): number
	local e = data.empire
	if quest.kind == "company" then return if data.company then 1 else 0 end
	if quest.kind == "tokens" then return ModelMath.dataSummary(data.data).total end
	if quest.kind == "gpus" then return ModelMath.fleet(data.gpus).slotsUsed end
	if quest.kind == "staff" then return Math.staff(e) end
	if quest.kind == "office" then return e.office end
	if quest.kind == "research" then
		local count = 0
		for _, def in Config.RESEARCH do if e.research[def.id] then count += 1 end end
		return count
	end
	if quest.kind == "contractsCompleted" then return e.contractsCompleted end
	return data.stats[quest.kind] or 0
end
function Math.eligible(model: any, contract: any): boolean
	return model.status == "live" and (model.stats[contract.stat] or 0) &gt;= contract.minimum
		and (contract.focus == nil or model.focusId == contract.focus)
end
return Math
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000015"><Properties><string name="Name">ServerScriptService</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000035"><Properties><string name="Name">Server</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">Lib</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Guard</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Eingabeprüfung für alles, was vom Client kommt. Grundsatz: nichts glauben, alles prüfen.
-- Jede Funktion gibt den bereinigten Wert oder nil zurück.

local Guard = {}

function Guard.finite(value: any): number?
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return value
end

function Guard.number(value: any, min: number, max: number): number?
	local n = Guard.finite(value)
	if n == nil or n &lt; min or n &gt; max then
		return nil
	end
	return n
end

function Guard.integer(value: any, min: number, max: number): number?
	local n = Guard.number(value, min, max)
	if n == nil or n % 1 ~= 0 then
		return nil
	end
	return n
end

-- auf ein Raster runden (Slider-Werte) und Floating-Point-Reste abschneiden
function Guard.snap(value: number, step: number): number
	return math.round(math.round(value / step) * step * 100) / 100
end

-- kurze technische IDs (Config-IDs, GUIDs)
function Guard.id(value: any): string?
	if typeof(value) ~= "string" or #value == 0 or #value &gt; 64 then
		return nil
	end
	if string.find(value, "[^%w_%-]") then
		return nil
	end
	return value
end

local function isInvisible(code: number): boolean
	return (code &gt;= 0x200B and code &lt;= 0x200F) -- Zero-Width, LRM/RLM
		or (code &gt;= 0x202A and code &lt;= 0x202E) -- Bidi-Overrides
		or (code &gt;= 0x2066 and code &lt;= 0x2069) -- Bidi-Isolates
		or code == 0xFEFF
end

-- Freitext (Firmen-/Modellnamen): gültiges UTF-8, keine Steuer-/Unsichtbar-Zeichen, Länge in Zeichen.
-- Ersetzt NICHT den Roblox-Textfilter – der kommt danach (Lib/TextFilter).
function Guard.text(value: any, minLength: number, maxLength: number): string?
	if typeof(value) ~= "string" or #value &gt; maxLength * 4 then
		return nil
	end
	if utf8.len(value) == nil then
		return nil
	end
	local cleaned = (string.gsub(value, "%s+", " "))
	cleaned = string.match(cleaned, "^%s*(.-)%s*$") or ""
	if string.find(cleaned, "%c") then
		return nil
	end
	for _, code in utf8.codes(cleaned) do
		if isInvisible(code) then
			return nil
		end
	end
	local length = utf8.len(cleaned) or 0
	if length &lt; minLength or length &gt; maxLength then
		return nil
	end
	return cleaned
end

return Guard
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">RateLimiter</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Token-Bucket pro Spieler: `burst` Anfragen sofort, danach `perSecond` nachfüllend.

export type Limiter = {
	allow: (player: Player) -&gt; boolean,
	forget: (player: Player) -&gt; (),
}

type Bucket = { tokens: number, last: number }

local RateLimiter = {}

function RateLimiter.new(burst: number, perSecond: number): Limiter
	local buckets: { [Player]: Bucket } = {}

	local function allow(player: Player): boolean
		local now = os.clock()
		local bucket = buckets[player]
		if not bucket then
			bucket = { tokens = burst, last = now }
			buckets[player] = bucket
		end
		bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * perSecond)
		bucket.last = now
		if bucket.tokens &lt; 1 then
			return false
		end
		bucket.tokens -= 1
		return true
	end

	local function forget(player: Player)
		buckets[player] = nil
	end

	return { allow = allow, forget = forget }
end

return RateLimiter
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Remote</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Sicherheits-Schicht für alle Client-Anfragen:
--   1. Rate-Limit pro Spieler und Remote
--   2. Spielerdaten müssen geladen sein
--   3. Payload muss eine Tabelle sein (Felder prüft der Handler mit Guard)
--   4. Fehler im Handler werden abgefangen -&gt; Client bekommt nur einen Code, nie einen Stacktrace

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)
local ServerTypes = require(script.Parent.ServerTypes)

type Session = ServerTypes.Session
-- company = true: Aktion erst nach der Firmengründung erlaubt
export type Limits = { burst: number, perSecond: number, company: boolean? }

local Remote = {}

local folder: Folder? = nil
local limiters: { RateLimiter.Limiter } = {}
local sessionProvider: (Player) -&gt; Session? = function(_player: Player)
	return nil
end

function Remote.setup()
	assert(folder == nil, "Remote.setup doppelt aufgerufen")
	local created = Instance.new("Folder")
	created.Name = Net.FOLDER
	for _, name in Net.FUNCTIONS do
		local fn = Instance.new("RemoteFunction")
		fn.Name = name
		fn.Parent = created
	end
	for _, name in Net.EVENTS do
		local event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = created
	end
	created.Parent = ReplicatedStorage
	folder = created

	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in limiters do
			limiter.forget(player)
		end
	end)
end

-- SessionService meldet sich hier an (kein zirkuläres require)
function Remote.setSessionProvider(provider: (Player) -&gt; Session?)
	sessionProvider = provider
end

function Remote.bind(name: string, limits: Limits, handler: ServerTypes.Handler)
	assert(folder, "Remote.setup zuerst aufrufen")
	local fn = folder:FindFirstChild(name)
	assert(fn and fn:IsA("RemoteFunction"), "Unbekanntes Remote: " .. name)
	local limiter = RateLimiter.new(limits.burst, limits.perSecond)
	table.insert(limiters, limiter)

	fn.OnServerInvoke = function(player: Player, payload: any): ServerTypes.Result
		if not limiter.allow(player) then
			return { ok = false, err = "RATE_LIMIT" }
		end
		local session = sessionProvider(player)
		if not session or session.closed then
			return { ok = false, err = "LOADING" }
		end
		if limits.company and not session.data.company then
			return { ok = false, err = "NO_COMPANY" }
		end
		local cleanPayload: ServerTypes.Payload = if typeof(payload) == "table" then payload else {}
		local ok, result = pcall(handler, session, cleanPayload)
		if not ok then
			warn(`[Remote] {name} von {player.Name} fehlgeschlagen: {result}`)
			return { ok = false, err = "SERVER_ERROR" }
		end
		return result
	end
end

function Remote.fire(player: Player, name: string, ...: any)
	assert(folder, "Remote.setup zuerst aufrufen")
	local event = folder:FindFirstChild(name)
	if event and event:IsA("RemoteEvent") then
		event:FireClient(player, ...)
	end
end

return Remote
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">ServerTypes</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Server-interne Typen. Eigenes Modul, damit Lib und Services sich nicht gegenseitig requiren müssen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)

export type Session = {
	player: Player,
	userId: number,
	data: Types.PlayerData,
	live: Types.LiveInfo, -- Laufzeitwerte, nicht gespeichert
	dirty: boolean,
	lastSent: number,
	nextSaveAt: number,
	saving: boolean,
	closed: boolean, -- keine Änderungen/Saves mehr
	released: boolean, -- Schließen läuft bereits
	rng: Random,
}

export type Payload = { [string]: any }
export type Result = { [string]: any }
export type Handler = (session: Session, payload: Payload) -&gt; Result

return {}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Template</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Startdaten eines neuen Spielers + Migrationen alter Spielstände.
--
-- Neues Feld in einer späteren Phase:
--   1. GameConfig.DATA_VERSION um 1 erhöhen
--   2. hier in MIGRATIONS[alteVersion] das Feld setzen (z. B. data.employees = {})
--   3. Template.new() um das Feld ergänzen
-- Alte Spielstände werden beim Laden Schritt für Schritt hochgezogen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

local EmpireMath = require(ReplicatedStorage.Shared.EmpireMath)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local Template = {}

function Template.new(): Types.PlayerData
	return {
		version = GameConfig.DATA_VERSION,
		empire = EmpireMath.new(),
		company = nil,
		money = GameConfig.START_MONEY,
		data = {},
		gpus = { laptop = 1 },
		models = {},
		modelOrder = {},
		training = nil,
		lastScrapeAt = 0,
		stats = {
			totalRevenue = 0,
			totalCost = 0,
			modelsTrained = 0,
			modelsReleased = 0,
			peakUsers = 0,
			bestOverall = 0,
		},
	}
end

-- MIGRATIONS[v] hebt einen Spielstand von Version v auf v + 1.
local MIGRATIONS: { [number]: (data: any) -&gt; () } = {
	[1] = function(data: any) data.empire = EmpireMath.new() end,
	[3] = function(data: any) end,
	[4] = function(data: any) end,
	[2] = function(data: any) end, -- nested defaults preserve existing founder progress
}

-- Gibt (Daten, nil) oder (nil, Grund) zurück. Ein Grund bedeutet: NICHT überschreiben, Spieler kicken.
function Template.migrate(raw: any): (Types.PlayerData?, string?)
	if typeof(raw) ~= "table" then
		if raw == nil then return Template.new(), nil end
		return nil, "invalid save; original preserved"
	end
	local version = if typeof(raw.version) == "number" then raw.version else 0
	if version &gt; GameConfig.DATA_VERSION then
		return nil, "save is from a newer game version"
	end
	while version &lt; GameConfig.DATA_VERSION do
		local step = MIGRATIONS[version]
		if step then
			step(raw)
		end
		version += 1
	end
	raw.version = version

	-- fehlende Felder auffüllen: robust gegen halbe Spielstände
	local defaults: any = Template.new()
	for key, value in defaults do
		if raw[key] == nil then
			raw[key] = value
		end
	end
	if typeof(raw.stats) ~= "table" then
		raw.stats = defaults.stats
	end
	for key, value in defaults.stats do
		if raw.stats[key] == nil then
			raw.stats[key] = value
		end
	end
	-- Nested defaults protect migrations without clearing existing progress.
	if typeof(raw.empire) ~= "table" then raw.empire = EmpireMath.new() end
	for key, value in EmpireMath.new() do
		if raw.empire[key] == nil then raw.empire[key] = value end
	end
	local e = raw.empire
	for _, key in {"employees", "research", "quests", "contracts", "history", "subscriptions", "invoices", "customers", "projects", "projectOrder", "deliveries", "arenaHistory"} do
		if typeof(e[key]) ~= "table" then e[key] = {} end
	end
	if typeof(e.infrastructure)~="table" then e.infrastructure={cooling=1,trainingShare=0.7} end
	e.infrastructure.cooling=math.clamp(math.floor(tonumber(e.infrastructure.cooling) or 1),1,8)
	e.infrastructure.trainingShare=math.clamp(tonumber(e.infrastructure.trainingShare) or 0.7,0.25,0.9)
	if e.projectJob~=nil and typeof(e.projectJob)~="table" then e.projectJob=nil end
	e.arenaBest=math.max(0,tonumber(e.arenaBest) or 0)
	e.historyClock = math.clamp(tonumber(e.historyClock) or 0,0,10)
	if typeof(e.daily) ~= "table" then e.daily = {day=-1,streak=0} end
	e.daily.day = tonumber(e.daily.day) or -1
	e.daily.streak = math.clamp(math.floor(tonumber(e.daily.streak) or 0),0,7)
	e.office = math.clamp(math.floor(tonumber(e.office) or 1),1,4)
	local remaining=EmpireConfig.OFFICES[e.office].staff
	local cleanEmployees={}
	for _,role in EmpireConfig.ROLES do
		local n=tonumber(e.employees[role.id]) or 0
		if n~=n or n==math.huge or n==-math.huge then n=0 end
		n=math.clamp(math.floor(n),0,remaining);cleanEmployees[role.id]=n;remaining-=n
	end
	e.employees=cleanEmployees
	if typeof(e.campus)~="table" then e.campus=CampusMath.new() end
	local c=e.campus
	for k,v in CampusMath.new() do if c[k]==nil then c[k]=v end end
	local function number(value: any,default: number): number
		local n=tonumber(value);return if n and n==n and n&lt;math.huge and n&gt; -math.huge then n else default
	end
	c.retailLevel=math.clamp(math.floor(number(c.retailLevel,1)),1,4)
	c.retailClock=math.clamp(number(c.retailClock,0),0,29.99)
	c.retailSales=math.max(0,math.floor(number(c.retailSales,0)));c.retailRevenue=math.max(0,number(c.retailRevenue,0))
	c.boostUntil=math.clamp(number(c.boostUntil,0),0,os.time()+240);c.boostSpeed=math.clamp(number(c.boostSpeed,16),16,21)
	local snacks={};local slots=16
	for _,def in CampusConfig.SNACKS do
		local count=if typeof(c.snacks)=="table" then number(c.snacks[def.id],0) else 0
		count=math.clamp(math.floor(count),0,slots);snacks[def.id]=count;slots-=count
	end
	c.snacks=snacks
	local cars={compact=true}
	for _,def in CampusConfig.CARS do if typeof(c.cars)=="table" and c.cars[def.id]==true then cars[def.id]=true end end
	c.cars=cars;c.selectedCar=if typeof(c.selectedCar)=="string" and cars[c.selectedCar] then c.selectedCar else "compact"
	for _,key in {"points","xp","seconds","contractsCompleted"} do
		e[key] = math.max(0, tonumber(e[key]) or 0)
	end
	return raw :: Types.PlayerData, nil
end

return Template
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">TextFilter</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Roblox-Pflicht: Text, den andere Spieler sehen (Firmen- und Modellnamen), muss gefiltert werden.

local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")

local TextFilter = {}

-- Gibt den gefilterten Text zurück, oder nil, wenn der Filter nicht erreichbar ist. Yieldet.
function TextFilter.forBroadcast(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and typeof(result) == "string" then
		return result
	end
	-- ungeprüft: ob der Filter in einem unveröffentlichten Studio-Ort fehlschlägt. Falls ja, darf Studio
	-- weiterlaufen (niemand sonst sieht den Text). Auf echten Servern wird ohne Filter abgelehnt.
	if RunService:IsStudio() then
		return text
	end
	warn("[TextFilter] Filter nicht erreichbar:", result)
	return nil
end

return TextFilter
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000033"><Properties><string name="Name">Services</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">AIModelService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- KI-Modelle: Training starten und fortschreiben, Trainings-Events, Release, Preise, Retire.
--
-- Ablauf eines Trainings:
--   StartTraining prüft Name/Größe/Fokus, plant mit ModelMath (GPU, VRAM, Daten, Kosten) und zieht
--   die Kosten ab. tick() schreibt jede Sekunde Arbeit fort (GPU-Käufe beschleunigen sofort).
--   Bei eventAt (35 %) wird einmal ein Event gewürfelt. Entscheidungs-Events pausieren das Training,
--   bis der Spieler wählt oder der Timer abläuft (dann gilt die Default-Wahl).
--   Am Ende berechnet computeStats die Stats aus den Daten vom Trainingsstart (Daten werden nicht verbraucht).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local ModelConfig = require(ReplicatedStorage.Shared.Config.ModelConfig)
local MarketConfig = require(ReplicatedStorage.Shared.Config.MarketConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local EmpireMath = require(ReplicatedStorage.Shared.EmpireMath)
local MarketMath = require(ReplicatedStorage.Shared.MarketMath)
local Format = require(ReplicatedStorage.Shared.Format)
local Types = require(ReplicatedStorage.Shared.Types)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local TextFilter = require(script.Parent.Parent.Lib.TextFilter)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)

type Session = ServerTypes.Session
type TrainingState = Types.TrainingState
type EventDef = ModelConfig.EventDef
type ChoiceDef = ModelConfig.ChoiceDef

local T = ModelConfig.TRAINING
local EPOCHS = 10

local AIModelService = {}

local function addLog(training: TrainingState, line: string)
	table.insert(training.log, line)
	while #training.log &gt; T.logLines do
		table.remove(training.log, 1)
	end
end

local function specOf(session: Session): string
	local company = session.data.company
	return if company then company.spec else "general"
end

-- "Nova" -&gt; Version 1, zweites "Nova" -&gt; Version 2 (Anzeige "Nova v2")
local function versionFor(data: Types.PlayerData, name: string): number
	local lower = string.lower(name)
	local count = 0
	for _, model in data.models do
		if string.lower(model.name) == lower then
			count += 1
		end
	end
	return count + 1
end

local function bestOverallExcept(data: Types.PlayerData, exceptId: string): number
	local best = 0
	for id, model in data.models do
		if id ~= exceptId and model.status ~= "training" then
			best = math.max(best, model.overall)
		end
	end
	return best
end

-- Loss-Punkte gleichmäßig über den Fortschritt (Punkt i gehört zu Fortschritt (i-1)/(N-1))
local function updateLoss(session: Session, training: TrainingState)
	local progress = training.workDone / training.workTotal
	local wanted = math.clamp(math.floor(progress * (T.lossPoints - 1)) + 1, 1, T.lossPoints)
	while #training.loss &lt; wanted do
		local p = #training.loss / (T.lossPoints - 1)
		local value = ModelMath.lossAt(p, training.expected, session.rng:NextNumber(-0.05, 0.05))
		table.insert(training.loss, math.round(value * 1000) / 1000)
	end
end

local function logEpochs(training: TrainingState)
	local epoch = math.min(EPOCHS - 1, math.floor(training.workDone / training.workTotal * EPOCHS))
	while training.epoch &lt; epoch do
		training.epoch += 1
		local loss = training.loss[#training.loss] or T.lossStart
		addLog(training, string.format("Epoch %d/%d  loss %.3f", training.epoch, EPOCHS, loss))
	end
end

local function stretchRemaining(training: TrainingState, timeMult: number)
	local remaining = training.workTotal - training.workDone
	training.workTotal = training.workDone + remaining * timeMult
end

-- Wendet eine Event-Wahl an. Gibt einen Fehlercode zurück oder nil.
local function applyChoice(session: Session, training: TrainingState, choice: ChoiceDef, auto: boolean): string?
	local event = training.event
	if not event or not event.pending then
		return "NO_EVENT"
	end
	if choice.costFactor then
		local extra = math.floor(training.cost * choice.costFactor)
		if not EconomyService.spend(session, extra) then
			return "NO_MONEY"
		end
		training.cost += extra
	end
	if choice.timeMult then
		stretchRemaining(training, choice.timeMult)
	end
	local note = choice.desc
	if choice.quality then
		local hit = true
		if choice.gamble then
			hit = session.rng:NextNumber() &lt; choice.gamble
		end
		if hit then
			training.qualityMod *= choice.quality
			note = if choice.gamble then "quality took a hit" else choice.desc
		else
			note = "loss recovered, no damage"
		end
		event.outcome = if hit then choice.id else choice.id .. "_lucky"
	else
		event.outcome = choice.id
	end
	event.pending = false
	addLog(training, (if auto then "Timeout -&gt; " else "") .. choice.label .. ": " .. note)
	return nil
end

-- Timeout: Default-Wahl; falls die Geld kostet und keins da ist, die nächste kostenlose Option
local function autoResolve(session: Session, training: TrainingState, def: EventDef)
	local ordered: { ChoiceDef } = {}
	local default = if def.default then ModelConfig.getChoice(def, def.default) else nil
	if default then
		table.insert(ordered, default)
	end
	local choices = def.choices
	if choices then
		for _, choice in choices do
			if choice ~= default then
				table.insert(ordered, choice)
			end
		end
	end
	for _, choice in ordered do
		if applyChoice(session, training, choice, true) == nil then
			return
		end
	end
	local event = training.event
	if event then
		event.pending = false
		event.outcome = "skipped"
	end
end

local function rollEvent(session: Session, training: TrainingState, now: number)
	training.eventRolled = true
	local def = ModelMath.rollEvent(function()
		return session.rng:NextNumber()
	end, specOf(session))
	if not def then
		return
	end
	if def.choices then
		training.event = { id = def.id, pending = true, expiresAt = now + T.decisionTimeout, outcome = nil }
		if def.id == "instability" and #training.loss &gt; 0 then
			training.loss[#training.loss] += 0.8 -- sichtbarer Ausschlag im Graphen
		end
		addLog(training, "[!] " .. def.title)
		Remote.fire(session.player, "Notify", "TRAINING_EVENT", { eventId = def.id })
	else
		if def.timeMult then
			stretchRemaining(training, def.timeMult)
		end
		if def.quality then
			training.qualityMod *= def.quality
		end
		training.event = { id = def.id, pending = false, expiresAt = 0, outcome = "auto" }
		addLog(training, "[*] " .. def.title .. ": " .. def.text)
	end
end

local function finish(session: Session, training: TrainingState)
	local data = session.data
	data.training = nil
	local model = data.models[training.modelId]
	if model then
		local stats, overall = ModelMath.computeStats(
			model.sizeId,
			model.focusId,
			model.dataUsed,
			specOf(session),
			training.qualityMod,
			function(n: number): number
				return session.rng:NextNumber(-n, n)
			end
		)
		stats, overall = EmpireMath.boostStats(stats, data.empire)
		if training.refinement and training.baseStats then
			for _, stat in ModelConfig.STATS do
				if stat.weight &gt; 0 and stat.id ~= "reliability" then
					local gain = (2 + 8 * model.dataUsed.quality) * (training.baseStats[stat.id] or 50) / 50 * training.qualityMod / math.sqrt(1 + (model.iterations or 0))
					stats[stat.id] = math.round(((training.baseStats[stat.id] or 1) + gain) * 10) / 10
				end
			end
			model.iterations = (model.iterations or 0) + 1
			model.version += 1
			overall = ModelMath.overall(stats)
		end
		local previousBest = bestOverallExcept(data, model.id)
		model.stats = stats
		model.overall = overall
		model.status = if training.resumeLive then "live" else "trained"
		model.trainedAt = os.time()
		model.trainCost = if training.refinement then model.trainCost + training.cost else training.cost
		data.stats.bestOverall = math.max(data.stats.bestOverall, overall)
		data.stats.modelsTrained += 1
		Remote.fire(session.player, "Notify", "TRAINING_COMPLETE", {
			modelId = model.id,
			overall = overall,
			previousBest = previousBest,
		})
	end
	SessionService.markDirty(session)
	PlotService.refresh(session)
end

-- Einmal pro Server-Tick für jede Session
function AIModelService.tick(session: Session, dt: number)
	local training = session.data.training
	if not training then
		return
	end
	if not session.data.models[training.modelId] then
		session.data.training = nil -- kaputter Zustand: Training ohne Modell
		SessionService.markDirty(session)
		return
	end

	local now = workspace:GetServerTimeNow()
	local event = training.event
	if event and event.pending then
		if now &lt; event.expiresAt then
			return -- pausiert, wartet auf Entscheidung
		end
		local def = ModelConfig.getEvent(event.id)
		if def then
			autoResolve(session, training, def)
		else
			event.pending = false
		end
	end

	local rate = EmpireMath.trainingRate(session.data.gpus, training.workTotal, session.data.empire)
	training.workDone = math.min(training.workTotal, training.workDone + rate * dt)
	updateLoss(session, training)
	if not training.eventRolled and training.workDone / training.workTotal &gt;= T.eventAt then
		rollEvent(session, training, now)
	end
	logEpochs(training)
	SessionService.markDirty(session)

	local pending = training.event ~= nil and (training.event :: Types.TrainingEventState).pending
	if training.workDone &gt;= training.workTotal and not pending then
		finish(session, training)
	end
end

-- Debug: Training sofort abschließen
function AIModelService.finishNow(session: Session): boolean
	local training = session.data.training
	if not training then
		return false
	end
	local event = training.event
	if event and event.pending then
		local def = ModelConfig.getEvent(event.id)
		if def then
			autoResolve(session, training, def)
		end
	end
	training.workDone = training.workTotal
	updateLoss(session, training)
	finish(session, training)
	return true
end

local function startTraining(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local recipeId=if payload.recipeId==nil then "steady" else Guard.id(payload.recipeId)
	if not recipeId or not ModelConfig.getRecipe(recipeId) then return {ok=false,err="BAD_INPUT"} end
	if session.data.training then
		return { ok = false, err = "TRAINING_ACTIVE" }
	end
	local name = Guard.text(payload.name, GameConfig.MODEL_NAME_MIN, GameConfig.MODEL_NAME_MAX)
	if not name then
		return { ok = false, err = "BAD_NAME" }
	end
	local sizeId = Guard.id(payload.sizeId)
	local focusId = Guard.id(payload.focusId)
	local size = if sizeId then ModelConfig.getSize(sizeId) else nil
	local focus = if focusId then ModelConfig.getFocus(focusId) else nil
	if not size or not focus then
		return { ok = false, err = "BAD_INPUT" }
	end

	if size.id == "s7b" and not session.data.empire.research.frontier then
		return {ok=false, err="PREREQUISITE"}
	end
	if #session.data.modelOrder &gt;= 80 then return {ok=false, err="MODEL_LIMIT"} end
	local plan = ModelMath.plan(size, ModelMath.fleet(session.data.gpus), ModelMath.dataSummary(session.data.data),recipeId)
	if not plan.ok then
		return { ok = false, err = plan.reason }
	end
	if session.data.money &lt; plan.cost then
		return { ok = false, err = "NO_MONEY" }
	end

	local filtered = TextFilter.forBroadcast(name, session.userId) -- yieldet
	if filtered == nil then
		return { ok = false, err = "FILTER_DOWN" }
	end
	if filtered ~= name then
		return { ok = false, err = "NAME_FILTERED" }
	end

	-- Nach dem Yield alles neu prüfen: zweite Anfrage, GPU verkauft, Geld ausgegeben, Spieler weg
	if session.closed then
		return { ok = false, err = "LOADING" }
	end
	local data = session.data
	if data.training then
		return { ok = false, err = "TRAINING_ACTIVE" }
	end
	local fleet = ModelMath.fleet(data.gpus)
	local summary = ModelMath.dataSummary(data.data)
	plan = ModelMath.plan(size, fleet, summary,recipeId)
	if not plan.ok then
		return { ok = false, err = plan.reason }
	end
	if #data.modelOrder &gt;= 80 then return {ok=false, err="MODEL_LIMIT"} end
	if not EconomyService.spend(session, plan.cost) then
		return { ok = false, err = "NO_MONEY" }
	end

	local expectedStats, expected = ModelMath.computeStats(size.id, focus.id, summary, specOf(session), ModelMath.recipeFactor(size,summary,recipeId), nil)
	expectedStats, expected = EmpireMath.boostStats(expectedStats, data.empire)
	local id = HttpService:GenerateGUID(false)
	local model: Types.ModelData = {
		id = id,
		name = name,
		version = versionFor(data, name),
		sizeId = size.id,
		focusId = focus.id,
		status = "training",
		createdAt = os.time(),
		trainedAt = nil,
		stats = {},
		overall = 0,
		trainCost = plan.cost,
		dataUsed = summary,
		release = nil,
		market = nil,
	}
	data.models[id] = model
	table.insert(data.modelOrder, id)

	local training: TrainingState = {
		modelId = id,
		workTotal = plan.work,
		workDone = 0,
		cost = plan.cost,
		expected = expected,
		qualityMod = ModelMath.recipeFactor(size,summary,recipeId),
		eventRolled = false,
		event = nil,
		epoch = 0,
		loss = { math.round(ModelMath.lossAt(0, expected, 0) * 1000) / 1000 },
		log = {},
	}
	addLog(training, `Allocating {fleet.vram} GB VRAM for {size.label} params`)
	addLog(training, `Tokenizing {Format.tokens(summary.total)} tokens`)
	addLog(training, "Training started")
	data.training = training

	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true, modelId = id }
end

local function improveModel(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local data = session.data
	if data.training then return {ok=false,err="TRAINING_ACTIVE"} end
	local id = Guard.id(payload.modelId)
	local model = if id then data.models[id] else nil
	if not model or (model.status ~= "trained" and model.status ~= "live") then return {ok=false,err="BAD_MODEL"} end
	local summary = ModelMath.dataSummary(data.data)
	if summary.total &lt; model.dataUsed.total + 1e8 then return {ok=false,err="NEW_DATA"} end
	local size = ModelConfig.getSize(model.sizeId)
	if not size then return {ok=false,err="BAD_MODEL"} end
	local plan = ModelMath.plan(size, ModelMath.fleet(data.gpus), summary)
	if not plan.ok then return {ok=false,err=plan.reason} end
	local scale = 1 + (model.iterations or 0) * 0.75 + model.overall / 100
	local cost = math.floor(plan.cost * scale)
	if not EconomyService.spend(session,cost) then return {ok=false,err="NO_MONEY"} end
	local resume = model.status == "live"
	local base = table.clone(model.stats)
	model.dataUsed = summary
	model.status = "training"
	data.training = {modelId=model.id,refinement=true,baseStats=base,resumeLive=resume,
		workTotal=plan.work*scale,workDone=0,cost=cost,expected=model.overall+5,
		qualityMod=1,eventRolled=false,event=nil,epoch=0,loss={ModelMath.lossAt(0,model.overall,0)},
		log={"Refinement: fresh data + your own checkpoint. Serving paused until completion.","No fixed intelligence ceiling. Later improvements take more compute."}}
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return {ok=true,modelId=model.id}
end

local function resolveEvent(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local training = session.data.training
	local event = if training then training.event else nil
	if not training or not event or not event.pending then
		return { ok = false, err = "NO_EVENT" }
	end
	local def = ModelConfig.getEvent(event.id)
	local choiceId = Guard.id(payload.choice)
	local choice = if def and choiceId then ModelConfig.getChoice(def, choiceId) else nil
	if not choice then
		return { ok = false, err = "BAD_INPUT" }
	end
	local err = applyChoice(session, training, choice, false)
	if err then
		return { ok = false, err = err }
	end
	SessionService.markDirty(session)
	return { ok = true, outcome = event.outcome }
end

local function parsePrices(payload: ServerTypes.Payload): (number?, number?)
	local sub = Guard.number(payload.subPrice, 0, 1000)
	local api = Guard.number(payload.apiPrice, MarketConfig.API_PRICE.min, MarketConfig.API_PRICE.max)
	if sub == nil or not MarketConfig.isSubPrice(sub) or api == nil then
		return nil, nil
	end
	return sub, Guard.snap(api, MarketConfig.API_PRICE.step)
end

local function modelFromPayload(session: Session, payload: ServerTypes.Payload): Types.ModelData?
	local id = Guard.id(payload.modelId)
	return if id then session.data.models[id] else nil
end

local function releaseModel(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local model = modelFromPayload(session, payload)
	if not model or model.status ~= "trained" then
		return { ok = false, err = "BAD_MODEL" }
	end
	local sub, api = parsePrices(payload)
	local marketingRaw = Guard.number(payload.marketing, 0, MarketConfig.MARKETING.max)
	local target = Guard.id(payload.target)
	if sub == nil or api == nil or marketingRaw == nil or not target or not MarketConfig.isTarget(target) then
		return { ok = false, err = "BAD_INPUT" }
	end
	local marketing = math.min(Guard.snap(marketingRaw, MarketConfig.MARKETING.step), MarketConfig.MARKETING.max)
	if not EconomyService.spend(session, marketing) then
		return { ok = false, err = "NO_MONEY" }
	end

	local data = session.data
	model.status = "live"
	model.release = {
		subPrice = sub,
		apiPrice = api,
		marketing = marketing,
		target = target,
		releasedAt = os.time(),
	}
	model.market = MarketMath.newMarketState(target, marketing)
	data.stats.modelsReleased += 1
	data.stats.bestOverall = math.max(data.stats.bestOverall, model.overall)
	SessionService.markDirty(session)
	Remote.fire(session.player, "Notify", "MODEL_LIVE", { modelId = model.id })
	return { ok = true }
end

local function updatePricing(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local model = modelFromPayload(session, payload)
	local release = if model then model.release else nil
	if not model or model.status ~= "live" or not release then
		return { ok = false, err = "BAD_MODEL" }
	end
	local sub, api = parsePrices(payload)
	if sub == nil or api == nil then
		return { ok = false, err = "BAD_INPUT" }
	end
	release.subPrice = sub
	release.apiPrice = api
	SessionService.markDirty(session)
	return { ok = true }
end

local function retireModel(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local model = modelFromPayload(session, payload)
	if not model or model.status ~= "live" then
		return { ok = false, err = "BAD_MODEL" }
	end
	model.status = "retired"
	if model.market then
		model.market.users = {}
	end
	SessionService.markDirty(session)
	return { ok = true }
end

-- Reviewing a server-owned benchmark records the tutorial step without changing model scores.
local function evaluateModel(session: Session,payload: ServerTypes.Payload): ServerTypes.Result
 local model=modelFromPayload(session,payload)
 if not model or model.status=="training" then return {ok=false,err="BAD_MODEL"} end
 session.data.empire.quests.journey_evaluation=true;SessionService.markDirty(session)
 return {ok=true,modelId=model.id}
end
function AIModelService.init()
 Remote.bind("EvaluateModel",{burst=2,perSecond=.5,company=true},evaluateModel)
	Remote.bind("ImproveModel", {burst=2,perSecond=0.5,company=true}, improveModel)
	Remote.bind("StartTraining", { burst = 3, perSecond = 0.5, company = true }, startTraining)
	Remote.bind("ResolveEvent", { burst = 4, perSecond = 1, company = true }, resolveEvent)
	Remote.bind("ReleaseModel", { burst = 3, perSecond = 0.5, company = true }, releaseModel)
	Remote.bind("UpdatePricing", { burst = 8, perSecond = 3, company = true }, updatePricing)
	Remote.bind("RetireModel", { burst = 3, perSecond = 0.5, company = true }, retireModel)
end

return AIModelService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">CompanyService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Firmengründung. Name wird geprüft (Guard) und durch den Roblox-Textfilter geschickt,
-- weil andere Spieler ihn auf dem Firmenschild sehen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local CompanyConfig = require(ReplicatedStorage.Shared.Config.CompanyConfig)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local TextFilter = require(script.Parent.Parent.Lib.TextFilter)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local PlotService = require(script.Parent.PlotService)

type Session = ServerTypes.Session

local CompanyService = {}

local function createCompany(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	if session.data.company then
		return { ok = false, err = "ALREADY_FOUNDED" }
	end
	local name = Guard.text(payload.name, GameConfig.COMPANY_NAME_MIN, GameConfig.COMPANY_NAME_MAX)
	if not name then
		return { ok = false, err = "BAD_NAME" }
	end
	local logo = payload.logo
	if typeof(logo) ~= "string" or not CompanyConfig.isLogo(logo) then
		return { ok = false, err = "BAD_INPUT" }
	end
	local colorId = Guard.id(payload.color)
	local specId = Guard.id(payload.spec)
	if not colorId or not CompanyConfig.getColor(colorId) or not specId or not CompanyConfig.getSpec(specId) then
		return { ok = false, err = "BAD_INPUT" }
	end

	local filtered = TextFilter.forBroadcast(name, session.userId) -- yieldet
	if filtered == nil then
		return { ok = false, err = "FILTER_DOWN" }
	end
	if filtered ~= name then
		return { ok = false, err = "NAME_FILTERED" }
	end
	-- Während des Yields kann eine zweite Anfrage durchgelaufen oder der Spieler gegangen sein
	if session.closed or session.data.company then
		return { ok = false, err = "ALREADY_FOUNDED" }
	end

	session.data.company = {
		name = name,
		logo = logo,
		color = colorId,
		spec = specId,
		foundedAt = os.time(),
		reputation = 0,
	}
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true }
end

function CompanyService.init()
	Remote.bind("CreateCompany", { burst = 3, perSecond = 0.2 }, createCompany)
end

return CompanyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">ComputeService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Compute: GPUs kaufen/verkaufen. Das Rack hat RACK_SLOTS Plätze, der Start-Laptop belegt keinen.
-- Verkaufen ist während eines Trainings gesperrt (sonst ließe sich der VRAM-Check beim Start umgehen).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardwareConfig = require(ReplicatedStorage.Shared.Config.HardwareConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)

type Session = ServerTypes.Session

local ComputeService = {}

local function gpuFromPayload(payload: ServerTypes.Payload): HardwareConfig.GPUDef?
	local gpuId = Guard.id(payload.gpuId)
	local gpu = if gpuId then HardwareConfig.getGPU(gpuId) else nil
	if not gpu or gpu.starter then
		return nil
	end
	return gpu
end

local function buyGPU(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local gpu = gpuFromPayload(payload)
	if not gpu then
		return { ok = false, err = "BAD_INPUT" }
	end
	if ModelMath.fleet(session.data.gpus).slotsUsed &gt;= HardwareConfig.slots(session.data.empire) then
		return { ok = false, err = "RACK_FULL" }
	end
	if not EconomyService.spend(session, gpu.price) then
		return { ok = false, err = "NO_MONEY" }
	end
	session.data.gpus[gpu.id] = (session.data.gpus[gpu.id] or 0) + 1
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true }
end

local function sellGPU(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local gpu = gpuFromPayload(payload)
	if not gpu then
		return { ok = false, err = "BAD_INPUT" }
	end
	if session.data.empire.projectJob then return {ok=false,err="PROJECT_ACTIVE"} end
	if session.data.training then
		return { ok = false, err = "TRAINING_ACTIVE" }
	end
	local owned = session.data.gpus[gpu.id] or 0
	if owned &lt;= 0 then
		return { ok = false, err = "NOT_OWNED" }
	end
	if owned &gt; 1 then
		session.data.gpus[gpu.id] = owned - 1
	else
		(session.data.gpus :: any)[gpu.id] = nil -- Eintrag entfernen statt 0 speichern
	end
	EconomyService.grant(session, math.floor(gpu.price * HardwareConfig.SELL_REFUND))
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true }
end

local function setShare(s: any,p: any): any
	local share=Guard.number(p.share,.25,.9)
	if not share then return {ok=false,err="BAD_INPUT"} end
	s.data.empire.infrastructure.trainingShare=share;SessionService.markDirty(s);return {ok=true}
end
local function cooling(s: any,_p: any): any
	local level=s.data.empire.infrastructure.cooling
	if level&gt;=8 then return {ok=false,err="MAX_COOLING"} end
	if not EconomyService.spend(s,math.floor(8000*1.7^(level-1))) then return {ok=false,err="NO_MONEY"} end
	s.data.empire.infrastructure.cooling+=1;SessionService.markDirty(s);PlotService.refresh(s);return {ok=true}
end
function ComputeService.init()
	Remote.bind("SetComputeShare",{burst=3,perSecond=1,company=true},setShare)
	Remote.bind("UpgradeCooling",{burst=2,perSecond=.5,company=true},cooling)
	Remote.bind("BuyGPU", { burst = 4, perSecond = 2, company = true }, buyGPU)
	Remote.bind("SellGPU", { burst = 4, perSecond = 2, company = true }, sellGPU)
end

return ComputeService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">DatasetService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Trainingsdaten: kostenlos scrapen (langsam, schlecht) oder Pakete kaufen.
-- Preise und Mengen kommen nur aus DataConfig – der Client schickt nur Paket-ID und Anzahl.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataConfig = require(ReplicatedStorage.Shared.Config.DataConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)

type Session = ServerTypes.Session

local DatasetService = {}

local function scrape(session: Session, _payload: ServerTypes.Payload): ServerTypes.Result
	local now = workspace:GetServerTimeNow()
	local remaining = session.data.lastScrapeAt + DataConfig.SCRAPE.cooldown - now
	if remaining &gt; 0 then
		return { ok = false, err = "COOLDOWN", wait = remaining }
	end
	session.data.lastScrapeAt = now
	ModelMath.addTokens(session.data.data, DataConfig.SCRAPE.type, DataConfig.SCRAPE.tokens, DataConfig.SCRAPE.quality)
	SessionService.markDirty(session)
	return { ok = true, tokens = DataConfig.SCRAPE.tokens }
end

local function buyData(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local packId = Guard.id(payload.packId)
	local pack = if packId then DataConfig.getPack(packId) else nil
	local count = Guard.integer(payload.count, 1, DataConfig.MAX_BUY)
	if not pack or not count then
		return { ok = false, err = "BAD_INPUT" }
	end
	if not EconomyService.spend(session, pack.price * count) then
		return { ok = false, err = "NO_MONEY" }
	end
	ModelMath.addTokens(session.data.data, pack.type, pack.tokens * count, pack.quality)
	SessionService.markDirty(session)
	return { ok = true, tokens = pack.tokens * count }
end

function DatasetService.init()
	Remote.bind("Scrape", { burst = 3, perSecond = 0.5, company = true }, scrape)
	Remote.bind("BuyData", { burst = 6, perSecond = 3, company = true }, buyData)
end

return DatasetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">DebugService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Debug-Befehle zum Testen. Nur in Studio oder für UserIds in GameConfig.DEV_USER_IDS.
-- Befehle: money (+$100K), data (+10B Tokens je Typ, Qualität 80 %), finish (Training sofort fertig),
-- rep (+25 Reputation), reset (Spielstand auf Start zurücksetzen).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local DataConfig = require(ReplicatedStorage.Shared.Config.DataConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local Template = require(script.Parent.Parent.Lib.Template)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local AIModelService = require(script.Parent.AIModelService)

type Session = ServerTypes.Session

local DebugService = {}

function DebugService.allowed(userId: number): boolean
	return RunService:IsStudio() or table.find(GameConfig.DEV_USER_IDS, userId) ~= nil
end

local function run(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	if not DebugService.allowed(session.userId) then
		return { ok = false, err = "NOT_ALLOWED" }
	end
	local cmd = Guard.id(payload.cmd)
	if cmd == "money" then
		EconomyService.grant(session, 100_000)
	elseif cmd == "data" then
		for _, dataType in DataConfig.TYPES do
			ModelMath.addTokens(session.data.data, dataType.id, 1e10, 0.8)
		end
	elseif cmd == "finish" then
		if not AIModelService.finishNow(session) then
			return { ok = false, err = "NO_TRAINING" }
		end
	elseif cmd == "rep" then
		local company = session.data.company
		if company then
			company.reputation = math.min(100, company.reputation + 25)
		end
	elseif cmd == "reset" then
		session.data = Template.new()
		session.live = { users = 0, revenue = 0, cost = 0, perModel = {}, npcUsers = {} }
		PlotService.refresh(session)
	else
		return { ok = false, err = "BAD_INPUT" }
	end
	SessionService.markDirty(session)
	print(`[Debug] {session.player.Name}: {cmd}`)
	return { ok = true }
end

function DebugService.init()
	Remote.bind("Debug", { burst = 8, perSecond = 4 }, run)
end

return DebugService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">EconomyService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Geld wird nur hier verändert. Der Client nennt nie Beträge, die er bekommt –
-- alle Preise kommen aus den Configs auf dem Server.

local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local SessionService = require(script.Parent.SessionService)

type Session = ServerTypes.Session

local EconomyService = {}

local function valid(amount: number): boolean
	return amount == amount and amount &gt;= 0 and amount &lt; math.huge
end

-- Zieht `amount` ab, wenn genug da ist. Ein negatives Konto blockiert alle Ausgaben &gt; 0.
function EconomyService.spend(session: Session, amount: number): boolean
	if not valid(amount) then
		return false
	end
	if amount == 0 then
		return true -- kostenlose Aktionen (z. B. Release ohne Marketing) gehen auch mit Schulden
	end
	if session.data.money &lt; amount then
		return false
	end
	session.data.money -= amount
	session.data.stats.totalCost += amount
	SessionService.markDirty(session)
	return true
end

function EconomyService.grant(session: Session, amount: number)
	if not valid(amount) then
		return
	end
	session.data.money += amount
	SessionService.markDirty(session)
end

-- Laufende Einnahmen/Kosten aus dem Markt (pro Tick). Darf ins Minus gehen.
function EconomyService.applyFlow(session: Session, revenue: number, cost: number)
	if not valid(revenue) or not valid(cost) then
		return
	end
	session.data.money += revenue - cost
	session.data.stats.totalRevenue += revenue
	session.data.stats.totalCost += cost
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">MarketService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One server economy: shared demand, monthly business contracts and paid player API access.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local CompanyConfig = require(Shared.Config.CompanyConfig)
local GameConfig = require(Shared.Config.GameConfig)
local MarketConfig = require(Shared.Config.MarketConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local MarketMath = require(Shared.MarketMath)
local EmpireMath = require(Shared.EmpireMath)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local Remote = require(script.Parent.Parent.Lib.Remote)
local Guard = require(script.Parent.Parent.Lib.Guard)
local SessionService = require(script.Parent.SessionService)
local Economy = require(script.Parent.EconomyService)
local NPC=require(script.Parent.NPCService)
local Market = {offers = {} :: {any}, customers = {} :: {any}}
local clock = 0
local businesses = {
	{id="pixel",name="Pixel Games",stat="coding",minimum=22,budget=900,tokens=50},
	{id="north",name="North Logistics",stat="reasoning",minimum=25,budget=1800,tokens=100},
	{id="paper",name="Paper Studio",stat="creativity",minimum=28,budget=1400,tokens=80},
	{id="ledger",name="Ledger Finance",stat="math",minimum=40,budget=4500,tokens=180},
	{id="orbit",name="Orbit Games",stat="coding",minimum=45,budget=5000,tokens=240},
	{id="atlas",name="Atlas Search",stat="knowledge",minimum=48,budget=6000,tokens=300},
	{id="civic",name="Civic Support",stat="reliability",minimum=48,budget=3500,tokens=160},
	{id="delta",name="Delta Robotics",stat="reasoning",minimum=60,budget=12000,tokens=450},
	{id="mosaic",name="Mosaic Worlds",stat="creativity",minimum=65,budget=15000,tokens=700},
	{id="helix",name="Helix Research",stat="math",minimum=80,budget=22000,tokens=900},
	{id="nova",name="Nova Infrastructure",stat="coding",minimum=100,budget=45000,tokens=1800},
	{id="frontier",name="Frontier Science",stat="reasoning",minimum=140,budget=90000,tokens=3000},
}
local leases: {[string]:any} = {}
local function all(): {any}
	local list = {}
	for _, s in SessionService.all() do
		if not s.closed and s.data.company then table.insert(list,s) end
	end
	for _, n in NPC.sessions do table.insert(list,n) end
	table.sort(list,function(a,b) return a.userId &lt; b.userId end)
	return list
end
local function seller(id: number): any
	for _, s in all() do if s.userId == id then return s end end
	return nil
end
local function entry(s: any, model: any): any
	return {id=model.id,stats=model.stats,sizeId=model.sizeId,subPrice=model.release.subPrice,
		apiPrice=model.release.apiPrice,market=model.market}
end
local function invoice(s: any, text: string, amount: number)
	table.insert(s.data.empire.invoices,1,{time=os.time(),text=text,amount=amount})
	while #s.data.empire.invoices&gt;20 do table.remove(s.data.empire.invoices) end
end
function Market.accessPrice(model: any): number
	return math.max(100,math.floor(model.release.subPrice*100 + model.release.apiPrice*50))
end
local function transfer(buyer: any, provider: any, model: any, fee: number, auto: boolean): boolean
	-- No yielding between the two ledger writes. Prices are server derived, never client supplied.
	if not Economy.spend(buyer,fee) then return false end
	Economy.applyFlow(provider,fee,0)
	buyer.data.empire.subscriptions = {providerId=provider.userId,modelId=model.id,
		provider=provider.data.company.name,name=model.name,score=model.overall,stats=table.clone(model.stats),
		price=fee,expires=os.time()+GameConfig.GAME_MONTH_SECONDS,autoRenew=auto}
	invoice(buyer,"API access: "..model.name,-fee)
	invoice(provider,"API customer: "..buyer.data.company.name,fee)
	SessionService.markDirty(buyer); SessionService.markDirty(provider)
	return true
end
local function buy(buyer: any, payload: any): any
	local providerId = Guard.integer(payload.providerId,-100000003,1e12)
	local modelId = Guard.id(payload.modelId)
	if not providerId or not modelId then return {ok=false,err="BAD_INPUT"} end
	if providerId==0 or providerId==buyer.userId then return {ok=false,err="SELF_PURCHASE"} end
	local sub = buyer.data.empire.subscriptions
	if sub.expires and sub.expires&gt;os.time() then return {ok=false,err="ACCESS_ACTIVE"} end
	local provider = seller(providerId)
	if not provider then return {ok=false,err="SELLER_OFFLINE"} end
	local model = provider.data.models[modelId]
	if not model or model.status~="live" or not model.release then return {ok=false,err="BAD_MODEL"} end
	local fee = Market.accessPrice(model)
	if payload.quotedPrice~=fee then return {ok=false,err="QUOTE_CHANGED"} end
	if not transfer(buyer,provider,model,fee,payload.autoRenew==true) then return {ok=false,err="NO_MONEY"} end
	return {ok=true}
end
local function cancel(buyer: any, _payload: any): any
	buyer.data.empire.subscriptions.autoRenew=false
	SessionService.markDirty(buyer)
	return {ok=true}
end
function Market.tickGlobal(dt: number)
	clock += dt
	local offers = {}
	local sessions = all()
	local capacity: {[number]:number} = {}
	for _, s in sessions do
		s.data.empire.customers = {}
		s.data.empire.businessRevenue = 0
		capacity[s.userId] = ModelMath.fleet(s.data.gpus).throughput*100*require(Shared.Config.HardwareConfig).thermal(s.data.empire,ModelMath.fleet(s.data.gpus).throughput)
		if s.data.training then capacity[s.userId] *= 1-s.data.empire.infrastructure.trainingShare end
		for _, id in s.data.modelOrder do
			local m = s.data.models[id]
			if m and m.status=="live" and m.release and m.market then
				table.insert(offers,{providerId=s.userId,company=s.data.company.name,id=id,name=m.name,
					overall=m.overall,stats=m.stats,sub=m.release.subPrice,api=m.release.apiPrice,
					price=Market.accessPrice(m),users=MarketMath.totalUsers(m.market),iterations=m.iterations or 0})
			end
		end
		local sub=s.data.empire.subscriptions
		if sub.expires and sub.expires&lt;=os.time() then
			local provider = seller(sub.providerId)
			local model = if provider then provider.data.models[sub.modelId] else nil
			if sub.autoRenew and model and model.status=="live" and Market.accessPrice(model)==sub.price then
				if not transfer(s,provider,model,sub.price,true) then sub.autoRenew=false end
			else sub.autoRenew=false end
		end
	end
	table.sort(offers,function(a,b)
		if a.overall~=b.overall then return a.overall&gt;b.overall end
		if a.providerId~=b.providerId then return a.providerId&lt;b.providerId end
		return a.id&lt;b.id
	end)
	Market.offers=offers
	local customers = {}
	-- Existing leases consume capacity first. New competitors can win when the game month renews.
	for _, business in businesses do
		local lease=leases[business.id]
		local provider=if lease then seller(lease.providerId) else nil
		local model=if provider then provider.data.models[lease.modelId] else nil
		if lease and (clock&gt;=lease.renewAt or not model or model.status~="live"
			or (capacity[lease.providerId] or 0)&lt;business.tokens) then leases[business.id]=nil
		elseif lease then capacity[lease.providerId]-=business.tokens end
	end
	for _, business in businesses do
		local lease = leases[business.id]
		if not lease then
			local winner:any=nil
			local best=-math.huge
			for _, offer in offers do
				local quote=math.floor(offer.sub*10 + offer.api*business.tokens)
				local ability=offer.stats[business.stat] or 0
				local value=ability/(1+quote/business.budget)
				if ability&gt;=business.minimum and quote&gt;0 and quote&lt;=business.budget
					and (capacity[offer.providerId] or 0)&gt;=business.tokens and value&gt;best then
					winner=offer;best=value
				end
			end
			if winner then
				lease={providerId=winner.providerId,modelId=winner.id,
					price=math.floor(winner.sub*10+winner.api*business.tokens),renewAt=clock+GameConfig.GAME_MONTH_SECONDS}
				leases[business.id]=lease
				capacity[winner.providerId]-=business.tokens
			end
		end
		local provider = if lease then seller(lease.providerId) else nil
		local row={id=business.id,name=business.name,stat=business.stat,minimum=business.minimum,
			budget=business.budget,tokens=business.tokens,providerId=if provider then provider.userId else 0,
			provider=if provider then provider.data.company.name else "Seeking provider",
			price=if lease then lease.price else 0,remaining=if lease then math.ceil(lease.renewAt-clock) else 0}
		table.insert(customers,row)
		if provider then
			row.modelId=lease.modelId
			table.insert(provider.data.empire.customers,row)
			provider.data.empire.businessRevenue+=lease.price/GameConfig.GAME_MONTH_SECONDS
		end
	end
	Market.customers=customers
	for _, s in NPC.sessions do Market.tick(s,dt) end
end
function Market.tick(session: any, dt: number)
	local data = session.data
	local company = data.company
	if not company then return end
	local entries, rivals = {}, {}
	for _, s in all() do
		for _, id in s.data.modelOrder do
			local m = s.data.models[id]
			if m and m.status=="live" and m.release and m.market then
				table.insert(if s==session then entries else rivals,entry(s,m))
			end
		end
	end
	local live=MarketMath.tick(entries,company.reputation,company.spec,dt,rivals,if #NPC.sessions&gt;0 then {} else nil)
	local b=EmpireMath.bonuses(data.empire)
	local cycle=EmpireConfig.cycle(workspace:GetServerTimeNow())
	live.revenue*=b.revenue*cycle.revenue; live.cost*=b.serving*cycle.cost
	for _, r in live.perModel do r.revenue*=b.revenue*cycle.revenue; r.cost*=b.serving*cycle.cost end
	for _, customer in data.empire.customers do
		local m=data.models[customer.modelId]
		if m and m.status=="live" then
			local size=ModelConfig.getSize(m.sizeId)
			local revenue=customer.price/GameConfig.GAME_MONTH_SECONDS
			local cost=customer.tokens*(if size then size.serveCost else 0)*b.serving/GameConfig.GAME_MONTH_SECONDS
			live.revenue+=revenue;live.cost+=cost
			local r=live.perModel[m.id]
			if r then r.revenue+=revenue;r.cost+=cost end
		end
	end
	-- Electricity while serving is distinct from the upfront training electricity budget.
	local fleet=ModelMath.fleet(data.gpus)
	if #entries&gt;0 then live.cost+=fleet.throughput*0.025 end
	live.marketplace={offers=Market.offers,customers=Market.customers}
	session.live=live
	Economy.applyFlow(session,live.revenue*dt,live.cost*dt)
	local oldRank=CompanyConfig.rankFor(data.stats.peakUsers)
	data.stats.peakUsers=math.max(data.stats.peakUsers,live.users)
	company.reputation=MarketMath.reputationStep(company.reputation,live.users,data.stats.bestOverall,dt)
	if #entries&gt;0 then SessionService.markDirty(session) end
	local newRank=CompanyConfig.rankFor(data.stats.peakUsers)
	if newRank~=oldRank then Remote.fire(session.player,"Notify","RANK_UP",{rank=newRank}) end
end
function Market.init()
	Remote.bind("BuyModelAccess",{burst=2,perSecond=0.5,company=true},buy)
	Remote.bind("CancelModelAccess",{burst=2,perSecond=0.5,company=true},cancel)
end
return Market
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">PlotService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Twelve campus plots with enough space for roads, shop streets and basement ramps.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Lighting=game:GetService("Lighting")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local CompanyConfig=require(ReplicatedStorage.Shared.Config.CompanyConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local SessionService=require(script.Parent.SessionService)
local Design=require(script.Parent.HeadquartersDesign)
local Plot={}
local plots={}
local changed={}
local function accent(session: any): Color3
	local company=session.data.company
	local def=if company then CompanyConfig.getColor(company.color) else nil
	return if def then Color3.fromRGB(def.rgb[1],def.rgb[2],def.rgb[3]) else Color3.fromRGB(120,154,129)
end
function Plot.get(player: Player): any
	for _,p in plots do if p.owner==player then return p end end
	return nil
end
function Plot.all(): {any} return plots end
function Plot.onChanged(fn: (any,any)-&gt;()) table.insert(changed,fn) end
local function announce(p: any,session: any)
	for _,fn in changed do fn(p,session) end
end
local function sendHome(player: Player,p: any)
	local character=player.Character;if not character then return end
	local root=character:WaitForChild("HumanoidRootPart",5);if not root then return end
	if p.owner~=player or not character.Parent then return end
	character:PivotTo(p.cframe*CFrame.new(0,4,-92))
end
function Plot.refresh(session: any)
	local p=Plot.get(session.player);local office=if p then p.office else nil;if not office then return end
	if office:GetAttribute("OfficeTier")~=session.data.empire.office then
		office:Destroy();office=Design.build(p.cframe,session,accent(session));office.Parent=p.model;p.office=office
		announce(p,session);task.spawn(sendHome,session.player,p)
	end
	local staffKey=""
	for _,role in EmpireConfig.ROLES do staffKey..=role.id..tostring(session.data.empire.employees[role.id] or 0) end
	if office:GetAttribute("StaffKey")~=staffKey then Design.staff(office,p.cframe,session) end
	office:SetAttribute("CoolingLevel",session.data.empire.infrastructure.cooling)
	local anchor=office:FindFirstChild("SignAnchor");local sign=if anchor then anchor:FindFirstChild("Sign") else nil;local title=if sign then sign:FindFirstChild("Label") else nil
	if title then title.Text=if session.data.company then session.data.company.name.."\n"..EmpireConfig.OFFICES[session.data.empire.office].name else session.player.DisplayName.."'s Headquarters" end
	if session.data.company then
		for _,name in {"ReceptionSign","KitchenBrand"} do
			local board=office:FindFirstChild(name);local gui=if board then board:FindFirstChildOfClass("SurfaceGui") else nil;local label=if gui then gui:FindFirstChildOfClass("TextLabel") else nil
			if label then label.Text=if name=="ReceptionSign" then "WELCOME TO\n"..session.data.company.name else session.data.company.name.."\nSNACK CLUB" end
		end
	end
	local colors={}
	for i=#HardwareConfig.GPUS,1,-1 do
		local gpu=HardwareConfig.GPUS[i]
		if not gpu.starter then for _=1,session.data.gpus[gpu.id] or 0 do table.insert(colors,accent(session)) end end
	end
	local blades=office:FindFirstChild("Blades")
	if blades then for i,blade in blades:GetChildren() do
		if blade:IsA("BasePart") then blade:SetAttribute("Lit",colors[i]~=nil);blade.Color=colors[i] or Color3.fromRGB(39,46,43) end
	end end
	office:SetAttribute("Training",session.data.training~=nil)
end
function Plot.claim(session: any)
	if Plot.get(session.player) then return end
	local p=nil;for _,candidate in plots do if not candidate.owner then p=candidate;break end end
	if not p then warn("[Campus] No free plot. Set Max Players to 12.");return end
	local vacant=p.model:FindFirstChild("VacantPad");if vacant then vacant:Destroy() end
	p.owner=session.player;p.office=Design.build(p.cframe,session,accent(session));p.office.Parent=p.model
	Plot.refresh(session);announce(p,session)
	p.characterConn=session.player.CharacterAdded:Connect(function()task.delay(.25,sendHome,session.player,p)end)
	task.delay(.25,sendHome,session.player,p)
end
function Plot.release(player: Player)
	local p=Plot.get(player);if not p then return end
	if p.characterConn then p.characterConn:Disconnect() end
	if p.office then p.office:Destroy() end
	p.owner=nil;p.office=nil;p.characterConn=nil
	local pad=Instance.new("Part");pad.Name="VacantPad";pad.Size=Vector3.new(284,24,240);pad.CFrame=p.cframe*CFrame.new(0,-12,6);pad.Color=Color3.fromRGB(140,154,127);pad.Material=Enum.Material.Grass;pad.Anchored=true;pad.Parent=p.model
end
function Plot.init()
	Lighting.ClockTime=15.8;Lighting.Brightness=2;Lighting.Ambient=Color3.fromRGB(96,104,94);Lighting.OutdoorAmbient=Color3.fromRGB(140,149,134)
	local old=workspace:FindFirstChild("Plots");if old then old:Destroy() end
	local folder=Instance.new("Folder");folder.Name="Plots";folder.Parent=workspace
	for i=1,Config.PLOT_COUNT do
		local row=if i&lt;=6 then -1 else 1;local x=((i-1)%6-2.5)*Config.PITCH
		local center=Vector3.new(x,Config.STREET_Y,row*Config.ROW_OFFSET)
		local cf=CFrame.lookAt(center,Vector3.new(x,Config.STREET_Y,0))
		local model=Instance.new("Model");model.Name=string.format("Plot_%02d",i);model.Parent=folder
		local pad=Instance.new("Part");pad.Name="VacantPad";pad.Size=Vector3.new(284,24,240);pad.CFrame=cf*CFrame.new(0,-12,6);pad.Color=Color3.fromRGB(140,154,127);pad.Material=Enum.Material.Grass;pad.Anchored=true;pad.Parent=model
		model:SetAttribute("CampusCFrame",cf);model:SetAttribute("PlotIndex",i)
		table.insert(plots,{index=i,cframe=cf,model=model})
	end
	SessionService.onLoaded(Plot.claim);SessionService.onClosing(function(s)Plot.release(s.player)end)
end
return Plot
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">SaveService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Persistenz. Nur hier wird der DataStore angefasst.
--
-- Aufbau eines Eintrags: { data = PlayerData, meta = { lockJobId, lockTime, saveCount } }
-- Session-Lock: Beim Laden schreibt der Server seine JobId in meta. Ein anderer Server, der den
-- Spieler gleichzeitig lädt (schneller Serverwechsel), wartet. Ein Lock älter als
-- SESSION_LOCK_TIMEOUT gilt als tot (Server abgestürzt) und wird übernommen.
-- Jeder Save prüft, ob der Lock noch uns gehört – sonst wird NICHT geschrieben (kein Dupe/Rollback).
--
-- Offline-Modus: In einem unveröffentlichten Ort (PlaceId 0) oder ohne Studio-API-Zugriff läuft das
-- Spiel ohne Speichern weiter, statt kaputtzugehen.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local SESSION_ID = if game.JobId ~= "" then game.JobId else HttpService:GenerateGUID(false)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)
local Template = require(script.Parent.Parent.Lib.Template)

local SaveService = {}
SaveService.enabled = false

local store: DataStore? = nil

local function keyFor(userId: number): string
	return GameConfig.KEY_PREFIX .. tostring(userId)
end

-- NaN/inf sind in JSON nicht speicherbar und würden den Spielstand zerstören
local function sanitize(value: any): any
	local kind = typeof(value)
	if kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return 0
		end
		return value
	elseif kind == "table" then
		local copy = {}
		for key, inner in value do
			copy[key] = sanitize(inner)
		end
		return copy
	end
	return value
end

local function waitForBudget()
	for _ = 1, 20 do
		if DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) &gt; 0 then
			return
		end
		task.wait(0.5)
	end
end

function SaveService.init()
	if game.PlaceId == 0 then
		warn("[Save] Unveröffentlichter Ort (PlaceId 0): Speichern ist AUS. Zum Speichern: Ort veröffentlichen.")
		return
	end
	local ok, err = pcall(function()
		local candidate = DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)
		candidate:GetAsync("__probe")
		store = candidate
	end)
	if ok then
		SaveService.enabled = true
	else
		warn("[Save] DataStore nicht erreichbar, Speichern ist AUS:", err)
	end
end

-- Lädt und sperrt den Spielstand. Gibt (Daten, nil) oder (nil, Grund) zurück.
function SaveService.load(userId: number): (Types.PlayerData?, string?)
	local activeStore = store
	if not SaveService.enabled or not activeStore then
		if RunService:IsStudio() or game.PlaceId == 0 then return Template.new(), nil end
		return nil, "storage unavailable; please rejoin"
	end
	local key = keyFor(userId)
	local jobId = SESSION_ID

	for attempt = 1, GameConfig.LOAD_ATTEMPTS do
		local lockedElsewhere = false
		local loaded: any = nil
		local invalidReason: string? = nil
		waitForBudget()
		local ok, err = pcall(function()
			activeStore:UpdateAsync(key, function(old: any)
				lockedElsewhere = false
				loaded = nil
				invalidReason = nil
				local now = os.time()
				if old ~= nil and (typeof(old) ~= "table" or typeof(old.data) ~= "table") then
					invalidReason = "invalid save; original preserved"
					return nil
				end
				if typeof(old) == "table" and typeof(old.meta) == "table" then
					local owner = old.meta.lockJobId
					local age = now - (tonumber(old.meta.lockTime) or 0)
					if owner ~= nil and owner ~= jobId and age &lt; GameConfig.SESSION_LOCK_TIMEOUT then
						lockedElsewhere = true
						return nil -- nichts schreiben, später erneut versuchen
					end
				end
				local record = if typeof(old) == "table" then old else { data = Template.new(), meta = {} }
				local migrated, reason = Template.migrate(record.data)
				if not migrated then
					invalidReason = reason or "invalid save; original preserved"
					return nil
				end
				record.data = migrated
				if typeof(record.meta) ~= "table" then
					record.meta = {}
				end
				record.meta.lockJobId = jobId
				record.meta.lockTime = now
				loaded = record.data
				return record
			end)
		end)
		if ok and invalidReason then return nil, invalidReason end
		if ok and not lockedElsewhere then
			return loaded, nil
		end
		if not ok then
			warn(`[Save] Laden fehlgeschlagen (Versuch {attempt}): {err}`)
		end
		task.wait(GameConfig.LOAD_RETRY_SECONDS)
	end
	return nil, "save could not be loaded"
end

-- Speichert. release = true gibt den Lock frei (Spieler verlässt den Server).
-- Rückgabe: (gespeichert, Lock verloren)
function SaveService.save(userId: number, data: Types.PlayerData, release: boolean): (boolean, boolean)
	local activeStore = store
	if not SaveService.enabled or not activeStore then
		return true, false
	end
	local key = keyFor(userId)
	local jobId = SESSION_ID
	local payload = sanitize(data)

	for attempt = 1, GameConfig.SAVE_ATTEMPTS do
		local lostLock = false
		waitForBudget()
		local ok, err = pcall(function()
			activeStore:UpdateAsync(key, function(old: any)
				lostLock = false
				local meta = if typeof(old) == "table" and typeof(old.meta) == "table" then old.meta else {}
				if meta.lockJobId ~= nil and meta.lockJobId ~= jobId then
					lostLock = true
					return nil -- eine andere Session besitzt die Daten: nicht überschreiben
				end
				return {
					data = payload,
					meta = {
						lockJobId = if release then nil else jobId,
						lockTime = os.time(),
						saveCount = (tonumber(meta.saveCount) or 0) + 1,
					},
				}
			end)
		end)
		if ok then
			if lostLock then
				warn(`[Save] Lock für {userId} gehört einem anderen Server – nicht gespeichert.`)
			end
			return not lostLock, lostLock
		end
		warn(`[Save] Speichern fehlgeschlagen (Versuch {attempt}): {err}`)
		task.wait(2 ^ attempt)
	end
	return false, false
end

-- Lock freigeben, ohne Daten zu schreiben (Spieler hat den Server verlassen, bevor das Laden fertig war)
function SaveService.releaseLock(userId: number)
	local activeStore = store
	if not SaveService.enabled or not activeStore then
		return
	end
	local jobId = SESSION_ID
	pcall(function()
		activeStore:UpdateAsync(keyFor(userId), function(old: any)
			if typeof(old) == "table" and typeof(old.meta) == "table" and old.meta.lockJobId == jobId then
				old.meta.lockJobId = nil
				return old
			end
			return nil
		end)
	end)
end

return SaveService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">SessionService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Hält die geladenen Spielerdaten im Speicher, schickt Snapshots an den Client und speichert.
-- Andere Services verändern session.data und rufen danach SessionService.markDirty(session).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local ModelConfig = require(ReplicatedStorage.Shared.Config.ModelConfig)
local Types = require(ReplicatedStorage.Shared.Types)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SaveService = require(script.Parent.SaveService)

type Session = ServerTypes.Session

local SessionService = {}

local sessions: { [Player]: Session } = {}
local loadedCallbacks: { (Session) -&gt; () } = {}
local closingCallbacks: { (Session) -&gt; () } = {}

local function emptyLive(): Types.LiveInfo
	return { users = 0, revenue = 0, cost = 0, perModel = {}, npcUsers = {} }
end

function SessionService.get(player: Player): Session?
	return sessions[player]
end

function SessionService.all(): { [Player]: Session }
	return sessions
end

function SessionService.markDirty(session: Session)
	session.dirty = true
end

function SessionService.onLoaded(callback: (Session) -&gt; ())
	table.insert(loadedCallbacks, callback)
end

function SessionService.onClosing(callback: (Session) -&gt; ())
	table.insert(closingCallbacks, callback)
end

function SessionService.snapshot(session: Session): Types.Snapshot
	return {
		saveEnabled = SaveService.enabled,
		serverTime = workspace:GetServerTimeNow(),
		data = session.data,
		live = session.live,
	}
end

-- Schickt geänderte Sessions an ihre Clients (höchstens alle REPLICATE_SECONDS)
function SessionService.flush(now: number)
	for _, session in sessions do
		if session.dirty and not session.closed and now - session.lastSent &gt;= GameConfig.REPLICATE_SECONDS then
			session.dirty = false
			session.lastSent = now
			Remote.fire(session.player, "State", SessionService.snapshot(session))
		end
	end
end

local function saveSession(session: Session, release: boolean)
	local _, lostLock = SaveService.save(session.userId, session.data, release)
	if lostLock and not release then
		-- Ein anderer Server hat übernommen: hier nichts mehr verändern oder speichern
		session.closed = true
		session.player:Kick("AI Empire: Your company was opened on another server.")
	end
end

function SessionService.autosave(now: number)
	for _, session in sessions do
		if not session.saving and not session.closed and now &gt;= session.nextSaveAt then
			session.saving = true
			session.nextSaveAt = now + GameConfig.AUTOSAVE_SECONDS
			task.spawn(function()
				saveSession(session, false)
				session.saving = false
			end)
		end
	end
end

local function onPlayerAdded(player: Player)
	local data, reason = SaveService.load(player.UserId)
	if player.Parent == nil then
		-- schon wieder weg, während wir geladen haben
		if data then
			SaveService.releaseLock(player.UserId)
		end
		return
	end
	if not data then
		player:Kick(`AI Empire: Your save could not be loaded ({reason}). Please rejoin in a minute.`)
		return
	end

	-- Ein offenes Trainings-Event aus der letzten Sitzung bekommt einen frischen Timer
	local training = data.training
	if training and training.event and training.event.pending then
		training.event.expiresAt = workspace:GetServerTimeNow() + ModelConfig.TRAINING.decisionTimeout
	end

	local now = os.clock()
	local session: Session = {
		player = player,
		userId = player.UserId,
		data = data,
		live = emptyLive(),
		dirty = true,
		lastSent = 0,
		nextSaveAt = now + GameConfig.AUTOSAVE_SECONDS + math.random() * 15, -- gestaffelt
		saving = false,
		closed = false,
		released = false,
		rng = Random.new(),
	}
	sessions[player] = session
	for _, callback in loadedCallbacks do
		task.spawn(callback, session)
	end
end

local function closeSession(player: Player)
	local session = sessions[player]
	if not session or session.released then
		return -- unbekannt oder wird schon geschlossen (PlayerRemoving + BindToClose gleichzeitig)
	end
	session.released = true
	local lockLost = session.closed -- closed ohne released = anderer Server hat übernommen
	session.closed = true
	for _, callback in closingCallbacks do
		local ok, err = pcall(callback :: (Session) -&gt; any, session)
		if not ok then
			warn("[Session] closing callback:", err)
		end
	end
	if not lockLost then
		-- laufenden Autosave abwarten, dann final speichern und Lock freigeben
		local waited = 0
		while session.saving and waited &lt; 15 do
			task.wait(0.2)
			waited += 0.2
		end
		session.saving = true
		saveSession(session, true)
	end
	sessions[player] = nil
end

function SessionService.init()
	Remote.setSessionProvider(function(player: Player): Session?
		return sessions[player]
	end)

	Remote.bind("RequestState", { burst = 4, perSecond = 1 }, function(session, _payload)
		return { ok = true, state = SessionService.snapshot(session) }
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(closeSession)

	game:BindToClose(function()
		local pending = 0
		local players = {}
		for player in sessions do
			table.insert(players, player)
		end
		for _, player in players do
			pending += 1
			task.spawn(function()
				closeSession(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending &gt; 0 and os.clock() - started &lt; 25 do
			task.wait(0.25)
		end
	end)
end

return SessionService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000000"><Properties><string name="Name">CampusSoundService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusAudioConfig)
local Service={}
function Service.play(parent: Instance,key: string)
 local id=Config.INTERACTIONS[key];if not id or id=="" then return end
 local sound=Instance.new("Sound");sound.Name="CampusSFX";sound.SoundId=id;sound.Volume=.12;sound.RollOffMinDistance=3;sound.RollOffMaxDistance=28;sound.RollOffMode=Enum.RollOffMode.InverseTapered;sound.Parent=parent;sound:Play()
 task.delay(8,function()if sound.Parent then sound:Destroy() end end)
end
return Service
