local Kit=require(script.Parent.Parent.UI.Kit)
local Controller={}
local player=Players.LocalPlayer
local gui: ScreenGui?=nil
local old: any=nil
local target: CFrame?=nil
local channels: {any}={}
local selected=1
local title: TextLabel?=nil
local currentOwner: number?=nil
function Controller.close()
	if gui then gui:Destroy();gui=nil end
	target=nil;currentOwner=nil;Context:UnbindAction("CampusCameraControls")
	local camera=workspace.CurrentCamera
	if camera and old then
		camera.CameraType=old.kind;camera.CFrame=old.cf;camera.FieldOfView=old.fov
		local h=if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
		camera.CameraSubject=h or old.subject
	end
	old=nil
end
local function selectChannel(index: number)
	selected=(index-1)%#channels+1
	local def=channels[selected];target=def.cframe
	if title then title.Text=string.format("%02d / %02d   %s",selected,#channels,def.name) end
	task.spawn(function()pcall(function()player:RequestStreamAroundAsync(def.cframe.Position,3)end)end)
end
local function show(payload: any)
	if payload.ownerId~=player.UserId or typeof(payload.channels)~="table" then return end
	local clean={};for _,c in payload.channels do if typeof(c.cframe)=="CFrame" and typeof(c.name)=="string" then table.insert(clean,c) end end
	if #clean==0 or not workspace.CurrentCamera then return end
	Controller.close();channels=clean;currentOwner=payload.ownerId
	local camera=workspace.CurrentCamera;old={kind=camera.CameraType,cf=camera.CFrame,fov=camera.FieldOfView,subject=camera.CameraSubject}
	camera.CameraType=Enum.CameraType.Scriptable;camera.FieldOfView=78
	Context:BindAction("CampusCameraControls",function()return Enum.ContextActionResult.Sink end,false,Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,Enum.PlayerActions.CharacterLeft,Enum.PlayerActions.CharacterRight,Enum.PlayerActions.CharacterJump)
	local screen=Instance.new("ScreenGui");screen.Name="CampusSecurity";screen.ResetOnSpawn=false;screen.DisplayOrder=55;screen.Parent=player:WaitForChild("PlayerGui");gui=screen
	local top=Kit.panel(screen,UDim2.new(1,-32,0,74),UDim2.fromOffset(16,16));Kit.padding(top,13,18,13,18)
	Kit.text(top,"CAMPUS SECURITY  /  LIVE",12,Theme.font.bold,Theme.colors.muted)
	title=Kit.text(top,"",19,Theme.font.bold,Theme.colors.text);title.Position=UDim2.fromOffset(0,25);title.AutomaticSize=Enum.AutomaticSize.None;title.Size=UDim2.new(1,-112,0,25);title.TextTruncate=Enum.TextTruncate.AtEnd
	local close=Kit.button(top,"Zurück","secondary",UDim2.fromOffset(100,34));close.Position=UDim2.new(1,-100,0,5);Kit.onClick(close,Controller.close)
	local list=Kit.panel(screen,UDim2.new(0,252,1,-184),UDim2.fromOffset(16,102));Kit.padding(list,10,10,10,10)
	list.Visible=camera.ViewportSize.X&gt;=700
	local choose=Kit.button(screen,"Kanäle","secondary",UDim2.fromOffset(110,34));choose.Position=UDim2.fromOffset(16,102);choose.Visible=not list.Visible;Kit.onClick(choose,function()list.Visible=not list.Visible;choose.Position=if list.Visible then UDim2.fromOffset(280,102) else UDim2.fromOffset(16,102) end)
	local scroll=Kit.scroll(list,UDim2.fromScale(1,1));Kit.list(scroll,6)
	for i,c in channels do local b=Kit.button(scroll,string.format("%02d  %s",i,c.name),"secondary",UDim2.new(1,-6,0,37));b.TextSize=12;b.LayoutOrder=i;Kit.onClick(b,function()selectChannel(i)end) end
	local bottom=Kit.panel(screen,UDim2.fromOffset(math.min(390,camera.ViewportSize.X-32),54),UDim2.new(.5,0,1,-16));bottom.AnchorPoint=Vector2.new(.5,1);Kit.padding(bottom,8,8,8,8)
	local prev=Kit.button(bottom,"← Vorherige","secondary",UDim2.new(.5,-6,0,38));Kit.onClick(prev,function()selectChannel(selected-1)end)
	local next=Kit.button(bottom,"Nächste →","secondary",UDim2.new(.5,-6,0,38));next.Position=UDim2.new(.5,6,0,0);Kit.onClick(next,function()selectChannel(selected+1)end)
	selectChannel(1)
end
function Controller.open()
	task.spawn(function()local ok,result=Action.call("OpenSecurity",{});if ok then show(result) end end)
end
function Controller.init()
	RunService.RenderStepped:Connect(function()
		if target and workspace.CurrentCamera then workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable;workspace.CurrentCamera.CFrame=target end
	end)
	player.CharacterAdded:Connect(Controller.close)
	State.onNotify(function(kind,payload)if kind=="SECURITY_OPEN" then show(payload) end end)
	State.onChange(function(snapshot)
		if currentOwner and (snapshot.live.campus and snapshot.live.campus.hasCard==false) then Controller.close() end
	end)
end
return Controller
