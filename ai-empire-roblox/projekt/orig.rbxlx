</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Format</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Anzeigeformate. Rein, ohne Roblox-APIs.

local Format = {}

local SUFFIXES: { { value: number, suffix: string } } = {
	{ value = 1e12, suffix = "T" },
	{ value = 1e9, suffix = "B" },
	{ value = 1e6, suffix = "M" },
	{ value = 1e3, suffix = "K" },
}

function Format.compact(n: number, decimals: number?): string
	if n ~= n then
		return "0"
	end
	local sign = if n &lt; 0 then "-" else ""
	local a = math.abs(n)
	for _, entry in SUFFIXES do
		if a &gt;= entry.value then
			local text = string.format("%." .. tostring(decimals or 1) .. "f", a / entry.value)
			if string.find(text, ".", 1, true) then
				-- "25.0" -&gt; "25", "1.20" -&gt; "1.2"
				text = string.gsub(string.gsub(text, "0+$", ""), "%.$", "")
			end
			return sign .. text .. entry.suffix
		end
	end
	return sign .. tostring(math.floor(a + 0.5))
end

function Format.money(n: number): string
	if math.abs(n) &lt; 1000 then
		return (if n &lt; 0 then "-$" else "$") .. tostring(math.floor(math.abs(n) + 0.5))
	end
	local text = Format.compact(math.abs(n), if math.abs(n) &gt;= 1e6 then 2 else 1)
	return (if n &lt; 0 then "-$" else "$") .. text
end

-- Volle Zahl mit Tausenderpunkten: 1234567 -&gt; "1,234,567"
function Format.int(n: number): string
	local text = tostring(math.floor(math.abs(n) + 0.5))
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then
		formatted = string.sub(formatted, 2)
	end
	return (if n &lt; 0 then "-" else "") .. formatted
end

function Format.perMinute(perSecond: number): string
	local perMin = perSecond * 60
	return (if perMin &gt;= 0 then "+" else "") .. Format.money(perMin) .. "/min"
end

function Format.tokens(n: number): string
	return Format.compact(n, if n &gt;= 1e9 then 1 else 0)
end

function Format.duration(seconds: number): string
	local s = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", s // 60, s % 60)
end

function Format.price(n: number): string
	return "$" .. string.format("%.2f", n)
end

function Format.percent(fraction: number, decimals: number?): string
	return string.format("%." .. tostring(decimals or 0) .. "f%%", fraction * 100)
end

-- Vorzeichen immer anzeigen: +3.2 / -1.0
function Format.signed(n: number, decimals: number?): string
	return (if n &gt;= 0 then "+" else "-") .. string.format("%." .. tostring(decimals or 1) .. "f", math.abs(n))
end

return Format
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">MarketMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Reine Markt-Simulation: keine Roblox-APIs. Server (Wahrheit), Client (Launch-Prognose)
-- und Tests rechnen mit demselben Code.
--
-- Pro Segment wählen Nutzer per Softmax zwischen allen Modellen + "keins davon".
-- Ein Spielermodell erreicht nur den Teil des Segments, der es kennt (Reichweite):
--   Reichweite = Firmen-Basis (Reputation) + Marketing-Hype (klingt ab) + Mundpropaganda (wächst mit Marktanteil)
--   Zielnutzer = Pool * Reichweite * Marktanteil; echte Nutzer laufen dem Zielwert hinterher.

local Config = script.Parent.Config
local MarketConfig = require(Config.MarketConfig)
local ModelConfig = require(Config.ModelConfig)
local CompanyConfig = require(Config.CompanyConfig)
local GameConfig = require(Config.GameConfig)
local Types = require(script.Parent.Types)

type Stats = Types.Stats
type MarketState = Types.MarketState
type SegmentDef = MarketConfig.SegmentDef

export type LiveEntry = {
	id: string,
	stats: Stats,
	sizeId: string,
	subPrice: number,
	apiPrice: number,
	market: MarketState, -- wird von tick() fortgeschrieben
}

local MarketMath = {}

function MarketMath.fit(stats: Stats, segment: SegmentDef): number
	local fit = 0
	for statId, weight in segment.weights do
		fit += weight * (stats[statId] or 0)
	end
	return fit
end

function MarketMath.utility(stats: Stats, subPrice: number, apiPrice: number, segment: SegmentDef): number
	local price = if segment.priceKind == "api"
		then apiPrice / MarketConfig.PRICE_NORM.api
		else subPrice / MarketConfig.PRICE_NORM.sub
	return (MarketMath.fit(stats, segment) - MarketConfig.FIT_CENTER) / MarketConfig.FIT_SCALE - segment.sens * price
end

function MarketMath.baseReach(reputation: number): number
	local R = MarketConfig.REACH
	return R.base + R.repScale * math.clamp(reputation, 0, 100) / 100
end

function MarketMath.initialHype(target: string, marketing: number): { [string]: number }
	local R = MarketConfig.REACH
	local hype: { [string]: number } = {}
	for _, segment in MarketConfig.SEGMENTS do
		local factor = if target == segment.id
			then R.targetFactor
			elseif target == "general" then R.generalFactor
			else R.spillFactor
		hype[segment.id] = factor * R.hypeMax * (1 - math.exp(-marketing / segment.marketingScale))
	end
	return hype
end

function MarketMath.newMarketState(target: string, marketing: number): MarketState
	return {
		age = 0,
		users = {},
		organic = {},
		hype = MarketMath.initialHype(target, marketing),
		revenueTotal = 0,
		peakUsers = 0,
	}
end

function MarketMath.totalUsers(state: MarketState): number
	local total = 0
	for _, users in state.users do
		total += users
	end
	return total
end

-- Ein Simulationsschritt für alle Live-Modelle eines Spielers. Mutiert entry.market.
function MarketMath.tick(models: { LiveEntry }, reputation: number, specId: string, dt: number, rivals: { LiveEntry }?, npcModels: any?): Types.LiveInfo
	local R = MarketConfig.REACH
	local npcList=npcModels or MarketConfig.NPC_MODELS
	local spec = CompanyConfig.getSpec(specId)
	local serveMult = if spec and spec.serveCostMult then spec.serveCostMult else 1
	local enterpriseMult = if spec and spec.enterpriseRevenueMult then spec.enterpriseRevenueMult else 1
	local base = MarketMath.baseReach(reputation)
	local month = GameConfig.GAME_MONTH_SECONDS

	local result: Types.LiveInfo = { users = 0, revenue = 0, cost = 0, perModel = {}, npcUsers = {} }
	for _, model in models do
		model.market.age += dt
		result.perModel[model.id] = { users = 0, revenue = 0, cost = 0 }
	end

	for _, segment in MarketConfig.SEGMENTS do
		local pivot = segment.outside
		for _, entry in npcList do pivot = math.max(pivot, MarketMath.utility(entry.stats,entry.subPrice,entry.apiPrice,segment)) end
		for _, entry in models do pivot = math.max(pivot, MarketMath.utility(entry.stats,entry.subPrice,entry.apiPrice,segment)) end
		for _, entry in rivals or {} do pivot = math.max(pivot, MarketMath.utility(entry.stats,entry.subPrice,entry.apiPrice,segment)) end
		local denominator = math.exp(segment.outside - pivot)
		for _, entry in rivals or {} do denominator += math.exp(MarketMath.utility(entry.stats,entry.subPrice,entry.apiPrice,segment)-pivot) end
		local npcWeight: { [string]: number } = {}
		for _, npc in npcList do
			local w = math.exp(MarketMath.utility(npc.stats, npc.subPrice, npc.apiPrice, segment)-pivot)
			npcWeight[npc.id] = w
			denominator += w
		end
		local liveWeight: { [string]: number } = {}
		for _, model in models do
			local w = math.exp(MarketMath.utility(model.stats, model.subPrice, model.apiPrice, segment)-pivot)
			liveWeight[model.id] = w
			denominator += w
		end

		for _, npc in npcList do
			local users = segment.pool * MarketConfig.NPC_REACH * npcWeight[npc.id] / denominator
			result.npcUsers[npc.id] = (result.npcUsers[npc.id] or 0) + users
		end

		for _, model in models do
			local share = liveWeight[model.id] / denominator
			local state = model.market

			local organic = state.organic[segment.id] or 0
			organic += (R.organicShare * share - organic) * math.min(1, R.organicRate * dt)
			state.organic[segment.id] = organic

			local hype = (state.hype[segment.id] or 0) * math.exp(-state.age / R.hypeTau)
			local reach = math.clamp(base + hype + organic, 0, R.max)
			local target = segment.pool * reach * share

			local users = state.users[segment.id] or 0
			local tau = if target &gt; users then MarketConfig.USERS.riseTau else MarketConfig.USERS.fallTau
			users += (target - users) * (1 - math.exp(-dt / tau))
			state.users[segment.id] = users

			local size = ModelConfig.getSize(model.sizeId)
			local millionTokens = users * segment.tokensPerUser / 1e6
			local revenue = if segment.priceKind == "api"
				then millionTokens * model.apiPrice * (if segment.enterprise then enterpriseMult else 1)
				else users * model.subPrice
			local cost = millionTokens * (if size then size.serveCost else 0) * serveMult

			local perModel = result.perModel[model.id]
			perModel.users += users
			perModel.revenue += revenue / month
			perModel.cost += cost / month
		end
	end

	for _, model in models do
		local perModel = result.perModel[model.id]
		model.market.peakUsers = math.max(model.market.peakUsers, perModel.users)
		model.market.revenueTotal += perModel.revenue * dt
		result.users += perModel.users
		result.revenue += perModel.revenue
		result.cost += perModel.cost
	end
	return result
end

function MarketMath.reputationStep(reputation: number, totalUsers: number, bestOverall: number, dt: number): number
	local P = MarketConfig.REPUTATION
	local target = math.min(100, P.userPart * (1 - math.exp(-totalUsers / P.userScale)) + P.qualityPart * bestOverall)
	return reputation + (target - reputation) * math.min(1, P.rate * dt)
end

local function cloneEntry(entry: LiveEntry): LiveEntry
	local m = entry.market
	return {
		id = entry.id,
		stats = entry.stats,
		sizeId = entry.sizeId,
		subPrice = entry.subPrice,
		apiPrice = entry.apiPrice,
		market = {
			age = m.age,
			users = table.clone(m.users),
			organic = table.clone(m.organic),
			hype = table.clone(m.hype),
			revenueTotal = m.revenueTotal,
			peakUsers = m.peakUsers,
		},
	}
end

-- Prognose für den Release-Screen: simuliert `seconds` Sekunden auf Kopien.
function MarketMath.forecast(
	candidate: LiveEntry,
	others: { LiveEntry },
	reputation: number,
	specId: string,
	seconds: number
): Types.LiveModelResult
	local list = { cloneEntry(candidate) }
	for _, other in others do
		table.insert(list, cloneEntry(other))
	end
	local result: Types.LiveModelResult = { users = 0, revenue = 0, cost = 0 }
	for _ = 1, math.max(1, math.floor(seconds / 5)) do
		result = MarketMath.tick(list, reputation, specId, 5).perModel[candidate.id]
	end
	return result
end

return MarketMath
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">ModelMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Reine Mathe für Modelle: keine Roblox-APIs, damit Server, Client (Vorschau) und Tests
-- exakt dieselbe Formel benutzen.

local Config = script.Parent.Config
local ModelConfig = require(Config.ModelConfig)
local HardwareConfig = require(Config.HardwareConfig)
local DataConfig = require(Config.DataConfig)
local CompanyConfig = require(Config.CompanyConfig)
local Types = require(script.Parent.Types)

type Stats = Types.Stats
type DataStock = Types.DataStock
type DataSummary = Types.DataSummary
type Fleet = Types.Fleet
type SizeDef = ModelConfig.SizeDef

export type Plan = {
	ok: boolean,
	reason: string?, -- "VRAM" | "NO_DATA" | "NO_GPU"
	work: number,
	rate: number, -- Compute-Einheiten pro Sekunde (inkl. Mindestdauer)
	seconds: number,
	cost: number,
}

export type Readiness = { fill: number, quantity: number, quality: number, factor: number }

local ModelMath = {}

function ModelMath.fleet(gpus: { [string]: number }): Fleet
	local throughput, vram, weightedCost, slots = 0, 0, 0, 0
	for _, gpu in HardwareConfig.GPUS do
		local count = gpus[gpu.id] or 0
		if count &gt; 0 then
			throughput += gpu.throughput * count
			vram += gpu.vram * count
			weightedCost += gpu.powerCost * gpu.throughput * count
			if not gpu.starter then
				slots += count
			end
		end
	end
	return {
		throughput = throughput,
		vram = vram,
		costPerWork = if throughput &gt; 0 then weightedCost / throughput else 0,
		slotsUsed = slots,
	}
end

function ModelMath.dataSummary(stock: { [string]: DataStock }): DataSummary
	local total, weighted = 0, 0
	local perType: { [string]: number } = {}
	for _, dataType in DataConfig.TYPES do
		local entry = stock[dataType.id]
		local tokens = if entry then entry.tokens else 0
		perType[dataType.id] = tokens
		total += tokens
		if entry then
			weighted += entry.tokens * entry.quality
		end
	end
	local shares: { [string]: number } = {}
	for id, tokens in perType do
		shares[id] = if total &gt; 0 then tokens / total else 0
	end
	return { total = total, quality = if total &gt; 0 then weighted / total else 0, shares = shares }
end

-- Fügt Tokens hinzu; Qualität wird gewichtet gemittelt (billige Masse verdünnt gute Daten).
function ModelMath.addTokens(stock: { [string]: DataStock }, typeId: string, tokens: number, quality: number)
	local entry = stock[typeId]
	if entry then
		local total = entry.tokens + tokens
		entry.quality = (entry.tokens * entry.quality + tokens * quality) / total
		entry.tokens = total
	else
		stock[typeId] = { tokens = tokens, quality = quality }
	end
end

function ModelMath.copyStock(stock: { [string]: DataStock }): { [string]: DataStock }
	local copy: { [string]: DataStock } = {}
	for id, entry in stock do
		copy[id] = { tokens = entry.tokens, quality = entry.quality }
	end
	return copy
end

function ModelMath.readiness(size: SizeDef, data: DataSummary): Readiness
	local D = ModelConfig.DATA
	local fill = math.min(D.maxFill, data.total / size.dataNeed)
	local quantity = 1 - math.exp(-D.quantityK * fill)
	local quality = D.qualityBase + D.qualityK * data.quality
	return { fill = fill, quantity = quantity, quality = quality, factor = quantity * quality }
end

function ModelMath.recipeFactor(size: SizeDef,data: DataSummary,id: string): number
	local recipe=ModelConfig.getRecipe(id) or ModelConfig.RECIPES[1]
	local enough=data.total&gt;=size.dataNeed*.5 and data.quality&gt;=.6
	return recipe.quality*(if id=="deep" and not enough then .68 else 1)
end
function ModelMath.plan(size: SizeDef, fleet: Fleet, data: DataSummary,recipeId: string?): Plan
	local T = ModelConfig.TRAINING
	local recipe=ModelConfig.getRecipe(recipeId or "steady") or ModelConfig.RECIPES[1]
	local work=size.work*recipe.work
	local reason: string? = nil
	if fleet.throughput &lt;= 0 then
		reason = "NO_GPU"
	elseif fleet.vram &lt; size.vram then
		reason = "VRAM"
	elseif data.total &lt; T.minTokens then
		reason = "NO_DATA"
	end
	local rate = if fleet.throughput &gt; 0 then math.min(fleet.throughput, work / T.minSeconds) else 0
	return {
		ok = reason == nil,
		reason = reason,
		work = work,
		rate = rate,
		seconds = if rate &gt; 0 then work / rate else 0,
		cost = math.floor(work * fleet.costPerWork),
	}
end

-- Trainingsrate während eines laufenden Trainings (GPU-Käufe beschleunigen sofort)
function ModelMath.trainingRate(fleet: Fleet, workTotal: number): number
	return math.min(fleet.throughput, workTotal / ModelConfig.TRAINING.minSeconds)
end

function ModelMath.overall(stats: Stats): number
	local sum, weightSum = 0, 0
	for _, stat in ModelConfig.STATS do
		if stat.weight &gt; 0 then
			sum += (stats[stat.id] or 0) * stat.weight
			weightSum += stat.weight
		end
	end
	return math.round(sum / weightSum * 10) / 10
end

-- noise(n) liefert einen Wert in [-n, n]. nil = keine Streuung (Vorschau, Erwartungswert).
function ModelMath.computeStats(
	sizeId: string,
	focusId: string,
	data: DataSummary,
	specId: string,
	qualityMod: number,
	noise: ((number) -&gt; number)?
): (Stats, number)
	local size = ModelConfig.getSize(sizeId)
	local focus = ModelConfig.getFocus(focusId)
	assert(size and focus, "computeStats: unbekannte Größe oder Fokus")
	local spec = CompanyConfig.getSpec(specId)
	local bonus = if spec and spec.statBonus then spec.statBonus else {}
	local D = ModelConfig.DATA
	local core = size.potential * (D.floor + (1 - D.floor) * ModelMath.readiness(size, data).factor) * qualityMod

	local stats: Stats = {}
	for _, stat in ModelConfig.STATS do
		local id = stat.id
		local value: number
		if id == "speed" then
			value = size.speed
		elseif id == "efficiency" then
			value = size.efficiency
		else
			local affinity: number
			if id == "reliability" then
				affinity = ModelConfig.RELIABILITY.base + ModelConfig.RELIABILITY.quality * data.quality
			else
				local coeffs = ModelConfig.AFFINITY[id]
				affinity = coeffs.base or 1
				for typeId, k in coeffs do
					if typeId ~= "base" then
						affinity += k * (data.shares[typeId] or 0)
					end
				end
			end
			value = core * affinity * (focus.mult[id] or 1)
		end
		value += bonus[id] or 0
		if noise then
			value += noise(ModelConfig.TRAINING.noise)
		end
		stats[id] = if id == "speed" or id == "efficiency" or id == "reliability" then math.clamp(math.round(value * 10) / 10, 1, 99) else math.max(1, math.round(value * 10) / 10)
	end
	return stats, ModelMath.overall(stats)
end

-- Simulierter Loss: fällt exponentiell Richtung eines Endwerts, der vom erwarteten Overall abhängt
function ModelMath.lossAt(progress: number, expected: number, jitter: number): number
	local final = 3.4 / (1 + math.max(0, expected) / 60)
	local p = math.clamp(progress, 0, 1)
	return final + (ModelConfig.TRAINING.lossStart - final) * math.exp(-4.5 * p) + jitter
end

-- roll() liefert [0, 1). Gibt nil zurück, wenn kein Event eintritt.
function ModelMath.rollEvent(roll: () -&gt; number, specId: string): ModelConfig.EventDef?
	if roll() &gt; ModelConfig.TRAINING.eventChance then
		return nil
	end
	local spec = CompanyConfig.getSpec(specId)
	local breakthroughMult = if spec and spec.breakthroughMult then spec.breakthroughMult else 1
	local function weightOf(event: ModelConfig.EventDef): number
		return event.weight * (if event.id == "breakthrough" then breakthroughMult else 1)
	end
	local total = 0
	for _, event in ModelConfig.EVENTS do
		total += weightOf(event)
	end
	local r = roll() * total
	for _, event in ModelConfig.EVENTS do
		local w = weightOf(event)
		if r &lt; w then
			return event
		end
		r -= w
	end
	return ModelConfig.EVENTS[#ModelConfig.EVENTS]
end

return ModelMath
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Net</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Alle Remotes an einer Stelle. Der Server legt sie beim Start in ReplicatedStorage.Remotes an,
-- der Client wartet darauf. Neue Aktion = Namen hier eintragen + Handler im Server binden.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.FOLDER = "Remotes"

-- Client -&gt; Server (Antwort immer { ok = boolean, err = string?, ... })
Net.FUNCTIONS = {
	"RequestState",
	"CreateCompany",
	"Scrape",
	"BuyData",
	"BuyGPU",
	"SellGPU",
	"StartTraining",
	"ResolveEvent",
	"ReleaseModel",
 "EvaluateModel",
	"UpdatePricing",
	"RetireModel",
	"Debug",
	"AdminAction",
	"OpenSecurity",
	"HireEmployee",
	"BuySnack",
	"ReplaceCard",
	"UseCampusLift",
	"GrantGuestCard",
	"RevokeGuestCard",
	"UpgradeRetail",
	"BuyCar",
	"SpawnCar",
	"FireEmployee",
	"StartResearch",
	"UpgradeOffice",
	"ClaimQuest",
	"DeliverContract",
	"ClaimDaily",
	"ImproveModel",
	"BuildProject",
	"CancelProject",
	"ArchiveProject",
	"PublishProject",
	"DeliverProject",
	"RunArena",
	"SetComputeShare",
	"UpgradeCooling",
	"BuyModelAccess",
	"CancelModelAccess",
} :: { string }

-- Server -&gt; Client
Net.EVENTS = {
	"VehicleInput", -- validated driver input (client -&gt; server)
	"State", -- kompletter Snapshot der eigenen Spielerdaten
	"Notify", -- (kind: string, payload: table) für Momente wie TRAINING_COMPLETE
} :: { string }

local function folder(): Instance
	return ReplicatedStorage:WaitForChild(Net.FOLDER)
end

function Net.getFunction(name: string): RemoteFunction
	return folder():WaitForChild(name) :: RemoteFunction
end

function Net.getEvent(name: string): RemoteEvent
	return folder():WaitForChild(name) :: RemoteEvent
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Types</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Zentrale Datentypen. Alles, was gespeichert oder an den Client geschickt wird, ist hier beschrieben.
-- Regel für gespeicherte Daten: nur string-Keys in Dictionaries, Arrays lückenlos (DataStore = JSON).

export type Stats = { [string]: number }

export type DataStock = { tokens: number, quality: number }

export type DataSummary = { total: number, quality: number, shares: { [string]: number } }

export type Fleet = { throughput: number, vram: number, costPerWork: number, slotsUsed: number }

export type MarketState = {
	age: number, -- Sekunden seit Release (nur Online-Zeit)
	users: { [string]: number }, -- Nutzer pro Segment
	organic: { [string]: number }, -- Mundpropaganda-Reichweite pro Segment
	hype: { [string]: number }, -- Marketing-Reichweite pro Segment beim Launch
	revenueTotal: number,
	peakUsers: number,
}

export type ReleaseConfig = {
	subPrice: number,
	apiPrice: number,
	marketing: number,
	target: string,
	releasedAt: number,
}

export type ModelStatus = "training" | "trained" | "live" | "retired"

export type ModelData = {
	id: string,
	name: string,
	version: number,
	sizeId: string,
	focusId: string,
	status: ModelStatus,
	createdAt: number,
	trainedAt: number?,
	stats: Stats,
	overall: number,
	trainCost: number,
	iterations: number?,
	dataUsed: DataSummary,
	release: ReleaseConfig?,
	market: MarketState?,
}

export type TrainingEventState = {
	id: string,
	pending: boolean,
	expiresAt: number, -- workspace:GetServerTimeNow()-Zeit; beim Laden neu gesetzt
	outcome: string?, -- gewählte Option bzw. Ergebnis, für die Anzeige
}

export type TrainingState = {
	modelId: string,
	refinement: boolean?,
	baseStats: Stats?,
	resumeLive: boolean?,
	workTotal: number,
	workDone: number,
	cost: number,
	expected: number, -- erwarteter Overall (für die Loss-Kurve)
	qualityMod: number,
	eventRolled: boolean,
	event: TrainingEventState?,
	epoch: number, -- zuletzt gemeldete Epoche (Log-Zeilen)
	loss: { number },
	log: { string },
}

export type Company = {
	name: string,
	logo: string,
	color: string,
	spec: string,
	foundedAt: number,
	reputation: number,
}

export type PlayerStats = {
	totalRevenue: number,
	totalCost: number,
	modelsTrained: number,
	modelsReleased: number,
	peakUsers: number,
	bestOverall: number,
}

export type PlayerData = {
	empire: any,
	version: number,
	company: Company?,
	money: number,
	data: { [string]: DataStock },
	gpus: { [string]: number },
	models: { [string]: ModelData },
	modelOrder: { string },
	training: TrainingState?,
	lastScrapeAt: number,
	stats: PlayerStats,
}

-- Laufzeitwerte (nicht gespeichert), die mit jedem Snapshot an den Client gehen
export type LiveModelResult = { users: number, revenue: number, cost: number }

export type LiveInfo = {
	admin: boolean?,
 workforce: any?,
	campus: any?,
	empire: any?,
	marketplace: any?,
	studio: any?,
	arena: any?,
	rankings: any?,
	users: number,
	revenue: number, -- $ pro Sekunde
	cost: number, -- $ pro Sekunde
	perModel: { [string]: LiveModelResult },
	npcUsers: { [string]: number },
}

export type Snapshot = {
	saveEnabled: boolean,
	serverTime: number,
	data: PlayerData,
	live: LiveInfo,
}

export type ActionResult = { ok: boolean, err: string?, [string]: any }

return {}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000002"><Properties><string name="Name">JourneyMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ModelMath=require(script.Parent.ModelMath)
local ModelConfig=require(script.Parent.Config.ModelConfig)
local Format=require(script.Parent.Format)
local Journey={}
Journey.STEPS={
 {id="data",label="DATA",app="data",title="Get training data",body="Data Operations · scrape free data or buy a pack. Data quantity and quality determine what your AI learns."},
 {id="compute",label="COMPUTE",app="compute",title="Check your compute",body="GPU control · your laptop can train a 100M model. Larger models need more VRAM; more GPU throughput shortens training."},
 {id="design",label="DESIGN",app="lab",title="Design your model",body="Model Architecture · choose a name, size, focus and recipe. Start small, then increase size when data and hardware support it."},
 {id="train",label="TRAIN",app="lab",title="Train with your own data",body="Training Control · start the run, watch loss and progress, and respond to training decisions."},
 {id="evaluation",label="EVALUATE",app="lab",section="evaluation",title="Evaluate your model",body="Evaluation Lab · compare coding, reasoning, math, creativity, knowledge and reliability before launch."},
 {id="release",label="LAUNCH",app="lab",section="release",title="Release your model",body="Deployment Studio · choose subscription and API prices, target customers and marketing, then launch."},
 {id="grow",label="GROW",app="market",title="Grow and improve",body="Growth · users and API customers pay for your live model. Hire a team and research improvements for the next generation."},
}
function Journey.latest(data: any,trainedOnly: boolean?): any
 for i=#data.modelOrder,1,-1 do local m=data.models[data.modelOrder[i]];if m and m.status~="training" and (not trainedOnly or m.status=="trained") then return m end end
 return nil
end
function Journey.progress(data: any,selection: any?): any
 local size=ModelConfig.getSize(if selection then selection.sizeId else "s100m") or ModelConfig.SIZES[1]
 local stock=ModelMath.dataSummary(data.data);local fleet=ModelMath.fleet(data.gpus)
 local released=data.stats.modelsReleased&gt;0;local trained=data.stats.modelsTrained&gt;0
 local done={stock.total&gt;=ModelConfig.TRAINING.minTokens or trained or released,fleet.vram&gt;=size.vram and fleet.throughput&gt;0 or trained or released,data.training~=nil or trained or released,trained or released,data.empire.quests.journey_evaluation==true or released,released,released and data.stats.totalRevenue&gt;0}
 local index=7;for i=1,7 do if not done[i] then index=i;break end end
 if data.training then index=4 end
 local missing=math.max(0,size.vram-fleet.vram);local hint=""
 if missing&gt;0 then hint=string.format("%s needs %d GB more VRAM · open Hardware",size.label,missing)
 elseif stock.total&lt;ModelConfig.TRAINING.minTokens then hint="Collect at least "..Format.tokens(ModelConfig.TRAINING.minTokens).." tokens before training."
 elseif size.id=="s7b" and not data.empire.research.frontier then hint="7B requires Frontier Architecture research in Company."
 else hint=string.format("%s · %d GB VRAM ready · %s tokens · %.0f%% quality",size.label,fleet.vram,Format.tokens(stock.total),stock.quality*100) end
 return {index=index,done=done,step=Journey.STEPS[index],hint=hint,missingVram=missing,complete=done[7]}
end
return Journey
