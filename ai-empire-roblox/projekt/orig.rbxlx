		local c=add("CampusCamera_"..id,Vector3.new(1.6,.8,.8),position.X,position.Y,position.Z,ink,Enum.Material.Metal)
		c.CFrame=cf*CFrame.lookAt(position,target);c:SetAttribute("CameraId",id);c:SetAttribute("CameraName",name);c:SetAttribute("ViewCFrame",cf*CFrame.lookAt(position,target)*CFrame.new(0,0,-1.3))
		local lens=add("CameraLens",Vector3.new(.5,.5,.2),position.X,position.Y,position.Z-.5,glass,Enum.Material.Glass);lens.CFrame=c.CFrame*CFrame.new(0,0,-.5);lens.CanCollide=false
	end
