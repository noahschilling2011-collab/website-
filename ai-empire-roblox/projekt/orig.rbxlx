-- Runtime only: never adds derived fields to the player's save.
-- An offscreen team retains the existing economy. Visible work/break/meeting states feed the same bonuses once.
local runtime: {[any]:any}=setmetatable({},{__mode="k"}) :: any
local Math={}
function Math.set(empire: any,counts: any?) runtime[empire]=counts end
function Math.count(empire: any,role: string): number
 local report=runtime[empire]
 return math.clamp(if report and typeof(report[role])=="number" then report[role] else (empire.employees[role] or 0),0,empire.employees[role] or 0)
end
return Math
