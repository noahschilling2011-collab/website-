 local leftArm=part("Left Arm",Vector3.new(1,2,1),CFrame.new(-1.5*scale,0,0),outfit)
 local rightArm=part("Right Arm",Vector3.new(1,2,1),CFrame.new(1.5*scale,0,0),outfit)
 local leftLeg=part("Left Leg",Vector3.new(1,2,1),CFrame.new(-.5*scale,-2*scale,0),Color3.fromRGB(54,62,70))
 local rightLeg=part("Right Leg",Vector3.new(1,2,1),CFrame.new(.5*scale,-2*scale,0),Color3.fromRGB(54,62,70))
 local function joint(name: string,p0: BasePart,p1: BasePart,c0: CFrame,c1: CFrame)
  local m=Instance.new("Motor6D");m.Name=name;m.Part0=p0;m.Part1=p1;m.C0=c0;m.C1=c1;m.Parent=p0
 end
 joint("RootJoint",root,torso,CFrame.new(),CFrame.new())
