-- Nearby staff follow a daily routine. Vehicle input supports Roblox's keyboard/gamepad/touch controller.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Net=require(ReplicatedStorage.Shared.Net)
local Math=require(ReplicatedStorage.Shared.CampusMath)
local State=require(script.Parent.StateController)
local Toast=require(script.Parent.Parent.UI.Toast)
local Action=require(script.Parent.ActionController)
local Theme=require(script.Parent.Parent.UI.Theme)
local Kit=require(script.Parent.Parent.UI.Kit)
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Controller={}
local player=Players.LocalPlayer
local liftGui: ScreenGui?=nil
local function liftPicker(payload: any)
	if liftGui then liftGui:Destroy() end
	local gui=Instance.new("ScreenGui");gui.Name="CampusLift";gui.ResetOnSpawn=false;gui.DisplayOrder=40;gui.Parent=player:WaitForChild("PlayerGui");liftGui=gui
	local box=Kit.frame(gui,UDim2.fromOffset(370,112+(payload.floors+2)*43),UDim2.fromScale(.5,.5));box.AnchorPoint=Vector2.new(.5,.5);box.BackgroundColor3=Theme.colors.panel;box.BackgroundTransparency=0;Kit.corner(box,12);Kit.padding(box,16,16,16,16)
	local scale=Instance.new("UIScale");local camera=workspace.CurrentCamera;scale.Scale=if camera then math.max(.3,math.min(1,(camera.ViewportSize.Y-32)/(112+(payload.floors+2)*43),(camera.ViewportSize.X-24)/370)) else 1;scale.Parent=box
	Kit.list(box,5)
	local heading=Kit.para(box,"Choose a floor",20,Theme.colors.text,1);heading.Font=Theme.font.bold
	for floor=-1,payload.floors do
		local label=if floor==payload.floors then "R  /  Roof garden" else Config.floorName(payload.tier,floor)
		local b=Kit.button(box,label,"secondary",UDim2.new(1,0,0,38));b.LayoutOrder=floor+3
		Kit.onClick(b,function()
			task.spawn(function()
				local ok=Action.call("UseCampusLift",{ownerId=payload.ownerId,floor=floor})
				if ok and gui.Parent then gui:Destroy();if liftGui==gui then liftGui=nil end end
			end)
		end)
	end
	local close=Kit.button(box,"Close","secondary",UDim2.new(1,0,0,32));close.LayoutOrder=20;Kit.onClick(close,function()gui:Destroy();if liftGui==gui then liftGui=nil end end)
end
function Controller.init()
	local input=Net.getEvent("VehicleInput")
	local clock=0
	RunService.Heartbeat:Connect(function(dt)
		clock+=dt
		local character=player.Character;local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
		local seat=if humanoid then humanoid.SeatPart else nil
		if clock&gt;=.06 then
			clock=0
			if seat and seat:IsA("VehicleSeat") and seat.Parent:GetAttribute("OwnerUserId")==player.UserId then
				input:FireServer(seat.Parent:GetAttribute("CarId"),seat.ThrottleFloat,seat.SteerFloat)
			end
		end

	end)
	State.onNotify(function(kind,payload)
		if kind=="LIFT_MENU" and typeof(payload.ownerId)=="number" and typeof(payload.floors)=="number" and payload.floors&gt;=3 and payload.floors&lt;=7 then liftPicker(payload) end
		if kind=="CAMPUS_NOTICE" and typeof(payload.text)=="string" then Toast.show("info",payload.text,5) end
	end)
end
return Controller
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000056"><Properties><string name="Name">UI</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000046"><Properties><string name="Name">Apps</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">ComputeApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Compute: Flottenübersicht, Rack (wie im 3D-Büro), Trainingszeiten pro Modellgröße, GPU-Shop.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local HardwareConfig = require(Shared.Config.HardwareConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot

local TIER_SHADE: { [string]: (Color3) -&gt; Color3 } = {
	consumer = Theme.darker(0.35),
	workstation = function(color: Color3): Color3
		return color
	end,
	accelerator = Theme.lighter(0.55),
}

local ComputeApp = {}

local root: Frame? = nil
local refresh: (Snapshot) -&gt; () = function(_snapshot: Snapshot) end

function ComputeApp.mount(parent: Frame, navigation: Kit.Nav)
	root = parent

	local scroll = Kit.scroll(parent)
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)

	Kit.heading(scroll, "COMPUTE", "GPUs train your models. More throughput = faster training, more VRAM = bigger models, better GPUs = cheaper power per unit.", 1)

	-- Flotte
	local fleetCard = Kit.card(scroll, 2, 12)
	local metrics = Kit.grid(fleetCard, 4, 48, 10, 1)
	local mThroughput = Kit.metric(metrics, "Throughput", 1, 20)
	local mTflops = Kit.metric(metrics, "Peak", 2, 20)
	local mVram = Kit.metric(metrics, "VRAM", 3, 20)
	local mPower = Kit.metric(metrics, "Power cost", 4, 20)
	local rackHead = Kit.frame(fleetCard, UDim2.new(1, 0, 0, 18))
	rackHead.LayoutOrder = 2
	Kit.caption(rackHead, "Server rack")
	local rackText = Kit.text(rackHead, "", 13, F.bold, C.muted)
	rackText.AnchorPoint = Vector2.new(1, 0)
	rackText.Position = UDim2.fromScale(1, 0)
	local rack = Kit.grid(fleetCard, HardwareConfig.RACK_SLOTS, 34, 8, 3)
	local slots: { { frame: Frame, label: TextLabel } } = {}
	for i = 1, HardwareConfig.RACK_SLOTS do
		local slot = Kit.frame(rack)
		slot.LayoutOrder = i
		slot.BackgroundTransparency = 0
		slot.BackgroundColor3 = C.raised
		Kit.corner(slot, 6)
		local label = Kit.text(slot, "", 11, F.bold, C.bg)
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.5)
		slots[i] = { frame = slot, label = label }
	end
	local speedText = Kit.para(fleetCard, "", 14, C.muted, 4)

	local operations=Kit.card(scroll,3,10)
	Kit.caption(operations,"Compute operations",1)
	local thermal=Kit.para(operations,"",13,C.muted,2)
	local cooling=Kit.button(operations,"UPGRADE COOLING","secondary",UDim2.new(1,0,0,34));cooling.LayoutOrder=3
	Kit.onClick(cooling,function() ActionController.call("UpgradeCooling",{}) end)
	Kit.caption(operations,"GPU split during shared workloads",4)
	local shares=Kit.segmented(operations,{{id="0.35",label="35% training"},{id="0.5",label="50%"},{id="0.7",label="70%"},{id="0.9",label="90%"}},"0.7",function(id) ActionController.call("SetComputeShare",{share=tonumber(id)}) end)
	shares.frame.LayoutOrder=5
	Kit.para(operations,"More training compute leaves less capacity for projects and business customers. Better cooling prevents large clusters from slowing down.",13,C.dim,6)

	-- Shop
	Kit.caption(scroll, "Hardware", 4)
	local list = Kit.stack(scroll, 10, 5)
	local rowRefs: { [string]: { owned: TextLabel, buy: TextButton?, sell: TextButton? } } = {}
	for index, gpu in HardwareConfig.GPUS do
		local row = Kit.frame(list, UDim2.new(1, 0, 0, 96))
		row.LayoutOrder = index
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = C.panel2
		Kit.corner(row, 12)
		Kit.stroke(row, 0.92)
		Kit.padding(row, 12, 14, 12, 16)

		local nameRow = Kit.frame(row, UDim2.new(1, -260, 0, 24))
		Kit.list(nameRow, 8, true)
		local name = Kit.text(nameRow, gpu.label, 18, F.bold, C.text)
		name.LayoutOrder = 1
		Kit.tag(nameRow, gpu.tier, if gpu.starter then C.dim else C.muted, 2)
		local stats = Kit.text(
			row,
			`{gpu.throughput} units/s · {gpu.vram} GB VRAM · ${gpu.powerCost} power per unit`,
			14,
			F.medium,
			C.muted
		)
		stats.Position = UDim2.fromOffset(0, 30)
		local owned = Kit.text(row, "", 14, F.bold, C.text)
		owned.Position = UDim2.fromOffset(0, 52)

		local refs: { owned: TextLabel, buy: TextButton?, sell: TextButton? } = { owned = owned, buy = nil, sell = nil }
		if gpu.starter then
			local included = Kit.text(row, "Included", 15, F.medium, C.dim)
			included.AnchorPoint = Vector2.new(1, 0.5)
			included.Position = UDim2.fromScale(1, 0.5)
		else
			local buy = Kit.button(row, `BUY {Format.money(gpu.price)}`, "primary", UDim2.fromOffset(150, 38))
			buy.AnchorPoint = Vector2.new(1, 0.5)
			buy.Position = UDim2.new(1, -96, 0.5, 0)
			buy.TextSize = 14
			local sell = Kit.button(row, "SELL", "ghost", UDim2.fromOffset(86, 38))
			sell.AnchorPoint = Vector2.new(1, 0.5)
			sell.Position = UDim2.fromScale(1, 0.5)
			sell.TextSize = 14
			Kit.onClick(buy, function()
				local ok = ActionController.call("BuyGPU", { gpuId = gpu.id })
				if ok then
					Toast.show("success", `{gpu.label} installed in your rack.`)
				end
			end)
			Kit.onClick(sell, function()
				local refund = math.floor(gpu.price * HardwareConfig.SELL_REFUND)
				local ok = ActionController.call("SellGPU", { gpuId = gpu.id })
				if ok then
					Toast.show("info", `Sold {gpu.label} for {Format.money(refund)}.`)
				end
			end)
			refs.buy = buy
			refs.sell = sell
		end
		rowRefs[gpu.id] = refs
	end
	Kit.para(scroll, `Selling refunds {Format.percent(HardwareConfig.SELL_REFUND)} and is locked while a model trains.`, 13, C.dim, 5)

	refresh = function(snapshot: Snapshot)
		local data = snapshot.data
		local fleet = ModelMath.fleet(data.gpus)
		local infrastructure=data.empire.infrastructure
		thermal.Text="Cooling level "..tostring(infrastructure.cooling).." / 8 · "..Format.percent(HardwareConfig.thermal(data.empire,fleet.throughput)).." sustained GPU performance"
		cooling.Text="UPGRADE COOLING · "..Format.money(math.floor(8000*1.7^(infrastructure.cooling-1)))
		Kit.setDisabled(cooling,infrastructure.cooling&gt;=8 or data.money&lt;math.floor(8000*1.7^(infrastructure.cooling-1)))
		shares.set(tostring(infrastructure.trainingShare))
		mThroughput.value.Text = `{fleet.throughput} u/s`
		mTflops.value.Text = `{Format.compact(fleet.throughput * HardwareConfig.TFLOPS_PER_UNIT, 0)} TFLOPS`
		mVram.value.Text = `{fleet.vram} GB`
		mPower.value.Text = `${string.format("%.1f", fleet.costPerWork)}/unit`

		-- Rack von stark nach schwach füllen (wie im Büro)
		local filled = 0
		for i = #HardwareConfig.GPUS, 1, -1 do
			local gpu = HardwareConfig.GPUS[i]
			if not gpu.starter then
				for _ = 1, data.gpus[gpu.id] or 0 do
					filled += 1
					local slot = slots[filled]
					if slot then
						local shade = TIER_SHADE[gpu.id]
						slot.frame.BackgroundColor3 = if shade then shade(Theme.accent) else Theme.accent
						slot.label.Text = "T" .. string.sub(gpu.tier, -1)
					end
				end
			end
		end
		for i = filled + 1, #slots do
			slots[i].frame.BackgroundColor3 = C.raised
			slots[i].label.Text = ""
		end
		rackText.Text = `{fleet.slotsUsed}/{HardwareConfig.slots(data.empire)} slots used · upgrade office / Cluster research for more`

		local parts: { string } = {}
		for _, size in ModelConfig.SIZES do
			if size.id == "s7b" and not data.empire.research.frontier then
				table.insert(parts, "7B: research required")
			elseif fleet.vram &lt; size.vram then
				table.insert(parts, `{size.label}: needs {size.vram} GB`)
			else
				local plan = ModelMath.plan(size, fleet, { total = math.huge, quality = 0, shares = {} })
				local rate = EmpireMath.trainingRate(data.gpus,plan.work,data.empire)
				table.insert(parts, `{size.label}: {Format.duration(if rate &gt; 0 then plan.work/rate else 0)}`)
			end
		end
		speedText.Text = "Training time: " .. table.concat(parts, " · ")

		local money = StateController.money()
		local rackFull = fleet.slotsUsed &gt;= HardwareConfig.slots(data.empire)
		local training = data.training ~= nil
		for _, gpu in HardwareConfig.GPUS do
			local refs = rowRefs[gpu.id]
			if refs then
				local count = data.gpus[gpu.id] or 0
				refs.owned.Text = `Owned: {count}`
				local buy, sell = refs.buy, refs.sell
				if buy then
					Kit.setDisabled(buy, rackFull or money &lt; gpu.price)
					buy.Text = if rackFull then "RACK FULL" else `BUY {Format.money(gpu.price)}`
				end
				if sell then
					Kit.setDisabled(sell, count &lt;= 0 or training)
				end
			end
		end
	end

	StateController.onChange(function(snapshot: Snapshot)
		if parent.Visible and navigation.isOpen() then
			refresh(snapshot)
		end
	end)
	Theme.onAccent(function()
		local snapshot = StateController.snapshot
		if snapshot and parent.Visible then
			refresh(snapshot)
		end
	end)
end

function ComputeApp.onShow()
	local snapshot = StateController.snapshot
	if snapshot and root then
		refresh(snapshot)
	end
end

return ComputeApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">DataApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Trainingsdaten: Inventar pro Typ, kostenloses Scrapen, Datenmarkt.
-- Jede Paket-Karte zeigt, wie viel Overall das Paket für die im Lab gewählte Größe bringen würde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local DataConfig = require(Shared.Config.DataConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot

local TYPE_COLORS: { [string]: Color3 } = {
	general = Color3.fromRGB(96, 165, 250),
	code = Color3.fromRGB(52, 211, 153),
	math = Color3.fromRGB(251, 191, 36),
}

local DataApp = {}

local root: Frame? = nil
local refresh: (Snapshot) -&gt; () = function(_snapshot: Snapshot) end

local function typeLabel(id: string): string
	for _, dataType in DataConfig.TYPES do
		if dataType.id == id then
			return dataType.label
		end
	end
	return id
end

function DataApp.mount(parent: Frame, navigation: Kit.Nav)
	root = parent

	local scroll = Kit.scroll(parent)
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)

	Kit.heading(scroll, "TRAINING DATA", "More data makes models smarter, better data makes them reliable. Data is not used up by training.", 1)

	-- Inventar
	local inventory = Kit.card(scroll, 2, 10)
	local invHead = Kit.frame(inventory, UDim2.new(1, 0, 0, 20))
	invHead.LayoutOrder = 1
	Kit.caption(invHead, "Your datasets")
	local totalText = Kit.text(invHead, "", 14, F.bold, C.text)
	totalText.AnchorPoint = Vector2.new(1, 0)
	totalText.Position = UDim2.fromScale(1, 0)
	local tiles = Kit.grid(inventory, #DataConfig.TYPES, 86, 10, 2)
	local tileRefs: { [string]: { tokens: TextLabel, bar: Kit.Bar, quality: TextLabel } } = {}
	for index, dataType in DataConfig.TYPES do
		local tile = Kit.frame(tiles)
		tile.LayoutOrder = index
		tile.BackgroundTransparency = 0.3
		tile.BackgroundColor3 = C.bg
		Kit.corner(tile, 10)
		Kit.padding(tile, 10, 12, 10, 12)
		Kit.list(tile, 4)
		local name = Kit.text(tile, dataType.label, 13, F.bold, TYPE_COLORS[dataType.id] or C.muted)
		name.LayoutOrder = 1
		local tokens = Kit.text(tile, "0", 22, F.black, C.text)
		tokens.LayoutOrder = 2
		local bar = Kit.bar(tile, 6, 3, TYPE_COLORS[dataType.id])
		local quality = Kit.text(tile, "", 12, F.medium, C.dim)
		quality.LayoutOrder = 4
		tileRefs[dataType.id] = { tokens = tokens, bar = bar, quality = quality }
	end
	local readiness = Kit.para(inventory, "", 14, C.muted, 3)

	-- Scrapen
	local scrapeCard = Kit.card(scroll, 3, 8)
	local scrapeTitle = Kit.text(scrapeCard, "Scrape the web", 18, F.bold, C.text)
	scrapeTitle.LayoutOrder = 1
	Kit.para(
		scrapeCard,
		`Free, but slow and messy: {Format.tokens(DataConfig.SCRAPE.tokens)} tokens of {typeLabel(DataConfig.SCRAPE.type)} at {Format.percent(DataConfig.SCRAPE.quality)} quality, every {DataConfig.SCRAPE.cooldown}s.`,
		14,
		C.muted,
		2
	)
	local scrapeButton = Kit.button(scrapeCard, "SCRAPE", "secondary", UDim2.fromOffset(200, 42))
	scrapeButton.LayoutOrder = 3
	Kit.onClick(scrapeButton, function()
		local ok = ActionController.call("Scrape", {})
		if ok then
			Toast.show("success", `+{Format.tokens(DataConfig.SCRAPE.tokens)} tokens scraped.`)
		end
	end)

	-- Markt
	local marketCaption = Kit.caption(scroll, "Data market", 4)
	marketCaption.TextSize = 13
	local deltaNote = Kit.para(scroll, "", 13, C.dim, 5)
	local packGrid = Kit.grid(scroll, 2, 148, 12, 6)
	local packRefs: { [string]: { delta: TextLabel, buy: TextButton, buy5: TextButton } } = {}
	for index, pack in DataConfig.PACKS do
		local card = Kit.frame(packGrid)
		card.LayoutOrder = index
		card.BackgroundTransparency = 0.05
		card.BackgroundColor3 = C.panel2
		Kit.corner(card, 12)
		Kit.stroke(card, 0.92)
		Kit.padding(card, 12, 14, 12, 14)

		local name = Kit.text(card, pack.label, 17, F.bold, C.text)
		name.Position = UDim2.new()
		local tag = Kit.tag(card, typeLabel(pack.type), TYPE_COLORS[pack.type] or C.muted)
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.fromScale(1, 0)
		local info = Kit.text(card, `{Format.tokens(pack.tokens)} tokens · quality {Format.percent(pack.quality)}`, 14, F.medium, C.muted)
		info.Position = UDim2.fromOffset(0, 26)
		local delta = Kit.text(card, "", 14, F.bold, C.good)
		delta.Position = UDim2.fromOffset(0, 48)
		local price = Kit.text(card, Format.money(pack.price), 18, F.black, C.text)
		price.AnchorPoint = Vector2.new(0, 1)
		price.Position = UDim2.fromScale(0, 1)
		local buy5 = Kit.button(card, "x5", "ghost", UDim2.fromOffset(52, 36))
		buy5.AnchorPoint = Vector2.new(1, 1)
		buy5.Position = UDim2.fromScale(1, 1)
		buy5.TextSize = 14
		local buy = Kit.button(card, "BUY", "primary", UDim2.fromOffset(86, 36))
		buy.AnchorPoint = Vector2.new(1, 1)
		buy.Position = UDim2.new(1, -60, 1, 0)
		buy.TextSize = 14

		local function purchase(count: number)
			local ok = ActionController.call("BuyData", { packId = pack.id, count = count })
			if ok then
				Toast.show("success", `Bought {count}x {pack.label} (+{Format.tokens(pack.tokens * count)} tokens).`, 2)
			end
		end
		Kit.onClick(buy, function()
			purchase(1)
		end)
		Kit.onClick(buy5, function()
			purchase(5)
		end)
		packRefs[pack.id] = { delta = delta, buy = buy, buy5 = buy5 }
	end

	refresh = function(snapshot: Snapshot)
		local data = snapshot.data
		local summary = ModelMath.dataSummary(data.data)
		totalText.Text = `{Format.tokens(summary.total)} tokens · avg quality {Format.percent(summary.quality)}`
		local largest = 1
		for _, stock in data.data do
			largest = math.max(largest, stock.tokens)
		end
		for id, refs in tileRefs do
			local stock = data.data[id]
			local tokens = if stock then stock.tokens else 0
			refs.tokens.Text = Format.tokens(tokens)
			refs.bar.set(tokens / largest)
			refs.quality.Text = if stock then `quality {Format.percent(stock.quality)}` else "none yet"
		end

		local ui = StateController.ui
		local size = ModelConfig.getSize(ui.sizeId)
		local company = data.company
		local spec = if company then company.spec else "general"
		if size then
			local ready = ModelMath.readiness(size, summary)
			readiness.Text = `Data fill for a {size.label} model: {Format.percent(ready.fill)}`
				.. (if ready.fill &lt; 1 then ` (full at {Format.tokens(size.dataNeed)} tokens)` else " - full! Quality matters most now.")
			deltaNote.Text = `Green numbers: Overall change for your selected {size.label} {string.lower(ui.focusId)} model in the Lab.`
			local baseStats, baseOverall = ModelMath.computeStats(size.id, ui.focusId, summary, spec, 1, nil)
			baseStats, baseOverall = EmpireMath.boostStats(baseStats, data.empire)
			for _, pack in DataConfig.PACKS do
				local refs = packRefs[pack.id]
				if refs then
					local stock = ModelMath.copyStock(data.data)
					ModelMath.addTokens(stock, pack.type, pack.tokens, pack.quality)
					local packStats, withPack = ModelMath.computeStats(size.id, ui.focusId, ModelMath.dataSummary(stock), spec, 1, nil)
					packStats, withPack = EmpireMath.boostStats(packStats, data.empire)
					local diff = withPack - baseOverall
					refs.delta.Text = `{Format.signed(diff)} Overall on {size.label}`
					refs.delta.TextColor3 = if diff &gt; 0.05 then C.good elseif diff &lt; -0.05 then C.bad else C.dim
				end
			end
		end

		local money = StateController.money()
		for _, pack in DataConfig.PACKS do
			local refs = packRefs[pack.id]
			if refs then
				Kit.setDisabled(refs.buy, money &lt; pack.price)
				Kit.setDisabled(refs.buy5, money &lt; pack.price * 5)
			end
		end
	end

	StateController.onChange(function(snapshot: Snapshot)
		if parent.Visible and navigation.isOpen() then
			refresh(snapshot)
		end
	end)
	StateController.onUiChange(function()
		local snapshot = StateController.snapshot
		if snapshot and parent.Visible then
			refresh(snapshot)
		end
	end)

	-- Cooldown-Anzeige läuft unabhängig vom Snapshot-Takt
	RunService.RenderStepped:Connect(function()
		local snapshot = StateController.snapshot
		if not snapshot or not parent.Visible or not navigation.isOpen() then
			return
		end
		local remaining = snapshot.data.lastScrapeAt + DataConfig.SCRAPE.cooldown - workspace:GetServerTimeNow()
		if remaining &gt; 0 then
			scrapeButton.Text = `COOLDOWN {math.ceil(remaining)}s`
			Kit.setDisabled(scrapeButton, true)
		else
			scrapeButton.Text = `SCRAPE (+{Format.tokens(DataConfig.SCRAPE.tokens)})`
			Kit.setDisabled(scrapeButton, false)
		end
	end)
end

function DataApp.onShow()
	local snapshot = StateController.snapshot
	if snapshot and root then
		refresh(snapshot)
	end
end


return DataApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">LabApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Modell-Labor. Vier Ansichten, je nach Zustand:
--   creator  -&gt; Modell entwerfen (Name, Größe, Fokus) mit Live-Schätzung
--   training -&gt; Fortschritt, Loss-Graph, Events mit Entscheidung, Log
--   result   -&gt; Ergebnis mit Stats und Vergleich
--   release  -&gt; Preise, Marketing, Zielgruppe, Prognose, Launch

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local MarketConfig = require(Shared.Config.MarketConfig)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local MarketMath = require(Shared.MarketMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)

local C = Theme.colors
local F = Theme.font
local T = ModelConfig.TRAINING

type Snapshot = Types.Snapshot
type ModelData = Types.ModelData

local NAME_IDEAS = { "Nova", "Atlas", "Echo", "Pulse", "Quill", "Sage", "Orbit", "Flux", "Iris", "Vega", "Lumen", "Spark" }
local CORE_STATS = { "reasoning", "coding", "math", "creativity", "knowledge", "reliability" }
local LOSS_MIN, LOSS_MAX = 0.6, 5.2
local FORECAST_SECONDS = 300
local MARKETING_TIERS = { 5_000, 10_000, 25_000, 50_000, 100_000, 250_000 }

local LabApp = {}

local nav: Kit.Nav? = nil
local container: Frame? = nil
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local view = "creator"
local resultId: string? = nil
local resultBest: number? = nil
local releaseId: string? = nil
local views: { [string]: GuiObject } = {}
local refreshers: { [string]: (Snapshot) -&gt; () } = {}
local nameBox: TextBox? = nil

---------------------------------------------------------------------------- Helfer

local function statLabel(id: string): string
	for _, stat in ModelConfig.STATS do
		if stat.id == id then
			return stat.label
		end
	end
	return id
end

local function sizeLabel(id: string): string
	local size = ModelConfig.getSize(id)
	return if size then size.label else id
end

local function focusLabel(id: string): string
	local focus = ModelConfig.getFocus(id)
	return if focus then focus.label else id
end

local function modelTitle(model: ModelData): string
	return `{model.name} v{model.version}`
end

local function trim(text: string): string
	return string.match(text, "^%s*(.-)%s*$") or ""
end

local function validName(text: string): boolean
	local length = utf8.len(trim(text))
	return length ~= nil and length &gt;= GameConfig.MODEL_NAME_MIN and length &lt;= GameConfig.MODEL_NAME_MAX
end

local function bestOverall(data: Types.PlayerData, exceptId: string?): number
	local best = 0
	for id, model in data.models do
		if id ~= exceptId and model.status ~= "training" then
			best = math.max(best, model.overall)
		end
	end
	return best
end

local function specOf(data: Types.PlayerData): string
	local company = data.company
	return if company then company.spec else "general"
end

local function liveEntries(data: Types.PlayerData, exceptId: string?): { MarketMath.LiveEntry }
	local list: { MarketMath.LiveEntry } = {}
	for _, id in data.modelOrder do
		local model: ModelData? = data.models[id]
		local release = if model then model.release else nil
		local market = if model then model.market else nil
		if model and id ~= exceptId and model.status == "live" and release and market then
			table.insert(list, {
				id = id,
				stats = model.stats,
				sizeId = model.sizeId,
				subPrice = release.subPrice,
				apiPrice = release.apiPrice,
				market = market,
			})
		end
	end
	return list
end

local function decideView(snapshot: Snapshot): string
	local data = snapshot.data
	if data.training then
		return "training"
	end
	local rid = releaseId
	if rid then
		local model: ModelData? = data.models[rid]
		if model and model.status == "trained" then
			return "release"
		end
		releaseId = nil
	end
	local res = resultId
	if res then
		local model: ModelData? = data.models[res]
		if model and model.status ~= "training" then
			return "result"
		end
		resultId = nil
	end
	return "creator"
end

local function render()
	local snapshot = StateController.snapshot
	if not snapshot then
		return
	end
	local nextView = decideView(snapshot)
	if nextView ~= view then
		view = nextView
		for id, frame in views do
			frame.Visible = id == view
		end
	end
	local refresh = refreshers[view]
	if refresh then
		refresh(snapshot)
	end
end

local function header(parent: Instance, captionText: string, order: number): (TextLabel, TextLabel, TextLabel)
	local head = Kit.stack(parent, 2, order)
	local caption = Kit.caption(head, captionText, 1)
	local title = Kit.text(head, "", 24, F.display, C.text)
	title.LayoutOrder = 2
	local sub = Kit.text(head, "", 15, F.medium, C.muted)
	sub.LayoutOrder = 3
	return caption, title, sub
end

local function scrollView(parent: Frame, id: string): ScrollingFrame
	local scroll = Kit.scroll(parent)
	scroll.Name = id
	scroll.Visible = id == view
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)
	views[id] = scroll
	return scroll
end

local function animateNumber(label: TextLabel, target: number)
	task.spawn(function()
		local start = os.clock()
		local duration = 1.1
		while label.Parent do
			local t = math.min(1, (os.clock() - start) / duration)
			local eased = 1 - (1 - t) ^ 3
			label.Text = string.format("%.1f", target * eased)
			if t &gt;= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

---------------------------------------------------------------------------- Creator

local function buildCreator(parent: Frame)
	local scroll = scrollView(parent, "creator")
	Kit.heading(scroll, "MODEL LAB", "Pick a size and a focus, then train on your GPUs. Bigger models need more VRAM and much more data.", 1)

	local left, right = Kit.columns(scroll, 0.52, 16, 2)

	-- Konfiguration
	local config = Kit.card(left, 1, 10)
	Kit.caption(config, "Model name", 1)
	local box = Kit.input(config, "e.g. Nova")
	box.LayoutOrder = 2
	box.Text = NAME_IDEAS[math.random(1, #NAME_IDEAS)]
	nameBox = box

	local sizeOptions: { Kit.Option } = {}
	for _, size in ModelConfig.SIZES do
		table.insert(sizeOptions, { id = size.id, label = size.label })
	end
	local focusOptions: { Kit.Option } = {}
	for _, focus in ModelConfig.FOCUSES do
		table.insert(focusOptions, { id = focus.id, label = focus.label })
	end

	Kit.caption(config, "Size (parameters)", 3)
	local sizeSeg = Kit.segmented(config, sizeOptions, StateController.ui.sizeId, function(id: string)
		StateController.setSelection(id, StateController.ui.focusId)
		render()
	end)
	sizeSeg.frame.LayoutOrder = 4
	local sizeHint = Kit.para(config, "", 13, C.dim, 5)

	Kit.caption(config, "Training focus", 6)
	local focusSeg = Kit.segmented(config, focusOptions, StateController.ui.focusId, function(id: string)
		StateController.setSelection(StateController.ui.sizeId, id)
		render()
	end)
	focusSeg.frame.LayoutOrder = 7
	local focusHint = Kit.para(config, "", 13, C.dim, 8)

	Kit.caption(config,"Training budget &amp; validation",9)
	local recipeOptions={};for _,recipe in ModelConfig.RECIPES do table.insert(recipeOptions,{id=recipe.id,label=recipe.label}) end
	local recipes=Kit.segmented(config,recipeOptions,StateController.ui.recipeId or "steady",function(id) StateController.setRecipe(id);render() end)
	recipes.frame.LayoutOrder=10
	local recipeHint=Kit.para(config,"",13,C.dim,11)

	-- Fertige, noch nicht veröffentlichte Modelle
	local readyCard = Kit.card(left, 2, 8)
	Kit.caption(readyCard, "Ready to launch", 1)
	local readyList = Kit.stack(readyCard, 8, 2)
	local readyEmpty = Kit.para(readyCard, "Your trained checkpoints appear here. Add 100M fresh tokens to refine a checkpoint with your own GPUs. Higher intelligence is possible beyond 99 points.", 14, C.dim, 3)
	local readyKey = ""

	-- Schätzung
	local est = Kit.card(right, 1, 10)
	Theme.bindAccent(est, "BackgroundColor3", Theme.tint(0.88)) -- Hero-Fläche
	Kit.caption(est, "Expected result", 1)
	local overallRow = Kit.row(est, 58, 14, 2)
	local expected = Kit.text(overallRow, "--", 40, F.display)
	expected.LayoutOrder = 1
	Theme.bindAccent(expected, "TextColor3")
	local info = Kit.frame(overallRow, UDim2.new())
	info.AutomaticSize = Enum.AutomaticSize.XY
	info.LayoutOrder = 2
	Kit.list(info, 2)
	Kit.caption(info, "Overall (estimate)", 1)
	local bestText = Kit.text(info, "", 14, F.medium, C.muted)
	bestText.LayoutOrder = 2

	local rows: { [string]: Kit.StatRow } = {}
	for index, id in CORE_STATS do
		rows[id] = Kit.statRow(est, statLabel(id), 2 + index)
	end
	Kit.divider(est, 10)
	local metrics = Kit.grid(est, 2, 46, 10, 11)
	local mTime = Kit.metric(metrics, "Training time", 1, 18)
	local mCost = Kit.metric(metrics, "Training cost", 2, 18)
	local mVram = Kit.metric(metrics, "VRAM", 3, 18)
	local mCompute = Kit.metric(metrics, "Compute", 4, 18)
	Kit.caption(est, "Data fill", 12)
	local fillBar = Kit.bar(est, 10, 13)
	local fillText = Kit.para(est, "", 13, C.dim, 14)
	local train = Kit.button(est, "START TRAINING", "primary", UDim2.new(1, 0, 0, 50))
	train.LayoutOrder = 15
	train.TextSize = 17

	local action: string? = nil -- "train" | "compute" | "data"

	local function rebuildReady(data: Types.PlayerData)
		local ids: { string } = {}
		for _, id in data.modelOrder do
			local model: ModelData? = data.models[id]
			if model and model.status == "trained" then
				table.insert(ids, id)
			end
		end
		local key = table.concat(ids, ",")
		if key == readyKey then
			return
		end
		readyKey = key
		for _, child in readyList:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for index, id in ids do
			local model = data.models[id]
			local row = Kit.frame(readyList, UDim2.new(1, 0, 0, 56))
			row.LayoutOrder = index
			row.BackgroundTransparency = 0.3
			row.BackgroundColor3 = C.bg
			Kit.corner(row, 10)
			local name = Kit.text(row, modelTitle(model), 16, F.bold, C.text)
			name.Position = UDim2.fromOffset(12, 8)
			name.AutomaticSize = Enum.AutomaticSize.None
			name.Size = UDim2.new(1,-300,0,22)
			name.TextTruncate = Enum.TextTruncate.AtEnd
			local sub = Kit.text(
				row,
				`{sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · Overall {string.format("%.1f", model.overall)}`,
				13,
				F.medium,
				C.muted
			)
			sub.Position = UDim2.fromOffset(12, 30)
			sub.AutomaticSize = Enum.AutomaticSize.None
			sub.Size = UDim2.new(1,-300,0,18)
			sub.TextTruncate = Enum.TextTruncate.AtEnd
			local refine = Kit.button(row,"REFINE", "secondary", UDim2.fromOffset(110,36))
			refine.AnchorPoint = Vector2.new(1,0.5)
			refine.Position = UDim2.new(1,-125,0.5,0)
			Kit.onClick(refine,function() ActionController.call("ImproveModel",{modelId=id}) end)
			local button = Kit.button(row, "RELEASE", "primary", UDim2.fromOffset(104, 36))
			button.AnchorPoint = Vector2.new(1, 0.5)
			button.Position = UDim2.new(1, -10, 0.5, 0)
			button.TextSize = 14
			Kit.onClick(button, function()
				releaseId = id
				resultId = nil
				render()
			end)
		end
		readyEmpty.Visible = #ids == 0
	end

	refreshers.creator = function(snapshot: Snapshot)
		local data = snapshot.data
		local ui = StateController.ui
		sizeSeg.set(ui.sizeId)
		focusSeg.set(ui.focusId)
		local size = ModelConfig.getSize(ui.sizeId)
		local focus = ModelConfig.getFocus(ui.focusId)
		if not size or not focus then
			return
		end
		local fleet = ModelMath.fleet(data.gpus)
		local summary = ModelMath.dataSummary(data.data)
		local recipeId=ui.recipeId or "steady"
		recipes.set(recipeId)
		recipeHint.Text=ModelConfig.getRecipe(recipeId).desc
		local plan = ModelMath.plan(size, fleet, summary,recipeId)
		local stats, overall = ModelMath.computeStats(size.id, focus.id, summary, specOf(data), ModelMath.recipeFactor(size,summary,recipeId), nil)
		stats, overall = EmpireMath.boostStats(stats, data.empire)
		plan.rate = EmpireMath.trainingRate(data.gpus, plan.work, data.empire)
		plan.seconds = if plan.rate &gt; 0 then plan.work / plan.rate else 0

		expected.Text = string.format("%.1f", overall)
		local best = bestOverall(data, nil)
		bestText.Text = if best &gt; 0
			then `your best: {string.format("%.1f", best)}  ({Format.signed(overall - best)})`
			else "your first model"
		for id, row in rows do
			row.set(stats[id] or 0)
		end

		mTime.value.Text = if plan.rate &gt; 0 then Format.duration(plan.seconds) else "--"
		mCost.value.Text = Format.money(plan.cost)
		mVram.value.Text = `{size.vram} of {fleet.vram} GB`
		mVram.value.TextColor3 = if fleet.vram &gt;= size.vram then C.text else C.bad
		mCompute.value.Text = `{fleet.throughput} units/s`

		local readiness = ModelMath.readiness(size, summary)
		fillBar.set(readiness.fill)
		fillText.Text = `{Format.tokens(summary.total)} tokens · fill {Format.percent(readiness.fill)} · quality {Format.percent(summary.quality)}`
			.. (if readiness.fill &lt; 1 then "  (more data = smarter model)" else "")

		for _, other in ModelConfig.SIZES do
			sizeSeg.setDim(other.id, fleet.vram &lt; other.vram or (other.id == "s7b" and not data.empire.research.frontier))
		end
		sizeHint.Text = `{size.label} params · needs {size.vram} GB VRAM · full data at {Format.tokens(size.dataNeed)} tokens`
		local parts: { string } = {}
		for _, stat in ModelConfig.STATS do
			local mult = focus.mult[stat.id]
			if mult then
				table.insert(parts, `{stat.label} {Format.signed((mult - 1) * 100, 0)}%`)
			end
		end
		focusHint.Text = if #parts &gt; 0 then table.concat(parts, " · ") else "No bonus, no weakness."

		local nameText = if nameBox then nameBox.Text else ""
		action = nil
		local label: string
		if not validName(nameText) then
			label = `NAME NEEDS {GameConfig.MODEL_NAME_MIN}-{GameConfig.MODEL_NAME_MAX} CHARACTERS`
		elseif plan.reason == "NO_GPU" then
			label = "NO GPU · OPEN COMPUTE"
			action = "compute"
		elseif plan.reason == "VRAM" then
			label = `NEEDS {size.vram-fleet.vram} GB MORE VRAM · OPEN COMPUTE`
			action = "compute"
		elseif plan.reason == "NO_DATA" then
			label = "NEED TRAINING DATA · OPEN DATA"
			action = "data"
		elseif size.id == "s7b" and not data.empire.research.frontier then
			label = "RESEARCH FRONTIER ARCHITECTURE · COMPANY"
			action = "empire"
		elseif StateController.money() &lt; plan.cost then
			label = `NEED {Format.money(plan.cost)}`
		else
			label = `START TRAINING · {Format.money(plan.cost)}`
			action = "train"
		end
		train.Text = label
		Kit.setDisabled(train, action == nil)
		rebuildReady(data)
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if view == "creator" then
			render()
		end
	end)

	Kit.onClick(train, function()
		local currentNav = nav
		if action == "compute" and currentNav then
			currentNav.show("compute")
			return
		elseif action == "data" and currentNav then
			currentNav.show("data")
			return
		elseif action == "empire" and currentNav then
			currentNav.show("empire")
			return
		elseif action ~= "train" then
			return
		end
		local name = trim(box.Text)
		local ui = StateController.ui
		ActionController.call("StartTraining", { name = name, sizeId = ui.sizeId, focusId = ui.focusId, recipeId=ui.recipeId })
		-- Rückmeldung ist die Trainingsansicht selbst, die mit dem nächsten Snapshot erscheint
	end)
end

---------------------------------------------------------------------------- Training

local function buildTraining(parent: Frame)
	local scroll = scrollView(parent, "training")
	local _, title, sub = header(scroll, "Training in progress", 1)

	local progressCard = Kit.card(scroll, 2, 8)
	local progressRow = Kit.frame(progressCard, UDim2.new(1, 0, 0, 30))
	progressRow.LayoutOrder = 1
	local percent = Kit.text(progressRow, "0%", 26, F.black, C.text)
	local eta = Kit.text(progressRow, "", 16, F.bold, C.muted)
	eta.AnchorPoint = Vector2.new(1, 0)
	eta.Position = UDim2.fromScale(1, 0)
	local bar = Kit.bar(progressCard, 14, 2)

	local lossCard = Kit.card(scroll, 3, 8)
	Theme.bindAccent(lossCard, "BackgroundColor3", Theme.tint(0.9)) -- Signatur: der Trainingslauf
	local lossRow = Kit.frame(lossCard, UDim2.new(1, 0, 0, 20))
	lossRow.LayoutOrder = 1
	Kit.caption(lossRow, "Training loss (lower is better)")
	local lossValue = Kit.text(lossRow, "", 16, F.bold, C.text)
	lossValue.AnchorPoint = Vector2.new(1, 0)
	lossValue.Position = UDim2.fromScale(1, 0)
	lossValue.Font = F.display
	local graph = Kit.frame(lossCard, UDim2.new(1, 0, 0, 190))
	graph.LayoutOrder = 2
	graph.BackgroundTransparency = 0.2
	graph.BackgroundColor3 = C.bg
	graph.ClipsDescendants = true
	Kit.corner(graph, 10)
	for i = 1, 3 do
		local line = Kit.frame(graph, UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, i / 4, 0))
		line.BackgroundTransparency = 0.94
		line.BackgroundColor3 = C.line
	end
	local lossBars: { Frame } = {}
	for i = 1, T.lossPoints do
		local b = Kit.frame(graph, UDim2.new(1 / T.lossPoints, -3, 0.02, 0), UDim2.new((i - 1) / T.lossPoints, 1, 1, 0))
		b.AnchorPoint = Vector2.new(0, 1)
		b.BackgroundTransparency = 0.88
		Theme.bindAccent(b, "BackgroundColor3")
		Kit.corner(b, 2)
		local fade = Instance.new("UIGradient") -- Säulen leuchten oben, laufen nach unten aus
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(0, 0.7)
		fade.Parent = b
		lossBars[i] = b
	end

	local metrics = Kit.grid(scroll, 4, 50, 10, 4)
	local mCompute = Kit.metric(metrics, "Compute", 1, 18)
	local mCost = Kit.metric(metrics, "Cost", 2, 18)
	local mData = Kit.metric(metrics, "Data", 3, 18)
	local mQuality = Kit.metric(metrics, "Quality mod", 4, 18)

	-- Entscheidungs-Event
	local eventCard = Kit.card(scroll, 5, 10)
	eventCard.Visible = false
	local eventStroke = eventCard:FindFirstChildOfClass("UIStroke")
	if eventStroke then
		eventStroke.Color = C.warn
		eventStroke.Transparency = 0.3
		eventStroke.Thickness = 2
		local lit = eventStroke:FindFirstChildOfClass("UIGradient") -- Warnrahmen gleichmäßig, ohne Lichtverlauf
		if lit then
			lit:Destroy()
		end
	end
	local eventTitle = Kit.text(eventCard, "", 22, F.black, C.warn)
	eventTitle.LayoutOrder = 1
	local eventText = Kit.para(eventCard, "", 15, C.text, 2)
	local choiceRow = Kit.grid(eventCard, 2, 66, 10, 3)
	local choiceButtons: { TextButton } = {}
	local choiceIds: { string } = {}
	for i = 1, 2 do
		local button = Kit.button(choiceRow, "", if i == 1 then "secondary" else "warn")
		button.LayoutOrder = i
		button.RichText = true
		button.TextWrapped = true
		choiceButtons[i] = button
		choiceIds[i] = ""
		Kit.onClick(button, function()
			local choice = choiceIds[i]
			if choice ~= "" then
				ActionController.call("ResolveEvent", { choice = choice })
			end
		end)
	end
	local countdown = Kit.para(eventCard, "", 13, C.muted, 4)
	local currentEvent = ""
	local defaultLabel = ""

	local logCard = Kit.card(scroll, 6, 4)
	Kit.caption(logCard, "Log", 0)
	local logLabels: { TextLabel } = {}
	for i = 1, T.logLines do
		local line = Kit.text(logCard, "", 13, F.mono, C.muted)
		line.LayoutOrder = i
		logLabels[i] = line
	end

	refreshers.training = function(snapshot: Snapshot)
		local data = snapshot.data
		local training = data.training
		if not training then
			return
		end
		local model: ModelData? = data.models[training.modelId]
		if model then
			title.Text = modelTitle(model)
			sub.Text = `{sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · expected overall ~{string.format("%.0f", training.expected)}`
			mData.value.Text = Format.tokens(model.dataUsed.total)
		end

		local count = #training.loss
		for i, b in lossBars do
			local value = training.loss[i]
			if value then
				local h = math.clamp((value - LOSS_MIN) / (LOSS_MAX - LOSS_MIN), 0.03, 1)
				b.Size = UDim2.new(1 / T.lossPoints, -3, h, 0)
				b.BackgroundTransparency = if i == count then 0 else 0.25
				b.BackgroundColor3 = if i == count then Theme.accent:Lerp(C.white, 0.45) else Theme.accent
			else
				b.Size = UDim2.new(1 / T.lossPoints, -3, 0.02, 0)
				b.BackgroundTransparency = 0.88
				b.BackgroundColor3 = Theme.accent
			end
		end
		lossValue.Text = string.format("%.3f", training.loss[count] or T.lossStart)

		local fleet = ModelMath.fleet(data.gpus)
		mCompute.value.Text = `{fleet.throughput} u/s`
		mCost.value.Text = Format.money(training.cost)
		mQuality.value.Text = string.format("x%.2f", training.qualityMod)
		mQuality.value.TextColor3 = if training.qualityMod &lt; 1
			then C.bad
			elseif training.qualityMod &gt; 1 then C.good
			else C.text

		for i, line in logLabels do
			line.Text = training.log[i] or ""
		end

		local event = training.event
		local def = if event and event.pending then ModelConfig.getEvent(event.id) else nil
		local choices = if def then def.choices else nil
		eventCard.Visible = choices ~= nil
		if def and choices and event and currentEvent ~= event.id then
			currentEvent = event.id
			eventTitle.Text = def.title
			eventText.Text = def.text .. " Training is paused until you decide."
			defaultLabel = ""
			for i, button in choiceButtons do
				local choice = choices[i]
				button.Visible = choice ~= nil
				if choice then
					choiceIds[i] = choice.id
					button.Text = `&lt;b&gt;{Kit.escape(choice.label)}&lt;/b&gt;\n&lt;font size="13"&gt;{Kit.escape(choice.desc)}&lt;/font&gt;`
					if choice.id == def.default then
						defaultLabel = choice.label
					end
				else
					choiceIds[i] = ""
				end
			end
		elseif not choices then
			currentEvent = ""
		end
	end

	RunService.RenderStepped:Connect(function()
		local currentNav = nav
		local snapshot = StateController.snapshot
		if not currentNav or not currentNav.isOpen() or view ~= "training" or not snapshot then
			return
		end
		local training = snapshot.data.training
		if not training then
			return
		end
		local done, total = StateController.trainingWork()
		local fraction = if total &gt; 0 then done / total else 0
		bar.set(fraction)
		percent.Text = Format.percent(fraction)
		local event = training.event
		if event and event.pending then
			eta.Text = "PAUSED"
			eta.TextColor3 = C.warn
			local remaining = math.max(0, event.expiresAt - workspace:GetServerTimeNow())
			countdown.Text = `Auto-picks "{defaultLabel}" in {math.ceil(remaining)}s`
		else
			eta.Text = "ETA " .. Format.duration(StateController.trainingEta())
			eta.TextColor3 = C.muted
		end
	end)
end

---------------------------------------------------------------------------- Result

local function buildResult(parent: Frame)
	local scroll = scrollView(parent, "result")
	local caption, title, sub = header(scroll, "Training complete", 1)
	caption.TextColor3 = C.good

	local scoreCard = Kit.card(scroll, 2, 6)
	Theme.bindAccent(scoreCard, "BackgroundColor3", Theme.tint(0.88))
	local scoreRow = Kit.row(scoreCard, 84, 18, 1)
	local score = Kit.text(scoreRow, "0.0", 64, F.display)
	score.LayoutOrder = 1
	Theme.bindAccent(score, "TextColor3")
	local scoreInfo = Kit.frame(scoreRow, UDim2.new())
	scoreInfo.AutomaticSize = Enum.AutomaticSize.XY
	scoreInfo.LayoutOrder = 2
	Kit.list(scoreInfo, 4)
	Kit.caption(scoreInfo, "Overall score", 1)
	local delta = Kit.text(scoreInfo, "", 18, F.bold, C.good)
	delta.LayoutOrder = 2
	local rankText = Kit.para(scoreCard, "", 14, C.muted, 2)

	local statsCard = Kit.card(scroll, 3, 8)
	Kit.caption(statsCard, "Benchmarks", 0)
	local rows: { [string]: Kit.StatRow } = {}
	for index, stat in ModelConfig.STATS do
		rows[stat.id] = Kit.statRow(statsCard, stat.label, index)
	end

	local buttons = Kit.row(scroll, 50, 10, 4)
	local release = Kit.button(buttons, "RELEASE", "primary", UDim2.fromOffset(190, 48))
	release.LayoutOrder = 1
	local retrain = Kit.button(buttons, "REFINE", "secondary", UDim2.fromOffset(160, 48))
	retrain.LayoutOrder = 2
	local later = Kit.button(buttons, "LATER", "ghost", UDim2.fromOffset(110, 48))
	later.LayoutOrder = 3

	local animatedFor: string? = nil

	refreshers.result = function(snapshot: Snapshot)
		local id = resultId
		local model: ModelData? = if id then snapshot.data.models[id] else nil
		if not model or not id then
			return
		end
		title.Text = modelTitle(model)
		sub.Text = `{sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · cost {Format.money(model.trainCost)}`
		if animatedFor ~= id then
			animatedFor = id
			animateNumber(score, model.overall)
		end
		local best = resultBest or bestOverall(snapshot.data, id)
		if best &lt;= 0 then
			delta.Text = "Your first model!"
			delta.TextColor3 = C.good
		else
			local diff = model.overall - best
			delta.Text = `{Format.signed(diff)} vs your best ({string.format("%.1f", best)})`
			delta.TextColor3 = if diff &gt;= 0 then C.good else C.bad
		end
		for statId, row in rows do
			row.set(model.stats[statId] or 0, math.max(100,model.stats[statId] or 0))
		end

		-- Marktvergleich nach Overall: NPCs + eigene Live-Modelle
		local better, total = 0, 1
		local strongestName, strongest = "", 0
		for _, npc in MarketConfig.NPC_MODELS do
			local overall = ModelMath.overall(npc.stats)
			total += 1
			if overall &gt; model.overall then
				better += 1
			end
			if overall &gt; strongest then
				strongest = overall
				strongestName = `{npc.company} {npc.name}`
			end
		end
		for _, other in snapshot.data.models do
			if other.status == "live" and other.id ~= id then
				total += 1
				if other.overall &gt; model.overall then
					better += 1
				end
			end
		end
		for _, other in (snapshot.live.marketplace and snapshot.live.marketplace.offers) or {} do
			if not snapshot.data.models[other.id] then
				total += 1
				if other.overall &gt; model.overall then better += 1 end
				if other.overall &gt; strongest then strongest=other.overall; strongestName=other.company.." / "..other.name end
			end
		end
		rankText.Text = `Market check: would rank #{better + 1} of {total} by overall. `
			.. (if model.overall &gt;= strongest
				then "That beats every rival model!"
				else `Strongest rival: {strongestName} ({string.format("%.1f", strongest)}).`)
	end

	Kit.onClick(release, function()
		releaseId = resultId
		resultId = nil
		render()
	end)
	Kit.onClick(retrain, function()
		if resultId then
			local ok=ActionController.call("ImproveModel",{modelId=resultId})
			if ok then resultId=nil; render() end
		end
	end)
	Kit.onClick(later, function()
		resultId = nil
		render()
	end)
end

---------------------------------------------------------------------------- Release

local function playLaunch(modelName: string)
	local parent = container
	if not parent then
		return
	end
	local overlay = Kit.blocker(parent, C.bg, 1)
	overlay.ZIndex = 40
	Kit.tween(overlay, 0.2, { BackgroundTransparency = 0.06 })
	local big = Kit.text(overlay, "3", 120, F.black, C.text)
	big.AnchorPoint = Vector2.new(0.5, 0.5)
	big.Position = UDim2.fromScale(0.5, 0.45)
	big.ZIndex = 41
	local scale = Instance.new("UIScale")
	scale.Parent = big
	local subLabel = Kit.text(overlay, "", 20, F.medium, C.muted)
	subLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	subLabel.Position = UDim2.fromScale(0.5, 0.64)
	subLabel.ZIndex = 41

	task.spawn(function()
		for _, step in { "3", "2", "1" } do
			big.Text = step
			scale.Scale = 1.5
			Kit.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			task.wait(0.6)
		end
		big.Text = "MODEL LIVE"
		big.TextSize = 84
		big.TextColor3 = Theme.accent
		scale.Scale = 0.6
		Kit.tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		subLabel.Text = `{modelName} is now serving users`
		task.wait(1.6)
		Kit.tween(overlay, 0.3, { BackgroundTransparency = 1 })
		Kit.tween(big, 0.3, { TextTransparency = 1 })
		Kit.tween(subLabel, 0.3, { TextTransparency = 1 })
		task.wait(0.32)
		overlay:Destroy()
		local currentNav = nav
		if currentNav then
			currentNav.show("market")
		end
	end)
end

local function buildRelease(parent: Frame)
	local scroll = scrollView(parent, "release")
	local _, title, sub = header(scroll, "Launch", 1)
	local left, right = Kit.columns(scroll, 0.55, 16, 2)

	local pricing = Kit.card(left, 1, 10)
	Kit.caption(pricing, "Subscription (per month)", 1)
	local subOptions: { Kit.Option } = {}
	for _, price in MarketConfig.SUB_PRICES do
		table.insert(subOptions, { id = tostring(price), label = if price == 0 then "Free" else `${price}` })
	end
	local subPrice = 5
	local apiPrice = MarketConfig.API_PRICE.default
	local marketing = 0
	local target = "developers"
	local configuredFor: string? = nil
	local updateForecast: () -&gt; () = function() end

	local subSeg = Kit.segmented(pricing, subOptions, tostring(subPrice), function(id: string)
		subPrice = tonumber(id) or 0
		updateForecast()
	end)
	subSeg.frame.LayoutOrder = 2
	Kit.para(pricing, "Students and General users pay a monthly subscription.", 13, C.dim, 3)

	local apiRow = Kit.frame(pricing, UDim2.new(1, 0, 0, 18))
	apiRow.LayoutOrder = 4
	Kit.caption(apiRow, "API price (per 1M tokens)")
	local apiValue = Kit.text(apiRow, "", 16, F.bold, C.text)
	apiValue.AnchorPoint = Vector2.new(1, 0)
	apiValue.Position = UDim2.fromScale(1, 0)
	local apiSlider = Kit.slider(
		pricing,
		MarketConfig.API_PRICE.min,
		MarketConfig.API_PRICE.max,
		MarketConfig.API_PRICE.step,
		apiPrice,
		function(value: number)
			apiPrice = value
			updateForecast()
		end
	)
	apiSlider.frame.LayoutOrder = 5
	Kit.para(pricing, "Developers and Businesses pay per token. Serving costs you money per token too.", 13, C.dim, 6)

	local mktRow = Kit.frame(pricing, UDim2.new(1, 0, 0, 18))
	mktRow.LayoutOrder = 7
	Kit.caption(mktRow, "Marketing budget")
	local mktValue = Kit.text(mktRow, "", 16, F.bold, C.text)
	mktValue.AnchorPoint = Vector2.new(1, 0)
	mktValue.Position = UDim2.fromScale(1, 0)
	local mktSlider = Kit.slider(pricing, 0, MarketConfig.MARKETING.max, MarketConfig.MARKETING.step, 0, function(value: number)
		marketing = value
		updateForecast()
	end)
	mktSlider.frame.LayoutOrder = 8
	Kit.para(pricing, "Hype at launch. Fades over about 10 minutes, word of mouth stays.", 13, C.dim, 9)

	Kit.caption(pricing, "Target audience", 10)
	local targetOptions: { Kit.Option } = {}
	for _, id in MarketConfig.TARGETS do
		local label = "General"
		for _, segment in MarketConfig.SEGMENTS do
			if segment.id == id then
				label = segment.label
			end
		end
		if id == "general" then
			label = "Everyone"
		end
		table.insert(targetOptions, { id = id, label = label })
	end
	local targetSeg = Kit.segmented(pricing, targetOptions, target, function(id: string)
		target = id
		updateForecast()
	end)
	targetSeg.frame.LayoutOrder = 11
	Kit.para(pricing, "Marketing hits the target hardest. 'Everyone' spreads it thinner.", 13, C.dim, 12)

	-- rechts: Passung und Prognose
	local fitCard = Kit.card(right, 1, 8)
	Kit.caption(fitCard, "Audience fit (what each group values)", 0)
	local fitRows: { [string]: Kit.StatRow } = {}
	for index, segment in MarketConfig.SEGMENTS do
		fitRows[segment.id] = Kit.statRow(fitCard, segment.label, index)
	end

	local forecastCard = Kit.card(right, 2, 10)
	Kit.caption(forecastCard, "Forecast after 5 minutes", 0)
	local forecastGrid = Kit.grid(forecastCard, 2, 46, 10, 1)
	local fUsers = Kit.metric(forecastGrid, "Users", 1, 20)
	local fNet = Kit.metric(forecastGrid, "Net income", 2, 20)
	local fRevenue = Kit.metric(forecastGrid, "Revenue", 3, 16)
	local fServing = Kit.metric(forecastGrid, "Serving cost", 4, 16)
	Kit.para(forecastCard, "Rivals are simulated too. Real numbers move with reputation and your other models.", 12, C.dim, 2)

	local launch = Kit.button(right, "LAUNCH", "primary", UDim2.new(1, 0, 0, 52))
	launch.LayoutOrder = 3
	launch.TextSize = 17
	local back = Kit.button(right, "BACK", "ghost", UDim2.new(1, 0, 0, 40))
	back.LayoutOrder = 4

	updateForecast = function()
		local snapshot = StateController.snapshot
		local id = releaseId
		local model: ModelData? = if snapshot and id then snapshot.data.models[id] else nil
		if not snapshot or not model or not id then
			return
		end
		local data = snapshot.data
		local company = data.company
		apiValue.Text = Format.price(apiPrice)
		mktValue.Text = Format.money(marketing)
		local money = StateController.money()
		mktValue.TextColor3 = if marketing &gt; money then C.bad else C.text

		local candidate: MarketMath.LiveEntry = {
			id = id,
			stats = model.stats,
			sizeId = model.sizeId,
			subPrice = subPrice,
			apiPrice = apiPrice,
			market = MarketMath.newMarketState(target, marketing),
		}
		local result = MarketMath.forecast(
			candidate,
			liveEntries(data, id),
			if company then company.reputation else 0,
			specOf(data),
			FORECAST_SECONDS
		)
		local bonuses = EmpireMath.bonuses(data.empire)
		local cycle = EmpireConfig.cycle(snapshot.serverTime)
		result.revenue *= bonuses.revenue * cycle.revenue
		result.cost *= bonuses.serving * cycle.cost
		fUsers.value.Text = Format.compact(result.users)
		fRevenue.value.Text = Format.money(result.revenue * 60) .. "/min"
		fServing.value.Text = Format.money(result.cost * 60) .. "/min"
		fNet.value.Text = Format.perMinute(result.revenue - result.cost)
		fNet.value.TextColor3 = if result.revenue &gt;= result.cost then C.good else C.bad

		if marketing &gt; money then
			launch.Text = "NOT ENOUGH MONEY FOR THIS BUDGET"
			Kit.setDisabled(launch, true)
		else
			launch.Text = if marketing &gt; 0 then `LAUNCH · {Format.money(marketing)} MARKETING` else "LAUNCH (NO MARKETING)"
			Kit.setDisabled(launch, false)
		end
	end

	refreshers.release = function(snapshot: Snapshot)
		local id = releaseId
		local model: ModelData? = if id then snapshot.data.models[id] else nil
		if not model or not id then
			return
		end
		title.Text = modelTitle(model)
		sub.Text = `Overall {string.format("%.1f", model.overall)} · {sizeLabel(model.sizeId)} · {focusLabel(model.focusId)}`

		local money = StateController.money()
		local step = MarketConfig.MARKETING.step
		local affordable = math.max(0, math.min(MarketConfig.MARKETING.max, math.floor(money / step) * step))

		local bestSegment, bestFit = "developers", -math.huge
		for _, segment in MarketConfig.SEGMENTS do
			local fit = MarketMath.fit(model.stats, segment)
			local row = fitRows[segment.id]
			if row then
				row.set(fit)
			end
			if fit &gt; bestFit then
				bestFit = fit
				bestSegment = segment.id
			end
		end

		if configuredFor ~= id then
			configuredFor = id
			subPrice = 5
			apiPrice = MarketConfig.API_PRICE.default
			marketing = math.min(5_000, affordable)
			-- "consumers" ist kein eigenes Ziel; am nächsten kommt "general" (Everyone)
			target = if table.find(MarketConfig.TARGETS, bestSegment) then bestSegment else "general"
			subSeg.set(tostring(subPrice))
			apiSlider.set(apiPrice)
			targetSeg.set(target)
		end
		-- Regler-Bereich in festen Stufen über dem verfügbaren Geld: fein genug am Anfang,
		-- springt aber nicht bei jedem Einnahmen-Tick
		local range = MARKETING_TIERS[#MARKETING_TIERS]
		for _, tier in MARKETING_TIERS do
			if tier &gt;= affordable then
				range = tier
				break
			end
		end
		mktSlider.setRange(0, range)
		mktSlider.set(marketing)
		marketing = mktSlider.get()
		updateForecast()
	end

	Kit.onClick(launch, function()
		local id = releaseId
		local snapshot = StateController.snapshot
		local model: ModelData? = if snapshot and id then snapshot.data.models[id] else nil
		if not model or not id then
			return
		end
		local ok = ActionController.call("ReleaseModel", {
			modelId = id,
			subPrice = subPrice,
			apiPrice = apiPrice,
			marketing = marketing,
			target = target,
		})
		if ok then
			releaseId = nil
			configuredFor = nil
			playLaunch(modelTitle(model))
			render()
		end
	end)
	Kit.onClick(back, function()
		releaseId = nil
		render()
	end)
end

---------------------------------------------------------------------------- Einstieg

function LabApp.mount(parent: Frame, navigation: Kit.Nav)
	container = parent
	nav = navigation
	buildCreator(parent)
	buildTraining(parent)
	buildResult(parent)
	buildRelease(parent)

	StateController.onChange(function(_snapshot)
		if parent.Visible and navigation.isOpen() then
			render()
		end
	end)
	StateController.onUiChange(function()
		if parent.Visible and view == "creator" then
			render()
		end
	end)
	StateController.onNotify(function(kind: string, payload: { [string]: any })
		if kind == "TRAINING_COMPLETE" then
			resultId = if typeof(payload.modelId) == "string" then payload.modelId else nil
			resultBest = if typeof(payload.previousBest) == "number" then payload.previousBest else nil
			releaseId = nil
			if navigation.isOpen() then
				navigation.show("lab")
			end
		elseif kind == "TRAINING_EVENT" then
			if navigation.isOpen() then
				navigation.show("lab")
			end
		end
	end)
end

function LabApp.onShow()
	render()
end

-- Von außen (HUD "Launch ..."): direkt die Release-Ansicht eines fertigen Modells öffnen
function LabApp.openRelease(modelId: string)
	releaseId = modelId
	resultId = nil
	render()
end

function LabApp.openSection(section: string)
 local snapshot=StateController.snapshot;if not snapshot then return end
 if section=="evaluation" then
  local model=Journey.latest(snapshot.data)
  if model then resultId=model.id;releaseId=nil;render();task.spawn(function()ActionController.call("EvaluateModel",{modelId=model.id})end)
  else Toast.show("info","Train a model first. Its real benchmark scores will appear here.") end
 elseif section=="release" then
  local model=Journey.latest(snapshot.data,true)
  if model then LabApp.openRelease(model.id) else Toast.show("info","No unreleased trained model yet. Train and evaluate a checkpoint first.") end
 end
end
return LabApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">MarketApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Markt: Gesamtzahlen, eigene Live-Modelle (Preise ändern, zurückziehen), Rangliste gegen NPCs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local MarketConfig = require(Shared.Config.MarketConfig)
local CompanyConfig = require(Shared.Config.CompanyConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot
type ModelData = Types.ModelData

type Card = {
	frame: Frame,
	users: Kit.Metric,
	revenue: Kit.Metric,
	serving: Kit.Metric,
	net: Kit.Metric,
	overall: TextLabel,
	segments: TextLabel,
	subSeg: Kit.Segmented,
	apiValue: TextLabel,
	apiLocal: number,
	touchedAt: number,
}

type Row = {
	frame: Frame,
	rank: TextLabel,
	dot: Frame,
	name: TextLabel,
	company: TextLabel,
	overall: TextLabel,
	users: TextLabel,
	price: TextLabel,
}

type Entry = {
	name: string,
	company: string,
	overall: number,
	users: number,
	sub: number,
	api: number,
	color: Color3,
	mine: boolean,
}

local API_STEP = 0.5

local MarketApp = {}

local root: Frame? = nil
local refresh: (Snapshot) -&gt; () = function(_snapshot: Snapshot) end

local function sizeLabel(id: string): string
	local size = ModelConfig.getSize(id)
	return if size then size.label else id
end

local function priceText(sub: number, api: number): string
	return (if sub == 0 then "Free" else `${sub}/mo`) .. ` · {Format.price(api)}`
end

local function nextRank(peak: number): string
	for _, rank in CompanyConfig.RANKS do
		if rank.minUsers &gt; peak then
			return `Next: {rank.name} at {Format.compact(rank.minUsers)} peak users`
		end
	end
	return "Top rank reached"
end

function MarketApp.mount(parent: Frame, navigation: Kit.Nav)
	root = parent

	local scroll = Kit.scroll(parent)
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)

	Kit.heading(scroll, "MARKET", "A shared market for this server. Companies rent your AI monthly; players can buy API access. One game month = one hour. All prices use game dollars.", 1)

	-- Kennzahlen
	local summary = Kit.stack(scroll, 10, 2) -- Kennzahlen ohne Karte: reine Information
	local grid = Kit.grid(summary, 3, 48, 12, 1)
	local mUsers = Kit.metric(grid, "Users", 1, 22)
	local mNet = Kit.metric(grid, "Net income", 2, 22)
	local mRep = Kit.metric(grid, "Reputation", 3, 22)
	local mRevenue = Kit.metric(grid, "Revenue", 4, 16)
	local mServing = Kit.metric(grid, "Serving cost", 5, 16)
	local mRank = Kit.metric(grid, "Rank", 6, 16)
	local rankNote = Kit.para(summary, "", 13, C.dim, 2)

	local accessCard = Kit.card(scroll, 3, 10)
	Kit.caption(accessCard, "Your API subscription", 1)
	local accessInfo = Kit.para(accessCard, "", 14, C.muted, 2)
	local cancelAccess = Kit.button(accessCard, "STOP AUTO-RENEW", "secondary", UDim2.fromOffset(190,34))
	cancelAccess.LayoutOrder = 3
	Kit.onClick(cancelAccess,function() ActionController.call("CancelModelAccess",{}) end)
	Kit.para(accessCard,"API access adds research points while active. You keep training your own model. The provider receives your payment; access never copies their model or leaderboard score.",13,C.dim,4)
	Kit.caption(scroll,"Provider exchange · player companies",4)
	local exchange = Kit.stack(scroll,10,5)
	local providerRows: {[string]:any} = {}
	local providerKey = ""
	local customerCard = Kit.card(scroll,6,10)
	Kit.caption(customerCard,"Business customers · monthly renewals",1)
	local businessRows = {}
	for i=1,12 do
		businessRows[i]=Kit.para(customerCard,"",13,C.muted,i+1)
	end
	local ledger = Kit.para(customerCard,"",13,C.dim,14)

	-- Eigene Live-Modelle
	Kit.caption(scroll, "Your live models", 7)
	local cardList = Kit.stack(scroll, 12, 8)
	local emptyNote = Kit.para(scroll, "No live models yet. Train one in the Lab and launch it.", 14, C.dim, 9)
	local cards: { [string]: Card } = {}
	local cardKey = ""

	-- Rangliste
	Kit.caption(scroll, "Intelligence leaderboard · live models", 10)
	local board = Kit.card(scroll, 11, 2)
	local headerRow = Kit.frame(board, UDim2.new(1, 0, 0, 22))
	headerRow.LayoutOrder = 0
	local function headerCell(text: string, width: UDim, x: UDim, right: boolean?)
		local label = Kit.cell(headerRow, string.upper(text), width, 11, F.bold, C.dim)
		label.Position = UDim2.new(x, UDim.new(0, 0))
		if right then
			label.TextXAlignment = Enum.TextXAlignment.Right
		end
	end
	headerCell("#", UDim.new(0, 30), UDim.new(0, 0))
	headerCell("Model", UDim.new(0.34, -40), UDim.new(0, 40))
	headerCell("Company", UDim.new(0.26, 0), UDim.new(0.34, 10))
	headerCell("Overall", UDim.new(0, 64), UDim.new(0.6, 10), true)
	headerCell("Users", UDim.new(0, 80), UDim.new(0.6, 84), true)
	headerCell("Price", UDim.new(0.4, -184), UDim.new(0.6, 174), true)
	local rows: { Row } = {}

	local function makeRow(index: number): Row
		local frame = Kit.frame(board, UDim2.new(1, 0, 0, 34))
		frame.LayoutOrder = index
		frame.BackgroundColor3 = Theme.accent
		frame.BackgroundTransparency = 1
		Kit.corner(frame, 8)
		local rank = Kit.cell(frame, "", UDim.new(0, 30), 15, F.bold, C.dim)
		local dot = Kit.dot(frame, C.dim, 10)
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.new(0, 34, 0.5, 0)
		local name = Kit.cell(frame, "", UDim.new(0.34, -52), 15, F.bold, C.text)
		name.Position = UDim2.fromOffset(52, 0)
		local company = Kit.cell(frame, "", UDim.new(0.26, 0), 14, F.medium, C.muted)
		company.Position = UDim2.new(0.34, 10, 0, 0)
		local overall = Kit.cell(frame, "", UDim.new(0, 64), 15, F.bold, C.text)
		overall.Position = UDim2.new(0.6, 10, 0, 0)
		overall.TextXAlignment = Enum.TextXAlignment.Right
		local users = Kit.cell(frame, "", UDim.new(0, 80), 15, F.bold, C.text)
		users.Position = UDim2.new(0.6, 84, 0, 0)
		users.TextXAlignment = Enum.TextXAlignment.Right
		local price = Kit.cell(frame, "", UDim.new(0.4, -184), 13, F.medium, C.muted)
		price.Position = UDim2.new(0.6, 174, 0, 0)
		price.TextXAlignment = Enum.TextXAlignment.Right
		return {
			frame = frame,
			rank = rank,
			dot = dot,
			name = name,
			company = company,
			overall = overall,
			users = users,
			price = price,
		}
	end

	local function buildCard(order: number, model: ModelData): Card
		local frame = Kit.card(cardList, order, 10)
		local top = Kit.frame(frame, UDim2.new(1, 0, 0, 26))
		top.LayoutOrder = 1
		local titleRow = Kit.frame(top, UDim2.new(1, -140, 1, 0))
		Kit.list(titleRow, 8, true)
		local name = Kit.text(titleRow, `{model.name} v{model.version}`, 19, F.bold, C.text)
		name.LayoutOrder = 1
		Kit.tag(titleRow, sizeLabel(model.sizeId), C.muted, 2)
		Kit.tag(titleRow, "LIVE", C.good, 3)
		local overall = Kit.text(top, "", 15, F.bold, C.muted)
		overall.AnchorPoint = Vector2.new(1, 0.5)
		overall.Position = UDim2.fromScale(1, 0.5)

		local metrics = Kit.grid(frame, 4, 44, 10, 2)
		local users = Kit.metric(metrics, "Users", 1, 18)
		local revenue = Kit.metric(metrics, "Revenue", 2, 18)
		local serving = Kit.metric(metrics, "Serving", 3, 18)
		local net = Kit.metric(metrics, "Net", 4, 18)
		local segments = Kit.para(frame, "", 13, C.dim, 3)

		local controls = Kit.frame(frame, UDim2.new(1, 0, 0, 38))
		controls.LayoutOrder = 4
		local subCaption = Kit.caption(controls, "Sub")
		subCaption.Position = UDim2.new(0, 0, 0.5, 0)
		subCaption.AnchorPoint = Vector2.new(0, 0.5)
		local options: { Kit.Option } = {}
		for _, price in MarketConfig.SUB_PRICES do
			table.insert(options, { id = tostring(price), label = if price == 0 then "Free" else `${price}` })
		end
		local release = model.release
		local card: Card
		local subSeg = Kit.segmented(controls, options, tostring(if release then release.subPrice else 0), function(id: string)
			card.touchedAt = os.clock()
			ActionController.call("UpdatePricing", {
				modelId = model.id,
				subPrice = tonumber(id) or 0,
				apiPrice = card.apiLocal,
			})
		end, 36)
		subSeg.frame.Size = UDim2.fromOffset(230, 36)
		subSeg.frame.Position = UDim2.fromOffset(38, 1)

		local apiCaption = Kit.caption(controls, "API")
		apiCaption.Position = UDim2.new(0, 284, 0.5, 0)
		apiCaption.AnchorPoint = Vector2.new(0, 0.5)
		local minus = Kit.button(controls, "-", "secondary", UDim2.fromOffset(34, 34))
		minus.Position = UDim2.fromOffset(316, 2)
		local apiValue = Kit.text(controls, "", 15, F.bold, C.text)
		apiValue.AutomaticSize = Enum.AutomaticSize.None
		apiValue.Size = UDim2.fromOffset(64, 38)
		apiValue.Position = UDim2.fromOffset(354, 0)
		apiValue.TextXAlignment = Enum.TextXAlignment.Center
		local plus = Kit.button(controls, "+", "secondary", UDim2.fromOffset(34, 34))
		plus.Position = UDim2.fromOffset(422, 2)
		local retire = Kit.button(controls, "RETIRE", "danger", UDim2.fromOffset(110, 34))
		retire.AnchorPoint = Vector2.new(1, 0)
		retire.Position = UDim2.new(1, 0, 0, 2)
		retire.TextSize = 13

		card = {
			frame = frame,
			users = users,
			revenue = revenue,
			serving = serving,
			net = net,
			overall = overall,
			segments = segments,
			subSeg = subSeg,
			apiValue = apiValue,
			apiLocal = if release then release.apiPrice else MarketConfig.API_PRICE.default,
			touchedAt = 0,
		}

		local function stepApi(direction: number)
			local P = MarketConfig.API_PRICE
			local value = math.clamp(math.round((card.apiLocal + direction * API_STEP) * 100) / 100, P.min, P.max)
			if value == card.apiLocal then
				return
			end
			card.apiLocal = value
			card.touchedAt = os.clock()
			apiValue.Text = Format.price(value)
			ActionController.call("UpdatePricing", {
				modelId = model.id,
				subPrice = tonumber(subSeg.get()) or 0,
				apiPrice = value,
			})
		end
		Kit.onClick(minus, function()
			stepApi(-1)
		end)
		Kit.onClick(plus, function()
			stepApi(1)
		end)

		local refineRow = Kit.row(frame,34,10,5)
		local refine = Kit.button(refineRow,"REFINE CHECKPOINT", "secondary", UDim2.fromOffset(190,32))
		Kit.onClick(refine,function() ActionController.call("ImproveModel",{modelId=model.id}) end)
		Kit.para(frame,"Add 100M new tokens, then refine with your GPUs. The checkpoint pauses serving during training; other customers reserve half your GPU throughput. Intelligence can rise beyond 99; later runs cost more compute.",13,C.dim,6)

		local armedAt = 0
		Kit.onClick(retire, function()
			if os.clock() - armedAt &gt; 3 then
				armedAt = os.clock()
				retire.Text = "CONFIRM?"
				task.delay(3, function()
					if retire.Parent then
						retire.Text = "RETIRE"
					end
				end)
				return
			end
			armedAt = 0
			local ok = ActionController.call("RetireModel", { modelId = model.id })
			if ok then
				Toast.show("info", `{model.name} v{model.version} was retired.`)
			end
		end)
		return card
	end

	refresh = function(snapshot: Snapshot)
		local data = snapshot.data
		local live = snapshot.live
		local company = data.company

		mUsers.value.Text = Format.compact(live.users)
		mNet.value.Text = Format.perMinute(live.revenue - live.cost)
		mNet.value.TextColor3 = if live.revenue &gt;= live.cost then C.good else C.bad
		mRevenue.value.Text = Format.money(live.revenue * 60) .. "/min"
		mServing.value.Text = Format.money(live.cost * 60) .. "/min"
		mRep.value.Text = if company then string.format("%.1f", company.reputation) else "0"
		mRank.value.Text = CompanyConfig.rankFor(data.stats.peakUsers)
		rankNote.Text = `Peak users: {Format.compact(data.stats.peakUsers)} · {nextRank(data.stats.peakUsers)}`

		local subscription=data.empire.subscriptions
		local active=typeof(subscription.expires)=="number" and subscription.expires&gt;os.time()
		accessInfo.Text=if active then subscription.provider .. " / " .. subscription.name .. " · " .. Format.money(subscription.price) .. "/month · " .. Format.duration(subscription.expires-os.time()) .. " left · " .. (if subscription.autoRenew then "Auto-renew ON" else "One month, no automatic renewal") else "No active provider. Choose a player offer below."
		cancelAccess.Visible=active and subscription.autoRenew==true
		local market=live.marketplace or {offers={},customers={}}
		local ids={}
		for _,offer in market.offers do table.insert(ids,tostring(offer.providerId)..":"..offer.id) end
		local newKey=table.concat(ids,",")
		if newKey~=providerKey then
			providerKey=newKey
			for _,refs in providerRows do refs.frame:Destroy() end
			table.clear(providerRows)
			for index,offer in market.offers do
				local key=tostring(offer.providerId)..":"..offer.id
				local card=Kit.card(exchange,index,10)
				local title=Kit.text(card,offer.company.." / "..offer.name,17,F.bold,C.text)
				title.LayoutOrder=1
				local detail=Kit.para(card,"",13,C.muted,2)
				local actions=Kit.row(card,34,10,3)
				local purchase=Kit.button(actions,"BUY ONE MONTH","primary",UDim2.fromOffset(175,32))
				local renew=Kit.button(actions,"SUBSCRIBE + AUTO-RENEW","secondary",UDim2.fromOffset(235,32))
				renew.LayoutOrder=2
				local refs={frame=card,detail=detail,purchase=purchase,renew=renew,offer=offer}
				providerRows[key]=refs
				local function buyAccess(auto: boolean)
					local current=refs.offer
					ActionController.call("BuyModelAccess",{providerId=current.providerId,modelId=current.id,quotedPrice=current.price,autoRenew=auto})
				end
				Kit.onClick(purchase,function() buyAccess(false) end)
				Kit.onClick(renew,function() buyAccess(true) end)
			end
		end
		for _,offer in market.offers do
			local refs=providerRows[tostring(offer.providerId)..":"..offer.id]
			if refs then
				refs.offer=offer
				local mine=data.models[offer.id]~=nil
				refs.detail.Text=string.format("%.1f intelligence pts · %d refinements · %s / game month%s",offer.overall,offer.iterations,Format.money(offer.price),if mine then " · Your model" else "")
				Kit.setDisabled(refs.purchase,mine or active or data.money&lt;offer.price)
				Kit.setDisabled(refs.renew,mine or active or data.money&lt;offer.price)
			end
		end
		for index,label in businessRows do
			local customer=market.customers[index]
			label.Visible=customer~=nil
			if customer then
				label.Text=customer.name.." · "..customer.stat.." ≥ "..tostring(customer.minimum).." · "..customer.provider.." · "..(if customer.price&gt;0 then Format.money(customer.price).."/month, renews in "..Format.duration(customer.remaining) else "Budget "..Format.money(customer.budget).."/month")
			end
		end
		local receipts={"Your business MRR: "..Format.money((data.empire.businessRevenue or 0)*3600).." · Billed proportionally while serving."}
		for i=1,math.min(4,#data.empire.invoices) do
			local bill=data.empire.invoices[i]
			table.insert(receipts,bill.text.." · "..Format.money(bill.amount))
		end
		ledger.Text=table.concat(receipts,"\n")

		-- Karten neu aufbauen, wenn sich die Menge der Live-Modelle ändert
		local liveIds: { string } = {}
		for _, id in data.modelOrder do
			local model: ModelData? = data.models[id]
			if model and model.status == "live" then
				table.insert(liveIds, id)
			end
		end
		local key = table.concat(liveIds, ",")
		if key ~= cardKey then
			cardKey = key
			for _, card in cards do
				card.frame:Destroy()
			end
			table.clear(cards)
			for index, id in liveIds do
				cards[id] = buildCard(index, data.models[id])
			end
		end
		emptyNote.Visible = #liveIds == 0

		for id, card in cards do
			local model: ModelData? = data.models[id]
			local release = if model then model.release else nil
			local result = live.perModel[id]
			if model and release then
				card.overall.Text = `Overall {string.format("%.1f", model.overall)}`
				local users = if result then result.users else 0
				local revenue = if result then result.revenue else 0
				local cost = if result then result.cost else 0
				card.users.value.Text = Format.compact(users)
				card.revenue.value.Text = Format.money(revenue * 60) .. "/m"
				card.serving.value.Text = Format.money(cost * 60) .. "/m"
				card.net.value.Text = Format.money((revenue - cost) * 60) .. "/m"
				card.net.value.TextColor3 = if revenue &gt;= cost then C.good else C.bad
				local market = model.market
				local parts: { string } = {}
				for _, segment in MarketConfig.SEGMENTS do
					local count = if market then market.users[segment.id] or 0 else 0
					table.insert(parts, `{segment.label} {Format.compact(count)}`)
				end
				card.segments.Text = table.concat(parts, " · ")
				-- kurz nach eigener Änderung nicht vom (evtl. älteren) Snapshot überschreiben lassen
				if os.clock() - card.touchedAt &gt; 1.5 then
					card.subSeg.set(tostring(release.subPrice))
					card.apiLocal = release.apiPrice
				end
				card.apiValue.Text = Format.price(card.apiLocal)
			end
		end

		-- Rangliste
		local entries: { Entry } = {}
		for _, npc in (if live.marketplace then {} else MarketConfig.NPC_MODELS) do
			table.insert(entries, {
				name = npc.name,
				company = npc.company,
				overall = ModelMath.overall(npc.stats),
				users = live.npcUsers[npc.id] or 0,
				sub = npc.subPrice,
				api = npc.apiPrice,
				color = Theme.rgb(npc.rgb),
				mine = false,
			})
		end
		for _, id in liveIds do
			local model = data.models[id]
			local release = model.release
			local result = live.perModel[id]
			table.insert(entries, {
				name = `{model.name} v{model.version}`,
				company = if company then company.name else "You",
				overall = model.overall,
				users = if result then result.users else 0,
				sub = if release then release.subPrice else 0,
				api = if release then release.apiPrice else 0,
				color = Theme.accent,
				mine = true,
			})
		end
		for _,offer in market.offers do
			if not data.models[offer.id] then
				table.insert(entries,{name=offer.name,company=offer.company,overall=offer.overall,users=offer.users,sub=offer.sub,api=offer.api,color=C.muted,mine=false})
			end
		end
		table.sort(entries, function(a: Entry, b: Entry): boolean
			if a.overall == b.overall then return a.company &lt; b.company end
			return a.overall &gt; b.overall
		end)
		while #rows &lt; #entries do
			table.insert(rows, makeRow(#rows + 1))
		end
		for index, row in rows do
			local entry = entries[index]
			row.frame.Visible = entry ~= nil
			if entry then
				row.rank.Text = tostring(index)
				row.dot.BackgroundColor3 = entry.color
				row.name.Text = entry.name
				row.name.TextColor3 = if entry.mine then Theme.accent else C.text
				row.company.Text = entry.company
				row.overall.Text = string.format("%.1f", entry.overall)
				row.users.Text = Format.compact(entry.users)
				row.price.Text = priceText(entry.sub, entry.api)
				row.frame.BackgroundColor3 = Theme.accent
				row.frame.BackgroundTransparency = if entry.mine then 0.88 else 1
			end
		end
	end

	StateController.onChange(function(snapshot: Snapshot)
		if parent.Visible and navigation.isOpen() then
			refresh(snapshot)
		end
	end)
end

function MarketApp.onShow()
	local snapshot = StateController.snapshot
	if snapshot and root then
		refresh(snapshot)
	end
end

return MarketApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000026"><Properties><string name="Name">CampusApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local Math=require(ReplicatedStorage.Shared.EmpireMath)
local Format=require(ReplicatedStorage.Shared.Format)
local UI=script.Parent.Parent
local State=require(UI.Parent.Controllers.StateController)
local Action=require(UI.Parent.Controllers.ActionController)
local Theme=require(UI.Theme)
local Kit=require(UI.Kit)
local Toast=require(UI.Toast)
local Security=require(UI.Parent.Controllers.SecurityController)
local C,F=Theme.colors,Theme.font
local App={}
local watchers={}
local scroll: ScrollingFrame?=nil
local current="building"
local function watch(fn: (any)-&gt;())table.insert(watchers,fn);if State.snapshot then fn(State.snapshot) end end
local function title(p: Instance,text: string)local t=Kit.para(p,text,19,C.text,1);t.Font=F.bold;return t end
local function para(p: Instance,text: string,order: number?)return Kit.para(p,text,14,C.muted,order or 2)end
local function call(name: string,p: any,message: string)
	task.spawn(function()local ok=Action.call(name,p);if ok then Toast.show("success",message) end end)
end
local function button(p: Instance,text: string,fn: ()-&gt;(),order: number?)
	local b=Kit.button(p,text,"primary",UDim2.new(1,0,0,40));b.LayoutOrder=order or 5;Kit.onClick(b,fn);return b
end
local function building(p: Instance)
	local hero=Kit.card(p,1);local heading=title(hero,"Your headquarters");local info=para(hero,"")
	watch(function(s)
		local e=s.data.empire;heading.Text=EmpireConfig.OFFICES[e.office].name
		info.Text=string.format("%d floors + underground parking · 164 × 208 studs incl. pavilion\n%d / %d specialists + 12 campus operations staff\nEmployee cards at every entrance · lift and exterior stairs",Config.FLOORS[e.office],Math.staff(e),EmpireConfig.OFFICES[e.office].staff)
	end)
	local map=Kit.card(p,2);title(map,"Find your way")
	para(map,"G: reception, kitchen, compute lab and meeting room.\nRear pavilion G: gym, cedar sauna, recovery lounge, restrooms, showers and lockers.\nRear pavilion 1: private camera control, archive, prototype lab and a hidden research room.\nWork floors: research, engineering, data and growth teams.\nTop: founder computer, boardroom, private bathroom and roof garden.\nB1: 14 parking bays, fleet desk and a driveable ramp.")
	local directions=Kit.card(p,3);title(directions,"Explore the campus")
	para(directions,"Walk to the reader at the glass entrance and press Use. Carry your card in your backpack or hand.\nInside, use a lift-floor prompt or the outside stairs. The roof-garden button is on the founder floor.\nThe shop street is beside the west side of your headquarters.\nUse the fleet desk in B1, or collect your car from the Fleet tab. Drive with WASD, your gamepad or Roblox's touch controls. Jump to leave the seat.")
	local staff=Kit.card(p,4);title(staff,"A team that has a day")
	para(staff,"Each specialist has a personal workstation, role and schedule. Employees walk through doors, use seats, meet colleagues and take staggered coffee, lunch and lounge breaks. Data, research, training and growth bonuses use the same working team. Founder rooms remain private.")
	local security=Kit.card(p,5);title(security,"Founder camera control")
	para(security,"Live views of your own campus: every work floor, entry, atrium, kitchen, compute lab, garage, gym, founder pavilion and roof. The camera room and the tablet on your founder desk open the same controls.")
	button(security,"Open live campus cameras",Security.open)
	local wellness=Kit.card(p,6);title(wellness,"Use the rooms")
	para(wellness,"Treadmills and bikes: stay nearby for an 18-second session. Sauna: relax near the heater for 12 seconds. Completed sessions give a short walking boost. Toilets have usable seats, occupied cubicles and flush buttons. Taps and showers run water and switch off automatically. Chairs and benches are real seats.")
end
local function access(p: Instance)
	local card=Kit.card(p,1);title(card,"Your employee card");local status=para(card,"")
	watch(function(s)status.Text=if s.live.campus and s.live.campus.hasCard then "Card active · entrances, garage, founder office and compute lab" else "Your card is missing. Print a replacement below." end)
	button(card,"Print replacement card",function()call("ReplaceCard",{},"New card added to your backpack.")end)
	local help=Kit.card(p,2);title(help,"Invite someone to visit")
	para(help,"Give another player a guest card for one hour. They can visit shared work floors, kitchen and wellness rooms. Your founder office, private bathroom, compute lab, camera room, archive, prototype lab and secret room stay private. Your admin powers never open someone else's private rooms. Revoking a guest card immediately ends access.")
	for i=1,11 do
		local row=Kit.card(p,i+2);local name=title(row,"");local info=para(row,"");local selected: number?=nil;local active=false
		local b=button(row,"Issue guest card",function()
			if selected then call(if active then "RevokeGuestCard" else "GrantGuestCard",{userId=selected},if active then "Guest access revoked." else "One-hour guest card issued.") end
		end)
		watch(function(s)
			local live=s.live.campus;local peer=if live then live.online[i] else nil;row.Visible=peer~=nil;selected=if peer then peer.id else nil;active=false
			if not peer then return end
			for _,pass in live.passes do if pass.id==peer.id then active=true end end
			name.Text=peer.name;info.Text=if active then "Guest card active" else "No guest access to your company";b.Text=if active then "Revoke guest card" else "Issue one-hour guest card"
		end)
	end
end
local function fleet(p: Instance)
	local help=Kit.card(p,1);title(help,"Your company fleet")
	para(help,"A Founder’s Hatch is included. Purchase other cars with company cash. Collect one active car in your underground parking; choose Drive at its seat. Your fleet ownership is saved. An occupied car must be parked and left before collecting another.")
	for i,def in Config.CARS do
		local card=Kit.card(p,i+1);title(card,def.name);para(card,string.format("%s · top speed %d studs/s · reverse %d studs/s",if def.price==0 then "Included with your company" else Format.money(def.price),def.speed,def.reverse))
		local owned=false
		local b=button(card,"",function()call(if owned then "SpawnCar" else "BuyCar",{carId=def.id},if owned then "Car ready in underground bay B1 — 14." else "Car purchased. Collect it below.")end)
		watch(function(s)
			owned=s.data.empire.campus.cars[def.id]==true;b.Text=if owned then "Collect in B1" else "Buy · "..Format.money(def.price);Kit.setDisabled(b,not owned and s.data.money&lt;def.price)
		end)
	end
end
local function shops(p: Instance)
	local hero=Kit.card(p,1);local heading=title(hero,"Your company stores");local info=para(hero,"")
	watch(function(s)
		local c=s.data.empire.campus;heading.Text=s.data.company.name.." / Company stores"
		info.Text=string.format("Retail level %d / 4 · %d sales · %s net revenue\nNPC retail traffic is simulated every 30 seconds. More staff and store upgrades increase visits. Each simulated ticket earns $12 after stock costs.",c.retailLevel,c.retailSales,Format.money(c.retailRevenue))
	end)
	local upgrade=button(hero,"Upgrade store",function()call("UpgradeRetail",{},"Company stores upgraded.")end)
	watch(function(s)local cost=Config.RETAIL[s.data.empire.campus.retailLevel];upgrade.Text=if cost then "Upgrade stores · "..Format.money(cost) else "Stores fully upgraded";Kit.setDisabled(upgrade,not cost or s.data.money&lt;(cost or 0))end)
	local help=Kit.card(p,2);title(help,"House Kitchen &amp; Snack Club")
	para(help,"Buy at the kitchen or shop counter to pay the menu price. The buttons below deliver a snack to your backpack for an extra $15. Equip it, then click or tap to eat. Snacks temporarily improve walk speed; the latest snack replaces the previous effect.")
	for i,def in Config.SNACKS do
		local card=Kit.card(p,i+2);title(card,def.name);local stock=para(card,"")
		local b=button(card,"Deliver · "..Format.money(def.price+15),function()call("BuySnack",{snackId=def.id},"Snack delivered to your backpack.")end)
		watch(function(s)stock.Text=string.format("In your bag: %d · walk speed %d for %ds",s.data.empire.campus.snacks[def.id] or 0,def.speed,def.seconds);Kit.setDisabled(b,s.data.money&lt;def.price+15)end)
	end
end
local builders={building=building,access=access,fleet=fleet,shops=shops}
local function render()
	if not scroll then return end;watchers={}
	for _,child in scroll:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
	local stack=Kit.stack(scroll,12);Kit.padding(stack,0,8,24,0);builders[current](stack);scroll.CanvasPosition=Vector2.zero
end
function App.mount(parent: Frame,_nav: any)
	local head=Kit.frame(parent,UDim2.new(1,0,0,38));local text=Kit.text(head,"Campus",24,F.display,C.text);text.Position=UDim2.fromOffset(0,2)
	local tabs=Kit.row(parent,40,8);tabs.Position=UDim2.fromOffset(0,44);tabs.Size=UDim2.new(1,0,0,40)
	for _,def in {{"building","Building"},{"access","Cards &amp; guests"},{"fleet","Fleet"},{"shops","Stores &amp; snacks"}} do
		local b=Kit.button(tabs,def[2],"secondary",UDim2.new(.25,-6,1,0));Kit.onClick(b,function()current=def[1];render()end)
	end
	scroll=Kit.scroll(parent,UDim2.new(1,0,1,-98),UDim2.fromOffset(0,98))
	State.onChange(function(s)if not s.data.company then return end;if #watchers==0 then render()end;for _,fn in watchers do fn(s)end end)
end
function App.onShow()if #watchers==0 and State.snapshot and State.snapshot.data.company then render() end end
return App
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000036"><Properties><string name="Name">StudioApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local Config=require(Shared.Config.StudioConfig)
local Math=require(Shared.StudioMath)
local Format=require(Shared.Format)
local UI=script.Parent.Parent
local State=require(UI.Parent.Controllers.StateController)
local Action=require(UI.Parent.Controllers.ActionController)
local Theme=require(UI.Theme)
local Kit=require(UI.Kit)
local Toast=require(UI.Toast)
local C,F=Theme.colors,Theme.font
local App={}
local refresh=function(_s: any)end
function App.mount(parent: Frame,nav: any)
	local scroll=Kit.scroll(parent);Kit.padding(scroll,2,14,22,2);Kit.list(scroll,16)
	Kit.heading(scroll,"Project studio","Give your AI a useful job. Build a website, a shop, a game companion or an office workflow.",1)
	local left,right=Kit.columns(scroll,.42,18,2)
	local builder=Kit.card(left,1,12)
	Kit.caption(builder,"01 / Project brief",1)
	local name=Kit.input(builder,"Your brand or project name");name.Text="Noah Studio";name.LayoutOrder=2
	local kindId,styleId,sourceId="website","paper","own"
	local briefId: string?=nil
	local selected: string?=nil
	local providerModelId: string?=nil
	local options={};for _,def in Config.KINDS do table.insert(options,{id=def.id,label=({website="Website",shop="Shop",gamebot="Game bot",workflow="Workflow"})[def.id]}) end
	local kinds=Kit.segmented(builder,options,kindId,function(id) kindId=id;briefId=nil;if State.snapshot then refresh(State.snapshot) end end)
	kinds.frame.LayoutOrder=3
	Kit.caption(builder,"02 / Visual direction",4)
	local styles=Kit.segmented(builder,{{id="paper",label="Paper"},{id="slate",label="Slate"},{id="brick",label="Clay"}},styleId,function(id) styleId=id end)
	styles.frame.LayoutOrder=5
	Kit.caption(builder,"03 / AI provider",6)
	local sources=Kit.segmented(builder,{{id="own",label="My trained AI"},{id="licensed",label="Subscribed AI"}},sourceId,function(id) sourceId=id;if State.snapshot then refresh(State.snapshot) end end)
	sources.frame.LayoutOrder=7
	local provider=Kit.para(builder,"",14,C.text,8)
	local quote=Kit.para(builder,"",13,C.muted,9)
	local generate=Kit.button(builder,"BUILD PROJECT","primary",UDim2.new(1,0,0,44));generate.LayoutOrder=10
	Kit.onClick(generate,function()
		if not providerModelId then return end
		local ok,result=Action.call("BuildProject",{name=name.Text,kind=kindId,style=styleId,modelId=providerModelId,briefId=briefId})
		if ok then selected=result.projectId end
	end)
	local jobText=Kit.para(builder,"",13,C.dim,11)
	local progress=Kit.bar(builder,6,12)
	local cancel=Kit.button(builder,"CANCEL CURRENT BUILD","ghost",UDim2.new(1,0,0,30));cancel.LayoutOrder=13;cancel.Visible=false
	Kit.onClick(cancel,function() Action.call("CancelProject",{}) end)

	local clientCard=Kit.card(left,2,10);Kit.caption(clientCard,"Client briefs",1)
	for index,brief in Config.BRIEFS do
		local b=Kit.button(clientCard,brief.client.." · "..Format.money(brief.reward),"secondary",UDim2.new(1,0,0,34));b.LayoutOrder=index+1;b.TextSize=13
		Kit.onClick(b,function() briefId=brief.id;kindId=brief.kind;name.Text=brief.client;kinds.set(kindId);if State.snapshot then refresh(State.snapshot) end end)
	end
	local work=Kit.card(left,3,10);Kit.caption(work,"Your portfolio",1)
	local projectList=Kit.stack(work,7,2);local rows={} :: {[string]:any};local listKey=""

	local previewCard=Kit.card(right,1,10)
	Kit.caption(previewCard,"Live project preview",1)
	local browser=Kit.frame(previewCard,UDim2.new(1,0,0,416));browser.LayoutOrder=2;browser.BackgroundTransparency=0;Kit.corner(browser,8)
	local chrome=Kit.frame(browser,UDim2.new(1,0,0,30));chrome.BackgroundTransparency=0;chrome.BackgroundColor3=C.raised
	local address=Kit.text(chrome,"studio.local",11,F.medium,C.muted);address.Position=UDim2.fromOffset(12,8)
	local brand=Kit.text(browser,"Noah Studio",15,F.bold);brand.Position=UDim2.fromOffset(22,49)
	local contact=Kit.button(browser,"Contact","ghost",UDim2.fromOffset(76,28));contact.Position=UDim2.new(1,-98,0,43);contact.TextSize=12
	local hero=Kit.para(browser,"",27,C.text);hero.AutomaticSize=Enum.AutomaticSize.None;hero.Size=UDim2.new(1,-44,0,96);hero.Position=UDim2.fromOffset(22,100)
	local body=Kit.para(browser,"",13,C.muted);body.AutomaticSize=Enum.AutomaticSize.None;body.Size=UDim2.new(1,-44,0,54);body.Position=UDim2.fromOffset(22,205)
	local tiles={}
	for i=1,3 do
		local tile=Kit.frame(browser,UDim2.new(1/3,-20,0,64),UDim2.new((i-1)/3,16,0,279));tile.BackgroundTransparency=0;Kit.corner(tile,4)
		local label=Kit.para(tile,"",12,C.text);label.AutomaticSize=Enum.AutomaticSize.None;label.Size=UDim2.new(1,-12,1,-12);label.Position=UDim2.fromOffset(6,6);label.TextXAlignment=Enum.TextXAlignment.Center
		tiles[i]={frame=tile,label=label}
	end
	local demo=Kit.button(browser,"Explore the project","secondary",UDim2.new(1,-44,0,34));demo.Position=UDim2.fromOffset(22,360);demo.TextSize=13
	local footer=Kit.para(previewCard,"",13,C.dim,3)
	local controls=Kit.row(previewCard,34,8,4)
	local publish=Kit.button(controls,"PUBLISH","primary",UDim2.fromOffset(120,32))
	local deliver=Kit.button(controls,"DELIVER TO CLIENT","secondary",UDim2.fromOffset(175,32));deliver.LayoutOrder=2
	local archive=Kit.button(previewCard,"Archive project","ghost",UDim2.new(1,0,0,28));archive.LayoutOrder=5;archive.TextSize=12
	local preview:any=nil
	local contactOpen=false;local demoCount=0;local previousId=""
	local function paint(item: any)
		preview=item
		if item.id~=previousId then previousId=item.id;contactOpen=false;demoCount=0 end
		local style=Config.find(Config.STYLES,item.style) or Config.STYLES[1]
		local bg,ink,accent=Theme.rgb(style.bg),Theme.rgb(style.ink),Theme.rgb(style.accent)
		contact.TextColor3=ink
		browser.BackgroundColor3=bg;brand.TextColor3=ink;hero.TextColor3=ink;body.TextColor3=ink
		brand.Text=item.name;address.Text="preview / "..item.kind.." / "..item.name
		hero.Text=if contactOpen then "Let's make something together." else item.content.headline
		body.Text=if contactOpen then "Contact preview opened. Your visitors can reach the company from this page." else item.content.sub
		for i,refs in tiles do refs.frame.BackgroundColor3=accent:Lerp(bg,.88);refs.label.TextColor3=ink;refs.label.Text=item.content.items[i] or "" end
		demo.BackgroundColor3=accent;demo.BackgroundTransparency=0;demo.TextColor3=bg
		demo.Text=if item.kind=="shop" then "Add item to cart · "..tostring(demoCount).." items" elseif item.kind=="workflow" then "Complete next task · "..tostring(demoCount).." done" elseif item.kind=="gamebot" then "Open robot test arena" else "Explore our work"
		footer.Text=string.format("%s · %.1f quality · Built by %s",item.status,item.quality,item.modelName or "AI provider")
		local mine=State.snapshot and State.snapshot.data.empire.projects[item.id]~=nil
		archive.Visible=mine==true and item.status~="building"
		publish.Visible=mine==true;deliver.Visible=mine==true and item.briefId~=nil
		Kit.setDisabled(publish,item.status~="ready");Kit.setDisabled(deliver,item.status=="building" or item.delivered==true)
	end
	Kit.onClick(contact,function() if preview then contactOpen=not contactOpen;paint(preview) end end)
	Kit.onClick(demo,function()
		if not preview then return end
		if preview.kind=="gamebot" then nav.show("arena")
		elseif preview.kind=="shop" or preview.kind=="workflow" then demoCount+=1;paint(preview)
		else Toast.show("info","Project preview: "..preview.content.items[1]) end
	end)
	Kit.onClick(publish,function() if preview then Action.call("PublishProject",{projectId=preview.id}) end end)
	Kit.onClick(archive,function() if preview then local ok=Action.call("ArchiveProject",{projectId=preview.id});if ok then selected=nil end end end)
	Kit.onClick(deliver,function() if preview then Action.call("DeliverProject",{projectId=preview.id}) end end)
	local gallery=Kit.card(right,2,8);Kit.caption(gallery,"Around the district",1)
	local galleryList=Kit.stack(gallery,6,2);local galleryKey="";local galleryButtons={}
	refresh=function(s: any)
		local e=s.data.empire;local kind=Config.find(Config.KINDS,kindId)
		local stats:any=nil;providerModelId=nil
		if sourceId=="licensed" then
			local sub=e.subscriptions
			if sub.expires and sub.expires&gt;os.time() then stats=sub.stats or {coding=sub.score,creativity=sub.score,reliability=60,reasoning=sub.score};providerModelId="licensed";provider.Text=sub.provider.." / "..sub.name else provider.Text="Buy AI access in Market first." end
		else
			local best:any=nil
			for _,id in s.data.modelOrder do local m=s.data.models[id];if m and (m.status=="trained" or m.status=="live") and (not best or (m.stats[kind.stat] or 0)&gt;(best.stats[kind.stat] or 0)) then best=m end end
			if best then stats=best.stats;providerModelId=best.id;provider.Text=best.name.." · your best "..kind.stat.." checkpoint" else provider.Text="Train your first model in Models." end
		end
		quote.Text=Format.money(kind.cost).." build cost · "..(if stats then tostring(Math.quality(stats,kind)).." expected quality" else "No trained AI available")..(if briefId then "\nClient: "..(Config.find(Config.BRIEFS,briefId).client) else "\nYour own company project")
		Kit.setDisabled(generate,e.projectJob~=nil or not stats or s.data.money&lt;kind.cost)
		local job=e.projectJob;cancel.Visible=job~=nil;progress.set(if job then job.done/job.total else 0)
		jobText.Text=if job then "Building · "..Format.percent(job.done/job.total).." · "..(if s.data.training then "Sharing GPUs with training" else "Using your compute") else "Ready for a new project"
		local key=table.concat(e.projectOrder,",")
		if key~=listKey then
			listKey=key;for _,r in rows do r.button:Destroy() end;table.clear(rows)
			for i,id in e.projectOrder do local b=Kit.button(projectList,"","secondary",UDim2.new(1,0,0,36));b.LayoutOrder=i;b.TextSize=13;rows[id]={button=b};Kit.onClick(b,function() selected=id;refresh(State.snapshot) end) end
		end
		for id,r in rows do local item=e.projects[id];r.button.Text=item.name.." / "..item.status end
		local list=s.live.studio and s.live.studio.gallery or {};local keys={}
		for _,item in list do table.insert(keys,item.id) end
		local gkey=table.concat(keys,",")
		if gkey~=galleryKey then
			galleryKey=gkey;for _,b in galleryButtons do b:Destroy() end;table.clear(galleryButtons)
			for i,item in list do local b=Kit.button(galleryList,item.company.." / "..item.kind,"ghost",UDim2.new(1,0,0,30));b.LayoutOrder=i;b.TextSize=12;table.insert(galleryButtons,b);Kit.onClick(b,function() selected=item.id;refresh(State.snapshot) end) end
		end
		local item=if selected then e.projects[selected] else nil
		if not item and selected then for _,other in list do if other.id==selected then item=other;break end end end
		if not item then item=e.projects[e.projectOrder[#e.projectOrder]] or list[1] end
		if item then paint(item) else
			paint({id="empty",name=name.Text,kind=kindId,style=styleId,status="preview",quality=0,modelName="your next model",content=Math.content(name.Text,kindId,briefId)})
		end
	end
	State.onChange(function(s) if parent.Visible and nav.isOpen() then refresh(s) end end)
end
function App.onShow() if State.snapshot then refresh(State.snapshot) end end
return App
