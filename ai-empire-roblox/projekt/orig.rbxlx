 local label=Instance.new("TextLabel");label.BackgroundTransparency=1;label.Size=UDim2.fromScale(1,1);label.Text=CampusMath.staffName(index).."\n"..(job or "Campus Operations");label.TextColor3=Color3.fromRGB(239,237,224);label.TextSize=12;label.Font=Enum.Font.BuilderSansBold;label.Parent=badge
 local prompt=Instance.new("ProximityPrompt");prompt.Name="EmployeeTalk";prompt.ActionText="Talk";prompt.ObjectText=CampusMath.staffName(index);prompt.MaxActivationDistance=10;prompt.RequiresLineOfSight=true;prompt:SetAttribute("OwnerUserId",owner);prompt:SetAttribute("EmployeeTalk",index);prompt.Parent=head
