  local p=Instance.new("Part");p.Name=name;p.Size=size*scale;p.CFrame=pose*at;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.CanCollide=collide==true;p.CanTouch=false;p.Massless=name~="HumanoidRootPart";p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=model;return p
 end
