-- Local procedural Motor6D poses; never moves an employee's world position.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Collection=game:GetService("CollectionService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Controller={}
local employees: {[Model]:any}={}
local function add(m: Instance)
 if not m:IsA("Model") then return end
 local joints={};local parts={}
 for _,p in m:GetDescendants() do if p:IsA("Motor6D") then joints[p.Name]=p elseif p:IsA("BasePart") then table.insert(parts,p) end end
 employees[m]={joints=joints,parts=parts,next=0,hidden=false}
end
function Controller.pose(activity: string,sitting: boolean,walking: boolean,time: number,seed: number,holdingCup: boolean?): {[string]:CFrame}
 local t=time+seed*.013;local sway=math.sin(t*5.3);local fidget=math.sin(t*.67)*math.sin(t*.13)
 local arms=if walking then .52*sway else 0
 local typing=(activity=="WORKING" or activity=="DATA_REVIEW" or activity=="MARKETING" or activity=="MONITOR_TRAINING" or activity=="MODEL_REVIEW" or activity=="RESEARCH") and sitting
 local left=if typing then 1.16+.07*math.sin(t*8.3) else -arms
 local right=if typing then 1.2+.06*math.sin(t*9.1+1.2) else arms
 if typing and math.sin(t*.31)&gt;.83 then left=.4;right=.7 end -- short pauses, not a permanent typing loop
 if activity=="COFFEE_BREAK" or activity=="LUNCH" then right=if math.sin(t*.7)&gt;.7 then 1.9 else 1.1 end
 if activity=="RESEARCH" and not sitting then right=1.5+.13*math.sin(t*2.4) end
 if holdingCup and math.sin(t*.53)&gt;.88 then right=1.9 end
 if activity=="SERVER_CHECK" then right=1.05+.15*math.sin(t*.8) end
 if activity=="MEETING" or activity=="TALKING" then right=.6+.35*math.sin(t*1.7);left=.2+.12*math.sin(t*1.2) end
 return {
  ["Left Shoulder"]=CFrame.Angles(left,0,-.04),["Right Shoulder"]=CFrame.Angles(right,0,.04),
  ["Left Hip"]=CFrame.Angles(if sitting then math.pi/2 else arms,0,0),["Right Hip"]=CFrame.Angles(if sitting then math.pi/2 else -arms,0,0),
  Neck=CFrame.Angles(if typing then -.1 else .03*fidget,.11*fidget,0),RootJoint=CFrame.new(0,if walking then .035*math.cos(t*10.6) else 0,0)*CFrame.Angles(if typing then .045 else .012*fidget,0,0),
 }
end
function Controller.init()
 for _,m in Collection:GetTagged("CompanyEmployee") do add(m) end
 Collection:GetInstanceAddedSignal("CompanyEmployee"):Connect(add)
 Collection:GetInstanceRemovedSignal("CompanyEmployee"):Connect(function(m)employees[m]=nil end)
 RunService.PreSimulation:Connect(function()
  local camera=workspace.CurrentCamera;if not camera then return end
  local time=workspace:GetServerTimeNow()
  for m,cache in employees do
   local root=m.PrimaryPart
   if not m.Parent or not root then employees[m]=nil;continue end
   local distance=(camera.CFrame.Position-root.Position).Magnitude
   local hidden=distance&gt;Config.FAR or m:GetAttribute("OffDuty")==true
   if hidden~=cache.hidden then for _,p in cache.parts do if p.Parent then p.LocalTransparencyModifier=if hidden then 1 else 0 end end;cache.hidden=hidden end
   if hidden or time&lt;cache.next then continue end
   cache.next=time+(if distance&lt;Config.NEAR then 1/30 else .2)
   local activity=m:GetAttribute("Activity") or "WORKING";local h=m:FindFirstChildOfClass("Humanoid")
   local velocity=root.AssemblyLinearVelocity;local walking=Vector3.new(velocity.X,0,velocity.Z).Magnitude&gt;.5
   local transforms=Controller.pose(activity,h~=nil and h.SeatPart~=nil,walking,time,m:GetAttribute("PersonalitySeed") or 0,m:GetAttribute("HoldingCup")==true)
   for name,transform in transforms do local joint=cache.joints[name];if joint and joint.Parent then joint.Transform=transform end end
  end
 end)
end
return Controller
