</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000009"><Properties><string name="Name">DepartmentConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- A single architectural plan drives rooms, access rules, workstations and wayfinding.
local Config={}
Config.DEPARTMENTS={
 data={name="Data Operations",role="curator",app="data",color={105,140,153},screen="data",description="Collect → filter → clean → tokenize. Better data improves your next model."},
 engineering={name="AI Engineering",role="engineer",app="lab",color={108,133,123},screen="engineering",description="Design a model, install enough VRAM, then train with your own data."},
 design={name="Model Architecture",role="researcher",app="lab",color={147,137,107},screen="design",description="Size sets potential and hardware needs. Focus chooses the model's strengths."},
 training={name="Training Control",role="engineer",app="lab",color={108,133,123},screen="training",description="GPUs process training data. Monitor progress, loss and training decisions."},
 research={name="AI Research",role="researcher",app="empire",section="research",color={126,121,149},screen="research",description="Research improves future models. Data quality still matters."},
 evaluation={name="Model Evaluation",role="researcher",app="lab",section="evaluation",color={129,149,115},screen="evaluation",description="Compare coding, reasoning, math, creativity, knowledge and reliability."},
 growth={name="Product &amp; Growth",role="marketer",app="market",color={168,133,109},screen="growth",description="Launch with pricing and a target market. Users and API customers generate revenue."},
 deployment={name="Deployment Studio",role="marketer",app="lab",section="release",color={168,133,109},screen="deployment",description="Choose a trained model → price subscription and API → target → marketing → launch."},
}
-- Eight rooms per work floor, six deliberately varied desks per team room.
-- The 14-stud internal aisles, front/back bridges and 6-stud cross corridors remain clear.
function Config.rooms(tier: number,floor: number): {any}
 local maxFloor=({3,4,5,7})[tier]-2
 local pairsByFloor={
  {"data","design","data","evaluation","engineering","growth","training","deployment"},
  {"engineering","design","engineering","evaluation","training","growth","engineering","deployment"},
  {"research","design","research","evaluation","research","growth","design","deployment"},
  {"growth","deployment","growth","evaluation","engineering","growth","research","deployment"},
  {"research","design","research","evaluation","engineering","growth","training","deployment"},
 }
 local out={}
 for bay=1,4 do for side=1,2 do
  local z1=-44+(bay-1)*32;local west=side==1
  local id=pairsByFloor[math.min(floor,#pairsByFloor)][(bay-1)*2+side]
  table.insert(out,{id=string.format("F%d_%s_%d",floor,if west then "W" else "E",bay),department=id,floor=floor,
   x1=if west then -80 else 30,x2=if west then -30 else 80,z1=z1,z2=z1+26,
   access=if id=="research" and floor==maxFloor and tier==4 then "research" else "staff",style=(floor+bay+side)%4})
 end end
 return out
end
function Config.employeeAllowed(role: string,x: number,y: number,z: number,tier: number): boolean
 local floors=({3,4,5,7})[tier];local top=(floors-1)*16
 -- The entire upper private pavilion and founder suite have no employee exception.
 if y&gt;14 and y&lt;34 and z&gt;98 and z&lt;160 and math.abs(x)&lt;82 then return false end
 if y&gt;top-2 and y&lt;top+16 and ((x&gt;18 and z&gt;34 and z&lt;80) or (x&gt;61 and z&lt; -10)) then return false end
 if y&gt; -2 and y&lt;15 and x&lt; -40 and z&gt;40 and z&lt;80 then return role=="engineer" end
 for f=1,floors-2 do
  if y&gt;f*16-2 and y&lt;f*16+14 then for _,r in Config.rooms(tier,f) do
   if x&gt;r.x1 and x&lt;r.x2 and z&gt;r.z1 and z&lt;r.z2 and r.access=="research" then return role=="researcher" or role=="engineer" end
  end end
 end
 return y&gt; -27 and y&lt;floors*16+12 and math.abs(x)&lt;146 and z&gt; -150 and z&lt;160
end
function Config.doorAllowed(role: string,access: string?): boolean
 if access=="owner" then return false end
 if access=="compute" then return role=="engineer" end
 if access=="research" then return role=="researcher" or role=="engineer" end
 return true
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000010"><Properties><string name="Name">EmployeeConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local Config={}
Config.NEAR=120;Config.FAR=250;Config.MAX_PATH_JOBS=2;Config.MAX_MOVING_PER_OFFICE=20
Config.ROLES={researcher="AI Researcher",engineer="ML Engineer",curator="Data Curator",marketer="Growth Manager",support="Campus Operations"}
Config.TASKS={
 researcher={{id="RunExperiment",type="Computer",department="research",seconds={45,180},state="RESEARCH",priority=30},
 {id="UseWhiteboard",type="Whiteboard",department="research",seconds={30,80},state="RESEARCH",priority=18},
 {id="AnalyzeModel",type="Computer",department="evaluation",seconds={40,100},state="MODEL_REVIEW",priority=20},
 {id="ArchitectureStudy",type="Computer",department="design",seconds={45,120},state="RESEARCH",priority=22}},
 engineer={{id="WriteCode",type="Computer",department="engineering",seconds={30,120},state="WORKING",priority=30},
 {id="MonitorTraining",type="Computer",department="training",seconds={45,120},state="MONITOR_TRAINING",priority=26},
 {id="InspectServer",type="ServerRack",department="compute",seconds={20,60},state="SERVER_CHECK",priority=15},
 {id="ReviewModel",type="Computer",department="evaluation",seconds={40,100},state="MODEL_REVIEW",priority=18}},
 curator={{id="CleanDataset",type="Computer",department="data",seconds={45,140},state="DATA_REVIEW",priority=35},
 {id="CheckQuality",type="Computer",department="data",seconds={45,100},state="DATA_REVIEW",priority=30},
 {id="MonitorPipeline",type="Pipeline",department="data",seconds={25,70},state="DATA_REVIEW",priority=18}},
 marketer={{id="AnalyzeMarket",type="Computer",department="growth",seconds={45,140},state="MARKETING",priority=35},
 {id="PlanLaunch",type="Computer",department="deployment",seconds={45,100},state="MARKETING",priority=30},
 {id="CheckCustomers",type="Computer",department="growth",seconds={35,110},state="MARKETING",priority=25}},
 support={{id="CampusOperations",type="Service",seconds={80,180},state="WORKING",priority=20}},
}
function Config.seed(index: number,owner: number): number return (index*7919+owner*31)%104729 end
function Config.personality(index: number,owner: number): any
 local seed=Config.seed(index,owner)
 return {seed=seed,walkSpeed=11+(seed%31)/10,social=(seed%100)/100,breakEvery=180+seed%240,
  coffee=seed%3~=0,start=7.75+(seed%76)/60,finish=16.5+(seed%91)/60,lunch=11.75+(seed%106)/60,
  scheduleOffset=seed%91,workStyle=seed%4,meetingFrequency=160+seed%280}
end
-- Workdays are visible in a practical session length; night passes faster than working hours.
function Config.hour(seconds: number): number
 local t=seconds%1200
 return (if t&lt;900 then 8+t/90 else 18+(t-900)*14/300)%24
end
function Config.priority(role: string,task: any,event: any): number
 local p=task.priority
 if event.training then
  if task.id=="MonitorTraining" then p+=50 elseif task.id=="InspectServer" then p+=40 elseif task.id=="AnalyzeModel" then p-=20 end
 end
 if event.research and task.id=="RunExperiment" then p+=60 end
 if event.review and (task.id=="AnalyzeModel" or task.id=="ReviewModel") then p+=65 end
 if event.live and role=="marketer" then p+=45 end
 if event.hardware and task.id=="InspectServer" then p+=65 end
 if event.data and role=="curator" then p+=35 end
 return p
end
function Config.productive(state: string): number
 if state=="WORKING" or state=="RESEARCH" or state=="DATA_REVIEW" or state=="MARKETING" or state=="SERVER_CHECK" or state=="MONITOR_TRAINING" or state=="MODEL_REVIEW" then return 1 end
 if state=="MEETING" or state=="TALKING" then return .8 end
 if state=="COFFEE_BREAK" or state=="LUNCH" then return .4 end
 if state=="LEAVING" or state=="OFF_DUTY" then return 0 end
 return .75
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000021"><Properties><string name="Name">CampusConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
