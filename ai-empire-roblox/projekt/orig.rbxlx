<roblox version="4"><External>null</External><External>nil</External><Item class="ReplicatedStorage" referent="RBX00000001"><Properties><string name="Name">ReplicatedStorage</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Shared</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000008"><Properties><string name="Name">Config</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">CompanyConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Firmengründung: Logos, Farben, Spezialisierungen, Ränge.

export type Specialization = {
	id: string,
	name: string,
	desc: string,
	statBonus: { [string]: number }?,
	serveCostMult: number?, -- Multiplikator auf Inferenzkosten
	breakthroughMult: number?, -- Multiplikator auf die Breakthrough-Chance im Training
	enterpriseRevenueMult: number?, -- Multiplikator auf Umsatz aus Enterprise-Segmenten
}

export type ColorDef = { id: string, rgb: { number } }
export type RankDef = { name: string, minUsers: number }

local CompanyConfig = {}

CompanyConfig.LOGOS = { "◈", "▰", "◒", "⊞", "△", "⦿", "//", "N" } :: { string }

CompanyConfig.COLORS = {
	{ id = "cyan", rgb = { 120, 200, 174 } },
	{ id = "violet", rgb = { 176, 162, 208 } },
	{ id = "emerald", rgb = { 116, 173, 143 } },
	{ id = "amber", rgb = { 224, 189, 122 } },
	{ id = "rose", rgb = { 202, 148, 148 } },
	{ id = "blue", rgb = { 134, 171, 198 } },
	{ id = "orange", rgb = { 213, 157, 118 } },
	{ id = "lime", rgb = { 170, 186, 132 } },
} :: { ColorDef }

-- Spezialisierung = kleiner Startbonus, keine Sackgasse.
CompanyConfig.SPECIALIZATIONS = {
	{
		id = "general",
		name = "General AI",
		desc = "Balanced. +2 on every core stat.",
		statBonus = { reasoning = 2, coding = 2, math = 2, creativity = 2, knowledge = 2, reliability = 2 },
	},
	{ id = "coding", name = "Coding AI", desc = "+6 Coding on every model.", statBonus = { coding = 6 } },
	{ id = "creative", name = "Creative AI", desc = "+6 Creativity on every model.", statBonus = { creativity = 6 } },
	{
		id = "efficient",
		name = "Efficient AI",
		desc = "-25% serving costs, +6 Efficiency.",
		statBonus = { efficiency = 6 },
		serveCostMult = 0.75,
	},
	{
		id = "research",
		name = "Research Lab",
		desc = "Training breakthroughs 60% more likely.",
		-- später: zusätzlich schnellere Forschung, sobald Phase 2 (Research Tree) existiert
		breakthroughMult = 1.6,
	},
	{
		id = "enterprise",
		name = "Enterprise AI",
		desc = "+25% revenue from businesses.",
		enterpriseRevenueMult = 1.25,
	},
} :: { Specialization }

-- Rang nach Spitzen-Nutzerzahl. später (Phase 6): Bewertung/Umsatz einbeziehen
CompanyConfig.RANKS = {
	{ name = "Garage Startup", minUsers = 0 },
	{ name = "Startup", minUsers = 5_000 },
	{ name = "Scale-Up", minUsers = 100_000 },
	{ name = "Unicorn", minUsers = 1_000_000 },
	{ name = "Tech Giant", minUsers = 10_000_000 },
	{ name = "AI Leader", minUsers = 50_000_000 },
} :: { RankDef }

function CompanyConfig.getSpec(id: string): Specialization?
	for _, spec in CompanyConfig.SPECIALIZATIONS do
		if spec.id == id then
			return spec
		end
	end
	return nil
end

function CompanyConfig.getColor(id: string): ColorDef?
	for _, color in CompanyConfig.COLORS do
		if color.id == id then
			return color
		end
	end
	return nil
end

function CompanyConfig.isLogo(glyph: string): boolean
	return table.find(CompanyConfig.LOGOS, glyph) ~= nil
end

function CompanyConfig.rankFor(peakUsers: number): string
	local name = CompanyConfig.RANKS[1].name
	for _, rank in CompanyConfig.RANKS do
		if peakUsers &gt;= rank.minUsers then
			name = rank.name
		end
	end
	return name
end

return CompanyConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">DataConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Trainingsdaten: Typen, kaufbare Pakete, kostenloses Scrapen.
-- Phase 1: General/Code/Math. Bilder, Synthetic, Scientific kommen mit Phase 2/9 als neue TYPES.

export type DataTypeDef = { id: string, label: string }
export type PackDef = {
	id: string,
	type: string,
	label: string,
	tokens: number,
	quality: number, -- 0..1
	price: number,
}

local DataConfig = {}

DataConfig.TYPES = {
	{ id = "general", label = "General Text" },
	{ id = "code", label = "Code" },
	{ id = "math", label = "Math" },
} :: { DataTypeDef }

DataConfig.PACKS = {
	{ id = "web_chunk", type = "general", label = "Web Crawl Chunk", tokens = 1e9, quality = 0.35, price = 1_200 },
	{ id = "web_xl", type = "general", label = "Web Crawl XL", tokens = 1e10, quality = 0.38, price = 10_000 },
	{ id = "books", type = "general", label = "Books &amp; Wiki", tokens = 1e9, quality = 0.82, price = 6_000 },
	{ id = "repos", type = "code", label = "Public Repos", tokens = 1e9, quality = 0.5, price = 2_500 },
	{ id = "code_curated", type = "code", label = "Curated Code", tokens = 2e9, quality = 0.86, price = 16_000 },
	{ id = "math_basic", type = "math", label = "Math Problems", tokens = 5e8, quality = 0.6, price = 2_000 },
	{ id = "math_olympiad", type = "math", label = "Olympiad Set", tokens = 1e9, quality = 0.9, price = 10_000 },
} :: { PackDef }

-- Gratis, aber langsam und schlecht: der Notausgang, wenn das Geld weg ist
DataConfig.SCRAPE = { type = "general", tokens = 8e7, quality = 0.3, cooldown = 30 }

DataConfig.MAX_BUY = 10 -- max. Pakete pro Kauf-Anfrage

function DataConfig.getPack(id: string): PackDef?
	for _, pack in DataConfig.PACKS do
		if pack.id == id then
			return pack
		end
	end
	return nil
end

function DataConfig.isType(id: string): boolean
	for _, t in DataConfig.TYPES do
		if t.id == id then
			return true
		end
	end
	return false
end

return DataConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">GameConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Technische Konstanten: Speichern, Takt, Limits.
-- Balancing (Preise, Formeln, Markt) liegt in den anderen Config-Modulen.

local GameConfig = {
	DATA_VERSION = 5,
	DATASTORE_NAME = "AIEmpire_Player_v1",
	KEY_PREFIX = "u_",

	AUTOSAVE_SECONDS = 90,
	SESSION_LOCK_TIMEOUT = 180, -- ein fremder Lock, der älter ist, gilt als tot (Server abgestürzt)
	LOAD_ATTEMPTS = 6,
	LOAD_RETRY_SECONDS = 4,
	SAVE_ATTEMPTS = 3,

	TICK_SECONDS = 1, -- Simulationstakt für Training und Markt
	REPLICATE_SECONDS = 0.25, -- frühestens so oft geht ein State-Update an einen Client

	START_MONEY = 25_000,
	COMPANY_NAME_MIN = 3,
	COMPANY_NAME_MAX = 24,
	MODEL_NAME_MIN = 2,
	MODEL_NAME_MAX = 20,

	-- 1 Spielmonat = 60 echte Minuten. Abo- und API-Preise gelten pro Spielmonat.
	GAME_MONTH_SECONDS = 3600,

	-- UserIds, die außerhalb von Studio Debug-Befehle nutzen dürfen. Für Live-Server leer lassen.
	DEV_USER_IDS = {} :: { number },
}

return table.freeze(GameConfig)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">HardwareConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Compute: GPU-Katalog für Phase 1 (Tier 1-3 + Start-Laptop).
-- GPU-Server, Cluster, Rechenzentren und Cloud-Miete kommen in Phase 4 als eigene Systeme.

export type GPUDef = {
	id: string,
	label: string,
	tier: string,
	price: number,
	throughput: number, -- Compute-Einheiten pro Sekunde
	vram: number, -- GB
	powerCost: number, -- $ pro Compute-Einheit (Strom); bessere Hardware = billiger pro Arbeit
	starter: boolean?, -- Start-Hardware: belegt keinen Rack-Slot, nicht verkaufbar
}

local HardwareConfig = {}

HardwareConfig.GPUS = {
	{
		id = "laptop",
		label = "Old Laptop GPU",
		tier = "Starter",
		price = 0,
		throughput = 0.5,
		vram = 6,
		powerCost = 32,
		starter = true,
	},
	{ id = "consumer", label = "Consumer GPU", tier = "Tier 1", price = 2_500, throughput = 1, vram = 12, powerCost = 26 },
	{
		id = "workstation",
		label = "Workstation GPU",
		tier = "Tier 2",
		price = 14_000,
		throughput = 3.2,
		vram = 48,
		powerCost = 22,
	},
	{
		id = "accelerator",
		label = "AI Accelerator",
		tier = "Tier 3",
		price = 60_000,
		throughput = 9,
		vram = 80,
		powerCost = 18,
	},
} :: { GPUDef }

table.insert(HardwareConfig.GPUS, {id="datacenter", label="HBM Datacenter GPU", tier="Tier 4", price=180000, throughput=28, vram=192, powerCost=13})
table.insert(HardwareConfig.GPUS, {id="superpod", label="Eight-GPU Compute Pod", tier="Tier 5", price=1200000, throughput=200, vram=1536, powerCost=10})
function HardwareConfig.slots(empire: any): number
	return ({6,12,24,48})[empire.office] + (if empire.research.cluster then 48 else 0)
end
HardwareConfig.RACK_SLOTS = 6 -- Garagen-Rack. später (Phase 4): Serverräume mit Strom/Kühlung
function HardwareConfig.thermal(empire: any,throughput: number): number
	local cooling=(empire.infrastructure and empire.infrastructure.cooling) or 1
	local budget=20*empire.office*cooling
	return math.min(1,budget/math.max(1,throughput))
end
HardwareConfig.SELL_REFUND = 0.5
HardwareConfig.TFLOPS_PER_UNIT = 35 -- nur für die Anzeige

function HardwareConfig.getGPU(id: string): GPUDef?
	for _, gpu in HardwareConfig.GPUS do
		if gpu.id == id then
			return gpu
		end
	end
	return nil
end

return HardwareConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">MarketConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- KI-Markt: Nutzersegmente, NPC-Konkurrenz, Preisgrenzen, Reichweite und Reputation.
-- Die Formeln stehen in Shared/MarketMath.

export type SegmentDef = {
	id: string,
	label: string,
	pool: number, -- erreichbare Nutzer im Segment
	priceKind: "sub" | "api", -- welcher Preis zählt: Monatsabo oder API-Preis
	sens: number, -- Preisempfindlichkeit
	outside: number, -- Nutzen der Option "nutze keins davon"
	tokensPerUser: number, -- Verbrauch pro Nutzer und Spielmonat
	marketingScale: number, -- $-Betrag, bei dem Marketing ~63% seiner Maximalwirkung erreicht
	enterprise: boolean?,
	weights: { [string]: number }, -- was das Segment an einem Modell schätzt (Summe = 1)
}

export type NPCModelDef = {
	id: string,
	company: string,
	name: string,
	rgb: { number },
	subPrice: number,
	apiPrice: number,
	stats: { [string]: number },
}

local MarketConfig = {}

MarketConfig.SEGMENTS = {
	{
		id = "developers",
		label = "Developers",
		pool = 4e5,
		priceKind = "api",
		sens = 0.8,
		outside = -0.6,
		tokensPerUser = 3e6,
		marketingScale = 15_000,
		weights = { coding = 0.45, reasoning = 0.25, speed = 0.1, reliability = 0.2 },
	},
	{
		id = "students",
		label = "Students",
		pool = 1.5e6,
		priceKind = "sub",
		sens = 1.6,
		outside = -0.3,
		tokensPerUser = 3e5,
		marketingScale = 30_000,
		weights = { knowledge = 0.3, math = 0.25, reasoning = 0.2, creativity = 0.15, speed = 0.1 },
	},
	{
		id = "businesses",
		label = "Businesses",
		pool = 1e5,
		priceKind = "api",
		sens = 0.35,
		outside = -0.4,
		tokensPerUser = 1.2e7,
		marketingScale = 40_000,
		enterprise = true,
		weights = { reliability = 0.35, knowledge = 0.2, reasoning = 0.2, coding = 0.15, speed = 0.1 },
	},
	{
		id = "consumers",
		label = "General",
		pool = 5e6,
		priceKind = "sub",
		sens = 1.1,
		outside = 0.2,
		tokensPerUser = 1.5e5,
		marketingScale = 80_000,
		weights = { creativity = 0.35, knowledge = 0.35, speed = 0.1, reasoning = 0.2 },
	},
} :: { SegmentDef }

-- Release-Ziel: ein Segment oder "general" (verteilt, schwächer pro Segment)
MarketConfig.TARGETS = { "developers", "students", "businesses", "general" } :: { string }

MarketConfig.SUB_PRICES = { 0, 5, 10, 20 } :: { number } -- $ pro Spielmonat
MarketConfig.API_PRICE = { min = 0.2, max = 20, step = 0.1, default = 2 } -- $ pro 1M Tokens
MarketConfig.MARKETING = { max = 250_000, step = 500 }

-- Nutzen = (Fit - FIT_CENTER) / FIT_SCALE - sens * Preis / PRICE_NORM
MarketConfig.FIT_CENTER = 50
MarketConfig.FIT_SCALE = 10
MarketConfig.PRICE_NORM = { sub = 10, api = 5 }

MarketConfig.REACH = {
	base = 0.01, -- Bekanntheit einer unbekannten Firma
	repScale = 0.3, -- + so viel bei Reputation 100
	max = 0.9,
	hypeMax = 0.5, -- Marketing-Obergrenze im Zielsegment
	hypeTau = 600, -- Sekunden, bis Marketing-Hype auf ~37% abgeklungen ist
	targetFactor = 1,
	generalFactor = 0.45,
	spillFactor = 0.12, -- Streuwirkung auf Nicht-Zielsegmente
	organicShare = 0.6, -- Mundpropaganda wächst Richtung organicShare * Marktanteil
	organicRate = 1 / 240,
}

MarketConfig.USERS = { riseTau = 40, fallTau = 120 } -- Sekunden bis ~63% des Zielwerts

MarketConfig.REPUTATION = { userScale = 2e6, userPart = 60, qualityPart = 0.4, rate = 1 / 300 }

MarketConfig.NPC_REACH = 0.8

-- Phase 1: statische Konkurrenz. später (Phase 5): NPC-Firmen mit Strategie und eigenen Releases
MarketConfig.NPC_MODELS = {
	{
		id = "npc_nc3",
		company = "NeuralCore",
		name = "NC-3",
		rgb = { 239, 68, 68 },
		subPrice = 20,
		apiPrice = 6,
		stats = { reasoning = 62, coding = 60, math = 58, creativity = 60, knowledge = 66, reliability = 68, speed = 70 },
	},
	{
		id = "npc_titan",
		company = "Titan Intelligence",
		name = "Titan Code 2",
		rgb = { 245, 158, 11 },
		subPrice = 10,
		apiPrice = 3,
		stats = { reasoning = 58, coding = 72, math = 60, creativity = 40, knowledge = 52, reliability = 62, speed = 76 },
	},
	{
		id = "npc_orion",
		company = "Orion AI",
		name = "Orion Edu",
		rgb = { 16, 185, 129 },
		subPrice = 5,
		apiPrice = 1.5,
		stats = { reasoning = 54, coding = 44, math = 62, creativity = 48, knowledge = 62, reliability = 58, speed = 78 },
	},
	{
		id = "npc_muse",
		company = "BlueMind",
		name = "Blue Muse",
		rgb = { 59, 130, 246 },
		subPrice = 0,
		apiPrice = 2,
		stats = { reasoning = 50, coding = 38, math = 36, creativity = 66, knowledge = 58, reliability = 54, speed = 80 },
	},
	{
		id = "npc_vlite",
		company = "Vector Labs",
		name = "Vector Lite",
		rgb = { 148, 163, 184 },
		subPrice = 0,
		apiPrice = 0.4,
		stats = { reasoning = 44, coding = 42, math = 40, creativity = 46, knowledge = 48, reliability = 50, speed = 92 },
	},
} :: { NPCModelDef }

function MarketConfig.isTarget(id: string): boolean
	return table.find(MarketConfig.TARGETS, id) ~= nil
end

function MarketConfig.isSubPrice(price: number): boolean
	return table.find(MarketConfig.SUB_PRICES, price) ~= nil
end

return MarketConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">ModelConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- KI-Modelle: Größen, Trainingsfokus, Stats und die Stellschrauben der Leistungsformel.
-- Die Formel selbst steht in Shared/ModelMath.

export type SizeDef = {
	id: string,
	label: string,
	potential: number, -- Obergrenze der Kern-Intelligenz bei perfekten Daten (Phase-1-Architektur)
	dataNeed: number, -- Tokens, ab denen die Daten "satt" sind (Füllgrad 1.0)
	work: number, -- Rechenarbeit in Compute-Einheiten
	vram: number, -- benötigter Grafikspeicher (GB, über alle GPUs summiert)
	serveCost: number, -- Inferenzkosten in $ pro 1M Tokens (Cloud)
	speed: number,
	efficiency: number,
}

export type FocusDef = { id: string, label: string, mult: { [string]: number } }
export type StatDef = { id: string, label: string, weight: number }

export type ChoiceDef = {
	id: string,
	label: string,
	desc: string,
	timeMult: number?, -- Multiplikator auf die RESTLICHE Arbeit
	quality: number?, -- Multiplikator auf die Modellqualität
	costFactor: number?, -- Zusatzkosten als Anteil der Trainingskosten
	gamble: number?, -- Wahrscheinlichkeit, dass "quality" tatsächlich greift
}

export type EventDef = {
	id: string,
	title: string,
	text: string,
	weight: number,
	choices: { ChoiceDef }?, -- vorhanden = Entscheidungs-Event, Training pausiert bis zur Wahl
	default: string?, -- Wahl bei Timeout
	timeMult: number?, -- Sofort-Effekt bei Events ohne Wahl
	quality: number?,
}

local ModelConfig = {}

-- Phase 1: vier Größen. 7B+ kommen mit Research/Infrastruktur (Phase 2/4) als neue Einträge hier.
ModelConfig.SIZES = {
	{
		id = "s100m",
		label = "100M",
		potential = 46,
		dataNeed = 1.5e9,
		work = 40,
		vram = 4,
		serveCost = 0.04,
		speed = 94,
		efficiency = 92,
	},
	{
		id = "s500m",
		label = "500M",
		potential = 57,
		dataNeed = 5e9,
		work = 150,
		vram = 12,
		serveCost = 0.15,
		speed = 84,
		efficiency = 82,
	},
	{
		id = "s1b",
		label = "1B",
		potential = 63,
		dataNeed = 1e10,
		work = 320,
		vram = 24,
		serveCost = 0.3,
		speed = 76,
		efficiency = 74,
	},
	{
		id = "s3b",
		label = "3B",
		potential = 71,
		dataNeed = 2.5e10,
		work = 900,
		vram = 64,
		serveCost = 0.8,
		speed = 64,
		efficiency = 62,
	},
	{ id="s7b", label="7B", potential=83, dataNeed=5e10, work=1600, vram=128, serveCost=1.25, speed=56, efficiency=52 },
} :: { SizeDef }

ModelConfig.FOCUSES = {
	{ id = "balanced", label = "Balanced", mult = {} },
	{
		id = "coding",
		label = "Coding",
		mult = { coding = 1.18, reasoning = 1.04, creativity = 0.88, knowledge = 0.94 },
	},
	{
		id = "reasoning",
		label = "Reasoning",
		mult = { reasoning = 1.16, math = 1.1, creativity = 0.9, coding = 0.96 },
	},
	{
		id = "creative",
		label = "Creative",
		mult = { creativity = 1.2, knowledge = 1.04, math = 0.86, coding = 0.88 },
	},
} :: { FocusDef }

-- weight = Anteil am Overall-Score. Speed/Efficiency zählen nicht ins Overall,
-- sie wirken über Markt (Speed) und Kosten (Efficiency = Spiegel der Inferenzkosten).
ModelConfig.STATS = {
	{ id = "reasoning", label = "Reasoning", weight = 0.22 },
	{ id = "coding", label = "Coding", weight = 0.17 },
	{ id = "math", label = "Math", weight = 0.14 },
	{ id = "creativity", label = "Creativity", weight = 0.14 },
	{ id = "knowledge", label = "Knowledge", weight = 0.17 },
	{ id = "reliability", label = "Reliability", weight = 0.16 },
	{ id = "speed", label = "Speed", weight = 0 },
	{ id = "efficiency", label = "Efficiency", weight = 0 },
} :: { StatDef }

-- Datenmix -&gt; Stat: base + Summe(Anteil des Datentyps * Faktor)
ModelConfig.AFFINITY = {
	reasoning = { base = 0.85, code = 0.35, math = 0.35 },
	coding = { base = 0.75, code = 0.9 },
	math = { base = 0.75, math = 0.9 },
	creativity = { base = 0.8, general = 0.4 },
	knowledge = { base = 0.8, general = 0.4 },
} :: { [string]: { [string]: number } }

-- Reliability hängt an der Datenqualität, nicht am Mix
ModelConfig.RELIABILITY = { base = 0.7, quality = 0.5 }

-- Datenwirkung: quantity = 1 - e^(-quantityK * Füllgrad), quality = qualityBase + qualityK * Q
-- Kern = potential * (floor + (1 - floor) * quantity * quality). Füllgrad ist bei maxFill gedeckelt:
-- mehr Masse bringt dann nichts mehr, schlechte Qualität zieht aber weiter runter.
ModelConfig.DATA = {
	quantityK = 1.6,
	qualityBase = 0.55,
	qualityK = 0.45,
	floor = 0.45,
	maxFill = 2,
}

ModelConfig.TRAINING = {
	minSeconds = 12,
	minTokens = 1e8, -- darunter kein Training
	eventAt = 0.35, -- ab diesem Fortschritt wird einmal ein Event gewürfelt
	eventChance = 0.6,
	decisionTimeout = 25, -- Sekunden, danach greift die Default-Wahl
	noise = 2.5, -- ± Streuung pro Stat
	lossStart = 4.2,
	lossPoints = 48, -- so viele Loss-Werte merkt sich der Graph
	logLines = 6,
}

-- Annotation statt Cast, damit die verschachtelten Choice-Tabellen korrekt typgeprüft werden
local EVENTS: { EventDef } = {
	{
		id = "data_issue",
		title = "DATA ISSUE DETECTED",
		text = "Duplicate shards found in the training set.",
		weight = 3,
		choices = {
			{ id = "clean", label = "Clean it", desc = "+20% remaining time, +15% cost", timeMult = 1.2, costFactor = 0.15 } :: ChoiceDef,
			{ id = "ignore", label = "Ignore", desc = "-6% model quality", quality = 0.94 } :: ChoiceDef,
		},
		default = "ignore",
	},
	{
		id = "instability",
		title = "TRAINING INSTABILITY",
		text = "Loss spike detected.",
		weight = 3,
		choices = {
			{ id = "rollback", label = "Roll back", desc = "+25% remaining time", timeMult = 1.25 } :: ChoiceDef,
			{ id = "push", label = "Push through", desc = "50% chance: -10% quality", quality = 0.9, gamble = 0.5 } :: ChoiceDef,
		},
		default = "rollback",
	},
	{ id = "gpu_failure", title = "GPU FAILURE", text = "A GPU crashed. Shard restarted.", weight = 2, timeMult = 1.15 },
	{
		id = "breakthrough",
		title = "BREAKTHROUGH",
		text = "Better learning-rate schedule found.",
		weight = 2,
		quality = 1.05,
	},
	{
		id = "optimization",
		title = "OPTIMIZATION FOUND",
		text = "Kernel fusion speeds up training.",
		weight = 2,
		timeMult = 0.8,
	},
}
ModelConfig.EVENTS = EVENTS

ModelConfig.RECIPES={
 {id="steady",label="Balanced",work=1,quality=1,desc="A measured run with stable validation. Standard time and cost."},
 {id="rapid",label="Quick pass",work=.65,quality=.9,desc="35% less compute; lower capability gain. Useful for an early prototype."},
 {id="deep",label="Deep training",work=2.4,quality=1.25,desc="2.4x compute. Higher gains with enough data; small or poor datasets can overfit."},
}
function ModelConfig.getRecipe(id: string): any
 for _,recipe in ModelConfig.RECIPES do if recipe.id==id then return recipe end end
 return nil
end
function ModelConfig.getSize(id: string): SizeDef?
	for _, size in ModelConfig.SIZES do
		if size.id == id then
			return size
		end
	end
	return nil
end

function ModelConfig.getFocus(id: string): FocusDef?
	for _, focus in ModelConfig.FOCUSES do
		if focus.id == id then
			return focus
		end
	end
	return nil
end

function ModelConfig.getEvent(id: string): EventDef?
	for _, event in ModelConfig.EVENTS do
		if event.id == id then
			return event
		end
	end
	return nil
end

function ModelConfig.getChoice(event: EventDef, choiceId: string): ChoiceDef?
	if not event.choices then
		return nil
	end
	for _, choice in event.choices do
		if choice.id == choiceId then
			return choice
		end
	end
	return nil
end

return ModelConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000003"><Properties><string name="Name">CampusAudioConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
