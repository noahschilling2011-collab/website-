local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local Math=require(Shared.ArenaMath)
local Format=require(Shared.Format)
local UI=script.Parent.Parent
local State=require(UI.Parent.Controllers.StateController)
local Action=require(UI.Parent.Controllers.ActionController)
local Theme=require(UI.Theme)
local Kit=require(UI.Kit)
local C,F=Theme.colors,Theme.font
local App={}
local refresh=function(_s: any)end
function App.mount(parent: Frame,nav: any)
	local scroll=Kit.scroll(parent);Kit.padding(scroll,2,14,24,2);Kit.list(scroll,16)
	Kit.heading(scroll,"Courier lab","Watch your model plan a route around obstacles. Better reasoning means fewer detours; reliable code improves its decisions.",1)
	local left,right=Kit.columns(scroll,.43,18,2)
	local config=Kit.card(left,1,12);Kit.caption(config,"Checkpoint under test",1)
	local name=Kit.text(config,"No trained model",21,F.bold,C.text);name.LayoutOrder=2
	local detail=Kit.para(config,"",13,C.muted,3)
	local controls=Kit.row(config,32,8,4)
	local previous=Kit.button(controls,"Previous","secondary",UDim2.fromOffset(100,30))
	local nextButton=Kit.button(controls,"Next model","secondary",UDim2.fromOffset(110,30));nextButton.LayoutOrder=2
	local index=1;local ids={}
	local start=Kit.button(config,"RUN COURIER TEST","primary",UDim2.new(1,0,0,42));start.LayoutOrder=5
	Kit.onClick(previous,function() index=math.max(1,index-1);if State.snapshot then refresh(State.snapshot) end end)
	Kit.onClick(nextButton,function() index=math.min(#ids,index+1);if State.snapshot then refresh(State.snapshot) end end)
	Kit.onClick(start,function() if ids[index] then Action.call("RunArena",{modelId=ids[index]}) end end)
	local progress=Kit.bar(config,6,6)
	local running=Kit.para(config,"",13,C.dim,7)
	Kit.para(config,"The physical course is at Courier Lab, west of the founder district. Run a test here, then walk over to watch your robot. Tests award a record, never farmable cash.",13,C.dim,8)
	local historyCard=Kit.card(left,2,8);Kit.caption(historyCard,"Recent tests",1)
	local histories={};for i=1,6 do histories[i]=Kit.para(historyCard,"",13,C.muted,i+1) end
	local mapCard=Kit.card(right,1,12);Kit.caption(mapCard,"Route planner / nine by seven",1)
	local map=Kit.frame(mapCard,UDim2.new(1,0,0,230));map.LayoutOrder=2
	local cells={}
	for x=1,Math.WIDTH do for z=1,Math.HEIGHT do
		local cell=Kit.frame(map,UDim2.new(1/9,-4,1/7,-4),UDim2.new((x-1)/9,2,(z-1)/7,2));cell.BackgroundTransparency=0;Kit.corner(cell,3)
		local label=Kit.text(cell,"",11,F.medium,C.text);label.AnchorPoint=Vector2.new(.5,.5);label.Position=UDim2.fromScale(.5,.5)
		cells[tostring(x)..":"..tostring(z)]={frame=cell,label=label,x=x,z=z}
	end end
	local routeInfo=Kit.para(mapCard,"",13,C.dim,3)
	local rivalsCard=Kit.card(right,2,10);Kit.caption(rivalsCard,"Rival companies / live activity",1)
	local activities={};for i=1,5 do activities[i]=Kit.para(rivalsCard,"",13,C.muted,i+1) end
	refresh=function(s: any)
		ids={};for _,id in s.data.modelOrder do local m=s.data.models[id];if m and (m.status=="trained" or m.status=="live") then table.insert(ids,id) end end
		index=math.clamp(index,1,math.max(1,#ids));local m=s.data.models[ids[index]]
		local info=s.live.arena or {};local active=info.active
		name.Text=if m then m.name.." v"..tostring(m.version) else "Train a model first"
		detail.Text=if m then string.format("Reasoning %.1f · Coding %.1f · Reliability %.1f",m.stats.reasoning or 0,m.stats.coding or 0,m.stats.reliability or 0) else "Your own checkpoint is required for a ranked test."
		Kit.setDisabled(start,not m or active~=nil)
		progress.set(if active then active.progress else 0)
		running.Text=if active then "Lane "..tostring(active.lane).." · "..Format.percent(active.progress).." · competing with "..active.opponent else "Best arena record: "..tostring(s.data.empire.arenaBest).." points"
		local plan=if m then Math.route(m.stats,#s.data.empire.arenaHistory+1) else nil
		local route={};if plan then for i,p in plan.path do route[tostring(p.x)..":"..tostring(p.z)]=i end end
		for key,c in cells do
			c.frame.BackgroundColor3=if Math.blocked(c.x,c.z) then C.raised elseif route[key] then Theme.accent:Lerp(C.bg,.4) else C.panel
			c.label.Text=if c.x==1 and c.z==4 then "IN" elseif c.x==9 and c.z==4 then "OUT" elseif route[key] then tostring(route[key]) else ""
		end
		routeInfo.Text=if plan then string.format("%d moves · %.1fs estimate · %d detours · %d expected points",plan.moves,plan.seconds,plan.detours,plan.score) else "Select a trained model to inspect its route."
		for i,l in histories do local h=s.data.empire.arenaHistory[i];l.Visible=h~=nil;if h then l.Text=h.name.." · "..tostring(h.score).." pts · "..tostring(h.moves).." moves · "..(if h.winner then "Beat " else "Behind ")..h.opponent end end
		for i,l in activities do local a=info.rivals and info.rivals[i];l.Visible=a~=nil;if a then l.Text=a.company.." / "..a.text end end
	end
	State.onChange(function(s) if parent.Visible and nav.isOpen() then refresh(s) end end)
end
function App.onShow() if State.snapshot then refresh(State.snapshot) end end
return App
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000042"><Properties><string name="Name">EmpireApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Company OS: reactive cards are built on tab changes, updated in place on snapshots.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config.EmpireConfig)
local Math = require(Shared.EmpireMath)
local Format = require(Shared.Format)
local UI = script.Parent.Parent
local Client = UI.Parent
local State = require(Client.Controllers.StateController)
local Action = require(Client.Controllers.ActionController)
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Toast = require(UI.Toast)
local C, F = Theme.colors, Theme.font
local App = {}
local page: Frame? = nil
local scroll: ScrollingFrame? = nil
local current = "overview"
local updaters: { (any) -&gt; () } = {}
local nav: any = nil
local function watch(fn: (any) -&gt; ())
	table.insert(updaters, fn)
	if State.snapshot then fn(State.snapshot) end
end
local function button(parent: Instance, label: string, callback: () -&gt; ())
	local b = Kit.button(parent, label, "primary", UDim2.new(1,0,0,40))
	b.LayoutOrder = 9
	Kit.onClick(b, callback)
	return b
end
local function call(name: string, payload: any, message: string)
	task.spawn(function()
		local ok = Action.call(name, payload)
		if ok then Toast.show("success", message) end
	end)
end
local function para(parent: Instance, text: string, order: number?)
	return Kit.para(parent, text, 14, C.muted, order or 2)
end
local function title(parent: Instance, text: string)
	local t = Kit.para(parent, text, 18, C.text, 1)
	t.Font = F.bold
	return t
end
local function metric(parent: Instance, label: string, value: (any) -&gt; string, order: number)
	local card = Kit.card(parent, order)
	Kit.caption(card, label, 1)
	local t = Kit.para(card, "", 23, C.text, 2)
	t.Font = F.bold
	watch(function(s) t.Text = value(s) end)
	return card
end
local function profitChart(parent: Instance, order: number)
	local card=Kit.card(parent,order)
	title(card,"How the business is doing")
	local caption=para(card,"",2)
	local graph=Kit.frame(card,UDim2.new(1,0,0,130))
	graph.LayoutOrder=3
	local positive=Kit.text(graph,"",11,F.medium,C.dim)
	positive.Position=UDim2.new(0,0,0,0)
	local negative=Kit.text(graph,"",11,F.medium,C.dim)
	negative.Position=UDim2.new(0,0,1,-15)
	local plot=Kit.frame(graph,UDim2.new(1,0,1,-34),UDim2.fromOffset(0,17))
	for i=0,3 do
		local line=Kit.frame(plot,UDim2.new(1,0,0,1),UDim2.fromScale(0,i/3))
		line.BackgroundColor3=C.line
		line.BackgroundTransparency=0.96
	end
	local baseline=Kit.frame(plot,UDim2.new(1,0,0,1))
	baseline.BackgroundColor3=C.dim
	baseline.BackgroundTransparency=0.4
	local bars={}
	for i=1,36 do
		local b=Kit.frame(plot)
		Kit.corner(b,2)
		bars[i]=b
	end
	watch(function(s)
		local history=s.data.empire.history
		local min,max=0,1
		for _,sample in history do min=math.min(min,sample.profit);max=math.max(max,sample.profit) end
		local range=max-min
		local zero=1-(0-min)/range
		baseline.Position=UDim2.fromScale(0,zero)
		positive.Text=Format.money(max).." / min"
		negative.Text=Format.money(min).." / min"
		caption.Text=if #history==0 then "The first sample appears after 10 seconds. Staff wages are included." else "Actual net profit · one sample every 10 seconds · staff wages included"
		for i,b in bars do
			local sample=history[i]
			b.Visible=sample~=nil
			if sample then
				b.AnchorPoint=Vector2.new(0,if sample.profit&gt;=0 then 1 else 0)
				b.Position=UDim2.fromScale((i-1)/36,zero)
				b.Size=UDim2.fromScale(0.021,math.abs(sample.profit)/range)
				b.BackgroundColor3=if sample.profit&gt;=0 then C.good else C.bad
				b.BackgroundTransparency=0.15
			end
		end
	end)
end
local function overview(parent: Instance)
	local hero = Kit.card(parent, 1)
	local headline = title(hero, "Your next chapter")
	local text = para(hero, "", 2)
	watch(function(s)
		local e = s.data.empire
		headline.Text = Config.OFFICES[e.office].name .. "  /  Level " .. tostring(1 + math.floor(e.xp / 250))
		local b = Math.bonuses(e)
		text.Text = string.format("%d/%d employees  ·  %.0f research points  ·  %.0f XP\nTraining +%.0f%%  ·  Revenue +%.0f%%  ·  Wages $%.2f/s",
			Math.staff(e), Config.OFFICES[e.office].staff, e.points, e.xp, (b.speed-1)*100, (b.revenue-1)*100, b.wage)
	end)
	local start = Kit.row(hero, 40, 8, 3)
	for _, def in {{"Lab","lab"},{"Data","data"},{"Market","market"}} do
		local b = Kit.button(start, def[1], "secondary", UDim2.new(1/3,-6,1,0))
		Kit.onClick(b, function() nav.show(def[2]) end)
	end
	local metrics = Kit.grid(parent, 3, 96, 10, 2)
	metric(metrics, "Cash available", function(s) return Format.money(s.data.money) end, 1)
	metric(metrics, "Profit / minute", function(s) return Format.money((s.live.revenue-s.live.cost)*60) end, 2)
	metric(metrics, "Active users", function(s) return Format.compact(s.live.users) end, 3)
	profitChart(parent,3)
	local cycle = Kit.card(parent, 4)
	local cycleTitle = title(cycle, "Market cycle")
	local cycleText = para(cycle, "")
	watch(function(s)
		local def, left = Config.cycle(s.serverTime)
		cycleTitle.Text = def.name
		cycleText.Text = def.desc .. "  Next cycle in " .. tostring(math.ceil(left)) .. "s."
	end)
	local daily = Kit.card(parent, 5)
	title(daily, "Daily founder grant")
	local dailyText = para(daily, "")
	local claim = button(daily, "Claim daily grant", function() call("ClaimDaily", {}, "Daily grant collected! +15 research points") end)
	watch(function(s)
		local e = s.data.empire
		local day = math.floor(s.serverTime/86400)
		local done = e.daily.day &gt;= day
		local nextStreak = if e.daily.day == day-1 then math.min(7,e.daily.streak+1) else 1
		dailyText.Text = if done then "Collected today. Streak: " .. tostring(e.daily.streak) .. ". Resets at 00:00 UTC."
			else "Today's grant: " .. Format.money(1000+(nextStreak-1)*500) .. " + 15 research points. Consecutive days increase the grant."
		Kit.setDisabled(claim, done)
		claim.Text = if done then "Come back tomorrow" else "Claim founder grant"
	end)
	local goal = Kit.card(parent, 6)
	title(goal, "A business with a plan")
	para(goal, "1. Buy data and train a model in Lab.\n2. Launch it at a competitive price.\n3. Deliver client contracts and collect milestones.\n4. Hire a team, research upgrades and expand your office.\n5. Build a frontier model and climb the server board.")
end
local function team(parent: Instance)
	local intro = Kit.card(parent, 1)
	title(intro, "Specialists, real advantages")
	local capacity = para(intro, "")
	watch(function(s)
		local e = s.data.empire
		capacity.Text = string.format("%d / %d desks filled. Staff earn wages every second while you play. Bonuses stop when you dismiss an employee. Hiring fees are non-refundable.",Math.staff(e),Config.OFFICES[e.office].staff)
	end)
	for i, role in Config.ROLES do
		local card = Kit.card(parent, i+1)
		title(card, role.name)
		para(card, role.desc)
		local info = para(card, "", 3)
		local row = Kit.row(card,40,10,4)
		local hire = Kit.button(row,"Hire","primary",UDim2.new(0.4,-6,1,0))
		local group = Kit.button(row,"Hire 5","secondary",UDim2.new(0.35,-6,1,0))
		local fire = Kit.button(row,"Dismiss one","secondary",UDim2.new(0.25,-6,1,0))
		Kit.onClick(hire,function() call("HireEmployee",{roleId=role.id},role.name .. " hired!") end)
		Kit.onClick(group,function()call("HireEmployee",{roleId=role.id,count=5},"Five specialists hired!")end)
		Kit.onClick(fire,function() call("FireEmployee",{roleId=role.id},"Employee dismissed.") end)
		watch(function(s)
			local e=s.data.empire
			local count=e.employees[role.id] or 0
			local price=Math.hireCost(e,role)
			info.Text=string.format("On your team: %d  ·  Wage: $%.2f/s each",count,role.wage)
			hire.Text="Hire · " .. Format.money(price)
			Kit.setDisabled(hire,Math.staff(e)&gt;=Config.OFFICES[e.office].staff or s.data.money&lt;price)
			local groupCost=0
			for j=0,4 do groupCost+=Math.hireCost({employees={[role.id]=count+j}},role) end
			group.Text="Hire 5 · "..Format.money(groupCost)
			Kit.setDisabled(group,Math.staff(e)+5&gt;Config.OFFICES[e.office].staff or s.data.money&lt;groupCost)
			Kit.setDisabled(fire,count==0)
		end)
	end
end
local function research(parent: Instance)
	local active=Kit.card(parent,1)
	title(active,"The research lab")
	local info=para(active,"")
	local bar=Kit.bar(active,8,3)
	watch(function(s)
		local e=s.data.empire
		local job=e.researchJob
		local b=Math.bonuses(e)
		info.Text=string.format("%.0f RP available · +%.2f RP/s\n",e.points,b.points*(if s.data.company.spec=="research" then 1.2 else 1)) ..
			(if job then "Researching " .. Config.find(Config.RESEARCH,job.id).name .. " · " .. tostring(math.ceil(job.seconds-job.elapsed)) .. "s left" else "Pick your next breakthrough. Research continues while you are online.")
		bar.frame.Visible=job~=nil
		if job then bar.set(job.elapsed/job.seconds) end
	end)
	for i,def in Config.RESEARCH do
		local card=Kit.card(parent,i+1)
		title(card,def.name)
		para(card,def.desc)
		local info=para(card,"",3)
		local b=button(card,"Research",function() call("StartResearch",{researchId=def.id},"Research started: " .. def.name) end)
		watch(function(s)
			local e=s.data.empire
			local locked=def.prereq and not e.research[def.prereq]
			local done=e.research[def.id]==true
			info.Text=string.format("%s · %d RP · %ds",Format.money(def.cost),def.points,def.seconds) ..
				(if locked then "\nRequires: " .. Config.find(Config.RESEARCH,def.prereq).name else "")
			b.Text=if done then "Completed" elseif e.researchJob and e.researchJob.id==def.id then "Researching..." elseif locked then "Locked" else "Start research"
			Kit.setDisabled(b,done or locked==true or e.researchJob~=nil or e.points&lt;def.points or s.data.money&lt;def.cost)
		end)
	end
end
local function contracts(parent: Instance)
	local help=Kit.card(parent,1)
	title(help,"Monthly business customers")
	para(help,"Companies and game studios choose between live player models by skill, monthly price and GPU capacity. Win ongoing subscriptions in Market. Below are additional pilot projects, each rewarded once per UTC day.")
	local customerCard=Kit.card(parent,2)
	title(customerCard,"Your recurring contracts")
	local customerInfo=para(customerCard,"")
	button(customerCard,"Open provider exchange",function() if nav then nav.show("market") end end)
	watch(function(s)
		local lines={"Business MRR: "..Format.money((s.data.empire.businessRevenue or 0)*3600)}
		for _,c in s.data.empire.customers do table.insert(lines,c.name.." · "..Format.money(c.price).."/month · "..Format.duration(c.remaining).." to renewal") end
		if #s.data.empire.customers==0 then table.insert(lines,"No recurring customers yet. Publish a suitable model and add GPU capacity.") end
		customerInfo.Text=table.concat(lines,"\n")
	end)
	for i,def in Config.CONTRACTS do
		local selected: string?=nil
		local card=Kit.card(parent,i+2)
		title(card,def.name .. " · " .. Format.money(def.reward))
		para(card,def.task)
		para(card,string.format("Requires %s ≥ %d%s · %s",def.stat,def.minimum,if def.focus then " · " .. def.focus .. " focus" else "",Config.OFFICES[def.office].name),3)
		local b=button(card,"No eligible live model",function()
			if selected then call("DeliverContract",{contractId=def.id,modelId=selected},"Contract delivered!") end
		end)
		watch(function(s)
			selected=nil
			local best:any=nil
			for _,id in s.data.modelOrder do
				local model=s.data.models[id]
				if model and Math.eligible(model,def) and (not best or model.overall&gt;best.overall) then best=model end
			end
			if best then selected=best.id end
			local done=s.data.empire.contracts[def.id]==math.floor(s.serverTime/86400)
			local locked=s.data.empire.office&lt;def.office
			b.Text=if done then "Delivered today" elseif locked then "Upgrade office first" elseif best then "Deliver: " .. best.name else "No eligible live model"
			Kit.setDisabled(b,done or locked or best==nil)
		end)
	end
end
local function milestones(parent: Instance)
	for i,def in Config.QUESTS do
		local card=Kit.card(parent,i)
		title(card,def.name)
		para(card,def.desc .. "  Reward: " .. Format.money(def.reward) .. " + " .. tostring(def.xp) .. " XP")
		local bar=Kit.bar(card,7,3)
		local b=button(card,"In progress",function() call("ClaimQuest",{questId=def.id},"Milestone reward collected!") end)
		watch(function(s)
			local p=Math.progress(s.data,def)
			local done=s.data.empire.quests[def.id]==true
			bar.set(math.min(1,p/def.target))
			b.Text=if done then "Collected" elseif p&gt;=def.target then "Collect " .. Format.money(def.reward) else Format.compact(p) .. " / " .. Format.compact(def.target)
			Kit.setDisabled(b,done or p&lt;def.target)
		end)
	end
end
local function office(parent: Instance)
	local card=Kit.card(parent,1)
	local name=title(card,"Office")
	local info=para(card,"")
	local b=button(card,"Upgrade",function() call("UpgradeOffice",{},"Office expanded. Visit your new building!") end)
	watch(function(s)
		local e=s.data.empire
		local def=Config.OFFICES[e.office]
		local nextOffice=Config.OFFICES[e.office+1]
		name.Text=def.name
		info.Text=string.format("Tier %d / 4 · %d staff desks · %.2f base RP/s\nThree to seven floors, 24 campus operations staff, stores, kitchen and underground parking.",e.office,def.staff,def.points)
		b.Text=if nextOffice then "Upgrade: " .. nextOffice.name .. " · " .. Format.money(nextOffice.price) else "Maximum office reached"
		Kit.setDisabled(b,nextOffice==nil or (nextOffice~=nil and s.data.money&lt;nextOffice.price))
	end)
	for i,def in Config.OFFICES do
		local row=Kit.card(parent,i+1)
		title(row,tostring(i) .. " · " .. def.name)
		para(row,string.format("%d employee desks · %.2f research points/s · %s",def.staff,def.points,if i==1 then "Starter office" else Format.money(def.price)))
	end
end
local function board(parent: Instance)
	local head=Kit.card(parent,1)
	title(head,"Company rankings")
	local status=para(head,"Global rankings load in a published game with saving enabled.")
	local mode="overall"
	local selector=Kit.segmented(head,{{id="overall",label="Overall"},{id="coding",label="Coding"},{id="math",label="Math"},{id="reasoning",label="Reasoning"},{id="creativity",label="Creative"},{id="arena",label="Arena"}},mode,function(id) mode=id;if State.snapshot then for _,fn in updaters do fn(State.snapshot) end end end)
	selector.frame.LayoutOrder=3
	watch(function(s) status.Text=if s.live.rankings then s.live.rankings.status.." · best self-trained records, refreshed every three minutes" else "Server preview · strongest self-trained AI" end)
	for i=1,10 do
		local row=Kit.card(parent,i+1)
		local name=title(row,"");local stats=para(row,"")
		watch(function(s)
			local ranking=s.live.rankings
			local entry=if ranking then ranking.boards[mode] and ranking.boards[mode][i] else s.live.empire and s.live.empire.board[i]
			row.Visible=entry~=nil
			if entry then name.Text=tostring(i)..". "..entry.name;stats.Text=string.format("%.1f %s points",entry.score or entry.best,mode) end
		end)
	end
end
local builders={overview=overview,team=team,research=research,contracts=contracts,milestones=milestones,office=office,board=board}
local function render()
	local container=scroll
	if not container then return end
	updaters={}
	for _,child in container:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local stack=Kit.stack(container,12)
	Kit.padding(stack,0,8,24,0)
	builders[current](stack)
	container.CanvasPosition=Vector2.zero
end
function App.mount(parent: Frame, navigation: any)
	nav=navigation
	page=parent
	local head=Kit.frame(parent,UDim2.new(1,0,0,38))
	local label=Kit.text(head,"Company",24,F.display,C.text)
	label.Position=UDim2.fromOffset(0,2)
	local tabs=Instance.new("ScrollingFrame")
	tabs.BackgroundTransparency=1
	tabs.BorderSizePixel=0
	tabs.Size=UDim2.new(1,0,0,46)
	tabs.Position=UDim2.fromOffset(0,42)
	tabs.CanvasSize=UDim2.new()
	tabs.AutomaticCanvasSize=Enum.AutomaticSize.X
	tabs.ScrollingDirection=Enum.ScrollingDirection.X
	tabs.ScrollBarThickness=2
	tabs.Parent=parent
	Kit.list(tabs,7,true)
	local buttons={}
	for i,def in {{"overview","Overview"},{"team","Team"},{"research","Research"},{"contracts","Contracts"},{"milestones","Goals"},{"office","Office"},{"board","Board"}} do
		local b=Kit.button(tabs,def[2],"secondary",UDim2.fromOffset(100,36))
		b.LayoutOrder=i
		buttons[def[1]]=b
		Kit.onClick(b,function()
			current=def[1]
			for id,btn in buttons do btn.BackgroundColor3=if id==current then Theme.accent:Lerp(C.panel,0.6) else C.raised end
			render()
		end)
	end
	scroll=Kit.scroll(parent,UDim2.new(1,0,1,-100),UDim2.fromOffset(0,100))
	State.onChange(function(s)
		if not s.data.company then return end
		if #updaters==0 then render() end
		for _,fn in updaters do fn(s) end
	end)
	State.onNotify(function(kind,payload)
		if kind=="EMPIRE_NOTICE" and typeof(payload.text)=="string" then Toast.show("success",payload.text,5) end
	end)
end
function App.onShow()
	if #updaters==0 and State.snapshot and State.snapshot.data.company then render() end
end
function App.openSection(section: string)
 if builders[section] then current=section;render() end
end
return App
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000050"><Properties><string name="Name">Screens</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">Computer</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Der Computer im Büro: ein Fenster mit Sidebar (Lab, Data, Compute, Market).
-- Öffnet über den Laptop-Prompt, den COMPUTER-Button im HUD oder die Taste C.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local Types = require(ReplicatedStorage.Shared.Types)
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local HardwareConfig = require(ReplicatedStorage.Shared.Config.HardwareConfig)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local LabApp = require(UI.Apps.LabApp)
local DataApp = require(UI.Apps.DataApp)
local ComputeApp = require(UI.Apps.ComputeApp)
local MarketApp = require(UI.Apps.MarketApp)
local StudioApp=require(UI.Apps.StudioApp)
local ArenaApp=require(UI.Apps.ArenaApp)
local CampusApp=require(UI.Apps.CampusApp)
local EmpireApp = require(UI.Apps.EmpireApp)

local C = Theme.colors
local F = Theme.font

type AppModule = { mount: (Frame, Kit.Nav) -&gt; (), onShow: () -&gt; () }
type Entry = { id: string, app: AppModule, container: Frame, status: TextLabel, paint: () -&gt; () }

local APPS: { { id: string, label: string, app: AppModule } } = {
	{ id = "empire", label = "Company", app = EmpireApp },
	{ id = "lab", label = "Models", app = LabApp },
	{ id = "data", label = "Datasets", app = DataApp },
	{ id = "compute", label = "Hardware", app = ComputeApp },
	{ id = "market", label = "Market", app = MarketApp },
	{ id = "studio", label = "Projects", app = StudioApp },
	{ id = "arena", label = "Test arena", app = ArenaApp },
	{ id = "campus", label = "Campus", app = CampusApp },
}

local SIDEBAR = 196
local HEADER = 64
local FLOW = 66

local Computer = {}

local root: Frame? = nil
local dim: TextButton? = nil
local windowScale: UIScale? = nil
local blur: BlurEffect? = nil
local entries: { Entry } = {}
local current = "empire"
local opened = false
local moneyLabel: TextLabel? = nil

local function entryOf(id: string): Entry?
	for _, entry in entries do
		if entry.id == id then
			return entry
		end
	end
	return nil
end

function Computer.isOpen(): boolean
	return opened
end

function Computer.show(appId: string)
	local target = entryOf(appId)
	if not target then
		return
	end
	local switched = current ~= appId
	current = appId
	for _, entry in entries do
		entry.container.Visible = entry.id == appId
		entry.paint()
	end
	if switched then
		-- kurze Antwort auf den Klick: neue App gleitet 10 px nach oben ein
		target.container.Position = UDim2.fromOffset(0, 10)
		Kit.tween(target.container, 0.25, { Position = UDim2.new() })
	end
	target.app.onShow()
end

function Computer.open(appId: string?,section: string?)
	local frame, shade, scale, effect = root, dim, windowScale, blur
	if not frame or not shade or not scale or not effect then
		return
	end
	if not opened then
		opened = true
		frame.Visible = true
		shade.Visible = true
		shade.BackgroundTransparency = 1
		Kit.tween(shade, 0.25, { BackgroundTransparency = 0.32 })
		scale.Scale = 0.96
		Kit.tween(scale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.tween(effect, 0.3, { Size = 8 })
	end
	Computer.show(appId or current)
 if section then local target=entryOf(appId or current);if target then local app=target.app :: any;if app.openSection then app.openSection(section) end end end
end

function Computer.close()
	local frame, shade, effect = root, dim, blur
	if not opened or not frame or not shade or not effect then
		return
	end
	opened = false
	Kit.tween(shade, 0.18, { BackgroundTransparency = 1 })
	Kit.tween(effect, 0.18, { Size = 0 })
	task.delay(0.18, function()
		if not opened then
			frame.Visible = false
			shade.Visible = false
		end
	end)
end

function Computer.toggle()
	if opened then
		Computer.close()
	else
		Computer.open()
	end
end

local function statusFor(id: string, snapshot: Types.Snapshot): (string, Color3)
	local data = snapshot.data
	if id == "empire" then
		return "Team · Research · Goals", C.dim
	elseif id == "lab" then
		local training = data.training
		if training then
			if training.event and training.event.pending then
				return "Decision needed", C.warn
			end
			return "Training " .. Format.percent(training.workDone / training.workTotal), Theme.accent
		end
		local ready = 0
		for _, model in data.models do
			if model.status == "trained" then
				ready += 1
			end
		end
		if ready &gt; 0 then
			return `{ready} ready to launch`, C.good
		end
		return "Design and train", C.dim
	elseif id == "data" then
		return Format.tokens(ModelMath.dataSummary(data.data).total) .. " tokens", C.dim
	elseif id == "compute" then
		local fleet = ModelMath.fleet(data.gpus)
		return `{fleet.slotsUsed} of {HardwareConfig.slots(data.empire)} compute slots`, C.dim
	end
	if id=="campus" then return "Cards · Fleet · Stores",C.dim end
	if id=="studio" then return tostring(#data.empire.projectOrder).." projects",C.dim end
	if id=="arena" then return tostring(data.empire.arenaBest).." best points",C.dim end
	local live = 0
	for _, model in data.models do
		if model.status == "live" then
			live += 1
		end
	end
	if live == 0 then
		return "Nothing live yet", C.dim
	end
	return `{Format.compact(snapshot.live.users)} users`, C.good
end

local function headerStatus(snapshot: Types.Snapshot): (string, Color3)
	local data = snapshot.data
	local training = data.training
	if training then
		if training.event and training.event.pending then
			return "Training paused: decision needed", C.warn
		end
		return "Training " .. Format.percent(training.workDone / training.workTotal), Theme.accent
	end
	local live = 0
	for _, model in data.models do
		if model.status == "live" then
			live += 1
		end
	end
	if live &gt; 0 then
		return `{live} model{if live == 1 then "" else "s"} live`, C.good
	end
	return "No model live yet", C.dim
end

local function buildNavButton(sidebar: Frame, index: number, id: string, label: string): (TextLabel, () -&gt; ())
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Text = ""
	button.Size = UDim2.new(1, 0, 0, 58)
	button.LayoutOrder = index
	button.BackgroundColor3 = C.raised
	button.BackgroundTransparency = 1
	button.Parent = sidebar
	Kit.corner(button, 12)

	-- Akzent-Strich = aktuelle Auswahl
	local bar = Kit.frame(button, UDim2.new(0, 3, 0, 24), UDim2.new(0, 0, 0.5, -12))
	bar.BackgroundTransparency = 0
	Theme.bindAccent(bar, "BackgroundColor3")
	Kit.corner(bar, 2)

	local icon = Kit.icon(button, id, 18)
	icon.frame.AnchorPoint = Vector2.new(0, 0.5)
	icon.frame.Position = UDim2.new(0, 16, 0.5, 0)
	local title = Kit.text(button, label, 16, F.bold, C.text)
	title.Position = UDim2.fromOffset(48, 10)
	local status = Kit.text(button, "", 12, F.medium, C.dim)
	status.Position = UDim2.fromOffset(48, 32)
	status.Size = UDim2.new(1, -54, 0, 16)
	status.AutomaticSize = Enum.AutomaticSize.None
	status.TextTruncate = Enum.TextTruncate.AtEnd

	local function paint()
		local selected = current == id
		button.BackgroundTransparency = if selected then 0 else 1
		bar.Visible = selected
		title.TextColor3 = if selected then C.text else C.muted
		icon.setColor(if selected then Theme.accent else C.dim)
	end
	Theme.onAccent(function()
		paint()
	end)
	Kit.onClick(button, function()
		Computer.show(id)
	end)
	paint()
	return status, paint
end

function Computer.mount(parent: Frame, dimLayer: Frame)
	local frame = Kit.frame(parent)
	frame.Name = "Computer"
	frame.Visible = false
	frame.ZIndex = 10
	root = frame

	-- Abdunkeln liegt in einer randlosen Ebene (deckt auch den Topbar-Streifen ab) und schluckt Klicks
	local shade = Kit.blocker(dimLayer, C.black, 1)
	shade.Visible = false
	dim = shade

	local effect = Instance.new("BlurEffect")
	effect.Name = "AIEmpireBlur"
	effect.Size = 0
	effect.Parent = Lighting -- vom Client erstellt = existiert nur bei diesem Spieler
	blur = effect

	local window = Kit.panel(frame, UDim2.new(1, -40, 1, -28), UDim2.fromScale(0.5, 0.5))
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.ZIndex = 11
	window.BackgroundColor3 = C.bg
	window.BackgroundTransparency = 0.03
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(1180, 740)
	constraint.Parent = window
	local scale = Instance.new("UIScale")
	scale.Parent = window
	windowScale = scale

	-- Kopfzeile: Firma + Live-Status links, Geld + Schließen rechts
	local header = Kit.frame(window, UDim2.new(1, 0, 0, HEADER))
	local logoBox = Kit.frame(header, UDim2.fromOffset(38, 38), UDim2.new(0, 18, 0.5, -19))
	logoBox.BackgroundTransparency = 0.72
	Theme.bindAccent(logoBox, "BackgroundColor3")
	Kit.corner(logoBox, 10)
	local logo = Kit.text(logoBox, "", 20, F.regular)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.fromScale(0.5, 0.5)
	local title = Kit.text(header, "AI Empire", 16, F.bold, C.text)
	title.Position = UDim2.fromOffset(68, 13)
	local status = Kit.text(header, "", 13, F.medium, C.dim)
	status.Position = UDim2.fromOffset(68, 34)
	local money = Kit.text(header, "$0", 18, F.display, C.text)
	money.AnchorPoint = Vector2.new(1, 0.5)
	money.Position = UDim2.new(1, -72, 0.5, 0)
	moneyLabel = money
	local close = Kit.button(header, "×", "ghost", UDim2.fromOffset(40, 40))
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.new(1, -16, 0.5, 0)
	Kit.onClick(close, Computer.close)
	local headerLine = Kit.divider(header)
	headerLine.Position = UDim2.new(0, 0, 1, -1)

	-- Sidebar
	local sidebar = Kit.frame(window, UDim2.new(0, SIDEBAR, 1, -HEADER), UDim2.fromOffset(0, HEADER))
	Kit.padding(sidebar, 14, 10, 14, 12)
	Kit.list(sidebar, 4)
	local sidebarScale = Instance.new("UIScale")
	sidebarScale.Parent = sidebar
	local function fitSidebar()
		sidebarScale.Scale = math.min(1, math.max(0.6, (window.AbsoluteSize.Y - HEADER - 24) / 512))
	end
	window:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitSidebar)
	fitSidebar()
	local sideLine = Kit.frame(window, UDim2.new(0, 1, 1, -HEADER), UDim2.fromOffset(SIDEBAR, HEADER))
	sideLine.BackgroundTransparency = 0.93
	sideLine.BackgroundColor3 = C.line

	-- The seven physical departments use the same permanent flow in Company OS.
 local flow=Kit.frame(window,UDim2.new(1,-SIDEBAR-1,0,FLOW),UDim2.fromOffset(SIDEBAR+1,HEADER));flow.Name="AIJourney"
 local labels={};local buttons={}
 for i,def in Journey.STEPS do
  local b=Kit.button(flow,def.label,"ghost",UDim2.new(1/7,-4,0,28));b.Position=UDim2.new((i-1)/7,2,0,4);b.TextSize=12;b.Name="Journey_"..def.id;buttons[i]=b
  Kit.onClick(b,function()Computer.open(def.app,def.section)end)
 end
 local hint=Kit.text(flow,"",12,F.medium,C.dim);hint.Position=UDim2.fromOffset(12,38);hint.Size=UDim2.new(1,-24,0,20);hint.AutomaticSize=Enum.AutomaticSize.None;hint.TextTruncate=Enum.TextTruncate.AtEnd
 local function paintFlow()
  local snapshot=StateController.snapshot;if not snapshot then return end
  local progress=Journey.progress(snapshot.data,StateController.ui)
  for i,b in buttons do b.Text=(if progress.done[i] then "✓ " else "")..Journey.STEPS[i].label;b.BackgroundColor3=if i==progress.index then Theme.accent:Lerp(C.panel,.72) else C.panel;b.TextColor3=if progress.done[i] then C.good elseif i==progress.index then C.text else C.dim end
  hint.Text=progress.hint;hint.TextColor3=if progress.missingVram&gt;0 then C.warn else C.dim
 end
 StateController.onChange(paintFlow);StateController.onUiChange(paintFlow)
 -- Inhalt
 local content = Kit.frame(window, UDim2.new(1, -SIDEBAR - 1, 1, -HEADER-FLOW), UDim2.fromOffset(SIDEBAR + 1, HEADER+FLOW))
	content.ClipsDescendants = true
	Kit.padding(content, 20, 20, 0, 24)

	local nav: Kit.Nav = {
		show = function(appId: string)
			Computer.open(appId)
		end,
		close = Computer.close,
		isOpen = Computer.isOpen,
	}

	for index, def in APPS do
		local container = Kit.frame(content)
		container.Name = def.id
		container.Visible = false
		local statusLabel, paint = buildNavButton(sidebar, index, def.id, def.label)
		table.insert(entries, {
			id = def.id,
			app = def.app,
			container = container,
			status = statusLabel,
			paint = paint,
		})
		def.app.mount(container, nav)
	end

	StateController.onChange(function(snapshot)
		for _, entry in entries do
			local text, color = statusFor(entry.id, snapshot)
			entry.status.Text = text
			entry.status.TextColor3 = color
		end
		local company = snapshot.data.company
		title.Text = if company then company.name else "AI Empire"
		logo.Text = if company then company.logo else ""
		local text, color = headerStatus(snapshot)
		status.Text = text
		status.TextColor3 = color
	end)

	RunService.RenderStepped:Connect(function()
		local label = moneyLabel
		if opened and label then
			local value = StateController.money()
			label.Text = Format.money(value)
			label.TextColor3 = if value &lt; 0 then C.bad else C.text
		end
	end)
end

return Computer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">HUD</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- HUD rechts oben (links oben gehört dem Roblox-Chat):
--   Glas-Panel (Firma, Geld, Nutzer, Reputation), Next-Step-Karte, COMPUTER-Button
-- Die Next-Step-Karte sagt immer, was als Nächstes sinnvoll ist, und öffnet per Klick die passende App.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local CompanyConfig = require(Shared.Config.CompanyConfig)
local MarketConfig = require(Shared.Config.MarketConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local Journey=require(Shared.JourneyMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)
local Computer = require(UI.Screens.Computer)
local LabApp = require(UI.Apps.LabApp)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot
type ModelData = Types.ModelData
type Step = { title: string, body: string, app: string, progress: boolean, releaseId: string?,section: string? }

local WIDTH = 300

local HUD = {}

local root: Frame? = nil

-- stärkstes NPC-Modell als Meilenstein
local function strongestRival(): (string, number)
	local name, best = "", 0
	for _, npc in MarketConfig.NPC_MODELS do
		local overall = ModelMath.overall(npc.stats)
		if overall &gt; best then
			best = overall
			name = `{npc.company} {npc.name}`
		end
	end
	return name, best
end

local function nextRankText(peak: number): string
	for _, rank in CompanyConfig.RANKS do
		if rank.minUsers &gt; peak then
			return `Reach {Format.compact(rank.minUsers)} peak users to become a {rank.name}.`
		end
	end
	return "You are at the top. Keep your models ahead of the rivals."
end

local function nextStep(snapshot: Snapshot): Step
 local journey=Journey.progress(snapshot.data,StateController.ui)
 if not journey.complete and not snapshot.data.training then
  return {title=string.format("%d / 7 · %s",journey.index,journey.step.title),body=journey.step.body,app=journey.step.app,section=journey.step.section,progress=false}
 end
	local data = snapshot.data
	local training = data.training
	if training then
		local event = training.event
		if event and event.pending then
			return {
				title = "Decision needed!",
				body = "Your training run hit a problem. Open the Lab and choose what to do.",
				app = "lab",
				progress = true,
			}
		end
		local model: ModelData? = data.models[training.modelId]
		return {
			title = if model then `Training {model.name} v{model.version}...` else "Training...",
			body = "Watch the loss drop. You'll see the benchmark when it's done.",
			app = "lab",
			progress = true,
		}
	end

	local trained, best = 0, 0
	local ready: ModelData? = nil
	for _, id in data.modelOrder do
		local model: ModelData? = data.models[id]
		if model and model.status ~= "training" then
			trained += 1
			best = math.max(best, model.overall)
			if model.status == "trained" and not ready then
				ready = model
			end
		end
	end

	if trained == 0 then
		if ModelMath.dataSummary(data.data).total &lt; 1e9 then
			return {
				title = "Collect training data",
				body = "Open Data: scrape the web for free or buy a data pack.",
				app = "data",
				progress = false,
			}
		end
		return {
			title = "Train your first model",
			body = "Open the Lab, pick 100M and start training.",
			app = "lab",
			progress = false,
		}
	end
	if ready then
		return {
			title = `Launch {ready.name} v{ready.version}`,
			body = "Set a price and release it to simulated customers.",
			app = "lab",
			progress = false,
			releaseId = ready.id,
		}
	end
	for _, quest in require(ReplicatedStorage.Shared.Config.EmpireConfig).QUESTS do
		if not data.empire.quests[quest.id] and require(ReplicatedStorage.Shared.EmpireMath).progress(data, quest) &gt;= quest.target then
			return {title="Milestone reward ready", body="Collect your reward in Company → Goals.", app="empire", progress=false}
		end
	end
	if trained &lt; 2 then
		return {
			title = "Build a stronger model",
			body = "Buy a GPU in Compute and more data, then train a 500M model.",
			app = "compute",
			progress = false,
		}
	end
	local rival, rivalScore = strongestRival()
	if best &lt; rivalScore then
		return {
			title = `Beat {rival}`,
			body = `Their flagship scores {string.format("%.1f", rivalScore)}. Your best: {string.format("%.1f", best)}.`,
			app = "lab",
			progress = false,
		}
	end
	return {
		title = "Grow your empire",
		body = nextRankText(data.stats.peakUsers),
		app = "market",
		progress = false,
	}
end

function HUD.mount(parent: Frame, devAllowed: boolean, onDev: () -&gt; ())
	local frame = Kit.frame(parent)
	frame.Name = "HUD"
	frame.Visible = false
	root = frame

	local column = Kit.frame(frame, UDim2.fromOffset(WIDTH, 0), UDim2.new(1, -16, 0, 12))
	column.AnchorPoint = Vector2.new(1, 0)
	column.AutomaticSize = Enum.AutomaticSize.Y
	local layout = Kit.list(column, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	-- Firma und Zahlen in einem Glas-Panel: Geld groß, Nutzer und Reputation als Nebenwerte
	local panel = Kit.panel(column, UDim2.new(1, 0, 0, 0))
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.LayoutOrder = 1
	Kit.padding(panel, 12, 14, 12, 12)
	Kit.list(panel, 10)

	local identity = Kit.frame(panel, UDim2.new(1, 0, 0, 40))
	identity.LayoutOrder = 1
	local logoBox = Kit.frame(identity, UDim2.fromOffset(40, 40))
	logoBox.BackgroundTransparency = 0.72
	Theme.bindAccent(logoBox, "BackgroundColor3")
	Kit.corner(logoBox, 11)
	local logo = Kit.text(logoBox, "", 22, F.regular)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.fromScale(0.5, 0.5)
	local nameLabel = Kit.text(identity, "", 17, F.bold, C.text)
	nameLabel.AutomaticSize = Enum.AutomaticSize.None
	nameLabel.Size = UDim2.new(1, -52, 0, 22)
	nameLabel.Position = UDim2.fromOffset(52, 1)
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	local rankLabel = Kit.text(identity, "", 13, F.bold, C.muted)
	rankLabel.Position = UDim2.fromOffset(52, 23)
	Theme.bindAccent(rankLabel, "TextColor3", Theme.lighter(0.3))

	Kit.divider(panel, 2)
	local moneyRow = Kit.frame(panel, UDim2.new(1, 0, 0, 26))
	moneyRow.LayoutOrder = 3
	local moneyValue = Kit.text(moneyRow, "$0", 22, F.display, C.text)
	moneyValue.AnchorPoint = Vector2.new(0, 0.5)
	moneyValue.Position = UDim2.fromScale(0, 0.5)
	local moneySub = Kit.text(moneyRow, "", 13, F.bold, C.dim)
	moneySub.AnchorPoint = Vector2.new(1, 0.5)
	moneySub.Position = UDim2.fromScale(1, 0.5)
	local statsRow = Kit.frame(panel, UDim2.new(1, 0, 0, 18))
	statsRow.LayoutOrder = 4
	local usersValue = Kit.text(statsRow, "0 users", 14, F.medium, C.muted)
	local repValue = Kit.text(statsRow, "Reputation 0", 14, F.medium, C.muted)
	repValue.AnchorPoint = Vector2.new(1, 0)
	repValue.Position = UDim2.fromScale(1, 0)

	local saveBadge = Kit.tag(column, "Saving off (Studio test)", C.warn, 2)
	saveBadge.Visible = false

	-- Next Step: sagt immer, was als Nächstes dran ist, und öffnet die passende App
	local step = Instance.new("TextButton")
	step.AutoButtonColor = false
	step.Text = ""
	step.BorderSizePixel = 0
	step.Size = UDim2.new(1, 0, 0, 0)
	step.AutomaticSize = Enum.AutomaticSize.Y
	step.LayoutOrder = 3
	step.BackgroundColor3 = C.panel
	step.BackgroundTransparency = 0.02
	step.Parent = column
	Kit.corner(step, 14)
	local stepStroke = Kit.stroke(step, 0.87)
	stepStroke.Color = C.line
	Kit.padding(step, 12, 14, 13, 14)
	Kit.list(step, 4)
	local stepCaption = Kit.caption(step, "Next step", 1)
	Theme.bindAccent(stepCaption, "TextColor3")
	local stepTitle = Kit.para(step, "", 17, C.text, 2)
	stepTitle.Font = F.bold
	local stepBody = Kit.para(step, "", 14, C.muted, 3)
	local stepBar = Kit.bar(step, 6, 4)
	local current: Step? = nil
	Kit.onClick(step, function()
		local target = current
		if not target then
			return
		end
		Computer.open(target.app,target.section)
		local releaseId = target.releaseId
		if releaseId then
			LabApp.openRelease(releaseId)
		end
	end)

	-- Computer-Button, für Tastatur mit Tastenkappe "C"
	local computerButton = Kit.button(column, "Open company", "primary", UDim2.new(1, 0, 0, 50))
	computerButton.LayoutOrder = 4
	computerButton.TextSize = 17
	Kit.onClick(computerButton, Computer.toggle)
	if UserInputService.KeyboardEnabled then
		local keycap = Kit.frame(computerButton, UDim2.fromOffset(26, 24), UDim2.new(1, -12, 0.5, 0))
		keycap.AnchorPoint = Vector2.new(1, 0.5)
		keycap.BackgroundTransparency = 0.82
		keycap.BackgroundColor3 = C.bg
		Kit.corner(keycap, 6)
		local key = Kit.text(keycap, "C", 13, F.bold, C.bg)
		key.AnchorPoint = Vector2.new(0.5, 0.5)
		key.Position = UDim2.fromScale(0.5, 0.5)
	end
	if devAllowed then
		local dev = Kit.button(column, "DEV TOOLS", "ghost", UDim2.fromOffset(110, 30))
		dev.LayoutOrder = 5
		dev.TextSize = 12
		Kit.onClick(dev, onDev)
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not frame.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.C then
			Computer.toggle()
		end
	end)

	StateController.onChange(function(snapshot: Snapshot)
		local data = snapshot.data
		local info = data.company
		frame.Visible = info ~= nil and frame:GetAttribute("Hidden") ~= true
		if not info then
			return
		end
		logo.Text = info.logo
		nameLabel.Text = info.name
		rankLabel.Text = CompanyConfig.rankFor(data.stats.peakUsers)
		repValue.Text = `Reputation {string.format("%.0f", info.reputation)}`
		saveBadge.Visible = not snapshot.saveEnabled

		local live = snapshot.live
		local net = live.revenue - live.cost
		if live.revenue &gt; 0 or live.cost &gt; 0 then
			moneySub.Text = Format.perMinute(net)
			moneySub.TextColor3 = if net &gt;= 0 then C.good else C.bad
		else
			moneySub.Text = "no income yet"
			moneySub.TextColor3 = C.dim
		end

		local s = nextStep(snapshot)
		current = s
		stepTitle.Text = s.title
		stepBody.Text = s.body
		stepBar.frame.Visible = s.progress
		stepCaption.TextColor3 = if s.title == "Decision needed!" then C.warn else Theme.accent
	end)

	-- Zahlen gleiten zum Zielwert (Geld läuft zwischen den Snapshots weiter)
	local shownMoney, shownUsers = 0, 0
	RunService.RenderStepped:Connect(function(dt: number)
		local snapshot = StateController.snapshot
		column.Visible = not Computer.isOpen() -- im Computer stehen dieselben Zahlen in der Kopfzeile
		if not snapshot or not frame.Visible then
			return
		end
		local alpha = math.min(1, dt * 8)
		local money = StateController.money()
		shownMoney = if math.abs(money - shownMoney) &gt; 1e8 then money else shownMoney + (money - shownMoney) * alpha
		moneyValue.Text = Format.money(shownMoney)
		moneyValue.TextColor3 = if shownMoney &lt; 0 then C.bad else C.text
		local users = snapshot.live.users
		shownUsers = if math.abs(users - shownUsers) &gt; 1e7 then users else shownUsers + (users - shownUsers) * alpha
		usersValue.Text = `{Format.compact(shownUsers)} users`
		if stepBar.frame.Visible then
			local done, total = StateController.trainingWork()
			stepBar.set(if total &gt; 0 then done / total else 0)
		end
	end)

	-- Benachrichtigungen vom Server
	StateController.onNotify(function(kind: string, payload: { [string]: any })
		if kind == "TRAINING_EVENT" then
			if Computer.isOpen() then
				return -- das Lab zeigt die Entscheidung ohnehin groß an
			end
			local def = if typeof(payload.eventId) == "string" then ModelConfig.getEvent(payload.eventId) else nil
			Toast.show("warn", `Training paused: {if def then def.title else "decision needed"}. Open the Lab to decide.`, 5)
		elseif kind == "TRAINING_COMPLETE" then
			local overall = if typeof(payload.overall) == "number" then payload.overall else 0
			if not Computer.isOpen() then -- bei offenem Computer erscheint das Ergebnis direkt im Lab
				Toast.show("success", `Training complete! Overall {string.format("%.1f", overall)}. Open your computer to see it.`, 5)
			end
		elseif kind == "MODEL_LIVE" then
			if not Computer.isOpen() then
				Toast.show("success", "Your model is live. Users are coming in!")
			end
		elseif kind == "RANK_UP" then
			local rank = if typeof(payload.rank) == "string" then payload.rank else "new rank"
			Toast.show("success", `Rank up! Your company is now a {rank}.`, 6)
		end
	end)
end

-- Während des Intros ausblenden
function HUD.setHidden(hidden: boolean)
	local frame = root
	if not frame then
		return
	end
	frame:SetAttribute("Hidden", hidden)
	local snapshot = StateController.snapshot
	frame.Visible = not hidden and snapshot ~= nil and snapshot.data.company ~= nil
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">Intro</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Intro: Titelbildschirm und Firmengründung. Eigene randlose Ebene über allem, bis eine Firma existiert.
-- Bei bestehender Firma: "Welcome back" + CONTINUE. Nach Debug-Reset erscheint es wieder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CompanyConfig = require(Shared.Config.CompanyConfig)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

export type Callbacks = { onFinish: () -&gt; (), onReopen: () -&gt; () }

local Intro = {}

local function trim(text: string): string
	return (string.gsub(string.gsub(text, "^%s+", ""), "%s+$", ""))
end

local function validName(text: string): boolean
	local length = utf8.len(trim(text))
	return length ~= nil and length &gt;= GameConfig.COMPANY_NAME_MIN and length &lt;= GameConfig.COMPANY_NAME_MAX
end

local function colorOf(id: string): Color3
	local def = CompanyConfig.getColor(id)
	return if def then Theme.rgb(def.rgb) else Theme.DEFAULT_ACCENT
end

function Intro.mount(parent: Frame, callbacks: Callbacks)
	local blocker = Kit.blocker(parent, C.white, 0)
	blocker.Name = "Intro"
	blocker.ZIndex = 30
	

	-- Quiet architectural backdrop: one border, a small wordmark and generous space.
	blocker.BackgroundColor3 = C.bg
	local edge = Kit.frame(blocker, UDim2.new(0, 1, 1, -96), UDim2.new(0, 48, 0, 48))
	edge.BackgroundColor3 = C.line
	edge.BackgroundTransparency = 0.92
	local edition = Kit.text(blocker, "FOUNDER DISTRICT   /   01", 12, F.bold, C.muted)
	edition.Position = UDim2.fromOffset(72, 52)
	local footerNote = Kit.text(blocker, "A garage today. Your company tomorrow.", 14, F.regular, C.dim)
	footerNote.Position = UDim2.new(0, 72, 1, -48)
	local mark = Kit.frame(blocker, UDim2.fromOffset(28, 28), UDim2.new(1,-72,0,52))
	mark.BackgroundColor3 = Theme.accent
	mark.BackgroundTransparency = 0.1
	Kit.corner(mark, 5)
	local cut = Kit.frame(mark,UDim2.fromOffset(8,20),UDim2.fromOffset(10,4))
	cut.BackgroundColor3 = C.bg
	cut.BackgroundTransparency = 0

	---------------------------------------------------------------- Titel
	local splash = Kit.frame(blocker, UDim2.fromOffset(860, 0), UDim2.fromScale(0.5, 0.46))
	splash.AnchorPoint = Vector2.new(0.5, 0.5)
	splash.AutomaticSize = Enum.AutomaticSize.Y
	local splashLayout = Kit.list(splash, 12)
	splashLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local title = Kit.text(splash, "AI Empire", 64, F.display, C.white)
	title.LayoutOrder = 1
	title.TextXAlignment = Enum.TextXAlignment.Center
	local horizon = Kit.frame(splash, UDim2.fromOffset(52, 3))
	horizon.LayoutOrder = 2
	horizon.BackgroundTransparency = 0
	Theme.bindAccent(horizon, "BackgroundColor3")
	local horizonFade = Instance.new("UIGradient")
	horizonFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	horizonFade.Parent = horizon
	local tagline = Kit.text(splash, "Train the model. Build the business.", 21, F.medium, C.muted)
	tagline.LayoutOrder = 3
	local spacer = Kit.frame(splash, UDim2.fromOffset(1, 10))
	spacer.LayoutOrder = 4
	local status = Kit.text(splash, "Connecting...", 16, F.medium, C.dim)
	status.LayoutOrder = 5
	local start = Kit.button(splash, "Build your company", "primary", UDim2.fromOffset(260, 56))
	start.LayoutOrder = 6
	start.TextSize = 19
	start.Visible = false

	---------------------------------------------------------------- Formular
	local form = Kit.scroll(blocker)
	form.Visible = false
	Kit.padding(form, 72, 24, 28, 24) -- oben Platz für die Roblox-Topbar (Ebene ist randlos)
	local formLayout = Kit.list(form, 14)
	formLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local column = Kit.frame(form, UDim2.fromScale(1, 0))
	column.AutomaticSize = Enum.AutomaticSize.Y
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(800, math.huge)
	limit.Parent = column
	Kit.list(column, 14)

	local head = Kit.stack(column, 8, 1)
	local formTitle = Kit.text(head, "Make it your company", 26, F.display, C.text)
	formTitle.LayoutOrder = 1
	Kit.para(
		head,
		`You start in a garage with {Format.money(GameConfig.START_MONEY)} and an old laptop. Everything else you build yourself.`,
		16,
		C.muted,
		2
	)

	local selectedLogo = CompanyConfig.LOGOS[1]
	local selectedColor = CompanyConfig.COLORS[1].id
	local selectedSpec = CompanyConfig.SPECIALIZATIONS[1].id

	local formPanel = Kit.panel(column, UDim2.fromScale(1, 0))
	formPanel.AutomaticSize = Enum.AutomaticSize.Y
	formPanel.LayoutOrder = 2
	formPanel.BackgroundTransparency = 0.06
	Kit.padding(formPanel, 22, 24, 22, 24)
	Kit.list(formPanel, 20)

	-- Name
	local nameCard = Kit.stack(formPanel, 8, 1)
	local nameHead = Kit.frame(nameCard, UDim2.new(1, 0, 0, 18))
	nameHead.LayoutOrder = 1
	Kit.caption(nameHead, "Company name")
	local counter = Kit.text(nameHead, "", 13, F.bold, C.dim)
	counter.AnchorPoint = Vector2.new(1, 0)
	counter.Position = UDim2.fromScale(1, 0)
	local nameBox = Kit.input(nameCard, "e.g. Nimbus Labs")
	nameBox.LayoutOrder = 2

	-- Logo
	local logoCard = Kit.stack(formPanel, 10, 2)
	Kit.caption(logoCard, "Logo", 1)
	local logoRow = Kit.row(logoCard, 54, 8, 2)
	local logoButtons: { [string]: { button: TextButton, stroke: UIStroke } } = {}
	for index, glyph in CompanyConfig.LOGOS do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = glyph
		button.TextSize = 26
		button.Font = F.regular
		button.Size = UDim2.fromOffset(54, 54)
		button.LayoutOrder = index
		button.BackgroundColor3 = C.raised
		button.Parent = logoRow
		Kit.corner(button, 12)
		local stroke = Kit.stroke(button, 1, Theme.accent, 2)
		logoButtons[glyph] = { button = button, stroke = stroke }
	end

	-- Farbe
	local colorCard = Kit.stack(formPanel, 10, 3)
	Kit.caption(colorCard, "Brand color", 1)
	local colorRow = Kit.row(colorCard, 44, 10, 2)
	local colorButtons: { [string]: UIStroke } = {}
	local colorClicks: { [string]: TextButton } = {}
	for index, def in CompanyConfig.COLORS do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = ""
		button.Size = UDim2.fromOffset(40, 40)
		button.LayoutOrder = index
		button.BackgroundColor3 = Theme.rgb(def.rgb)
		button.Parent = colorRow
		Kit.corner(button, 20)
		colorButtons[def.id] = Kit.stroke(button, 1, C.white, 3)
		colorClicks[def.id] = button
	end

	-- Spezialisierung
	local specCard = Kit.stack(formPanel, 10, 4)
	Kit.caption(specCard, "Specialization: a small bonus that lasts forever", 1)
	local specGrid = Kit.grid(specCard, 3, 80, 10, 2)
	local specButtons: { [string]: { button: TextButton, stroke: UIStroke } } = {}
	for index, spec in CompanyConfig.SPECIALIZATIONS do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = ""
		button.LayoutOrder = index
		button.BackgroundColor3 = C.bg
		button.BackgroundTransparency = 0.3
		button.Parent = specGrid
		Kit.corner(button, 12)
		local stroke = Kit.stroke(button, 0.88, C.line, 2)
		Kit.padding(button, 10, 12, 10, 12)
		Kit.list(button, 4)
		local name = Kit.text(button, spec.name, 16, F.bold, C.text)
		name.LayoutOrder = 1
		Kit.para(button, spec.desc, 13, C.muted, 2)
		specButtons[spec.id] = { button = button, stroke = stroke }
	end

	-- Vorschau + Gründen
	Kit.divider(formPanel, 5)
	local footer = Kit.frame(formPanel, UDim2.new(1, 0, 0, 60))
	footer.LayoutOrder = 6
	local previewLogo = Kit.frame(footer, UDim2.fromOffset(52, 52), UDim2.new(0, 0, 0.5, -26))
	previewLogo.BackgroundTransparency = 0.7
	Theme.bindAccent(previewLogo, "BackgroundColor3")
	Kit.corner(previewLogo, 14)
	local previewGlyph = Kit.text(previewLogo, selectedLogo, 28, F.regular)
	previewGlyph.AnchorPoint = Vector2.new(0.5, 0.5)
	previewGlyph.Position = UDim2.fromScale(0.5, 0.5)
	local previewName = Kit.text(footer, "", 22, F.black, C.text)
	previewName.AutomaticSize = Enum.AutomaticSize.None
	previewName.Size = UDim2.new(1, -340, 0, 26)
	previewName.Position = UDim2.fromOffset(66, 8)
	previewName.TextTruncate = Enum.TextTruncate.AtEnd
	local previewSpec = Kit.text(footer, "", 14, F.bold, C.muted)
	previewSpec.Position = UDim2.fromOffset(66, 36)
	Theme.bindAccent(previewSpec, "TextColor3")
	local found = Kit.button(footer, "Create company", "primary", UDim2.fromOffset(250, 54))
	found.AnchorPoint = Vector2.new(1, 0.5)
	found.Position = UDim2.fromScale(1, 0.5)
	found.TextSize = 18

	local function paint()
		local text = trim(nameBox.Text)
		local length = utf8.len(text) or 0
		counter.Text = `{length}/{GameConfig.COMPANY_NAME_MAX}`
		counter.TextColor3 = if length &gt; GameConfig.COMPANY_NAME_MAX then C.bad else C.dim
		previewName.Text = if text ~= "" then text else "Your company"
		previewGlyph.Text = selectedLogo
		local spec = CompanyConfig.getSpec(selectedSpec)
		previewSpec.Text = if spec then spec.name else ""
		for glyph, refs in logoButtons do
			local on = glyph == selectedLogo
			refs.stroke.Transparency = if on then 0 else 1
			refs.stroke.Color = Theme.accent
			refs.button.BackgroundColor3 = if on then Theme.accent:Lerp(C.bg, 0.65) else C.raised
		end
		for id, stroke in colorButtons do
			stroke.Transparency = if id == selectedColor then 0 else 1
		end
		for id, refs in specButtons do
			local on = id == selectedSpec
			refs.stroke.Color = if on then Theme.accent else C.line
			refs.stroke.Transparency = if on then 0 else 0.88
		end
		Kit.setDisabled(found, not validName(nameBox.Text))
	end

	for glyph, refs in logoButtons do
		refs.button.Activated:Connect(function()
			selectedLogo = glyph
			paint()
		end)
	end
	for id, button in colorClicks do
		button.Activated:Connect(function()
			selectedColor = id
			Theme.setAccent(colorOf(id)) -- Vorschau sofort in der Firmenfarbe
			paint()
		end)
	end
	for id, refs in specButtons do
		refs.button.Activated:Connect(function()
			selectedSpec = id
			paint()
		end)
	end
	nameBox:GetPropertyChangedSignal("Text"):Connect(paint)
	Theme.onAccent(function()
		paint()
	end)
	paint()

	---------------------------------------------------------------- Ablauf
	local stage = "loading" -- loading | welcome | new | form | done

	local function finish()
		if stage == "done" then
			return
		end
		stage = "done"
		Kit.tween(blocker, 0.6, { Position = UDim2.fromScale(0, -1) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.6, function()
			if stage == "done" then
				blocker.Visible = false
			end
		end)
		callbacks.onFinish()
	end

	local function showNew()
		stage = "new"
		blocker.Position = UDim2.new()
		blocker.Visible = true
		form.Visible = false
		splash.Visible = true
		status.Text = `You have {Format.money(GameConfig.START_MONEY)}, an old laptop and a big idea.`
		start.Text = "Build your company"
		start.Visible = true
	end

	Kit.onClick(start, function()
		if stage == "welcome" then
			finish()
		elseif stage == "new" then
			stage = "form"
			splash.Visible = false
			form.Visible = true
		end
	end)

	Kit.onClick(found, function()
		local name = trim(nameBox.Text)
		local ok = ActionController.call("CreateCompany", {
			name = name,
			logo = selectedLogo,
			color = selectedColor,
			spec = selectedSpec,
		})
		if ok then
			Toast.show("success", `Welcome to {name}! Your garage office is ready.`, 5)
			finish()
		end
	end)

	StateController.onChange(function(snapshot: Types.Snapshot)
		local company = snapshot.data.company
		if stage == "done" then
			if not company then
				-- Firma wurde zurückgesetzt (Debug): Intro wieder zeigen
				callbacks.onReopen()
				showNew()
			end
			return
		end
		if company then
			if stage == "form" then
				finish()
			elseif stage ~= "welcome" then
				stage = "welcome"
				status.Text = `Welcome back, {company.logo} {company.name}`
				start.Text = "Back to work"
				start.Visible = true
			end
		elseif stage == "loading" then
			showNew()
		end
	end)
end

return Intro
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><string name="Name">DebugPanel</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Test-Abkürzungen. Sichtbar nur in Studio oder für GameConfig.DEV_USER_IDS.
-- Der Server prüft das unabhängig davon noch einmal (DebugService.allowed).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local UI = script.Parent
local Client = UI.Parent
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors

local COMMANDS: { { cmd: string, label: string, done: string } } = {
	{ cmd = "money", label = "+ $100K", done = "+$100,000" },
	{ cmd = "data", label = "+ 10B tokens per type", done = "+10B tokens of every data type" },
	{ cmd = "finish", label = "Finish training now", done = "Training finished" },
	{ cmd = "rep", label = "+ 25 reputation", done = "+25 reputation" },
}

local DebugPanel = {}

local panel: Frame? = nil

function DebugPanel.allowed(): boolean
	return RunService:IsStudio() or table.find(GameConfig.DEV_USER_IDS, Players.LocalPlayer.UserId) ~= nil
end

function DebugPanel.mount(parent: Frame)
	local frame = Kit.panel(parent, UDim2.fromOffset(240, 0), UDim2.new(0, 16, 0.55, 0))
	frame.AnchorPoint = Vector2.new(0, 0.5)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.Visible = false
	frame.Name = "DebugPanel"
	Kit.padding(frame, 12)
	Kit.list(frame, 8)
	local caption = Kit.caption(frame, "Dev tools (Studio only)", 0)
	caption.TextColor3 = C.warn
	panel = frame

	for index, def in COMMANDS do
		local button = Kit.button(frame, def.label, "secondary", UDim2.new(1, 0, 0, 36))
		button.LayoutOrder = index
		button.TextSize = 14
		Kit.onClick(button, function()
			local ok = ActionController.call("Debug", { cmd = def.cmd })
			if ok then
				Toast.show("info", "[Dev] " .. def.done)
			end
		end)
	end

	local reset = Kit.button(frame, "Reset save", "danger", UDim2.new(1, 0, 0, 36))
	reset.LayoutOrder = #COMMANDS + 1
	reset.TextSize = 14
	local armedAt = 0
	Kit.onClick(reset, function()
		if os.clock() - armedAt &gt; 3 then
			armedAt = os.clock()
			reset.Text = "Click again to reset"
			task.delay(3, function()
				reset.Text = "Reset save"
			end)
			return
		end
		armedAt = 0
		reset.Text = "Reset save"
		local ok = ActionController.call("Debug", { cmd = "reset" })
		if ok then
			Toast.show("warn", "[Dev] Save reset. Starting over.")
		end
	end)

	local close = Kit.button(frame, "Close", "ghost", UDim2.new(1, 0, 0, 30))
	close.LayoutOrder = #COMMANDS + 2
	close.TextSize = 13
	Kit.onClick(close, DebugPanel.toggle)
end

function DebugPanel.toggle()
	local frame = panel
	if frame then
		frame.Visible = not frame.Visible
	end
end

return DebugPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">Kit</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- UI-Bausteine. Bewusst typisiert (Instance.new + direkte Property-Zuweisung), damit luau-lsp
-- falsche Property-Namen findet. Größen sind Design-Pixel (UIRoot skaliert alles passend).

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local C = Theme.colors
local F = Theme.font

export type Nav = { show: (appId: string) -&gt; (), close: () -&gt; (), isOpen: () -&gt; boolean }
export type ButtonStyle = "primary" | "secondary" | "ghost" | "danger" | "warn"
export type Option = { id: string, label: string }
export type Bar = { frame: Frame, fill: Frame, set: (fraction: number) -&gt; () }
export type Segmented = {
	frame: Frame,
	set: (id: string) -&gt; (),
	get: () -&gt; string,
	setDim: (id: string, dim: boolean) -&gt; (),
}
export type Slider = {
	frame: Frame,
	set: (value: number) -&gt; (),
	get: () -&gt; number,
	setRange: (min: number, max: number) -&gt; (),
}
export type StatRow = { frame: Frame, set: (value: number, max: number?) -&gt; () }
export type Metric = { frame: Frame, value: TextLabel, label: TextLabel }
export type Icon = { frame: Frame, setColor: (color: Color3) -&gt; () }

local Kit = {}

function Kit.tween(
	inst: Instance,
	seconds: number,
	goals: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local tween = TweenService:Create(inst, info, goals)
	tween:Play()
	return tween
end

function Kit.corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = parent
	return corner
end

function Kit.stroke(parent: Instance, transparency: number?, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color or C.line
	stroke.Transparency = transparency or 0.9
	stroke.Thickness = thickness or 1
	stroke.Parent = parent
	return stroke
end

function Kit.padding(parent: Instance, top: number, right: number?, bottom: number?, left: number?): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingRight = UDim.new(0, right or top)
	padding.PaddingBottom = UDim.new(0, bottom or top)
	padding.PaddingLeft = UDim.new(0, left or right or top)
	padding.Parent = parent
	return padding
end

function Kit.list(parent: Instance, gap: number?, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, gap or 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	if horizontal then
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	layout.Parent = parent
	return layout
end

function Kit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = rotation or 90
	gradient.Parent = parent
	return gradient
end

function Kit.frame(parent: Instance?, size: UDim2?, position: UDim2?): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = size or UDim2.fromScale(1, 1)
	frame.Position = position or UDim2.new()
	frame.Parent = parent
	return frame
end

-- Spalte mit Inhaltshöhe (volle Breite)
function Kit.stack(parent: Instance, gap: number?, order: number?): Frame
	local frame = Kit.frame(parent, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = order or 0
	Kit.list(frame, gap)
	return frame
end

-- Zeile mit fester Höhe, Kinder nebeneinander
function Kit.row(parent: Instance, height: number, gap: number?, order: number?): Frame
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, height))
	frame.LayoutOrder = order or 0
	Kit.list(frame, gap, true)
	return frame
end

-- Glas-Kante: oben hell, nach unten fast unsichtbar (Licht von oben)
function Kit.litStroke(parent: Instance, top: number?): UIStroke
	local stroke = Kit.stroke(parent, 0, C.line, 1)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, top or 0.78),
		NumberSequenceKeypoint.new(0.4, 0.9),
		NumberSequenceKeypoint.new(1, 0.95),
	})
	gradient.Parent = stroke
	return stroke
end

-- Großes Glas-Panel (Fenster, HUD)
function Kit.panel(parent: Instance?, size: UDim2?, position: UDim2?): Frame
	local frame = Kit.frame(parent, size, position)
	frame.BackgroundColor3 = C.panel
	frame.BackgroundTransparency = 0.02
	Kit.corner(frame, 12)
	Kit.stroke(frame, 0.87)
	return frame
end

-- Inhaltskarte mit Innenabstand und Liste
function Kit.card(parent: Instance, order: number?, gap: number?): Frame
	local frame = Kit.frame(parent, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = order or 0
	frame.BackgroundColor3 = C.panel2
	frame.BackgroundTransparency = 0
	Kit.corner(frame, 10)
	Kit.stroke(frame, 0.93)
	Kit.padding(frame, 16)
	Kit.list(frame, gap or 10)
	return frame
end

function Kit.text(parent: Instance?, text: string, size: number?, font: Enum.Font?, color: Color3?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = text
	label.TextSize = size or 16
	label.Font = font or F.medium
	label.TextColor3 = color or C.text
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.AutomaticSize = Enum.AutomaticSize.XY
	label.Size = UDim2.new()
	label.Parent = parent
	return label
end

-- Fließtext über die volle Breite mit Umbruch
function Kit.para(parent: Instance, text: string, size: number?, color: Color3?, order: number?): TextLabel
	local label = Kit.text(parent, text, size or 15, F.regular, color or C.muted)
	label.Size = UDim2.fromScale(1, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.LayoutOrder = order or 0
	return label
end

-- Abschnittsname: normale Schreibung, gedämpft (keine Großbuchstaben-Etiketten)
function Kit.caption(parent: Instance, text: string, order: number?): TextLabel
	local label = Kit.text(parent, text, 13, F.medium, C.muted)
	label.LayoutOrder = order or 0
	return label
end

-- Fester Textblock (z. B. Spalte in einer Tabelle)
function Kit.cell(parent: Instance, text: string, width: UDim, size: number?, font: Enum.Font?, color: Color3?): TextLabel
	local label = Kit.text(parent, text, size or 15, font, color)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.Size = UDim2.new(width, UDim.new(1, 0))
	label.TextTruncate = Enum.TextTruncate.AtEnd
	return label
end

function Kit.tag(parent: Instance, text: string, color: Color3, order: number?): TextLabel
	local label = Kit.text(parent, string.upper(text), 11, F.bold, color)
	label.BackgroundColor3 = C.bg -- dunkle Basis: lesbar auch über hellem Himmel
	label.BackgroundTransparency = 0.15
	label.LayoutOrder = order or 0
	Kit.corner(label, 6)
	Kit.stroke(label, 0.55, color)
	Kit.padding(label, 3, 7, 3, 7)
	return label
end

function Kit.dot(parent: Instance, color: Color3, size: number?): Frame
	local dot = Kit.frame(parent, UDim2.fromOffset(size or 10, size or 10))
	dot.BackgroundTransparency = 0
	dot.BackgroundColor3 = color
	Kit.corner(dot, (size or 10) // 2 + 1)
	return dot
end

function Kit.divider(parent: Instance, order: number?): Frame
	local line = Kit.frame(parent, UDim2.new(1, 0, 0, 1))
	line.BackgroundTransparency = 0.92
	line.BackgroundColor3 = C.line
	line.LayoutOrder = order or 0
	return line
end

-- Für RichText: Spielertexte (Namen) immer escapen
function Kit.escape(text: string): string
	return (
		string.gsub(text, "[&amp;&lt;&gt;\"']", {
			["&amp;"] = "&amp;amp;",
			["&lt;"] = "&amp;lt;",
			["&gt;"] = "&amp;gt;",
			['"'] = "&amp;quot;",
			["'"] = "&amp;apos;",
		})
	)
end

---------------------------------------------------------------------------- Buttons

function Kit.button(parent: Instance?, text: string, style: ButtonStyle?, size: UDim2?): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Text = text
	button.Font = F.bold
	button.TextSize = 16
	button.Size = size or UDim2.fromOffset(140, 40)
	button.Parent = parent
	Kit.corner(button, 10)

	local kind = style or "secondary"
	if kind == "primary" then
		Theme.bindAccent(button, "BackgroundColor3")
		button.BackgroundTransparency = 0
		button.TextColor3 = C.bg
	elseif kind == "danger" or kind == "warn" then
		local color = if kind == "danger" then C.bad else C.warn
		button.BackgroundColor3 = color
		button.BackgroundTransparency = 0.82
		button.TextColor3 = color
		Kit.stroke(button, 0.55, color)
	elseif kind == "ghost" then
		button.BackgroundColor3 = C.raised
		button.BackgroundTransparency = 1
		button.TextColor3 = C.muted
		Kit.stroke(button, 0.84)
	else
		button.BackgroundColor3 = C.raised
		button.BackgroundTransparency = 0
		button.TextColor3 = C.text
		Kit.litStroke(button, 0.8)
	end
	button:SetAttribute("BaseBg", button.BackgroundTransparency)

	-- kleines "Juice": Hover und Druck skalieren den Button
	local scale = Instance.new("UIScale")
	scale.Parent = button
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			Kit.tween(scale, 0.15, { Scale = 1.015 })
		end
	end)
	button.MouseLeave:Connect(function()
		Kit.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			Kit.tween(scale, 0.08, { Scale = 0.98 })
		end
	end)
	button.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	return button
end

function Kit.setDisabled(button: TextButton, disabled: boolean)
	if (button:GetAttribute("Disabled") == true) == disabled then
		return
	end
	button:SetAttribute("Disabled", disabled)
	local base = button:GetAttribute("BaseBg")
	local baseBg = if typeof(base) == "number" then base else 0
	button.BackgroundTransparency = if disabled then math.min(1, baseBg + 0.5) else baseBg
	button.TextTransparency = if disabled then 0.45 else 0
end

-- Klick-Handler, der deaktivierte Buttons ignoriert
function Kit.onClick(button: GuiButton, callback: () -&gt; ())
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") == true then
			return
		end
		callback()
	end)
end

-- Unsichtbarer Vollflächen-Button: schluckt Klicks/Touches (Kamera dreht sich nicht mit)
function Kit.blocker(parent: Instance, color: Color3, transparency: number): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Text = ""
	button.Size = UDim2.fromScale(1, 1)
	button.BackgroundColor3 = color
	button.BackgroundTransparency = transparency
	button.Modal = true -- gibt die Maus frei, falls die Kamera sie festhält
	button.Parent = parent
	return button
end

---------------------------------------------------------------------------- Eingaben

function Kit.input(parent: Instance, placeholder: string, size: UDim2?): TextBox
	local box = Instance.new("TextBox")
	box.ClearTextOnFocus = false
	box.Text = ""
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = C.dim
	box.Font = F.medium
	box.TextSize = 18
	box.TextColor3 = C.text
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.BackgroundColor3 = C.bg
	box.BackgroundTransparency = 0.25
	box.BorderSizePixel = 0
	box.ClipsDescendants = true
	box.Size = size or UDim2.new(1, 0, 0, 44)
	box.Parent = parent
	Kit.corner(box, 10)
	Kit.padding(box, 0, 14, 0, 14)
	local stroke = Kit.stroke(box, 0.84)
	box.Focused:Connect(function()
		stroke.Color = Theme.accent
		stroke.Transparency = 0.2
	end)
	box.FocusLost:Connect(function()
		stroke.Color = C.line
		stroke.Transparency = 0.84
	end)
	return box
end

function Kit.segmented(
	parent: Instance,
	options: { Option },
	initial: string,
	onSelect: (id: string) -&gt; (),
	height: number?
): Segmented
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, height or 38))
	frame.BackgroundColor3 = C.bg
	frame.BackgroundTransparency = 0.25
	Kit.corner(frame, 10)
	Kit.stroke(frame, 0.9)
	Kit.padding(frame, 3)
	Kit.list(frame, 3, true)

	local count = #options
	local buttons: { [string]: TextButton } = {}
	local dimmed: { [string]: boolean } = {}
	local selected = initial

	local function paint()
		for id, button in buttons do
			local on = id == selected
			button.BackgroundColor3 = if on then Theme.accent else C.raised
			button.BackgroundTransparency = if on then 0 else 1
			button.TextColor3 = if on then C.bg elseif dimmed[id] then C.dim else C.muted
		end
	end

	for index, option in options do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = option.label
		button.Font = F.bold
		button.TextSize = 15
		button.Size = UDim2.new(1 / count, -3 * (count - 1) / count, 1, 0)
		button.LayoutOrder = index
		button.Parent = frame
		Kit.corner(button, 8)
		buttons[option.id] = button
		button.Activated:Connect(function()
			if selected == option.id then
				return
			end
			selected = option.id
			paint()
			onSelect(option.id)
		end)
	end
	paint()
	Theme.onAccent(function()
		paint()
	end)

	return {
		frame = frame,
		set = function(id: string)
			selected = id
			paint()
		end,
		get = function(): string
			return selected
		end,
		setDim = function(id: string, dim: boolean)
			dimmed[id] = dim
			paint()
		end,
	}
end

function Kit.slider(
	parent: Instance,
	min: number,
	max: number,
	step: number,
	value: number,
	onChange: (value: number) -&gt; ()
): Slider
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, 30))
	local track = Instance.new("TextButton")
	track.AutoButtonColor = false
	track.Text = ""
	track.BorderSizePixel = 0
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.new(0, 10, 0.5, 0)
	track.Size = UDim2.new(1, -20, 0, 8)
	track.BackgroundColor3 = C.raised
	track.Parent = frame
	Kit.corner(track, 4)

	local fill = Kit.frame(track, UDim2.fromScale(0, 1))
	fill.BackgroundTransparency = 0
	Theme.bindAccent(fill, "BackgroundColor3")
	Kit.corner(fill, 4)

	local knob = Kit.frame(track, UDim2.fromOffset(20, 20))
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundTransparency = 0
	knob.BackgroundColor3 = C.white
	Kit.corner(knob, 10)
	Kit.stroke(knob, 0.3, C.bg, 2)

	local lo, hi, current = min, max, value
	local dragging = false

	local function clampSnap(v: number): number
		local snapped = math.round((v - lo) / step) * step + lo
		return math.round(math.clamp(snapped, lo, math.max(lo, hi)) * 100) / 100
	end

	local function paint()
		local fraction = if hi &gt; lo then (current - lo) / (hi - lo) else 0
		fill.Size = UDim2.fromScale(fraction, 1)
		knob.Position = UDim2.fromScale(fraction, 0.5)
	end

	local function updateFrom(x: number)
		local width = track.AbsoluteSize.X
		if width &lt;= 0 then
			return
		end
		local fraction = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		local v = clampSnap(lo + fraction * (hi - lo))
		if v ~= current then
			current = v
			paint()
			onChange(v)
		end
	end

	local function begin(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			updateFrom(input.Position.X)
		end
	end
	track.InputBegan:Connect(begin)
	knob.InputBegan:Connect(begin)
	-- ungeprüft: X-Koordinaten von InputObject und AbsolutePosition stimmen bei seitlichen Notch-Insets überein
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			updateFrom(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)
	paint()

	return {
		frame = frame,
		set = function(v: number)
			current = clampSnap(v)
			paint()
		end,
		get = function(): number
			return current
		end,
		setRange = function(newMin: number, newMax: number)
			lo, hi = newMin, math.max(newMin, newMax)
			current = clampSnap(current)
			paint()
		end,
	}
end

---------------------------------------------------------------------------- Anzeigen

-- Fortschrittsbalken. Ohne color folgt die Füllung der Akzentfarbe.
function Kit.bar(parent: Instance, height: number?, order: number?, color: Color3?): Bar
	local h = height or 8
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, h))
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = C.raised
	frame.LayoutOrder = order or 0
	frame.ClipsDescendants = true
	Kit.corner(frame, math.ceil(h / 2))
	local fill = Kit.frame(frame, UDim2.fromScale(0, 1))
	fill.BackgroundTransparency = 0
	if color then
		fill.BackgroundColor3 = color
	else
		Theme.bindAccent(fill, "BackgroundColor3")
	end
	Kit.corner(fill, math.ceil(h / 2))
	Kit.gradient(fill, Color3.fromRGB(170, 176, 190), C.white, 0) -- Füllung wird nach rechts heller
	return {
		frame = frame,
		fill = fill,
		set = function(fraction: number)
			local f = if fraction == fraction then math.clamp(fraction, 0, 1) else 0
			fill.Size = UDim2.fromScale(f, 1)
		end,
	}
end

-- Zeile "Name ▓▓▓▓░░ Wert" für Modell-Stats
function Kit.statRow(parent: Instance, label: string, order: number?): StatRow
	local row = Kit.frame(parent, UDim2.new(1, 0, 0, 22))
	row.LayoutOrder = order or 0
	local name = Kit.cell(row, label, UDim.new(0, 92), 14, F.medium, C.muted)
	name.Position = UDim2.new()
	local track = Kit.frame(row, UDim2.new(1, -150, 0, 6), UDim2.new(0, 98, 0.5, -3))
	track.BackgroundTransparency = 0
	track.BackgroundColor3 = C.raised
	Kit.corner(track, 3)
	local fill = Kit.frame(track, UDim2.fromScale(0, 1))
	fill.BackgroundTransparency = 0
	Theme.bindAccent(fill, "BackgroundColor3")
	Kit.corner(fill, 3)
	local value = Kit.cell(row, "0", UDim.new(0, 44), 14, F.bold, C.text)
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.fromScale(1, 0)
	value.TextXAlignment = Enum.TextXAlignment.Right
	return {
		frame = row,
		set = function(v: number, max: number?)
			fill.Size = UDim2.fromScale(math.clamp(v / (max or 100), 0, 1), 1)
			value.Text = string.format("%.0f", v)
		end,
	}
end

-- Kennzahl: kleine Überschrift + großer Wert
function Kit.metric(parent: Instance, label: string, order: number?, valueSize: number?): Metric
	local frame = Kit.frame(parent, UDim2.new())
	frame.AutomaticSize = Enum.AutomaticSize.XY
	frame.LayoutOrder = order or 0
	Kit.list(frame, 2)
	local caption = Kit.caption(frame, label, 1)
	local value = Kit.text(frame, "–", valueSize or 20, F.bold, C.text)
	value.LayoutOrder = 2
	return { frame = frame, value = value, label = caption }
end

-- Zwei Spalten nebeneinander (links/rechts), jeweils mit Inhaltshöhe
function Kit.columns(parent: Instance, leftShare: number, gap: number?, order: number?): (Frame, Frame)
	local holder = Kit.frame(parent, UDim2.fromScale(1, 0))
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.LayoutOrder = order or 0
	local g = gap or 14
	local left = Kit.frame(holder, UDim2.new(leftShare, -g / 2, 0, 0))
	left.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(left, 12)
	local right = Kit.frame(holder, UDim2.new(1 - leftShare, -g / 2, 0, 0), UDim2.new(leftShare, g / 2, 0, 0))
	right.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(right, 12)
	return left, right
end

-- Raster mit festen Spalten und fester Zellenhöhe, Gesamthöhe automatisch
function Kit.grid(parent: Instance, columns: number, cellHeight: number, gap: number?, order: number?): Frame
	local frame = Kit.frame(parent, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = order or 0
	local g = gap or 10
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / columns, -g * (columns - 1) / columns, 0, cellHeight)
	grid.CellPadding = UDim2.fromOffset(g, g)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = frame
	return frame
end

function Kit.scroll(parent: Instance, size: UDim2?, position: UDim2?): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = size or UDim2.fromScale(1, 1)
	scroll.Position = position or UDim2.new()
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 5
	scroll.ScrollBarImageColor3 = C.white
	scroll.ScrollBarImageTransparency = 0.75
	scroll.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
	scroll.Parent = parent
	return scroll
end

-- Seitenkopf einer App: Titel in der Display-Schrift, darunter eine Zeile Erklärung
function Kit.heading(parent: Instance, title: string, subtitle: string?, order: number?): TextLabel
	local head = Kit.stack(parent, 6, order)
	local label = Kit.text(head, title, 22, F.display, C.text)
	label.LayoutOrder = 1
	if subtitle then
		Kit.para(head, subtitle, 14, C.muted, 2)
	end
	return label
end

-- Kleine Linien-Icons aus Frames (keine Emoji, keine Asset-IDs): lab, data, compute, market
function Kit.icon(parent: Instance, kind: string, size: number?): Icon
	local s = size or 20
	local frame = Kit.frame(parent, UDim2.fromOffset(s, s))
	local fills: { Frame } = {}
	local rings: { UIStroke } = {}
	local function block(x: number, y: number, w: number, h: number, radius: number?)
		local b = Kit.frame(frame, UDim2.fromScale(w, h), UDim2.fromScale(x, y))
		b.BackgroundTransparency = 0
		Kit.corner(b, radius or 2)
		table.insert(fills, b)
	end
	local function ring(x: number, y: number, w: number, h: number, radius: number)
		local r = Kit.frame(frame, UDim2.fromScale(w, h), UDim2.fromScale(x, y))
		Kit.corner(r, radius)
		table.insert(rings, Kit.stroke(r, 0, C.white, 2))
	end
	if kind == "empire" then
		block(0.12,0.25,0.76,0.68,2)
		ring(0.3,0.02,0.4,0.23,2)
	elseif kind == "lab" then -- Neuron
		ring(0.08, 0.08, 0.84, 0.84, s)
		block(0.34, 0.34, 0.32, 0.32, s)
	elseif kind == "data" then -- gestapelte Datensätze
		block(0.04, 0.1, 0.92, 0.2)
		block(0.04, 0.4, 0.92, 0.2)
		block(0.04, 0.7, 0.92, 0.2)
	elseif kind == "compute" then -- Chip mit Pins
		ring(0.18, 0.18, 0.64, 0.64, 3)
		block(0.38, 0.38, 0.24, 0.24, 1)
		block(0, 0.3, 0.12, 0.1, 1)
		block(0, 0.6, 0.12, 0.1, 1)
		block(0.88, 0.3, 0.12, 0.1, 1)
		block(0.88, 0.6, 0.12, 0.1, 1)
	elseif kind=="studio" then
		ring(.06,.12,.88,.76,2);block(.12,.19,.76,.12);block(.14,.4,.3,.38);block(.5,.4,.32,.1);block(.5,.62,.32,.1)
	elseif kind=="campus" then
		ring(.15,.18,.7,.75,1);block(.05,.88,.9,.1);block(.3,.34,.12,.15);block(.57,.34,.12,.15);block(.44,.65,.12,.28)
	elseif kind=="arena" then
		ring(.1,.05,.8,.57,3);block(.43,.6,.14,.22);block(.25,.85,.5,.1)
	else -- Markt: steigende Balken
		block(0.04, 0.56, 0.24, 0.4)
		block(0.38, 0.32, 0.24, 0.64)
		block(0.72, 0.06, 0.24, 0.9)
	end
	return {
		frame = frame,
		setColor = function(color: Color3)
			for _, b in fills do
				b.BackgroundColor3 = color
			end
			for _, r in rings do
				r.Color = color
			end
		end,
	}
end

return Kit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">Theme</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Farben und Schriften ("Nachtlabor"): tiefe Tinte als Grund, helle Haarlinien als Struktur, die
-- Firmenfarbe als einziger Akzent (CTA, Auswahl, Live-Daten). Elemente melden sich mit bindAccent
-- (Instanz + Property) oder onAccent (Callback) an und werden beim Farbwechsel umgefärbt.

local Theme = {}

Theme.colors = {
	bg = Color3.fromRGB(15, 21, 23),
	panel = Color3.fromRGB(23, 31, 33),
	panel2 = Color3.fromRGB(30, 39, 41),
	raised = Color3.fromRGB(42, 52, 53),
	line = Color3.fromRGB(255, 255, 255), -- Haarlinien, immer mit hoher Transparenz
	text = Color3.fromRGB(238, 239, 231),
	muted = Color3.fromRGB(158, 173, 168),
	dim = Color3.fromRGB(117, 136, 132),
	good = Color3.fromRGB(129, 204, 162),
	bad = Color3.fromRGB(224, 137, 127),
	warn = Color3.fromRGB(224, 189, 122),
	black = Color3.fromRGB(0, 0, 0),
	white = Color3.fromRGB(255, 255, 255),
}

Theme.font = {
	regular = Enum.Font.BuilderSans,
	medium = Enum.Font.BuilderSansMedium,
	bold = Enum.Font.BuilderSansBold,
	black = Enum.Font.BuilderSansExtraBold,
	display = Enum.Font.BuilderSansExtraBold,
	mono = Enum.Font.RobotoMono, -- nur im Trainings-Log
}

Theme.DEFAULT_ACCENT = Color3.fromRGB(120, 200, 174)
Theme.accent = Theme.DEFAULT_ACCENT

type Binding = { inst: Instance, prop: string, mix: ((Color3) -&gt; Color3)? }

local bindings: { Binding } = {}
local listeners: { (Color3) -&gt; () } = {}

local function valueFor(binding: Binding): Color3
	return if binding.mix then binding.mix(Theme.accent) else Theme.accent
end

-- Instanz zuerst parenten, dann binden (unparented Instanzen werden beim nächsten Wechsel entfernt)
function Theme.bindAccent(inst: Instance, prop: string, mix: ((Color3) -&gt; Color3)?)
	local binding: Binding = { inst = inst, prop = prop, mix = mix }
	table.insert(bindings, binding)
	local target: any = inst
	target[prop] = valueFor(binding)
	-- Rebuilt app cards must release their bindings immediately, even if the
	-- company's accent never changes again during this session.
	inst.Destroying:Once(function()
		local index = table.find(bindings, binding)
		if index then table.remove(bindings, index) end
	end)
end

function Theme.onAccent(callback: (Color3) -&gt; ())
	table.insert(listeners, callback)
end

function Theme.setAccent(color: Color3)
	if color == Theme.accent then
		return
	end
	Theme.accent = color
	local kept: { Binding } = {}
	for _, binding in bindings do
		if binding.inst.Parent ~= nil then
			local target: any = binding.inst
			target[binding.prop] = valueFor(binding)
			table.insert(kept, binding)
		end
	end
	bindings = kept
	for _, callback in listeners do
		task.spawn(callback, color)
	end
end

-- Mischungen für bindAccent
function Theme.darker(amount: number): (Color3) -&gt; Color3
	return function(color: Color3): Color3
		return color:Lerp(Theme.colors.black, amount)
	end
end

function Theme.lighter(amount: number): (Color3) -&gt; Color3
	return function(color: Color3): Color3
		return color:Lerp(Theme.colors.white, amount)
	end
end

-- Akzent als dunkle Tönung einer Fläche (Hero-Flächen: Schätzung, Loss-Graph, Ergebnis)
function Theme.tint(amount: number): (Color3) -&gt; Color3
	return function(color: Color3): Color3
		return color:Lerp(Theme.colors.panel, amount)
	end
end

function Theme.rgb(values: { number }): Color3
	return Color3.fromRGB(values[1] or 255, values[2] or 255, values[3] or 255)
end

return Theme
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">Toast</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Kurze Meldungen oben mittig. Immer nur eine: neue ersetzt alte. Bei offenem Computer liegt sie
-- in der leeren Mitte der Kopfzeile und verdeckt keinen Inhalt. Gleicher Text verlängert nur.

local Theme = require(script.Parent.Theme)
local Kit = require(script.Parent.Kit)

local C = Theme.colors
local F = Theme.font

export type Kind = "info" | "success" | "error" | "warn"

local Toast = {}

local MAX_VISIBLE = 1
local container: Frame? = nil
local active: { { text: string, frame: Frame, expires: number } } = {}
local counter = 0

local function colorOf(kind: Kind): Color3
	if kind == "success" then
		return C.good
	elseif kind == "error" then
		return C.bad
	elseif kind == "warn" then
		return C.warn
	end
	return Theme.accent
end

function Toast.mount(parent: Instance)
	local holder = Kit.frame(parent, UDim2.fromOffset(440, 0), UDim2.new(0.5, 0, 0, 16))
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.Name = "Toasts"
	holder.ZIndex = 50
	local layout = Kit.list(holder, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	container = holder
end

local function dismiss(entry: { text: string, frame: Frame, expires: number })
	local index = table.find(active, entry)
	if index then
		table.remove(active, index)
	end
	local frame = entry.frame
	Kit.tween(frame, 0.25, { BackgroundTransparency = 1 })
	for _, child in frame:GetDescendants() do
		if child:IsA("TextLabel") then
			Kit.tween(child, 0.25, { TextTransparency = 1 })
		elseif child:IsA("Frame") then
			Kit.tween(child, 0.25, { BackgroundTransparency = 1 })
		elseif child:IsA("UIStroke") then
			Kit.tween(child, 0.25, { Transparency = 1 })
		end
	end
	task.delay(0.3, function()
		frame:Destroy()
	end)
end

function Toast.show(kind: Kind, text: string, seconds: number?)
	local holder = container
	if not holder then
		return
	end
	local duration = seconds or 3
	for _, entry in active do
		if entry.text == text then
			entry.expires = os.clock() + duration
			return
		end
	end
	if #active &gt;= MAX_VISIBLE then
		dismiss(active[1])
	end

	counter += 1
	local color = colorOf(kind)
	local frame = Kit.frame(holder, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = counter
	frame.BackgroundTransparency = 0.04
	frame.BackgroundColor3 = C.bg
	frame.ZIndex = 50
	Kit.corner(frame, 12)
	Kit.stroke(frame, 0.6, color)
	Kit.padding(frame, 11, 16, 11, 16)
	Kit.list(frame, 10, true)

	local dot = Kit.dot(frame, color, 8) -- Statusfarbe: Erfolg, Fehler, Warnung, Info
	dot.LayoutOrder = 1
	dot.ZIndex = 51
	local label = Kit.text(frame, text, 15, F.medium, C.text)
	label.LayoutOrder = 2
	label.ZIndex = 51
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Size = UDim2.new(1, -18, 0, 0)
	label.TextWrapped = true

	local scale = Instance.new("UIScale")
	scale.Scale = 0.92
	scale.Parent = frame
	Kit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

	local entry = { text = text, frame = frame, expires = os.clock() + duration }
	table.insert(active, entry)
	task.spawn(function()
		while table.find(active, entry) do
			if os.clock() &gt;= entry.expires then
				dismiss(entry)
				return
			end
			task.wait(0.2)
		end
	end)
end

return Toast
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000055"><Properties><string name="Name">UIRoot</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Fünf ScreenGuis übereinander: HUD, Dim, Overlay (Computer), Intro (randlos), Top (Toasts, Debug).
-- Jede hat einen Root-Frame mit UIScale: das UI wird für 1280x720 entworfen und passend skaliert,
-- damit es auf Handy und großem Monitor gleich aussieht. CoreUISafeInsets hält es aus der Roblox-
-- Topbar und aus Notches heraus.

local Players = game:GetService("Players")

local UIRoot = {}

local DESIGN = Vector2.new(1280, 720)
local MIN_SCALE = 0.3
local MAX_SCALE = 1.25

type Layer = { gui: ScreenGui, root: Frame, scale: UIScale }

local function scaleFor(size: Vector2): number
	if size.X &lt;= 0 or size.Y &lt;= 0 then
		return 1
	end
	return math.clamp(math.min(size.X / DESIGN.X, size.Y / DESIGN.Y), MIN_SCALE, MAX_SCALE)
end

local function applyScale(layer: Layer)
	local s = scaleFor(layer.gui.AbsoluteSize)
	layer.scale.Scale = s
	layer.root.Size = UDim2.fromScale(1 / s, 1 / s)
end

local function makeLayer(playerGui: Instance, name: string, order: number, insets: Enum.ScreenInsets?): Frame
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = insets or Enum.ScreenInsets.CoreUISafeInsets
	gui.DisplayOrder = order
	gui.Parent = playerGui

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local layer: Layer = { gui = gui, root = root, scale = scale }
	applyScale(layer)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		applyScale(layer)
	end)
	return root
end

-- Rückgabe: hud, dim (randlos: Abdunkeln hinter dem Computer, auch unter der Topbar),
-- overlay (Computer), intro (randlos), top (Toasts, Debug)
function UIRoot.init(): (Frame, Frame, Frame, Frame, Frame)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local hud = makeLayer(playerGui, "AIEmpire_HUD", 10)
	local dim = makeLayer(playerGui, "AIEmpire_Dim", 19, Enum.ScreenInsets.None)
	local overlay = makeLayer(playerGui, "AIEmpire_Overlay", 20)
	local intro = makeLayer(playerGui, "AIEmpire_Intro", 25, Enum.ScreenInsets.None)
	local top = makeLayer(playerGui, "AIEmpire_Top", 30)
	return hud, dim, overlay, intro, top
end

return UIRoot
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000020"><Properties><string name="Name">AdminPanel</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The launcher appears only after a server-authorized snapshot, including before company creation.
local State=require(script.Parent.Parent.Controllers.StateController)
local Action=require(script.Parent.Parent.Controllers.ActionController)
local Theme=require(script.Parent.Theme)
local Kit=require(script.Parent.Kit)
local Toast=require(script.Parent.Toast)
local Panel={}
local frame: Frame?=nil
local authorized=false
local actions={
	{cmd="campus",title="Größten Campus freischalten",body="Sieben Etagen, alle Räume und Stores. Dein Spielstand bleibt erhalten."},
	{cmd="setup",title="Kompletten Firmenstart geben",body="Campus, 240 Mitarbeiter, Forschung, GPUs, Autos, Daten und $1 Mio."},
	{cmd="money",title="+$1.000.000 Spielgeld",body="Auf das eigene Firmenkonto einzahlen."},
	{cmd="staff",title="Team auf 240 auffüllen",body="Vier Rollen ausgewogen ergänzen. Die laufenden Gehälter gelten weiter."},
	{cmd="hardware",title="Compute ausbauen",body="Bis zu zwei Compute-Pods ergänzen und Kühlung auf Stufe 8 setzen."},
	{cmd="research",title="Alle Forschung freischalten",body="Acht Forschungsprojekte abschließen und 10.000 Punkte bereitstellen."},
	{cmd="fleet",title="Alle Firmenautos freischalten",body="Hatch, Cargo, Executive und Circuit GT im Fleet-Tab abholen."},
	{cmd="data",title="Trainingsdaten ergänzen",body="10 Milliarden hochwertige Tokens pro Datenart."},
	{cmd="finish",title="Laufendes Training abschließen",body="Den bestehenden Trainingslauf mit seinen normalen Modellwerten beenden."},
}
function Panel.toggle()
	if frame then frame.Visible=authorized and not frame.Visible end
end
function Panel.mount(parent: Frame)
	local launch=Kit.button(parent,"ADMIN","secondary",UDim2.fromOffset(134,38))
	launch.Name="AdminLauncher";launch.Position=UDim2.new(0,16,1,-16);launch.AnchorPoint=Vector2.new(0,1);launch.Visible=false
	Kit.onClick(launch,Panel.toggle)
	local box=Kit.panel(parent,UDim2.fromOffset(610,610),UDim2.fromScale(.5,.5))
	box.Name="AdminPanel";box.AnchorPoint=Vector2.new(.5,.5);box.Visible=false;frame=box
	local scale=Instance.new("UIScale");scale.Parent=box
	local function resize()
		local camera=workspace.CurrentCamera
		if camera then scale.Scale=math.max(.3,math.min(1,(camera.ViewportSize.X-24)/610,(camera.ViewportSize.Y-40)/610)) end
	end
	resize();if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
	Kit.padding(box,22,22,20,22)
	local heading=Kit.text(box,"Campus-Kontrolle",25,Theme.font.bold,Theme.colors.text)
	local caption=Kit.text(box,"Nonortrttrt  /  Administrator",13,Theme.font.medium,Theme.colors.muted);caption.Position=UDim2.fromOffset(0,38)
	local close=Kit.button(box,"Schließen","ghost",UDim2.fromOffset(90,30));close.Position=UDim2.new(1,-90,0,2);Kit.onClick(close,Panel.toggle)
	local scroller=Kit.scroll(box,UDim2.new(1,0,1,-80),UDim2.fromOffset(0,78))
	Kit.list(scroller,9);Kit.padding(scroller,0,8,8,0)
	for i,def in actions do
		local row=Kit.card(scroller,i)
		local b=Kit.button(row,def.title,if i==1 then "primary" else "secondary",UDim2.new(1,0,0,36));b.LayoutOrder=1
		Kit.para(row,def.body,13,Theme.colors.muted,2)
		Kit.onClick(b,function()
			if not authorized then return end
			task.spawn(function()
				Kit.setDisabled(b,true)
				local ok=Action.call("AdminAction",{cmd=def.cmd})
				Kit.setDisabled(b,false)
				if ok then Toast.show("success",def.title.." · erledigt",4) end
			end)
		end)
	end
	State.onChange(function(snapshot)
		authorized=snapshot.live.admin==true;launch.Visible=authorized
		if not authorized then box.Visible=false end
	end)
end
return Panel
</ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX00000057"><Properties><string name="Name">Main</string><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">--!strict
-- Client-Einstieg: UI aufbauen, Welt verbinden, Zustand vom Server abholen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end
ReplicatedStorage:WaitForChild("Shared")

local Client = script.Parent
local CompanyConfig = require(ReplicatedStorage.Shared.Config.CompanyConfig)
local StateController = require(Client.Controllers.StateController)
local WorldController = require(Client.Controllers.WorldController)
local CampusController=require(Client.Controllers.CampusController)
local SecurityController=require(Client.Controllers.SecurityController)
local EmployeeController=require(Client.Controllers.EmployeeController)
local JourneyController=require(Client.Controllers.JourneyController)
local BuildingEffectsController=require(Client.Controllers.BuildingEffectsController)
local Theme = require(Client.UI.Theme)
local UIRoot = require(Client.UI.UIRoot)
local Toast = require(Client.UI.Toast)
local HUD = require(Client.UI.Screens.HUD)
local Computer = require(Client.UI.Screens.Computer)
local Intro = require(Client.UI.Screens.Intro)
local DebugPanel = require(Client.UI.DebugPanel)
local AdminPanel=require(Client.UI.AdminPanel)

-- Platz für das eigene HUD oben rechts: Spielerliste und Rucksack braucht das Spiel nicht
for _, coreType in { Enum.CoreGuiType.PlayerList } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreType, false)
	end)
end

local hud, dimLayer, overlay, introLayer, top = UIRoot.init()
Toast.mount(top)
AdminPanel.mount(top)

local devAllowed = DebugPanel.allowed()
HUD.mount(hud, devAllowed, DebugPanel.toggle)
HUD.setHidden(true)
Computer.mount(overlay, dimLayer)
Intro.mount(introLayer, {
	onFinish = function()
		HUD.setHidden(false)
	end,
	onReopen = function()
		Computer.close()
		HUD.setHidden(true)
	end,
})
if devAllowed then
	DebugPanel.mount(top)
end

-- Firmenfarbe = Akzentfarbe der gesamten UI
StateController.onChange(function(snapshot)
	local company = snapshot.data.company
	if company then
		local def = CompanyConfig.getColor(company.color)
		if def then
			Theme.setAccent(Theme.rgb(def.rgb))
		end
	end
end)

WorldController.init(function(appId,section)
	Computer.open(appId,section)
end)
CampusController.init()
SecurityController.init()
EmployeeController.init()
JourneyController.init()
BuildingEffectsController.init()
StateController.init()
