</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000014"><Properties><string name="Name">EmployeeRigDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Original R6-compatible rigs. No downloaded avatars, clothes or animation asset IDs.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Collection=game:GetService("CollectionService")
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local Rig={}
local skins={Color3.fromRGB(226,183,143),Color3.fromRGB(150,103,76),Color3.fromRGB(240,208,174),Color3.fromRGB(105,76,58),Color3.fromRGB(197,145,102),Color3.fromRGB(209,174,153)}
local clothes={Color3.fromRGB(65,85,99),Color3.fromRGB(163,134,107),Color3.fromRGB(94,113,90),Color3.fromRGB(110,97,123),Color3.fromRGB(183,180,166),Color3.fromRGB(75,82,88),Color3.fromRGB(169,149,131)}
function Rig.build(parent: Instance,owner: number,index: number,role: string,pose: CFrame): Model
 local job=if role=="support" then ({"Reception","Reception","Security","Security","Facilities","IT Support","Barista","Chef","Kitchen Team","Cafe Host","Facilities","Fleet"})[index-300] else Config.ROLES[role]
 local seed=Config.seed(index,owner);local scale=.94+(seed%15)/100
 local skin=skins[seed%#skins+1];local outfit=clothes[(seed//7)%#clothes+1];if job=="Security" then outfit=Color3.fromRGB(43,58,69) end
 local hair=if seed%3==0 then Color3.fromRGB(123,83,49) elseif seed%3==1 then Color3.fromRGB(46,36,30) else Color3.fromRGB(79,71,65)
 local model=Instance.new("Model");model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic;model.Name="Employee_"..index;model:SetAttribute("OwnerUserId",owner);model:SetAttribute("StaffIndex",index);model:SetAttribute("EmployeeName",CampusMath.staffName(index));model:SetAttribute("RoleId",role);model:SetAttribute("Role",job or "Campus Operations");model:SetAttribute("AccessClass","employee");model:SetAttribute("Activity","ARRIVING");model:SetAttribute("PersonalitySeed",seed);model:SetAttribute("StaffAnimated",true)
