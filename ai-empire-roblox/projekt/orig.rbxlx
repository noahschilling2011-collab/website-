local Config = require(script.Parent.Config.CampusConfig)
local Math = {}
function Math.new(): any
	return {snacks={},retailLevel=1,retailClock=0,retailSales=0,retailRevenue=0,cars={compact=true},selectedCar="compact",boostUntil=0,boostSpeed=16}
end
function Math.staffName(index: number): string
	return Config.FIRST_NAMES[(index-1)%#Config.FIRST_NAMES+1].." "..Config.LAST_NAMES[((index-1)//#Config.FIRST_NAMES)%#Config.LAST_NAMES+1]
end
function Math.desk(index: number): (number, number, number)
	local slot=(index-1)%Config.DESKS_PER_FLOOR
	local xs={-66,-50,-34,-18,18,34,50,66}
	return xs[slot%8+1], ((index-1)//Config.DESKS_PER_FLOOR+1)*Config.FLOOR_HEIGHT, -26+(slot//8)*16
end
function Math.inside(x: number, y: number, z: number, tier: number): boolean
	return math.abs(x)&lt;82 and z&gt;-48 and z&lt;80 and y&gt;-2 and y&lt;Config.FLOORS[tier]*16+12
		or math.abs(x)&lt;82 and z&gt;=80 and z&lt;160 and y&gt;-2 and y&lt;32
end
function Math.garage(x: number, y: number, z: number): boolean
	return x&gt;-94 and x&lt;112 and z&gt;-64 and z&lt;90 and y&gt;-27 and y&lt;-3
end
function Math.privateZone(x: number, y: number, z: number, tier: number): boolean
	local executive=(Config.FLOORS[tier]-1)*16
	if y&gt;14 and y&lt;34 and z&gt;98 and z&lt;160 and math.abs(x)&lt;82 then return true end
	if (y&gt;executive-2 and y&lt;executive+18 and x&gt;18 and z&gt;34 and z&lt;80)
		or (y&gt;executive-2 and y&lt;executive+18 and x&gt;61 and z&lt; -10)
		or (y&gt; -2 and y&lt;18 and x&lt;-40 and z&gt;40 and z&lt;80) then return true end
	for _,r in Config.ROOMS do
		if r.access=="owner" and y&gt;r.floor*16-2 and y&lt;r.floor*16+18 and x&gt;r.x1-1 and x&lt;r.x2+1 and z&gt;r.z1-1 and z&lt;r.z2+1 then return true end
	end
	return false
end
function Math.staffAllowed(x: number,y: number,z: number,tier: number): boolean
	return not Math.privateZone(x,y,z,tier) and y&lt;Config.FLOORS[tier]*16
end
function Math.drive(speed: number, throttle: number, steer: number, dt: number, def: any): (number, number)
	local target=if throttle&gt;=0 then throttle*def.speed else throttle*def.reverse
	local delta=math.clamp(target-speed,-def.acceleration*dt,def.acceleration*dt)
	local nextSpeed=speed+delta
	if math.abs(nextSpeed)&lt;.15 then nextSpeed=0 end
	local turn= -steer*def.turn*math.clamp(math.abs(nextSpeed)/18,0,1)*(if nextSpeed&lt;0 then -1 else 1)
	return nextSpeed,turn
end
function Math.finiteUnit(value: any): boolean
	return typeof(value)=="number" and value==value and value&gt;-math.huge and value&lt;math.huge and math.abs(value)&lt;=1
end
return Math
