 joint("Right Shoulder",torso,rightArm,CFrame.new(scale,.5*scale,0),CFrame.new(-.5*scale,.5*scale,0))
 joint("Left Hip",torso,leftLeg,CFrame.new(-.5*scale,-scale,0),CFrame.new(0,scale,0))
 joint("Right Hip",torso,rightLeg,CFrame.new(.5*scale,-scale,0),CFrame.new(0,scale,0))
 local function accessory(name: string,size: Vector3,at: CFrame,color: Color3,target: BasePart)
  local p=part(name,size,at,color);local weld=Instance.new("WeldConstraint");weld.Part0=target;weld.Part1=p;weld.Parent=p;return p
 end
 accessory("Hair",Vector3.new(2.03,.35,1.1),CFrame.new(0,2.05*scale,.04),hair,head)
 if seed%4==0 then accessory("LongHair",Vector3.new(2,.9,.35),CFrame.new(0,1.52*scale,.52*scale),hair,head)
 elseif seed%4==1 then accessory("SidePart",Vector3.new(1.3,.23,1.1),CFrame.new(.3*scale,2.27*scale,0)*CFrame.Angles(0,0,-.12),hair,head)
 elseif seed%4==2 then accessory("HairBun",Vector3.new(.55,.55,.55),CFrame.new(0,2.1*scale,.63*scale),hair,head).Shape=Enum.PartType.Ball end
 for _,side in {-1,1} do
  accessory("Hand",Vector3.new(.98,.5,.98),CFrame.new(side*1.5*scale,-.75*scale,0),skin,if side&lt;0 then leftArm else rightArm)
  accessory("Sneaker",Vector3.new(.98,.35,1.1),CFrame.new(side*.5*scale,-2.85*scale,-.04),Color3.fromRGB(216,215,202),if side&lt;0 then leftLeg else rightLeg)
 end
 if seed%3==0 or role=="marketer" then
  accessory("Overshirt",Vector3.new(.6,1.8,.08),CFrame.new(-.68*scale,0,-.55*scale),outfit:Lerp(Color3.fromRGB(235,228,211),.3),torso)
  accessory("Overshirt",Vector3.new(.6,1.8,.08),CFrame.new(.68*scale,0,-.55*scale),outfit:Lerp(Color3.fromRGB(235,228,211),.3),torso)
 elseif seed%3==1 then accessory("Hood",Vector3.new(1.3,.5,.6),CFrame.new(0,.84*scale,.46*scale),outfit,torso) end
 accessory("Lanyard",Vector3.new(.1,1.25,.05),CFrame.new(0,.18*scale,-.57*scale),Color3.fromRGB(155,178,161),torso)
 accessory("IDBadge",Vector3.new(.5,.6,.06),CFrame.new(0,-.5*scale,-.59*scale),Color3.fromRGB(227,230,215),torso)
 local face=Instance.new("SurfaceGui");face.Name="Face";face.Face=Enum.NormalId.Front;face.CanvasSize=Vector2.new(200,100);face.LightInfluence=1;face.MaxDistance=40;face.Parent=head
 for _,x in {65,126} do local eye=Instance.new("Frame");eye.Size=UDim2.fromOffset(8,12);eye.Position=UDim2.fromOffset(x,38);eye.BackgroundColor3=Color3.fromRGB(34,31,28);eye.BorderSizePixel=0;eye.Parent=face end
 local mouth=Instance.new("TextLabel");mouth.Text=if seed%3==0 then "⌣" else "‿";mouth.TextSize=32;mouth.BackgroundTransparency=1;mouth.TextColor3=Color3.fromRGB(67,42,32);mouth.Size=UDim2.fromOffset(80,32);mouth.Position=UDim2.fromOffset(60,56);mouth.Parent=face
