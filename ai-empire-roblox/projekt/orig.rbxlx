</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000023"><Properties><string name="Name">HeadquartersDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- A complete, walkable headquarters. Built from original geometry; no external assets.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Math=require(ReplicatedStorage.Shared.CampusMath)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local FacilitiesDesign=require(script.Parent.OfficeFacilitiesDesign)
local Departments=require(script.Parent.DepartmentDesign)
local K=require(script.Parent.OfficeKit)
local Rig=require(script.Parent.EmployeeRigDesign)
local EmployeeConfig=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local DepartmentConfig=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local Design={}
local ink=Color3.fromRGB(41,49,46)
local stone=Color3.fromRGB(210,208,193)
local wood=Color3.fromRGB(160,122,82)
local paper=Color3.fromRGB(238,235,221)
local green=Color3.fromRGB(82,110,85)
local glass=Color3.fromRGB(155,185,176)
local function part(parent: Instance,cf: CFrame,name: string,size: Vector3,pos: CFrame,color: Color3,material: Enum.Material?): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf*pos;p.Anchored=true;p.Color=color
	p.Material=material or Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
	return p
end
local function label(p: BasePart,text: string,color: Color3?): TextLabel
	local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Front;g.CanvasSize=Vector2.new(900,420);g.LightInfluence=.5;g.Parent=p
	local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1);t.Text=text;t.TextScaled=true;t.TextWrapped=true
	t.TextColor3=color or paper;t.Font=Enum.Font.BuilderSansBold;t.Parent=g;return t
end
local function prompt(p: BasePart,text: string,owner: number?,app: string?,action: string?,value: any?): ProximityPrompt
	local q=Instance.new("ProximityPrompt");q.ActionText=if action then "Use" else "Open";q.ObjectText=text;q.MaxActivationDistance=12;q.RequiresLineOfSight=false;q.HoldDuration=0
	if owner then q:SetAttribute("OwnerUserId",owner) else q:SetAttribute("Public",true) end
	if app then q:SetAttribute("App",app) end
	if action then q:SetAttribute("CampusAction",action);q:SetAttribute("Value",value) end
	q.Parent=p;return q
end
local function plant(parent: Instance,cf: CFrame,x: number,y: number,z: number,big: boolean?)
	local a=part(parent,cf,"Planter",Vector3.new(3,1.7,3),CFrame.new(x,y+.85,z),stone,Enum.Material.Concrete)
	part(parent,cf,"Soil",Vector3.new(2.7,.2,2.7),CFrame.new(x,y+1.75,z),Color3.fromRGB(65,57,43))
	local h=if big then 9 else 3
	part(parent,cf,"Trunk",Vector3.new(.6,h,.6),CFrame.new(x,y+1.8+h/2,z),wood,Enum.Material.Wood)
	for i=1,3 do
		local leaf=part(parent,cf,"Foliage",Vector3.new(if big then 8-i else 3.4-i*.3,2.1,if big then 7-i else 3.1),CFrame.new(x+(i%2)*.5,y+1.8+h-i*.9,z),green,Enum.Material.Grass)
		leaf.CanCollide=false
	end
	a:SetAttribute("CampusDetail",true)
end
local function chair(parent: Instance,cf: CFrame,x: number,y: number,z: number)
	local seat=Instance.new("Seat");seat.Name="ChairSeat";seat.Size=Vector3.new(2.8,.45,2.8);seat.CFrame=cf*CFrame.new(x,y+2.1,z);seat.Color=green;seat.Material=Enum.Material.Fabric;seat.Anchored=true;seat.Parent=parent
	part(parent,cf,"ChairBack",Vector3.new(2.8,2.5,.4),CFrame.new(x,y+3.4,z-1.3),green,Enum.Material.Fabric)
	part(parent,cf,"ChairStem",Vector3.new(.3,1.5,.3),CFrame.new(x,y+1.1,z),ink,Enum.Material.Metal)
end
local function desk(parent: Instance,cf: CFrame,x: number,y: number,z: number,accent: Color3,index: number)
	part(parent,cf,"StaffDesk",Vector3.new(10,.45,5),CFrame.new(x,y+3.1,z),wood,Enum.Material.Wood)
	for _,dx in {-4,4} do part(parent,cf,"DeskLeg",Vector3.new(.4,2.8,3.5),CFrame.new(x+dx,y+1.5,z),ink,Enum.Material.Metal) end
	part(parent,cf,"MonitorStand",Vector3.new(.5,1.1,.45),CFrame.new(x,y+3.9,z+.9),ink)
	part(parent,cf,"StaffDisplay",Vector3.new(3.8,2.3,.25),CFrame.new(x,y+4.9,z+.9),ink)
	local screen=part(parent,cf,"DisplayContent",Vector3.new(3.5,2,.04),CFrame.new(x,y+4.9,z+.74),accent:Lerp(ink,.72));screen.CanCollide=false
	for row=1,3 do part(parent,cf,"EditorLine",Vector3.new(1.3+row*.4,.08,.04),CFrame.new(x-.3,y+4.2+row*.4,z+.70),paper).CanCollide=false end
	part(parent,cf,"Keyboard",Vector3.new(2.8,.15,1),CFrame.new(x,y+3.4,z-.9),ink)
	part(parent,cf,"Notebook",Vector3.new(1.7,.12,2.1),CFrame.new(x+3.2,y+3.4,z-.2)*CFrame.Angles(0,index*.23,0),paper)
	part(parent,cf,"Mug",Vector3.new(.6,.7,.6),CFrame.new(x-3.6,y+3.7,z-.3),if index%3==0 then accent else paper)
	chair(parent,cf,x,y,z-4)
end
function Design.staff(office: Model,cf: CFrame,session: any)
 local previous=office:FindFirstChild("Employees");if previous then previous:Destroy() end
 local folder=Instance.new("Folder");folder.Name="Employees";folder.Parent=office
 local seats={}
 for _,m in office:GetDescendants() do if m:IsA("Model") and m:GetAttribute("WorkstationType")=="Computer" then table.insert(seats,m) end end
 table.sort(seats,function(a,b)return a.Name&lt;b.Name end)
 local assigned={};local index=0;local key=""
 for _,role in EmpireConfig.ROLES do
  key..=role.id..tostring(session.data.empire.employees[role.id] or 0)
  for _=1,session.data.empire.employees[role.id] or 0 do
   index+=1;local best=nil;local score=-math.huge
   for _,w in seats do
    local pos=cf:PointToObjectSpace(w:GetAttribute("InteractionPosition"))
    if not assigned[w] and DepartmentConfig.employeeAllowed(role.id,pos.X,pos.Y,pos.Z,session.data.empire.office)
     and DepartmentConfig.doorAllowed(role.id,w:GetAttribute("RoomAccess")) then
     local value=(if w:GetAttribute("PreferredRole")==role.id then 1000 else 0)-(w:GetAttribute("Floor") or 0)*5
     if value&gt;score then best=w;score=value end
    end
   end
   local work=if best then best:GetAttribute("SeatPosition")*CFrame.new(0,1.6,0) else cf*CFrame.new(0,3,-14)
   if best then assigned[best]=true end
   local employee=Rig.build(folder,session.userId,index,role.id,work)
   employee:SetAttribute("HomeWorkstation",if best then best:GetAttribute("WorkstationId") else "")
   employee:SetAttribute("WorkCFrame",work);employee:SetAttribute("CampusCFrame",cf);employee:SetAttribute("StaffFloor",if best then best:GetAttribute("Floor")*16 else 0)
   local localPos=cf:PointToObjectSpace(work.Position);employee:SetAttribute("StaffX",localPos.X);employee:SetAttribute("StaffZ",localPos.Z)
  end
 end
 office:SetAttribute("StaffKey",key);office:SetAttribute("StaffCount",index)
end
function Design.build(cf: CFrame,session: any,accent: Color3): Model
	local tier=session.data.empire.office;local floors=Config.FLOORS[tier];local owner=session.userId
	local office=Instance.new("Model");office.Name="Office";office:SetAttribute("OwnerUserId",owner);office:SetAttribute("OfficeTier",tier);office:SetAttribute("FloorCount",floors);office:SetAttribute("CampusCFrame",cf)
