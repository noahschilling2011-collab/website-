-- Distance-limited screen alerts and a single quiet local room ambience.
local Collection=game:GetService("CollectionService")
local RunService=game:GetService("RunService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusAudioConfig)
local Controller={}
local screens: {[BasePart]:boolean}={};local fans: {[BasePart]:boolean}={};local clock=0
local ambience: Sound?=nil;local current=""
local function add(p: Instance)if p:IsA("BasePart") then screens[p]=true end end
function Controller.init()
 for _,p in Collection:GetTagged("ClusterFan") do fans[p]=true end
 Collection:GetInstanceAddedSignal("ClusterFan"):Connect(function(p)fans[p]=true end)
 Collection:GetInstanceRemovedSignal("ClusterFan"):Connect(function(p)fans[p]=nil end)
 for _,p in Collection:GetTagged("CompanyScreen") do add(p) end
 Collection:GetInstanceAddedSignal("CompanyScreen"):Connect(add)
 Collection:GetInstanceRemovedSignal("CompanyScreen"):Connect(function(p)screens[p]=nil end)
 RunService.Heartbeat:Connect(function(dt)
  clock+=dt;if clock&lt;.2 then return end;clock=0
  local camera=workspace.CurrentCamera;if not camera then return end
  for p in fans do if p.Parent and (p.Position-camera.CFrame.Position).Magnitude&lt;120 then
   local office=p:FindFirstAncestor("Office");p.CFrame=p:GetAttribute("FanHome")*CFrame.Angles(0,0,workspace:GetServerTimeNow()*(if office and office:GetAttribute("Training") then 8 else 2))
  end end
  local nearestKind="";local distance=35
  for p in screens do
   if not p.Parent then screens[p]=nil;continue end
   local d=(camera.CFrame.Position-p.Position).Magnitude
   if d&lt;120 and p:GetAttribute("TrainingAlert") then
    local gui=p:FindFirstChild("Desktop");local header=if gui then gui:FindFirstChild("Header") else nil
    if header then header.TextColor3=if math.sin(workspace:GetServerTimeNow()*3)&gt;0 then Color3.fromRGB(219,171,88) else Color3.fromRGB(190,207,182) end
   end
   if d&lt;distance then nearestKind=p:GetAttribute("LiveScreen");distance=d end
  end
  local kind=if nearestKind=="compute" then "compute" elseif nearestKind=="growth" or nearestKind=="engineering" or nearestKind=="research" or nearestKind=="data" then "office" else ""
  local office=nil
  for p in screens do if p.Parent and (p.Position-camera.CFrame.Position).Magnitude&lt;100 then office=p:FindFirstAncestor("Office");if office then break end end end
  if office then local cf=office:GetAttribute("CampusCFrame");local v=cf:PointToObjectSpace(camera.CFrame.Position)
   if v.Y&lt; -3 then kind="garage" elseif v.Y&lt;15 and v.X&gt;19 and v.X&lt;80 and v.Z&gt; -44 and v.Z&lt;44 then kind="kitchen" end
  end
  local id=Config.AMBIENCE[kind]
  if current~=kind then
   if ambience then ambience:Destroy();ambience=nil end;current=kind
   if id and id~="" then local s=Instance.new("Sound");s.Name="CampusAmbience";s.SoundId=id;s.Volume=.08;s.Looped=true;s.Parent=camera;s:Play();ambience=s end
  end
 end)
end
return Controller
