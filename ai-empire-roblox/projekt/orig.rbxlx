	local secretSwitch=add("SecretExitSwitch",Vector3.new(1,2,.25),10,20,135,green);action(secretSwitch,"roomDoor","Return to archive","secret",true)
	-- Upgrade the founder's bathroom and computer without creating overlapping old fixtures.
	for _,name in {"BathroomSeat","BathroomTank","Washbasin","Mirror"} do local old=office:FindFirstChild(name);if old then old:Destroy() end end
	local executive=(Config.FLOORS[session.data.empire.office]-1)*16
	toilet(75,executive,-23,true);tap(75,executive,-37,true)
	local chief=office:FindFirstChild("FounderTerminal")
	if chief then local q=chief:FindFirstChildOfClass("ProximityPrompt");if q then q:SetAttribute("App",nil);q:SetAttribute("CampusAction","ownerComputer");q:SetAttribute("Value","empire");q:SetAttribute("OwnerOnly",true);q.ObjectText="Chef-Computer · gesamte Firma" end end
	local cctv=add("FounderCameraTablet",Vector3.new(2.8,.25,2.1),52,executive+3.5,59,green);action(cctv,"security","Chef · Gebäudekameras",nil,true)
	-- Coverage includes every main floor, the front, basement, roof, wellness and private pavilion.
