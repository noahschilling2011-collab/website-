-- Live architecture: every value comes from the same session that owns the building.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local EmpireMath=require(ReplicatedStorage.Shared.EmpireMath)
local Workforce=require(ReplicatedStorage.Shared.WorkforceMath)
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local Format=require(ReplicatedStorage.Shared.Format)
local ModelConfig=require(ReplicatedStorage.Shared.Config.ModelConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local Plot=require(script.Parent.PlotService)
local Session=require(script.Parent.SessionService)
local Service={}
local clock=0;local caches: {[Instance]:any}=setmetatable({},{__mode="k"}) :: any
local function proximity(position: Vector3,positions: {Vector3}): number
 local min=math.huge;for _,p in positions do min=math.min(min,(p-position).Magnitude) end;return min
end
local function scan(office: Model): any
 local cache=caches[office];if cache then return cache end;cache={screens={}}
 for _,p in office:GetDescendants() do if p:IsA("BasePart") and p:GetAttribute("LiveScreen") then table.insert(cache.screens,p) end end
 caches[office]=cache;return cache
end
local function title(model: any): string return if model then model.name.." v"..model.version else "No model yet" end
function Service.assetValue(data: any): number
 local total=data.money
 for _,gpu in HardwareConfig.GPUS do total+=(data.gpus[gpu.id] or 0)*(gpu.price or 0) end
 for i=2,data.empire.office do total+=EmpireConfig.OFFICES[i].price end
 for _,car in CampusConfig.CARS do if data.empire.campus.cars[car.id] then total+=car.price end end
 return total
end
function Service.presentation(s: any,kind: string,w: Model?): (string,string,string,number)
 local d=s.data;local e=d.empire;local stock=ModelMath.dataSummary(d.data);local fleet=ModelMath.fleet(d.gpus);local training=d.training
 local current=if training then d.models[training.modelId] else Journey.latest(d)
 local progress=if training then math.clamp(training.workDone/math.max(1,training.workTotal),0,1) else 0
 local loss=if training then training.loss[#training.loss] else nil
 local pending=training and training.event and training.event.pending
 local company=if d.company then d.company.name else "Your Company"
 local footer="DATA → COMPUTE → DESIGN → TRAIN → EVALUATE → LAUNCH"
 if w and w:GetAttribute("OccupiedBy") then
  if (w:GetAttribute("LoginUntil") or 0)&gt;workspace:GetServerTimeNow() then return "EMPLOYEE LOGIN",w:GetAttribute("EmployeeName") or "",company,0 end
  local taskId=w:GetAttribute("Software")
  if kind=="secondary" then return "COMPANY OS / TEAM",string.format("%s\nTask  %s\nWorkstation  %s\nData  %s tokens\nCompany hour  %.1f",w:GetAttribute("EmployeeName") or "Employee",taskId or "Working",w:GetAttribute("WorkstationId") or "",Format.tokens(stock.total),s.live.workforce and s.live.workforce.hour or 8),company,0 end
  if taskId=="CleanDataset" or taskId=="CheckQuality" or taskId=="MonitorPipeline" then kind="data"
  elseif taskId=="WriteCode" then kind="engineering"
  elseif taskId=="MonitorTraining" then kind="training"
  elseif taskId=="RunExperiment" or taskId=="ArchitectureStudy" then kind="research"
  elseif taskId=="AnalyzeModel" or taskId=="ReviewModel" then kind="evaluation"
  elseif taskId=="AnalyzeMarket" or taskId=="CheckCustomers" or taskId=="PlanLaunch" then kind="growth" end
  footer=(w:GetAttribute("EmployeeName") or "Employee").." / "..(taskId or "Working")
 elseif w and w:GetAttribute("WorkstationType")=="Computer" then return company,"WORKSTATION LOCKED\nAvailable for your team's next task.\nUse this terminal to open Company OS.","SECURE / EMPLOYEE CARD",0 end
 if kind=="data" then
  local general=d.data.general;local code=d.data.code;local mathData=d.data.math
  return "DATA OPERATIONS",string.format("General  %s tokens\nCode       %s tokens\nMath       %s tokens\nQuality    %.1f%%\nCurator production  %s tokens/s",Format.tokens(if general then general.tokens else 0),Format.tokens(if code then code.tokens else 0),Format.tokens(if mathData then mathData.tokens else 0),stock.quality*100,Format.tokens(Workforce.count(e,"curator")*300000)),footer,stock.quality
 elseif kind=="compute" or kind=="training" then
  return if pending then "TRAINING DECISION REQUIRED" else if training then "MODEL TRAINING" else "GPU CLUSTER / IDLE",string.format("%s\n%d GPUs  /  %d GB VRAM\nProgress  %.1f%%   /   Epoch %d / 10\nLoss  %s  /  Estimate %.1f\nCooling  %d / 8",title(current),fleet.slotsUsed,fleet.vram,progress*100,if training then training.epoch else 0,if loss then string.format("%.3f",loss) else "—",if training then training.expected else 0,e.infrastructure.cooling),footer,progress
 elseif kind=="engineering" then
  local mode=if w then w:GetAttribute("WorkstationId") or "" else ""
  if #mode%2==0 then return "AI EMPIRE / DEV",string.format("model = %q\ndata.tokens = %s\ncompute.vram = %d GB\ntraining.status = %q\nteam.engineers = %.1f",title(current),Format.tokens(stock.total),fleet.vram,if training then "RUNNING" else "IDLE",Workforce.count(e,"engineer")),footer,progress end
  return Service.presentation(s,"training",nil)
 elseif kind=="research" then
  local job=e.researchJob;local p=if job then job.elapsed/math.max(1,job.seconds) else 0
  return if job then "RESEARCH ACTIVE" else "RESEARCH / ARCHITECTURE",string.format("Study  %s\nProgress  %.1f%%\nResearch points  %s\nProduction  %.1f points/s\nBetter architecture helps your next model.",if job then job.id else "No active study",p*100,Format.compact(e.points),EmpireMath.bonuses(e).points),footer,p
 elseif kind=="design" then return "MODEL ARCHITECTURE",string.format("100M  /  4 GB VRAM  /  first model\n500M  /  12 GB VRAM /  lower cost\n7B      /  128 GB VRAM / frontier research\nChoose SIZE + FOCUS + RECIPE\nGood data still determines quality."),footer,0
 elseif kind=="evaluation" then
  local m=Journey.latest(d);if not m then return "MODEL EVALUATION","No trained model yet.\nTrain a model, then compare its six benchmark scores here.",footer,0 end
  return "EVALUATION / "..title(m),string.format("Reasoning %.1f   Coding %.1f\nMath %.1f          Creativity %.1f\nKnowledge %.1f  Reliability %.1f\nOverall %.1f\n%s",m.stats.reasoning or 0,m.stats.coding or 0,m.stats.math or 0,m.stats.creativity or 0,m.stats.knowledge or 0,m.stats.reliability or 0,m.overall,if m.status=="trained" then "READY FOR RELEASE" else string.upper(m.status)),footer,math.min(1,m.overall/100)
 elseif kind=="growth" or kind=="deployment" then
  return "DEPLOYMENT / CUSTOMERS",string.format("Users  %s\nRevenue  %s\nAPI customers  %d\nLive releases  %d\nModel → pricing → target → marketing → launch",Format.compact(s.live.users),Format.perMinute(s.live.revenue),#e.customers,d.stats.modelsReleased),footer,0
 elseif kind=="milestones" then return "COMPANY MILESTONES",string.format("Models trained  %d\nModels launched  %d\nBest benchmark  %.1f\nTotal revenue  %s\nYour next generation starts here.",d.stats.modelsTrained,d.stats.modelsReleased,d.stats.bestOverall,Format.money(d.stats.totalRevenue)),company,0
 elseif kind=="history" then
  local lines={};for i=math.max(1,#d.modelOrder-4),#d.modelOrder do local m=d.models[d.modelOrder[i]];if m then table.insert(lines,title(m).." / "..m.status.." / "..string.format("%.1f",m.overall or 0)) end end
  return "MODEL HISTORY",if #lines&gt;0 then table.concat(lines,"\n") else "Your first trained model starts the story.",company,0
 elseif kind=="journey" then
  local flow=Journey.progress(d);return "BUILD YOUR FIRST AI",string.format("%d / 7  /  %s\n%s\nDATA → GPU → MODEL → TRAIN\nEVALUATE → RELEASE → GROW",flow.index,string.upper(flow.step.title),flow.step.body),flow.hint,(flow.index-1)/7
 else
  local rank="Not listed";if s.live.rankings and s.live.rankings.boards then for i,row in s.live.rankings.boards.overall or {} do if row.userId==s.userId then rank="#"..i.." / "..s.live.rankings.status;break end end end
  return if kind=="founder" then "FOUNDER / "..company elseif kind=="boardroom" then "COMPANY REVIEW" else company,string.format("Users %s / Revenue %s\nTeam %d / GPUs %d\nBest AI %.1f / Rank %s\nCash %s / Total revenue %s",Format.compact(s.live.users),Format.perMinute(s.live.revenue),EmpireMath.staff(e),fleet.slotsUsed,d.stats.bestOverall,rank,Format.money(Service.assetValue(d)),Format.money(d.stats.totalRevenue)),footer,0
 end
end
local function write(s: any,p: BasePart,time: number)
 local gui=p:FindFirstChild("Desktop");if not gui then return end
 local w=p.Parent;if not w:IsA("Model") or not w:GetAttribute("WorkstationId") then w=nil end
 local kind=p:GetAttribute("LiveScreen");local header,body,footer,fill
 if w and w:GetAttribute("OccupiedBy") and (w:GetAttribute("LoginUntil") or 0)&gt;time then
  header="EMPLOYEE LOGIN";body=w:GetAttribute("EmployeeName") or "";footer="Company OS / secure session";fill=.15
 elseif kind=="lobby" or kind=="boardroom" or kind=="founder" then
  local d=s.data;local best=Journey.latest(d);local rank="Not listed"
  if s.live.rankings and s.live.rankings.boards then for i,row in s.live.rankings.boards.overall or {} do if row.userId==s.userId then rank="#"..i;break end end end
  header=if kind=="founder" then "FOUNDER / COMPANY CONTROL" elseif kind=="boardroom" then (p:FindFirstAncestor("Office"):GetAttribute("MeetingTopic") or "COMPANY REVIEW") else (if d.company then d.company.name else "YOUR COMPANY")
  body=string.format("Users %s   /   Revenue %s\nTeam %d    /    GPUs %d\nBest AI %.1f   /   Rank %s\nAsset value %s  /  Total revenue %s\n%s",Format.compact(s.live.users),Format.perMinute(s.live.revenue),EmpireMath.staff(d.empire),ModelMath.fleet(d.gpus).slotsUsed,d.stats.bestOverall,rank,Format.money(Service.assetValue(d)),Format.money(d.stats.totalRevenue),if d.training then "Training "..title(d.models[d.training.modelId]) else title(best))
  footer="Live company data / "..(if s.live.rankings then s.live.rankings.status else "Rankings loading");fill=0
 else header,body,footer,fill=Service.presentation(s,kind,w) end
 for name,text in {Header=header,Body=body,Footer=footer} do local label=gui:FindFirstChild(name);if label and label.Text~=text then label.Text=text end end
 local track=gui:FindFirstChild("ProgressTrack");if track then local bar=track:FindFirstChild("Fill");if bar then bar.Size=UDim2.fromScale(math.clamp(fill,0,1),1) end end
 p:SetAttribute("TrainingAlert",s.data.training~=nil and s.data.training.event~=nil and s.data.training.event.pending==true)
end
function Service.tick(dt: number)
 clock+=dt;if clock&lt;1 then return end;clock=0
 local positions={};for _,s in Session.all() do if not s.closed and s.player.Character and s.player.Character.PrimaryPart then table.insert(positions,s.player.Character.PrimaryPart.Position) end end
 local time=workspace:GetServerTimeNow()
 for _,p in Plot.all() do if p.office and p.owner then
  local s=Session.get(p.owner);if not s or s.closed then continue end
  for _,screen in scan(p.office).screens do
   local distance=proximity(screen.Position,positions)
   if screen.Parent and distance&lt;250 then local interval=if distance&lt;120 then 1 else 6
    if (screen:GetAttribute("NextScreenUpdate") or 0)&lt;=time then write(s,screen,time);screen:SetAttribute("NextScreenUpdate",time+interval) end
   end
  end
  p.office:SetAttribute("Training",s.data.training~=nil);p.office:SetAttribute("TrainingAlert",s.data.training~=nil and s.data.training.event~=nil and s.data.training.event.pending==true)
 end end
end
return Service
