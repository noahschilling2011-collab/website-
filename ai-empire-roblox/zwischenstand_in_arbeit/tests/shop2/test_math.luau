--!nocheck
-- shop package (SHOP_SPEC 9), the pure parts on the real modules in the mock:
--   T13 ShopMath: eurekaUsesLeft, savingText rounding, buy minimums (30 s / RP short / 20 s), the stranding check,
--       DUTY_PEAK, shareWords, cashText
--   T14 buy guards (Eureka uses left, daily caps, cash packs once per office, owned passes, bundle with a part owned)
--   T15 gate (guide running, no launch yet, 10 s after a failed action, Studio id 0 = preview, unpriced = none)
--   T16 Studio offer (SHOP_SPEC 5.2.4 rule 1-4 with the real LabPreview.estimate; withResearch is pure)
--   T21 texts: every ShopConfig name / tag / tab / text equals SHOP_SPEC section 2 (generated by spec_texts.py);
--       no forbidden word in any shop string
-- Run: tests/shop2/run.sh (generates .spec_texts.luau, then: cd tests/shop2 && ../../tools/luau test_math.luau -a .gen_shop2)
local M = require("../../harness/mock")
local args = { ... }
local GEN = "../../harness/" .. (args[1] or ".gen_shop2")
M.loadTree(require(GEN .. "/manifest"), require(GEN .. "/sources"))
M.quiet = true
local C = require("../econ/common")
local SPEC = require("./.spec_texts")
local pass, failc = 0, 0
local function check(name, ok, detail)
	if ok then pass += 1 else failc += 1; print("FAIL  " .. name .. (if detail ~= nil then "  -- " .. tostring(detail) else "")) end
end

local function deepcopy(v)
	if type(v) ~= "table" then return v end
	local out = {}
	for k, x in v do out[k] = deepcopy(x) end
	return out
end
local function deepEqual(a, b)
	if type(a) ~= type(b) then return false end
	if type(a) ~= "table" then return a == b or (a ~= a and b ~= b) end
	for k, v in a do if not deepEqual(v, b[k]) then return false end end
	for k in b do if a[k] == nil then return false end end
	return true
end

local function body()
	local R = C.load(M)
	local game = M.game
	local RS = game.ReplicatedStorage
	local Client = game.StarterPlayer.StarterPlayerScripts.Client
	local EmpireConfig = R.EmpireConfig
	local Ops = R.Ops
	local ShopConfig = M.require(RS.Shared.Config.ShopConfig)
	local ShopMath = M.require(RS.Shared.ShopMath)
	local LabPreview = M.require(Client.UI.Lab.LabPreview)
	local Format = M.require(RS.Shared.Format)
	local NOW = 20000 * 86400 + 3600
	-- test ids in memory (work/src keeps every id at 0): a real id is part 4 of the offer rule
	for i, key in { "eureka", "lastEpoch", "keynote", "overclock" } do ShopConfig.product(key).id = 9000 + i end

	local function fixture(opts)
		opts = opts or {}
		local d = C.company({ money = opts.money or 500000, staff = { researcher = 2 }, gpus = opts.gpus })
		d.empire.tutorial = { v = 1, step = 0, done = true, skipped = false, tipsOff = false, seen = {}, tips = {} }
		d.stats.modelsReleased = if opts.released == nil then 1 else opts.released
		d.shop.daily = { day = ShopMath.utcDay(NOW), used = {} }
		return d
	end
	local function ui(extra)
		local u = { live = { shop = { available = { eureka = true, lastEpoch = true, keynote = true, overclock = true } } }, priced = true, clock = 100, now = NOW }
		for k, v in extra or {} do u[k] = v end
		return u
	end
	local function allResearch(d) for _, def in EmpireConfig.RESEARCH do d.empire.research[def.id] = true end end

	------------------------------------------------------------------ T13 pure
	do
		local d = fixture()
		check("T13 fresh save: 18 Eureka uses left (8 projects + 10 Lab levels)", ShopMath.eurekaUsesLeft(d) == 18, ShopMath.eurekaUsesLeft(d))
		d.empire.researchJob = { id = "pipeline", elapsed = 5, seconds = 35 }
		check("T13 a running job still counts as a use left", ShopMath.eurekaUsesLeft(d) == 18)
		allResearch(d); d.empire.researchJob = nil; d.empire.labLevel = 10
		check("T13 tree done + Lab 10 -> 0 uses left", ShopMath.eurekaUsesLeft(d) == 0)
		check("T13 savingText 75 s -> about 1 min", ShopMath.savingText(75) == "about 1 min", ShopMath.savingText(75))
		check("T13 savingText 40 s -> about 40 s", ShopMath.savingText(40) == "about 40 s", ShopMath.savingText(40))
		check("T13 savingText 156.7 s -> about 2 min", ShopMath.savingText(156.7) == "about 2 min", ShopMath.savingText(156.7))
		check("T13 savingText 12.4 s -> 12 s", ShopMath.savingText(12.4) == "12 s", ShopMath.savingText(12.4))
		check("T13 savingText never rounds up (59.9 s -> about 50 s, NaN -> 0 s)", ShopMath.savingText(59.9) == "about 50 s" and ShopMath.savingText(0 / 0) == "0 s")

		local r = fixture()
		r.empire.points = 300
		r.empire.researchJob = { id = "pipeline", elapsed = 10, seconds = 35 } -- 25 s left
		local buy = ShopMath.eurekaCheck(r, nil, r.money, true, NOW)
		check("T13 running job, 25 s left, buy state -> TOO_SMALL (no buy button)", buy.ok == false and buy.err == "TOO_SMALL", buy.err)
		local own = ShopMath.eurekaCheck(r, nil, r.money, false, NOW)
		check("T13 owned state -> ok, saves 25 s, its 50 RP back", own.ok and own.kind == "running" and own.seconds == 25 and own.points == 50 and ShopMath.savingText(own.seconds) == "25 s", own.seconds)
		r.empire.researchJob.elapsed = 0 -- 35 s left
		check("T13 35 s left: the buy state is allowed", ShopMath.eurekaCheck(r, nil, r.money, true, NOW).ok)
		check("T13 running job: a different target -> RESEARCH_ACTIVE", ShopMath.eurekaCheck(r, "cleaning", r.money, false, NOW).err == "RESEARCH_ACTIVE")

		local idle = fixture()
		idle.empire.points = 0
		local ic = ShopMath.eurekaCheck(idle, "pipeline", idle.money, true, NOW)
		check("T13 idle project with no RP: timer + RP wait at peak speed", ic.ok and ic.kind == "idle" and ic.cost == 4000 and math.abs(ic.seconds - (35 + 50 / ShopMath.peakRate(idle, NOW))) < 1e-6, ic.seconds)
		check("T13 idle errors in server order", ShopMath.eurekaCheck(idle, "nope", 1e9, false, NOW).err == "BAD_INPUT"
			and ShopMath.eurekaCheck(idle, "architecture", 1e9, false, NOW).err == "PREREQUISITE"
			and ShopMath.eurekaCheck(idle, "pipeline", 100, false, NOW).err == "NO_MONEY")
		idle.empire.research.pipeline = true
		check("T13 idle: done project -> ALREADY_DONE", ShopMath.eurekaCheck(idle, "pipeline", 1e9, false, NOW).err == "ALREADY_DONE")

		local lab = fixture({ money = 5e6 })
		allResearch(lab); lab.empire.labLevel = 3; lab.empire.points = 100000
		local pts, cash = Ops.labCost(3)
		local lb = ShopMath.eurekaCheck(lab, "lab", lab.money, true, NOW)
		check("T13 Lab level with RP >= its RP: no buy button (NOT_SHORT)", lb.ok == false and lb.err == "NOT_SHORT", lb.err)
		local lo = ShopMath.eurekaCheck(lab, "lab", lab.money, false, NOW)
		check("T13 Lab level owned: ok, saves 0 s, still pays $", lo.ok and lo.kind == "lab" and lo.seconds == 0 and lo.cost == cash and lo.points == pts and lo.level == 3, lo.seconds)
		lab.empire.points = 0
		check("T13 Lab level short of RP, saving >= 30 s: buy allowed", ShopMath.eurekaCheck(lab, "lab", lab.money, true, NOW).ok)
		check("T13 Lab: tree open -> PREREQUISITE, L10 -> MAX_LEVEL", ShopMath.eurekaCheck(fixture(), "lab", 1e9, false, NOW).err == "PREREQUISITE"
			and (function() local x = fixture(); allResearch(x); x.empire.labLevel = 10; return ShopMath.eurekaCheck(x, "lab", 1e9, false, NOW).err == "MAX_LEVEL" end)())

		local t = fixture()
		t.training = { modelId = "m", workTotal = 1000, workDone = 400, eventRolled = true }
		local okBuy, errBuy = ShopMath.lastEpochCheck(t, 19, true, NOW)
		check("T13 Last Epoch with 19 s left: no buy button (TOO_SMALL)", okBuy == false and errBuy == "TOO_SMALL", errBuy)
		check("T13 Last Epoch 19 s left, owned: button shown", ShopMath.lastEpochCheck(t, 19, false, NOW) == true)
		check("T13 Last Epoch 20 s left: buy allowed", ShopMath.lastEpochCheck(t, 20, true, NOW) == true)
		t.training.event = { id = "x", pending = true }
		check("T13 Last Epoch with a pending decision -> DECIDE_FIRST", select(2, ShopMath.lastEpochCheck(t, 100, false, NOW)) == "DECIDE_FIRST")
		check("T13 Last Epoch without training -> NO_TRAINING", select(2, ShopMath.lastEpochCheck(fixture(), 100, false, NOW)) == "NO_TRAINING")

		-- stranding check: tree done, Lab 3, 100,000 RP, 1 Eureka owned
		local st = fixture({ money = 5e6 })
		allResearch(st); st.empire.labLevel = 3; st.empire.points = 100000
		st.shop.vouchers.eureka = 1
		check("T13 stranding: eurekaUsesLeft = 7", ShopMath.eurekaUsesLeft(st) == 7)
		check("T13 stranding: owned state on the Lab card (LEVEL UP · EUREKA ×1)", ShopMath.offerState(st, "eureka", ui()) == "owned" and ShopMath.eurekaCheck(st, "lab", st.money, false, NOW).ok)
		local anyBuy = false
		local none = deepcopy(st); none.shop.vouchers.eureka = 0
		check("T13 stranding twin without voucher: offer state buy", ShopMath.offerState(none, "eureka", ui()) == "buy")
		for _, target in { "lab", "pipeline", "frontier", nil } do
			if ShopMath.eurekaCheck(none, target, none.money, true, NOW).ok then anyBuy = true end
		end
		check("T13 stranding: no buy button anywhere (lab NOT_SHORT, projects done)", not anyBuy)

		check("T13 DUTY_PEAK within 1.69-1.71", ShopMath.DUTY_PEAK >= 1.69 and ShopMath.DUTY_PEAK <= 1.71, ShopMath.DUTY_PEAK)
		check("T13 shareWords", ShopMath.shareWords(0.1) == "10 % of" and ShopMath.shareWords(0.2) == "20 % of" and ShopMath.shareWords(0.25) == "a quarter of"
			and ShopMath.shareWords(0.3) == "30 % of" and ShopMath.shareWords(0.5) == "half of" and ShopMath.shareWords(0.75) == "three quarters of"
			and ShopMath.shareWords(1) == "the full" and ShopMath.shareWords(2) == "twice" and ShopMath.shareWords(0.33) == "33 % of")
		check("T13 cashText garage seed (S1)", ShopMath.cashText(ShopConfig.product("seed"), 1) == "+$2,700 company cash now: 10 % of the Founder Headquarters price. One per office.", ShopMath.cashText(ShopConfig.product("seed"), 1))
		check("T13 cashText garage Series B adds the first-client line", ShopMath.cashText(ShopConfig.product("seriesB"), 1) == "+$8,100 company cash now: 30 % of the Founder Headquarters price. One per office. Leaving the garage still needs your first client.")
		check("T13 cashText last stage", ShopMath.cashText(ShopConfig.product("seriesA"), 5) == "+$380,000 company cash (based on the Global AI Headquarters price). One per office.", ShopMath.cashText(ShopConfig.product("seriesA"), 5))
		check("T13 peakRate > 0 even with no researcher", ShopMath.peakRate(C.company({ staff = {} }), NOW) > 0)
	end

	------------------------------------------------------------------ T14 buy guards
	do
		local d = fixture()
		local left = ShopMath.eurekaUsesLeft(d)
		d.shop.vouchers.eureka = left - 1
		check("T14 Eureka buyable below the uses left", ShopMath.buyAllowed(d, nil, "eureka", NOW))
		d.shop.vouchers.eureka = left
		check("T14 Eureka hidden when vouchers >= uses left", not ShopMath.buyAllowed(d, nil, "eureka", NOW) and ShopMath.offerState(d, "eureka", ui()) == "owned")
		d.shop.vouchers.eureka = 0
		check("T14 Eureka offer state buy with none held", ShopMath.offerState(d, "eureka", ui()) == "buy")
		local function daily(key, used, held)
			local x = fixture()
			x.shop.daily.used[key] = used
			x.shop.vouchers[key] = held
			return ShopMath.buyAllowed(x, nil, key, NOW)
		end
		check("T14 Last Epoch hidden at 10 today with one held", not daily("lastEpoch", 10, 1))
		check("T14 Last Epoch hidden with 10 held", not daily("lastEpoch", 0, 10))
		check("T14 Last Epoch buyable at 9 today with one held", daily("lastEpoch", 9, 1))
		check("T14 Keynote hidden at 4 today with one held / with 4 held", not daily("keynote", 4, 1) and not daily("keynote", 0, 4))
		check("T14 Overclock hidden at 4 today with one held, buyable at 3", not daily("overclock", 4, 1) and daily("overclock", 3, 1))
		local yesterday = fixture()
		yesterday.shop.daily = { day = ShopMath.utcDay(NOW) - 1, used = { keynote = 4 } }
		yesterday.shop.vouchers.keynote = 1
		check("T14 yesterday's count does not hide today's buy", ShopMath.buyAllowed(yesterday, nil, "keynote", NOW) and ShopMath.dailyUsed(yesterday, "keynote", NOW) == 0)
		check("T14 boostCheck: DAILY_LIMIT at 4 today", select(2, ShopMath.boostCheck((function() local x = fixture(); x.shop.daily.used.overclock = 4; return x end)(), "overclock", NOW)) == "DAILY_LIMIT")
		-- T9 (client part): the cash pack buy chip is hidden in the office it was bought in
		local p = fixture()
		p.empire.office = 2
		check("T9 cash pack open before a purchase", ShopMath.buyAllowed(p, nil, "seriesA", NOW) and ShopMath.packOpen(p, "seriesA"))
		p.shop.packs.seriesA = 2
		check("T9 cash pack chip hidden in the same office; other sizes open", not ShopMath.buyAllowed(p, nil, "seriesA", NOW) and ShopMath.buyAllowed(p, nil, "seed", NOW))
		p.empire.office = 3
		check("T9 next office: the pack is open again", ShopMath.buyAllowed(p, nil, "seriesA", NOW))
		-- T10 (pure): bundle ownership + bundle hidden when a part is owned
		check("T10 styleCollection owns identityKit / serverGlow / stageLights", ShopMath.ownsPass({ styleCollection = true }, "identityKit") and ShopMath.ownsPass({ styleCollection = true }, "serverGlow") and ShopMath.ownsPass({ styleCollection = true }, "stageLights"))
		check("T10 styleCollection does not own vip", not ShopMath.ownsPass({ styleCollection = true }, "vip"))
		check("T10 bundle flag false: none of the parts", not ShopMath.ownsPass({ styleCollection = false }, "identityKit"))
		check("T10 bundle not sold when a part is owned", not ShopMath.buyAllowed(fixture(), { shop = { passes = { serverGlow = true } } }, "styleCollection", NOW))
		check("T10 bundle sold when no part is owned", ShopMath.buyAllowed(fixture(), { shop = { passes = { vip = true } } }, "styleCollection", NOW))
		check("T10 parts not sold with the bundle", not ShopMath.buyAllowed(fixture(), { shop = { passes = { styleCollection = true } } }, "stageLights", NOW))
	end

	------------------------------------------------------------------ T15 gate
	do
		local d = fixture()
		check("T15 gate open: guide done + first launch", ShopMath.gateOpen(d) and ShopMath.offerState(d, "eureka", ui()) == "buy")
		local g = fixture(); g.empire.tutorial.done = false
		check("T15 guide running -> no Robux button", not ShopMath.gateOpen(g) and ShopMath.offerState(g, "eureka", ui()) == nil)
		g.shop.vouchers.eureka = 2
		check("T15 guide running -> not even the owned button", ShopMath.offerState(g, "eureka", ui()) == nil)
		local sk = fixture(); sk.empire.tutorial.done = false; sk.empire.tutorial.skipped = true
		check("T15 guide skipped -> gate open", ShopMath.gateOpen(sk))
		local z = fixture({ released = 0 })
		check("T15 modelsReleased == 0 -> no Robux button", not ShopMath.gateOpen(z) and ShopMath.offerState(z, "eureka", ui()) == nil)
		check("T15 within 10 s after a failed action (NO_MONEY) -> none", ShopMath.offerState(d, "eureka", ui({ lastErrorAt = 95, clock = 104.9 })) == nil)
		check("T15 10 s after the failure -> back", ShopMath.offerState(d, "eureka", ui({ lastErrorAt = 95, clock = 105.1 })) == "buy")
		check("T15 unpriced outside Studio -> none", ShopMath.offerState(d, "eureka", ui({ priced = false })) == nil)
		ShopConfig.product("eureka").id = 0
		check("T15 id 0 outside Studio -> none", ShopMath.offerState(d, "eureka", ui()) == nil)
		check("T15 Studio id 0 -> preview (Not set up)", ShopMath.offerState(d, "eureka", ui({ priced = false, studio = true })) == "preview")
		ShopConfig.product("eureka").id = 9001
		check("T15 not available on the server -> none", ShopMath.offerState(d, "eureka", ui({ live = { shop = { available = {} } } })) == nil)
		check("T15 no company -> gate closed", not ShopMath.gateOpen({ stats = { modelsReleased = 3 } }))
	end

	------------------------------------------------------------------ T16 Studio offer
	do
		local SEL = { sizeId = "s7b", focusId = "balanced", recipeId = "steady" }
		local BIG = { laptop = 1, datacenter = 2 }
		local function studio(opts)
			opts = opts or {}
			local d = fixture({ money = opts.money or 500000, gpus = opts.gpus or BIG })
			d.empire.research.pipeline = true
			d.empire.research.architecture = true
			d.data = opts.data or { general = { tokens = 6e10, quality = 0.85 } }
			return d
		end
		local function offer(d, money, u) return ShopMath.studioEurekaOffer(d, SEL, money or d.money, LabPreview.estimate, u or ui()) end
		local base = studio()
		local est = LabPreview.estimate(base, SEL, base.money)
		check("T16 fixture: 7B locked by FRONTIER only", est.lock == "FRONTIER", est.lock)
		local o = offer(base)
		check("T16 FRONTIER only -> offer (buy)", o.state == "buy" and o.check and o.check.kind == "idle" and o.check.cost == 65000, o.state)
		check("T16 owner preview in Studio with id 0", offer(base, nil, ui({ priced = false, studio = true })).state == "preview")
		local vram = studio({ gpus = { laptop = 1, workstation = 2 } }) -- 6 + 2 x 48 = 102 GB < 128
		local ov = offer(vram)
		check("T16 FRONTIER + VRAM -> no offer, need VRAM (OPEN GPUS ›)", ov.state == nil and ov.need == "VRAM", tostring(ov.state) .. " " .. tostring(ov.need) .. " " .. tostring(ov.check and ov.check.err) .. " vram " .. tostring(LabPreview.estimate(vram, SEL, vram.money).vramHave))
		check("T16 cash < 65,000 -> none", offer(studio({ money = 64999 })).state == nil)
		local after = LabPreview.estimate(ShopMath.withResearch(base, "frontier"), SEL, 0)
		local short = studio({ money = 65000 + after.cost - 1 })
		local os2 = offer(short)
		check("T16 cash >= 65,000 but < 65,000 + training -> none (MONEY)", os2.state == nil and os2.need == "MONEY", os2.need)
		local exact = studio({ money = 65000 + after.cost })
		check("T16 cash = 65,000 + training -> offer", offer(exact).state == "buy")
		local other = studio()
		other.empire.researchJob = { id = "quantization", elapsed = 0, seconds = 75 }
		check("T16 another research job running -> none", offer(other).state == nil)
		local running = studio()
		running.empire.researchJob = { id = "frontier", elapsed = 10, seconds = 120 }
		local orun = offer(running)
		check("T16 Frontier running -> FINISH NOW (running check, nothing to pay)", orun.state == "buy" and orun.check.kind == "running" and orun.check.cost == 0)
		local tr = studio()
		tr.training = { modelId = "m", workTotal = 1000, workDone = 1 }
		check("T16 a training running -> none (TRAINING)", offer(tr).state == nil and offer(tr).need == "TRAINING")
		local nodata = studio({ data = {} })
		local ond = offer(nodata)
		check("T16 FRONTIER + NO_DATA -> none", ond.state == nil and ond.need == "NO_DATA", ond.need)
		check("T16 another size (1B) -> no offer", ShopMath.studioEurekaOffer(base, { sizeId = "s1b", focusId = "balanced", recipeId = "steady" }, base.money, LabPreview.estimate, ui()).state == nil)
		local g = studio(); g.empire.tutorial.done = false
		check("T16 guide running -> none", offer(g).state == nil)
		local owned = studio(); owned.shop.vouchers.eureka = 1
		check("T16 one held -> owned", offer(owned).state == "owned")
		local before = deepcopy(base)
		local copy = ShopMath.withResearch(base, "frontier")
		check("T16 withResearch leaves the input unchanged (deep compare)", deepEqual(before, base) and base.empire.research.frontier == nil)
		check("T16 withResearch copy has frontier, shares the rest", copy.empire.research.frontier == true and copy.gpus == base.gpus and copy ~= base and copy.empire ~= base.empire)
		local small = studio()
		small.empire.researchJob = { id = "frontier", elapsed = 100, seconds = 120 } -- 20 s left: the buy state needs 30 s
		check("T16 Frontier running with 20 s left: no buy, owned would show", offer(small).state == nil and (function() small.shop.vouchers.eureka = 1; return offer(small).state == "owned" end)())
		local prev = studio()
		prev.empire.researchJob = { id = "frontier", elapsed = 100, seconds = 120 }
		check("T16 the owner preview follows the buy minimum too", offer(prev, nil, ui({ priced = false, studio = true })).state == nil)
	end

	------------------------------------------------------------------ T21 texts
	do
		local seen = 0
		for key, want in SPEC.items do
			local def = ShopConfig.product(key) or ShopConfig.pass(key)
			check("T21 " .. key .. " exists", def ~= nil)
			if def then
				seen += 1
				check("T21 " .. key .. " name", def.name == want.name, def.name)
				check("T21 " .. key .. " tag", def.tag == want.tag, def.tag)
				check("T21 " .. key .. " tab", def.tab == want.tab, def.tab)
				if def.kind == "cash" then
					local office = 2
					local nextName = EmpireConfig.OFFICES[office + 1].name
					local expect = string.gsub(SPEC.items.seed.text, "{amount}", function() return "$" .. Format.int(ShopConfig.cashFor(def, office)) end)
					expect = string.gsub(expect, "{share words}", function() return ShopMath.shareWords(def.share) end)
					expect = string.gsub(expect, "{next office}", function() return nextName end)
					check("T21 " .. key .. " text (pattern of seed)", ShopMath.cashText(def, office) == expect, ShopMath.cashText(def, office))
				else
					check("T21 " .. key .. " text", def.desc == want.text, def.desc)
				end
			end
		end
		check("T21 23 catalogue rows compared", seen == 23, seen)
		local FORBIDDEN = { "limited", "deal", "best value", "worth", "sale", "only today", "premium" }
		local hits = {}
		for _, entry in SPEC.strings do
			local s = " " .. string.lower(entry[2]) .. " "
			for _, w in FORBIDDEN do
				if string.find(s, "[^%a]" .. w .. "[^%a]") then table.insert(hits, entry[1] .. ": " .. entry[2]) end
			end
		end
		for _, def in ShopConfig.PRODUCTS do
			for _, w in FORBIDDEN do if string.find(" " .. string.lower((def.desc or "") .. " " .. (def.name or "")) .. " ", "[^%a]" .. w .. "[^%a]") then table.insert(hits, def.key) end end
		end
		check("T21 no forbidden word in " .. #SPEC.strings .. " shop strings", #hits == 0, table.concat(hits, " | "))
	end
end

local ok, err = xpcall(body, debug.traceback)
check("body ran", ok, err)
print(string.format("shop2_math: %d passed, %d failed", pass, failc))
