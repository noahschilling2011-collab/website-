	{id="slate",name="Studio slate",bg={31,39,43},ink={240,237,225},accent={197,156,98}},
	{id="brick",name="Clay &amp; cream",bg={248,241,229},ink={62,43,36},accent={165,85,59}},
}
Config.BRIEFS = {
