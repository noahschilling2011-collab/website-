-- The candidate's own question at the end ("Do you have any questions for us?") and the founder's
-- replies. Effects add up per matching trait (high = k&gt;=4, low = k&lt;=2) and are clamped to -1..1.
local function options(...: any): {any} return {...} end
local ASKS: {any}={
 {text="What does a normal day look like at {company}?",options=options(
  {text="Fast and a bit chaotic, but you'll own real problems from day one.",high=1,nervous=-1,candid=1},
  {text="Calm and flexible: sensible hours and good coffee.",nervous=1,low=1},
  {text="Long hours. We expect results, not excuses.",all=-1,oversell=1})},
 {text="How do you decide what the team works on?",options=options(
  {text="We look at the numbers together every week and pick what moves them.",high=1,candid=1},
  {text="I decide, and the team executes.",high=-1,confident=-1},
  {text="Honestly, we're still figuring that out.",candid=1,nervous=-1})},
 {text="What would success look like for me after six months?",options=options(
  {text="You've shipped something our users notice.",high=1,confident=1},
  {text="You've learned our stack and found your feet.",low=1,nervous=1},
  {text="You've hit every target we set, no matter what.",all=-1,oversell=1})},
}
local REACTIONS={[1]={"That's exactly what I was hoping to hear.","Great. That sounds like a place where I'd do my best work."},
 [0]={"Okay, thanks. Good to know.","Fair enough, thank you."},
 [-1]={"Hm. I see.","Okay... not quite what I'm looking for, but thanks for being direct."}}
local DECLINE={"I appreciate the offer, but I can't go below what I asked for.","Thank you, but at that number I'll stay where I am."}
local ACCEPT={"Thank you! I'm really excited. See you on my first day.","Deal. I can't wait to get started at {company}."}
local WORDS={"one","two","three","four","five","six","seven","eight","nine","ten","eleven","twelve"}
local function yearsText(n: number): string
 if n&lt;=0 then return "less than a year" end
 return (WORDS[n] or tostring(n))..(if n==1 then " year" else " years")
end
local function fill(text: string,ctx: {[string]:string}): string
 return (string.gsub(text,"{(%a+)}",function(key: string): any return ctx[key] end))
end
function Recruiting.question(roleId: string,id: string): Question?
 for _,q in GENERIC do if q.id==id then return q end end
 local technical: {Question}=TECHNICAL[roleId] or {}
 for _,q in technical do if q.id==id then return q end end
 return nil
end
function Recruiting.questions(roleId: string): {Question}
 local out=table.clone(GENERIC)
 local technical: {Question}=TECHNICAL[roleId] or {}
 for _,q in technical do table.insert(out,q) end
 return out
end
-- Context for the templates: {company}, {years}, {Years}, {prev}, {spec}, {roleName}, {cost}, {wage}, {month}, {topic}.
function Recruiting.context(person: Person,company: string,e: any?): {[string]:string}
 local years=yearsText(person.xp)
 local def=roleDef(person.role)
 return {company=company,years=years,Years=(string.gsub(years,"^%l",string.upper)),prev=person.prev,spec=person.spec,roleName=def.name,
  cost=Format.money(Recruiting.hireCost(person.role,person.ask,e)),wage=string.format("$%.2f/s",Recruiting.wage(person.role,person.ask)),
  month=Format.money(Recruiting.wage(person.role,person.ask)*GameConfig.GAME_MONTH_SECONDS)}
end
local function tierOf(k: number): string return if k&lt;=2 then "low" elseif k&gt;=4 then "high" else "mid" end
-- Position of a question in its bank (generic or the role's technical list): consecutive questions
-- pick consecutive template variants, so recurring phrases never repeat back to back.
local ORDER: {[string]:number}={}
for i,q in GENERIC do ORDER[q.id]=i end
for _,list in TECHNICAL do for i,q in list do ORDER[q.id]=20+i end end
local function variant&lt;T&gt;(person: Person,qid: string,list: {T}): T
 return list[(person.serial+(ORDER[qid] or 0))%#list+1]
end
local function picker(person: Person,qid: string,salt: number): (number)-&gt;number
 return stream((person.serial*0x27d4eb2f+textHash(qid)+salt)%4294967296)
end
-- What one answer tells an interviewer about the skill: (evidence on the 1..5 scale, weight).
-- Overselling inflates general answers by a full tier, nerves deflate them; technical answers show the
-- real skill (weight 2.5); salary asks are a weak, honest signal (the ask correlates with skill).
local function evidence(person: Person,q: Question): (number,number)
 local noise=(unit(picker(person,q.id,0x51ed27))-.5)*.8
 if q.kind=="technical" then return person.k+noise,2.5 end
 if q.id=="salary" then return 1+(person.ask-.8)/.175,.4 end
 if q.id=="start" then return person.k+noise*2,.15 end
 local bias=(if person.candour&lt;.35 then 1 else 0)-(if person.confidence&lt;.35 then .5 else 0)
 if q.id=="questions" then return person.k+bias*.5+noise,.6 end
 return person.k+bias+noise,1
end
function Recruiting.candidateAsk(person: Person): any return ASKS[person.serial%#ASKS+1] end
-- Answer text for question `qid` (nil when the question does not exist for the role).
function Recruiting.answer(person: Person,qid: string,ctx: {[string]:string}): string?
 local q=Recruiting.question(person.role,qid);if not q then return nil end
 local pick=picker(person,qid,0)
 local tier=tierOf(person.k)
 local nervous,confident=person.confidence&lt;.35,person.confidence&gt;.65
 local oversell,candid=person.candour&lt;.35,person.candour&gt;.65
 local opener: string=choose(pick,if nervous then NERVOUS_OPEN elseif confident then CONFIDENT_OPEN else NEUTRAL_OPEN)
 local body: string;local closer=""
 if q.kind=="technical" then
  local local_ctx=table.clone(ctx);local_ctx.topic=q.topic or "this"
  if tier=="high" then body=q.high or "" elseif tier=="mid" then body=q.mid or ""
  elseif oversell then body=variant(person,qid,BUZZ) elseif candid then body=variant(person,qid,HONEST) else body=variant(person,qid,VAGUE) end
  if oversell and tier~="low" and pick(10)&lt;=6 then closer=variant(person,qid,OVERSELL_CLOSE)
  elseif nervous and pick(10)&lt;=5 then closer=variant(person,qid,NERVOUS_CLOSE)
  elseif candid and tier=="high" and pick(10)&lt;=4 then closer=variant(person,qid,CANDID_CLOSE) end
  return fill(opener..body..closer,local_ctx)
 elseif qid=="salary" then
  body="I'm looking for a signing package of about {cost}, then {wage}, roughly {month} per game month."
  closer=if oversell then " With my track record, that's a bargain." elseif nervous then " But I'm, um, open to discussing it."
   elseif tier=="high" and confident then " That's in line with the other offers I have." elseif tier=="low" and candid then " I know I'm still learning, so I kept it reasonable." else ""
 elseif qid=="start" then
  body=if tier=="high" then START[4] else choose(pick,START)
  if nervous then closer=" If that works for you, of course." end
 elseif qid=="questions" then
  opener="" -- the candidate's own question needs no filler
  body=(if nervous then "Um, yes, actually. " else "Yes, actually. ")..Recruiting.candidateAsk(person).text
 else
  local shown=if oversell and tier=="low" then "mid" elseif oversell then "high" else tier
  body=choose(pick,GENERIC_ANSWERS[qid][shown])
  if oversell and pick(10)&lt;=7 then closer=variant(person,qid,OVERSELL_CLOSE)
  elseif nervous and pick(10)&lt;=5 then closer=variant(person,qid,NERVOUS_CLOSE)
  elseif candid and tier=="low" and pick(10)&lt;=5 then closer=variant(person,qid,HUMBLE_CLOSE) end
 end
 return fill(opener..body..closer,ctx)
end
-- Mood change (-1..1) caused by the founder's reply option to the candidate's question.
function Recruiting.mood(person: Person,option: number?): number
 if not option then return 0 end
 local opt=Recruiting.candidateAsk(person).options[option];if not opt then return 0 end
 local m=(opt.all or 0)+(if person.k&gt;=4 then opt.high or 0 else 0)+(if person.k&lt;=2 then opt.low or 0 else 0)
  +(if person.confidence&lt;.35 then opt.nervous or 0 else 0)+(if person.confidence&gt;.65 then opt.confident or 0 else 0)
  +(if person.candour&gt;.65 then opt.candid or 0 else 0)+(if person.candour&lt;.35 then opt.oversell or 0 else 0)
 return math.clamp(m,-1,1)
end
function Recruiting.reaction(person: Person,option: number): string
 local list=REACTIONS[Recruiting.mood(person,option)]
 return list[picker(person,"reply",option)(#list)]
end
-- Would the candidate accept the reduced offer? Weak candidates always, average ones unless the
-- conversation went badly, strong ones only after a reply they liked.
function Recruiting.acceptsLow(person: Person,option: number?): boolean
 local mood=Recruiting.mood(person,option)
 return person.k&lt;=2 or (person.k==3 and mood&gt;=0) or (person.k&gt;=4 and mood&gt;=1)
end
-- Estimated skill range after the asked questions; never collapses to an exact value before hiring.
function Recruiting.impression(person: Person,asked: {string}): {estimateLow: number,estimateHigh: number,note: string}
 local weight,sum,technical=0,0,0
 for _,id in asked do
  local q=Recruiting.question(person.role,id)
  if q then local e,w=evidence(person,q);weight+=w;sum+=e*w;if q.kind=="technical" then technical+=1 end end
 end
 if weight&lt;=0 then return {estimateLow=1,estimateHigh=5,note="First impressions only. Ask questions to judge their skill."} end
 local estimate=sum/weight
 local spread=math.clamp(2.4/math.sqrt(1+weight),.5,2)
 local low=math.clamp(math.floor((estimate-spread)*2+.5)/2,1,5);local high=math.clamp(math.floor((estimate+spread)*2+.5)/2,1,5)
 if high-low&lt;1 then
  local mid=math.clamp(math.floor(estimate*2+.5)/2,1.5,4.5);low=mid-.5;high=mid+.5
 end
 local manner=if person.confidence&lt;.35 then "Nervous" elseif person.confidence&gt;.65 then "Self-assured" else "Composed"
 local note
 if technical==0 then note=manner..". Ask a technical question to test real depth."
 elseif person.candour&lt;.35 and person.k&lt;=3 then note="Big claims; the technical answers don't fully back them up."
 elseif person.k&gt;=4 then note=if person.confidence&lt;.35 then "Nervous, but the technical steps are concrete and correct." else "Concrete, correct technical steps."
 elseif person.k==3 then note="Solid fundamentals, fewer specifics."
 elseif person.candour&gt;.65 then note="Honest about gaps; technical depth is limited."
 else note="Technical answers stay vague." end
 return {estimateLow=low,estimateHigh=high,note=note}
end

-- Visitor NPC helpers (shared with AssistantService) ----------------------------------------------
local NPC={}
Recruiting.npc=NPC
function NPC.flat(a: Vector3,b: Vector3): number return Vector3.new(a.X-b.X,0,a.Z-b.Z).Magnitude end
-- Turns a rig from EmployeeRigDesign into a non-staff person: role for doors/navigation, badge text and
-- an owner-only prompt handled by `action` (the EmployeeTalk attribute is removed, so StaffService
-- ignores it). Parts join the CompanyEmployees collision group like staff.
function NPC.dress(model: Model,roleId: string,title: string,actionText: string,action: string,attrs: {[string]:any},lanyard: Color3?)
 model:SetAttribute("RoleId",roleId);model:SetAttribute("Role",title);model:SetAttribute("AccessClass",roleId)
 local head=model:FindFirstChild("Head")
 local badge=if head then head:FindFirstChild("EmployeeBadge") else nil
 local label=if badge then badge:FindFirstChildWhichIsA("TextLabel") else nil
 if label then label.Text=tostring(model:GetAttribute("EmployeeName")).."\n"..title end
 local prompt=if head then head:FindFirstChild("EmployeeTalk") else nil
 if prompt and prompt:IsA("ProximityPrompt") then
  prompt.Name="PeopleTalk";prompt:SetAttribute("EmployeeTalk",nil);prompt:SetAttribute("PeopleAction",action)
  prompt.ActionText=actionText;prompt.RequiresLineOfSight=false;prompt.HoldDuration=0
  for k,v in attrs do prompt:SetAttribute(k,v) end
 end
 for _,p in model:GetDescendants() do
  if p:IsA("BasePart") then
   p.CollisionGroup="CompanyEmployees"
   if lanyard and p.Name=="Lanyard" then p.Color=lanyard end
  end
 end
end
-- Navigation record compatible with EmployeeNavigation and WorkstationService.
function NPC.record(model: Model,roleId: string,index: number,tier: number,cf: CFrame,office: Model,seed: number): any
 local h=model:FindFirstChildOfClass("Humanoid")
 return {model=model,root=model.PrimaryPart,humanoid=h,index=index,name=model:GetAttribute("EmployeeName"),role=roleId,tier=tier,cf=cf,office=office,
  personality=EmployeeConfig.personalityFromSeed(seed),state="WAITING",now=Staff.now(),sequence=0}
end
-- Direct Humanoid walk (no path) for open ground the plan does not class as public (plaza).
function NPC.straight(e: any,target: Vector3)
 e.root.Anchored=false;e.humanoid.Sit=false;e.humanoid.AutoRotate=true;e.humanoid.EvaluateStateMachine=true;e.humanoid.WalkSpeed=e.personality.walkSpeed
 pcall(function() e.root:SetNetworkOwner(nil) end)
 e.humanoid:MoveTo(target)
end
-- DoorService only counts NPCs in Employees/OperationsEmployees as "in the doorway"; while one of
-- these NPCs stands in an open door it re-requests the door so the hold timer cannot close it on them.
function NPC.holdDoors(e: any,time: number)
 if (e.doorHoldAt or 0)&gt;time then return end
 e.doorHoldAt=time+.5
 for _,door in Doors.doorsNear(e.office,e.root.Position,7) do
  local state=Doors.state(door)
  if state=="open" or state=="opening" then
   local sensor=door:FindFirstChild("Sensor")
   local centre=if sensor and sensor:IsA("BasePart") then sensor.Position else door:GetPivot().Position
   local class=door:GetAttribute("AccessClass")
   if NPC.flat(centre,e.root.Position)&lt;=4.5 and Plan.roleAllows(e.role,if typeof(class)=="string" then class else nil) then Doors.requestNPC(e.model,door) end
  end
 end
end
function NPC.face(e: any,position: Vector3)
 if not e.root.Parent or (e.humanoid and e.humanoid.SeatPart) then return end
 local p=e.root.Position;local d=Vector3.new(position.X-p.X,0,position.Z-p.Z)
 if d.Magnitude&gt;.2 then e.root.CFrame=CFrame.lookAt(p,p+d) end
end

-- Visitors ------------------------------------------------------------------------------------------
local visits: {[string]:any}={}
local claimed: {[Instance]:{[any]:string}}=setmetatable({},{__mode="k"}) :: any
local runtime: {[any]:any}=setmetatable({},{__mode="k"}) :: any
local function visitKey(s: any,id: string): string return tostring(s.userId)..":"..id end
local function find(e: any,id: string): (any,number?)
 for i,a in e.applicants do if a.id==id then return a,i end end
 return nil,nil
end
local function notify(s: any,text: string)
 Remote.fire(s.player,"Notify","PEOPLE_NOTICE",{text=text})
end
local function companyName(s: any): string
 return if s.data.company then s.data.company.name else s.player.DisplayName.."'s company"
end
-- Waiting places in the visitor lounge: its activities (Lounge seats …), else the raw Seats of its room
-- model, then standing spots along the lounge's open east edge (kept free of furniture; used when the
-- room is not furnished or every seat is taken), so an invited candidate always has somewhere to wait.
-- A raw seat is approached from the side away from its neighbours (sofas face a coffee table, so the
-- floor in front of a seat is often blocked), then the other side, then just in front; Seat:Sit does
-- the last step like workstation chairs.
local function floorPoint(v: any,p: Vector3): Vector3
 local lp=v.cf:PointToObjectSpace(p);return v.cf*Vector3.new(lp.X,Plan.levelY(0)+3,lp.Z)
end
local function spots(v: any): {any}
 local list={}
 local route=Plan.visitorRoute(v.tier)
 for _,w in Workstations.scan(v.office).all do
  if w.room==route.room and w.kind~="Computer" and w.model.Parent then table.insert(list,{key=w,w=w,candidates={w.position}}) end
 end
 if #list==0 then
  local rooms=v.office:FindFirstChild("Rooms");local room=if rooms then rooms:FindFirstChild(route.room) else nil
  local seats: {Seat}={}
  if room then for _,d in room:GetDescendants() do if d:IsA("Seat") and not d.Disabled then table.insert(seats,d) end end end
  for _,seat in seats do
   local function crowd(p: Vector3): number
    local m=math.huge;for _,o in seats do if o~=seat then m=math.min(m,(o.Position-p).Magnitude) end end;return m
   end
   local offset=seat.CFrame.RightVector*(seat.Size.X/2+2.2)
   local a,b=seat.Position+offset,seat.Position-offset
   if crowd(b)&gt;crowd(a) then a,b=b,a end
   table.insert(list,{key=seat,seat=seat,candidates={floorPoint(v,a),floorPoint(v,b),floorPoint(v,seat.Position+seat.CFrame.LookVector*1.6)}})
  end
 end
 for i,p in route.standing do table.insert(list,{key="edge"..i,candidates={v.cf*p}}) end
 return list
end
local function releaseSpot(v: any)
 local spot=v.spot;if not spot then return end
 local claims=claimed[v.office];if claims and claims[spot.key]==v.key then claims[spot.key]=nil end
 if spot.w then Workstations.release(v.e)
 else v.e.humanoid.Sit=false;v.e.root.Anchored=false end
 v.spot=nil;v.seated=false
end
local function claimSpot(v: any): any
 local claims=claimed[v.office];if not claims then claims={};claimed[v.office]=claims end
 for _,spot in spots(v) do
  if claims[spot.key]==nil and not (spot.seat and spot.seat.Occupant) then
   if spot.w and not Workstations.reserve(spot.w,v.e) then continue end
   claims[spot.key]=v.key;v.spot=spot;v.tries=0;return spot
  end
 end
 return nil
end
local function sit(v: any)
 local spot=v.spot;local e=v.e;if not spot then return end
 if spot.w then
  e.task={id="Interview",state="WAITING"}
  if Workstations.perform(e,Staff.now()) then v.seated=true;return end
 elseif spot.seat then
  e.humanoid.AutoRotate=false;e.root.Anchored=false;spot.seat:Sit(e.humanoid);e.root.Anchored=true;v.seated=true;return
 end
 -- standing spot: face the route's waiting direction (HQ: the reception hall, building east) and wait
 local p=e.root.Position;NPC.face(e,p+v.cf:VectorToWorldSpace(Plan.visitorRoute(v.tier).standFace));e.root.Anchored=true;v.seated=true
end
local function despawn(v: any)
 if v.hireSeed then
  -- a hired candidate leaves at the speed gates: the staff rig takes over at that spot (first day)
  local root=v.e.root
  Staff.handoverArrival(v.office,v.hireSeed,if root and root.Parent then root.CFrame else nil)
  v.hireSeed=nil
 end
 Nav.cancel(v.e);releaseSpot(v)
 if v.model.Parent then v.model:Destroy() end
 visits[v.key]=nil
end
local enter: (v: any)-&gt;()
local function go(v: any,target: Vector3,done: (boolean)-&gt;())
 v.e.now=Staff.now()
 Nav.go(v.e,target,Staff.now(),function(ok: boolean) if visits[v.key]==v then done(ok) end end)
end
-- Walk to the claimed place; a failed route tries the next approach point, then gives up and waits
-- where the candidate stands (the Interview prompt works anywhere).
enter=function(v: any)
 v.phase="enter"
 local spot=v.spot or claimSpot(v)
 if not spot then v.phase="waiting";return end
 local target=spot.candidates[math.min(v.tries+1,#spot.candidates)]
 go(v,target,function(ok)
  if v.phase~="enter" then return end
  if ok then v.phase="waiting";sit(v)
  else
   v.tries+=1
   if v.tries&lt;math.max(3,#spot.candidates) then v.phase="retry";v.retryAt=Staff.now()+2 else releaseSpot(v);v.phase="waiting" end
  end
 end)
end
local function walkStraight(v: any,target: Vector3,phase: string)
 v.phase=phase;v.walk={target=target,since=Staff.now(),issued=Staff.now()};NPC.straight(v.e,target)
end
-- Inside the entrance recess (public per the plan from z = -48), just before the automatic doors
-- (garage stage: in front of the porch).
local function portalPoint(v: any): Vector3
 local route=Plan.visitorRoute(v.tier)
 return v.cf*(route.portal+route.spread*((v.slot-1)%3-1))
end
-- kind "out": back to the plaza (rejected); "hired": through the public hall to the speed gates.
local function leave(v: any,kind: string)
 if v.phase=="leaving" or v.phase=="exit" then return end
 Nav.cancel(v.e);releaseSpot(v);v.phase="leaving";v.tries=0
 local route=Plan.visitorRoute(v.tier)
 if kind=="hired" then
  local exit=route.exits[(v.slot-1)%#route.exits+1]
  go(v,v.cf*exit,function(_ok) despawn(v) end)
 else
  go(v,portalPoint(v),function(_ok)
   if visits[v.key]~=v then return end
   walkStraight(v,v.cf*(route.arrival+Vector3.new(((v.slot-1)%3-1)*2,0,0)),"exit")
  end)
 end
end
local function spawnVisitor(s: any,p: any,a: any): any
 local office: Model=p.office;local cf: CFrame=p.cframe
 local tierAttr=office:GetAttribute("OfficeTier");local tier: number=if typeof(tierAttr)=="number" then tierAttr else Plan.tierForOffice(s.data.empire.office)
 local folder: Instance?=office:FindFirstChild("Visitors")
 if not folder then local created=Instance.new("Folder");created.Name="Visitors";created.Parent=office;folder=created end
 local used: {[number]:boolean}={}
 for _,v in visits do if v.office==office then used[v.slot]=true end end
 local slot=1;while used[slot] do slot+=1 end
 local route=Plan.visitorRoute(tier)
 local start=route.arrival+Vector3.new(((slot-1)%3-1)*2,0,-((slot-1)//3)*2)
 local pose=cf*CFrame.lookAt(start,start+route.face)
 -- Interview clothes: the marketer wardrobe is mostly blazers; the role is "visitor" for doors and paths.
 local model=Rig.build(folder::Instance,s.userId,500+slot,"marketer",pose,{n=a.n,s=a.s})
 local def=roleDef(a.role)
 NPC.dress(model,"visitor","Applicant · "..def.name,"Interview","interview",{ApplicantId=a.id},Color3.fromRGB(150,154,160))
 local e=NPC.record(model,"visitor",500+slot,tier,cf,office,a.s)
 local v={key=visitKey(s,a.id),id=a.id,session=s,office=office,cf=cf,tier=tier,model=model,e=e,slot=slot,phase="approach",tries=0,seated=false}
 visits[v.key]=v
 walkStraight(v,portalPoint(v),"approach")
 return v
end
function Recruiting.visit(s: any,id: string): any return visits[visitKey(s,id)] end
-- After an interview that interrupted the walk in: continue to the lounge (from the plaza: walk to the
-- entrance recess first, the plan does not class the plaza as public).
local function resume(v: any)
 if v.seated or v.phase~="waiting" or not v.e.root.Parent then return end
 v.e.root.Anchored=false
 if Plan.employeeAllowed(v.e.role,v.tier,v.cf:PointToObjectSpace(v.e.root.Position)) then enter(v)
 else walkStraight(v,portalPoint(v),"approach") end
end

-- Interview payload -------------------------------------------------------------------------------
local function initials(name: string): string
 local out=""
 for word in string.gmatch(name,"%S+") do out..=string.sub(word,1,1);if #out&gt;=2 then break end end
 return string.upper(out)
end
function Recruiting.payload(s: any,a: any): any
 local person=Recruiting.person(s.userId,a);local company=companyName(s);local ctx=Recruiting.context(person,company,s.data.empire)
 local def=roleDef(a.role)
 local transcript={}
 for _,id in a.q do
  local q=Recruiting.question(a.role,id)
  if q then
   table.insert(transcript,{from="founder",text=fill(q.text,ctx)})
   table.insert(transcript,{from="candidate",text=Recruiting.answer(person,id,ctx) or ""})
   if id=="questions" and a.r then
    local opt=Recruiting.candidateAsk(person).options[a.r]
    table.insert(transcript,{from="founder",text=if opt then opt.text else ""})
    table.insert(transcript,{from="candidate",text=Recruiting.reaction(person,a.r)})
   end
  end
 end
 local lowMult=roundAsk(a.ask*Recruiting.LOW_OFFER)
 if a.low then
  table.insert(transcript,{from="founder",text="We can offer "..Format.money(Recruiting.hireCost(a.role,lowMult,s.data.empire)).." and "..string.format("$%.2f/s",Recruiting.wage(a.role,lowMult)).."."})
  table.insert(transcript,{from="candidate",text=DECLINE[a.serial%#DECLINE+1]})
 end
 local remaining={}
 local asked: {[string]:boolean}={};for _,id in a.q do asked[id]=true end
 if #a.q&lt;Recruiting.MAX_QUESTIONS then
  for _,q in Recruiting.questions(a.role) do if not asked[q.id] then table.insert(remaining,{id=q.id,text=fill(q.text,ctx),kind=q.kind}) end end
 end
 local pending=nil
 if asked.questions and not a.r then
  local ask=Recruiting.candidateAsk(person);local options={}
  for i,opt in ask.options do options[i]=opt.text end
  pending={text=fill(ask.text,ctx),options=options}
 end
 local e=s.data.empire
 return {id=a.id,name=a.n,initials=initials(a.n),seed=a.s,role=a.role,roleName=def.name,xp=a.xp,years=ctx.years,prev=a.prev,spec=a.spec,ask=a.ask,
  cost=Recruiting.hireCost(a.role,a.ask,e),wage=Recruiting.wage(a.role,a.ask),lowCost=Recruiting.hireCost(a.role,lowMult,e),lowWage=Recruiting.wage(a.role,lowMult),
  lowDeclined=a.low==true,monthSeconds=GameConfig.GAME_MONTH_SECONDS,transcript=transcript,questions=remaining,asked=#a.q,max=Recruiting.MAX_QUESTIONS,
  impression=Recruiting.impression(person,a.q),pendingAsk=pending,company=company,status=a.st,
  staffFull=EmpireMath.staff(e)&gt;=EmpireConfig.OFFICES[e.office].staff}
end
function Recruiting.counts(s: any): {open: number,waiting: number}
 local open,waiting=0,0
 for _,a in s.data.empire.applicants do if a.st=="new" then open+=1 else waiting+=1 end end
 return {open=open,waiting=waiting}
end

-- Remote --------------------------------------------------------------------------------------------
local function interviewing(a: any): boolean return a.st=="interviewing" end
local function hire(s: any,a: any,index: number,low: boolean): any
 local e=s.data.empire
 if EmpireMath.staff(e)&gt;=EmpireConfig.OFFICES[e.office].staff then return {ok=false,err="STAFF_FULL"} end
 local person=Recruiting.person(s.userId,a)
 if low and a.low then return {ok=false,err="OFFER_DECLINED"} end
 if low and not Recruiting.acceptsLow(person,a.r) then
  a.low=true;Session.markDirty(s)
  return {ok=true,accepted=false,text=DECLINE[a.serial%#DECLINE+1],interview=Recruiting.payload(s,a)}
 end
 local mult=if low then roundAsk(a.ask*Recruiting.LOW_OFFER) else a.ask
 local cost=Recruiting.hireCost(a.role,mult,e)
 if not Economy.spend(s,cost,"hire") then return {ok=false,err="NO_MONEY"} end
 EmpireMath.syncProfiles(e,s.userId)
 table.insert(e.staffProfiles[a.role],{n=a.n,s=a.s,k=person.k,w=mult})
 e.employees[a.role]=(e.employees[a.role] or 0)+1
 table.remove(e.applicants,index)
 Session.markDirty(s)
 local v=visits[visitKey(s,a.id)]
 if v then
  -- the candidate walks out to the speed gates; there the new colleague's rig takes over (first day:
  -- badge at reception, then the desk)
  Staff.expectArrival(v.office,a.s,nil,true);v.hireSeed=a.s
  leave(v,"hired")
 end
 Plot.refresh(s)
 local def=roleDef(a.role)
 notify(s,a.n.." joined "..companyName(s).." as "..def.name..".")
 return {ok=true,accepted=true,cost=cost,text=fill(ACCEPT[a.serial%#ACCEPT+1],{company=companyName(s)})}
end
local function act(s: any,p: any): any
 local action=p.action;local id=Guard.id(p.id)
 if typeof(action)~="string" or not id then return {ok=false,err="BAD_INPUT"} end
 local e=s.data.empire
 local a,index=find(e,id)
 if not a or not index then return {ok=false,err="APPLICANT_GONE"} end
 if action=="invite" then
  if a.st~="new" then return {ok=false,err="ALREADY_INVITED"} end
  local plot=Plot.get(s.player)
  if not plot or not plot.office then return {ok=false,err="NO_OFFICE"} end
  spawnVisitor(s,plot,a);a.st="invited";Session.markDirty(s)
  return {ok=true}
 elseif action=="reject" then
  table.remove(e.applicants,index);Session.markDirty(s)
  local v=visits[visitKey(s,id)];if v then leave(v,"out") end
  return {ok=true}
 elseif action=="open" then
  if not interviewing(a) then return {ok=false,err="NOT_HERE"} end
  return {ok=true,interview=Recruiting.payload(s,a)}
 elseif action=="close" then
  if interviewing(a) then a.st="invited";Session.markDirty(s) end
  local v=visits[visitKey(s,id)];if v then resume(v) end
  return {ok=true}
 elseif action=="question" then
  if not interviewing(a) then return {ok=false,err="NOT_HERE"} end
  local qid=Guard.id(p.questionId);local q=if qid then Recruiting.question(a.role,qid) else nil
  if not qid or not q then return {ok=false,err="BAD_INPUT"} end
  if table.find(a.q,qid) then return {ok=false,err="ASKED"} end
  if #a.q&gt;=Recruiting.MAX_QUESTIONS then return {ok=false,err="QUESTION_LIMIT"} end
  table.insert(a.q,qid);Session.markDirty(s)
  local person=Recruiting.person(s.userId,a);local ctx=Recruiting.context(person,companyName(s),s.data.empire)
  return {ok=true,question=fill(q.text,ctx),answer=Recruiting.answer(person,qid,ctx),interview=Recruiting.payload(s,a)}
 elseif action=="reply" then
  if not interviewing(a) then return {ok=false,err="NOT_HERE"} end
  local option=Guard.integer(p.option,1,3)
  if not option then return {ok=false,err="BAD_INPUT"} end
  if not table.find(a.q,"questions") or a.r~=nil then return {ok=false,err="NO_ASK"} end
  a.r=option;Session.markDirty(s)
  local person=Recruiting.person(s.userId,a)
  return {ok=true,text=Recruiting.reaction(person,option),interview=Recruiting.payload(s,a)}
 elseif action=="hire" then
  if not interviewing(a) then return {ok=false,err="NOT_HERE"} end
  return hire(s,a,index,p.offer=="low")
 end
 return {ok=false,err="BAD_INPUT"}
end
Recruiting._act=act -- tests

-- Prompt: the founder talks to a waiting candidate -----------------------------------------------
local function onPrompt(q: ProximityPrompt,player: Player)
 if q:GetAttribute("PeopleAction")~="interview" then return end
 local id=q:GetAttribute("ApplicantId")
 if typeof(id)~="string" or q:GetAttribute("OwnerUserId")~=player.UserId then return end
 local s=Session.get(player);if not s or s.closed then return end
 local v=visits[visitKey(s,id)];local a=find(s.data.empire,id)
 local character=player.Character;local root=if character then character.PrimaryPart else nil
 if not v or not a or not root or (root.Position-v.e.root.Position).Magnitude&gt;14 then return end
 if v.phase=="leaving" or v.phase=="exit" then return end
 a.st="interviewing";Session.markDirty(s)
 if v.e.nav then Nav.cancel(v.e) end
 -- also in "retry" (no route active): otherwise campusTick re-enters and walks off mid-interview
 if v.phase=="enter" or v.phase=="retry" then v.phase="waiting";releaseSpot(v) end
 if v.phase=="approach" then v.phase="waiting";v.walk=nil end
 if not v.seated then NPC.face(v.e,root.Position);v.e.root.Anchored=true end
 Remote.fire(player,"Notify","INTERVIEW_OPEN",Recruiting.payload(s,a))
end
Recruiting._prompt=onPrompt -- tests

-- Ticks ---------------------------------------------------------------------------------------------
local function rt(s: any): any
 local state=runtime[s]
 if not state then
  state={rng=Random.new((s.userId%2147483647+7919*(tonumber(s.data.empire.hireSerial) or 0))%2147483647),loaded=false,next=nil}
  runtime[s]=state
 end
 return state
end
-- Simulation step (1 s): profile repair, expiry, arrivals.
function Recruiting.tick(s: any,_dt: number)
 if s.closed or not s.data.company then return end
 local e=s.data.empire;local state=rt(s)
 if not state.loaded then
  state.loaded=true
  -- after a rejoin nobody is waiting in the lounge any more; the interview so far is kept and the
  -- expiry window restarts (a.at is the application time, which may already be past EXPIRE)
  for _,a in e.applicants do if a.st~="new" and not visits[visitKey(s,a.id)] then a.st="new";a.at=e.seconds end end
 end
 if not EmpireMath.profilesConsistent(e) then EmpireMath.syncProfiles(e,s.userId);Session.markDirty(s) end
 local now=e.seconds
 for i=#e.applicants,1,-1 do
  local a=e.applicants[i]
  if a.st=="new" and now-a.at&gt;=Recruiting.EXPIRE then table.remove(e.applicants,i);Session.markDirty(s) end
 end
 local open=EmpireMath.staff(e)&lt;EmpireConfig.OFFICES[e.office].staff and #e.applicants&lt;EmpireMath.MAX_APPLICANTS
 if not open then state.next=nil;return end
 if state.next==nil then state.next=now+state.rng:NextInteger(Recruiting.ARRIVAL[1],Recruiting.ARRIVAL[2]) end
 if now&gt;=state.next then
  state.next=nil
  local a=Recruiting.generate(e,s.userId,now)
  table.insert(e.applicants,a);Session.markDirty(s)
  notify(s,"New application: "..a.n.." · "..roleDef(a.role).name)
 end
end
-- Campus step (Heartbeat): visitor navigation on the shared EmployeeNavigation queue/clock.
function Recruiting.campusTick(_dt: number)
 local time=Staff.now()
 for _,v in visits do
  local e=v.e
  if not v.model.Parent or not v.office.Parent or v.session.closed or not e.root.Parent then
   local a=if not v.session.closed then find(v.session.data.empire,v.id) else nil
   if a and a.st~="new" then a.st="new";a.at=v.session.data.empire.seconds;Session.markDirty(v.session) end
   despawn(v);continue
  end
  e.now=time
  Nav.tick(e,time)
  NPC.holdDoors(e,time)
  local walk=v.walk
  if (v.phase=="approach" or v.phase=="exit") and walk then
   -- the walk in hands over to navigation only on ground the visitor role may use
   local arrived=NPC.flat(e.root.Position,walk.target)&lt;(if v.phase=="approach" then 1.2 else 2.2)
    and (v.phase=="exit" or Plan.employeeAllowed(e.role,v.tier,v.cf:PointToObjectSpace(e.root.Position)))
   if arrived or time-walk.since&gt;25 then
    v.walk=nil
    if v.phase=="exit" then despawn(v) else enter(v) end
   elseif time-walk.issued&gt;3 then walk.issued=time;e.humanoid:MoveTo(walk.target) end
  elseif v.phase=="retry" and time&gt;=(v.retryAt or 0) then enter(v) end
 end
end

-- Headhunter voucher (shop, CORE_SPEC 11.7): one applicant whose hidden skill is 4 or 5. Deterministic: the
-- serial stream is walked until such a candidate comes up (each generate() takes the next serial).
function Recruiting.headhunt(s: any): (boolean,string?)
 if not s.data.company then return false,"NO_COMPANY" end
 local e=s.data.empire
 if #e.applicants&gt;=EmpireMath.MAX_APPLICANTS then return false,"APPLICANTS_FULL" end
 if EmpireMath.staff(e)&gt;=EmpireConfig.OFFICES[e.office].staff then return false,"STAFF_FULL" end
 for _=1,60 do
  local a=Recruiting.generate(e,s.userId,e.seconds)
  if Recruiting.traits(s.userId,a.serial).k&gt;=4 then
   table.insert(e.applicants,a)
   Session.markDirty(s,true)
   notify(s,"Headhunter: "..a.n.." · "..roleDef(a.role).name.." applied (top candidate)")
   return true
  end
 end
 return false,"NO_CANDIDATE"
end
function Recruiting.init()
 Remote.bind("RecruitAction",{burst=4,perSecond=2,company=true},act)
 Shop.setRedeemHandler("headhunter",Recruiting.headhunt)
 Prompts.PromptTriggered:Connect(onPrompt)
 Session.onLoaded(function(s)
  -- identities StaffAssignment shows today become persistent profiles (no visible change)
  EmpireMath.syncProfiles(s.data.empire,s.userId)
 end)
 Session.onClosing(function(s)
  for _,v in visits do if v.session==s then despawn(v) end end
  runtime[s]=nil
 end)
end
return Recruiting
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000028"><Properties><string name="Name">RoomKitsGarage</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- RoomKitsGarage: furniture, work stations and activities of the garage stage (plan tier 0) - the
-- converted garage where the founder starts with the first team. Runs after InteriorDesign (room
-- models, the WC / founder-corner walls and their doors, floors, ceilings, cameras) and the exterior
-- (shell, garage door, porch canopy, sign, car spot). Everything sits INSIDE ctx.rooms[id].
--
-- Garage lab (Plan.GARAGE_LAB x 60..112, z -118..-78): server corner with the GPU blades (lit per owned
-- GPU by PlotService), tea kitchen with the coffee machine, meeting table, whiteboard, data wall, five
-- team desks in two rows, workbench with a 3D printer, sofa corner, the assistant's desk by the side
-- door (G0_ASSIST), the glazed founder corner (G0_FOUNDER, founder-only desk) and the WC. Applicants
-- wait on the porch benches outside (G0_PORCH, Waiting activities, public).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Departments = require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local A = require(ReplicatedStorage.Shared.Config.ArchPalette)
local Kit = require(script.Parent.ArchKit)

local C, M = A.color, A.material
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local DETAIL: Kit.Opts = { detail = true }
local Y = Kit.FINISH -- finished floor (level 0)

local Garage = {}

type Ctx = { office: Model, cf: CFrame, tier: number, owner: number, accent: Color3, company: string, folders: { [string]: Instance }, rooms: { [string]: Model } }

local function fit(ctx: Ctx, id: string): Model
	local room = ctx.rooms[id]
	if not room then
		local r = Plan.room(ctx.tier, id)
		local created = Kit.model(ctx.folders.Rooms, id, true)
		created:SetAttribute("RoomId", id)
		if r then
			created:SetAttribute("RoomName", r.name)
			created:SetAttribute("RoomKind", r.kind)
			created:SetAttribute("Level", r.level)
			created:SetAttribute("AccessClass", r.access)
		end
		ctx.rooms[id] = created
		room = created
	end
	return Kit.model(room :: Model, "FitOut")
end

local function deptInfo(dept: string): (string, string?, string, string)
	if dept == "executive" then
		return "empire", nil, "any", "founder"
	end
	local d = (Departments.DEPARTMENTS :: any)[dept]
	if d then
		return d.app or "market", d.section, d.role or "any", d.screen or dept
	end
	return "market", nil, "any", dept
end

-- Computer work station (contract SPEC §5) with the department's app prompt and screen.
local function desk(ctx: Ctx, parent: Model, id: string, dept: string, at: CFrame, variant: string, access: string, room: string): Model
	local app, section, role, screen = deptInfo(dept)
	local m = Kit.station(parent, ctx.cf, id, dept, role, at, 0, variant, ctx.owner, ctx.accent, app, section, access, room)
	local disp = m:FindFirstChild("DisplayContent")
	if disp then
		disp:SetAttribute("LiveScreen", screen)
	end
	return m
end

-- Activity point at building-local (x, z), facing (fx, fz).
local function activity(ctx: Ctx, parent: Model, id: string, kind: string, dept: string, x: number, z: number, fx: number, fz: number, access: string, room: string, seat: Seat?, extra: { [string]: any }?): Model
	local p = V3(x, Y + 2.8, z)
	local f = V3(fx, Y + 2.8, fz)
	return Kit.activity(parent, ctx.cf, id, kind, dept, if kind == "Service" then "support" else "any", Kit.facing(p, f), 0, ctx.owner, seat, {
		roomAccess = access,
		homeRoom = room,
		facing = f,
		meetingRoom = extra and extra.meetingRoom,
		attributes = extra and extra.attributes,
	})
end

-- Seat activity: stand `d` studs in front of the seat (the sitter's view direction), face the seat.
local function seatActivity(ctx: Ctx, parent: Model, id: string, kind: string, dept: string, seat: Seat, d: number, access: string, room: string, extra: { [string]: any }?): Model
	local lp = ctx.cf:ToObjectSpace(seat.CFrame)
	local front = lp.LookVector
	local p = lp.Position + V3(front.X, 0, front.Z).Unit * d
	return activity(ctx, parent, id, kind, dept, p.X, p.Z, lp.Position.X, lp.Position.Z, access, room, seat, extra)
end

---------------------------------------------------------------------------------------------
-- Garage lab
---------------------------------------------------------------------------------------------
-- Mini GPU rack: one cabinet with stacked blade units. Each RackBlade goes into Office.Blades
-- (PlotService lights one per owned GPU; the lit blades breathe while the company trains).
local function gpuRack(ctx: Ctx, m: Model, at: CFrame, stationId: string)
	local n = Plan.GARAGE_STAGE.blades
	Kit.part(m, ctx.cf, "GarageRack", V3(2.6, 7.0, 2.4), at * CF(0, 3.5, -1.2), C.screen, M.metal)
	Kit.part(m, ctx.cf, "RackTop", V3(2.7, 0.15, 2.5), at * CF(0, 7.07, -1.2), C.metal, M.metal, DETAIL)
	local blades = ctx.folders.Blades
	for i = 1, n do
		local blade = Kit.part(blades, ctx.cf, "RackBlade", V3(2.0, 0.6, 0.08), at * CF(0, 1.0 + (i - 1) * 0.85, -2.44), A.department.compute, M.metal, DETAIL)
		blade:SetAttribute("RackIndex", i)
		blade:SetAttribute("RackVariant", "gpu")
		Kit.fx(blade, "breathe", { FxGate = "Training" })
	end
	local door = Kit.part(m, ctx.cf, "RackDoor", V3(2.6, 6.8, 0.08), at * CF(0, 3.5, -2.52), C.metal, M.metal, { detail = true, transparency = 0.45 })
	Kit.fx(door, "hinge", { FxAxis = "y", FxTravel = 1.6, FxHinge = V3(-1.3, 0, 0), FxStation = stationId })
	-- network switch and a small UPS on a shelf beside the rack
	Kit.part(m, ctx.cf, "NetShelf", V3(2.2, 0.15, 1.6), at * CF(2.6, 3.6, -0.8), C.metalSoft, M.metal)
	local switch = Kit.part(m, ctx.cf, "NetworkSwitch", V3(2.0, 0.35, 1.2), at * CF(2.6, 3.86, -0.8), C.screen, M.metal, DETAIL)
	Kit.fx(switch, "blink", { FxColor = C.statusGood, FxRate = 1.5, FxIdle = "on" })
	Kit.part(m, ctx.cf, "UPSBox", V3(1.4, 2.2, 1.6), at * CF(2.6, 1.1, -0.8), C.metalSoft, M.metal)
end

local function furnishLab(ctx: Ctx)
	local m = fit(ctx, "G0_LAB")
	local cf = ctx.cf
	local seed = Kit.hash("G0_LAB")
	local ACC, ROOM = "staff", "G0_LAB"

	-- server corner on the north wall (engineers inspect the rack: ServerRack activity)
	local rackAt = Kit.place(77, Y, -78, "S")
	activity(ctx, m, "G0_LAB_Rack1", "ServerRack", "compute", 77, -82.6, 77, -78, ACC, ROOM)
	gpuRack(ctx, m, rackAt, "G0_LAB_Rack1")

	-- tea kitchen with the coffee machine (PantryCoffee: WorkstationService brews here)
	local kitchen = Kit.kitchenette(m, cf, Kit.place(84, Y, -78, "S"), 10, seed + 1)
	local coffee = cf:PointToObjectSpace(kitchen.coffee.Position)
	for i, x in { coffee.X - 0.9, coffee.X + 1.2 } do
		activity(ctx, m, "G0_LAB_Coffee" .. i, "Coffee", "kitchen", x, -82.4, coffee.X, coffee.Z, ACC, ROOM)
	end
	Kit.cylinder(m, cf, "PizzaBox", "y", 0.35, 2.4, CF(81.2, Y + 3.33, -79.2), C.white, M.smooth, DETAIL)

	-- whiteboard on the WC's east wall (roadmap of a startup)
	Kit.whiteboard(m, cf, Kit.place(69.5, Y, -83, "E"), 5, "ROADMAP\n1  first model\n2  first customers\n3  hire the team\n4  move into the HQ", seed + 2, { y = 5.2 })
	activity(ctx, m, "G0_LAB_Board", "Whiteboard", "research", 72.6, -83, 69.5, -83, ACC, ROOM)

	-- meeting table (model reviews, stand-ups)
	local tableAt = CF(84, Y, -89.5)
	Kit.meetingTable(m, cf, tableAt, "round", 4.6, nil, seed + 3)
	for i, a in { 0, 90, 180, 270 } do
		local r = math.rad(a)
		local ox, oz = math.sin(r), -math.cos(r) -- outward from the table centre
		local cx, cz = 84 + ox * 3.4, -89.5 + oz * 3.4
		local seat = Kit.meetingChair(m, cf, Kit.facing(V3(cx, Y, cz), V3(84, Y, -89.5)), seed + 10 + i)
		-- stand behind the chair, a little to its side (like the HQ meeting rooms)
		local sx, sz = -oz, ox
		activity(ctx, m, "G0_LAB_Meet" .. i, "Meeting", "evaluation", cx + ox * 1.6 + sx * 1.7, cz + oz * 1.6 + sz * 1.7, 84, -89.5, ACC, ROOM, seat, { meetingRoom = "GarageTable" })
	end
	Kit.part(m, cf, "Laptop", V3(2.0, 0.1, 1.4), CF(83.4, Y + 3.2, -88.8) * ANG(0, 0.3, 0), C.metalSoft, M.metal, DETAIL)

	-- data wall on the west wall (curators watch the pipeline here)
	Kit.tvScreen(m, cf, Kit.place(60, Y, -96, "E"), 7, "data", ctx.accent, { y = 6.2, name = "DataWall" })
	activity(ctx, m, "G0_LAB_Pipeline", "Pipeline", "data", 63.4, -96, 60, -96, ACC, ROOM)

	-- five team desks in two rows (founder desk: founder corner; assistant: G0_ASSIST)
	local deskX = { 68, 76, 84, 72, 80 } -- row 1 (users face north), row 2 (users face south)
	local deskDept = { "data", "engineering", "research", "growth", "training" }
	for n = 1, 5 do
		local row1 = n &lt;= 3
		desk(ctx, m, "G0_LAB_Desk" .. n, deskDept[n], Kit.place(deskX[n], Y, if row1 then -106 else -102, if row1 then "S" else "N"), "bench", ACC, ROOM)
	end

	-- workbench with a 3D printer on the east wall (researchers run experiments here)
	Kit.workbench(m, cf, Kit.place(112, Y, -102, "W"), 10, seed + 4)
	Kit.printer3d(m, cf, Kit.place(110.6, Y + 3.2, -99.4, "W"), seed + 5, { propId = "GaragePrinter", prompt = "3D printer", station = "G0_LAB_Bench" })
	Kit.part(m, cf, "PrototypeBoard", V3(1.6, 0.15, 1.2), CF(110.4, Y + 3.28, -104.6), C.sage, M.smooth, DETAIL)
	activity(ctx, m, "G0_LAB_Bench", "LabBench", "research", 107.4, -102, 112, -102, ACC, ROOM)
	for k = 0, 1 do
		Kit.part(m, cf, "HardwareCrate", V3(2.4, 1.8, 1.8), CF(110.6, Y + 0.9 + k * 1.8, -95.4), if k == 0 then C.oakLight else C.oak, M.wood)
	end

	-- table tennis inside the up-and-over door (the garage startup's break corner), 4.5 studs clear of
	-- the door and of the workbench station
	local tt = CF(101, Y, -110)
	Kit.part(m, cf, "PingPongTop", V3(9, 0.25, 5), tt * CF(0, 2.6, 0), C.sage, M.smooth)
	Kit.part(m, cf, "PingPongLine", V3(9, 0.02, 0.08), tt * CF(0, 2.735, 0), C.white, M.smooth, DETAIL)
	Kit.part(m, cf, "PingPongNet", V3(0.06, 0.5, 5.4), tt * CF(0, 2.98, 0), C.white, M.fabric, { detail = true, transparency = 0.3 })
	for _, dx in { -3.6, 3.6 } do
		Kit.part(m, cf, "PingPongFrame", V3(0.25, 2.45, 4.2), tt * CF(dx, 1.225, 0), C.metal, M.metal)
	end
	for k, dx in { -2.2, 2.6 } do
		Kit.cylinder(m, cf, "Paddle", "y", 0.06, 0.9, tt * CF(dx, 2.76, (k - 1.5) * 2.4), if k == 1 then C.statusBad else C.screen, M.smooth, DETAIL)
	end
	Kit.ball(m, cf, "PingPongBall", 0.2, tt * CF(1.1, 2.83, -0.6), C.white, M.smooth, DETAIL)

	-- sofa corner by the west window (open towards the room: 3.6 studs in front of the sofa)
	Kit.rug(m, cf, CF(66.2, Y, -114), 10, 7, seed + 6)
	local sofaSeats = Kit.sofa(m, cf, Kit.place(61.6, Y, -114, "E"), 7, seed + 7)
	for i, s in sofaSeats do
		seatActivity(ctx, m, "G0_LAB_Sofa" .. i, "Lounge", "lounge", s, 2.4, ACC, ROOM)
	end
	Kit.coffeeTable(m, cf, CF(68.4, Y, -114.4), seed + 8, 3.0, 2.2)
	Kit.floorLamp(m, cf, CF(61.4, Y, -117.0), seed + 10)
	Kit.plant(m, cf, CF(61.6, Y, -102.6), "l", seed + 11)

	-- shelf with books and boxes between the kitchen and the founder corner
	Kit.bookshelf(m, cf, Kit.place(93.5, Y, -78, "S"), 7, 8, seed + 12, { books = 3 })
	-- string lights along the north wall (Neon bulbs, no light objects)
	for k = 0, 7 do
		Kit.ball(m, cf, "StringLight", 0.35, CF(62 + k * 4.5, Y + 11.6 - (k % 2) * 0.3, -78.6), C.lightWarm, M.neon, DETAIL)
	end
	Kit.plant(m, cf, CF(91.2, Y, -116.4), "m", seed + 13)
end

local function furnishAssistant(ctx: Ctx)
	local m = fit(ctx, "G0_ASSIST")
	-- the assistant's desk faces the side door (role assistant: founder clearance, staff can't sit here)
	desk(ctx, m, "G0_ASSIST_Desk1", "operations", Kit.place(88, Y, -113, "E"), "bench", "founder", "G0_ASSIST")
	Kit.plant(m, ctx.cf, CF(84.2, Y, -116.6), "s", Kit.hash("G0_ASSIST"))
end

local function furnishFounder(ctx: Ctx)
	local m = fit(ctx, "G0_FOUNDER")
	local cf = ctx.cf
	local seed = Kit.hash("G0_FOUNDER")
	local deskAt = Kit.place(106, Y, -86, "E")
	local d = desk(ctx, m, "G0_FOUNDER_Desk1", "executive", deskAt, "ldesk", "founder", "G0_FOUNDER")
	d:SetAttribute("Role", "founder") -- the founder's own desk: no employee takes it
	local term = Kit.part(m, cf, "FounderTerminal", V3(1.8, 1.2, 0.15), deskAt * CF(-2.4, 3.8, 0.9) * ANG(0, math.rad(-15), 0), C.screen, M.smooth, { canCollide = false })
	Kit.action(term, "ownerComputer", "Founder computer · whole company", "empire", { ownerOnly = true, actionText = "Open", maxDistance = 8 })
	local tablet = Kit.part(m, cf, "FounderCameraTablet", V3(1.2, 0.08, 1.6), deskAt * CF(2.3, 3.2, -0.3) * ANG(0, math.rad(20), 0), C.metal, M.smooth, { canCollide = false })
	Kit.action(tablet, "security", "Security cameras", nil, { ownerOnly = true, actionText = "View", maxDistance = 8 })
	Kit.sideboard(m, cf, Kit.place(105, Y, -78, "S"), 6, seed + 1)
	Kit.loungeChair(m, cf, Kit.place(100.4, Y, -80.4, -135), seed + 2)
	Kit.plant(m, cf, CF(110.6, Y, -79.6), "m", seed + 3)
	Kit.rug(m, cf, CF(105, Y, -86), 8, 7, seed + 4)
end

local function furnishWc(ctx: Ctx)
	local m = fit(ctx, "G0_WC")
	local cf = ctx.cf
	local key = "G0_WC_T"
	-- toilet against the west wall, basin with mirror on the north wall (FixtureKey contract)
	local base = Kit.place(60, Y, -81.5, "E")
	Kit.part(m, cf, "ToiletBowl", V3(1.5, 1.4, 2.2), base * CF(0, 0.7, -1.3), C.white, M.smooth)
	Kit.part(m, cf, "ToiletTank", V3(1.9, 2.2, 0.7), base * CF(0, 2.4, -0.35), C.white, M.smooth)
	local seat = Kit.seat(m, cf, "ToiletSeat", V3(1.5, 0.2, 1.8), base * CF(0, 1.5, -1.4), C.white, M.smooth, { canTouch = false })
	seat.Disabled = true
	seat:SetAttribute("FixtureKey", key)
	Kit.action(seat, "toilet", "Toilet", nil, { actionText = "Use", maxDistance = 6 })
	local flush = Kit.part(m, cf, "FlushButton", V3(0.6, 0.35, 0.08), base * CF(0, 3.0, -0.74), C.metalSoft, M.metal, { canCollide = false, canTouch = false })
	flush:SetAttribute("FixtureKey", key)
	Kit.action(flush, "flush", "Flush", nil, { actionText = "Flush", maxDistance = 6 })
	local water = Kit.part(m, cf, "ToiletWater", V3(1.0, 0.05, 1.2), base * CF(0, 1.32, -1.45), C.water, M.smooth, { detail = true, transparency = 0.25 })
	water:SetAttribute("FixtureKey", key)
	Kit.fx(water, "flow", { FxAxis = "y", FxTravel = -0.3, FxRate = 3, FxSeconds = 2 })
	local wall = Kit.place(65.5, Y, -78, "S")
	Kit.part(m, cf, "VanityTop", V3(3.6, 0.25, 1.8), wall * CF(0, 2.85, -0.9), C.stone, M.marble)
	Kit.part(m, cf, "Basin", V3(1.6, 0.35, 1.3), wall * CF(0, 3.1, -0.95), C.white, M.smooth)
	local tap = Kit.part(m, cf, "Tap", V3(0.2, 0.7, 0.5), wall * CF(0, 3.55, -0.35), C.metalSoft, M.metal, { canCollide = false })
	tap:SetAttribute("FixtureKey", "G0_WC_B")
	Kit.action(tap, "tap", "Tap", nil, { actionText = "Wash hands", maxDistance = 6 })
	local tapWater = Kit.part(m, cf, "TapWater", V3(0.15, 0.55, 0.15), wall * CF(0, 3.25, -0.6), C.water, M.smooth, { detail = true, transparency = 1 })
	tapWater:SetAttribute("FixtureKey", "G0_WC_B")
	tapWater:SetAttribute("FxShow", 0.5)
	Kit.fx(tapWater, "flow", { FxSeconds = 6 })
	Kit.part(m, cf, "Mirror", V3(3.2, 3.2, 0.08), wall * CF(0, 5.6, -0.05), C.glassDeep, M.glass, { detail = true, reflectance = 0.25 })
end

local function furnishPorch(ctx: Ctx)
	local m = fit(ctx, "G0_PORCH")
	local cf = ctx.cf
	local seed = Kit.hash("G0_PORCH")
	local y = 0.12 -- porch paving
	-- two benches against the facade: applicants wait here for their interview (Waiting activities,
	-- public; staff never use them)
	local k = 0
	for i, x in { 69, 86.5 } do
		local seats = Kit.bench(m, cf, Kit.place(x, y, -120.4, "S"), 6, seed + i)
		for _, s in seats do
			k += 1
			local lp = cf:ToObjectSpace(s.CFrame).Position
			Kit.activity(m, cf, "G0_PORCH_Wait" .. k, "Waiting", "visitor", "any", Kit.facing(V3(lp.X, y + 2.8, -122.4), V3(lp.X, y + 2.8, -130)), 0, ctx.owner, s, {
				roomAccess = "public",
				homeRoom = "G0_PORCH",
				facing = V3(lp.X, y + 2.8, -130),
			})
		end
	end
	for i, x in { 73.2, 80.8 } do
		Kit.plant(m, cf, CF(x, y, -120.6), "m", seed + 10 + i)
	end
	Kit.part(m, cf, "Doormat", V3(4.4, 0.05, 2.2), CF(77, y + 0.025, -120.4), C.fabricCharcoal, M.fabric, DETAIL)
end

function Garage.build(ctx: any)
	if ctx.tier &gt;= 1 then
		return
	end
	for _, step in { furnishLab, furnishAssistant, furnishFounder, furnishWc, furnishPorch } do
		local ok, err = pcall(function(): any
			step(ctx :: Ctx)
			return nil
		end)
		if not ok then
			warn(`[RoomKitsGarage] {err}`)
		end
	end
end

return Garage
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000029"><Properties><string name="Name">RoomKitsHotel</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- RoomKitsHotel: the company guest house (hotel annex, Plan.hasHotel). Runs after InteriorDesign (room
-- models, walls, interior doors, floors, ceilings, nameplates, cameras, access volumes) and the exterior
-- (facade, entrance and terrace doors, roof). Builds the switchback stair and furnishes every room:
--   lobby: two-station reception counter (fluted oak, stone ledge, brass plate) with the receptionist
--          (operations post 13 "Hotel Reception": seated, job points greet / printer with the key-card
--          printer PropFx), walnut back wall with the company name and "GUEST HOUSE" in brass,
--          backlit key-cubby grid, live reception screen, lounge (sofa + 2 armchairs = Waiting seats)
--          before a sheer curtain, pendants, concierge desk, luggage trolley, an art screen on the
--          entrance axis, artwork, plants, rugs;
--   breakfast room: buffet (food, sneeze guard, menu board) with a coffee machine (Coffee activities),
--          3 tables x 4 + 8 window-bar Dining seats;
--   pantry, housekeeping (operations post 14 "Housekeeping": cart + job points room1..room4 in the
--          ground-floor guest rooms), front office;
--   workshop room: 10 Meeting seats (MeetingRoom "HotelWorkshop"), whiteboard, screen;
--   12 guest rooms (bed, bedside tables, framed print, desk + chair, wardrobe, TV with a welcome page,
--          curtains, en-suite with toilet, basin and
--          shower behind a cubicle door; FixtureKey contract), suite 208 with a lounge corner.
-- Seats for guests are "Waiting" (lobby) / "Dining" / "Meeting" activities in guest-class rooms: staff
-- never take them (clearance), the later guest NPCs can. Everything sits INSIDE ctx.rooms[id].
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local A = require(ReplicatedStorage.Shared.Config.ArchPalette)
local Kit = require(script.Parent.ArchKit)

local C, M = A.color, A.material
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local PI = math.pi
local DETAIL: Kit.Opts = { detail = true }
local GLASS: Kit.Opts = { transparency = A.glassTransparency, castShadow = false }
local WATER: Kit.Opts = { detail = true, transparency = 1 }
local FIN = Kit.FINISH

local Hotel = {}

type Ctx = { office: Model, cf: CFrame, tier: number, owner: number, accent: Color3, company: string, folders: { [string]: Instance }, rooms: { [string]: Model } }
type Room = Plan.Room

local function fit(ctx: Ctx, r: Room): Model
	local room = ctx.rooms[r.id]
	if not room then
		local created = Kit.model(ctx.folders.Rooms, r.id, true)
		created:SetAttribute("RoomId", r.id)
		created:SetAttribute("RoomName", r.name)
		created:SetAttribute("RoomKind", r.kind)
		created:SetAttribute("Level", r.level)
		created:SetAttribute("AccessClass", r.access)
		ctx.rooms[r.id] = created
		room = created
	end
	return Kit.model(room :: Model, "FitOut")
end

local function floorY(r: Room): number
	return Plan.levelY(r.level) + FIN
end

-- Activity point (building-local stand point p, look-at point f; heights are taken from p.Y).
local function activity(ctx: Ctx, parent: Model, r: Room, id: string, kind: string, dept: string, p: Vector3, f: Vector3, seat: Seat?, extra: { [string]: any }?): Model
	local stand = V3(p.X, floorY(r) + 2.8, p.Z)
	local look = V3(f.X, floorY(r) + 2.8, f.Z)
	return Kit.activity(parent, ctx.cf, id, kind, dept, if kind == "Service" then "support" else "any", Kit.facing(stand, look), r.level, ctx.owner, seat, {
		roomAccess = r.access,
		homeRoom = r.id,
		facing = look,
		meetingRoom = extra and extra.meetingRoom,
		attributes = extra and extra.attributes,
	})
end

-- Operations post with job points (PROPFX_CONTRACT §9): JobPoint_&lt;name&gt; / JobFace_&lt;name&gt; / JobProp_&lt;name&gt;.
type JobPoint = { name: string, stand: Vector3, face: Vector3, prop: string? }
local function opsPost(ctx: Ctx, parent: Model, r: Room, i: number, stand: Vector3, face: Vector3, seat: Seat?, points: { JobPoint })
	local post = activity(ctx, parent, r, "OperationsStation" .. i, "Service", "operations", stand, face, seat, { attributes = { OpsIndex = i } })
	for _, jp in points do
		local y = Plan.levelY(jp.stand.Y) + FIN + 2.8 -- jp.stand.Y carries the level of the point
		post:SetAttribute("JobPoint_" .. jp.name, ctx.cf:PointToWorldSpace(V3(jp.stand.X, y, jp.stand.Z)))
		post:SetAttribute("JobFace_" .. jp.name, ctx.cf:PointToWorldSpace(V3(jp.face.X, y, jp.face.Z)))
		if jp.prop then
			post:SetAttribute("JobProp_" .. jp.name, jp.prop)
		end
	end
	return post
end

-- Chair (sitter faces the point `to`) with a Dining / Meeting activity. The NPC stands `stand` away from
-- the chair (building-local offset; default: 1.6 behind and 1.6 to the side).
local function seatWithActivity(ctx: Ctx, parent: Model, r: Room, id: string, kind: string, dept: string, x: number, z: number, to: Vector3, seed: number, extra: { [string]: any }?, stand: Vector3?): Seat
	local y = floorY(r)
	local seat = Kit.meetingChair(parent, ctx.cf, Kit.facing(V3(x, y, z), V3(to.X, y, to.Z)), seed)
	local back = V3(x - to.X, 0, z - to.Z)
	back = if back.Magnitude &gt; 0.01 then back.Unit else V3(0, 0, 1)
	local side = V3(-back.Z, 0, back.X)
	local p = V3(x, y, z) + (stand or (back * 1.6 + side * 1.6))
	local a = activity(ctx, parent, r, id, kind, dept, p, to, seat, extra)
	a:SetAttribute("TablePoint", ctx.cf:PointToWorldSpace(V3(x, y, z) - back * 1.9 + V3(0, 3.2, 0)))
	return seat
end

---------------------------------------------------------------------------------------------
-- Built lettering for the house name (the parapet signs in ExteriorDesign): one part per
-- stroke, so the words read at any distance (SurfaceGui text fades out at MaxDistance) and need no
-- texture. Glyph = advance + strokes {u1, u2, v1, v2} in cap heights; only the letters the signs use.
---------------------------------------------------------------------------------------------
local SW = 0.16 -- stroke width (cap heights)
local MID1, MID2 = 0.5 - SW / 2, 0.5 + SW / 2
local GLYPHS: { [string]: { w: number, s: { { number } } } } = {
	G = { w = 0.7, s = { { 0, 0.7, 1 - SW, 1 }, { 0, SW, SW, 1 - SW }, { 0, 0.7, 0, SW }, { 0.7 - SW, 0.7, SW, 0.48 }, { 0.36, 0.7 - SW, 0.48 - SW, 0.48 } } },
	U = { w = 0.62, s = { { 0, SW, SW, 1 }, { 0.62 - SW, 0.62, SW, 1 }, { 0, 0.62, 0, SW } } },
	E = { w = 0.55, s = { { 0, SW, 0, 1 }, { SW, 0.55, 1 - SW, 1 }, { SW, 0.47, MID1, MID2 }, { SW, 0.55, 0, SW } } },
	S = { w = 0.62, s = { { 0, 0.62, 1 - SW, 1 }, { 0, SW, MID2, 1 - SW }, { 0, 0.62, MID1, MID2 }, { 0.62 - SW, 0.62, SW, MID1 }, { 0, 0.62, 0, SW } } },
	T = { w = 0.6, s = { { 0, 0.6, 1 - SW, 1 }, { 0.3 - SW / 2, 0.3 + SW / 2, 0, 1 - SW } } },
	H = { w = 0.62, s = { { 0, SW, 0, 1 }, { 0.62 - SW, 0.62, 0, 1 }, { SW, 0.62 - SW, MID1, MID2 } } },
	O = { w = 0.68, s = { { 0, SW, 0, 1 }, { 0.68 - SW, 0.68, 0, 1 }, { SW, 0.68 - SW, 1 - SW, 1 }, { SW, 0.68 - SW, 0, SW } } },
	[" "] = { w = 0.34, s = {} },
}
local GLYPH_GAP = 0.16

-- Width of `text` in studs at cap height `height`.
function Hotel.lettersWidth(text: string, height: number): number
	local w = 0
	for i = 1, #text do
		local g = GLYPHS[string.sub(text, i, i)]
		if g then
			w += g.w + (if i &lt; #text then GLYPH_GAP else 0)
		end
	end
	return w * height
end

-- `text` on the plane of `at` (cf-local): origin = middle of the baseline, LookVector INTO the wall (the
-- viewer's direction), so +X reads left to right; strokes stand `depth` proud towards the viewer.
-- Characters without a glyph are skipped. Parts are decor (no collision/touch/query/shadow).
function Hotel.letters(parent: Instance, cf: CFrame, text: string, at: CFrame, height: number, depth: number, color: Color3, material: Enum.Material)
	local cursor = -Hotel.lettersWidth(text, height) / 2
	for i = 1, #text do
		local g = GLYPHS[string.sub(text, i, i)]
		if g then
			for _, s in g.s do
				local w, h = (s[2] - s[1]) * height, (s[4] - s[3]) * height
				local x, y = cursor + (s[1] + s[2]) / 2 * height, (s[3] + s[4]) / 2 * height
				Kit.part(parent, cf, "SignLetter", V3(w, h, depth), at * CF(x, y, depth / 2), color, material, DETAIL)
			end
			cursor += (g.w + GLYPH_GAP) * height
		end
	end
end

-- Flat GUI frame (centre x, y and size w, h as fractions of the parent), optionally rounded by a UICorner.
local function guiBlock(parent: Instance, name: string, x: number, y: number, w: number, h: number, color: Color3, radius: number?, z: number?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z or 1
	if radius then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(radius, 0)
		corner.Parent = f
	end
	f.Parent = parent
	return f
end

-- Folds of a sheer curtain (0 extra parts): soft vertical bands, one per `pitch` studs, on one face of the
-- curtain part (lit by the room, culled beyond `maxDistance`); the curtain's own translucency shows between them.
local function sheerPleats(part: BasePart, face: Enum.NormalId, pitch: number, maxDistance: number)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Pleats"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 10
	gui.LightInfluence = 1
	gui.MaxDistance = maxDistance
	gui.Parent = part
	local width = if face == Enum.NormalId.Left or face == Enum.NormalId.Right then part.Size.Z else part.Size.X
	local n = math.max(1, math.floor(width / pitch))
	for i = 1, n do
		local f = guiBlock(gui, "Fold" .. i, (i - 0.5) / n, 0.5, 0.42 / n, 1, C.fabricSand:Lerp(C.white, 0.2))
		f.BackgroundTransparency = 0.3
	end
end

---------------------------------------------------------------------------------------------
-- Guest rooms (room frame: u = into the room from the corridor wall, v = along the room from the
-- door end; west-strip rooms are the east layout turned by 180°)
---------------------------------------------------------------------------------------------
local function roomFrame(r: Room): (CFrame, number, number)
	local y = floorY(r)
	local door = r.doors[1]
	if door and door.face == "E" then
		-- west strip: corridor wall at x2, door end at z2
		return CF(r.x2, y, r.z2) * ANG(0, PI, 0), r.x2 - r.x1, r.z2 - r.z1
	end
	return CF(r.x1, y, r.z1), r.x2 - r.x1, r.z2 - r.z1
end

-- yaw in the room frame so that an object's front (-Z) faces the given local direction
local FACE_U, FACE_MINUS_U, FACE_V = ANG(0, -PI / 2, 0), ANG(0, PI / 2, 0), ANG(0, PI, 0)

local function bed(m: Model, cf: CFrame, at: CFrame, w: number, seed: number)
	local L = 7.6
	local cover = Kit.pick({ C.fabricSand, C.sageLight, C.blueSoft, C.white }, seed)
	Kit.part(m, cf, "BedBase", V3(w, 1.3, L - 0.4), at * CF(0, 0.65, -(L / 2 + 0.2)), C.oakDark, M.wood)
	Kit.part(m, cf, "Mattress", V3(w - 0.3, 0.9, L - 0.7), at * CF(0, 1.75, -(L / 2 + 0.25)), C.white, M.fabric)
	Kit.part(m, cf, "Duvet", V3(w - 0.1, 0.2, L * 0.6), at * CF(0, 2.28, -(L * 0.7)), cover, M.fabric, DETAIL)
	Kit.part(m, cf, "Headboard", V3(w + 0.6, 4.4, 0.35), at * CF(0, 2.2, -0.18), Kit.pick({ C.fabricCharcoal, C.fabric, C.oak }, seed + 1), M.fabric)
	for _, k in { -1, 1 } do
		Kit.part(m, cf, "Pillow", V3(w / 2 - 0.5, 0.45, 1.2), at * CF(k * w / 4, 2.42, -1.2), C.white, M.fabric, DETAIL)
	end
end

-- Rug w x d with a border (non-colliding; the colours as Kit.rug). Border 0.05 and field 0.10 high: the
-- tops are 0.05 apart, so they do not flicker at distance (Kit.rug's 0.04 / 0.05 do). Returns the field.
local function rug(m: Model, cf: CFrame, at: CFrame, w: number, d: number, seed: number, border: Color3?, field: Color3?): Part
	local bc = border or Kit.pick({ C.fabricCharcoal, C.oakDark, C.fabricBlue, C.sage }, seed)
	local fc = field or Kit.pick({ C.fabricSand, C.carpetWarm, C.sageLight, C.blueSoft }, seed + 3)
	Kit.part(m, cf, "RugBorder", V3(w, 0.05, d), at * CF(0, 0.025, 0), bc, M.fabric, DETAIL)
	return Kit.part(m, cf, "Rug", V3(w - 0.6, 0.1, d - 0.6), at * CF(0, 0.05, 0), fc, M.fabric, DETAIL)
end

-- Framed print (0 extra parts): the ArtPrint part is the paper, the picture a seeded composition of
-- SurfaceGui frames on its Front face (a landscape: field, sun disc, hill; or an abstract: block, disc,
-- bar), lit by the room (LightInfluence 1) and culled beyond 30 studs.
local PRINT_COLORS = { C.terracotta, C.sage, C.blue, C.brass, C.oakDark, C.statusBusy, C.fabricBlue, C.sageLight }
local function printArt(part: BasePart, seed: number)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Print"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 1
	gui.MaxDistance = 30
	gui.Parent = part
	-- (x, y) = centre, (w, h) as a fraction of the print; square = both relative to the print's height
	local function shape(name: string, x: number, y: number, w: number, h: number, color: Color3, round: boolean, square: boolean)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		if square then
			f.SizeConstraint = Enum.SizeConstraint.RelativeYY
		end
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		if round then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = f
		end
		f.Parent = gui
	end
	local n = #PRINT_COLORS
	local i1 = 1 + seed % n
	local i2 = 1 + (i1 + 1 + seed % 3) % n
	local i3 = 1 + (i2 + 2) % n
	local c1, c2, c3 = PRINT_COLORS[i1], PRINT_COLORS[i2], PRINT_COLORS[i3]
	if Kit.rand(seed, 1) &lt; 0.5 then
		local sx = Kit.range(seed, 2, 0.28, 0.72)
		shape("Sun", sx, 0.36, 0.44, 0.44, c2, true, true)
		shape("Hill", 1 - sx, 0.72, 0.62, 0.5, c3, true, false)
		shape("Field", 0.5, 0.86, 0.92, 0.2, c1, false, false)
	else
		shape("Block", Kit.range(seed, 3, 0.3, 0.45), 0.5, 0.36, 0.72, c1, false, false)
		shape("Disc", Kit.range(seed, 4, 0.55, 0.72), Kit.range(seed, 5, 0.38, 0.6), 0.6, 0.6, c2, true, true)
		shape("Bar", 0.5, Kit.range(seed, 6, 0.78, 0.86), 0.84, 0.07, c3, false, false)
	end
end

local function nightstand(m: Model, cf: CFrame, at: CFrame, w: number?)
	Kit.part(m, cf, "Nightstand", V3(w or 1.5, 1.9, 1.3), at * CF(0, 0.95, -0.65), C.oak, M.wood)
	Kit.cylinder(m, cf, "LampShade", "y", 0.7, 0.8, at * CF(0, 2.6, -0.65), C.lightWarm, M.neon, DETAIL)
	Kit.cylinder(m, cf, "LampFoot", "y", 0.4, 0.3, at * CF(0, 2.05, -0.65), C.brass, M.metal, DETAIL)
end

-- En-suite inside the guest room frame F: u 0.5..6.5, v 7..13.5 (a partition closes it at v 13.5 in the
-- longer rooms); a cubicle door (u 3.1..6.3) in the v = 7 partition.
local function ensuite(ctx: Ctx, m: Model, r: Room, F: CFrame, W: number)
	local cf = ctx.cf
	local H = Plan.CEILING - 0.15
	local back = 13.5
	Kit.part(m, cf, "BathPartition", V3(2.6, H, 0.3), F * CF(1.8, H / 2, 7), C.white, M.plaster)
	Kit.part(m, cf, "BathPartition", V3(0.3, H, back - 6.85), F * CF(6.5, H / 2, (6.85 + back) / 2), C.white, M.plaster)
	if W &gt; back + 1 then
		Kit.part(m, cf, "BathPartition", V3(6.15, H, 0.3), F * CF(3.575, H / 2, back + 0.15), C.white, M.plaster)
	end
	local key = r.id .. "_BATH"
	local centre = (F * CF(4.7, 0, 7)).Position -- building-local (F is a building-local frame)
	local inward = F:VectorToWorldSpace(V3(0, 0, 1))
	local def: any = {
		id = key,
		level = r.level,
		room = r.id,
		kind = "cubicle",
		access = r.access,
		axis = if math.abs(inward.X) &gt; 0.5 then "z" else "x",
		x = centre.X,
		z = centre.Z,
		w = 3.2,
		h = 7.2,
		inward = inward,
		exterior = false,
		hidden = false,
		builder = "interior",
		y = centre.Y,
		thickness = 0.3,
	}
	local _ = W
	local door = Kit.door(ctx.folders.Doors, cf, def :: any, ctx.owner)
	if door then
		door:SetAttribute("FixtureKey", r.id .. "_T")
	end
	-- the partition over the cubicle opening (the door frame takes u 3.1..6.3)
	Kit.part(m, cf, "BathPartitionHead", V3(3.2, H - 7.2, 0.3), F * CF(4.7, 7.2 + (H - 7.2) / 2, 7), C.white, M.plaster)
	-- toilet against the back wall
	local tb = F * CF(2.3, 0, back) -- wall surface, front towards -v (into the bathroom)
	Kit.part(m, cf, "ToiletBowl", V3(1.5, 1.4, 2.2), tb * CF(0, 0.7, -1.3), C.white, M.smooth)
	Kit.part(m, cf, "ToiletTank", V3(1.9, 2.2, 0.7), tb * CF(0, 2.4, -0.35), C.white, M.smooth)
	local seat = Kit.seat(m, cf, "ToiletSeat", V3(1.5, 0.2, 1.8), tb * CF(0, 1.5, -1.4), C.white, M.smooth, { canTouch = false })
	seat.Disabled = true
	seat:SetAttribute("FixtureKey", r.id .. "_T")
	Kit.action(seat, "toilet", "Toilet", nil, { actionText = "Use", maxDistance = 6 })
	local flush = Kit.part(m, cf, "FlushButton", V3(0.6, 0.35, 0.08), tb * CF(0, 3.0, -0.74), C.metalSoft, M.metal, { canCollide = false, canTouch = false })
	flush:SetAttribute("FixtureKey", r.id .. "_T")
	Kit.action(flush, "flush", "Flush", nil, { actionText = "Flush", maxDistance = 6 })
	local tw = Kit.part(m, cf, "ToiletWater", V3(1.0, 0.05, 1.2), tb * CF(0, 1.32, -1.45), C.water, M.smooth, { detail = true, transparency = 0.25 })
	tw:SetAttribute("FixtureKey", r.id .. "_T")
	Kit.fx(tw, "flow", { FxAxis = "y", FxTravel = -0.3, FxRate = 3, FxSeconds = 2 })
	-- basin on the corridor-side wall
	local bb = F * CF(0.5, 0, 9.6) * FACE_U
	Kit.part(m, cf, "VanityTop", V3(2.6, 0.25, 1.5), bb * CF(0, 2.85, -0.75), C.stone, M.marble)
	Kit.part(m, cf, "Basin", V3(1.5, 0.3, 1.1), bb * CF(0, 3.1, -0.8), C.white, M.smooth, DETAIL)
	local tap = Kit.part(m, cf, "Tap", V3(0.2, 0.7, 0.5), bb * CF(0, 3.55, -0.3), C.metalSoft, M.metal, { canCollide = false })
	tap:SetAttribute("FixtureKey", r.id .. "_B")
	Kit.action(tap, "tap", "Tap", nil, { actionText = "Wash hands", maxDistance = 6 })
	local water = Kit.part(m, cf, "TapWater", V3(0.15, 0.55, 0.15), bb * CF(0, 3.25, -0.55), C.water, M.smooth, WATER)
	water:SetAttribute("FixtureKey", r.id .. "_B")
	water:SetAttribute("FxShow", 0.5)
	Kit.fx(water, "flow", { FxSeconds = 6 })
	Kit.part(m, cf, "Mirror", V3(2.4, 3.0, 0.08), bb * CF(0, 5.6, -0.05), C.glassDeep, M.glass, { detail = true, reflectance = 0.25 })
	-- shower in the corner behind a glass screen
	local su, sv = 5.3, back - 1.45
	Kit.part(m, cf, "ShowerTray", V3(1.9, 0.08, 2.8), F * CF(su, 0.04, sv), C.metalSoft, M.slate, DETAIL)
	Kit.part(m, cf, "ShowerScreen", V3(1.9, 7.2, 0.12), F * CF(su, 3.7, back - 2.9), C.glass, M.glass, GLASS)
	local head = Kit.cylinder(m, cf, "ShowerHead", "y", 0.15, 1.1, F * CF(su, 8.0, back - 0.7), C.metalSoft, M.metal, { canCollide = false, castShadow = false })
	head:SetAttribute("FixtureKey", r.id .. "_S")
	Kit.action(head, "shower", "Shower", nil, { actionText = "Start / stop", maxDistance = 8 })
	local sw = Kit.part(m, cf, "ShowerWater", V3(1.0, 7.6, 1.0), F * CF(su, 4.1, back - 0.9), C.water, M.glass, WATER)
	sw:SetAttribute("FixtureKey", r.id .. "_S")
	sw:SetAttribute("FxShow", 0.5)
	Kit.fx(sw, "flow", { FxSeconds = 15 })
end

-- Drapes either side of every room window over a white sheer: one warm rust-sand fabric for the whole house,
-- so from the street each window reads as a curtained guest room through the facade glass (a light drape
-- vanishes against the sheer). Centre plane CURTAIN_U inside the window wall (u = D), 0.15 thick; the desk
-- and the window-side nightstand keep clear of it.
local CURTAIN_U = 0.2
local CURTAIN_COLOR = C.terracotta:Lerp(C.fabricSand, 0.35)

local function guestRoom(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local F, D, W = roomFrame(r)
	local seed = Kit.hash(r.id)
	local suite = r.vip == true
	ensuite(ctx, m, r, F, W)
	local wallEnd = W - 0.5 -- far end wall (headboard)
	-- bed against the far wall, nightstands either side
	local bw = if suite then 7 else 6
	local bu = 12
	bed(m, cf, F * CF(bu, 0, wallEnd), bw, seed)
	nightstand(m, cf, F * CF(bu - bw / 2 - 1.1, 0, wallEnd)) -- 0.05 clear of the headboard
	-- window-side nightstand between the headboard end and the curtain's inner face (CURTAIN_U - 0.075),
	-- &gt;= 0.05 clear of the headboard; in the 17-deep west rooms it narrows to keep &gt;= 0.1 clear of both
	local hbEnd, curtainIn = bu + bw / 2 + 0.3, D - CURTAIN_U - 0.075
	nightstand(m, cf, F * CF(math.min(bu + bw / 2 + 1.1, (hbEnd + curtainIn) / 2), 0, wallEnd), math.min(1.5, curtainIn - hbEnd - 0.2))
	rug(m, cf, F * CF(bu, 0, wallEnd - 6.4), bw + 2, 4.5, seed + 2)
	-- the guest's point in the room (for the later hotel-guest NPCs): at the foot of the bed, facing it.
	-- Its own kind "GuestBed": no employee job or break looks for it, guest clearance only.
	local gp = (F * CF(10.6, 0, 4.4)).Position
	local gf = (F * CF(bu, 0, wallEnd - 4)).Position
	local number = tonumber(string.match(r.name, "(%d+)$"))
	activity(ctx, m, r, r.id .. "_Guest", "GuestBed", "hotel", V3(gp.X, 0, gp.Z), V3(gf.X, 0, gf.Z), nil, {
		attributes = { GuestRoom = r.id, RoomNumber = number, Suite = suite },
	})
	-- framed print over the headboard: paper-coloured print with a seeded picture (SurfaceGui frames)
	local art = F * CF(bu, 0, wallEnd)
	Kit.part(m, cf, "ArtFrame", V3(bw - 1.2, 2.6, 0.1), art * CF(0, 6.6, -0.05), Kit.pick({ C.white, C.oakDark, C.metal }, seed + 11), M.smooth, DETAIL)
	local artPrint = Kit.part(m, cf, "ArtPrint", V3(bw - 2.0, 1.8, 0.04), art * CF(0, 6.6, -0.12), Kit.pick({ C.white, C.fabricSand }, seed + 12), M.smooth, DETAIL)
	printArt(artPrint, seed + 12)
	-- wardrobe and TV on the door-end wall (the TV shows the house's welcome page), writing desk at the window.
	-- The set is a dark screen (SmoothPlastic): the page is self-lit (LightInfluence 0) and culled beyond
	-- 40 studs, so from outside the facade a room TV stays dark instead of a glowing slab.
	Kit.cabinet(m, cf, F * CF(8.8, 0, 0.5) * FACE_V, 3.6, 7.5, seed + 3).Name = "Wardrobe"
	local tvAt = F * CF(12.6, 0, 0.5) * FACE_V
	Kit.part(m, cf, "TVBracket", V3(0.6, 0.6, 0.3), tvAt * CF(0, 5.6, -0.15), C.metal, M.metal, DETAIL)
	local tv = Kit.part(m, cf, "TV", V3(3.6, 2.1, 0.15), tvAt * CF(0, 5.6, -0.38), C.screen, M.smooth, { canCollide = false, castShadow = false })
	local page = Instance.new("SurfaceGui")
	page.Name = "WelcomePage"
	page.Face = Enum.NormalId.Front
	page.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	page.PixelsPerStud = 60
	page.LightInfluence = 0
	page.MaxDistance = 40
	page.Parent = tv
	local bg = Instance.new("Frame")
	bg.Name = "Background"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = C.fabricBlue
	bg.BackgroundTransparency = 0
	bg.BorderSizePixel = 0
	bg.Parent = page
	for i, line in { "WELCOME", ctx.company .. " Guest House", r.name } do
		local t = Instance.new("TextLabel")
		t.Name = "Line" .. i
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0.08, if i == 1 then 0.14 else 0.34 + (i - 1) * 0.16)
		t.Size = UDim2.fromScale(0.84, if i == 1 then 0.3 else 0.14)
		t.Text = line
		t.TextScaled = true
		t.TextColor3 = if i == 1 then C.lightWarm else C.white
		t.Font = if i == 1 then Enum.Font.BuilderSansExtraBold else Enum.Font.BuilderSans
		t.Parent = bg
	end
	local du = D - 1.6 -- desk u D-2.6..D-0.6: clear of the curtain (D-0.275..D-0.125)
	Kit.part(m, cf, "WritingDesk", V3(2.0, 0.2, 4.0), F * CF(du, 3.0, 3.2), C.oak, M.wood)
	for _, dv in { 1.4, 5.0 } do
		Kit.part(m, cf, "DeskLeg", V3(1.8, 2.9, 0.2), F * CF(du, 1.45, dv), C.metal, M.metal)
	end
	Kit.meetingChair(m, cf, F * CF(du - 2.2, 0, 3.2) * FACE_U, seed + 4)
	Kit.part(m, cf, "DeskLamp", V3(0.4, 1.2, 0.4), F * CF(du + 0.3, 3.7, 1.8), C.brass, M.metal, DETAIL)
	-- curtains drawn to both window ends (3.2 wide, 0.04 off the skirting of the side walls, whose faces
	-- are at v 0.5 and W - 0.5: about 2.4 of each shows in front of the glass)
	for _, cv in { 2.2, W - 2.2 } do
		Kit.part(m, cf, "Curtain", V3(0.15, 11.6, 3.2), F * CF(D - CURTAIN_U, 6.0, cv), CURTAIN_COLOR, M.fabric, DETAIL)
	end
	-- a white sheer drawn across the whole window between the glass (u = D) and the drapes: translucent, so
	-- the view stays, and from outside every room window reads as a curtained guest-room window
	local windowSheer = Kit.part(m, cf, "WindowSheer", V3(0.05, 11.6, W - 1.2), F * CF(D - 0.06, 6.0, W / 2), C.white, M.fabric, { detail = true, transparency = 0.45 })
	sheerPleats(windowSheer, Enum.NormalId.Left, 0.8, 40) -- folds on the room side (-u)
	if W &gt; 16 then
		-- bigger rooms: armchair corner at the window between desk and bed; the suite: sofa and two chairs
		local lv = (6.5 + W - 8.6) / 2
		if suite then
			-- sofa under the window facing two armchairs with a side table between them
			Kit.sofa(m, cf, F * CF(D - 2.0, 0, lv) * FACE_MINUS_U, 7, seed + 6)
			Kit.loungeChair(m, cf, F * CF(8.6, 0, lv - 2.2) * FACE_U, seed + 7)
			Kit.loungeChair(m, cf, F * CF(8.6, 0, lv + 2.2) * FACE_U, seed + 8)
			Kit.coffeeTable(m, cf, F * CF(D - 1.6, 0, lv + 5.4), seed + 9, 1.8, 1.8)
		else
			Kit.loungeChair(m, cf, F * CF(D - 2.2, 0, lv) * FACE_MINUS_U, seed + 6)
			Kit.coffeeTable(m, cf, F * CF(D - 2.0, 0, lv + 3.0), seed + 9, 1.8, 1.8)
			Kit.floorLamp(m, cf, F * CF(D - 1.4, 0, lv - 2.6), seed + 10)
		end
	end
end

---------------------------------------------------------------------------------------------
-- Ground floor: lobby, breakfast, pantry, housekeeping, office
---------------------------------------------------------------------------------------------
-- Two-line SurfaceGui sign (title over subtitle) on one face of `part`; LightInfluence 0 = self-lit.
-- Text boards get 100 pixels per stud whatever their size (the subtitle line is only 0.26 of the face
-- height, so it needs the resolution), capped at 1000 px along the face's longer side.
local function signText(part: BasePart, face: Enum.NormalId, title: string, subtitle: string?, titleColor: Color3, subColor: Color3, maxDistance: number, name: string?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name or "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local s = part.Size
	local faceLong = if face == Enum.NormalId.Left or face == Enum.NormalId.Right then math.max(s.Y, s.Z) elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then math.max(s.X, s.Z) else math.max(s.X, s.Y)
	gui.PixelsPerStud = math.min(100, math.floor(1000 / faceLong))
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance
	gui.Parent = part
	local function label(n: string, text: string, y0: number, h: number, color: Color3, font: Enum.Font)
		local t = Instance.new("TextLabel")
		t.Name = n
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0.06, y0)
		t.Size = UDim2.fromScale(0.88, h)
		t.Text = text
		t.TextScaled = true
		t.TextWrapped = true
		t.TextColor3 = color
		t.Font = font
		t.Parent = gui
	end
	if subtitle then
		label("Label", title, 0.1, 0.52, titleColor, Enum.Font.BuilderSansExtraBold)
		label("Sub", subtitle, 0.64, 0.26, subColor, Enum.Font.BuilderSansMedium)
	else
		label("Label", title, 0.14, 0.72, titleColor, Enum.Font.BuilderSansExtraBold)
	end
end

-- Glass globe pendant hanging from the ceiling (13.0 above the floor) at building-local (x, z).
local function globePendant(m: Model, cf: CFrame, x: number, y: number, z: number, drop: number): Part
	Kit.cylinder(m, cf, "PendantCable", "y", drop, 0.06, CF(x, y + 13 - drop / 2, z), C.metal, M.metal, DETAIL)
	return Kit.ball(m, cf, "PendantGlobe", 1.1, CF(x, y + 13 - drop - 0.6, z), C.lightWarm, M.neon, DETAIL)
end

-- Reception counter along z1..z2 at x = -108.7 (front, facing the entrance in +X): oak front with
-- dark oak fluting either side of a brass name plate, stone transaction ledge with an LED strip, stone
-- end returns, a lower work top behind it (x -112.3..-109.7, starting 1.3 behind the south end so the
-- receptionist's hops keep their clearance). Every part name starts with "Reception" (tests/buildings:
-- the negative hop through the desk names it).
local function receptionCounter(m: Model, cf: CFrame, y: number, z1: number, z2: number): Part
	local L, zc = z2 - z1, (z1 + z2) / 2
	Kit.part(m, cf, "ReceptionFront", V3(0.9, 3.42, L - 0.6), CF(-109.25, y + 0.3 + 1.71, zc), C.oak, M.wood)
	Kit.part(m, cf, "ReceptionKick", V3(0.5, 0.3, L - 0.8), CF(-109.35, y + 0.15, zc), C.metal, M.metal)
	local k = 0
	while 2.1 + k * 0.75 &lt;= L / 2 - 0.55 do
		for _, side in { -1, 1 } do
			Kit.part(m, cf, "ReceptionFlute", V3(0.1, 3.1, 0.34), CF(-108.75, y + 2.0, zc + side * (2.1 + k * 0.75)), C.oakDark, M.wood, DETAIL)
		end
		k += 1
	end
	for _, ez in { z1 + 0.15, z2 - 0.15 } do
		Kit.part(m, cf, "ReceptionEnd", V3(1.5, 3.72, 0.3), CF(-109.25, y + 1.86, ez), C.stone, M.marble)
	end
	local ledge = Kit.part(m, cf, "ReceptionLedge", V3(1.6, 0.18, L + 0.2), CF(-109.3, y + 3.81, zc), C.stoneDeep, M.marble)
	Kit.part(m, cf, "ReceptionGlow", V3(0.06, 0.06, L - 0.8), CF(-108.62, y + 3.66, zc), C.lightWarm, M.neon, DETAIL)
	local wz1 = z1 + 1.3
	Kit.part(m, cf, "ReceptionWorktop", V3(2.6, 0.25, z2 - wz1), CF(-111.0, y + 3.025, (wz1 + z2) / 2), C.oakLight, M.wood)
	for _, lz in { wz1 + 0.3, z2 - 0.3 } do
		Kit.part(m, cf, "ReceptionLeg", V3(2.2, 2.9, 0.25), CF(-111.1, y + 1.45, lz), C.oakLight, M.wood)
	end
	local panel = Kit.part(m, cf, "ReceptionPanel", V3(0.06, 1.0, 3.4), CF(-108.72, y + 2.15, zc), C.brass, M.metal, DETAIL)
	Kit.text(panel, "RECEPTION", { face = Enum.NormalId.Right, color = C.oakDark, light = 0.6, maxDistance = 70, pad = 0.14 })
	return ledge
end

-- Staff-side monitor on the work top (screen faces -X, towards the receptionist) with a lit page.
local function staffMonitor(m: Model, cf: CFrame, y: number, z: number, title: string)
	local screen = Kit.part(m, cf, "StaffMonitor", V3(0.1, 1.25, 2.0), CF(-110.35, y + 4.05, z), C.screen, M.smooth, { canCollide = false, castShadow = false })
	Kit.part(m, cf, "MonitorStand", V3(0.5, 0.8, 0.3), CF(-110.2, y + 3.4, z), C.metal, M.metal, DETAIL)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Page"
	gui.Face = Enum.NormalId.Left
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0
	gui.MaxDistance = 40
	gui.Parent = screen
	local bg = Instance.new("Frame")
	bg.Name = "Background"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = C.fabricBlue
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local t = Instance.new("TextLabel")
	t.Name = "Label"
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0.08, 0.1)
	t.Size = UDim2.fromScale(0.84, 0.3)
	t.Text = title
	t.TextScaled = true
	t.TextColor3 = C.white
	t.Font = Enum.Font.BuilderSansBold
	t.Parent = bg
end

-- Bellman's luggage trolley (long axis along z): carpeted deck on casters, brass uprights and hanging
-- rail, two suitcases and a garment bag. The deck collides; the rest is decor.
local function luggageTrolley(m: Model, cf: CFrame, x: number, y: number, z: number)
	Kit.part(m, cf, "TrolleyDeck", V3(2.0, 0.3, 3.6), CF(x, y + 0.65, z), C.brass, M.metal)
	Kit.part(m, cf, "TrolleyCarpet", V3(1.8, 0.06, 3.4), CF(x, y + 0.83, z), C.terracotta, M.fabric, DETAIL)
	for _, dx in { -0.75, 0.75 } do
		for _, dz in { -1.45, 1.45 } do
			Kit.cylinder(m, cf, "TrolleyWheel", "x", 0.2, 0.5, CF(x + dx, y + 0.25, z + dz), C.metal, M.rubber, DETAIL)
		end
	end
	for _, dz in { -1.65, 1.65 } do
		Kit.cylinder(m, cf, "TrolleyPost", "y", 5.1, 0.16, CF(x, y + 0.8 + 2.55, z + dz), C.brass, M.metal, DETAIL)
	end
	Kit.cylinder(m, cf, "TrolleyRail", "z", 3.46, 0.16, CF(x, y + 5.85, z), C.brass, M.metal, DETAIL)
	Kit.part(m, cf, "Suitcase", V3(1.0, 2.3, 1.5), CF(x - 0.3, y + 2.0, z - 0.8), C.blue, M.smooth, DETAIL)
	Kit.part(m, cf, "Suitcase", V3(0.8, 1.6, 1.2), CF(x + 0.45, y + 1.65, z + 0.9), C.fabricCharcoal, M.smooth, DETAIL)
	Kit.part(m, cf, "GarmentBag", V3(0.25, 3.2, 1.3), CF(x + 0.1, y + 4.15, z + 0.5), C.sage, M.fabric, DETAIL)
end

-- Key-cubby grid on the +X face of the rack panel (0 extra parts): four cubbies per row, each backlit
-- (self-lit GUI, LightInfluence 0) with its room number; a brass key tag hangs in about half of them. The
-- panel's own brass shows as the grid between the cubbies.
local function keyGrid(part: BasePart, numbers: { number }, seed: number)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "KeyGrid"
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.LightInfluence = 0
	gui.MaxDistance = 60
	gui.Parent = part
	local cols = 4
	local rows = math.max(1, math.ceil(#numbers / cols))
	local cw, ch = 0.94 / cols, 0.92 / rows
	for i, n in numbers do
		local col, row = (i - 1) % cols, (i - 1) // cols
		local cell = guiBlock(gui, "Cubby" .. n, 0.03 + (col + 0.5) * cw, 0.04 + (row + 0.5) * ch, cw - 0.025, ch - 0.04, C.lightWarm)
		local t = Instance.new("TextLabel")
		t.Name = "Number"
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0.08, 0.06)
		t.Size = UDim2.fromScale(0.84, 0.4)
		t.Text = tostring(n)
		t.TextScaled = true
		t.TextColor3 = C.oakDark
		t.Font = Enum.Font.BuilderSansBold
		t.ZIndex = 2
		t.Parent = cell
		if Kit.rand(seed, i) &lt; 0.55 then
			guiBlock(cell, "KeyTag", 0.5, 0.72, 0.26, 0.4, C.brass, 0.3, 2)
		end
	end
end

-- Tall abstract composition for the lobby art screen (0 extra parts: SurfaceGui frames on the canvas, lit
-- by the room): a terracotta arch, a warm sun disc, a blue block, an oak line and a brass bar on warm
-- paper. Sizes are fractions of the 2.9 x 8.0 canvas (a disc of d studs is d / 2.9 wide, d / 8 high).
local function screenArt(part: BasePart, face: Enum.NormalId)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Print"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 1
	gui.MaxDistance = 60
	gui.Parent = part
	guiBlock(gui, "Arch", 0.44, 0.56, 0.62, 0.5, C.terracotta, 0.5, 1)
	guiBlock(gui, "Sun", 0.64, 0.22, 1.3 / 2.9, 1.3 / 8, C.statusBusy, 0.5, 2)
	guiBlock(gui, "Block", 0.68, 0.74, 0.4, 0.17, C.fabricBlue, nil, 3)
	guiBlock(gui, "Line", 0.2, 0.46, 0.02, 0.56, C.oakDark, nil, 4)
	guiBlock(gui, "Bar", 0.5, 0.9, 0.8, 0.012, C.brass, nil, 5)
end

local function lobby(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	local seed = Kit.hash(r.id)
	-- reception counter on the west side facing the entrance (east), two stations. Its south end stays
	-- clear so the receptionist's direct hops (StaffJobs: seat -&gt; greet -&gt; printer -&gt; seat, straight
	-- Humanoid:MoveTo lines inside the room) pass it with &gt;= 1.0 stud (tests/life/test_routes.py,
	-- tests/buildings/test_geometry.py, tests/hotelpolish). Built first: the counter is what a hop
	-- through the desk hits.
	local CZ1, CZ2 = 95.0, 103.4
	receptionCounter(m, cf, y, CZ1, CZ2)
	local screen = Kit.screen(m, cf, "ReceptionScreen", V3(2.4, 1.4, 0.1), Kit.place(-109.4, y, 102.0, "E") * CF(0, 4.75, 0) * ANG(math.rad(-10), 0, 0), "reception", ctx.accent)
	Kit.prompt(screen, "Guest house reception", ctx.owner, "empire")
	Kit.part(m, cf, "ScreenStand", V3(0.3, 0.3, 0.6), CF(-109.4, y + 4.05, 102.0), C.metal, M.metal, DETAIL)
	-- key-card printer on the south end of the work top (Hotel Reception job point "printer")
	local printer = Kit.part(m, cf, "KeyCardPrinter", V3(1.2, 0.6, 0.9), CF(-111.4, y + 3.45, 97.45), C.metal, M.metal)
	local slot = Kit.part(printer, cf, "CardSlot", V3(0.06, 0.06, 0.7), CF(-110.78, y + 3.55, 97.45), C.statusGood, M.neon, DETAIL)
	slot:SetAttribute("FxGlow", true)
	Kit.fx(printer, "paper,blink", { FxColor = C.statusBusy, FxRate = 3, FxSeconds = 3, PropId = "HotelKeyPrinter" })
	Kit.action(printer, "prop", "Key-card printer", nil, { actionText = "Print", maxDistance = 8 })
	staffMonitor(m, cf, y, 98.9, "RESERVATIONS")
	staffMonitor(m, cf, y, 101.7, "KEY CARDS")
	-- desk bell (a brass dome on the ledge) and flowers
	Kit.ball(m, cf, "DeskBell", 0.5, CF(-108.95, y + 4.0, 96.6), C.brass, M.metal, DETAIL)
	Kit.cylinder(m, cf, "Vase", "y", 0.9, 0.4, CF(-109.5, y + 4.35, 100.1), C.white, M.smooth, DETAIL)
	Kit.ball(m, cf, "Flowers", 0.95, CF(-109.5, y + 5.0, 100.1), C.terracotta, M.fabric, DETAIL)
	-- the receptionist (operations post 13), seated behind the counter; a second station beside it
	local chair = Kit.officeChair(m, cf, Kit.place(-113.4, y, 98.4, "E"), seed + 1, { lite = true, arms = true, canTouch = false })
	opsPost(ctx, m, r, 13, V3(-113.8, 0, 95.6), V3(-108, 0, 98.4), chair, {
		{ name = "greet", stand = V3(-105.6, 0, 90.6), face = V3(-99, 0, 90) },
		{ name = "printer", stand = V3(-113.9, 0, 96.0), face = V3(-111.4, 0, 97.45), prop = "HotelKeyPrinter" },
	})
	Kit.officeChair(m, cf, Kit.place(-113.4, y, 101.7, "E"), seed + 9, { lite = true, arms = true, canTouch = false })
	-- back wall in front of the corridor glazing: walnut panel washed by an LED cove, the house sign
	-- (company name as a self-lit SurfaceGui line on a clear carrier over a brass rule and the words
	-- "GUEST HOUSE"), key-cubby rack
	Kit.part(m, cf, "ReceptionBackWall", V3(0.3, 12.85, 10.4), CF(-115.65, y + 6.425, 98.2), C.oakDark, M.wood)
	Kit.part(m, cf, "WallWashCove", V3(0.5, 0.15, 10.4), CF(-115.25, y + 12.7, 98.2), C.metal, M.metal, DETAIL)
	Kit.part(m, cf, "WallWash", V3(0.06, 0.05, 10.0), CF(-115.05, y + 12.6, 98.2), C.lightWarm, M.neon, DETAIL)
	local sign = Kit.part(m, cf, "LobbyHouseSign", V3(0.05, 1.7, 9.2), CF(-115.45, y + 10.75, 98.2), C.lightWarm, M.smooth, { detail = true, transparency = 1 })
	signText(sign, Enum.NormalId.Right, string.upper(ctx.company), nil, C.lightWarm, C.brass, 90)
	Kit.part(m, cf, "SignRule", V3(0.06, 0.07, 8.6), CF(-115.47, y + 9.75, 98.2), C.brass, M.metal, DETAIL)
	-- "GUEST HOUSE" in brass under the rule: one SurfaceGui line on a clear carrier (seen from inside the
	-- lobby only, so it needs no built letters), lit by the wall wash with a dark oak outline
	local word = Kit.part(m, cf, "LobbyHouseWord", V3(0.05, 1.5, 9.4), CF(-115.45, y + 8.85, 98.2), C.brass, M.smooth, { detail = true, transparency = 1 })
	local wordLabel = Kit.text(word, "GUEST HOUSE", { face = Enum.NormalId.Right, color = C.brass, light = 0.6, font = Enum.Font.BuilderSansBold, maxDistance = 90, pad = 0.04, pps = 100 })
	wordLabel.TextStrokeColor3 = C.oakDark
	wordLabel.TextStrokeTransparency = 0.55
	-- key-cubby rack: a brass grid of backlit cubbies, one per guest room with its number, a key tag in the
	-- free rooms' cubbies (one SurfaceGui on the rack panel)
	Kit.part(m, cf, "KeyRackFrame", V3(0.3, 2.5, 3.3), CF(-115.35, y + 6.1, 95.3), C.oakDark, M.wood, DETAIL)
	local rack = Kit.part(m, cf, "KeyRack", V3(0.3, 2.2, 3.0), CF(-115.25, y + 6.1, 95.3), C.brass, M.metal, DETAIL)
	local numbers: { number } = {}
	for _, g in Plan.rooms(ctx.tier) do
		local n = if g.annex == "hotel" and g.kind == "guestroom" then tonumber(string.match(g.name, "(%d+)$")) else nil
		if n then
			table.insert(numbers, n)
		end
	end
	table.sort(numbers)
	keyGrid(rack, numbers, seed + 13)
	for _, pz in { 97.7, 100.0, 102.3 } do
		local globe = globePendant(m, cf, -110.0, y, pz, 3.4)
		if pz == 100.0 then
			Kit.light(globe, "point", C.lightWarm, 16, 0.9)
		end
	end
	-- lounge at the south facade (guests wait here: Waiting activities); sofa with its back to the glass,
	-- armchairs either side of a stone coffee table, side table lamp, floor lamp, drum pendant
	rug(m, cf, CF(-107.8, y, 80.4), 13, 7.2, seed + 2)
	-- sheer curtain on a ceiling track inside the south glass behind the lounge: the Campus Arcade's back
	-- wall stands 3.4 studs outside it, so the seating looks at soft fabric instead of grey wall
	local sheer = Kit.part(m, cf, "SheerCurtain", V3(13.5, 12.7, 0.1), CF(-108.95, y + 6.45, 76.15), C.fabricSand:Lerp(C.white, 0.5), M.fabric, { detail = true, transparency = 0.4 })
	sheerPleats(sheer, Enum.NormalId.Back, 0.75, 50)
	Kit.part(m, cf, "CurtainTrack", V3(13.7, 0.12, 0.2), CF(-108.95, y + 12.84, 76.2), C.metal, M.metal, DETAIL)
	-- cream sofa with a matching pair of leather armchairs
	local seats = Kit.sofa(m, cf, Kit.place(-107.8, y, 78.0, "N"), 7.2, seed + 3, { color = C.fabricSand })
	for i, s in seats do
		local lp = cf:PointToObjectSpace(s.Position)
		activity(ctx, m, r, string.format("%s_Wait%d", r.id, i), "Waiting", "visitor", V3(lp.X, 0, lp.Z + 2.2), V3(lp.X, 0, lp.Z - 2), s)
	end
	Kit.part(m, cf, "CoffeeTable", V3(3.6, 0.2, 1.6), CF(-107.8, y + 1.3, 82.6), C.stoneDeep, M.marble)
	Kit.part(m, cf, "CoffeeTableBase", V3(2.6, 1.2, 0.9), CF(-107.8, y + 0.6, 82.6), C.oakDark, M.wood)
	Kit.part(m, cf, "Books", V3(1.0, 0.3, 0.7), CF(-108.7, y + 1.55, 82.5), C.blue, M.smooth, DETAIL)
	Kit.cylinder(m, cf, "Bowl", "y", 0.3, 0.9, CF(-106.9, y + 1.55, 82.7), C.brass, M.metal, DETAIL)
	for k, side in { -1, 1 } do
		local x = -107.8 + side * 5.8
		local chairSeat = Kit.loungeChair(m, cf, Kit.place(x, y, 81.2, if side &lt; 0 then "E" else "W"), seed + 5, { color = C.leather })
		activity(ctx, m, r, string.format("%s_Wait%d", r.id, #seats + k), "Waiting", "visitor", V3(x - side * 2.2, 0, 81.2), V3(x, 0, 81.2), chairSeat)
	end
	-- side table (top y + 1.96) with a table lamp: brass stem standing on the top, shade on the stem
	Kit.cylinder(m, cf, "SideTable", "y", 0.12, 1.3, CF(-101.9, y + 1.9, 77.6), C.oakDark, M.wood)
	Kit.cylinder(m, cf, "SideTableStem", "y", 1.8, 0.25, CF(-101.9, y + 0.95, 77.6), C.metal, M.metal, DETAIL)
	Kit.cylinder(m, cf, "TableLampStem", "y", 0.6, 0.15, CF(-101.9, y + 2.26, 77.6), C.brass, M.metal, DETAIL)
	Kit.cylinder(m, cf, "TableLampShade", "y", 0.9, 0.9, CF(-101.9, y + 2.95, 77.6), C.lightWarm, M.neon, DETAIL)
	Kit.floorLamp(m, cf, CF(-114.6, y, 77.8), seed + 8)
	Kit.cylinder(m, cf, "PendantCable", "y", 3.4, 0.06, CF(-107.8, y + 11.3, 81.0), C.metal, M.metal, DETAIL)
	Kit.cylinder(m, cf, "DrumShade", "y", 1.1, 3.4, CF(-107.8, y + 9.05, 81.0), C.fabricSand, M.fabric, DETAIL)
	Kit.cylinder(m, cf, "DrumDiffuser", "y", 0.05, 3.0, CF(-107.8, y + 8.5, 81.0), C.lightWarm, M.neon, DETAIL)
	Kit.plant(m, cf, CF(-99.95, y, 77.7), "l", seed + 6) -- foliage clear of both facade glass lines
	-- north-east: concierge / travel desk under an artwork, luggage trolley parked by the door
	Kit.artwork(m, cf, Kit.place(-103.4, y, 103.5, "S"), 5.6, 3.6, seed + 10, { y = 7.2 })
	Kit.part(m, cf, "ConciergeDesk", V3(2.6, 3.5, 1.1), CF(-103.4, y + 1.75, 101.75), C.oak, M.wood)
	Kit.part(m, cf, "ConciergeTop", V3(2.9, 0.15, 1.4), CF(-103.4, y + 3.6, 101.7) * ANG(math.rad(-8), 0, 0), C.stoneDeep, M.marble)
	Kit.part(m, cf, "ConciergeTablet", V3(1.1, 0.06, 0.75), CF(-103.6, y + 3.72, 101.6) * ANG(math.rad(-8), 0, 0), C.screen, M.smooth, DETAIL)
	local plate = Kit.part(m, cf, "ConciergeSign", V3(2.2, 0.75, 0.06), CF(-103.4, y + 2.6, 101.17), C.brass, M.metal, DETAIL)
	signText(plate, Enum.NormalId.Front, "CONCIERGE", "City · Airport · Port Meridian", C.oakDark, C.oakDark, 50)
	Kit.part(m, cf, "BrochureRack", V3(1.0, 3.0, 0.5), CF(-101.4, y + 1.5, 101.9), C.oakDark, M.wood, DETAIL)
	for k, col in { C.terracotta, C.blue } do
		Kit.part(m, cf, "Brochure", V3(0.7, 0.8, 0.06), CF(-101.4, y + 0.6 + k * 1.0, 101.62) * ANG(math.rad(-12), 0, 0), col, M.smooth, DETAIL)
	end
	luggageTrolley(m, cf, -100.4, y, 96.7)
	Kit.plant(m, cf, CF(-99.6, y, 101.75), "l", seed + 7) -- planter and foliage clear of the north wall
	-- focal piece on the entrance axis (the first thing seen from the door): a free-standing oak-framed art
	-- screen in front of the corridor glass between door D2 and the back wall, a plant in front of it
	Kit.part(m, cf, "ArtScreenFrame", V3(0.12, 8.6, 3.5), CF(-115.74, y + 4.3, 91.05), C.oakDark, M.wood, DETAIL)
	local screenCanvas = Kit.part(m, cf, "ArtScreen", V3(0.04, 8.0, 2.9), CF(-115.66, y + 4.3, 91.05), C.fabricSand:Lerp(C.white, 0.6), M.fabric, DETAIL)
	screenArt(screenCanvas, Enum.NormalId.Right)
	Kit.plant(m, cf, CF(-114.3, y, 91.4), "m", seed + 11)
	-- door mat inside the entrance, a large rug on the walk from the door to the counter and the corridor
	-- (overlays at least 0.05 apart: no flicker at distance)
	Kit.part(m, cf, "EntranceMat", V3(2.6, 0.06, 6.6), CF(-99.7, y + 0.03, 90), C.fabricCharcoal, M.fabric, DETAIL)
	rug(m, cf, CF(-107.6, y, 89.9), 11, 8.4, seed, C.oakDark, C.carpetWarm)
end

local function breakfast(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	local seed = Kit.hash(r.id)
	-- buffet along the north wall (west of the pantry door) with the coffee machine: juice and milk,
	-- a chafing dish, bread basket, fruit bowl, plates and cups under a sneeze guard and a menu board
	Kit.counter(m, cf, Kit.place(-110, y, 137.6, "S"), 9, seed, nil)
	local top = y + 3.65
	for k, x in { -112.6, -110.4, -108.2 } do
		Kit.part(m, cf, "BuffetTray", V3(1.8, 0.25, 1.2), CF(x, y + 3.78, 137.4), Kit.pick({ C.white, C.terracotta, C.sageLight }, seed + k), M.smooth, DETAIL)
	end
	Kit.cylinder(m, cf, "Juice", "y", 1.0, 0.5, CF(-114.05, top + 0.5, 137.0), C.statusBusy, M.glass, DETAIL)
	Kit.cylinder(m, cf, "Milk", "y", 1.0, 0.5, CF(-114.05, top + 0.5, 138.0), C.white, M.smooth, DETAIL)
	Kit.cylinder(m, cf, "ChafingDish", "x", 1.6, 0.9, CF(-112.6, top + 0.3, 137.4), C.metalSoft, M.metal, DETAIL)
	Kit.part(m, cf, "BreadBasket", V3(1.4, 0.4, 0.9), CF(-110.4, top + 0.45, 137.4), C.oak, M.wood, DETAIL)
	for k = -1, 1 do
		Kit.ball(m, cf, "BreadRoll", 0.5, CF(-110.4 + k * 0.42, top + 0.72, 137.4 + k * 0.08), C.oakLight, M.smooth, DETAIL)
	end
	Kit.cylinder(m, cf, "FruitBowl", "y", 0.35, 1.3, CF(-108.2, top + 0.42, 137.4), C.white, M.smooth, DETAIL)
	for k, col in { C.statusBad, C.statusBusy, C.statusGood, C.terracotta } do
		local a = k * PI / 2
		Kit.ball(m, cf, "Fruit", 0.45, CF(-108.2 + math.cos(a) * 0.3, top + 0.72, 137.4 + math.sin(a) * 0.3), col, M.smooth, DETAIL)
	end
	Kit.cylinder(m, cf, "PlateStack", "y", 0.45, 0.85, CF(-106.6, top + 0.22, 136.85), C.white, M.smooth, DETAIL)
	Kit.cylinder(m, cf, "CupStack", "y", 0.7, 0.45, CF(-105.85, top + 0.35, 137.1), C.white, M.smooth, DETAIL)
	Kit.part(m, cf, "SneezeGuard", V3(6.6, 0.08, 1.0), CF(-110.4, top + 1.85, 136.75) * ANG(math.rad(-20), 0, 0), C.glass, M.glass, { detail = true, transparency = 0.6 })
	for _, x in { -113.6, -107.2 } do
		Kit.part(m, cf, "GuardPost", V3(0.12, 1.75, 0.12), CF(x, top + 0.9, 137.15), C.metal, M.metal, DETAIL)
	end
	local menu = Kit.part(m, cf, "MenuBoard", V3(4.6, 1.5, 0.1), CF(-110.2, y + 7.4, 139.45), C.metal, M.metal, DETAIL)
	signText(menu, Enum.NormalId.Front, "BREAKFAST", "Daily 8:00 – 10:30 · coffee all day", C.lightWarm, C.white, 50)
	for _, x in { -112.6, -108.2 } do
		globePendant(m, cf, x, y, 137.2, 3.6)
	end
	local machineAt = CF(-106.6, y + 4.35, 137.9)
	local coffee = Kit.part(m, cf, "PantryCoffee", V3(1.0, 1.4, 1.0), machineAt, C.metal, M.metal)
	local brew = Kit.part(coffee, cf, "BrewLight", V3(0.3, 0.08, 0.04), machineAt * CF(0, 0.45, -0.52), C.metalSoft, M.neon, DETAIL)
	brew:SetAttribute("FxGlow", true)
	Kit.steamEmitter(coffee, "CoffeeSteam", 4, 0.25)
	Kit.fx(coffee, "steam,blink", { FxColor = C.statusBusy, FxRate = 2, FxSeconds = 5 })
	Kit.action(coffee, "prop", "Coffee machine", nil, { actionText = "Brew", maxDistance = 6 })
	for i, x in { -107.4, -105.6 } do
		activity(ctx, m, r, string.format("%s_Coffee%d", r.id, i), "Coffee", "kitchen", V3(x, 0, 134.6), V3(-106.6, 0, 137.9))
	end
	-- three tables with four seats (NPCs step in from the outer side of each chair) and a window bar
	-- with eight stools along the east facade: 20 Dining seats (TablePoint = where the plate goes)
	local n = 0
	local tx = -109.5
	for _, tz in { 109, 118.5, 128 } do
		Kit.meetingTable(m, cf, CF(tx, y, tz), "rect", 5, 3, seed + n)
		Kit.cylinder(m, cf, "BudVase", "y", 0.6, 0.3, CF(tx + 0.9, y + 3.45, tz), C.white, M.glass, DETAIL)
		Kit.ball(m, cf, "Bloom", 0.45, CF(tx + 0.9, y + 3.9, tz), Kit.pick({ C.terracotta, C.statusBusy, C.sageLight }, seed + n + 7), M.fabric, DETAIL)
		for _, dz in { -2.4, 2.4 } do
			for _, dx in { -1.25, 1.25 } do
				n += 1
				seatWithActivity(ctx, m, r, string.format("%s_Dining%d", r.id, n), "Dining", "kitchen", tx + dx, tz + dz, V3(tx + dx, y, tz), seed + 20 + n, nil, V3(if dx &lt; 0 then -2.65 else 2.65, 0, 0))
			end
		end
	end
	Kit.part(m, cf, "WindowBar", V3(1.8, 0.2, 28), CF(-99.1, y + 3.5, 121), C.oak, M.wood) -- z 107..135 (plant corner free)
	for _, z in { 107.5, 120.5, 133.5 } do
		Kit.part(m, cf, "WindowBarLeg", V3(0.3, 3.4, 0.3), CF(-99.1, y + 1.7, z), C.metal, M.metal)
	end
	for k = 0, 7 do
		local z = 107.5 + k * (26 / 7)
		n += 1
		local stool = Kit.stool(m, cf, Kit.place(-101.3, y, z, "E"), seed + 40 + k, 3.0)
		local a = activity(ctx, m, r, string.format("%s_Dining%d", r.id, n), "Dining", "kitchen", V3(-103.3, 0, z), V3(-99.1, 0, z), stool)
		a:SetAttribute("TablePoint", cf:PointToWorldSpace(V3(-99.4, y + 3.7, z)))
	end
	Kit.artwork(m, cf, Kit.place(-107, y, 104.5, "N"), 6, 3.6, seed + 3, { y = 6.2 })
	Kit.plant(m, cf, CF(-99.5, y, 105.65), "m", seed + 4) -- foliage clear of the wall, the glass and the bar
	Kit.plant(m, cf, CF(-114.4, y, 106.0), "m", seed + 5)
end

local function pantry(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	local seed = Kit.hash(r.id)
	Kit.kitchenette(m, cf, Kit.place(-108, y, 151.5, "S"), 12, seed, { coffeeName = "PrepCoffee" })
	Kit.part(m, cf, "PrepTable", V3(6, 0.2, 2.4), CF(-108.5, y + 3.0, 145.5), C.metalSoft, M.metal)
	for _, x in { -111.2, -105.8 } do
		Kit.part(m, cf, "PrepTableLeg", V3(0.2, 2.9, 2.2), CF(x, y + 1.45, 145.5), C.metal, M.metal)
	end
	Kit.part(m, cf, "Dishwasher", V3(2.4, 3.0, 2.2), CF(-99.4, y + 1.5, 149.5), C.metalSoft, M.metal)
	Kit.part(m, cf, "ServiceTrolley", V3(2.0, 3.2, 3.0), CF(-113.6, y + 1.6, 141.9), C.metal, M.metal)
end

local function housekeeping(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	local seed = Kit.hash(r.id)
	for k, z in { 156, 163 } do
		Kit.rackShelf(m, cf, Kit.place(-98, y, z, "W"), 6, seed + k)
		for s = 0, 2 do
			Kit.part(m, cf, "LinenStack", V3(1.2, 0.9, 4.6), CF(-99.2, y + 1.5 + s * 1.9, z), C.white, M.fabric, DETAIL)
		end
	end
	for k, x in { -112, -108.6 } do
		Kit.part(m, cf, "WashingMachine", V3(2.8, 3.4, 2.6), CF(x, y + 1.7, 170.1), C.white, M.smooth)
		local led = Kit.part(m, cf, "WasherLight", V3(0.5, 0.15, 0.06), CF(x, y + 3.0, 168.77), C.statusGood, M.neon, DETAIL)
		Kit.fx(led, "blink", { FxColor = C.statusGood, FxRate = 1, FxIdle = "slow", PropId = "HotelWasher" .. k })
	end
	-- the housekeeping cart (job point "cart") and the housekeeper's post (operations post 14)
	Kit.part(m, cf, "HousekeepingCart", V3(2.2, 3.4, 4.0), CF(-107.4, y + 1.7, 157.8), C.metalSoft, M.metal)
	Kit.part(m, cf, "CartLinen", V3(1.8, 0.8, 3.4), CF(-107.4, y + 3.8, 157.8), C.white, M.fabric, DETAIL)
	local points: { JobPoint } = { { name = "cart", stand = V3(-109.8, 0, 157.8), face = V3(-107.4, 0, 157.8) } }
	-- room1..room4: beside the bed in the four ground-floor guest rooms
	local k = 0
	for _, g in Plan.roomsOnLevel(ctx.tier, 0) do
		if g.kind == "guestroom" and k &lt; 4 then
			k += 1
			local F = roomFrame(g)
			local p = (F * CF(12, 0, 4.2)).Position -- at the foot of the bed
			local f = (F * CF(12, 0, 8)).Position
			table.insert(points, { name = "room" .. k, stand = V3(p.X, 0, p.Z), face = V3(f.X, 0, f.Z) })
		end
	end
	opsPost(ctx, m, r, 14, V3(-109.2, 0, 164.0), V3(-107.4, 0, 158.4), nil, points)
end

local function office(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	local seed = Kit.hash(r.id)
	-- desk with its back to the south wall (the clerk faces the door), safe, luggage shelf on the facade
	Kit.desk(m, cf, Kit.place(-134.5, y, 106.2, "N"), "bench", seed)
	Kit.officeChair(m, cf, Kit.place(-134.5, y, 109.1, "S"), seed + 1, { lite = true })
	Kit.part(m, cf, "Safe", V3(2.2, 3.0, 2.2), CF(-139.6, y + 1.5, 104.4), C.metal, M.metal)
	Kit.rackShelf(m, cf, Kit.place(-141, y, 111.6, "E"), 6, seed + 3)
	for k = 0, 2 do
		Kit.part(m, cf, "Suitcase", V3(1.0, 2.2, 1.6), CF(-140.1, y + 1.2, 109.6 + k * 2), Kit.pick({ C.blue, C.terracotta, C.fabricCharcoal }, seed + k), M.smooth, DETAIL)
	end
end

local function corridor(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	-- runner, wall sconces (Neon, no light objects), fire extinguisher and an exit sign
	Kit.part(m, cf, "Runner", V3(3.6, 0.04, r.z2 - r.z1 - 4), CF(-120, y + 0.02, (r.z1 + r.z2) / 2), C.carpetWarm, M.carpet, DETAIL)
	for z = r.z1 + 12, r.z2 - 6, 16 do
		Kit.part(m, cf, "Sconce", V3(0.2, 0.9, 0.5), CF(-123.4, y + 7.4, z), C.lightWarm, M.neon, DETAIL)
		Kit.part(m, cf, "Sconce", V3(0.2, 0.9, 0.5), CF(-116.6, y + 7.4, z + 8), C.lightWarm, M.neon, DETAIL)
	end
	Kit.cylinder(m, cf, "FireExtinguisher", "y", 1.6, 0.6, CF(-123.2, y + 0.9, r.z2 - 2.2), C.statusBad, M.smooth, DETAIL)
	if r.level == 0 then
		local sign = Kit.part(m, cf, "ExitSign", V3(2.4, 0.8, 0.12), CF(-120, y + 11, r.z2 - 0.2), C.statusGood, M.neon, DETAIL)
		Kit.text(sign, "EXIT · TERRACE", { face = Enum.NormalId.Front, color = C.white, maxDistance = 50, pad = 0.08 })
	end
	Kit.plant(m, cf, CF(-117.6, y, r.z2 - 1.6), "m", Kit.hash(r.id))
end

---------------------------------------------------------------------------------------------
-- Level 1: workshop room
---------------------------------------------------------------------------------------------
local function workshop(ctx: Ctx, r: Room)
	local m = fit(ctx, r)
	local cf = ctx.cf
	local y = floorY(r)
	local seed = Kit.hash(r.id)
	local cx, cz = -107.5, 90
	Kit.meetingTable(m, cf, CF(cx, y, cz) * ANG(0, PI / 2, 0), "boat", 15, 4.0, seed)
	local n = 0
	local centre = V3(cx, y, cz)
	for _, side in { -1, 1 } do
		for _, z in { 84.6, 88.2, 91.8, 95.4 } do
			n += 1
			seatWithActivity(ctx, m, r, string.format("%s_Meet%d", r.id, n), "Meeting", "growth", cx + side * 3.4, z, V3(cx, y, z), seed + n, { meetingRoom = "HotelWorkshop" }, V3(side * 2.4, 0, 1.6))
		end
	end
	for _, e in { -1, 1 } do
		n += 1
		seatWithActivity(ctx, m, r, string.format("%s_Meet%d", r.id, n), "Meeting", "growth", cx, cz + e * 9.6, centre, seed + n, { meetingRoom = "HotelWorkshop" }, V3(2.6, 0, e * 0.8))
	end
	Kit.whiteboard(m, cf, Kit.place(-111, y, 103.5, "S"), 7, "CUSTOMER WORKSHOP\n- goals\n- data we need\n- pilot plan", seed + 20, { y = 5.6 })
	Kit.tvScreen(m, cf, Kit.place(-102.4, y, 103.5, "S"), 6, "meeting", ctx.accent, { y = 6.0, name = "WorkshopScreen" })
	Kit.plant(m, cf, CF(-99.8, y, 77.8), "l", seed + 22)
	Kit.plant(m, cf, CF(-114.6, y, 77.8), "m", seed + 23)
end

---------------------------------------------------------------------------------------------
-- Stair (both storeys, built with the ground-floor stair room)
---------------------------------------------------------------------------------------------
local function pitch(dy: number, dz: number): (number, number, number, number)
	if dz &lt; 0 then
		dy, dz = -dy, -dz
	end
	local a = -math.atan2(dy, dz)
	return a, math.cos(a), math.sin(a), math.sqrt(dy * dy + dz * dz)
end

-- Inclined part across x1..x2 whose top face runs from (yA, zA) to (yB, zB).
local function slopeTop(m: Model, cf: CFrame, name: string, x1: number, x2: number, yA: number, zA: number, yB: number, zB: number, t: number, color: Color3, mat: Enum.Material, opts: Kit.Opts?): Part
	local a, ny, nz, len = pitch(yB - yA, zB - zA)
	local at = CF((x1 + x2) / 2, (yA + yB) / 2 - ny * t / 2, (zA + zB) / 2 - nz * t / 2) * ANG(a, 0, 0)
	return Kit.part(m, cf, name, V3(x2 - x1, t, len), at, color, mat, opts)
end

local function flight(m: Model, cf: CFrame, x1: number, x2: number, yA: number, zA: number, yB: number, zB: number)
	local steps = 12
	-- invisible smooth ramp (what Humanoids and pathfinding walk on) under visual treads
	local ramp = slopeTop(m, cf, "StairRamp", x1, x2, yA, zA, yB, zB, 0.4, C.stone, M.stone)
	ramp.Transparency = 1
	ramp.CanTouch = false
	ramp.CastShadow = false
	ramp:SetAttribute("StairRamp", true)
	local dir = if zB &gt; zA then 1 else -1
	local rise = (yB - yA) / steps
	local going = math.abs(zB - zA) / steps
	for i = 1, steps - 1 do
		local top = yA + rise * i
		local za, zb = zA + dir * going * i, zA + dir * going * (i + 1)
		Kit.part(m, cf, "StairTread", V3(x2 - x1, rise + 0.3, going), CF((x1 + x2) / 2, top - (rise + 0.3) / 2, (za + zb) / 2), C.stone, M.stone, DETAIL)
	end
	slopeTop(m, cf, "StairSoffit", x1, x2, yA - rise, zA, yB - rise, zB, 0.8, C.interior, M.plaster, DETAIL)
	-- wall-side handrail along the walking line
	local a, _, _, len = pitch(yB - yA, zB - zA)
	local hx = if x1 &lt; -136 then x1 + 0.2 else x2 - 0.2
	Kit.part(m, cf, "StairHandrail", V3(0.2, 0.2, len - 1.2), CF(hx, (yA + yB) / 2 + 3.2, (zA + zB) / 2) * ANG(a, 0, 0), C.oak, M.wood, DETAIL)
end

local function stair(ctx: Ctx, r: Room)
	if r.level ~= 0 then
		return
	end
	local m = fit(ctx, r)
	local cf = ctx.cf
	local L = Plan.HOTEL_STAIR_LAYOUT
	local y0, y1 = Plan.levelY(0), Plan.levelY(1)
	local mid = (y0 + y1) / 2
	local Af, Bf, dv = L.flightA, L.flightB, L.divider
	flight(m, cf, Af.x1, Af.x2, y0, Af.z1, mid, Af.z2)
	flight(m, cf, Bf.x1, Bf.x2, mid, Bf.z2, y1, Bf.z1)
	Kit.part(m, cf, "StairLanding", V3(L.inner.x2 - L.inner.x1, 1, L.midLanding.z2 - L.midLanding.z1), CF((L.inner.x1 + L.inner.x2) / 2, mid - 0.5, (L.midLanding.z1 + L.midLanding.z2) / 2), C.stone, M.stone)
	-- divider wall between the flights (to the roof slab), guard over the flight-A void on level 1
	Kit.part(m, cf, "StairDivider", V3(dv.x2 - dv.x1, Plan.HOTEL.roofY - 1, Af.z2 - Af.z1), CF((dv.x1 + dv.x2) / 2, (Plan.HOTEL.roofY - 1) / 2, (Af.z1 + Af.z2) / 2), C.interior, M.plaster)
	local gz = Af.z1 - 0.15
	Kit.part(m, cf, "StairGuardGlass", V3(dv.x1 - L.inner.x1, 3.5, 0.12), CF((L.inner.x1 + dv.x1) / 2, y1 + 1.75, gz), C.glass, M.glass, { transparency = A.railTransparency, castShadow = false })
	Kit.part(m, cf, "StairGuardRail", V3(dv.x1 - L.inner.x1, 0.2, 0.2), CF((L.inner.x1 + dv.x1) / 2, y1 + 3.6, gz), C.metal, M.metal)
	-- level signs on the divider end facing the front landing, one light over the mid landing
	for level = 0, 1 do
		local sign = Kit.part(m, cf, "StairSign", V3(2.2, 2.6, 0.12), CF((dv.x1 + dv.x2) / 2, Plan.levelY(level) + 8.4, Af.z1 - 0.07), C.metal, M.metal, DETAIL)
		Kit.text(sign, if level == 0 then "G\nLobby · Breakfast" else "1\nRooms · Workshop", { face = Enum.NormalId.Front, color = C.white, maxDistance = 50, pad = 0.1 })
	end
	local lamp = Kit.part(m, cf, "StairLight", V3(0.5, 1.4, 0.12), CF((dv.x1 + dv.x2) / 2, mid + 6.8, L.midLanding.z1 + 0.07), C.lightWarm, M.neon, DETAIL)
	Kit.light(lamp, "point", C.lightWarm, 20, 0.9)
end

---------------------------------------------------------------------------------------------
-- Entry point
---------------------------------------------------------------------------------------------
local KITS: { [string]: (Ctx, Room) -&gt; () } = {
	hotel_lobby = lobby,
	hotel_breakfast = breakfast,
	hotel_pantry = pantry,
	hotel_service = housekeeping,
	hotel_office = office,
	hotel_corridor = corridor,
	hotel_workshop = workshop,
	hotel_stair = stair,
	guestroom = guestRoom,
}

function Hotel.build(ctx: any)
	if not Plan.hasHotel(ctx.tier) then
		return
	end
	for _, r in Plan.rooms(ctx.tier) do
		local kit = if r.annex == "hotel" then KITS[r.kind] else nil
		if kit then
			local ok, err = pcall(function(): any
				kit(ctx :: Ctx, r)
				return nil
			end)
			if not ok then
				warn(`[RoomKitsHotel] {r.id} ({r.kind}) failed: {err}`)
			end
		end
	end
end

return Hotel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000030"><Properties><string name="Name">RoomKitsPavilion</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- RoomKitsPavilion: furniture, fixtures, activities, screens and prompts of the wellness pavilion
-- (level 0), the founder services wing (level 1: campus security, founder archive, shelf passage,
-- hidden research lab, prototype lab, model vault), the roof (lobby, terrace, plant zone, solar
-- array, lift machine room) and the pavilion roof garden.
-- Walls, doors (incl. the bookcase, flush and vault doors), floors, ceilings, lights, nameplates,
-- cameras and access volumes come from InteriorDesign; this module only furnishes, and puts
-- everything into ctx.rooms[room.id] (WC cubicle doors go to Office.Doors, SPEC §3).
-- Fixture contracts (FacilityService): SPEC §6, FixtureKey based. Everything is building-local
-- through ctx.cf, so the pavilion works on every plot orientation.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Collection = game:GetService("CollectionService")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Kit = require(script.Parent.ArchKit)

type Room = Plan.Room
-- Per-room build context. y = slab top of the level, fy = top of the floor finish (furniture
-- base indoors; outdoor rooms stand on the slab/paving: fy = y).
type B = {
	ctx: any,
	cf: CFrame,
	room: Room,
	m: Model,
	y: number,
	fy: number,
	owner: number,
	accent: Color3,
	seed: number,
}

local C = Kit.C
local M = Kit.M
local A = Kit.A
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local PI = math.pi
local RAD = math.rad
local DETAIL: Kit.Opts = { detail = true }
local GLASS: Kit.Opts = { transparency = A.glassTransparency, castShadow = false }
local FROSTED: Kit.Opts = { transparency = 0.35, castShadow = false } -- privacy glass (showers)
local WATER: Kit.Opts = { detail = true, transparency = 1 } -- fixture water: hidden until used

local Pavilion = {}
local BUILD: { [string]: (B) -&gt; () } = {}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------
local function roomModel(ctx: any, room: Room): Model
	local existing = ctx.rooms[room.id]
	if existing then
		return existing
	end
	-- InteriorDesign normally creates the room models; keep the contract if it did not.
	local m = Kit.model(ctx.folders.Rooms, room.id, true)
	m:SetAttribute("RoomId", room.id)
	m:SetAttribute("RoomName", room.name)
	m:SetAttribute("RoomKind", room.kind)
	m:SetAttribute("Level", room.level)
	m:SetAttribute("AccessClass", room.access)
	ctx.rooms[room.id] = m
	return m
end

local function at(b: B, x: number, z: number, front: (string | number)?): CFrame
	return Kit.place(x, b.fy, z, front)
end

-- Text on one face; `size` = TextSize in px (nil = scaled to the face).
local function label(part: BasePart, text: string, color: Color3?, size: number?, face: Enum.NormalId?, align: string?): TextLabel
	return Kit.text(part, text, { color = color or C.white, size = size, face = face, align = align, light = 0.4, maxDistance = 60 })
end

-- Lounge activity (SPEC §10) around an existing Seat; `stand` = building-local standing point.
local function lounge(b: B, seat: Seat, index: number, department: string, stand: Vector3)
	local seatLocal = b.cf:ToObjectSpace(seat.CFrame)
	Kit.activity(b.m, b.cf, b.room.id .. "_Lounge" .. index, "Lounge", department, "any", CF(stand.X, b.fy + 2.8, stand.Z), b.room.level, b.owner, seat, {
		roomAccess = b.room.access,
		homeRoom = b.room.id,
		facing = seatLocal.Position,
	})
end

-- Wellness activity (employees' wellness break, EmployeeConfig): `stand` = building-local floor point,
-- `facing` = look-at point; extra = JobPose / JobItem / UseProp / StandCFrame (world) attributes.
local function wellness(b: B, id: string, stand: Vector3, facing: Vector3, seat: Seat?, extra: { [string]: any }): Model
	return Kit.activity(b.m, b.cf, b.room.id .. "_" .. id, "Wellness", "wellness", "any", CF(stand.X, b.fy + 2.8, stand.Z), b.room.level, b.owner, seat, {
		roomAccess = b.room.access,
		homeRoom = b.room.id,
		facing = V3(facing.X, b.fy + 2.8, facing.Z),
		attributes = extra,
	})
end

-- PropFx root (design/PROPFX_CONTRACT.md).
local function fx(inst: Instance, kinds: string, attrs: { [string]: any }?): Instance
	return Kit.fx(inst, kinds, attrs)
end

-- Wall sconce look: brass back plate + warm diffuser (Neon, no light object).
local function sconce(b: B, wall: CFrame, y: number)
	Kit.part(b.m, b.cf, "SconcePlate", V3(0.5, 1.0, 0.08), wall * CF(0, y, -0.04), C.brass, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "SconceGlow", V3(0.32, 0.72, 0.1), wall * CF(0, y, -0.13), C.lightWarm, M.neon, DETAIL)
end

-- Small round side table (detail top + post).
local function sideTable(b: B, x: number, z: number, y: number)
	Kit.cylinder(b.m, b.cf, "SideTableTop", "y", 0.12, 1.3, CF(x, y + 1.6, z), C.oakDark, M.wood, DETAIL)
	Kit.cylinder(b.m, b.cf, "SideTablePost", "y", 1.55, 0.25, CF(x, y + 0.78, z), C.metal, M.metal, DETAIL)
end

-- Raised planter with ornamental grass clumps (box, soil, tufts). `at` centre, length along local X.
local function grassPlanter(b: B, base: CFrame, w: number, d: number, seed: number, h: number?)
	local H = h or 1.8
	local box = Kit.pick({ C.stoneDeep, C.oakDark, C.concrete }, seed)
	Kit.part(b.m, b.cf, "PlanterBox", V3(w, H, d), base * CF(0, H / 2, 0), box, if box == C.oakDark then M.wood else M.stone)
	Kit.part(b.m, b.cf, "Soil", V3(w - 0.4, 0.1, d - 0.4), base * CF(0, H + 0.05, 0), C.soil, M.grass, DETAIL)
	local n = math.clamp(math.floor(w / 2.2), 2, 6)
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * w / n + Kit.range(seed, i, -0.3, 0.3)
		local th = Kit.range(seed, i + 10, 1.6, 2.6)
		local dia = Kit.range(seed, i + 20, 0.9, math.min(1.6, d - 0.5))
		Kit.cylinder(b.m, b.cf, "Grass", "y", th, dia, base * CF(x, H + th / 2, Kit.range(seed, i + 30, -0.2, 0.2)), if i % 2 == 0 then C.foliageLight else C.sageLight, M.leafy, DETAIL)
	end
end

-- Building-local AABB of a door leaf over its closed and open pivot (to keep furniture clear of a
-- sliding bookcase). Returns nil when the door is not built yet.
local function leafBounds(ctx: any, doorId: string): (Vector3?, Vector3?)
	local door = ctx.folders.Doors:FindFirstChild("Door_" .. doorId)
	local leaf = if door then door:FindFirstChild("Leaf1") else nil
	if not leaf or not leaf:IsA("Model") then
		return nil, nil
	end
	local closed, open = leaf:GetAttribute("ClosedPivot"), leaf:GetAttribute("OpenPivot")
	if typeof(closed) ~= "CFrame" or typeof(open) ~= "CFrame" then
		return nil, nil
	end
	local delta = open * closed:Inverse()
	local lo, hi = V3(math.huge, math.huge, math.huge), V3(-math.huge, -math.huge, -math.huge)
	for _, p in leaf:GetDescendants() do
		if p:IsA("BasePart") then
			for _, world in { p.CFrame, delta * p.CFrame } do
				local l = ctx.cf:ToObjectSpace(world)
				local s = p.Size / 2
				for _, k in { V3(1, 1, 1), V3(1, 1, -1), V3(1, -1, 1), V3(1, -1, -1), V3(-1, 1, 1), V3(-1, 1, -1), V3(-1, -1, 1), V3(-1, -1, -1) } do
					local c = l:PointToWorldSpace(s * k)
					lo, hi = lo:Min(c), hi:Max(c)
				end
			end
		end
	end
	return lo, hi
end

---------------------------------------------------------------------------------------------
-- Level 0 · wellness pavilion
---------------------------------------------------------------------------------------------
local function waterDispenser(b: B, wall: CFrame)
	local unit = Kit.part(b.m, b.cf, "WaterDispenser", V3(1.4, 3.6, 1.2), wall * CF(0, 1.8, -0.62), C.white, M.smooth)
	local stream = Kit.part(unit, b.cf, "DispenserStream", V3(0.1, 0.65, 0.1), wall * CF(0, 2.4, -1.28), C.water, M.glass, WATER)
	stream:SetAttribute("FxShow", 0.35)
	fx(unit, "flow", { FxSeconds = 3, PropId = "WellnessWater" })
	Kit.action(unit, "prop", "Water point", "WellnessWater", { actionText = "Drink", maxDistance = 6 })
	Kit.cylinder(b.m, b.cf, "WaterBottle", "y", 1.5, 1.0, wall * CF(0, 4.35, -0.6), C.water, M.glass, { detail = true, transparency = 0.35 })
	Kit.part(b.m, b.cf, "DispenserTap", V3(0.5, 0.3, 0.2), wall * CF(0, 2.8, -1.25), C.metalSoft, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "DripTray", V3(0.9, 0.1, 0.5), wall * CF(0, 2.0, -1.3), C.metal, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "CupHolder", V3(0.35, 1.2, 0.35), wall * CF(1.0, 4.0, -0.11), C.metalSoft, M.metal, DETAIL)
end

local function corridorWellness(b: B)
	local s = b.seed
	local S = 80.5 -- link wall surface (z = 80, 1.0 thick); floor-standing units stand 0.07 off (skirting)
	local N = 93.5 -- solid room walls on z = 94 (restrooms, showers)
	-- benches with art above, plants, a water point and the timetable board along the link wall
	for i, x in { -74, -18, 20, 63 } do
		Kit.bench(b.m, b.cf, at(b, x, S + 1.0, "N"), 6, s + i)
		Kit.artwork(b.m, b.cf, at(b, x, S, "N"), 5, 3.2, s + i * 7, { y = 6.8 })
	end
	local xs, sizes = { -80, -66, -53, -38, -4, 36, 53, 79.5 }, { "l", "m", "s", "m", "l", "m", "s", "l" }
	for i, x in xs do
		Kit.plant(b.m, b.cf, CF(x, b.fy, S + 1.95), sizes[i], s + i * 3)
	end
	waterDispenser(b, at(b, -58.5, S + 0.07, "N"))
	local board = Kit.part(b.m, b.cf, "WellnessTimetable", V3(6, 4.4, 0.15), at(b, -30, S, "N") * CF(0, 5.6, -0.08), C.sage, M.smooth)
	Kit.part(b.m, b.cf, "TimetableFrame", V3(6.3, 4.7, 0.08), at(b, -30, S, "N") * CF(0, 5.6, -0.02), C.oakDark, M.wood, DETAIL)
	Kit.text(board, "WELLNESS TIMETABLE\n07:30  Morning mobility · studio\n12:30  Lunchtime spin · 18 min\n17:30  Stretch &amp; breathe\nSauna  daily from 16:00 · recovery lounge open all day", {
		color = C.white,
		align = "left",
		valign = "top",
		size = 15,
		font = Enum.Font.BuilderSans,
		light = 0.4,
	})
	-- art on the solid restroom / shower walls (glass walls stay clear)
	Kit.artwork(b.m, b.cf, at(b, -0.5, N, "S"), 4, 3, s + 31)
	Kit.artwork(b.m, b.cf, at(b, 31, N, "S"), 5, 3.4, s + 37)
	Kit.artwork(b.m, b.cf, at(b, 51, N, "S"), 4, 3, s + 41)
end

-- Treadmill: runner faces local -Z (console end); the belt stripes (PropFx belt, client-side) slide
-- along local Z while a player's session runs (FacilityService) or an employee runs (Wellness station).
local function treadmill(b: B, base: CFrame, i: number)
	local m, cf = b.m, b.cf
	Kit.part(m, cf, "TreadmillDeck", V3(3.4, 0.5, 7.0), base * CF(0, 0.25, 0.6), C.metal, M.metal)
	Kit.part(m, cf, "TreadmillHood", V3(3.4, 0.8, 1.2), base * CF(0, 0.4, -3.5), C.metalSoft, M.metal)
	Kit.part(m, cf, "TreadmillBelt", V3(2.6, 0.08, 6.6), base * CF(0, 0.54, 0.6), C.fabricCharcoal, M.rubber)
	local station = wellness(b, "Treadmill" .. i, (base * CF(0, 0, 5.6)).Position, (base * CF(0, 0, -3)).Position, nil, {
		JobPose = "run",
		StandCFrame = cf * base * CF(0, 0.58 + 2.8, 0.9),
	})
	local belt = Kit.propModel(m, cf, "TreadmillBeltStripes", base * CF(0, 0.595, 0.6))
	for k, dz in { -2.4, -0.8, 0.8, 2.4 } do
		local stripe = Kit.part(belt, cf, "BeltStripe", V3(2.4, 0.05, 0.15), base * CF(0, 0.595, 0.6 + dz), C.metalSoft, M.smooth, DETAIL)
		stripe:SetAttribute("BeltHome", stripe.CFrame)
		stripe:SetAttribute("BeltMachine", i)
		stripe:SetAttribute("StripeIndex", k)
	end
	-- the stripes run towards the runner's back (+Z) and wrap every 1.6 studs
	fx(belt, "belt", { FxAxis = "z", FxRate = 3, FxTravel = 1.6, FxStation = station.Name, Machine = i })
	for _, x in { -1.55, 1.55 } do
		Kit.part(m, cf, "TreadmillUpright", V3(0.25, 4.1, 0.25), base * CF(x, 2.85, -3.3), C.metal, M.metal)
		Kit.part(m, cf, "TreadmillRail", V3(0.18, 0.18, 2.4), base * CF(x, 4.0, -2.1), C.metalSoft, M.metal, DETAIL)
	end
	local control = Kit.part(m, cf, "TreadmillControl", V3(2.8, 1.1, 0.35), base * CF(0, 4.95, -3.35) * ANG(RAD(-25), 0, 0), C.screen, M.smooth)
	label(control, "READY · 18 SEC", C.statusGood, 16, Enum.NormalId.Back)
	Kit.action(control, "workout", "Treadmill · start session", i, { actionText = "Use", maxDistance = 8 })
end

-- Exercise bike: rider faces local -Z; the flywheel spins about its own axle (local X).
local function exerciseBike(b: B, base: CFrame, machine: number)
	local m, cf = b.m, b.cf
	Kit.part(m, cf, "BikeFrame", V3(0.5, 0.35, 4.6), base * CF(0, 0.175, 0), C.metal, M.metal)
	for _, z in { -2.1, 2.1 } do
		Kit.part(m, cf, "BikeFoot", V3(2.2, 0.3, 0.5), base * CF(0, 0.15, z), C.metal, M.metal)
	end
	local fly = Kit.cylinder(m, cf, "BikeFlywheel", "x", 0.45, 1.8, base * CF(0, 1.25, -1.0), C.metalSoft, M.metal, { canCollide = false })
	fly:SetAttribute("SpinBase", fly.CFrame)
	fly:SetAttribute("BikeMachine", machine)
	Kit.part(m, cf, "BikeStem", V3(0.3, 3.6, 0.3), base * CF(0, 2.3, -2.12), C.metal, M.metal)
	local bars = Kit.part(m, cf, "BikeHandlebars", V3(2.2, 0.22, 0.5), base * CF(0, 4.2, -2.0), C.metal, M.metal)
	Kit.action(bars, "workout", "Exercise bike · start session", machine, { actionText = "Use", maxDistance = 8 })
	Kit.part(m, cf, "BikeConsole", V3(0.9, 0.6, 0.12), base * CF(0, 4.65, -2.05) * ANG(RAD(-20), 0, 0), C.screen, M.smooth, DETAIL)
	Kit.part(m, cf, "BikeSeatPost", V3(0.3, 2.2, 0.3), base * CF(0, 1.45, 1.0), C.metal, M.metal)
	local seat = Kit.seat(m, cf, "BikeSeat", V3(1.4, 0.35, 1.6), base * CF(0, 2.72, 1.0), C.fabricCharcoal, M.fabric)
	local station = wellness(b, "Bike" .. machine, (base * CF(0, 0, 4.0)).Position, (base * CF(0, 0, -3)).Position, seat, { JobPose = "cycle" })
	fx(fly, "spin", { FxAxis = "x", FxRate = 9, FxStation = station.Name, Machine = machine })
end

-- Rowing machine: rower faces local -Z (flywheel end). The fan wheel spins (PropFx) while rowing; the
-- seat never moves (seated characters are welded to it).
local function rower(b: B, base: CFrame, seed: number, machine: number)
	local m, cf = b.m, b.cf
	Kit.part(m, cf, "RowerRail", V3(0.5, 0.35, 7.0), base * CF(0, 0.55, 0.6), C.metalSoft, M.metal)
	Kit.part(m, cf, "RowerHousing", V3(1.4, 1.8, 0.15), base * CF(0, 0.95, -3.75), C.metal, M.metal)
	local fan = Kit.cylinder(m, cf, "RowerFlywheel", "x", 1.0, 1.6, base * CF(0, 0.95, -2.8), C.metal, M.metal, { canCollide = false })
	for _, z in { -2.9, 3.8 } do
		Kit.part(m, cf, "RowerFoot", V3(1.8, 0.35, 0.4), base * CF(0, 0.175, z), C.metal, M.metal)
	end
	Kit.part(m, cf, "RowerFootrest", V3(1.6, 0.15, 0.8), base * CF(0, 0.8, -1.7) * ANG(RAD(-30), 0, 0), C.fabricCharcoal, M.rubber, DETAIL)
	Kit.part(m, cf, "RowerHandle", V3(1.6, 0.12, 0.12), base * CF(0, 1.4, -2.15), C.metal, M.metal, DETAIL)
	Kit.part(m, cf, "RowerMonitorArm", V3(0.15, 0.7, 0.15), base * CF(0, 2.1, -2.9), C.metal, M.metal, DETAIL)
	local monitor = Kit.part(m, cf, "RowerMonitor", V3(0.8, 0.6, 0.1), base * CF(0, 2.6, -2.9) * ANG(RAD(-20), 0, 0), C.screen, M.smooth, DETAIL)
	local seat = Kit.seat(m, cf, "RowerSeat", V3(1.2, 0.3, 1.2), base * CF(0, 0.92, 1.2), Kit.pick({ C.fabricCharcoal, C.fabricBlue }, seed), M.fabric)
	local station = wellness(b, "Rower" .. machine, (base * CF(0, 0, 5.6)).Position, (base * CF(0, 0, -3)).Position, seat, { JobPose = "row" })
	fx(fan, "spin", { FxAxis = "x", FxRate = 7, FxStation = station.Name, Machine = machine })
	Kit.action(monitor, "workout", "Rowing machine · start session", machine, { actionText = "Use", maxDistance = 8 })
end

BUILD.gym = function(b: B)
	local s = b.seed
	local E = -36.5 -- east wall surface (solid, shared with recovery and sauna)
	-- cardio row facing the west glazing: three treadmills, two bikes
	for i, z in { 106, 112, 118 } do
		treadmill(b, at(b, -74.5, z, "W"), i)
	end
	for i, z in { 126, 131 } do
		exerciseBike(b, at(b, -75.5, z, "W"), 3 + i)
	end
	for i, z in { 137, 141.5 } do
		rower(b, at(b, -75, z, "W"), s + i, 5 + i)
	end
	-- functional zone: squat rack on a timber platform, plyo boxes, medicine balls
	Kit.part(b.m, b.cf, "LiftPlatform", V3(8, 0.1, 8), CF(-56, b.fy + 0.05, 113), C.oakDark, M.planks, DETAIL)
	for _, p in { V3(-2.0, 0, -2.2), V3(2.0, 0, -2.2), V3(-2.0, 0, 2.2), V3(2.0, 0, 2.2) } do
		Kit.part(b.m, b.cf, "RackPost", V3(0.3, 7.5, 0.3), CF(-56 + p.X, b.fy + 3.75, 113 + p.Z), C.metal, M.metal)
	end
	for _, x in { -2.0, 2.0 } do
		Kit.part(b.m, b.cf, "RackBeam", V3(0.3, 0.3, 4.7), CF(-56 + x, b.fy + 7.35, 113), C.metal, M.metal)
		Kit.part(b.m, b.cf, "SafetyBar", V3(0.2, 0.2, 4.4), CF(-56 + x, b.fy + 2.6, 113), C.metalSoft, M.metal, DETAIL)
	end
	Kit.cylinder(b.m, b.cf, "Barbell", "x", 7.2, 0.2, CF(-56, b.fy + 4.8, 110.95), C.metalSoft, M.metal, DETAIL)
	for _, x in { -2.9, 2.9 } do
		Kit.cylinder(b.m, b.cf, "BarbellPlate", "x", 0.35, 1.7, CF(-56 + x, b.fy + 4.8, 110.95), C.fabricCharcoal, M.rubber, DETAIL)
	end
	for i, h in { 1.5, 2.0, 2.5 } do
		Kit.part(b.m, b.cf, "PlyoBox", V3(2.4, h, 2.0), CF(-60 + (i - 1) * 3.5, b.fy + h / 2, 131), C.oakLight, M.wood)
	end
	for k = 1, 3 do
		Kit.ball(b.m, b.cf, "MedicineBall", 1.0, CF(-50.2 + (k - 1) * 1.2, b.fy + 0.5, 131.4), Kit.pick({ C.terracotta, C.fabricBlue, C.sage }, s + k), M.rubber, DETAIL)
	end
	-- free weights in front of a satin metal mirror wall
	local wall = at(b, E, 125, "W")
	Kit.part(b.m, b.cf, "MirrorWall", V3(26, 7.84, 0.1), wall * CF(0, 4.53, -0.05), C.glass, M.metal)
	for _, y in { 0.53, 8.53 } do
		Kit.part(b.m, b.cf, "MirrorTrim", V3(26.2, 0.16, 0.14), wall * CF(0, y, -0.07), C.metal, M.metal, DETAIL)
	end
	local board = Kit.part(b.m, b.cf, "GymBoard", V3(18, 2.8, 0.15), wall * CF(0, 10.7, -0.08), C.sage, M.smooth)
	label(board, "MOVE · RESET · BUILD — 18 seconds of exercise", C.white, nil)
	-- dumbbell rack: two tiers, the upper one set back
	local rack = at(b, E - 1.3, 125, "W")
	for _, x in { -6.85, 6.85 } do
		Kit.part(b.m, b.cf, "RackEnd", V3(0.3, 3.0, 2.2), rack * CF(x, 1.5, 0), C.metal, M.metal)
	end
	local tier = Kit.part(b.m, b.cf, "RackTier", V3(13.4, 0.15, 1.0), rack * CF(0, 1.4, -0.5), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "RackTier", V3(13.4, 0.15, 1.0), rack * CF(0, 2.6, 0.5), C.metalSoft, M.metal)
	for k = 1, 6 do
		local x = -6.6 + (k - 0.5) * 2.2
		Kit.cylinder(b.m, b.cf, "Dumbbell", "z", 1.0, 0.42 + k * 0.04, rack * CF(x, 1.72 + k * 0.02, -0.5), C.metal, M.metal, DETAIL)
		Kit.cylinder(b.m, b.cf, "Dumbbell", "z", 1.0, 0.36 + k * 0.03, rack * CF(x, 2.9 + k * 0.015, 0.5), C.fabricCharcoal, M.rubber, DETAIL)
	end
	for k = 1, 3 do
		Kit.ball(b.m, b.cf, "Kettlebell", 0.8 + k * 0.12, rack * CF(-4 + k * 2.2, 0.4 + k * 0.06, -2.2), C.metal, M.metal, DETAIL)
	end
	-- free weights: players start a set at the rack (machine 8), employees lift on a wellness break
	Kit.action(tier, "workout", "Free weights · start set", 8, { actionText = "Lift", maxDistance = 8 })
	wellness(b, "Weights", V3(-41.2, 0, 121), V3(-36.5, 0, 121), nil, { JobPose = "lift", JobItem = "dumbbell" })
	Kit.part(b.m, b.cf, "WeightsMat", V3(12, 0.05, 28), CF(-43.5, b.fy + 0.025, 125), C.fabricCharcoal, M.rubber, DETAIL)
	Kit.part(b.m, b.cf, "WeightBenchPad", V3(4.4, 0.4, 1.4), CF(-45.5, b.fy + 1.5, 125), C.fabricCharcoal, M.leather)
	for _, x in { -47.2, -43.8 } do
		Kit.part(b.m, b.cf, "WeightBenchLeg", V3(0.3, 1.3, 1.2), CF(x, b.fy + 0.65, 125), C.metal, M.metal)
	end
	-- stretching mats facing the garden glazing, foam rollers
	for i, x in { -64, -58.5, -53, -47.5 } do
		Kit.part(b.m, b.cf, "ExerciseMat", V3(2.4, 0.06, 6), CF(x, b.fy + 0.03, 151), Kit.pick({ C.sage, C.fabricBlue, C.fabricCharcoal, C.sageLight }, s + i), M.rubber, DETAIL)
		if i % 2 == 1 then
			Kit.cylinder(b.m, b.cf, "FoamRoller", "x", 2.0, 0.6, CF(x, b.fy + 0.3, 154.6), C.fabricBlue, M.rubber, DETAIL)
		end
	end
	-- towel station by the entrance, plants
	Kit.sideboard(b.m, b.cf, at(b, -44, 94.2, "N"), 6, s)
	for k = 1, 3 do
		Kit.cylinder(b.m, b.cf, "RolledTowel", "z", 1.3, 0.55, at(b, -44, 94.2, "N") * CF(-1.0 + k * 0.6 - 0.6, 3.1, -0.8), C.white, M.fabric, DETAIL)
	end
	Kit.plant(b.m, b.cf, CF(-79.3, b.fy, 157.4), "l", s + 3)
	Kit.plant(b.m, b.cf, CF(-38.6, b.fy, 157.4), "l", s + 5)
	Kit.plant(b.m, b.cf, CF(-38.7, b.fy, 97), "m", s + 7)
end

-- Chaise lounger: sitter faces local -Z (foot end), reclined backrest at +Z.
local function chaise(b: B, base: CFrame, seed: number): Seat
	local cover = Kit.pick({ C.fabricSand, C.sageLight, C.white, C.fabric }, seed)
	Kit.part(b.m, b.cf, "LoungerBase", V3(2.4, 0.8, 5.6), base * CF(0, 0.6, 0), cover, M.fabric)
	Kit.part(b.m, b.cf, "LoungerRunner", V3(2.2, 0.2, 5.2), base * CF(0, 0.1, 0), C.oakDark, M.wood, DETAIL)
	local seat = Kit.seat(b.m, b.cf, "Seat", V3(2.2, 0.35, 3.4), base * CF(0, 1.17, -0.9), cover, M.fabric)
	Kit.part(b.m, b.cf, "LoungerBack", V3(2.2, 0.4, 2.6), base * CF(0, 1.85, 1.65) * ANG(RAD(-35), 0, 0), cover, M.fabric)
	Kit.part(b.m, b.cf, "LoungerPillow", V3(1.6, 0.35, 0.8), base * CF(0, 2.55, 2.0) * ANG(RAD(-35), 0, 0), C.white, M.fabric, DETAIL)
	return seat
end

BUILD.recovery = function(b: B)
	local s = b.seed
	-- west: sofa group around a low table
	local sofa = Kit.sofa(b.m, b.cf, at(b, -33.93, 106, "E"), 8, s, { color = C.sage })
	Kit.coffeeTable(b.m, b.cf, at(b, -29.6, 106, "E"), s + 1, 4, 2.2)
	Kit.loungeChair(b.m, b.cf, Kit.facing(V3(-27.2, b.fy, 110.6), V3(-30, b.fy, 106)), s + 2, { color = C.fabricSand })
	Kit.part(b.m, b.cf, "Magazines", V3(1.2, 0.12, 1.5), CF(-29.6, b.fy + 1.46, 105.2) * ANG(0, 0.3, 0), C.white, M.smooth, DETAIL)
	Kit.floorLamp(b.m, b.cf, at(b, -34.4, 112.8, "S"), s + 4, { light = true, mood = "warm" })
	Kit.rug(b.m, b.cf, CF(-30.5, b.fy, 106), 9, 11, s + 5)
	-- calm wall feature: stone panel with a water sheet into a stone trough
	local fw = at(b, -30, 127.5, "S")
	Kit.part(b.m, b.cf, "WaterWallStone", V3(8.5, 8.95, 0.35), fw * CF(0, 4.925, -0.175), C.stoneDeep, M.stone)
	local sheet = Kit.part(b.m, b.cf, "WaterSheet", V3(7.6, 7.6, 0.05), fw * CF(0, 5.2, -0.4), C.water, M.glass, { detail = true, transparency = 0.45 })
	sheet:SetAttribute("FxShow", 0.45)
	fx(sheet, "flow", { FxIdle = "on", FxRate = 0.6 })
	Kit.part(b.m, b.cf, "WaterSpout", V3(7.8, 0.2, 0.3), fw * CF(0, 9.05, -0.45), C.brass, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "WaterTrough", V3(8.5, 0.9, 1.3), fw * CF(0, 0.45, -0.72), C.stone, M.stone)
	Kit.part(b.m, b.cf, "TroughWater", V3(8.1, 0.05, 1.0), fw * CF(0, 0.9, -0.72), C.water, M.glass, { detail = true, transparency = 0.3 })
	-- two recliners facing the water wall
	local recliners = {
		Kit.loungeChair(b.m, b.cf, at(b, -32, 120.5, "N"), s + 6, { color = C.fabricSand }),
		Kit.loungeChair(b.m, b.cf, at(b, -27.6, 120.5, "N"), s + 7, { color = C.fabricSand }),
	}
	sideTable(b, -29.8, 120.8, b.fy)
	-- east: three chaise loungers along the wall, side tables, plants, soft lamp
	local loungers: { Seat } = {}
	for i, z in { 100.5, 107, 113.5 } do
		table.insert(loungers, chaise(b, at(b, -10.4, z, "W"), s + 10 + i))
	end
	sideTable(b, -8.6, 103.75, b.fy)
	sideTable(b, -8.6, 110.25, b.fy)
	Kit.floorLamp(b.m, b.cf, at(b, -8.2, 118.6, "W"), s + 8)
	Kit.plant(b.m, b.cf, CF(-9, b.fy, 124.6), "l", s + 9)
	Kit.plant(b.m, b.cf, CF(-16.4, b.fy, 125.8), "m", s + 11)
	Kit.plant(b.m, b.cf, CF(-34.4, b.fy, 96.4), "m", s + 12)
	-- staff break points (aisle x -24..-18 to the sauna door stays free)
	lounge(b, recliners[2], 1, "lounge", V3(-24.6, 0, 120.5))
	lounge(b, sofa[1], 2, "lounge", V3(-30.9, 0, 101.9))
	lounge(b, loungers[1], 3, "lounge", V3(-15.0, 0, 100.5))
	lounge(b, loungers[3], 4, "lounge", V3(-15.0, 0, 113.5))
end

BUILD.sauna = function(b: B)
	local s = b.seed
	local cedar, cedarDark = C.oakLight, C.oak
	-- cedar cladding inside (west, east, north liner in front of the facade, south around the door)
	local Y = 12.8
	Kit.part(b.m, b.cf, "CedarCladding", V3(0.15, Y, 30.1), CF(-35.365, b.fy + Y / 2, 143.6), cedar, M.planks)
	Kit.part(b.m, b.cf, "CedarCladding", V3(0.15, Y, 30.1), CF(-6.635, b.fy + Y / 2, 143.6), cedar, M.planks)
	Kit.part(b.m, b.cf, "CedarCladding", V3(28.7, Y, 0.15), CF(-21, b.fy + Y / 2, 158.68), cedar, M.planks)
	Kit.part(b.m, b.cf, "CedarCladding", V3(11.9, Y, 0.15), CF(-29.45, b.fy + Y / 2, 128.635), cedar, M.planks)
	Kit.part(b.m, b.cf, "CedarCladding", V3(11.9, Y, 0.15), CF(-12.55, b.fy + Y / 2, 128.635), cedar, M.planks)
	-- two-tier bench along the north liner, single tier along both side walls
	-- (tiers 1.5 apart: the lower bench is the step up to the upper one; sitters face the stove)
	Kit.part(b.m, b.cf, "BenchUpperBody", V3(27, 2.8, 2.4), CF(-21, b.fy + 1.4, 157.3), cedarDark, M.wood)
	Kit.part(b.m, b.cf, "BenchLowerBody", V3(27, 1.3, 2.2), CF(-21, b.fy + 0.65, 155.0), cedarDark, M.wood)
	local lower: { [number]: Seat } = {}
	for k = 1, 7 do
		local x = -34.5 + (k - 0.5) * 27 / 7
		Kit.seat(b.m, b.cf, "SaunaBench", V3(27 / 7 - 0.06, 0.2, 2.4), CF(x, b.fy + 2.9, 157.3), cedar, M.planks)
		lower[k] = Kit.seat(b.m, b.cf, "SaunaBench", V3(27 / 7 - 0.06, 0.2, 2.2), CF(x, b.fy + 1.4, 155.0), cedar, M.planks)
	end
	-- three lower bench places for employees on a wellness break (the stove steams while they relax)
	for _, k in { 2, 4, 6 } do
		local x = -34.5 + (k - 0.5) * 27 / 7
		wellness(b, "Sauna" .. k, V3(x, 0, 152.6), V3(x, 0, 150), lower[k], { JobPose = "relax", UseProp = "SaunaHeater" })
	end
	for _, side in { -1, 1 } do
		local x = -21 + side * 13.19
		Kit.part(b.m, b.cf, "BenchSideBody", V3(2.2, 1.3, 17.8), CF(x, b.fy + 0.65, 145.0), cedarDark, M.wood)
		for k = 1, 5 do
			local z = 136.1 + (k - 0.5) * 17.8 / 5
			Kit.seat(b.m, b.cf, "SaunaBench", V3(17.8 / 5 - 0.06, 0.2, 2.2), CF(x, b.fy + 1.4, z) * ANG(0, side * PI / 2, 0), cedar, M.planks)
		end
	end
	-- central stove on a stone plinth inside a cedar guard rail
	Kit.part(b.m, b.cf, "StovePlinth", V3(4.4, 0.4, 4.4), CF(-21, b.fy + 0.2, 142.5), C.stoneDeep, M.stone)
	local heater = Kit.part(b.m, b.cf, "SaunaHeater", V3(3, 3.2, 3), CF(-21, b.fy + 2.0, 142.5), C.metal, M.metal)
	fx(heater, "steam", { FxSeconds = 20, PropId = "SaunaHeater" })
	for k = 1, 8 do
		local a = k * 2 * PI / 8
		Kit.ball(b.m, b.cf, "SaunaStone", Kit.range(s, k, 0.7, 1.0), CF(-21 + math.cos(a) * 0.8, b.fy + 3.75, 142.5 + math.sin(a) * 0.8), C.stoneDeep, M.slate, DETAIL)
	end
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Steam"
	steam.Enabled = false
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(C.white)
	steam.Size = NumberSequence.new(2.5)
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.65), NumberSequenceKeypoint.new(1, 1) })
	steam.Rate = 7
	steam.Lifetime = NumberRange.new(1.5, 3)
	steam.Speed = NumberRange.new(1, 2)
	steam.Parent = heater
	Kit.action(heater, "sauna", "Sauna · add steam and relax", nil, { actionText = "Use", maxDistance = 8 })
	for _, p in { { -24, 139.5 }, { -18, 139.5 }, { -24, 145.5 }, { -18, 145.5 } } do
		Kit.part(b.m, b.cf, "GuardPost", V3(0.3, 3.0, 0.3), CF(p[1], b.fy + 1.5, p[2]), cedarDark, M.wood)
	end
	for _, r in { { -21, 139.5, 6, 0.2 }, { -21, 145.5, 6, 0.2 }, { -24, 142.5, 0.2, 6 }, { -18, 142.5, 0.2, 6 } } do
		Kit.part(b.m, b.cf, "GuardRail", V3(r[3], 0.25, r[4]), CF(r[1], b.fy + 2.6, r[2]), cedar, M.wood)
	end
	-- bucket and ladle, towel shelf by the door, hourglass on the east wall
	Kit.cylinder(b.m, b.cf, "SaunaBucket", "y", 0.8, 0.9, CF(-17.2, b.fy + 0.4, 139.2), cedarDark, M.wood, DETAIL)
	Kit.part(b.m, b.cf, "Ladle", V3(0.1, 0.1, 1.6), CF(-17.2, b.fy + 0.9, 139.6) * ANG(RAD(-30), 0, 0), cedar, M.wood, DETAIL)
	local shelf = at(b, -29.5, 128.71, "N")
	Kit.part(b.m, b.cf, "TowelShelf", V3(6, 0.15, 1.3), shelf * CF(0, 5.0, -0.65), cedarDark, M.wood)
	for k = 1, 4 do
		Kit.cylinder(b.m, b.cf, "SaunaTowel", "z", 1.1, 0.6, shelf * CF(-2.25 + (k - 1) * 1.5, 5.38, -0.65), C.white, M.fabric, DETAIL)
	end
	Kit.part(b.m, b.cf, "Hourglass", V3(0.4, 1.0, 0.3), CF(-6.75, b.fy + 5.2, 136), cedarDark, M.wood, DETAIL)
end

-- WC: tiled pre-wall at local +Z side is the caller's; toilet faces local -Z of `base`.
local function toilet(b: B, base: CFrame, key: string)
	local m, cf = b.m, b.cf
	Kit.part(m, cf, "ToiletPedestal", V3(1.2, 1.0, 1.4), base * CF(0, 0.5, 0.35), C.white, M.smooth)
	Kit.part(m, cf, "ToiletBowl", V3(1.6, 0.5, 2.4), base * CF(0, 1.25, 0), C.white, M.smooth)
	local seat = Kit.seat(m, cf, "ToiletSeat", V3(1.5, 0.12, 2.0), base * CF(0, 1.56, 0.05), C.white, M.smooth)
	seat.Disabled = true
	seat:SetAttribute("FixtureKey", key)
	Kit.action(seat, "toilet", "Toilet", nil, { actionText = "Sit", maxDistance = 6 })
	Kit.part(m, cf, "ToiletLid", V3(1.5, 1.8, 0.1), base * CF(0, 2.5, 1.12), C.white, M.smooth, DETAIL)
	local water = Kit.part(m, cf, "ToiletWater", V3(1.0, 0.05, 1.4), base * CF(0, 1.46, -0.1), C.water, M.glass, { detail = true, transparency = 0.45 })
	water:SetAttribute("FixtureKey", key)
	fx(water, "flow", { FxAxis = "y", FxTravel = -0.35, FxRate = 3, FxSeconds = 2 })
	local flush = Kit.part(m, cf, "FlushButton", V3(0.8, 0.5, 0.06), base * CF(0, 3.1, 1.17), C.metalSoft, M.metal)
	flush:SetAttribute("FixtureKey", key)
	Kit.action(flush, "flush", "Toilet", nil, { actionText = "Flush", maxDistance = 6 })
end

BUILD.restrooms = function(b: B)
	local s = b.seed
	local room = b.room
	local laminate = Kit.pick({ C.sageLight, C.white, C.oakLight, C.blueSoft }, Kit.hash(room.id)) -- = cubicle doors
	local lamMat = if laminate == C.oakLight then M.wood else M.smooth
	-- four cubicles against the west wall: tiled pre-wall, partitions, front panels, cubicle doors
	local Z0, W, FX, DW = 118.5, 5.8, 1.5, 3.6 -- first partition, cubicle width, front line x, door width
	Kit.part(b.m, b.cf, "PreWall", V3(1.0, 4.0, 4 * W), CF(-4.93, b.fy + 2.0, Z0 + 2 * W), C.white, M.tile)
	Kit.part(b.m, b.cf, "PreWallShelf", V3(1.1, 0.12, 4 * W), CF(-4.88, b.fy + 4.06, Z0 + 2 * W), C.stone, M.marble, DETAIL)
	for k = 0, 4 do
		Kit.part(b.m, b.cf, "CubiclePartition", V3(7, 6.7, 0.15), CF(-2, b.fy + 3.85, Z0 + k * W), laminate, lamMat)
	end
	local side = (W - DW) / 2 -- front panel beside each door
	local panels = { { Z0, Z0 + side } }
	for k = 1, 3 do
		table.insert(panels, { Z0 + k * W - side, Z0 + k * W + side })
	end
	table.insert(panels, { Z0 + 4 * W - side, Z0 + 4 * W })
	for _, p in panels do
		Kit.part(b.m, b.cf, "CubicleFront", V3(0.15, 6.7, p[2] - p[1]), CF(FX, b.fy + 3.85, (p[1] + p[2]) / 2), laminate, lamMat)
	end
	for k = 1, 4 do
		local c = Z0 + (k - 0.5) * W
		local key = room.id .. "_C" .. k
		toilet(b, at(b, -3.23, c, "E"), key)
		Kit.part(b.m, b.cf, "PaperHolder", V3(0.5, 0.5, 0.3), CF(-1.6, b.fy + 2.4, Z0 + (k - 1) * W + 0.25), C.metalSoft, M.metal, DETAIL)
		local def: any = {
			id = key,
			level = room.level,
			room = room.id,
			kind = "cubicle",
			access = room.access,
			axis = "z",
			x = FX,
			z = c,
			w = DW,
			h = 7.2,
			inward = V3(-1, 0, 0),
			exterior = false,
			hidden = false,
			builder = "interior",
			thickness = 0.15,
			y = b.fy,
		}
		local door = Kit.door(b.ctx.folders.Doors, b.cf, def, b.owner)
		if door then
			door:SetAttribute("FixtureKey", key)
		end
	end
	-- vanity with three basins along the east wall, one long mirror, soap, hand dryers
	local E = 23.5 -- east wall surface (wall-hung fixtures; the towel bin stands clear of the skirting)
	Kit.part(b.m, b.cf, "VanityTop", V3(2.2, 0.25, 15), CF(E - 1.1, b.fy + 3.0, 111.5), C.stone, M.marble)
	Kit.part(b.m, b.cf, "VanityBody", V3(2.0, 1.2, 15), CF(E - 1.0, b.fy + 2.3, 111.5), C.oak, M.wood)
	Kit.part(b.m, b.cf, "WashMirror", V3(0.08, 4.4, 15), CF(E - 0.04, b.fy + 6.4, 111.5), C.glass, M.metal)
	for k, z in { 107, 111.5, 116 } do
		local key = room.id .. "_T" .. k
		Kit.part(b.m, b.cf, "Basin", V3(1.3, 0.2, 1.5), CF(E - 1.3, b.fy + 3.06, z), C.white, M.smooth, DETAIL)
		local tap = Kit.cylinder(b.m, b.cf, "Tap", "y", 0.8, 0.2, CF(E - 0.35, b.fy + 3.5, z), C.metalSoft, M.metal, { canCollide = false, castShadow = false })
		tap:SetAttribute("FixtureKey", key)
		Kit.action(tap, "tap", "Wash basin", nil, { actionText = "Wash hands", maxDistance = 6 })
		Kit.part(b.m, b.cf, "Spout", V3(0.5, 0.1, 0.12), CF(E - 0.6, b.fy + 3.85, z), C.metalSoft, M.metal, DETAIL)
		local water = Kit.part(b.m, b.cf, "TapWater", V3(0.12, 0.6, 0.12), CF(E - 0.8, b.fy + 3.5, z), C.water, M.glass, WATER)
		water:SetAttribute("FixtureKey", key)
		water:SetAttribute("FxShow", 0.5)
		fx(water, "flow", { FxSeconds = 6 })
		Kit.part(b.m, b.cf, "SoapDispenser", V3(0.35, 0.6, 0.35), CF(E - 0.3, b.fy + 3.45, z + 0.95), C.white, M.smooth, DETAIL)
	end
	for _, z in { 101.5, 121.8 } do
		local dryer = Kit.part(b.m, b.cf, "HandDryer", V3(0.9, 1.5, 1.2), CF(E - 0.45, b.fy + 4.6, z), C.white, M.smooth)
		local nozzle = Kit.part(dryer, b.cf, "DryerNozzle", V3(0.5, 0.15, 0.8), CF(E - 0.7, b.fy + 3.8, z), C.metalSoft, M.metal, DETAIL)
		local air = Kit.steamEmitter(nozzle, "WarmAir", 6, 0.2)
		air.EmissionDirection = Enum.NormalId.Bottom
		fx(dryer, "steam", { FxSeconds = 4 })
		Kit.action(dryer, "prop", "Hand dryer", nil, { actionText = "Dry hands", maxDistance = 6 })
	end
	Kit.cylinder(b.m, b.cf, "TowelBin", "y", 2.0, 1.1, CF(E - 0.8, b.fy + 1.0, 124.2), C.metalSoft, M.metal)
	-- the cleaner wipes the vanity here (Clean activity for the support staff)
	Kit.activity(b.m, b.cf, room.id .. "_Clean", "Clean", "operations", "support", CF(E - 4.2, b.fy + 2.8, 111.5), room.level, b.owner, nil, {
		roomAccess = room.access,
		homeRoom = room.id,
		facing = V3(E, b.fy + 2.8, 111.5),
		attributes = { JobPose = "wipe", JobItem = "sponge" },
	})
	-- urinals with privacy screens on the east wall
	for k = 0, 2 do
		local z = 130 + k * 3.2
		Kit.part(b.m, b.cf, "Urinal", V3(1.3, 2.2, 1.2), CF(E - 0.65, b.fy + 2.6, z), C.white, M.smooth)
		Kit.part(b.m, b.cf, "FlushValve", V3(0.15, 0.8, 0.15), CF(E - 0.12, b.fy + 4.3, z), C.metalSoft, M.metal, DETAIL)
	end
	for k = 0, 3 do
		Kit.part(b.m, b.cf, "UrinalScreen", V3(1.7, 3.2, 0.12), CF(E - 0.85, b.fy + 3.1, 128.4 + k * 3.2), laminate, lamMat)
	end
	Kit.cabinet(b.m, b.cf, at(b, -5.43, 151, "E"), 3, 6.5, s)
	Kit.plant(b.m, b.cf, CF(20.6, b.fy, 156.4), "l", s + 1)
	Kit.plant(b.m, b.cf, CF(-3.4, b.fy, 97.2), "m", s + 2)
end

BUILD.showers = function(b: B)
	local s = b.seed
	local room = b.room
	-- tiled wet wall along the north side (also screens the facade), four stalls in front of it
	Kit.part(b.m, b.cf, "WetWall", V3(32.86, 12.9, 1.5), CF(41, b.fy + 6.45, 157.75), C.white, M.tile)
	for k = 0, 4 do
		Kit.part(b.m, b.cf, "ShowerDivider", V3(0.2, 7.7, 5.6), CF(29 + k * 6, b.fy + 4.15, 154.2), C.glass, M.glass, FROSTED)
	end
	for k = 1, 4 do
		local x1 = 29 + (k - 1) * 6
		local sx = x1 + 3
		local key = room.id .. "_S" .. k
		Kit.part(b.m, b.cf, "ShowerScreen", V3(2.6, 7.7, 0.2), CF(x1 + 1.4, b.fy + 4.15, 151.5), C.glass, M.glass, FROSTED)
		Kit.part(b.m, b.cf, "ShowerTray", V3(5.6, 0.06, 5.4), CF(sx, b.fy + 0.03, 154.2), C.metalSoft, M.slate, DETAIL)
		local head = Kit.cylinder(b.m, b.cf, "ShowerHead", "y", 0.15, 1.3, CF(sx, b.fy + 8.2, 155.9), C.metalSoft, M.metal, { canCollide = false, castShadow = false })
		head:SetAttribute("FixtureKey", key)
		Kit.action(head, "shower", "Shower", nil, { actionText = "Start / stop", maxDistance = 10 })
		Kit.part(b.m, b.cf, "ShowerArm", V3(0.15, 0.15, 1.2), CF(sx, b.fy + 8.35, 156.45), C.metalSoft, M.metal, DETAIL)
		Kit.part(b.m, b.cf, "ShowerValve", V3(0.6, 0.6, 0.2), CF(sx + 1.6, b.fy + 4.2, 156.9), C.metalSoft, M.metal, DETAIL)
		local water = Kit.part(b.m, b.cf, "ShowerWater", V3(1.2, 7.8, 1.2), CF(sx, b.fy + 4.2, 155.9), C.water, M.glass, WATER)
		water:SetAttribute("FixtureKey", key)
		water:SetAttribute("FxShow", 0.5)
		-- stalls 1 and 3 double as wellness-break showers for employees (water runs while occupied)
		local station: string? = nil
		if k == 1 or k == 3 then
			station = wellness(b, "Shower" .. k, V3(sx + 0.6, 0, 154.2), V3(sx, 0, 156.9), nil, { JobPose = "shower" }).Name
		end
		fx(water, "flow", { FxSeconds = 15, FxStation = station })
	end
	-- two locker rows with changing benches (players sit by walking into them)
	Kit.lockers(b.m, b.cf, at(b, 24.57, 111.5, "E"), 10, s, { prompt = "Locker" })
	Kit.lockers(b.m, b.cf, at(b, 57.43, 111.5, "W"), 10, s + 1, { prompt = "Locker" })
	Kit.bench(b.m, b.cf, at(b, 29.9, 111.5, "W"), 12, s + 2)
	Kit.bench(b.m, b.cf, at(b, 52.1, 111.5, "E"), 12, s + 3)
	-- mirror counter with stools on the west wall, towel shelving on the east wall
	Kit.part(b.m, b.cf, "MirrorCounterTop", V3(2.0, 0.25, 12), CF(25.5, b.fy + 3.0, 132), C.stone, M.marble)
	Kit.part(b.m, b.cf, "MirrorCounterBody", V3(1.8, 1.0, 12), CF(25.4, b.fy + 2.4, 132), C.oak, M.wood)
	Kit.part(b.m, b.cf, "CounterMirror", V3(0.08, 4.0, 12), CF(24.54, b.fy + 6.2, 132), C.glass, M.metal)
	Kit.part(b.m, b.cf, "HairDryer", V3(0.5, 0.4, 0.9), CF(25.6, b.fy + 3.32, 128.6), C.white, M.smooth, DETAIL)
	for i, z in { 129, 135 } do
		Kit.stool(b.m, b.cf, CF(28.3, b.fy, z), s + i, 2.2)
	end
	Kit.rackShelf(b.m, b.cf, at(b, 57.43, 141, "W"), 4, s + 4)
	for k = 1, 3 do
		Kit.cylinder(b.m, b.cf, "FoldedTowels", "z", 1.2, 0.5, at(b, 57.43, 141, "W") * CF(-1.2 + k * 0.8 - 0.8, 2.89, -0.8), C.white, M.fabric, DETAIL)
	end
	Kit.plant(b.m, b.cf, CF(26.6, b.fy, 97.2), "m", s + 5)
	Kit.plant(b.m, b.cf, CF(55.4, b.fy, 97.2), "m", s + 6)
end

BUILD.garden_lobby = function(b: B)
	local s = b.seed
	local W = 58.5 -- west wall surface; the path x 65..75 between both garden doors stays free
	local rail = at(b, W, 145, "E")
	Kit.part(b.m, b.cf, "CoatRail", V3(10, 0.5, 0.15), rail * CF(0, 6.2, -0.08), C.oak, M.wood)
	for k = 1, 7 do
		Kit.cylinder(b.m, b.cf, "CoatHook", "z", 0.45, 0.14, rail * CF(-4.5 + (k - 1) * 1.5, 6.0, -0.35), C.brass, M.metal, DETAIL)
	end
	for k, x in { -3, 0, 4.5 } do
		Kit.part(b.m, b.cf, "Coat", V3(1.4, 3.0, 0.45), rail * CF(x, 4.45, -0.45), Kit.pick({ C.fabricCharcoal, C.fabricSand, C.fabricBlue, C.sage }, s + k), M.fabric, DETAIL)
	end
	Kit.bench(b.m, b.cf, at(b, W + 0.9, 145, "E"), 9, s)
	Kit.part(b.m, b.cf, "BootTray", V3(1.4, 0.12, 4), CF(W + 0.8, b.fy + 0.06, 152.2), C.metal, M.rubber, DETAIL)
	Kit.cylinder(b.m, b.cf, "UmbrellaStand", "y", 2.0, 1.1, CF(61.4, b.fy + 1.0, 155.6), C.metal, M.metal)
	for k = 1, 2 do
		Kit.cylinder(b.m, b.cf, "Umbrella", "y", 3.0, 0.25, CF(61.4 + (k - 1.5) * 0.35, b.fy + 2.3, 155.6) * ANG(0, 0, (k - 1.5) * 0.2), Kit.pick({ C.fabricBlue, C.fabricCharcoal, C.sage }, s + k), M.fabric, DETAIL)
	end
	Kit.part(b.m, b.cf, "DoorMat", V3(8, 0.05, 3), CF(70, b.fy + 0.025, 157.3), C.fabricCharcoal, M.fabric, DETAIL)
	-- a small waiting spot, art, garden-side planting
	Kit.loungeChair(b.m, b.cf, at(b, 61.2, 112, "E"), s + 2)
	Kit.loungeChair(b.m, b.cf, at(b, 61.2, 119, "E"), s + 3)
	sideTable(b, 60.4, 115.5, b.fy)
	Kit.artwork(b.m, b.cf, at(b, W, 128, "E"), 5, 3.5, s + 4)
	Kit.plant(b.m, b.cf, CF(78.4, b.fy, 108), "tree", s + 5)
	Kit.plant(b.m, b.cf, CF(78.4, b.fy, 136), "tree", s + 6)
	Kit.plant(b.m, b.cf, CF(78.8, b.fy, 122), "l", s + 7)
	Kit.plant(b.m, b.cf, CF(78.8, b.fy, 150), "l", s + 8)
	Kit.plant(b.m, b.cf, CF(60.4, b.fy, 97.2), "m", s + 9)
end

---------------------------------------------------------------------------------------------
-- Level 1 · founder services
---------------------------------------------------------------------------------------------
local function corridorFounder(b: B)
	local s = b.seed
	local S = 80.5 -- plaster link wall: lined with oak panelling like the panel walls opposite
	local N = 93.44 -- panel wall battens on z = 94
	local P = Kit.PANEL_PITCH
	for _, run in { { -81.5, -49.2 }, { -42.8, 42.8 }, { 49.2, 81.5 } } do
		local x1, x2 = run[1], run[2]
		Kit.part(b.m, b.cf, "OakPanelling", V3(x2 - x1, 12.55, 0.08), CF((x1 + x2) / 2, b.y + 0.45 + 12.55 / 2, S + 0.04), C.oakLight, M.wood)
		for k = math.ceil((x1 + 0.3) / P), math.floor((x2 - 0.3) / P) do
			Kit.part(b.m, b.cf, "Batten", V3(0.2, 12.55, 0.06), CF(k * P, b.y + 0.45 + 12.55 / 2, S + 0.11), C.oakDark, M.wood, DETAIL)
		end
	end
	-- soft wall-light look (no light objects); nothing in front of the flush panel x 29..35
	for _, x in { -74, -58, -34, -18, 18, 34, 58, 74 } do
		sconce(b, at(b, x, S + 0.14, "N"), 7.6)
	end
	for _, x in { -74, -50, -34, -6, 14, 50, 63, 77 } do
		sconce(b, at(b, x, N, "S"), 7.6)
	end
	-- console table under art, flanked by sconces
	local ct = at(b, -26, S + 0.14, "N")
	Kit.part(b.m, b.cf, "ConsoleTop", V3(6, 0.2, 1.4), ct * CF(0, 3.0, -0.75), C.oakDark, M.wood)
	Kit.part(b.m, b.cf, "ConsoleShelf", V3(5.6, 0.12, 1.2), ct * CF(0, 0.9, -0.7), C.oakDark, M.wood)
	for _, x in { -2.8, 2.8 } do
		Kit.part(b.m, b.cf, "ConsoleLeg", V3(0.18, 2.9, 1.2), ct * CF(x, 1.45, -0.7), C.brass, M.metal)
	end
	Kit.cylinder(b.m, b.cf, "Vase", "y", 1.4, 0.6, ct * CF(-1.8, 3.8, -0.75), C.terracotta, M.smooth, DETAIL)
	Kit.part(b.m, b.cf, "Books", V3(1.3, 0.4, 0.9), ct * CF(1.4, 3.3, -0.75), C.leather, M.smooth, DETAIL)
	Kit.part(b.m, b.cf, "BoxFile", V3(1.6, 0.9, 1.0), ct * CF(0, 1.41, -0.7), C.fabricSand, M.smooth, DETAIL)
	for i, x in { -26, -66, 26, 66 } do
		Kit.artwork(b.m, b.cf, at(b, x, S + 0.14, "N"), if x == -26 then 4.5 else 5, 3.2, s + i * 11, { y = if x == -26 then 7.4 else 6.8 })
	end
	Kit.artwork(b.m, b.cf, at(b, -30, N, "S"), 4.5, 3.2, s + 71)
	Kit.artwork(b.m, b.cf, at(b, 70, N, "S"), 4, 3, s + 73)
	for i, p in { V3(-79.8, 0, 91.4), V3(79.8, 0, 91.4), V3(21.4, 0, 81.8), V3(30.6, 0, 81.8) } do
		Kit.plant(b.m, b.cf, CF(p.X, b.fy, p.Z), if i &lt;= 2 then "l" else "m", s + i * 5)
	end
end

BUILD.pavilion_corridor = function(b: B)
	if b.room.level == 0 then
		corridorWellness(b)
	else
		corridorFounder(b)
	end
end

local CHANNELS = { "01 · ENTRY", "02 · RECEPTION", "03 · ATRIUM", "04 · CAFÉ", "05 · GARAGE", "06 · DATA HALL", "07 · WORK FLOORS", "08 · PAVILION", "09 · ROOF TERRACE" }

BUILD.security = function(b: B)
	local s = b.seed
	local E = -42.57 -- panel wall shared with the archive (surface -42.5 + battens)
	-- camera wall: 3 x 3 monitors on a steel frame; each opens the live camera views (founder)
	local wall = at(b, E, 127, "W")
	Kit.part(b.m, b.cf, "VideoWallFrame", V3(16.2, 9.4, 0.3), wall * CF(0, 7.9, -0.15), C.metal, M.metal)
	for r = 0, 2 do
		for c = 0, 2 do
			local idx = r * 3 + c + 1
			local mon = Kit.part(b.m, b.cf, "SecurityMonitor", V3(5.0, 2.8, 0.12), wall * CF((c - 1) * 5.15, 7.9 + (1 - r) * 2.95, -0.36), C.screen, M.smooth, { canCollide = false, castShadow = false })
			local t = label(mon, CHANNELS[idx], C.white, 20, nil, "left")
			t.TextYAlignment = Enum.TextYAlignment.Top
			local live = t:Clone()
			live.Name = "Status"
			live.Text = "● LIVE · camera view"
			live.TextColor3 = C.statusGood
			live.TextSize = 14
			live.TextYAlignment = Enum.TextYAlignment.Bottom
			live.Parent = t.Parent
			Kit.action(mon, "security", "Live campus cameras", nil, { ownerOnly = true, actionText = "View", maxDistance = 12 })
		end
	end
	Kit.tvScreen(b.m, b.cf, at(b, E, 109, "W"), 6.4, "security", b.accent, { y = 6.95, name = "SecurityStatus" })
	local map = Kit.part(b.m, b.cf, "CampusLevels", V3(6.4, 5.2, 0.12), at(b, E, 145.5, "W") * CF(0, 6.95, -0.06), C.metal, M.metal)
	local lines = { "CAMPUS LEVELS" }
	for level = Plan.roofLevel(b.ctx.tier), -1, -1 do
		table.insert(lines, Plan.floorTitle(b.ctx.tier, level))
	end
	Kit.text(map, table.concat(lines, "\n"), { color = C.white, align = "left", valign = "top", size = 13, font = Enum.Font.BuilderSans, light = 0.4 })
	-- curved console desk (three segments facing the operator), control surface, monitors, chair
	local chair = V3(-58, b.fy, 127)
	for k, a in { -40, 0, 40 } do
		local p = chair + V3(math.cos(RAD(a)) * 3.9, 0, math.sin(RAD(a)) * 3.9)
		local seg = Kit.facing(p, chair)
		Kit.part(b.m, b.cf, "ConsoleDesk", V3(3.4, 0.2, 2.2), seg * CF(0, 3.05, 0), C.oakDark, M.wood)
		Kit.part(b.m, b.cf, "ConsoleFascia", V3(3.4, 2.95, 0.15), seg * CF(0, 1.475, 1.0), C.metal, M.metal)
		local mon = Kit.part(b.m, b.cf, "ConsoleMonitor", V3(2.6, 1.5, 0.12), seg * CF(0, 3.9, 0.7), C.screen, M.smooth, DETAIL)
		label(mon, if k == 2 then "LIVE VIEW · ALL CHANNELS" else (if k == 1 then "ACCESS LOG" else "FACILITY STATUS"), if k == 2 then b.accent else C.sageLight, 14)
		if k == 2 then
			local console = Kit.part(b.m, b.cf, "SecurityConsole", V3(2.2, 0.12, 0.9), seg * CF(0, 3.22, -0.3) * ANG(RAD(8), 0, 0), C.metalSoft, M.metal)
			label(console, "CAMERA CONTROL", C.white, 12, Enum.NormalId.Top)
			Kit.action(console, "security", "Camera control · all channels", nil, { ownerOnly = true, actionText = "Open", maxDistance = 8 })
		end
	end
	Kit.officeChair(b.m, b.cf, at(b, chair.X, chair.Z, "E"), s, { arms = true, name = "SecuritySeat" })
	-- key cabinet and lockers on the south wall, briefing table by the glazing, plants
	local key = at(b, -52, 94.5, "N")
	Kit.part(b.m, b.cf, "KeyCabinet", V3(2.4, 3.0, 0.5), key * CF(0, 5.5, -0.25), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "KeyCabinetGlass", V3(2.2, 2.8, 0.05), key * CF(0, 5.5, -0.53), C.glass, M.glass, { detail = true, transparency = A.glassTransparencyDoor })
	for _, y in { 6.1, 5.0 } do
		Kit.part(b.m, b.cf, "KeyTags", V3(1.8, 0.4, 0.05), key * CF(0, y, -0.5), C.brass, M.metal, DETAIL)
	end
	Kit.lockers(b.m, b.cf, at(b, -75.5, 94.57, "N"), 6, s + 1)
	-- camera recorders (network racks) in the corner, supervisor standing desk behind the console
	for i, x in { -46.4, -48.6 } do
		Kit.serverRack(b.m, b.cf, at(b, x, 96.6, "N"), s + 30 + i, b.m, { variant = "network", index = i, name = "RecorderRack" })
	end
	Kit.desk(b.m, b.cf, at(b, -67, 119, "W"), "standing", s + 7)
	for i, z in { 117.6, 120.4 } do
		local mon = Kit.part(b.m, b.cf, "SupervisorMonitor", V3(2.4, 1.4, 0.12), Kit.place(-66.0, b.fy + 4.87, z, "W"), C.screen, M.smooth, DETAIL)
		label(mon, if i == 1 then "PATROL ROUTES" else "VISITOR LOG", C.sageLight, 13)
	end
	Kit.stool(b.m, b.cf, CF(-69.6, b.fy, 119), s + 8, 3.2)
	local centre = V3(-70, b.fy, 150)
	Kit.meetingTable(b.m, b.cf, CF(centre), "round", 4.5, nil, s + 2)
	for i, a in { 90, 210, 330 } do
		Kit.meetingChair(b.m, b.cf, Kit.facing(centre + V3(math.cos(RAD(a)) * 3.4, 0, -math.sin(RAD(a)) * 3.4), centre), s + 3 + i)
	end
	Kit.plant(b.m, b.cf, CF(-80, b.fy, 157.4), "l", s + 4)
	Kit.plant(b.m, b.cf, CF(-44.4, b.fy, 157.4), "m", s + 5)
	Kit.plant(b.m, b.cf, CF(-44.6, b.fy, 96.6), "m", s + 6)
end

local BOOK_SPINES = { C.leather, C.oakDark, C.sage, C.blue, C.terracotta, C.fabricSand, C.fabricCharcoal, C.white, C.brass, C.fabricBlue, C.sageLight }

-- One 7-wide built-in shelving bay against a wall surface at z = zWall (room on -Z): carcass
-- 0.44 deep in front of the wall battens, five rows like the bookcase door (it stands on the slab,
-- level Y), books 0.28 deep in one or two clusters per row.
local function builtInBay(b: B, x: number, zWall: number, seed: number)
	local base = b.y
	local d = 0.44
	local zc = zWall - 0.06 - d / 2
	local zBook = zWall - 0.06 - 0.04 - 0.14
	local wood = C.oakDark
	for _, sx in { -1, 1 } do
		Kit.part(b.m, b.cf, "BayStile", V3(0.15, 8.55, d), CF(x + sx * 3.425, base + 0.03 + 4.275, zc), wood, M.wood)
	end
	Kit.part(b.m, b.cf, "BayTop", V3(6.7, 0.15, d), CF(x, base + 8.505, zc), wood, M.wood)
	Kit.part(b.m, b.cf, "BayPlinth", V3(6.7, 0.4, d), CF(x, base + 0.23, zc), wood, M.wood)
	Kit.part(b.m, b.cf, "BayBack", V3(6.7, 8.15, 0.05), CF(x, base + 4.43, zWall - 0.085), wood, M.wood, DETAIL)
	for r = 1, 5 do
		local y = base + 0.43 + (r - 1) * 1.62
		if r &gt; 1 then
			Kit.part(b.m, b.cf, "BayShelf", V3(6.7, 0.1, d), CF(x, y - 0.05, zc), wood, M.wood)
		end
		local cursor = x - 3.25 + Kit.range(seed, r, 0.05, 0.9)
		local stop = x + 3.25
		local gapAt = math.floor(Kit.range(seed, r + 10, 3, 6))
		for k = 1, 7 do
			local w = Kit.range(seed, r * 20 + k, 0.35, 0.6)
			if k == gapAt then
				cursor += Kit.range(seed, r * 20 + k + 9, 0.6, 1.4)
			end
			if cursor + w &gt; stop - 0.05 then
				break
			end
			local h = Kit.range(seed, r * 40 + k, 0.85, 1.35)
			Kit.part(b.m, b.cf, "Book", V3(w, h, 0.28), CF(cursor + w / 2, y + h / 2, zBook), Kit.pick(BOOK_SPINES, seed + r * 7 + k), M.smooth, DETAIL)
			cursor += w + 0.02
		end
	end
end

local BINDERS = { C.oakDark, C.blue, C.white, C.fabricSand, C.sage, C.fabricCharcoal, C.leather }

-- Double-sided archive stack (centred, long axis local X), binder groups on four levels.
local function archiveStack(b: B, base: CFrame, L: number, seed: number, tag: string)
	local H, D = 7.6, 2.6
	for _, x in { -1, 1 } do
		Kit.part(b.m, b.cf, "StackEnd", V3(0.2, H, D), base * CF(x * (L / 2 - 0.1), H / 2, 0), C.oakDark, M.wood)
	end
	Kit.part(b.m, b.cf, "StackTop", V3(L, 0.15, D), base * CF(0, H - 0.075, 0), C.oakDark, M.wood)
	Kit.part(b.m, b.cf, "StackPlinth", V3(L - 0.4, 0.3, D - 0.2), base * CF(0, 0.15, 0), C.oakDark, M.wood)
	Kit.part(b.m, b.cf, "StackSpine", V3(L - 0.4, H - 0.45, 0.08), base * CF(0, H / 2, 0), C.oak, M.wood)
	for k = 1, 3 do
		Kit.part(b.m, b.cf, "StackShelf", V3(L - 0.4, 0.08, D), base * CF(0, 0.3 + k * 1.8, 0), C.oak, M.wood)
	end
	for k = 0, 3 do
		local y = 0.34 + k * 1.8
		for _, side in { -1, 1 } do
			local x = -L / 2 + 0.3
			local i = 0
			while i &lt; 3 do
				local n = k * 20 + (side + 1) * 5 + i
				local w = Kit.range(seed, n, 2.0, 3.8)
				if x + w &gt; L / 2 - 0.3 then
					break
				end
				local h = Kit.range(seed, n + 100, 1.25, 1.5)
				Kit.part(b.m, b.cf, "Binders", V3(w, h, 1.05), base * CF(x + w / 2, y + h / 2, side * 0.6), Kit.pick(BINDERS, seed + n * 3), M.smooth, DETAIL)
				x += w + Kit.range(seed, n + 200, 0.2, 1.1)
				i += 1
			end
		end
	end
	local plate = Kit.part(b.m, b.cf, "StackLabel", V3(0.05, 0.8, 1.4), base * CF(L / 2 + 0.025, 5.8, 0), C.brass, M.metal, DETAIL)
	label(plate, tag, C.metal, 14, Enum.NormalId.Right)
end

BUILD.archive = function(b: B)
	local s = b.seed
	local ctx = b.ctx
	-- continuous built-in shelving on the north wall left and right of the bookcase door: same
	-- rows, heights and dark oak as the door's shelving unit, shallow so the bookcase reads as one
	-- more bay; kept in front of the measured leaf (closed and slid open)
	local face = 125.5
	local lo = leafBounds(ctx, "P1_ARCHIVE_D2")
	local zWall = if lo and lo.Z &lt; face - 0.05 then lo.Z - 0.03 else face
	for i, x in { -32, -25, -11, -4 } do
		builtInBay(b, x, zWall, s + i * 23)
	end
	Kit.part(b.m, b.cf, "ShelfCornice", V3(35, 0.42, 0.56), CF(-18, b.y + 8.79, zWall - 0.34), C.oakDark, M.wood)
	-- west: three double-sided stacks off the west wall (aisles 4.4)
	for i, z in { 102.5, 109.5, 116.5 } do
		archiveStack(b, at(b, -34.4, z, "S"), 14, s + i * 17, ({ "A – F", "G – O", "P – Z" })[i])
	end
	-- east: reading table, model history screen, plan chests, printer on a sideboard
	Kit.tvScreen(b.m, b.cf, at(b, 5.43, 110, "W"), 8, "history", b.accent, { y = 6.4, name = "ModelHistory" })
	Kit.meetingTable(b.m, b.cf, at(b, -2.6, 110, "E"), "rect", 8, 4, s + 5)
	Kit.meetingChair(b.m, b.cf, at(b, -6.4, 110, "E"), s + 6, { name = "ArchiveSeat" })
	Kit.part(b.m, b.cf, "OpenBinder", V3(1.8, 0.1, 1.4), CF(-3.4, b.fy + 3.2, 109.4) * ANG(0, 0.2, 0), C.white, M.smooth, DETAIL)
	Kit.part(b.m, b.cf, "BinderStack", V3(1.2, 0.6, 1.0), CF(-1.5, b.fy + 3.45, 113), C.oakDark, M.smooth, DETAIL)
	Kit.cylinder(b.m, b.cf, "LampFoot", "y", 0.1, 0.7, CF(-1.6, b.fy + 3.2, 106.6), C.brass, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "LampArm", V3(0.1, 1.6, 0.1), CF(-1.6, b.fy + 4.0, 106.6), C.brass, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "LampHead", V3(0.9, 0.3, 0.5), CF(-2.0, b.fy + 4.85, 106.6), C.brass, M.metal, DETAIL)
	for k, z in { 117.6, 121.8 } do
		local pc = at(b, 5.43, z, "W")
		Kit.part(b.m, b.cf, "PlanChest", V3(4, 3.0, 2.6), pc * CF(0, 1.5, -1.3), C.oak, M.wood)
		for _, y in { 0.8, 1.6, 2.4 } do
			Kit.part(b.m, b.cf, "DrawerLine", V3(3.8, 0.05, 0.05), pc * CF(0, y, -2.62), C.oakDark, M.smooth, DETAIL)
		end
		if k == 1 then
			Kit.part(b.m, b.cf, "Drawings", V3(2.6, 0.06, 1.8), pc * CF(0.2, 3.03, -1.3), C.white, M.smooth, DETAIL)
		end
	end
	local sb = at(b, 0, 94.57, "N")
	Kit.sideboard(b.m, b.cf, sb, 6, s + 7)
	local printer = Kit.part(b.m, b.cf, "ReportPrinter", V3(2.2, 1.0, 1.6), sb * CF(-1.2, 3.33, -0.85), C.metalSoft, M.metal)
	fx(printer, "paper", { FxSeconds = 3 })
	Kit.part(b.m, b.cf, "PrinterTray", V3(1.6, 0.06, 0.7), sb * CF(-1.2, 3.4, -1.85), C.white, M.smooth, DETAIL)
	Kit.action(printer, "report", "Print company report", nil, { ownerOnly = true, actionText = "Print", maxDistance = 8 })
	Kit.plant(b.m, b.cf, CF(3.5, b.fy, 97.8), "m", s + 8)
	Kit.floorLamp(b.m, b.cf, at(b, -7.6, 114.6, "E"), s + 9)
end

BUILD.secret_passage = function(b: B)
	-- narrow service-like passage behind the shelving wall; the bookcase pocket (x -14.5..-7.5,
	-- south side) stays free, so everything sits on the north wall (surface z = 129.5)
	local N = 129.43 -- north wall surface (z = 130) + battens
	Kit.part(b.m, b.cf, "AccentStrip", V3(15, 0.08, 0.06), CF(-14.5, b.y + 0.52, N - 0.03), C.blue, M.neon, DETAIL)
	Kit.cylinder(b.m, b.cf, "CableConduit", "x", 15, 0.35, CF(-14.5, b.fy + 12.0, N - 0.25), C.metalSoft, M.metal, DETAIL)
	for _, x in { -20, -14.5, -9 } do
		Kit.part(b.m, b.cf, "ConduitClip", V3(0.15, 0.5, 0.3), CF(x, b.fy + 12.0, N - 0.15), C.metal, M.metal, DETAIL)
	end
	Kit.part(b.m, b.cf, "JunctionBox", V3(0.9, 0.9, 0.45), CF(-8.2, b.fy + 11.0, N - 0.23), C.metal, M.metal, DETAIL)
	-- framed blueprint (a schematic in white lines on blue)
	local bp = at(b, -11.2, N, "S")
	Kit.part(b.m, b.cf, "BlueprintFrame", V3(4.4, 3.2, 0.1), bp * CF(0, 5.6, -0.05), C.oakDark, M.wood, DETAIL)
	Kit.part(b.m, b.cf, "Blueprint", V3(4.0, 2.8, 0.05), bp * CF(0, 5.6, -0.12), C.blue, M.smooth, DETAIL)
	for _, l in { { 0, 6.6, 3.2, 0.04 }, { 0, 4.6, 3.2, 0.04 }, { -1.6, 5.6, 0.04, 2.0 }, { 1.6, 5.6, 0.04, 2.0 }, { -0.4, 5.6, 0.04, 2.0 }, { 0.6, 5.2, 2.0, 0.04 } } do
		Kit.part(b.m, b.cf, "BlueprintLine", V3(math.max(l[3], 0.06), math.max(l[4], 0.06), 0.05), bp * CF(l[1], l[2], -0.15), C.white, M.smooth, DETAIL)
	end
	Kit.cylinder(b.m, b.cf, "BlueprintRing", "z", 0.05, 0.9, bp * CF(1.0, 6.0, -0.15), C.blueSoft, M.smooth, DETAIL)
	-- lit way-back plate on the west wall beside the bookcase (its inner prompt is the exit)
	local plate = at(b, -21.93, 127.9, "E")
	Kit.part(b.m, b.cf, "ExitPlate", V3(0.6, 0.9, 0.06), plate * CF(0, 4.0, -0.03), C.metalSoft, M.metal, DETAIL)
	Kit.cylinder(b.m, b.cf, "ExitRing", "z", 0.05, 0.36, plate * CF(0, 4.1, -0.08), C.statusGood, M.neon, DETAIL)
end

BUILD.secret_lab = function(b: B)
	local s = b.seed
	local room = b.room
	local W = -41.43 -- west panel wall surface + battens
	-- research wall: confidential roadmap board + live research wall screen (owner prompt)
	Kit.whiteboard(b.m, b.cf, at(b, W, 139.5, "E"), 10, "NEXT-GEN MODEL · INTERNAL\n• eval gates: reasoning · safety · cost\n• checkpoint 7 → red-team review\n• compute plan for the next training run\n• partner preview only after sign-off", s, { y = 6.3, name = "ResearchBoard" })
	local wallScreen = Kit.tvScreen(b.m, b.cf, at(b, W, 151, "E"), 9, "secretlab", b.accent, { y = 6.8, name = "ResearchWall" })
	Kit.prompt(wallScreen, "Research wall", b.owner, "empire", "research")
	-- two private research workstations facing the wall
	for i, z in { 141, 151 } do
		Kit.station(b.m, b.cf, room.id .. "_Desk" .. i, "research", "researcher", at(b, -30, z, "E"), room.level, "lab", b.owner, b.accent, "empire", "research", room.access, room.id)
	end
	-- dashboard monitors by the entrance wall
	for i, x in { -36, -30 } do
		Kit.tvScreen(b.m, b.cf, at(b, x, 130.57, "N"), 4.5, if i == 1 then "research" else "evaluation", b.accent, { y = 6.2, name = "LabMonitor" })
	end
	-- strategy table
	local centre = V3(-17, b.fy, 150)
	Kit.rug(b.m, b.cf, CF(centre), 9, 9, s + 1)
	Kit.meetingTable(b.m, b.cf, CF(centre), "round", 4.6, nil, s + 2)
	for i, a in { 0, 120, 240 } do
		Kit.meetingChair(b.m, b.cf, Kit.facing(centre + V3(math.cos(RAD(a + 30)) * 3.4, 0, math.sin(RAD(a + 30)) * 3.4), centre), s + 3 + i)
	end
	-- model checkpoints in a glass case: drives on two shelves, label on the plinth
	Kit.part(b.m, b.cf, "CasePlinth", V3(4.2, 3.0, 2.6), CF(-3, b.fy + 1.5, 146), C.stone, M.stone)
	Kit.part(b.m, b.cf, "CaseGlass", V3(4.0, 2.4, 2.4), CF(-3, b.fy + 4.2, 146), C.glass, M.glass, GLASS)
	Kit.part(b.m, b.cf, "CaseGlow", V3(4.0, 0.06, 0.08), CF(-3, b.fy + 3.03, 144.75), C.blueSoft, M.neon, DETAIL)
	for k, y in { 3.0, 4.15 } do
		Kit.part(b.m, b.cf, "CaseShelf", V3(3.4, 0.08, 1.8), CF(-3, b.fy + y + 0.04, 146), C.metal, M.metal, DETAIL)
		for j = 1, 3 do
			Kit.part(b.m, b.cf, "CheckpointDrive", V3(0.7, 0.28, 1.0), CF(-4.1 + (j - 1) * 1.1, b.fy + y + 0.22, 146 + (k - 1.5) * 0.3), C.metalSoft, M.metal, DETAIL)
		end
	end
	local plate = Kit.part(b.m, b.cf, "CaseLabel", V3(2.8, 0.5, 0.05), CF(-3, b.fy + 2.4, 144.68), C.brass, M.metal, DETAIL)
	label(plate, "MODEL CHECKPOINTS · INTERNAL", C.metal, 12)
	-- locked cabinets on the east wall (keypads)
	for i, z in { 135.5, 138.5, 141.5 } do
		local cab = at(b, 5.43, z, "W")
		Kit.cabinet(b.m, b.cf, cab, 3, 6.5, s + 10 + i)
		Kit.part(b.m, b.cf, "Keypad", V3(0.3, 0.45, 0.05), cab * CF(-0.9, 4.6, -1.63), C.metal, M.metal, DETAIL)
		Kit.part(b.m, b.cf, "KeypadLed", V3(0.14, 0.06, 0.05), cab * CF(-0.9, 4.78, -1.67), C.statusBad, M.neon, DETAIL)
	end
	-- private report terminal (kiosk) and the founder's lab computer on a sideboard
	local kiosk = at(b, 2.2, 132.3, "N")
	Kit.part(b.m, b.cf, "TerminalPedestal", V3(1.2, 3.4, 1.0), kiosk * CF(0, 1.7, 0), C.metal, M.metal)
	local terminal = Kit.part(b.m, b.cf, "ReportTerminal", V3(2.2, 1.4, 0.3), kiosk * CF(0, 4.1, -0.3) * ANG(RAD(15), 0, 0), C.screen, M.smooth)
	label(terminal, "PRIVATE REPORTS", b.accent, 16)
	Kit.action(terminal, "report", "Print private report", nil, { ownerOnly = true, actionText = "Print", maxDistance = 8 })
	local sb = at(b, 5.43, 155.5, "W")
	Kit.sideboard(b.m, b.cf, sb, 5, s + 20)
	local pc = Kit.part(b.m, b.cf, "LabComputer", V3(2.8, 1.7, 0.15), sb * CF(0, 4.05, -0.7), C.screen, M.smooth)
	label(pc, "LAB · PRIVATE", b.accent, 16)
	Kit.part(b.m, b.cf, "MonitorStand", V3(0.3, 0.6, 0.45), sb * CF(0, 3.12, -0.6), C.metal, M.metal, DETAIL)
	Kit.action(pc, "ownerComputer", "Private lab computer", "lab", { ownerOnly = true, actionText = "Open", maxDistance = 8 })
	-- calm, tasteful way-back cue beside the passage opening (the bookcase prompt is the exit)
	local cue = at(b, -13.3, 130.57, "N")
	local cuePlate = Kit.part(b.m, b.cf, "ArchivePlate", V3(0.9, 1.3, 0.06), cue * CF(0, 4.2, -0.03), C.metalSoft, M.metal, DETAIL)
	Kit.cylinder(b.m, b.cf, "ArchiveRing", "z", 0.05, 0.5, cue * CF(0, 4.45, -0.08), C.statusGood, M.neon, DETAIL)
	Kit.text(cuePlate, "ARCHIVE", { color = C.white, size = 12, valign = "bottom", light = 0.5, maxDistance = 30 })
	Kit.plant(b.m, b.cf, CF(-1, b.fy, 157.6), "m", s + 21)
end

-- Small articulated robot arm standing on `base` (top surface), scaled by k: an Atomic PropFx "arm"
-- model (PROPFX_CONTRACT §3): parts carry FxLink (1 turret, 2 upper arm, 3 forearm + gripper) and the
-- model FxJoint1..3 (home joint frames in pivot space; joint 1 turns about local Y, 2 and 3 about local Z).
local function robotArm(b: B, base: CFrame, k: number, propId: string): Model
	local m = Kit.propModel(b.m, b.cf, "RobotArm", base)
	local function link(p: BasePart, n: number)
		p:SetAttribute("FxLink", n)
	end
	Kit.cylinder(m, b.cf, "ArmBase", "y", 0.4 * k, 1.4 * k, base * CF(0, 0.2 * k, 0), C.metal, M.metal, DETAIL)
	link(Kit.cylinder(m, b.cf, "ArmTurret", "y", 0.9 * k, 0.9 * k, base * CF(0, 0.85 * k, 0), C.white, M.smooth, DETAIL), 1)
	local shoulderLocal = CF(0, 1.3 * k, 0) * ANG(0, 0, RAD(-35))
	local shoulder = base * shoulderLocal
	link(Kit.part(m, b.cf, "ArmUpper", V3(0.45, 2.4, 0.45) * k, shoulder * CF(0, 1.2 * k, 0), C.white, M.smooth, DETAIL), 2)
	local elbowLocal = shoulderLocal * CF(0, 2.4 * k, 0) * ANG(0, 0, RAD(100))
	local elbow = base * elbowLocal
	link(Kit.ball(m, b.cf, "ArmJoint", 0.6 * k, elbow, C.metal, M.metal, DETAIL), 2)
	link(Kit.part(m, b.cf, "ArmFore", V3(0.35, 2.0, 0.35) * k, elbow * CF(0, 1.0 * k, 0), C.white, M.smooth, DETAIL), 3)
	local wrist = elbow * CF(0, 2.0 * k, 0)
	link(Kit.cylinder(m, b.cf, "ArmWrist", "y", 0.35 * k, 0.45 * k, wrist, C.metal, M.metal, DETAIL), 3)
	for _, x in { -0.16, 0.16 } do
		link(Kit.part(m, b.cf, "ArmFinger", V3(0.08, 0.5, 0.2) * k, wrist * CF(x * k, 0.4 * k, 0), C.metal, M.metal, DETAIL), 3)
	end
	fx(m, "arm", { FxJoint1 = CFrame.identity, FxJoint2 = shoulderLocal, FxJoint3 = elbowLocal, FxSeconds = 12, PropId = propId })
	return m
end

-- Island lab bench (centred, long axis local X), slate top at 3.2.
local function labIsland(b: B, base: CFrame, L: number)
	Kit.part(b.m, b.cf, "IslandTop", V3(L, 0.25, 3.6), base * CF(0, 3.075, 0), C.metalSoft, M.slate)
	for _, x in { -1, 1 } do
		Kit.part(b.m, b.cf, "IslandCabinet", V3(2.4, 2.95, 3.2), base * CF(x * (L / 2 - 1.3), 1.475, 0), C.white, M.smooth)
	end
end

BUILD.prototype = function(b: B)
	local s = b.seed
	local room = b.room
	local W = 6.57 -- west panel wall surface + battens
	-- project wall: large prototype screen over the special project workstation, roadmap board
	Kit.tvScreen(b.m, b.cf, at(b, W, 124, "E"), 12, "prototype", b.accent, { y = 8.0, name = "PrototypeScreen" })
	Kit.station(b.m, b.cf, room.id .. "_Desk1", "research", "researcher", at(b, 13, 124, "E"), room.level, "lab", b.owner, b.accent, "lab", nil, room.access, room.id)
	Kit.whiteboard(b.m, b.cf, at(b, W, 144, "E"), 9, "PROJECT ROADMAP\nQ1  prototype v0 · bench validation\nQ2  robotics + model integration\nQ3  safety review · partner pilots\nQ4  launch decision", s, { name = "RoadmapBoard" })
	-- south wall benches: GPU boards + scope, test rig + instrument (flush door x 29..35 stays free)
	local wb1 = at(b, 15, 94.57, "N")
	Kit.workbench(b.m, b.cf, wb1, 12, s + 1)
	local desk = room.id .. "_Desk1"
	for k = 1, 3 do
		local x = -3.5 + (k - 1) * 3.5
		Kit.part(b.m, b.cf, "GpuBoard", V3(2.2, 0.08, 1.2), wb1 * CF(x, 3.24, -1.5), C.sage, M.smooth, DETAIL)
		Kit.part(b.m, b.cf, "Heatsink", V3(1.5, 0.45, 1.0), wb1 * CF(x, 3.5, -1.5), C.metalSoft, M.metal, DETAIL)
		-- board fans idle slowly and spin up while the project desk is staffed
		local boardFan = Kit.cylinder(b.m, b.cf, "BoardFan", "y", 0.08, 0.8, wb1 * CF(x, 3.77, -1.5), C.metal, M.metal, DETAIL)
		fx(boardFan, "spin", { FxAxis = "x", FxRate = 14, FxIdle = "slow", FxStation = desk })
	end
	Kit.part(b.m, b.cf, "Scope", V3(1.6, 1.1, 1.2), wb1 * CF(4.6, 3.75, -1.2), C.white, M.smooth, DETAIL)
	Kit.part(b.m, b.cf, "ScopeScreen", V3(1.0, 0.6, 0.05), wb1 * CF(4.4, 3.8, -1.82), C.screen, M.smooth, DETAIL)
	local wb2 = at(b, 47, 94.57, "N")
	Kit.workbench(b.m, b.cf, wb2, 10, s + 2)
	for _, p in { { -1.5, -0.9 }, { 1.5, -0.9 }, { -1.5, -2.3 }, { 1.5, -2.3 } } do
		Kit.part(b.m, b.cf, "RigPost", V3(0.12, 2.2, 0.12), wb2 * CF(p[1], 4.3, p[2]), C.metalSoft, M.metal, DETAIL)
	end
	for _, z in { -0.9, -2.3 } do
		Kit.part(b.m, b.cf, "RigRail", V3(3.1, 0.12, 0.12), wb2 * CF(0, 5.4, z), C.metalSoft, M.metal, DETAIL)
	end
	Kit.part(b.m, b.cf, "DeviceUnderTest", V3(1.4, 0.8, 1.0), wb2 * CF(0, 3.6, -1.6), C.white, M.smooth, DETAIL)
	local probe = Kit.part(b.m, b.cf, "RigProbe", V3(0.1, 1.2, 0.1), wb2 * CF(0.3, 4.6, -1.6), C.metal, M.metal, DETAIL)
	-- the probe taps the device under test (oscillating slider) while the test rig runs
	fx(probe, "slider", { FxAxis = "y", FxTravel = -0.35, FxRate = 1.4, FxSeconds = 10, PropId = "TestRig" })
	Kit.action(probe, "prop", "Test rig · run test", "TestRig", { ownerOnly = true, actionText = "Run", maxDistance = 8 })
	Kit.cylinder(b.m, b.cf, "RigCable", "x", 2.2, 0.15, wb2 * CF(1.8, 3.3, -0.5), C.fabricCharcoal, M.rubber, DETAIL)
	Kit.part(b.m, b.cf, "Instrument", V3(1.6, 1.1, 1.2), wb2 * CF(3.4, 3.75, -1.2), C.white, M.smooth, DETAIL)
	Kit.part(b.m, b.cf, "InstrumentScreen", V3(1.0, 0.6, 0.05), wb2 * CF(3.2, 3.8, -1.82), C.screen, M.smooth, DETAIL)
	-- island A: small robot arm + controller; island B: open GPU test chassis + device prototype
	labIsland(b, at(b, 32, 128, "S"), 12)
	labIsland(b, at(b, 32, 142, "S"), 12)
	robotArm(b, CF(29, b.fy + 3.2, 128), 1, "RobotArm1")
	local controller = Kit.part(b.m, b.cf, "ArmController", V3(1.6, 1.0, 1.2), CF(34.5, b.fy + 3.7, 128), C.metal, M.metal, DETAIL)
	Kit.action(controller, "prop", "Robot arm · run program", "RobotArm1", { ownerOnly = true, actionText = "Run", maxDistance = 8 })
	Kit.cylinder(b.m, b.cf, "EStop", "y", 0.2, 0.45, CF(34.5, b.fy + 4.3, 127.7), C.statusBad, M.smooth, DETAIL)
	Kit.part(b.m, b.cf, "TestChassis", V3(3.0, 0.7, 2.2), CF(29, b.fy + 3.55, 142), C.metal, M.metal, DETAIL)
	for k = 1, 4 do
		Kit.part(b.m, b.cf, "GpuCard", V3(0.2, 1.0, 1.8), CF(28.0 + (k - 1) * 0.65, b.fy + 4.4, 142), C.sage, M.smooth, DETAIL)
	end
	Kit.part(b.m, b.cf, "LaptopBase", V3(2.2, 0.1, 1.5), CF(33, b.fy + 3.25, 141.6), C.metalSoft, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "LaptopLid", V3(2.2, 1.4, 0.08), CF(33, b.fy + 3.95, 142.35) * ANG(RAD(10), 0, 0), C.metalSoft, M.metal, DETAIL)
	Kit.cylinder(b.m, b.cf, "PrototypeDevice", "y", 0.3, 1.2, CF(36, b.fy + 3.35, 142), C.white, M.smooth, DETAIL)
	for i, p in { { 28.5, 124.6 }, { 35.5, 124.6 }, { 28.5, 138.6 }, { 35.5, 138.6 } } do
		Kit.stool(b.m, b.cf, CF(p[1], b.fy, p[2]), s + 3 + i, 3.0)
	end
	-- robot test cell: mesh enclosure (open towards the lab), arm on a pedestal, part fixture table
	local mesh: Kit.Opts = { transparency = 0.55, castShadow = false }
	Kit.part(b.m, b.cf, "CellMesh", V3(10, 6, 0.1), CF(47, b.fy + 3.2, 112), C.metalSoft, M.metal, mesh)
	Kit.part(b.m, b.cf, "CellMesh", V3(10, 6, 0.1), CF(47, b.fy + 3.2, 102), C.metalSoft, M.metal, mesh)
	Kit.part(b.m, b.cf, "CellMesh", V3(0.1, 6, 10), CF(52, b.fy + 3.2, 107), C.metalSoft, M.metal, mesh)
	Kit.part(b.m, b.cf, "CellMesh", V3(0.1, 6, 3.2), CF(42, b.fy + 3.2, 103.6), C.metalSoft, M.metal, mesh)
	Kit.part(b.m, b.cf, "CellMesh", V3(0.1, 6, 3.2), CF(42, b.fy + 3.2, 110.4), C.metalSoft, M.metal, mesh)
	for _, p in { V3(42, 0, 102), V3(52, 0, 102), V3(42, 0, 112), V3(52, 0, 112), V3(42, 0, 105.2), V3(42, 0, 108.8) } do
		Kit.part(b.m, b.cf, "CellPost", V3(0.3, 6.4, 0.3), CF(p.X, b.fy + 3.2, p.Z), C.statusBusy, M.metal)
	end
	Kit.part(b.m, b.cf, "ArmPedestal", V3(1.6, 2.4, 1.6), CF(48.5, b.fy + 1.2, 106), C.metal, M.metal)
	robotArm(b, CF(48.5, b.fy + 2.4, 106), 1.5, "RobotArm2")
	local fixture = Kit.part(b.m, b.cf, "FixtureTable", V3(5, 0.25, 2), CF(47.5, b.fy + 3.0, 110.4), C.metalSoft, M.slate)
	Kit.action(fixture, "prop", "Robot test cell · start cycle", "RobotArm2", { ownerOnly = true, actionText = "Start", maxDistance = 9 })
	Kit.part(b.m, b.cf, "FixtureTableBase", V3(4.4, 2.85, 1.6), CF(47.5, b.fy + 1.45, 110.4), C.metal, M.metal)
	local cellSign = Kit.part(b.m, b.cf, "CellSign", V3(0.06, 0.8, 2.4), CF(41.92, b.fy + 6.0, 103.6), C.statusBusy, M.smooth, DETAIL)
	label(cellSign, "ROBOT TEST CELL", C.metal, 14, Enum.NormalId.Left)
	-- storage shelving on the east wall north of the vault door
	Kit.rackShelf(b.m, b.cf, at(b, 57.43, 139, "W"), 4, s + 8)
	Kit.rackShelf(b.m, b.cf, at(b, 57.43, 144, "W"), 4, s + 9)
	-- sofa corner by the north glazing
	Kit.rug(b.m, b.cf, CF(48, b.fy, 152.6), 13, 10, s + 10)
	Kit.sofa(b.m, b.cf, at(b, 48, 156.8, "S"), 8, s + 11)
	Kit.coffeeTable(b.m, b.cf, at(b, 48, 151.8, "S"), s + 12, 4, 2.4)
	Kit.loungeChair(b.m, b.cf, Kit.facing(V3(42.2, b.fy, 151.4), V3(48, b.fy, 152)), s + 13)
	Kit.loungeChair(b.m, b.cf, Kit.facing(V3(53.8, b.fy, 151.4), V3(48, b.fy, 152)), s + 14)
	Kit.floorLamp(b.m, b.cf, at(b, 42.6, 157.4, "S"), s + 15)
	Kit.plant(b.m, b.cf, CF(55.2, b.fy, 156.8), "l", s + 16)
	Kit.plant(b.m, b.cf, CF(9.4, b.fy, 156.8), "l", s + 17)
	Kit.plant(b.m, b.cf, CF(55.4, b.fy, 97.6), "m", s + 18)
end

-- Double-sided archive drive rack (centred, long axis local X): cartridge groups + status strip.
local function driveRack(b: B, base: CFrame, L: number, seed: number)
	local H, D = 7.4, 2.4
	for _, x in { -1, 1 } do
		Kit.part(b.m, b.cf, "RackEnd", V3(0.25, H, D), base * CF(x * (L / 2 - 0.125), H / 2, 0), C.metal, M.metal)
	end
	Kit.part(b.m, b.cf, "RackTop", V3(L, 0.15, D), base * CF(0, H - 0.075, 0), C.metal, M.metal)
	Kit.part(b.m, b.cf, "RackSpine", V3(L - 0.5, H - 0.3, 0.08), base * CF(0, H / 2, 0), C.metalSoft, M.metal)
	for k = 0, 3 do
		local y = 0.3 + k * 1.75
		Kit.part(b.m, b.cf, "RackShelf", V3(L - 0.5, 0.08, D), base * CF(0, y, 0), C.metalSoft, M.metal)
		for _, side in { -1, 1 } do
			local n = k * 4 + (side + 1)
			local w1 = Kit.range(seed, n, L * 0.3, L * 0.45)
			local w2 = Kit.range(seed, n + 50, L * 0.25, L * 0.4)
			Kit.part(b.m, b.cf, "DriveCartridges", V3(w1, 1.2, 0.95), base * CF(-L / 2 + 0.4 + w1 / 2, y + 0.64, side * 0.6), C.screen, M.smooth, DETAIL)
			Kit.part(b.m, b.cf, "DriveCartridges", V3(w2, 1.2, 0.95), base * CF(L / 2 - 0.4 - w2 / 2, y + 0.64, side * 0.6), C.metal, M.smooth, DETAIL)
		end
	end
	for _, side in { -1, 1 } do
		Kit.part(b.m, b.cf, "RackStatus", V3(L - 0.8, 0.06, 0.05), base * CF(0, H - 0.1, side * (D / 2 + 0.025)), C.blueSoft, M.neon, DETAIL)
	end
end

BUILD.vault = function(b: B)
	local s = b.seed
	local Hh = 12.9
	-- steel liner on all four walls (vault door opening z 124..130 on the west wall stays open)
	local y = b.fy + Hh / 2
	Kit.part(b.m, b.cf, "VaultLiner", V3(0.3, Hh, 124 - 94.58), CF(58.73, y, (124 + 94.58) / 2), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "VaultLiner", V3(0.3, Hh, 158.6 - 130), CF(58.73, y, (158.6 + 130) / 2), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "VaultLiner", V3(80.6 - 58.88, Hh, 0.3), CF((80.6 + 58.88) / 2, y, 94.73), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "VaultLiner", V3(0.3, Hh, 158.9 - 94.58), CF(80.75, y, (158.9 + 94.58) / 2), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "VaultLiner", V3(80.6 - 58.88, Hh, 0.3), CF((80.6 + 58.88) / 2, y, 158.75), C.metalSoft, M.metal)
	for _, by in { 4.5, 9.0 } do
		Kit.part(b.m, b.cf, "LinerBand", V3(0.08, 0.3, 158.6 - 94.88), CF(80.56, b.fy + by, (158.6 + 94.88) / 2), C.metal, M.metal, DETAIL)
		Kit.part(b.m, b.cf, "LinerBand", V3(80.6 - 58.88, 0.3, 0.08), CF((80.6 + 58.88) / 2, b.fy + by, 158.56), C.metal, M.metal, DETAIL)
		Kit.part(b.m, b.cf, "LinerBand", V3(80.6 - 58.88, 0.3, 0.08), CF((80.6 + 58.88) / 2, b.fy + by, 94.92), C.metal, M.metal, DETAIL)
	end
	-- the model safe on the door axis
	local sf = at(b, 80.6, 127, "W")
	local safe = Kit.part(b.m, b.cf, "ModelSafe", V3(6, 8, 3), sf * CF(0, 4.25, -1.5), C.metalSoft, M.metal)
	Kit.part(b.m, b.cf, "SafePlinth", V3(6.2, 0.25, 3.2), sf * CF(0, 0.125, -1.5), C.metal, M.metal)
	Kit.part(b.m, b.cf, "SafeFront", V3(5.2, 7.0, 0.08), sf * CF(0, 4.3, -3.04), C.metal, M.metal, DETAIL)
	Kit.cylinder(b.m, b.cf, "SafeWheel", "z", 0.3, 0.7, sf * CF(1.2, 4.3, -3.22), C.stoneDeep, M.metal, DETAIL)
	for k = 0, 2 do
		Kit.part(b.m, b.cf, "SafeSpoke", V3(2.0, 0.14, 0.14), sf * CF(1.2, 4.3, -3.3) * ANG(0, 0, k * PI / 3), C.stoneDeep, M.metal, DETAIL)
	end
	Kit.part(b.m, b.cf, "SafeKeypad", V3(0.6, 0.9, 0.08), sf * CF(-1.8, 4.9, -3.12), C.metal, M.metal, DETAIL)
	Kit.part(b.m, b.cf, "SafeKeypadLed", V3(0.3, 0.08, 0.05), sf * CF(-1.8, 5.25, -3.17), C.statusBusy, M.neon, DETAIL)
	local plate = Kit.part(b.m, b.cf, "SafeLabel", V3(2.4, 0.5, 0.05), sf * CF(0, 7.35, -3.1), C.brass, M.metal, DETAIL)
	label(plate, "MODEL VAULT", C.metal, 16)
	Kit.action(safe, "modelSafe", "Open model vault", nil, { ownerOnly = true, actionText = "Open", maxDistance = 8 })
	Kit.tvScreen(b.m, b.cf, at(b, 80.6, 116.5, "W"), 6, "vault", b.accent, { y = 6.4, name = "VaultScreen" })
	-- archive drive racks north and south of the axis, a small bench facing it
	for i, z in { 101, 108, 115, 139, 146, 153 } do
		driveRack(b, at(b, 70.5, z, "S"), 11, s + i * 13)
	end
	Kit.bench(b.m, b.cf, at(b, 70.5, 134.4, "S"), 5, s + 2)
end

