</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000015"><Properties><string name="Name">AdminService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The Roblox server supplies Player.Name; a display name or a remote payload grants no rights.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local DataConfig=require(ReplicatedStorage.Shared.Config.DataConfig)
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Facility=require(script.Parent.FacilityService)
local AI=require(script.Parent.AIModelService)
local Admin={}
local ACCOUNT="nonortrttrt"
function Admin.allowed(player: Player): boolean
	return string.lower(player.Name)==ACCOUNT
end
local function campus(s: any)
	s.data.empire.office=#EmpireConfig.OFFICES
	s.data.empire.campus.retailLevel=#CampusConfig.RETAIL+1
	Facility.issueCard(s.player,s.userId)
end
local function staff(s: any)
	campus(s)
	local e=s.data.empire;local total=0
	for _,r in EmpireConfig.ROLES do total+=e.employees[r.id] or 0 end
	while total&lt;EmpireConfig.OFFICES[e.office].staff do
		local lowest=EmpireConfig.ROLES[1]
		for _,r in EmpireConfig.ROLES do if (e.employees[r.id] or 0)&lt;(e.employees[lowest.id] or 0) then lowest=r end end
		e.employees[lowest.id]=(e.employees[lowest.id] or 0)+1;total+=1
	end
end
local function research(s: any)
	for _,r in EmpireConfig.RESEARCH do s.data.empire.research[r.id]=true end
	s.data.empire.researchJob=nil
	s.data.empire.points=math.max(s.data.empire.points,10000)
	s.data.empire.infrastructure.cooling=8
end
local function hardware(s: any)
	campus(s);s.data.empire.infrastructure.cooling=8
	local used=0;for _,g in HardwareConfig.GPUS do if not g.starter then used+=s.data.gpus[g.id] or 0 end end
	local count=s.data.gpus.superpod or 0
	s.data.gpus.superpod=count+math.min(math.max(0,2-count),math.max(0,HardwareConfig.slots(s.data.empire)-used))
end
local function fleet(s: any)
	for _,car in CampusConfig.CARS do s.data.empire.campus.cars[car.id]=true end
end
local function data(s: any)
	for _,d in DataConfig.TYPES do ModelMath.addTokens(s.data.data,d.id,1e10,.9) end
end
-- Read-only diagnostics -------------------------------------------------------------------
-- Optional services are required lazily so a missing or failing module only removes its section.
local function inspect(name: string,office: Model): (any,string?)
	local ok,result=pcall(function(): any
		local m=script.Parent:FindFirstChild(name)
		if not m or not m:IsA("ModuleScript") then return nil end
		local svc=(require :: any)(m)
		return if typeof(svc)=="table" and typeof(svc.inspect)=="function" then svc.inspect(office) else nil
	end)
	if not ok then return nil,tostring(result) end
	return result,nil
end
local function count(t: any): number
	if typeof(t)=="number" then return t end
	if typeof(t)~="table" then return 0 end
	local n=0;for _ in t do n+=1 end;return n
end
local function list(t: any): string
	if typeof(t)~="table" or next(t)==nil then return "—" end
	local out={};for _,v in t do table.insert(out,tostring(v)) end;return table.concat(out,",")
end
local function roomReport(office: Model,tier: number,lines: {string})
	local perLevel,planned={},{}
	for _,r in Plan.rooms(tier) do perLevel[r.level]=(perLevel[r.level] or 0)+1;planned[r.id]=true end
	local parts={}
	for _,level in Plan.levels(tier) do table.insert(parts,Plan.levelLabel(tier,level).." "..(perLevel[level] or 0)) end
	table.insert(lines,"Rooms (Plan): "..table.concat(parts," · "))
	local folder=office:FindFirstChild("Rooms");local built,missing=0,{}
	if folder then for _,m in folder:GetChildren() do if planned[m.Name] then built+=1 end end end
	for _,r in Plan.rooms(tier) do if not folder or not folder:FindFirstChild(r.id) then table.insert(missing,r.id) end end
	table.insert(lines,string.format("Rooms built: %d / %d%s",built,count(planned),if #missing&gt;0 then " · missing "..table.concat(missing,",",1,math.min(#missing,10))..(if #missing&gt;10 then ",…" else "") else ""))
end
local function workstationReport(office: Model,lines: {string})
	local w,err=inspect("WorkstationService",office)
	if typeof(w)~="table" then table.insert(lines,"Workstations: unavailable"..(if err then " ("..err..")" else ""));return end
	table.insert(lines,string.format("Workstations: %s total · %s reserved · %s occupied · %s seated players",tostring(w.total or "?"),tostring(w.reserved or "?"),tostring(w.occupied or "?"),tostring(w.playerSeated or 0)))
	if typeof(w.byType)=="table" then
		local parts={}
		for kind,t in w.byType do if typeof(t)=="table" then table.insert(parts,string.format("%s %d/%d/%d",tostring(kind),t.total or 0,t.reserved or 0,t.occupied or 0)) end end
		table.sort(parts);if #parts&gt;0 then table.insert(lines,"  by type (total/reserved/occupied): "..table.concat(parts," · ")) end
	end
end
-- StaffService.inspect rows: {name, index, role, state, task, station, home, lod, navIssue, navStage,
-- liftTicketState}.
local function staffReport(office: Model,lines: {string})
	local report,err=inspect("StaffService",office)
	if typeof(report)~="table" then table.insert(lines,"Employees: unavailable"..(if err then " ("..err..")" else ""));return end
	local total,issues,tickets,sleeping=0,0,0,0
	local detail={}
	for _,r in report do
		if typeof(r)~="table" then continue end
		total+=1
		if r.lod=="sleep" then sleeping+=1 end
		local issue=r.navIssue;local ticket=r.liftTicketState
		if issue~=nil and issue~="" and issue~=false then issues+=1 else issue=nil end
		if ticket~=nil then tickets+=1 end
		if (issue or ticket) and #detail&lt;12 then
			table.insert(detail,string.format("  #%s %s (%s) %s%s%s%s",tostring(r.index or "?"),tostring(r.name or "?"),tostring(r.role or "?"),tostring(r.state or ""),
				if r.navStage then " · "..tostring(r.navStage) else "",if issue then " · nav: "..tostring(issue) else "",if ticket then " · lift "..tostring(ticket) else ""))
		end
	end
	table.insert(lines,string.format("Employees: %d simulated (%d asleep, far from players) · %d nav issues · %d lift tickets",total,sleeping,issues,tickets))
	for _,line in detail do table.insert(lines,line) end
end
local function liftReport(office: Model,tier: number,lines: {string})
	local r,err=inspect("LiftService",office)
	if typeof(r)~="table" then table.insert(lines,"Lift: unavailable"..(if err then " ("..err..")" else ""));return end
	if r.attached==false then table.insert(lines,if r.none then "Lift: none in this building (garage stage)" else "Lift: not attached"..(if r.failed then " (attach failed)" else ""));return end
	local q=if typeof(r.queue)=="table" then r.queue else {}
	local states={};if typeof(r.ticketStates)=="table" then for k,v in r.ticketStates do table.insert(states,tostring(k).." "..tostring(v)) end;table.sort(states) end
	table.insert(lines,string.format("Lift: %s at %s%s · door %s · riders %s/%s%s · hall %s · car %s · tickets %s%s%s",
		tostring(r.state or "?"),if typeof(r.level)=="number" then Plan.levelLabel(tier,r.level) else "?",if typeof(r.target)=="number" then " → "..Plan.levelLabel(tier,r.target) else "",
		tostring(r.door or "?"),tostring(r.riders or 0),tostring(r.capacity or "?"),if r.full then " FULL" else "",list(q.hall),list(q.car),tostring(r.tickets or 0),
		if #states&gt;0 then " ("..table.concat(states,", ")..")" else "",if r.reason then " · reason "..tostring(r.reason) else ""))
end
local function doorReport(office: Model,tier: number,lines: {string})
	local r,err=inspect("DoorService",office)
	if typeof(r)~="table" then table.insert(lines,"Doors: unavailable"..(if err then " ("..err..")" else ""));return end
	-- Compute Operations (G_COMPUTE) and the Data Hall (B1_DATAHALL) are both compute-class rooms.
	local computeRooms={};for _,room in Plan.rooms(tier) do if room.kind=="compute" or room.kind=="datahall" then table.insert(computeRooms,room.name) end end
	local total,locked,odd,compute={},0,{},{}
	for _,d in r do
		if typeof(d)~="table" then continue end
		table.insert(total,d)
		if d.state=="locked" then locked+=1 end
		if d.state~="closed" and d.state~="locked" and #odd&lt;16 then table.insert(odd,string.format("%s %s",tostring(d.id),tostring(d.state))) end
		if d.access=="compute" then table.insert(compute,string.format("%s %s",tostring(d.id),tostring(d.state))) end
	end
	table.insert(lines,string.format("Doors: %d registered · %d locked · not closed: %s",#total,locked,if #odd&gt;0 then table.concat(odd,", ") else "none"))
	table.insert(lines,string.format("  compute doors (%s): %s",table.concat(computeRooms," + "),if #compute&gt;0 then table.concat(compute,", ") else "none registered"))
end
local function cameraReport(office: Model,lines: {string})
	local total,private,levels=0,0,{}
	for _,p in office:GetDescendants() do
		if p:IsA("BasePart") and p:GetAttribute("CameraId")~=nil then
			total+=1;if p:GetAttribute("Private")==true then private+=1 end
			local level=p:GetAttribute("Level");if typeof(level)=="number" then levels[level]=(levels[level] or 0)+1 end
		end
	end
	table.insert(lines,string.format("Cameras: %d channels · %d private · on %d levels",total,private,count(levels)))
end
-- Compact text report about one headquarters; never changes anything.
function Admin.diagnostics(office: Model,tier: number): string
	local def=EmpireConfig.OFFICES[Plan.officeForTier(tier)]
	local name=if def then def.name elseif tier&lt;1 then "Garage stage" else "?"
	local shape=if tier&lt;1 then "1 storey, no B1, no lift" else string.format("%d storeys + B1 + roof",Plan.floors(tier))
	local lines={string.format("HQ diagnostics · plan tier %d (%s) · %s%s",tier,name,shape,if Plan.hasHotel(tier) then " · guest house" else "")}
	for _,section in {
		function() roomReport(office,tier,lines) end,
		function() workstationReport(office,lines) end,
		function() staffReport(office,lines) end,
		function() liftReport(office,tier,lines) end,
		function() doorReport(office,tier,lines) end,
		function() cameraReport(office,lines) end,
	} do
		local ok,err=pcall(section :: () -&gt; any);if not ok then table.insert(lines,"(section failed: "..tostring(err)..")") end
	end
	return table.concat(lines,"\n")
end
-- Testing only: changes the admin's OWN saved office tier (and trims staff to the new desk count,
-- exactly like loading a save would). Plot.refresh then rebuilds the headquarters.
local function trimStaff(s: any,cap: number)
	local e=s.data.empire;local remaining=cap
	for _,role in EmpireConfig.ROLES do
		local n=math.min(e.employees[role.id] or 0,remaining);e.employees[role.id]=n;remaining-=n
	end
end
local function setTier(s: any,tier: number)
	s.data.empire.office=tier
	trimStaff(s,EmpireConfig.OFFICES[tier].staff)
end
-- "tierN" builds plan tier N (0 = garage stage, 1..4 = the HQ buildings): an alias of "stage(N+1)" through
-- Plan.officeForTier (OFFICE_TIER_OFFSET = 1 since DATA_VERSION 6). A plan tier that an office
-- index maps to (Plan.officeForTier) is set through the save as before; one that no office maps to yet
-- (the garage stage before the save migration) is a session-only override (session.planTier, never
-- saved) that HeadquartersDesign.tierFor reads. Returns false when the rebuild did not happen.
local function setPlanTier(s: any,tier: number): boolean
	local office=Plan.officeForTier(tier)
	if EmpireConfig.OFFICES[office] then
		s.planTier=nil
		setTier(s,office)
		return true
	end
	s.planTier=tier
	trimStaff(s,if tier&lt;1 then Plan.GARAGE_STAGE.staff else EmpireConfig.OFFICES[s.data.empire.office].staff)
	return true
end
local function run(s: any,p: any): any
	if s.userId~=s.player.UserId or not Admin.allowed(s.player) then return {ok=false,err="ADMIN_ONLY"} end
	local cmd=p.cmd
	if cmd=="diag" then
		local plot=Plot.get(s.player)
		if not plot or not plot.office then return {ok=false,err="LOADING"} end
		print(`[Admin] {s.player.Name} ({s.userId}): diag`)
		local built=plot.office:GetAttribute("OfficeTier")
		return {ok=true,cmd=cmd,report=Admin.diagnostics(plot.office,if typeof(built)=="number" then built else Plan.tierForOffice(s.data.empire.office))}
	end
	-- "stageN" sets the office index (1 = Garage Lab .. 5 = Global AI HQ, CORE_SPEC 2.4); the building follows
	local stage=if typeof(cmd)=="string" then tonumber(string.match(cmd,"^stage(%d)$")) else nil
	if stage and EmpireConfig.OFFICES[stage] then
		s.planTier=nil
		setTier(s,stage)
		Plot.refresh(s);Session.markDirty(s)
		print(`[Admin] {s.player.Name} ({s.userId}): {cmd}`)
		return {ok=true,cmd=cmd}
	end
	local tier=if typeof(cmd)=="string" then tonumber(string.match(cmd,"^tier(%d)$")) else nil
	if tier and tier&gt;=Plan.MIN_TIER and tier&lt;=Plan.MAX_TIER then
		local e=s.data.empire
		local before={office=e.office,employees=table.clone(e.employees),planTier=s.planTier}
		setPlanTier(s,tier)
		Plot.refresh(s);Session.markDirty(s)
		local plot=Plot.get(s.player)
		local built=if plot and plot.office then plot.office:GetAttribute("OfficeTier") else nil
		if built~=tier then
			-- the plot did not rebuild (a PlotService that compares the saved office index never rebuilds
			-- for a session-only plan tier): undo everything, the save keeps its staff
			s.planTier=before.planTier;e.office=before.office;e.employees=before.employees
			Plot.refresh(s);Session.markDirty(s)
			return {ok=false,err="TIER_NOT_BUILT"}
		end
		print(`[Admin] {s.player.Name} ({s.userId}): {cmd}`)
		return {ok=true,cmd=cmd}
	elseif cmd=="campus" then campus(s)
	elseif cmd=="staff" then staff(s)
	elseif cmd=="hardware" then hardware(s)
	elseif cmd=="research" then research(s)
	elseif cmd=="fleet" then fleet(s)
	elseif cmd=="money" then Economy.grant(s,1000000,"admin")
	elseif cmd=="data" then data(s)
	elseif cmd=="finish" then if not AI.finishNow(s) then return {ok=false,err="NO_TRAINING"} end
	elseif cmd=="setup" then campus(s);staff(s);research(s);hardware(s);fleet(s);data(s);Economy.grant(s,1000000,"admin")
	else return {ok=false,err="BAD_INPUT"} end
	Plot.refresh(s);Session.markDirty(s)
	print(`[Admin] {s.player.Name} ({s.userId}): {cmd}`)
	return {ok=true,cmd=cmd}
end
function Admin.init()
	Remote.bind("AdminAction",{burst=3,perSecond=.5},run)
	Session.onLoaded(function(s)
		s.live.admin=Admin.allowed(s.player);Session.markDirty(s)
	end)
end
return Admin
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000016"><Properties><string name="Name">StaffService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One employee identity owns a real workstation, a bounded navigator and a role-specific task state machine.
-- Economy (CORE_SPEC 5.1, 11.5): this service NEVER writes money or department output. Output is
-- WorkforceMath.count = CompanyOps.output, computed from saved data and the clock only, so a company
-- produces exactly the same whether its owner, a visitor or nobody stands near it. The state machine
-- below only animates the schedule and publishes live.workforce (visible counts, states) for screens.
-- LOD: an employee holding a lift ticket (or riding) never goes to "sleep"; sleeping mid-walk cancels
-- only the walk and keeps identity, station reservation and task, and the walk resumes on wake.
-- Visible work (StaffJobs): operations staff run their job steps (EmployeeConfig.JOBS), employees take a
-- real lunch (servery queue, plate, seat, tray return); held items and poses are rig attributes the client
-- renders (Holding / Pose), props are driven by one FxUntil write per use (PropFx contract).
-- Talking to employees is TalkService's job (the "EmployeeTalk" prompts); Staff.recordOf gives it the
-- live record (state, task, station) of a rig.
-- staffops: ONE clock (CORE_SPEC 6): the shown hour, Lighting.ClockTime, CompanyHour and every schedule come
-- from CompanyOps.hour(workspace:GetServerTimeNow()), the clock the economy uses (trip departures, duty, IT
-- on duty, news stamps); `time` stays a monotonic timer for e.next / cooldowns / Nav.pump (it starts at the
-- server time and is never behind it, so EmployeeConfig.hour(Staff.now()) shows the same hour).
-- Who is on duty (StaffRota, CORE_SPEC 5.3 / 11.1): absent people (vacation, sick, unpaid leave, trips) stay
-- OFF_DUTY with their desk released (employees[role] never changes), night crews work 22-06, operations
-- posts follow a covering day shift (security + IT night rota at stage 5), apprentices follow their own
-- schedule. Visible flows (StaffEvents): first-day arrivals through reception, IT/engineer rack repairs in
-- sync with CompanyOps faults, the apprentices' tour, training session, shadowing and the Training Lead.
-- Staff changes (hire / fire / graduation) are applied incrementally: StaffAssignment keeps every unchanged
-- rig, StaffService registers the new ones (StaffRev) instead of recreating the whole office.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Physics=game:GetService("PhysicsService")
local Lighting=game:GetService("Lighting")
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local Workforce=require(ReplicatedStorage.Shared.WorkforceMath)
local Plot=require(script.Parent.PlotService)
local Session=require(script.Parent.SessionService)
local Workstations=require(script.Parent.WorkstationService)
local Nav=require(script.Parent.EmployeeNavigation)
local Jobs=require(script.Parent.StaffJobs)
local Ops=require(ReplicatedStorage.Shared.CompanyOps)
local Rota=require(script.Parent.StaffRota)
local Events=require(script.Parent.StaffEvents)
local Assignment=require(script.Parent.StaffAssignment)
local Staff={}
local caches: {[Instance]:any}={}
local records: {[Model]:any}={}
local evaluationFloors: {[number]:{[number]:boolean}}={}
-- monotonic campus timer (starts at the server clock, never falls behind it; see header)
local time=workspace:GetServerTimeNow();local accumulator=0;local ticks=0
-- the ONE visible clock (CORE_SPEC 6): same hour and day index as the economy
local function shownHour(): number return Ops.hour(workspace:GetServerTimeNow()) end
local function shownDay(): number return math.floor(workspace:GetServerTimeNow()/Ops.DAY) end
local BREAKS={COFFEE_BREAK=true,LUNCH=true}
local QUOTA={researcher=2,engineer=2,marketer=1,curator=1}
local function state(e: any,name: string)
 e.state=name;e.model:SetAttribute("Activity",name)
end
local function jitter(e: any,max: number): number
 e.sequence+=1;return ((e.personality.seed+e.sequence*3571)%1000)/1000*max
end
local function nearest(position: Vector3,positions: {Vector3}): number
 local best=math.huge;for _,p in positions do best=math.min(best,(p-position).Magnitude) end;return best
end
local function destroy(e: any)
 Events.abort(e,e.cache);Jobs.abort(e,e.cache);Nav.cancel(e);Workstations.release(e);records[e.model]=nil
 if e.cache and e.cache.recordsSet then e.cache.recordsSet[e]=nil end
 if e.died then e.died:Disconnect();e.died=nil end
end
-- Street arrivals use the plaza in front of the entrance, car commuters the garage (B1; at plan tier 0 the
-- visitor bays in front of the garage): Plan.staffArrival.
local function commute(e: any): CFrame
 local base=Plan.staffArrival(e.tier,e.garage)
 return e.cf*CFrame.new(base+Vector3.new((e.index%5-2)*1.6,0,(e.index//5%3-1)*1.6))
end
-- On duty right now (StaffRota): absent people never, operations posts their covering day shift (or the
-- night rota), the night crew 22-06, everybody else the seeded shift.
local applyRota: (c: any,e: any,r: Rota.Snapshot)-&gt;()
local function onDutyAt(e: any,hour: number): boolean
 if e.role=="support" then
  return Rota.opsOnDuty(hour,e.shiftStart or 0,e.shiftEnd or 24,e.nightRota)
 end
 return Rota.hiredOnDuty(hour,e.personality.start,e.personality.finish,e.away,e.night)
end
-- Shift attributes for the talk lines ("My shift today runs from 7:15 to 18:20"); nil = around the clock
-- (night rota) or the seeded personality shift of hired staff.
local function shiftAttrs(e: any)
 local a,b=nil,nil
 if e.role=="support" then
  if not e.nightRota then a,b=e.shiftStart,e.shiftEnd end
 elseif e.night then a,b=Config.NIGHT_CREW.start,Config.NIGHT_CREW.finish end
 if e.model:GetAttribute("ShiftStart")~=a then e.model:SetAttribute("ShiftStart",a) end
 if e.model:GetAttribute("ShiftEnd")~=b then e.model:SetAttribute("ShiftEnd",b) end
end
-- Rota facts of one record (StaffRota snapshot): away today, night crew, night rota post, apprentice.
-- The apprentice look (lanyard, badge, size) follows graduation without a rebuild.
applyRota=function(c: any,e: any,r: Rota.Snapshot)
 if e.role=="support" then
  local nightRota=Rota.nightRota(r,e.post or 0)
  if nightRota~=(e.nightRota==true) then e.nightRota=nightRota or nil;shiftAttrs(e) end
  return
 end
 local i=e.index-(r.before[e.role] or 0)
 local key=Rota.key(e.role,i)
 e.away=r.away[key]
 local night=r.night[key]==true
 if night~=(e.night==true) then e.night=night or nil;shiftAttrs(e) end
 local a: {age: number,skill: number,seed: number}?=r.apprentices[key]
 if a and a.seed~=e.personality.seed then a=nil end -- the profile at this index changed: next resync fixes it
 e.apprentice=a
 local dressed=e.model:GetAttribute("Apprentice")==true
 if (a~=nil)~=dressed then Assignment.dressApprentice(e.model,a~=nil,c.session.data.empire) end
end
-- Off duty at the commute point (hidden by the client, never talked to, desk released).
local function park(e: any)
 Events.abort(e,e.cache);Jobs.abort(e,e.cache);Nav.cancel(e);Workstations.release(e)
 e.model:PivotTo(commute(e));e.root.Anchored=true;e.model:SetAttribute("OffDuty",true);state(e,"OFF_DUTY");e.next=time+e.index%7
end
-- One record per rig. mode "initial": spawn placement of a fresh office (off duty at the commute point,
-- a small staggered group arriving, everybody else at the desk); mode "added": a rig that appeared in a
-- running office (a hire, the Training Lead): a new hire arrives through reception (first day), later
-- shifts start normally.
local function register(c: any,m: Model,mode: string): any?
 if not m:IsA("Model") or not m.PrimaryPart then return nil end
 local h=m:FindFirstChildOfClass("Humanoid");local index=m:GetAttribute("StaffIndex")
 if not h or typeof(index)~="number" then return nil end
 local s=c.session
 local role=m:GetAttribute("RoleId") or "support"
 local skillAttr=m:GetAttribute("Skill")
 local e={model=m,root=m.PrimaryPart,humanoid=h,index=index,name=m:GetAttribute("EmployeeName"),role=role,skill=Workforce.factor(skillAttr),skillK=if typeof(skillAttr)=="number" then skillAttr :: number else 3,home=m:GetAttribute("HomeWorkstation"),cf=c.cf,tier=c.tier,office=c.office,session=s,personality=if typeof(m:GetAttribute("PersonalitySeed"))=="number" then Config.personalityFromSeed(m:GetAttribute("PersonalitySeed") :: number) else Config.personality(index,s.userId),sequence=0,state="SELECT_TASK",next=time+index%5*.7,lastBreak=time-index%80,lastMeeting=-200,now=time,taskStarted=time,cache=c}
 local work=m:GetAttribute("WorkCFrame");e.homePosition=if typeof(work)=="CFrame" then work.Position else m.PrimaryPart.Position
 e.garage=e.personality.seed%3==0
 if role=="support" then
  e.post=index-300
  e.shiftStart,e.shiftEnd=Rota.opsShift(e.personality.seed)
 end
 for _,part in m:GetDescendants() do if part:IsA("BasePart") then part.CollisionGroup="CompanyEmployees" end end
 e.died=h.Died:Connect(function()
  -- A dead rig keeps its identity (counted as offscreen) but never holds a station or a route.
  e.dead=true;Events.abort(e,c);Nav.cancel(e);Workstations.release(e);state(e,"INACTIVE")
 end)
 records[m]=e;table.insert(c.all,e);c.recordsSet[e]=true
 if c.rota then applyRota(c,e,c.rota) end
 local hour=shownHour()
 local duty=onDutyAt(e,hour)
 e.onDuty=duty
 shiftAttrs(e)
 if mode=="added" then
  local seed=e.personality.seed
  if not duty then
   park(e)
   if role~="support" or m:GetAttribute("Role")=="Training Lead" then Events.expect(c.office,seed,nil) end
  elseif Events.held(c.office,seed) then
   park(e);e.next=time+1 -- the hired candidate is still walking out to the speed gates
  else
   local pending=Events.claim(c.office,seed)
   Events.arrive(e,c,if pending and pending.from then pending.from else commute(e))
  end
  return e
 end
 local home=Workstations.scan(c.office).byId[e.home]
 if home and Workstations.reserve(home,e) then
  e.task=(Config.TASKS[role] or Config.TASKS.support)[1]
  -- operations staff start their job loop soon; employees work a while at their desk first
  if Workstations.perform(e,time) then state(e,e.task.state);e.next=time+(if role=="support" then 2+jitter(e,8) else 35+jitter(e,100)) end
 end
 -- Spawn placement (not movement): people whose shift has not started (or is over, or who are away
 -- today) wait off duty at their commute point; a small staggered group arrives from the street or
 -- garage; everyone else starts at their real desk.
 if not duty then park(e)
 elseif role~="support" and index%24&lt;3 then
  Nav.cancel(e);Workstations.release(e)
  m:PivotTo(commute(e));e.root.Anchored=false;state(e,"ARRIVING");e.next=time+index%12*.8
 end
 return e
end
-- Rigs added / removed / renumbered by StaffAssignment in a running office (StaffRev changed).
local function resync(c: any)
 c.rev=c.office:GetAttribute("StaffRev")
 -- the team changed: a fresh rota first (new apprentices, absences of the new people)
 c.rota=Rota.compute(c.session.data.empire,shownHour());c.rotaAt=time+2
 local seen: {[Model]:boolean}={}
 for _,group in {c.folder,c.ops} do if group then for _,m in group:GetChildren() do
  if not m:IsA("Model") then continue end
  local e=records[m]
  if e and e.cache==c then
   seen[m]=true
   local index=m:GetAttribute("StaffIndex");if typeof(index)=="number" then e.index=index end
   local home=m:GetAttribute("HomeWorkstation")
   if home~=e.home then
    e.home=home
    local work=m:GetAttribute("WorkCFrame");e.homePosition=if typeof(work)=="CFrame" then work.Position else e.homePosition
   end
   local k=m:GetAttribute("Skill");if typeof(k)=="number" then e.skillK=k;e.skill=Workforce.factor(k) end
  else
   local added=register(c,m,"added");if added then seen[m]=true end
  end
 end end end
 for i=#c.all,1,-1 do
  local e=c.all[i]
  if not seen[e.model] then destroy(e);table.remove(c.all,i) end
 end
end
local function sync(p: any,s: any): any
 local office=p.office;local folder=office:FindFirstChild("Employees");local ops=office:FindFirstChild("OperationsEmployees")
 local cached=caches[p.model]
 if cached and cached.office==office and cached.folder==folder and cached.ops==ops then
  if office:GetAttribute("StaffRev")~=cached.rev then resync(cached) end
  return cached
 end
 if cached then for _,e in cached.all do destroy(e) end end
 Workstations.reset(office)
 Workstations.scan(office)
 local c={office=office,folder=folder,ops=ops,all={},recordsSet={},session=s,event={},cf=p.cframe,rev=office:GetAttribute("StaffRev"),tier=(function(): number local t=office:GetAttribute("OfficeTier");return if typeof(t)=="number" then t else Plan.tierForOffice(s.data.empire.office) end)(),lastTraining=s.data.training~=nil,lastResearch=if s.data.empire.researchJob then s.data.empire.researchJob.id else nil,lastReleased=s.data.stats.modelsReleased,lastTrained=s.data.stats.modelsTrained,lastHardware=ModelMath.fleet(s.data.gpus).slotsUsed,lastData=ModelMath.dataSummary(s.data.data).total,nextMeeting=time+55,nextSocial=time+40,moving=0,onBreak=0,load={}}
 caches[p.model]=c
 c.rota=Rota.compute(s.data.empire,shownHour());c.rotaAt=time+2
 for _,group in {folder,ops} do if group then for _,m in group:GetChildren() do register(c,m,"initial") end end end
 return c
end
-- Held drink/snack after a break: the client renders it from the rig's Holding attribute (no server
-- part). A coffee is carried back to the desk for 90 s; a snack bar is eaten at the counter.
local function cup(e: any,item: string)
 Workstations.setItem(e,item)
 e.carryUntil=if item=="cup" then time+90 else time+6
end
local function dropItems(e: any)
 if e.lunch then return end
 e.carryUntil=nil;Workstations.setItem(e,nil);Workstations.setPose(e,nil)
end
-- A task with `via` (e.g. InspectServer via the server cart): the Pickup activity in the station's room.
local function viaStation(e: any,def: any,w: any): any
 if not def.via or e.viaDone==w then return nil end
 for _,p in Workstations.scan(e.office).byKind[def.via] or {} do
  if p.room==w.room and Workstations.allowed(p,e) then return p end
 end
 return nil
end
local walk: (e: any,def: any,w: any)-&gt;()
-- Walk to a reserved station and start the task there; also used to resume a walk after LOD sleep.
walk=function(e: any,def: any,w: any)
 e.walkTask=def
 local pickup=viaStation(e,def,w)
 local target=if pickup then pickup.position else w.position
 Nav.go(e,target,time,function(ok)
  e.walkTask=nil
  if e.dead or not e.model.Parent then return end
  if ok and pickup and e.station==w then
   -- picked up the item at the via point (one Pose + one Holding write), then on to the station
   e.viaDone=w;state(e,def.state)
   local f=pickup.model:GetAttribute("FacingPosition")
   if typeof(f)=="Vector3" then local d=Vector3.new(f.X-e.root.Position.X,0,f.Z-e.root.Position.Z);if d.Magnitude&gt;.2 then e.root.CFrame=CFrame.lookAt(e.root.Position,e.root.Position+d) end end
   Workstations.setPose(e,"reach");local item=pickup.model:GetAttribute("JobItem");Workstations.setItem(e,if typeof(item)=="string" then item else nil)
   e.pendingWalk={def=def,station=w,at=time+2.5};e.next=math.huge
   return
  end
  if ok and e.station==w and Workstations.perform(e,time) then
   state(e,def.state);local duration=def.seconds or {45,100};e.next=time+duration[1]+jitter(e,duration[2]-duration[1]);e.taskStarted=time
   if e.role=="support" then e.next=time+2+jitter(e,4) end -- back at the post: the job loop starts
   if def.state=="COFFEE_BREAK" then e.lastBreak=time;if def.id=="Coffee" or def.id=="FridgeDrink" then e.cupAt=time+4 end
   elseif def.state=="LUNCH" then e.lastLunch=shownDay()
   elseif def.state=="MEETING" or def.state=="TALKING" then e.lastMeeting=time;e.next=def.untilTime or e.next end
   if e.viaDone==w and e.item then Workstations.setPose(e,"reach") end -- carrying the blade to the rack
  else
   Workstations.release(e);state(e,"SELECT_TASK");e.next=time+5+jitter(e,8);dropItems(e)
   if def.state=="COFFEE_BREAK" then e.lastBreak=time-e.personality.breakEvery+45 elseif def.state=="LUNCH" then e.lunchRetry=time+20 end
  end
 end)
end
local function begin(e: any,def: any,w: any)
 if e.cache.moving&gt;=Config.moverCap(e.role) then e.next=time+3;return end
 if not w then e.next=time+4+jitter(e,6);state(e,"WAIT_AT_DESK");return end
 Nav.cancel(e);Workstations.release(e)
 e.viaDone=nil;e.pendingWalk=nil
 if not e.carryUntil then dropItems(e) end -- a coffee stays in the hand on the way back to work
 if not Workstations.reserve(w,e) then e.next=time+3;state(e,"SELECT_TASK");return end
 e.cache.moving+=1;if BREAKS[def.state] then e.cache.onBreak+=1 end
 e.task=def;e.taskStarted=time;e.next=math.huge;e.model:SetAttribute("Task",def.id);state(e,"WALKING")
 walk(e,def,w)
end
local function breakRoom(c: any): boolean
 return c.onBreak&lt;math.max(1,math.floor(#c.all*Config.BREAK_SHARE))
end
local function selectTask(e: any,c: any,hour: number)
 if c.moving&gt;=Config.moverCap(e.role) then e.next=time+2+jitter(e,3);return end
 -- operations staff: their visible job loop (never a coffee walk; short breaks in place)
 if e.role=="support" then Jobs.next(e,c);return end
 if e.forced then local forced=e.forced;e.forced=nil;if (forced.task.untilTime or math.huge)&gt;time+10 then begin(e,forced.task,forced.station);return end end
 local day=shownDay()
 local lunchEnd=e.personality.lunch+1.1+(if e.lunchDeferred==day then .9 else 0)
 if hour&gt;=e.personality.lunch and hour&lt;lunchEnd and e.lastLunch~=day and time&gt;=(e.lunchRetry or 0) then
  if breakRoom(c) then
   local def={id="Lunch",type="Dining",department="kitchen",seconds={120,230},state="LUNCH"};local w=Workstations.choose(e,def)
   if w and Jobs.lunch(e,c,w,def) then c.onBreak+=1;return end
   e.lunchRetry=time+15
  else e.lunchDeferred=day;e.lunchRetry=time+12+jitter(e,10) end
 end
 if time-e.lastBreak&gt;e.personality.breakEvery then
  if breakRoom(c) then
   e.breaks=(e.breaks or 0)+1
   -- about every tenth break is a wellness break (treadmill, bike, rower, weights, sauna, shower)
   if (e.personality.seed+e.breaks*3)%Config.WELLNESS_EVERY==0 then
    local def={id="Wellness",type="Wellness",department="wellness",seconds={40,70},state="COFFEE_BREAK"}
    local w=Workstations.choose(e,def);if w then begin(e,def,w);return end
   end
   local roof=e.personality.seed%7==0;local lounge=not roof and e.personality.seed%5==0;local drink=not roof and not lounge and e.personality.seed%4==0
   local coffee=not roof and not lounge and not drink and e.personality.coffee
   local def={id=if roof then "RoofBreak" elseif lounge then "LoungeBreak" elseif drink then "FridgeDrink" elseif coffee then "Coffee" else "Snack",type=if roof or lounge then "Lounge" elseif drink then "Fridge" elseif coffee then "Coffee" else "Snack",department=if roof then "roof" elseif lounge then "lounge" else "kitchen",nearest=coffee,seconds={20,55},state="COFFEE_BREAK"}
   local w=Workstations.choose(e,def);if w then begin(e,def,w);return end
   e.lastBreak=time-e.personality.breakEvery+40 -- nothing free: ask again later
  else e.lastBreak=time-e.personality.breakEvery+20+jitter(e,25) end
 end
 -- apprentices (staffops): practice at the own desk or sit next to a senior colleague; the tour and the
 -- training session are office events (StaffEvents.academyTick)
 if e.apprentice and Events.apprenticeTask(e,c) then return end
 local best,station=nil,nil;local score=-math.huge
 for _,def in Config.TASKS[e.role] or Config.TASKS.support do
  local w=Workstations.choose(e,def)
  if w then
   local load=(c.load[def.id] or 0)-(if e.task and e.task.id==def.id then 1 else 0)
   local p=Config.priority(e.role,def,c.event)+jitter(e,28)-load*1.6+(if Config.departmentMatch(def,w.department) then 8 else -10)
   if p&gt;score then best=def;station=w;score=p end
  end
 end
 if best then begin(e,best,station) else e.next=time+6;state(e,"WAIT_AT_DESK") end
end
local function evaluation(tier: number): {[number]:boolean}
 local cached=evaluationFloors[tier];if cached then return cached end
 local set: {[number]:boolean}={}
 for _,r in Plan.rooms(tier) do if r.dept=="evaluation" then set[r.level]=true end end
 evaluationFloors[tier]=set;return set
end
local function free(room: any): {any}
 local out={}
 for _,w in room.seats do if w.model.Parent and not w.reserved and not (w.seat and w.seat.Occupant) then table.insert(out,w) end end
 return out
end
local function available(e: any): boolean
 -- apprentices keep their own schedule (tour, training, shadowing): not drafted into team meetings / chats
 return e.role~="support" and not e.dead and not e.talkHold and e.lod~="sleep" and not e.nav and not e.forced and not e.apprentice and not e.event and time-e.lastMeeting&gt;=160
  and e.state~="LUNCH" and e.state~="COFFEE_BREAK" and e.state~="OFF_DUTY" and e.state~="LEAVING" and e.state~="ARRIVING" and e.state~="MEETING" and e.state~="TALKING" and e.state~="INACTIVE"
end
-- Any meeting room with &gt;= 3 free Meeting seats. Reviews prefer the G project room and meeting rooms
-- on evaluation floors; team meetings take a room on the floor where most free colleagues are.
-- Participants come mostly from the room's floor; role quotas and cooldowns as before.
local function meeting(c: any,review: boolean)
 local eligible={};local perLevel={}
 for _,e in c.all do if available(e) then e.meetLevel=Workstations.levelOf(e);table.insert(eligible,e);perLevel[e.meetLevel]=(perLevel[e.meetLevel] or 0)+1 end end
 if #eligible&lt;2 then return end
 local floors=evaluation(c.tier);local stamp=math.floor(time)
 local room,seats,best=nil,nil,-math.huge
 for id,r in Workstations.scan(c.office).meetings do
  local open=free(r);if #open&lt;3 then continue end
  local here=perLevel[r.level] or 0
  local score=if review then (if id=="ProjectRoom" then 60 else 0)+(if floors[r.level] then 40 else 0)+here*2 else here*10+(if id=="Boardroom" then 4 else 0)
  score+=((#tostring(id)*37+stamp)%11)/10
  if score&gt;best then room=r;seats=open;best=score end
 end
 if not room or not seats then return end
 local level=room.level
 table.sort(eligible,function(a,b)
  local da=math.abs(a.meetLevel-level);local db=math.abs(b.meetLevel-level)
  if da~=db then return da&lt;db end
  local ka=(a.index*7+stamp)%13;local kb=(b.index*7+stamp)%13
  if ka~=kb then return ka&lt;kb end
  return a.index&lt;b.index
 end)
 local selected={};local roles={researcher=0,engineer=0,marketer=0,curator=0};local taken={};local limit=math.min(5,#seats)
 for _,e in eligible do
  if (roles[e.role] or 0)&gt;=(QUOTA[e.role] or 0) then continue end
  local seat=nil;for _,w in seats do if not taken[w] and Workstations.available(w,e) then seat=w;break end end
  if not seat then continue end
  taken[seat]=true;table.insert(selected,{employee=e,seat=seat});roles[e.role]+=1
  if #selected&gt;=limit then break end
 end
 if #selected&lt;2 then return end
 local untilTime=time+150
 for i,s in selected do
  s.employee.forced={task={id=if review then "ModelReviewMeeting" else "TeamMeeting",state="MEETING",seconds={80,160},untilTime=untilTime},station=s.seat}
  s.employee.next=math.min(s.employee.next,time+i*1.3)
 end
 c.office:SetAttribute("MeetingTopic",if review then "MODEL REVIEW" else "TEAM REVIEW");c.office:SetAttribute("MeetingUntil",untilTime);c.office:SetAttribute("MeetingRoom",tostring(room.id))
end
local function conversation(c: any)
 local groups={}
 for _,w in Workstations.scan(c.office).byKind.Conversation or {} do
  if not w.reserved and w.model.Parent then local id=w.group or w.id;groups[id]=groups[id] or {};table.insert(groups[id],w) end
 end
 for _,seats in groups do if #seats&gt;=2 then
  local selected={}
  for _,e in c.all do
   if e.personality.social&gt;.55 and available(e) and time-e.lastMeeting&gt;100 and (e.root.Position-seats[1].position).Magnitude&lt;80 and math.abs(e.root.Position.Y-seats[1].position.Y)&lt;8
    and Workstations.available(seats[#selected+1],e) then table.insert(selected,e);if #selected==2 then break end end
  end
  if #selected==2 then for i,e in selected do e.forced={task={id="DiscussWork",state="TALKING",seconds={25,45},untilTime=time+55},station=seats[i]};e.next=math.min(e.next,time+i) end;return end
 end end
end
local function events(c: any,s: any)
 local d=s.data;local trained=d.stats.modelsTrained;local hardware=ModelMath.fleet(d.gpus).slotsUsed;local data=ModelMath.dataSummary(d.data).total
 local review=trained&gt;c.lastTrained
 if review then c.reviewUntil=time+150;c.nextMeeting=time+2 end
 if hardware&gt;c.lastHardware then c.hardwareUntil=time+80 end
 if data&gt;c.lastData+1e8 then c.dataUntil=time+80 end
 local live=false;for _,model in d.models do if model.status=="live" then live=true;break end end
 c.event={training=d.training~=nil,research=d.empire.researchJob~=nil,review=(c.reviewUntil or 0)&gt;time,live=live,hardware=(c.hardwareUntil or 0)&gt;time,data=(c.dataUntil or 0)&gt;time}
 local research=if d.empire.researchJob then d.empire.researchJob.id else nil
 local changed=(research~=c.lastResearch) or d.stats.modelsReleased&gt;c.lastReleased or (c.lastTraining~=(d.training~=nil)) or review or hardware&gt;c.lastHardware
 if changed then for _,e in c.all do if (e.role=="engineer" or e.role=="researcher" or e.role=="marketer") and not e.nav and time-e.taskStarted&gt;10 and e.state~="LUNCH" then e.next=math.min(e.next,time+e.index%9) end end end
 c.lastResearch=research;c.lastReleased=d.stats.modelsReleased
 c.lastTraining=d.training~=nil;c.lastTrained=trained;c.lastHardware=hardware;c.lastData=data
 if time&gt;=c.nextMeeting then meeting(c,c.event.review);c.nextMeeting=time+180 end
 if time&gt;=c.nextSocial then conversation(c);c.nextSocial=time+75 end
end
local function leave(e: any)
 if e.nav then return end
 -- the end-of-shift wave respects the office movers cap too (departures stagger instead of 40+ walkers)
 if e.cache.moving&gt;=Config.moverCap(e.role) then e.next=time+2+jitter(e,4);return end
 e.cache.moving+=1
 Events.abort(e,e.cache);Jobs.abort(e,e.cache);dropItems(e)
 Workstations.release(e);e.task={id="Leaving",state="LEAVING"};state(e,"LEAVING");e.next=math.huge
 Nav.go(e,commute(e).Position,time,function(ok)
  if e.dead or not e.model.Parent then return end
  if ok then state(e,"OFF_DUTY");e.model:SetAttribute("OffDuty",true);e.root.Anchored=true;e.next=time+8;e.leaveFails=nil
  else
   -- no route home three times in a row (e.g. a post in the guest house): off duty where the route ends
   e.leaveFails=(e.leaveFails or 0)+1
   if e.leaveFails&gt;=3 then e.leaveFails=nil;park(e) else state(e,"SELECT_TASK");e.next=time+12 end
  end
 end)
end
-- Rare fallback only (an employee found in a zone its role may not enter); never ordinary movement.
local function security(e: any)
 local pos=e.cf:PointToObjectSpace(e.root.Position)
 if Plan.employeeAllowed(e.role,e.tier,pos) then return end
 warn(string.format("[Staff] Security recovery: %s (%s) in a restricted zone at local %.1f, %.1f, %.1f; returned to the home desk",tostring(e.name),tostring(e.role),pos.X,pos.Y,pos.Z))
 Nav.cancel(e);Workstations.release(e)
 local home=e.model:GetAttribute("WorkCFrame")
 local target=if typeof(home)=="CFrame" and Plan.employeeAllowed(e.role,e.tier,e.cf:PointToObjectSpace(home.Position)) then home else commute(e)
 e.model:PivotTo(target);e.next=time+5;state(e,"SELECT_TASK")
end
-- Conversation hold (TalkService): the employee stays put; identity, task, station and state are kept
-- (the economy counts it exactly as before). A route in progress is re-issued on release with its own
-- callback, a job hop walks on, everything else continues where it was.
local HOLD_MAX=120
local function unhold(e: any)
 if not e.talkHold then return end
 e.talkHold=nil;e.talkHoldUntil=nil
 local held=e.heldNav;e.heldNav=nil
 local anchored=e.heldAnchored;e.heldAnchored=nil
 if e.dead or not e.model.Parent or not e.root.Parent then return end
 if anchored~=nil and not e.humanoid.SeatPart then e.root.Anchored=anchored end
 if held then Nav.go(e,held.target,time,held.callback) else Jobs.resume(e,time) end
end
local function setLod(e: any,lod: string)
 local was=e.lod;e.lod=lod;e.model:SetAttribute("SimulationLOD",lod)
 if lod=="sleep" then
  unhold(e)
  -- Keep identity, reservation and task; only the walk stops (resumed on wake). Lunch and job flows
  -- end cleanly (they restart from selectTask when somebody comes close again).
  local flow=e.lunch~=nil or e.jobStep~=nil or e.hop~=nil or e.event~=nil
  if flow then Events.abort(e,e.cache);Jobs.abort(e,e.cache);if e.lunch==nil and e.state=="LUNCH" then state(e,"SELECT_TASK") end;e.next=math.min(e.next,time+1) end
  e.pendingWalk=nil
  e.resumeWalk=e.nav~=nil and e.state=="WALKING" and e.station~=nil and e.walkTask~=nil and not flow
  local pending=e.walkTask
  Nav.cancel(e);e.walkTask=pending
  if flow and e.state=="WALKING" then Workstations.release(e);state(e,"SELECT_TASK") end
  e.humanoid.EvaluateStateMachine=false;e.root.Anchored=true
 elseif was=="sleep" or was==nil then
  if e.state=="OFF_DUTY" or e.state=="INACTIVE" then return end
  e.humanoid.EvaluateStateMachine=true
  -- nobody saw the shift end / the absence start while asleep: already at home, not walking out now
  if was=="sleep" and not onDutyAt(e,shownHour()) then park(e);return end
  if e.resumeWalk and e.station and e.walkTask then
   e.resumeWalk=false;e.root.Anchored=false;walk(e,e.walkTask,e.station);return
  end
  e.resumeWalk=false;e.walkTask=nil
  if e.state=="WALKING" or e.state=="LEAVING" then Workstations.release(e);state(e,"SELECT_TASK") end
  e.root.Anchored=e.station~=nil and e.station.seat~=nil
  e.next=math.min(e.next,time+e.index%11)
 end
end
function Staff.init()
 Jobs.bind({now=function(): number return time end,hour=shownHour,state=state,jitter=jitter})
 Events.bind({now=function(): number return time end,hour=shownHour,state=state,jitter=jitter,begin=begin})
 pcall(function()Physics:RegisterCollisionGroup("CompanyEmployees")end)
 pcall(function()Physics:RegisterCollisionGroup("CompanyPlayers")end)
 Physics:CollisionGroupSetCollidable("CompanyEmployees","CompanyEmployees",false)
 Physics:CollisionGroupSetCollidable("CompanyEmployees","CompanyPlayers",false)
 local function bindCharacter(char: Model)
  local function set(p: Instance)if p:IsA("BasePart") then p.CollisionGroup="CompanyPlayers" end end
  for _,p in char:GetDescendants() do set(p) end;char.DescendantAdded:Connect(set)
 end
 Session.onLoaded(function(s)if s.player.Character then bindCharacter(s.player.Character) end;s.player.CharacterAdded:Connect(bindCharacter)end)
 Session.onClosing(function(s)
  for model,c in caches do if c.session==s then for _,e in c.all do destroy(e) end;caches[model]=nil end end
 end)
end
-- Office rota (every 2 s): absences, night crew, night rota, apprentices; the Training Lead leaves with
-- the last apprentice (CORE_SPEC 11.1: the post exists only while there are apprentices).
local function refreshRota(c: any,s: any,hour: number)
 if time&lt;(c.rotaAt or 0) then return end
 c.rotaAt=time+2
 local r=Rota.compute(s.data.empire,hour)
 c.rota=r
 for i=#c.all,1,-1 do
  local e=c.all[i]
  if r.apprenticeCount==0 and e.role=="support" and e.model:GetAttribute("Role")=="Training Lead" then
   destroy(e);table.remove(c.all,i)
   if e.model.Parent then e.model:Destroy() end
  else applyRota(c,e,r) end
 end
end
function Staff.tick(dt: number)
 time=math.max(time+dt,workspace:GetServerTimeNow());accumulator+=dt;if accumulator&lt;.2 then return end;accumulator=0;ticks+=1
 local positions={};for _,s in Session.all() do if not s.closed and s.player.Character and s.player.Character.PrimaryPart then table.insert(positions,s.player.Character.PrimaryPart.Position) end end
 local hour=shownHour();Lighting.ClockTime=hour
 local clock=workspace:GetServerTimeNow()
 for _,p in Plot.all() do if p.office and p.owner then
  local s=Session.get(p.owner);if not s or s.closed then continue end
  local c=sync(p,s);events(c,s)
  refreshRota(c,s,hour)
  c.moving=0;c.onBreak=0;c.load={}
  for _,e in c.all do
   if e.nav or e.hop then c.moving+=1 end
   if e.task then c.load[e.task.id]=(c.load[e.task.id] or 0)+1 end
   if BREAKS[e.state] or (e.state=="WALKING" and e.task and BREAKS[e.task.state]) then c.onBreak+=1 end
  end
  local counts={researcher=0,engineer=0,curator=0,marketer=0};local states={};local visible=0
  for _,e in c.all do
   e.now=time
   if e.dead or not e.root.Parent or not e.humanoid.Parent then
    if counts[e.role] then counts[e.role]+=e.skill end
    states.INACTIVE=(states.INACTIVE or 0)+1;continue
   end
   if e.carryUntil and time&gt;=e.carryUntil and not e.lunch then e.carryUntil=nil;if e.item=="cup" or e.item=="snack" then Workstations.setItem(e,nil) end end
   local distance=nearest(e.root.Position,positions);local lod=if distance&gt;Config.FAR then "sleep" elseif distance&gt;Config.NEAR then "reduced" else "full"
   -- Never freeze an employee inside the moving cabin: sleep waits until the lift ticket is done.
   if lod=="sleep" and e.lod~="sleep" and Nav.liftBusy(e) then lod=e.lod or "reduced" end
   if lod~=e.lod then setLod(e,lod) end
   local productive=1
   if e.talkHold and time&gt;=(e.talkHoldUntil or 0) then unhold(e) end -- safety: a lost release
   if e.lod~="sleep" then
    visible+=1
    if not e.talkHold and (ticks+e.index)%5==0 and not Nav.liftBusy(e) then security(e) end
    Nav.tick(e,time)
    local onDuty=onDutyAt(e,hour);e.onDuty=onDuty
    -- shift over: during the day the current task is finished first; once the office has closed (night
    -- hours pass at ~21 s per hour) the step ends within a few seconds, so nobody works until morning
    if onDuty then e.offAt=nil elseif not e.offAt and (hour&gt;=18 or hour&lt;8) then e.offAt=time+3+jitter(e,8) end
    if e.talkHold then
     -- in a conversation: no task changes, no walking (state and economy weight unchanged)
    elseif e.pendingWalk and time&gt;=e.pendingWalk.at and not e.nav then
     local p=e.pendingWalk
     if c.moving&gt;=Config.moverCap(e.role) then p.at=time+1 -- second leg (cart -&gt; rack) waits for a free slot
     else
      e.pendingWalk=nil
      if e.station==p.station then c.moving+=1;state(e,"WALKING");walk(e,p.def,p.station) else e.next=time+1 end
     end
    elseif Jobs.busy(e) then Jobs.tick(e,c,time)
    elseif Events.busy(e) then
     if onDuty then Events.tick(e,c,time) else Events.abort(e,c);Jobs.abort(e,c);Nav.cancel(e);Workstations.release(e);state(e,"SELECT_TASK");e.next=time end
    elseif not onDuty and e.state~="OFF_DUTY" and e.state~="LEAVING" and not e.nav and (time&gt;=e.next or time&gt;=(e.offAt or math.huge)) then leave(e)
    elseif onDuty and (e.state=="OFF_DUTY" or e.state=="ARRIVING") and not e.nav and time&gt;=e.next then
     if Events.held(c.office,e.personality.seed) then e.next=time+1
     else
      e.model:SetAttribute("OffDuty",false)
      local pending=Events.claim(c.office,e.personality.seed)
      -- first day of a hire (made while this person was off duty, or an interview hire): in through reception
      if pending then Events.arrive(e,c,pending.from or commute(e))
      else local def=(Config.TASKS[e.role] or Config.TASKS.support)[1];local home=Workstations.scan(e.office).byId[e.home] or Workstations.choose(e,def);begin(e,def,home) end
     end
    elseif onDuty and not e.nav and time&gt;=e.next then selectTask(e,c,hour) end
    if e.cupAt and time&gt;=e.cupAt then cup(e,if e.task and e.task.id=="Snack" then "snack" else "cup");e.cupAt=nil end
    productive=Config.productive(e.state)
   end
   if counts[e.role] then counts[e.role]+=productive*e.skill end
   states[e.state]=(states[e.state] or 0)+1
  end
  Jobs.officeTick(c)
  -- once a second: rack faults (blade states + repairs, in sync with CompanyOps) and the apprentices
  if time&gt;=(c.eventsAt or 0) then
   c.eventsAt=time+1
   Events.rackTick(c,s,clock)
   Events.academyTick(c,hour,if c.rota then c.rota.day else Ops.day(s.data.empire))
  end
  s.live.workforce={researcher=counts.researcher,engineer=counts.engineer,curator=counts.curator,marketer=counts.marketer,visible=visible,total=#c.all,hour=hour,states=states}
  -- CompanyHour: written when the shown hour changes (PropFx "Hour" gate and screens read it)
  local shown=math.floor(hour*10)/10
  if c.lastHour~=shown then c.lastHour=shown;c.office:SetAttribute("CompanyHour",hour) end
 end end
 for model,c in caches do if not c.office.Parent then for _,e in c.all do destroy(e) end;caches[model]=nil end end
 Nav.pump(time)
end
-- TalkService: pause one employee for a conversation (false = not now: unknown, dead, asleep, off duty,
-- leaving or in the lift). The caller turns a standing NPC towards the player and calls release once.
function Staff.hold(model: Model,_face: Vector3): boolean
 local e=records[model]
 if not e or e.dead or not e.root.Parent or not e.humanoid.Parent or e.lod=="sleep" then return false end
 if e.state=="OFF_DUTY" or e.state=="LEAVING" or e.state=="INACTIVE" or Nav.liftBusy(e) then return false end
 e.talkHoldUntil=time+HOLD_MAX
 if e.talkHold then return true end
 e.talkHold=true
 local n=e.nav
 if n then e.heldNav={target=n.target,callback=n.callback};Nav.cancel(e) end
 Jobs.pause(e)
 if not e.humanoid.SeatPart then
  e.heldAnchored=e.root.Anchored
  e.humanoid:MoveTo(e.root.Position);e.root.Anchored=true
 end
 return true
end
function Staff.release(model: Model)
 local e=records[model]
 if e then unhold(e) end
end
-- Live record of an employee rig (TalkService reads state / task / station for dialogue). Read-only use.
function Staff.recordOf(model: Model): any
 return records[model]
end
-- Campus clock of the shared EmployeeNavigation queue (Nav.pump runs on it): other NPC drivers
-- (RecruitingService visitors, AssistantService) pass this time to Nav.go/Nav.tick.
function Staff.now(): number return time end
-- The visible company hour (CompanyOps.hour of the server clock): sky, schedules, economy.
function Staff.hour(): number return shownHour() end
-- RecruitingService (interview hire): the new employee walks in through reception (StaffEvents first-day
-- flow) once StaffAssignment has built the rig - from `from`, or, with `hold`, hidden until
-- Staff.handoverArrival hands over the visitor's last spot (the speed gates).
function Staff.expectArrival(office: Instance,seed: number,from: CFrame?,hold: boolean?)
 Events.expect(office,math.floor(math.abs(seed))%2147483647,from,hold)
end
function Staff.handoverArrival(office: Instance,seed: number,from: CFrame?)
 Events.handover(office,math.floor(math.abs(seed))%2147483647,from)
end
-- Admin diagnostics: one plain row per employee.
function Staff.inspect(office: Model): {any}
 for _,c in caches do if c.office==office then
  local out={}
  for _,e in c.all do
   table.insert(out,{name=e.name,index=e.index,role=e.role,state=e.state,task=if e.task then e.task.id else nil,station=if e.station then e.station.id else nil,
    home=e.home,lod=e.lod,navIssue=e.model:GetAttribute("NavigationIssue"),navStage=Nav.stage(e),liftTicketState=Nav.ticketState(e),
    away=e.away,night=e.night==true,apprentice=e.apprentice~=nil,event=if e.event then e.event.kind else nil,onDuty=e.onDuty})
  end
  return out
 end end
 return {}
end
return Staff
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000017"><Properties><string name="Name">LiftService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One physical, multi-passenger lift per headquarters (geometry: CoreDesign, SPEC §4).
--
-- Transport and trade-offs:
--  * The cabin is a real assembly: every cabin part is welded to CabinFloor (door leaves through
--    a Weld whose C0 slides them), the floor rides a PrismaticConstraint servo on the anchored
--    LiftGuide and the server owns its physics. Riders stand on the floor and are carried by the
--    engine: no PivotTo, no anchoring, no WalkSpeed/JumpPower changes, so players and NPCs can walk
--    in and out, ride together and leave at any open stop. Cost: a client sees the server-owned
--    cabin with replication delay, so fast moves can jitter; vmax 10 studs/s and 6 studs/s² keep
--    that small, and the passenger box tolerates the lag (y -4..10 above the floor).
--  * TargetPosition follows a trapezoidal profile computed at the service tick (~20 Hz). Servo
--    Speed = vmax + 1 and a moderate LinearResponsiveness smooth the 20 Hz steps; arrival means
--    CurrentPosition within 0.1 stud for 0.2 s, and only then can doors open.
--  * Collision groups: LiftCabin never collides with LiftShaft (shaft walls, landing doors, sills,
--    pit, head house). Safety net: attach also moves any other collidable Default-group part that
--    intrudes into the swept cabin volume into LiftShaft (warned once), so a mis-built slab edge
--    cannot jam the cabin; characters still collide with those parts.
--  * Scheduling, door state machine and NPC tickets live in the pure, unit-tested LiftLogic:
--    collective SCAN over deduplicated hall/car call sets, door zone safety (never closes on
--    anyone), overload hold, FIFO NPC boarding that keeps 2 slots for players waiting in the lobby.
--  * NPCs are never moved by this service: a ticket exposes a target the navigation walks to.
--  * Emergency evacuation is the only teleport: detach (before an office rebuild) and a cabin
--    declared out of service after repeated stalls move player riders to the nearest landing exit.
--  * Rights: calls need authorize(player, ownerId); opening the doors at the current stop is always
--    allowed for riders (egress), and arriving cabins always open, so nobody can be trapped.
--  * tick() is self-healing: it attaches built offices it does not know yet (Plot.all, required
--    lazily because PlotService requires this module), forgets destroyed offices, and never errors.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Logic = require(script.Parent.LiftLogic)
local Sound = require(script.Parent.CampusSoundService)
local Remote = require(script.Parent.Parent.Lib.Remote)

local Lift = {}

local CABIN_GROUP, SHAFT_GROUP = "LiftCabin", "LiftShaft"
local DOOR_ZONE = { x1 = -4.5, x2 = 4.5, z1 = 51.5, z2 = 57.5 } -- building-local, y level-1..level+7
local LOBBY = { x1 = -22, x2 = 22, z1 = 36, z2 = 54 } -- y level-2..level+10
local INSIDE_HALF, INSIDE_LOW, INSIDE_HIGH = 5.6, -4, 10 -- cabin-local, relative to the floor top
local LANDING_RANGE = 14 -- remote hall calls: max distance from a landing
local NEAR_RANGE = 18 -- NPC counts as waiting at the landing within this radius
local RIDER_MASS = 30 -- generous per-rider mass for the servo force
local LIGHT = PhysicalProperties.new(0.1, 0.5, 0, 1, 1)
local ARROWS: { [number]: string } = { [1] = "▲", [-1] = "▼", [0] = "•" }

type Labels = { level: TextLabel?, arrow: TextLabel?, status: TextLabel? }
type Landing = {
	level: number,
	doorL: BasePart,
	doorR: BasePart,
	closedL: CFrame,
	openL: CFrame,
	closedR: CFrame,
	openR: CFrame,
	labels: Labels,
	sound: BasePart,
}
type Leaf = { part: BasePart, weld: Weld?, closed: CFrame, open: CFrame }
type Record = {
	office: Instance,
	cabin: Model,
	floor: BasePart,
	guide: BasePart,
	display: BasePart?,
	prismatic: PrismaticConstraint,
	att0: Attachment,
	att1: Attachment,
	joints: { Instance },
	leaves: { Leaf },
	cabinParts: { BasePart },
	landings: { [number]: Landing },
	labels: Labels,
	cf: CFrame,
	topRel: CFrame,
	ownerId: number,
	tier: number,
	car: Logic.Car,
	tickets: { [Logic.Ticket]: Model },
	tweens: { Tween },
	doorLanding: number?,
	lastDoor: number,
	lastTarget: number,
	texts: { [Instance]: string },
	ownerSet: boolean,
	parented: boolean,
	displayClock: number,
	riders: number,
	lastLevel: number?,
	lastState: string?,
}
type Person = { player: Player, character: Model, root: BasePart }
type Wanted = { rec: Record, level: number, expires: number }

local records: { [Instance]: Record } = {}
local failed: { [Instance]: boolean } = {}
local ticketHome: { [Logic.Ticket]: Record } = {}
local wanted: { [Player]: Wanted } = {} -- destination chosen at a landing, sent as car call on boarding
local warned: { [string]: boolean } = {}
local authorize: (Player, number) -&gt; boolean = function(_player: Player, _owner: number): boolean
	return false
end
local now, sweepClock, healClock = 0, 0, 0
local groupsReady, initialized = false, false

local function warnOnce(key: string, message: string)
	if warned[key] then
		return
	end
	warned[key] = true
	warn("[Lift] " .. message)
end

local function notify(player: Player, kind: string, payload: { [string]: any })
	pcall(Remote.fire, player, "Notify", kind, payload)
end

local function ensureGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	for _, name in { CABIN_GROUP, SHAFT_GROUP } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(CABIN_GROUP, SHAFT_GROUP, false)
	end)
end

---------------------------------------------------------------------------- geometry helpers

local function rootOf(model: Instance?): BasePart?
	if not model or not model:IsA("Model") then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return model.PrimaryPart
end

local function aliveModel(model: Instance): boolean
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health &gt; 0
end

local function cabinFrame(rec: Record): CFrame
	return rec.floor.CFrame * rec.topRel
end

local function insideFrame(frame: CFrame, p: Vector3): boolean
	local v = frame:PointToObjectSpace(p)
	return math.abs(v.X) &lt; INSIDE_HALF and math.abs(v.Z) &lt; INSIDE_HALF and v.Y &gt; INSIDE_LOW and v.Y &lt; INSIDE_HIGH
end

local function inBox(v: Vector3, box: { x1: number, x2: number, z1: number, z2: number }, level: number, low: number, high: number): boolean
	local y = Plan.levelY(level)
	return v.X &gt;= box.x1 and v.X &lt;= box.x2 and v.Z &gt;= box.z1 and v.Z &lt;= box.z2 and v.Y &gt;= y + low and v.Y &lt;= y + high
end

local function child(parent: Instance?, name: string): BasePart?
	local p = if parent then parent:FindFirstChild(name, true) else nil
	return if p and p:IsA("BasePart") then p else nil
end

local function cframeAttr(inst: Instance, name: string): CFrame?
	local v = inst:GetAttribute(name)
	return if typeof(v) == "CFrame" then v else nil
end

local function labelsOf(part: Instance?): Labels
	local gui = if part then part:FindFirstChild("Display") else nil
	local function label(name: string): TextLabel?
		local l = if gui then gui:FindFirstChild(name, true) else nil
		return if l and l:IsA("TextLabel") then l else nil
	end
	return { level = label("Level"), arrow = label("Arrow"), status = label("Status") }
end

local function findLanding(folder: Instance, level: number): Instance?
	for _, c in folder:GetChildren() do
		if c:GetAttribute("LiftStop") == level and c:FindFirstChild("DoorL") then
			return c
		end
	end
	return folder:FindFirstChild("Landing_" .. level)
end

-- Parts tagged LiftShaft never collide with the cabin.
local function claimShaft(office: Instance)
	local roots: { Instance } = {}
	for _, name in { "Core", "Lift", "Structure" } do
		local f = office:FindFirstChild(name)
		if f then
			table.insert(roots, f)
		end
	end
	if #roots == 0 then
		roots = { office }
	end
	for _, root in roots do
		for _, d in root:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("LiftShaft") == true then
				d.CollisionGroup = SHAFT_GROUP
			end
		end
	end
end

-- Safety net: anything collidable left inside the cabin's travel volume joins LiftShaft.
local function clearSweep(rec: Record, low: number, high: number)
	local c = Plan.CABIN
	local lo, hi = Plan.levelY(low) - 0.45, Plan.levelY(high) + c.height - 0.15
	local size = Vector3.new(c.x2 - c.x1 - 0.3, hi - lo, c.z2 - c.z1 - 0.3)
	local center = rec.cf * CFrame.new((c.x1 + c.x2) / 2, (lo + hi) / 2, (c.z1 + c.z2) / 2)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { rec.office }
	local ok, hits = pcall(function(): { BasePart }
		return workspace:GetPartBoundsInBox(center, size, params)
	end)
	if not ok or type(hits) ~= "table" then
		return
	end
	local moved: { string } = {}
	for _, p in hits do
		if p.CanCollide and p.CollisionGroup == "Default" and not p:IsDescendantOf(rec.cabin) and p ~= rec.guide then
			p.CollisionGroup = SHAFT_GROUP
			table.insert(moved, p:GetFullName())
		end
	end
	if #moved &gt; 0 then
		warnOnce("sweep" .. rec.ownerId, string.format("%d part(s) intruded into the lift shaft and no longer collide with the cabin: %s", #moved, table.concat(moved, ", ", 1, math.min(#moved, 5))))
	end
end

---------------------------------------------------------------------------- attach / detach

local function build(office: Instance): (Record?, string?)
	local folder = office:FindFirstChild("Lift")
	if not folder then
		return nil, "Lift folder missing"
	end
	local guide = folder:FindFirstChild("LiftGuide")
	local cabin = folder:FindFirstChild("LiftCabin")
	if not guide or not guide:IsA("BasePart") then
		return nil, "LiftGuide missing"
	end
	if not cabin or not cabin:IsA("Model") then
		return nil, "LiftCabin missing"
	end
	local floor = cabin:FindFirstChild("CabinFloor")
	if not floor or not floor:IsA("BasePart") then
		return nil, "CabinFloor missing"
	end
	local cf, tier, ownerId = office:GetAttribute("CampusCFrame"), office:GetAttribute("OfficeTier"), office:GetAttribute("OwnerUserId")
	if typeof(cf) ~= "CFrame" or typeof(tier) ~= "number" or typeof(ownerId) ~= "number" then
		return nil, "office attributes CampusCFrame/OfficeTier/OwnerUserId missing"
	end
	local leaves: { Leaf } = {}
	for _, name in { "CabinDoorL", "CabinDoorR" } do
		local leaf = child(cabin, name)
		local closed = if leaf then cframeAttr(leaf, "ClosedOffset") else nil
		local opened = if leaf then cframeAttr(leaf, "OpenOffset") else nil
		if not leaf or not closed or not opened then
			return nil, name .. " missing or without ClosedOffset/OpenOffset"
		end
		table.insert(leaves, { part = leaf, weld = nil, closed = closed, open = opened })
	end
	local stops = Plan.liftStops(tier)
	local landings: { [number]: Landing } = {}
	for _, stop in stops do
		local model = findLanding(folder, stop.level)
		local doorL, doorR = child(model, "DoorL"), child(model, "DoorR")
		if not model or not doorL or not doorR then
			return nil, "Landing_" .. stop.level .. " or its doors missing"
		end
		local closedL, openL = cframeAttr(doorL, "ClosedCFrame"), cframeAttr(doorL, "OpenCFrame")
		local closedR, openR = cframeAttr(doorR, "ClosedCFrame"), cframeAttr(doorR, "OpenCFrame")
		if not closedL or not openL or not closedR or not openR then
			return nil, "Landing_" .. stop.level .. " doors without ClosedCFrame/OpenCFrame"
		end
		local indicator = child(model, "Indicator")
		landings[stop.level] = {
			level = stop.level, doorL = doorL, doorR = doorR, closedL = closedL, openL = openL, closedR = closedR,
			openR = openR, labels = labelsOf(indicator), sound = indicator or doorL,
		}
	end

	-- Everything is present: take over the physics.
	ensureGroups()
	claimShaft(office)
	local oldAttachment = guide:FindFirstChild("LiftGuideAttachment")
	if oldAttachment then
		oldAttachment:Destroy()
	end
	local parts: { BasePart } = {}
	local isLeaf: { [BasePart]: boolean } = { [leaves[1].part] = true, [leaves[2].part] = true }
	for _, d in cabin:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		elseif d.Name == "LiftWeld" or d.Name == "LiftLeafWeld" or d.Name == "LiftPrismatic" or d.Name == "LiftFloorAttachment" then
			d:Destroy() -- leftovers of an earlier attach
		elseif d:IsA("WeldConstraint") then
			local p0, p1 = d.Part0, d.Part1
			if (p0 and not p0:IsDescendantOf(cabin)) or (p1 and not p1:IsDescendantOf(cabin)) then
				d:Destroy() -- would pin the cabin to the building
			end
		elseif d:IsA("JointInstance") then
			local p0, p1 = d.Part0, d.Part1
			if (p0 and not p0:IsDescendantOf(cabin)) or (p1 and not p1:IsDescendantOf(cabin)) then
				d:Destroy()
			end
		end
	end
	local joints: { Instance } = {}
	for _, p in parts do
		p.CollisionGroup = CABIN_GROUP
		p.CustomPhysicalProperties = LIGHT
		if p ~= floor and not isLeaf[p] then
			local w = Instance.new("WeldConstraint")
			w.Name = "LiftWeld"
			w.Part0 = floor
			w.Part1 = p
			w.Parent = p
			table.insert(joints, w)
		end
	end
	for _, leaf in leaves do
		local w = Instance.new("Weld")
		w.Name = "LiftLeafWeld"
		w.Part0 = floor
		w.Part1 = leaf.part
		w.C0 = leaf.closed
		w.C1 = CFrame.identity
		w.Parent = leaf.part
		leaf.weld = w
		leaf.part.CanCollide = true
		table.insert(joints, w)
	end

	-- Vertical prismatic axis (attachment X axis = building up); Attachment1 at the floor top centre.
	local up, look = cf.UpVector, cf.LookVector
	local lu = floor.CFrame:VectorToObjectSpace(up)
	local half = 0.5 * (math.abs(lu.X) * floor.Size.X + math.abs(lu.Y) * floor.Size.Y + math.abs(lu.Z) * floor.Size.Z)
	local top = floor.Position + up * half
	local disp = (top - guide.Position):Dot(up)
	local att0 = Instance.new("Attachment")
	att0.Name = "LiftGuideAttachment"
	att0.CFrame = guide.CFrame:ToObjectSpace(CFrame.fromMatrix(top - up * disp, up, look))
	att0.Parent = guide
	local att1 = Instance.new("Attachment")
	att1.Name = "LiftFloorAttachment"
	att1.CFrame = floor.CFrame:ToObjectSpace(CFrame.fromMatrix(top, up, look))
	att1.Parent = floor
	local topY = cf:PointToObjectSpace(top).Y
	local heights: { [number]: number } = {}
	local levels: { number } = {}
	local start, startD = stops[1].level, math.huge
	for _, stop in stops do
		heights[stop.level] = disp + (Plan.levelY(stop.level) - topY)
		table.insert(levels, stop.level)
		local d = math.abs(Plan.levelY(stop.level) - topY)
		if d &lt; startD then
			start, startD = stop.level, d
		end
	end
	local low, high = stops[1].level, stops[#stops].level
	local prismatic = Instance.new("PrismaticConstraint")
	prismatic.Name = "LiftPrismatic"
	prismatic.Attachment0 = att0
	prismatic.Attachment1 = att1
	prismatic.ActuatorType = Enum.ActuatorType.Servo
	prismatic.LimitsEnabled = true
	prismatic.LowerLimit = heights[low] - 0.5
	prismatic.UpperLimit = heights[high] + 0.5
	prismatic.Speed = Logic.VMAX + 1
	prismatic.LinearResponsiveness = 40
	prismatic.ServoMaxForce = 1e6
	prismatic.TargetPosition = disp
	prismatic.Parent = floor
	for _, p in parts do
		p.Anchored = false
	end
	local mass = 0
	pcall(function()
		mass = floor.AssemblyMass
	end)
	if mass &lt;= 0 then
		for _, p in parts do
			pcall(function()
				mass += p:GetMass()
			end)
		end
	end
	prismatic.ServoMaxForce = math.max(2e4, (mass + Plan.CABIN.capacity * RIDER_MASS) * workspace.Gravity * 4)

	local rec: Record = {
		office = office, cabin = cabin, floor = floor, guide = guide, display = child(cabin, "CabinDisplay"),
		prismatic = prismatic, att0 = att0, att1 = att1, joints = joints, leaves = leaves, cabinParts = parts,
		landings = landings, labels = labelsOf(child(cabin, "CabinDisplay")), cf = cf,
		topRel = floor.CFrame:ToObjectSpace(CFrame.new(top) * cf.Rotation), ownerId = ownerId, tier = tier,
		car = Logic.new(levels, heights, start, Plan.CABIN.capacity, disp), tickets = {}, tweens = {},
		doorLanding = nil, lastDoor = 0, lastTarget = disp, texts = {}, ownerSet = false,
		parented = office.Parent ~= nil, displayClock = math.huge, riders = 0, lastLevel = nil, lastState = nil,
	}
	for _, landing in landings do
		landing.doorL.CFrame = landing.closedL
		landing.doorR.CFrame = landing.closedR
		landing.doorL.CanCollide = true
		landing.doorR.CanCollide = true
	end
	if floor:IsDescendantOf(workspace) then
		rec.ownerSet = pcall(function()
			floor:SetNetworkOwner(nil)
		end)
	end
	clearSweep(rec, low, high)
	return rec, nil
end

-- Buildings without a lift (garage stage, plan tier 0: Plan.liftStops is empty) are not an error.
local function liftless(office: Instance): boolean
	local tier = office:GetAttribute("OfficeTier")
	return typeof(tier) == "number" and #Plan.liftStops(tier) == 0
end

function Lift.attach(office: Instance): boolean
	if typeof(office) ~= "Instance" then
		return false
	end
	if records[office] then
		return true
	end
	if liftless(office) then
		failed[office] = nil
		return false -- no lift in this building: nothing to attach, nothing to warn about
	end
	local ok, rec, reason = pcall(build, office)
	if ok and rec then
		records[office] = rec
		failed[office] = nil
		return true
	end
	failed[office] = true
	pcall(function() -- tell people at the landings instead of leaving stale texts
		local folder = office:FindFirstChild("Lift")
		if folder then
			for _, d in folder:GetDescendants() do
				if d:IsA("TextLabel") and d.Name == "Status" then
					d.Text = "Out of service"
				end
			end
		end
	end)
	local owner = office:GetAttribute("OwnerUserId")
	warnOnce("attach" .. tostring(owner) .. tostring(reason or rec), "lift not attached for office of " .. tostring(owner) .. ": " .. tostring(if ok then reason else rec))
	return false
end

local function stopTweens(rec: Record)
	for _, tween in rec.tweens do
		pcall(function()
			tween:Cancel()
		end)
	end
	table.clear(rec.tweens)
end

local function forget(rec: Record, reason: string)
	if records[rec.office] == rec then
		records[rec.office] = nil
	end
	stopTweens(rec)
	for t in rec.tickets do
		Logic.cancel(rec.car, t, reason)
		ticketHome[t] = nil
		t.target = nil
	end
	table.clear(rec.tickets)
	for player, w in wanted do
		if w.rec == rec then
			wanted[player] = nil
		end
	end
end

-- Emergency evacuation (rebuild or out-of-service cabin): the only place that teleports anyone.
local function evacuate(rec: Record)
	local level = Logic.nearestLevel(rec.car, rec.car.position)
	local frame = cabinFrame(rec)
	local slot = 0
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = rootOf(character)
		if character and root and insideFrame(frame, root.Position) then
			slot += 1
			character:PivotTo(rec.cf * CFrame.new(Plan.liftExitPoint(level, slot)))
		end
	end
end

-- Leave the cabin anchored where it is and remove our constraints, so a later attach starts clean.
local function release(rec: Record)
	for _, p in rec.cabinParts do
		if p.Parent then
			p.Anchored = true
		end
	end
	rec.prismatic:Destroy()
	rec.att0:Destroy()
	rec.att1:Destroy()
	for _, j in rec.joints do
		j:Destroy()
	end
end

function Lift.detach(office: Instance)
	failed[office] = nil
	local rec = records[office]
	if not rec then
		return
	end
	pcall(evacuate, rec)
	forget(rec, "detached")
	pcall(release, rec)
end

---------------------------------------------------------------------------- doors, displays, sounds

local function tweenTo(rec: Record, door: BasePart, goal: CFrame, seconds: number)
	if seconds &lt;= 0.02 then
		door.CFrame = goal
		return
	end
	local ok, tween = pcall(function(): Tween
		return TweenService:Create(door, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { CFrame = goal })
	end)
	if ok and tween then
		tween:Play()
		table.insert(rec.tweens, tween)
	else
		door.CFrame = goal
	end
end

local function shutLanding(rec: Record, level: number)
	local landing = rec.landings[level]
	if landing then
		landing.doorL.CFrame = landing.closedL
		landing.doorR.CFrame = landing.closedR
		landing.doorL.CanCollide = true
		landing.doorR.CanCollide = true
	end
end

-- Landing doors follow the cabin doors; they only ever move at the stop where the cabin stands.
local function moveLanding(rec: Record, opening: boolean)
	local level = rec.car.level
	local landing = rec.landings[level]
	stopTweens(rec)
	if rec.doorLanding and rec.doorLanding ~= level then
		shutLanding(rec, rec.doorLanding)
	end
	if not landing then
		return
	end
	rec.doorLanding = level
	local seconds = Logic.DOOR_TIME * (if opening then 1 - rec.car.door else rec.car.door)
	landing.doorL.CanCollide = false
	landing.doorR.CanCollide = false
	tweenTo(rec, landing.doorL, if opening then landing.openL else landing.closedL, seconds)
	tweenTo(rec, landing.doorR, if opening then landing.openR else landing.closedR, seconds)
end

local function leavesCollide(rec: Record, on: boolean)
	for _, leaf in rec.leaves do
		leaf.part.CanCollide = on
	end
end

local function play(part: Instance?, key: string)
	if part then
		pcall(Sound.play, part, key)
	end
end

local function onEvent(rec: Record, event: string)
	local landing = rec.landings[rec.car.level]
	if event == "doorsOpening" or event == "reopen" then
		leavesCollide(rec, false)
		moveLanding(rec, true)
		play(if landing then landing.doorL else nil, "liftDoor")
	elseif event == "doorsClosing" then
		moveLanding(rec, false)
		play(if landing then landing.doorL else nil, "liftDoor")
	elseif event == "closed" then
		stopTweens(rec)
		shutLanding(rec, rec.doorLanding or rec.car.level)
		rec.doorLanding = nil
		leavesCollide(rec, true)
	elseif event == "arrive" then
		play(if landing then landing.sound else nil, "liftChime")
		play(rec.display, "liftChime")
	elseif event == "stall" then
		warnOnce("stall" .. rec.ownerId, "cabin stalled for office of " .. rec.ownerId .. "; returning to the previous stop")
	elseif event == "outOfService" then
		warn("[Lift] cabin out of service for office of " .. rec.ownerId .. " (" .. tostring(rec.car.reason) .. "); evacuating riders")
		pcall(evacuate, rec) -- its tickets are failed now and get released after this step
	end
end

local function setText(rec: Record, label: TextLabel?, text: string)
	if label and rec.texts[label] ~= text then
		rec.texts[label] = text
		label.Text = text
	end
end

local function title(rec: Record, level: number): string
	return Plan.levelLabel(rec.tier, level) .. " · " .. Plan.levelName(rec.tier, level)
end

local function npcWaiting(car: Logic.Car, level: number): boolean
	for _, t in car.tickets do
		if t.state == "waiting" and t.fromLevel == level then
			return true
		end
	end
	return false
end

local function displays(rec: Record)
	local car = rec.car
	local moving = car.state == "MOVING"
	local shown = if moving then Logic.nearestLevel(car, car.position) else car.level
	local label = Plan.levelLabel(rec.tier, shown)
	local arrow = ARROWS[Logic.arrow(car)] or "•"
	local phase = Logic.doorPhase(car)
	local status
	if car.state == "OUT_OF_SERVICE" then
		status = "Out of service"
	elseif car.full then
		status = "FULL – please step out"
	elseif phase == "closing" then
		status = "Doors closing"
	elseif moving and car.target then
		status = title(rec, car.target)
	else
		status = title(rec, car.level)
	end
	setText(rec, rec.labels.level, label)
	setText(rec, rec.labels.arrow, arrow)
	setText(rec, rec.labels.status, status)
	for level, landing in rec.landings do
		local s
		if car.state == "OUT_OF_SERVICE" then
			s = "Out of service"
		elseif not moving and car.level == level and phase ~= "closed" then
			s = if car.full then "FULL" elseif phase == "closing" then "Doors closing" else title(rec, level)
		elseif car.hall[level] or npcWaiting(car, level) then
			s = "Lift called"
		else
			s = title(rec, level)
		end
		setText(rec, landing.labels.level, label)
		setText(rec, landing.labels.arrow, arrow)
		setText(rec, landing.labels.status, s)
	end
end

---------------------------------------------------------------------------- NPC targets

local function targetFor(rec: Record, t: Logic.Ticket, npc: Model?): Vector3?
	local s = t.state
	if s == "waiting" then
		return rec.cf:PointToWorldSpace(Plan.liftWaitPoint(t.fromLevel, t.waitSlot))
	elseif s ~= "board" and s ~= "riding" and s ~= "exit" then
		return nil
	end
	local frame = cabinFrame(rec)
	local slot = Plan.liftCabinSlot(t.slot or 1)
	local root = rootOf(npc)
	local v = if root then rec.cf:PointToObjectSpace(root.Position) else nil
	if s == "board" then
		if root and insideFrame(frame, root.Position) then
			return frame:PointToWorldSpace(slot)
		elseif v and math.abs(v.X) &lt;= 2 and v.Z &gt;= 49.5 then
			return frame:PointToWorldSpace(Vector3.new(0, 3, -2.5)) -- straight through the doorway
		end
		return rec.cf:PointToWorldSpace(Vector3.new(0, Plan.levelY(t.fromLevel) + 3, 50.5)) -- line up in front
	elseif s == "riding" then
		return frame:PointToWorldSpace(slot)
	end
	if v and v.Z &gt; 52.5 then
		return rec.cf:PointToWorldSpace(Vector3.new(0, Plan.levelY(t.toLevel) + 3, 51)) -- out through the doorway
	end
	return rec.cf:PointToWorldSpace(Plan.liftExitPoint(t.toLevel, t.slot or 1))
end

---------------------------------------------------------------------------- tick

local function eachNPC(rec: Record, fn: (Model, BasePart) -&gt; ())
	for _, name in { "Employees", "OperationsEmployees", "Visitors", "Assistant" } do
		local folder = rec.office:FindFirstChild(name)
		if folder then
			for _, npc in folder:GetChildren() do
				local root = rootOf(npc)
				if root and npc:IsA("Model") and aliveModel(npc) then
					fn(npc, root)
				end
			end
		end
	end
end

local function step(rec: Record, dt: number, people: { Person })
	if rec.floor.Parent == nil or (rec.parented and rec.office.Parent == nil) then
		return -- being torn down; the sweep forgets it
	end
	local car = rec.car
	local frame = cabinFrame(rec)
	local level = car.level
	local s = car.state
	local doorsBusy = s == "DOORS_OPENING" or s == "DOORS_OPEN" or s == "DOORS_CLOSING" or s == "REOPENING"
	local occupied, riders, waiting = false, 0, false
	local function observe(root: BasePart, isPlayer: boolean)
		local p = root.Position
		local inside = insideFrame(frame, p)
		if inside then
			riders += 1
		end
		local v = rec.cf:PointToObjectSpace(p)
		if doorsBusy and inBox(v, DOOR_ZONE, level, -1, 7) then
			occupied = true
		end
		if isPlayer and not inside and inBox(v, LOBBY, level, -2, 10) then
			waiting = true
		end
	end
	for _, person in people do
		observe(person.root, true)
	end
	if doorsBusy or next(rec.tickets) ~= nil then
		eachNPC(rec, function(_npc: Model, root: BasePart)
			observe(root, false)
		end)
	end
	rec.riders = riders
	for t, npc in rec.tickets do
		local root = rootOf(npc)
		local alive = npc.Parent ~= nil and root ~= nil and aliveModel(npc) and npc:IsDescendantOf(rec.office)
		t.alive = alive
		if alive and root then
			local p = root.Position
			local v = rec.cf:PointToObjectSpace(p)
			local y = Plan.levelY(t.fromLevel)
			t.inside = insideFrame(frame, p)
			t.zone = inBox(v, DOOR_ZONE, level, -1, 7)
			t.near = Vector3.new(v.X, 0, v.Z - Plan.LIFT_DOOR.z).Magnitude &lt;= NEAR_RANGE and v.Y &gt;= y - 2 and v.Y &lt;= y + 8
		end
	end

	Logic.step(car, dt, now, { position = rec.prismatic.CurrentPosition, occupied = occupied, riders = riders, playersWaiting = waiting })

	if car.cmd ~= rec.lastTarget then
		rec.lastTarget = car.cmd
		rec.prismatic.TargetPosition = car.cmd
	end
	if car.door ~= rec.lastDoor then
		rec.lastDoor = car.door
		for _, leaf in rec.leaves do
			if leaf.weld then
				leaf.weld.C0 = leaf.closed:Lerp(leaf.open, car.door)
			end
		end
	end
	local events = Logic.drain(car)
	for _, event in events do
		onEvent(rec, event)
	end
	for t, npc in rec.tickets do
		if t.state == "done" or t.state == "failed" then
			rec.tickets[t] = nil
			ticketHome[t] = nil
			t.target = nil
		else
			t.target = targetFor(rec, t, npc)
		end
	end
	-- destination picked at a landing becomes a car call once its player is aboard
	if car.state ~= "MOVING" then
		for player, w in wanted do
			if w.rec == rec then
				local root = rootOf(player.Character)
				if root and insideFrame(frame, root.Position) then
					wanted[player] = nil
					Lift.carCall(player, rec.office, w.level)
				end
			end
		end
	end
	rec.displayClock += dt
	if rec.displayClock &gt;= 0.2 or #events &gt; 0 then
		rec.displayClock = 0
		displays(rec)
	end
	if rec.lastLevel ~= car.level then
		rec.lastLevel = car.level
		rec.cabin:SetAttribute("CurrentLevel", car.level)
	end
	if rec.lastState ~= car.state then
		rec.lastState = car.state
		rec.cabin:SetAttribute("LiftState", car.state)
	end
end

local function geometricPosition(rec: Record): number
	return (rec.att1.WorldCFrame.Position - rec.att0.WorldCFrame.Position):Dot(rec.att0.WorldAxis)
end

local function sweep()
	for office, rec in records do
		if office.Parent ~= nil then
			rec.parented = true
		end
		local gone = (rec.parented and office.Parent == nil) or rec.floor.Parent == nil or not rec.floor:IsDescendantOf(office)
			or rec.guide.Parent == nil or rec.prismatic.Parent == nil
		if gone then
			forget(rec, "office removed")
		else
			if not rec.ownerSet and rec.floor:IsDescendantOf(workspace) then
				rec.ownerSet = pcall(function()
					rec.floor:SetNetworkOwner(nil)
				end)
			end
			-- diagnostics: the servo reading must agree with the cabin's real position
			local geometric = geometricPosition(rec)
			if math.abs(geometric - rec.prismatic.CurrentPosition) &gt; 1.5 and rec.prismatic.Active then
				warnOnce("position" .. rec.ownerId, string.format("servo CurrentPosition %.2f disagrees with the cabin geometry %.2f", rec.prismatic.CurrentPosition, geometric))
			end
		end
	end
	for office in failed do
		if office.Parent == nil then
			failed[office] = nil
		end
	end
	for player, w in wanted do
		if player.Parent == nil or w.expires &lt; now or records[w.rec.office] ~= w.rec then
			wanted[player] = nil
		end
	end
	for t, rec in ticketHome do
		if records[rec.office] ~= rec then
			ticketHome[t] = nil
			if t.state ~= "done" then
				t.state = "failed"
			end
			t.target = nil
		end
	end
end

local function heal()
	local ok, plot = pcall(function(): any
		return require(script.Parent.PlotService) :: any
	end)
	if not ok or type(plot) ~= "table" or type(plot.all) ~= "function" then
		return
	end
	local okAll, list = pcall(plot.all)
	if not okAll or type(list) ~= "table" then
		return
	end
	for _, p in list do
		local office = if type(p) == "table" then p.office else nil
		if typeof(office) == "Instance" and office.Parent ~= nil and not records[office] and not failed[office] then
			Lift.attach(office)
		end
	end
end

function Lift.tick(dt: number)
	if type(dt) ~= "number" or dt ~= dt or dt &lt;= 0 then
		return
	end
	dt = math.min(dt, 0.25)
	now += dt
	sweepClock += dt
	healClock += dt
	if sweepClock &gt;= 1 then
		sweepClock = 0
		pcall(sweep)
	end
	if healClock &gt;= 2 then
		healClock = 0
		pcall(heal)
	end
	local people: { Person } = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = rootOf(character)
		if character and root and aliveModel(character) then
			table.insert(people, { player = player, character = character :: Model, root = root })
		end
	end
	for _, rec in records do
		local ok, err = pcall(function(): any
			step(rec, dt, people)
			return nil
		end)
		if not ok then
			warnOnce("step" .. rec.ownerId .. tostring(err), "tick failed for office of " .. rec.ownerId .. ": " .. tostring(err))
		end
	end
end

function Lift.init(check: (Player, number) -&gt; boolean)
	authorize = check
	ensureGroups()
	if not initialized then
		initialized = true
		Players.PlayerRemoving:Connect(function(player: Player)
			wanted[player] = nil
		end)
	end
end

---------------------------------------------------------------------------- calls (players)

local function recordFor(office: Instance?): Record?
	if typeof(office) ~= "Instance" then
		return nil
	end
	local rec = records[office]
	if not rec and not failed[office] and office.Parent ~= nil and Lift.attach(office) then
		rec = records[office]
	end
	return rec
end

local function validLevel(rec: Record, level: any): boolean
	return type(level) == "number" and level == math.floor(level) and rec.car.heights[level] ~= nil
end

local function callError(err: string): string
	return if err == "OUT_OF_SERVICE" then "LIFT_OUT_OF_SERVICE" elseif err == "BAD_LEVEL" then "BAD_INPUT" else err
end

local function floorAllowed(rec: Record, player: Player, level: number): boolean
	local class = Plan.accessAt(rec.tier, Plan.liftExitPoint(level, 1))
	return Plan.playerAllows(player.UserId == rec.ownerId, authorize(player, rec.ownerId), class)
end

local function passenger(rec: Record, player: Player): boolean
	local root = rootOf(player.Character)
	return root ~= nil and insideFrame(cabinFrame(rec), root.Position)
end

local function hall(player: Player, office: Instance, level: number, quiet: boolean): (boolean, string?)
	local rec = recordFor(office)
	if not rec then
		return false, "LIFT_OUT_OF_SERVICE"
	end
	if not validLevel(rec, level) then
		return false, "BAD_INPUT"
	end
	if not authorize(player, rec.ownerId) then
		return false, "CARD_REQUIRED"
	end
	local ok, how = Logic.call(rec.car, "hall", level)
	if not ok then
		return false, callError(how)
	end
	if not quiet then
		notify(player, "LIFT_CALLED", { level = level, label = Plan.levelLabel(rec.tier, level), state = how })
	end
	return true, nil
end

-- Landing call button. Gives its own feedback (Notify LIFT_CALLED) on success.
function Lift.hallCall(player: Player, office: Instance, level: number): (boolean, string?)
	return hall(player, office, level, false)
end

-- Cabin panel. Opening the doors at the current stop is always allowed (egress).
function Lift.carCall(player: Player, office: Instance, level: number): (boolean, string?)
	local rec = recordFor(office)
	if not rec then
		return false, "LIFT_OUT_OF_SERVICE"
	end
	if not validLevel(rec, level) then
		return false, "BAD_INPUT"
	end
	if not passenger(rec, player) then
		return false, "LIFT_NOT_PASSENGER"
	end
	local car = rec.car
	if not (level == car.level and car.state ~= "MOVING") then
		if not authorize(player, rec.ownerId) then
			return false, "CARD_REQUIRED"
		end
		if not floorAllowed(rec, player, level) then
			return false, "LIFT_FLOOR_LOCKED"
		end
	end
	local ok, how = Logic.call(car, "car", level)
	if not ok then
		return false, callError(how)
	end
	return true, nil
end

function Lift.panel(player: Player, office: Instance): { [string]: any }
	local rec = recordFor(office)
	if not rec then
		local owner = if typeof(office) == "Instance" then office:GetAttribute("OwnerUserId") else nil
		return { ownerId = owner, current = 0, passenger = false, outOfService = true, stops = {} }
	end
	local car = rec.car
	local inside = passenger(rec, player)
	local card = authorize(player, rec.ownerId)
	local stops = {}
	for _, stop in Plan.liftStops(rec.tier) do
		local here = inside and stop.level == car.level and car.state ~= "MOVING"
		table.insert(stops, {
			level = stop.level, label = stop.label, name = stop.name,
			allowed = here or (card and floorAllowed(rec, player, stop.level)),
		})
	end
	return {
		ownerId = rec.ownerId, current = car.level, passenger = inside, state = car.state,
		outOfService = car.state == "OUT_OF_SERVICE", stops = stops,
	}
end

function Lift.isPassenger(office: Instance, character: Model?): boolean
	local rec = records[office]
	local root = rootOf(character)
	return rec ~= nil and root ~= nil and insideFrame(cabinFrame(rec), root.Position)
end

-- Accepts a character (or a Player for older callers).
function Lift.riding(who: Instance?): boolean
	local character: Instance? = who
	if who and who:IsA("Player") then
		character = who.Character
	end
	local root = rootOf(character)
	if not root then
		return false
	end
	for _, rec in records do
		if insideFrame(cabinFrame(rec), root.Position) then
			return true
		end
	end
	return false
end

-- RemoteFunction "UseCampusLift" {ownerId, floor}: car call for riders of that owner's cabin,
-- otherwise a hall call at the landing the player stands at (the floor is remembered and sent as
-- a car call when the player boards).
function Lift.remote(session: any, payload: any): { [string]: any }
	local player = if type(session) == "table" then session.player else nil
	if typeof(player) ~= "Instance" or not player:IsA("Player") or type(payload) ~= "table" then
		return { ok = false, err = "BAD_INPUT" }
	end
	local ownerId, floor = payload.ownerId, payload.floor
	if type(ownerId) ~= "number" or type(floor) ~= "number" or ownerId ~= math.floor(ownerId) or floor ~= math.floor(floor) then
		return { ok = false, err = "BAD_INPUT" }
	end
	local rec: Record? = nil
	for _, r in records do
		if r.ownerId == ownerId then
			rec = r
			break
		end
	end
	if not rec then
		for office in failed do
			if office:GetAttribute("OwnerUserId") == ownerId then
				return { ok = false, err = "LIFT_OUT_OF_SERVICE" }
			end
		end
		return { ok = false, err = "PLAYER_OFFLINE" }
	end
	if not validLevel(rec, floor) then
		return { ok = false, err = "BAD_INPUT" }
	end
	local character = player.Character
	local root = rootOf(character)
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not humanoid then
		return { ok = false, err = "LOADING" }
	end
	if humanoid.SeatPart then
		return { ok = false, err = "LIFT_SEATED" }
	end
	if passenger(rec, player) then
		local ok, err = Lift.carCall(player, rec.office, floor)
		return { ok = ok, err = err, kind = "car", level = floor }
	end
	local best: Landing? = nil
	local bestD = LANDING_RANGE
	for _, landing in rec.landings do
		local d = (root.Position - (landing.closedL.Position + landing.closedR.Position) / 2).Magnitude
		if d &lt;= bestD then
			best, bestD = landing, d
		end
	end
	if not best then
		return { ok = false, err = "LIFT_NO_LANDING" }
	end
	local ok, err = hall(player, rec.office, best.level, true)
	if not ok then
		return { ok = false, err = err }
	end
	if floor ~= best.level then
		wanted[player] = { rec = rec, level = floor, expires = now + 60 }
	end
	return { ok = true, kind = "hall", level = best.level, floor = floor }
end

---------------------------------------------------------------------------- NPC tickets

-- Ticket for an employee NPC; nil when the lift is unavailable or the destination is not allowed.
-- The NPC walks to ticket.target: wait point (waiting), doorway then a cabin slot (board), stays
-- (riding), exit point (exit); "done" = continue the route, "failed" = take the stairs.
function Lift.npcCall(office: Instance, npc: Model, fromLevel: number, toLevel: number): Logic.Ticket?
	local rec = recordFor(office)
	if not rec or typeof(npc) ~= "Instance" or not npc:IsA("Model") or not npc:IsDescendantOf(rec.office) then
		return nil
	end
	if not rootOf(npc) or not aliveModel(npc) then
		return nil
	end
	if not validLevel(rec, fromLevel) or not validLevel(rec, toLevel) or fromLevel == toLevel then
		return nil
	end
	local role = npc:GetAttribute("RoleId")
	if not Plan.employeeAllowed(if type(role) == "string" then role else "support", rec.tier, Plan.liftExitPoint(toLevel, 1)) then
		return nil
	end
	for t, other in rec.tickets do
		if other == npc then
			if t.fromLevel == fromLevel and t.toLevel == toLevel and t.state ~= "done" and t.state ~= "failed" then
				return t
			end
			rec.tickets[t] = nil
			ticketHome[t] = nil
			Logic.cancel(rec.car, t, "replaced")
			t.target = nil
		end
	end
	local t = Logic.addTicket(rec.car, fromLevel, toLevel, now)
	if not t then
		return nil
	end
	rec.tickets[t] = npc
	ticketHome[t] = rec
	t.target = targetFor(rec, t, npc)
	return t
end

function Lift.npcTicket(ticket: Logic.Ticket): Logic.Ticket
	local rec = ticketHome[ticket]
	if not rec then
		if ticket.state ~= "done" and ticket.state ~= "failed" then
			ticket.state = "failed"
		end
		ticket.target = nil
		return ticket
	end
	ticket.target = targetFor(rec, ticket, rec.tickets[ticket])
	return ticket
end

function Lift.npcCancel(ticket: Logic.Ticket)
	local rec = ticketHome[ticket]
	ticketHome[ticket] = nil
	if rec then
		rec.tickets[ticket] = nil
		Logic.cancel(rec.car, ticket, "cancelled")
	end
	ticket.target = nil
end

-- Deprecated teleport-era entry point: always declines, so old callers fall back to the stairs.
function Lift.requestEmployee(_office: Instance, _cf: CFrame, _npc: Model, _source: number, _destination: number): boolean
	return false
end

---------------------------------------------------------------------------- diagnostics

function Lift.inspect(office: Instance): { [string]: any }
	local rec = records[office]
	if not rec then
		return { attached = false, failed = failed[office] == true, none = liftless(office) }
	end
	local car = rec.car
	local hallCalls, carCalls = {}, {}
	for level in car.hall do
		table.insert(hallCalls, level)
	end
	for level in car.car do
		table.insert(carCalls, level)
	end
	table.sort(hallCalls)
	table.sort(carCalls)
	local states: { [string]: number } = {}
	for _, t in car.tickets do
		states[t.state] = (states[t.state] or 0) + 1
	end
	return {
		attached = true, state = car.state, level = car.level, label = Plan.levelLabel(rec.tier, car.level),
		target = car.target, direction = car.direction, door = Logic.doorPhase(car), doorAlpha = car.door,
		position = car.position, geometric = geometricPosition(rec), command = car.cmd, velocity = car.vel, queue = { hall = hallCalls, car = carCalls },
		riders = rec.riders, capacity = car.capacity, full = car.full, tickets = #car.tickets, ticketStates = states,
		reason = car.reason, networkOwner = if rec.ownerSet then "server" else "pending",
	}
end

return Lift
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000023"><Properties><string name="Name">HeadquartersDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Builds one company headquarters from the shared BuildingPlan. Generators only create geometry,
-- furniture and registration data; doors, the lift, access and work are driven by services.
-- Plan tier 0 (garage stage) runs the same pipeline without the core and the HQ room kits: the
-- exterior builds the converted garage and the construction site, RoomKitsGarage furnishes it.
-- Tiers with Plan.hasHotel also get the guest house (RoomKitsHotel furnishes its rooms).
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout=require(ReplicatedStorage.Shared.BuildingLayout)
local Palette=require(ReplicatedStorage.Shared.Config.ArchPalette)
-- Generators are loaded defensively so one missing/broken module is reported instead of
-- preventing every company from getting a building.
local function load(name: string): any
	local module=script.Parent:FindFirstChild(name)
	if not module then warn(`[HQ] generator {name} missing`);return nil end
	local ok,result=pcall(require,module)
	if not ok then warn(`[HQ] generator {name} failed to load: {result}`);return nil end
	return result
end
local Kit=load("ArchKit")
local Exterior=load("ExteriorDesign")
local Core=load("CoreDesign")
local Interior=load("InteriorDesign")
local KitsWork=load("RoomKitsWork")
local KitsSpecial=load("RoomKitsSpecial")
local KitsPavilion=load("RoomKitsPavilion")
local KitsHotel=load("RoomKitsHotel")
local KitsGarage=load("RoomKitsGarage")
local StaffAssignment=load("StaffAssignment")
local Design={}
local FOLDERS={"Structure","Facade","Site","Core","Lift","Walls","Doors","Rooms","Circulation","Cameras","Navigation","SharedWorkstations","Blades"}

function Design.staff(office: Model,cf: CFrame,session: any)
	if StaffAssignment then StaffAssignment.assign(office,cf,session) end
end

local function step(label: string,fn: ()-&gt;())
	-- One generator failing must not leave a half-registered office without telling us why.
	local ok,err=pcall(fn :: ()-&gt;any)
	if not ok then warn(`[HQ] {label} failed: {err}`) end
end

-- Plan tier this session's office builds: an explicit session.planTier (admin "tier0" test command,
-- harness; not saved) wins, else the office index through Plan.tierForOffice.
function Design.tierFor(session: any): number
	local forced=session.planTier
	if typeof(forced)=="number" and forced==forced then return Plan.clampTier(forced) end
	local office=if session.data and session.data.empire then session.data.empire.office else nil
	return Plan.tierForOffice(if typeof(office)=="number" then office else 1)
end

function Design.build(cf: CFrame,session: any,accent: Color3): Model
	local tier=Design.tierFor(session)
	local floors=Plan.floors(tier);local owner=session.userId
	local office=Instance.new("Model");office.Name="Office"
	office:SetAttribute("OwnerUserId",owner);office:SetAttribute("OfficeTier",tier);office:SetAttribute("FloorCount",floors)
	office:SetAttribute("CampusCFrame",cf);office:SetAttribute("FacilitiesVersion",3)
	if tier&lt;1 then office:SetAttribute("GarageStage",true) end
	if Plan.hasHotel(tier) then office:SetAttribute("HotelRooms",Plan.HOTEL_ROOMS) end
	local folders={}
	for _,name in FOLDERS do local f=Instance.new("Folder");f.Name=name;f.Parent=office;folders[name]=f end
	local company=if session.data.company then session.data.company.name else (session.player.DisplayName.."'s Company")
	local ctx={office=office,cf=cf,tier=tier,floors=floors,owner=owner,session=session,accent=accent,company=company,
		ownerName=session.player.DisplayName,plan=Plan,layout=Layout,kit=Kit,palette=Palette,folders=folders,rooms={}}
	local generators: { { label: string, module: any } }
	if tier&lt;1 then
		generators={{label="exterior",module=Exterior},{label="interior",module=Interior},{label="garage lab",module=KitsGarage}}
	else
		generators={{label="exterior",module=Exterior},{label="core",module=Core},{label="interior",module=Interior},
			{label="work rooms",module=KitsWork},{label="ground &amp; garage rooms",module=KitsSpecial},{label="pavilion &amp; roof rooms",module=KitsPavilion}}
		if Plan.hasHotel(tier) then table.insert(generators,{label="guest house",module=KitsHotel}) end
	end
	for _,def in generators do
		local generator=def.module
		if generator then step(def.label,function() generator.build(ctx) end) end
	end
	step("staff",function() Design.staff(office,cf,session) end)
	return office
end
return Design
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000024"><Properties><string name="Name">FacilityService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Card authority, door access rules, facility prompts (doors, lift, fixtures, founder terminals),
-- shop economy and real consumable snack tools.
--
-- Security model: doors are the primary barrier (DoorService asks authorizeDoor below for every
-- entry from the non-secure side; leaving is always possible). The access guard in Facility.tick is
-- only the fallback for what a door cannot stop — tailgating through a speed gate or behind the
-- founder, glitching through geometry, a guest card expiring while its holder is inside. It
-- relocates players, it never traps. Public rooms (reception hall, visitor lounge, showroom, café)
-- are open to visitors without a card (BuildingPlan.playerAllows).
--
-- Props and fixtures never move on the server: every prompt writes one state attribute (FxUntil /
-- FxState, design/PROPFX_CONTRACT.md) and the client animates (water, flush, steam, belts, flywheels,
-- printers, lockers, chargers, robot arms ...). Generic player prop action: CampusAction "prop".
local Collection=game:GetService("CollectionService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Prompts=game:GetService("ProximityPromptService")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout=require(ReplicatedStorage.Shared.BuildingLayout)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Lift=require(script.Parent.LiftService)
local Doors=require(script.Parent.DoorService)
local Sound=require(script.Parent.CampusSoundService)
local Facility={}
local cards: {[Instance]:any}={}
local snackTools: {[Instance]:any}={}
local guests: {[number]:{[number]:number}}={}
local connections: {[Player]:RBXScriptConnection}={}
local guardClock=0
local routines: {[Player]:any}={}
local propCooldown: {[Instance]:number}=setmetatable({},{__mode="k"}) :: any
local FX_TAG="PropFx"
local promptTimes: {[Player]:number}={}
local routineCooldown: {[Player]:number}={}
local speedApplied: {[Player]:{humanoid:Humanoid,value:number}}={}
local toiletSeats: {[Seat]:number}={} -- seats enabled for a player; re-disabled once empty
local CARD_TEXT="Access denied. You need a valid card for this company."
local BADGE_TEXT="Badge required — ask for a guest card at reception."
local VISITOR_TEXT="This area needs a company or guest card. Visitors are welcome in the reception hall, showroom and café."
local DENY: {[string]:string}={
	founder="Founder-only room. Your employee or guest pass does not open it.",
	research="Research clearance required. Guest cards stop at the lab door.",
	compute="Compute clearance required. The compute room is closed to guests.",
	technical="Technical staff only. This service area is closed to guests.",
	guest="Hotel rooms are for guests.",
}
-- Hidden doors answer non-founders neutrally so they do not give themselves away.
local HIDDEN_DENY: {[string]:string}={
	bookcase="Just a bookcase full of old binders.",
	flush="Just a timber wall panel.",
	vault="Model vault · founder biometrics required.",
}
-- LiftService answers with codes; the landing button shows them as short notices.
local LIFT_TEXT: {[string]:string}={
	CARD_REQUIRED="The lift needs a company or guest card.",
	LIFT_OUT_OF_SERVICE="The lift is out of service right now.",
	LIFT_FLOOR_LOCKED="That floor is not on your card.",
}
local FOUNDER_ACTIONS: {[string]:string}={
	security="Camera control belongs to the campus founder.",
	ownerComputer="This terminal belongs to the founder.",
	report="Company reports are printed for the founder only.",
	modelSafe="The model safe opens for the founder only.",
	fleet="The fleet desk is managed by the founder.",
}
local function notify(player: Player,text: string,kind: string?)
	Remote.fire(player,"Notify",kind or "CAMPUS_NOTICE",{text=text})
end
local function backpack(player: Player): Instance?
	return player:FindFirstChildOfClass("Backpack")
end
local function carried(player: Player,tool: Instance): boolean
	return tool.Parent~=nil and (tool.Parent==backpack(player) or tool.Parent==player.Character)
end
function Facility.hasCard(player: Player,owner: number,executive: boolean?): boolean
	for tool,record in cards do
		if record.holder==player and record.owner==owner and carried(player,tool) and (record.expires==0 or record.expires&gt;os.time()) then
			if not executive or player.UserId==owner then return true end
		end
	end
	return false
end
function Facility.issueCard(player: Player,owner: number,expires: number?): boolean
	local bag=backpack(player);if not bag then return false end
	for tool,record in cards do if record.holder==player and record.owner==owner then tool:Destroy();cards[tool]=nil end end
	local tool=Instance.new("Tool");tool.Name=if owner==player.UserId then "Employee Card" else "Guest Card";tool.CanBeDropped=false;tool.ToolTip="Scan at the door reader. Carry in your backpack or hand."
	local handle=Instance.new("Part");handle.Name="Handle";handle.Size=Vector3.new(1.6,.12,1);handle.Color=Color3.fromRGB(225,222,205);handle.CanCollide=false;handle.Massless=true;handle.Parent=tool
	local stripe=Instance.new("Part");stripe.Name="CardStripe";stripe.Size=Vector3.new(1.6,.02,.24);stripe.CFrame=handle.CFrame*CFrame.new(0,.08,.25);stripe.Color=Color3.fromRGB(82,110,85);stripe.CanCollide=false;stripe.Massless=true;stripe.Parent=tool
	local weld=Instance.new("WeldConstraint");weld.Part0=handle;weld.Part1=stripe;weld.Parent=handle
	tool:SetAttribute("CardOwner",owner);tool:SetAttribute("CardHolder",player.UserId)
	cards[tool]={holder=player,owner=owner,expires=expires or 0};tool.Parent=bag
	return true
end
local function rootOf(player: Player): BasePart?
	local character=player.Character
	local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end
local function humanoidOf(player: Player): Humanoid?
	local character=player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end
local function nearby(player: Player,p: BasePart,maxDistance: number): boolean
	local root=rootOf(player);return root~=nil and (root.Position-p.Position).Magnitude&lt;=maxDistance
end
local function ownerSession(owner: number): any
	for _,s in Session.all() do if s.userId==owner and not s.closed then return s end end
	return nil
end
-- Stand a humanoid up, including the engine's SeatWeld so a following PivotTo is not pulled back.
local function unseat(h: Humanoid?)
	if not h then return end
	local seat=h.SeatPart
	if seat then local weld=seat:FindFirstChild("SeatWeld");if weld then weld:Destroy() end end
	h.Sit=false
end

-- Door authorizer -------------------------------------------------------------------------------
-- Entry from the non-secure side: founder always; company/guest card holders by access class.
local function authorizeDoor(player: Player,office: Model,door: Model): (boolean,string?)
	local owner=office:GetAttribute("OwnerUserId")
	if typeof(owner)~="number" then return false,"Door offline." end
	if player.UserId==owner then return true,nil end
	local classAttr=door:GetAttribute("AccessClass");local class=if typeof(classAttr)=="string" then classAttr else "staff"
	local card=Facility.hasCard(player,owner)
	if Plan.playerAllows(false,card,class) then return true,nil end
	local kind=door:GetAttribute("DoorKind")
	if typeof(kind)=="string" and HIDDEN_DENY[kind] then return false,HIDDEN_DENY[kind] end
	if door:GetAttribute("Hidden")==true then return false,"Nothing happens." end
	if not card then return false,if kind=="speedgate" then BADGE_TEXT else CARD_TEXT end
	return false,DENY[class] or "Access denied."
end

-- PropFx state writes (the client animates) --------------------------------------------------------
local function serverNow(): number return workspace:GetServerTimeNow() end
-- Tagged prop root of `inst`: itself or the nearest tagged ancestor below the office.
local function propRoot(inst: Instance?): Instance?
	local node=inst
	while node and node.Name~="Office" do
		if Collection:HasTag(node,FX_TAG) then return node end
		node=node.Parent
	end
	return nil
end
-- PropFx root by PropId inside one office (prompts beside their prop, e.g. a robot arm's controller).
local propIndex: {[Instance]:{[string]:Instance}}=setmetatable({},{__mode="k"}) :: any
local function propById(office: Instance,id: any): Instance?
	if typeof(id)~="string" then return nil end
	local map=propIndex[office]
	local cached=if map then map[id] else nil
	if map and (cached==nil or cached.Parent) then return cached end
	local fresh: {[string]:Instance}={}
	for _,root in Collection:GetTagged(FX_TAG) do
		local pid=root:GetAttribute("PropId")
		if typeof(pid)=="string" and root:IsDescendantOf(office) then fresh[pid]=root end
	end
	propIndex[office]=fresh
	return fresh[id]
end
-- Works for `seconds` from now (&lt;= 0 stops it). One attribute write.
local function run(root: Instance?,seconds: number)
	if root then root:SetAttribute("FxUntil",if seconds&gt;0 then serverNow()+seconds else 0) end
end
local function running(root: Instance?): boolean
	local untilTime=if root then root:GetAttribute("FxUntil") else nil
	return typeof(untilTime)=="number" and untilTime&gt;serverNow()
end

-- Fixture index (SPEC §6 FixtureKey contract), built once per office instance -----------------
type FixtureIndex={byKey:{[string]:{[string]:BasePart}},named:{[string]:{BasePart}},machines:{[string]:{Instance}}}
local FIXTURE_NAMES: {[string]:boolean}={ToiletSeat=true,FlushButton=true,ToiletWater=true,Tap=true,TapWater=true,ShowerHead=true,ShowerWater=true,SaunaHeater=true}
local fixtureCache: {[Instance]:FixtureIndex}=setmetatable({},{__mode="k"}) :: any
local function fixtures(office: Instance): FixtureIndex
	local cached=fixtureCache[office];if cached then return cached end
	local index: FixtureIndex={byKey={},named={},machines={}}
	for _,d in office:GetDescendants() do
		if not d:IsA("BasePart") then continue end
		if FIXTURE_NAMES[d.Name] then
			local list=index.named[d.Name];if not list then list={};index.named[d.Name]=list end;table.insert(list,d)
			local key=d:GetAttribute("FixtureKey")
			if key~=nil then local map=index.byKey[d.Name];if not map then map={};index.byKey[d.Name]=map end;map[tostring(key)]=d end
		end
	end
	-- workout machines: PropFx roots carrying Machine = &lt;prompt Value&gt; (belts, flywheels, rower fans)
	for _,root in Collection:GetTagged(FX_TAG) do
		local machine=root:GetAttribute("Machine")
		if machine~=nil and root:IsDescendantOf(office) then
			local list=index.machines[tostring(machine)];if not list then list={};index.machines[tostring(machine)]=list end;table.insert(list,root)
		end
	end
	fixtureCache[office]=index;return index
end
local function fixtureFor(office: Instance,name: string,key: any): BasePart?
	if key==nil then return nil end
	local map=fixtures(office).byKey[name];local part=if map then map[tostring(key)] else nil
	return if part and part.Parent then part else nil
end
local function nearestNamed(office: Instance,name: string,position: Vector3,maxDistance: number): BasePart?
	local best: BasePart?=nil;local distance=maxDistance
	local list=fixtures(office).named[name];if not list then return nil end
	for _,part in list do
		if part.Parent and (part.Position-position).Magnitude&lt;distance then best=part;distance=(part.Position-position).Magnitude end
	end
	return best
end

-- Snacks, guests, retail (unchanged economy) ---------------------------------------------------
local function consume(player: Player,tool: Instance)
	local record=snackTools[tool];local s=Session.get(player)
	if not record or record.holder~=player or not s or s.closed or not carried(player,tool) then return end
	local c=s.data.empire.campus;local n=c.snacks[record.id] or 0;if n&lt;1 then return end
	snackTools[tool]=nil;c.snacks[record.id]=n-1
	local def=Config.find(Config.SNACKS,record.id);c.boostUntil=os.time()+def.seconds;c.boostSpeed=def.speed
	tool:Destroy();Session.markDirty(s);notify(player,def.name.." enjoyed. Walk speed "..def.speed.." for "..def.seconds.."s.")
end
local function issueSnack(s: any,id: string)
	local bag=backpack(s.player);if not bag or s.closed then return end
	local def=Config.find(Config.SNACKS,id);if not def then return end
	local tool=Instance.new("Tool");tool.Name=def.name;tool.CanBeDropped=false;tool.ToolTip="Equip, then click or tap to eat."
	local handle=Instance.new("Part");handle.Name="Handle";handle.Size=if def.shape=="cup" then Vector3.new(.9,1.3,.9) else Vector3.new(1.7,.5,1)
	handle.Color=Color3.fromRGB(unpack(def.color));handle.Massless=true;handle.CanCollide=false;handle.Parent=tool
	snackTools[tool]={holder=s.player,id=id};tool.Activated:Connect(function()consume(s.player,tool)end);tool.Parent=bag
end
local function restore(s: any)
	if s.closed or not s.player.Parent then return end
	Facility.issueCard(s.player,s.userId)
	for owner,list in guests do if list[s.userId] and list[s.userId]&gt;os.time() then Facility.issueCard(s.player,owner,list[s.userId]) end end
	for tool,record in snackTools do if record.holder==s.player then tool:Destroy();snackTools[tool]=nil end end
	for id,count in s.data.empire.campus.snacks do for _=1,count do issueSnack(s,id) end end
end
local function buySnack(s: any,p: any): any
	local def=Config.find(Config.SNACKS,p.snackId);if not def then return {ok=false,err="BAD_INPUT"} end
	local c=s.data.empire.campus;local total=0;for _,count in c.snacks do total+=count end
	if total&gt;=16 then return {ok=false,err="SNACK_FULL"} end
	local delivery=if p.atCounter==true then 0 else 15
	-- atCounter is only accepted from the server prompt route, never from remote payloads.
	if not Economy.spend(s,def.price+delivery,"campus") then return {ok=false,err="NO_MONEY"} end
	c.snacks[def.id]=(c.snacks[def.id] or 0)+1;issueSnack(s,def.id)
	local seller=if delivery==0 and typeof(p.shopOwnerId)=="number" then ownerSession(p.shopOwnerId) else nil
	if seller and seller~=s then
		local net=def.price*.55;Economy.grant(seller,net,"retail");seller.data.empire.campus.retailRevenue+=net;seller.data.empire.campus.retailSales+=1;Session.markDirty(seller)
	end
	Session.markDirty(s);return {ok=true}
end
-- A snack brought by staff (the founder's assistant's coffee run): joins the 16-slot snack bag as
-- the same real tool a counter purchase gives. The company pays the menu price here unless the order
-- already paid it (prepaid). false = unknown snack, bag full, closed session or not enough money.
function Facility.deliverSnack(s: any,snackId: string,prepaid: boolean?): boolean
	local def=Config.find(Config.SNACKS,snackId);if not def or s.closed then return false end
	local c=s.data.empire.campus;local total=0;for _,count in c.snacks do total+=count end
	if total&gt;=16 then return false end
	if not prepaid and not Economy.spend(s,def.price,"campus") then return false end
	c.snacks[def.id]=(c.snacks[def.id] or 0)+1;issueSnack(s,def.id)
	Session.markDirty(s);return true
end
local function grantGuest(s: any,p: any): any
	if typeof(p.userId)~="number" or p.userId~=math.floor(p.userId) or p.userId==s.userId then return {ok=false,err="BAD_INPUT"} end
	local peer=ownerSession(p.userId);if not peer then return {ok=false,err="PLAYER_OFFLINE"} end
	guests[s.userId]=guests[s.userId] or {};guests[s.userId][p.userId]=os.time()+3600
	Facility.issueCard(peer.player,s.userId,guests[s.userId][p.userId]);notify(peer.player,s.player.DisplayName.." gave you a one-hour guest card. Founder rooms and technical labs stay private.")
	Session.markDirty(s);return {ok=true}
end
local function revokeGuest(s: any,p: any): any
	if typeof(p.userId)~="number" then return {ok=false,err="BAD_INPUT"} end
	if guests[s.userId] then guests[s.userId][p.userId]=nil end
	for tool,record in cards do if record.owner==s.userId and record.holder.UserId==p.userId then tool:Destroy();cards[tool]=nil end end
	Session.markDirty(s);return {ok=true}
end
local function upgradeRetail(s: any,_p: any): any
	local c=s.data.empire.campus;local cost=Config.RETAIL[c.retailLevel];if not cost then return {ok=false,err="MAX_RETAIL"} end
	if not Economy.spend(s,cost,"campus") then return {ok=false,err="NO_MONEY"} end
	c.retailLevel+=1;Session.markDirty(s);return {ok=true}
end

-- Security cameras: channels come from Office.Cameras (SPEC §6); founder only.
local function openSecurity(s: any,payload: any): any
	if payload.ownerId~=nil and payload.ownerId~=s.userId then return {ok=false,err="OWNER_ONLY"} end
	local p=Plot.get(s.player)
	if not p or not p.office then return {ok=false,err="LOADING"} end
	if not Facility.hasCard(s.player,s.userId,true) then return {ok=false,err="CARD_REQUIRED"} end
	local channels={}
	local folder=p.office:FindFirstChild("Cameras")
	if folder then for _,c in folder:GetDescendants() do
		local id=c:GetAttribute("CameraId");local view=c:GetAttribute("ViewCFrame")
		if c:IsA("BasePart") and id~=nil and typeof(view)=="CFrame" then
			local name=c:GetAttribute("CameraName");local level=c:GetAttribute("Level")
			table.insert(channels,{id=tostring(id),name=if typeof(name)=="string" then name else tostring(id),cframe=view,level=if typeof(level)=="number" then level else 0,room=c:GetAttribute("RoomId"),private=c:GetAttribute("Private")==true})
		end
	end end
	table.sort(channels,function(a,b)if a.level~=b.level then return a.level&lt;b.level end;return a.name&lt;b.name end)
	return {ok=true,ownerId=s.userId,channels=channels}
end

-- Internal employee route: identity comes from the current server-built office, never a payload.
function Facility.openEmployeeDoor(npc: Model,door: Instance): boolean
	if not door:IsA("Model") then return false end
	return Doors.requestNPC(npc,door)
end

-- Prompt actions --------------------------------------------------------------------------------
type Ctx={s:any,player:Player,q:ProximityPrompt,part:BasePart,office:Model,owner:number,plot:any,humanoid:Humanoid?}

local function doorOf(q: ProximityPrompt,office: Model): Model?
	local node: Instance?=q.Parent
	while node and node~=office do
		if node:IsA("Model") and node:GetAttribute("DoorId")~=nil then return node end
		node=node.Parent
	end
	local value=q:GetAttribute("Value")
	return if value~=nil then Doors.find(office,tostring(value)) else nil
end
local function useDoor(ctx: Ctx)
	local door=doorOf(ctx.q,ctx.office);if not door then return end
	local sideAttr=ctx.q:GetAttribute("Side")
	local ok,reason=Doors.request(ctx.player,door,if typeof(sideAttr)=="string" then sideAttr else nil)
	if not ok and reason then notify(ctx.player,if reason=="Occupied" then "Occupied. Please use another cubicle." else reason) end
end
local function toilet(ctx: Ctx)
	local p,h=ctx.part,ctx.humanoid
	local seat: Seat?=if p:IsA("Seat") then p else nil
	if not seat then local found=fixtureFor(ctx.office,"ToiletSeat",p:GetAttribute("FixtureKey"));if found and found:IsA("Seat") then seat=found end end
	if not h or not seat then return end
	if seat.Occupant and seat.Occupant~=h then notify(ctx.player,"This cubicle is occupied.");return end
	if h.SeatPart==seat then h.Sit=false;seat.Disabled=true;toiletSeats[seat]=nil
	else seat.Disabled=false;seat:Sit(h);toiletSeats[seat]=os.clock()+1.5 end
end
local function flush(ctx: Ctx)
	local p=ctx.part;Sound.play(p,"flush")
	local water=fixtureFor(ctx.office,"ToiletWater",p:GetAttribute("FixtureKey"));if not water then return end
	run(propRoot(water) or water,2) -- the client dips the water level for 2 s (PropFx flow)
	notify(ctx.player,"Toilet flushed.")
end
local function water(ctx: Ctx,action: string)
	local w=fixtureFor(ctx.office,if action=="tap" then "TapWater" else "ShowerWater",ctx.part:GetAttribute("FixtureKey"));if not w then return end
	local root=propRoot(w) or w
	-- a second press stops the water; otherwise it runs 6 s (tap) / 15 s (shower) on the client
	if running(root) then run(root,0) else run(root,if action=="tap" then 6 else 15) end
end
-- Wellness station (WorkstationService) linked to a machine root by FxStation, if any.
local function machineStation(office: Model,root: Instance): Instance?
	local id=root:GetAttribute("FxStation")
	if typeof(id)~="string" then return nil end
	local found=office:FindFirstChild(id,true)
	return if found and found:GetAttribute("WorkstationId")==id then found else nil
end
local function routine(ctx: Ctx,action: string)
	local player=ctx.player
	if routines[player] or (routineCooldown[player] or 0)&gt;os.clock() then notify(player,"Finish your session or take a short break before the next one.");return end
	local machine=ctx.q:GetAttribute("Value")
	local roots: {Instance}=if action=="workout" and machine~=nil then (fixtures(ctx.office).machines[tostring(machine)] or {}) else {}
	if action=="workout" then
		for _,job in routines do if job.part==ctx.part or (machine~=nil and job.machine==machine and job.office==ctx.office) then notify(player,"This machine is in use.");return end end
		-- an employee on a wellness break holds the machine too
		for _,root in roots do
			local station=machineStation(ctx.office,root)
			if station and station:GetAttribute("OccupiedBy")~=nil then notify(player,"This machine is in use.");return end
		end
	end
	local seconds=if action=="workout" then 18 else 12
	routines[player]={part=ctx.part,kind=action,left=seconds,seconds=seconds,owner=ctx.owner,machine=machine,office=ctx.office,cf=ctx.plot.cframe,roots=roots}
	for _,root in roots do
		run(root,seconds) -- belts / flywheels / rower fan move on the client for the session
		local station=machineStation(ctx.office,root)
		if station then station:SetAttribute("PlayerUntil",serverNow()+seconds) end -- employees keep off it
	end
	if action=="sauna" then
		local heater=if ctx.part.Name=="SaunaHeater" then ctx.part else nearestNamed(ctx.office,"SaunaHeater",ctx.part.Position,40)
		run(propRoot(heater) or heater,20)
	end
	notify(player,if action=="workout" then "Exercise started · stay at this machine for 18 seconds." else "Sauna started · relax inside the sauna for 12 seconds.")
end
-- Generic prop use (coffee machines, fridges, copiers, printers, lockers, chargers, car lift, robot arm,
-- vending, water points ...): distance, throttle and room access were checked by handle; here a
-- per-prop cooldown, then one FxUntil write. Cosmetic: no money, no saved data.
local function useProp(ctx: Ctx)
	local root=propRoot(ctx.part) or propById(ctx.office,ctx.q:GetAttribute("Value"))
	if not root then return end
	if (propCooldown[root] or 0)&gt;os.clock() then notify(ctx.player,"Just a moment, it is still busy.");return end
	local seconds=root:GetAttribute("FxSeconds");local secs=if typeof(seconds)=="number" then math.clamp(seconds,1,30) else 4
	propCooldown[root]=os.clock()+secs+1
	run(root,secs)
end
local function report(ctx: Ctx)
	local s,player=ctx.s,ctx.player
	run(propRoot(ctx.part),3) -- the printer feeds pages on the client
	local bag=backpack(player);if not bag then return end
	local old=bag:FindFirstChild("Company Report");if old then old:Destroy() end
	local equipped=if player.Character then player.Character:FindFirstChild("Company Report") else nil;if equipped then equipped:Destroy() end
	local tool=Instance.new("Tool");tool.Name="Company Report";tool.CanBeDropped=false;tool.RequiresHandle=false;tool.ToolTip=string.format("$%.0f · AI %.1f · office %d",s.data.money,s.data.stats.bestOverall or 0,s.data.empire.office)
	local text=tool.ToolTip;tool.Activated:Connect(function()if tool.Parent and carried(player,tool) then notify(player,text) end end);tool.Parent=bag;notify(player,"Company report printed to your backpack.")
end
-- Founder's model safe: confidential summary of the newest four model versions + training state.
local function modelSafe(ctx: Ctx)
	local data=ctx.s.data;local lines={"MODEL SAFE · CONFIDENTIAL"}
	local order=data.modelOrder or {}
	for i=#order,math.max(1,#order-3),-1 do
		local m=data.models[order[i]]
		if m then table.insert(lines,string.format("%s v%s · %s · score %.1f",tostring(m.name),tostring(m.version),tostring(m.status),m.overall or 0)) end
	end
	if #lines==1 then table.insert(lines,"No model versions stored yet.") end
	local training=data.training
	if training then
		local m=data.models[training.modelId]
		local share=if training.workTotal and training.workTotal&gt;0 then math.clamp(training.workDone/training.workTotal,0,1) else 0
		table.insert(lines,string.format("Training: %s · %d%%",if m then m.name.." v"..tostring(m.version) else "model",math.floor(share*100)))
	else table.insert(lines,"Training: idle") end
	notify(ctx.player,table.concat(lines,"\n"))
	Remote.fire(ctx.player,"Notify","OWNER_COMPUTER",{app="lab"})
end
-- Players may take a free workstation chair that no employee has reserved.
local function sit(ctx: Ctx)
	local h=ctx.humanoid;if not h then return end
	local node: Instance?=ctx.part;local station: Instance?=nil
	while node and node~=ctx.office do if node:GetAttribute("WorkstationId")~=nil then station=node;break end;node=node.Parent end
	local seat: Seat?=if ctx.part:IsA("Seat") then ctx.part else nil
	if not seat and station then local found=station:FindFirstChildWhichIsA("Seat",true);if found then seat=found end end
	if not seat then return end
	if h.SeatPart==seat then h.Sit=false;return end
	if seat.Occupant or (station and station:GetAttribute("ReservedBy")~=nil) then notify(ctx.player,"This desk is in use.");return end
	seat:Sit(h)
end
local ACTIONS: {[string]:(Ctx)-&gt;()}={
	toilet=toilet,
	flush=flush,
	tap=function(ctx) water(ctx,"tap") end,
	shower=function(ctx) water(ctx,"shower") end,
	sauna=function(ctx) routine(ctx,"sauna") end,
	workout=function(ctx) routine(ctx,"workout") end,
	report=report,
	modelSafe=modelSafe,
	sit=sit,
	prop=useProp,
	security=function(ctx)
		local result=openSecurity(ctx.s,{ownerId=ctx.owner});if result.ok then Remote.fire(ctx.player,"Notify","SECURITY_OPEN",result) end
	end,
	ownerComputer=function(ctx)
		local app=ctx.q:GetAttribute("Value");Remote.fire(ctx.player,"Notify","OWNER_COMPUTER",{app=if typeof(app)=="string" then app else "empire"})
	end,
	fleet=function(ctx) Remote.fire(ctx.player,"Notify","OWNER_COMPUTER",{app="campus",section="fleet"}) end,
}
function Facility.handle(player: Player,q: ProximityPrompt)
	local action=q:GetAttribute("CampusAction");if typeof(action)~="string" or action=="spawnCar" then return end
	local s=Session.get(player);local part=q.Parent
	if not s or s.closed or not part or not part:IsA("BasePart") or not nearby(player,part,16) then return end
	local officeInst=q:FindFirstAncestor("Office");if not officeInst or not officeInst:IsA("Model") then return end
	local office: Model=officeInst
	local owner=office:GetAttribute("OwnerUserId");if typeof(owner)~="number" then return end
	local own=ownerSession(owner);local p=if own then Plot.get(own.player) else nil
	if not own or not p or p.office~=office then return end
	if (promptTimes[player] or 0)&gt;os.clock() then return end;promptTimes[player]=os.clock()+.3
	local ctx: Ctx={s=s,player=player,q=q,part=part,office=office,owner=owner,plot=p,humanoid=humanoidOf(player)}
	if action=="door" then useDoor(ctx);return end -- DoorService decides (egress never needs a card)
	if action=="liftCall" then
		local level=q:GetAttribute("Value");if typeof(level)~="number" then return end
		local ok,reason=Lift.hallCall(player,office,level)
		if not ok and reason and reason~="BAD_INPUT" then notify(player,LIFT_TEXT[reason] or reason) end
		return
	end
	if action=="liftPanel" then Remote.fire(player,"Notify","LIFT_PANEL",Lift.panel(player,office));return end
	if action=="snack" then -- the café is public: visitors pay like everybody else
		local result=buySnack(s,{snackId=q:GetAttribute("Value"),shopOwnerId=owner,atCounter=true})
		notify(player,if result.ok then "Snack added to your backpack. Equip it to eat." elseif result.err=="NO_MONEY" then "Not enough money for this snack." elseif result.err=="SNACK_FULL" then "Your snack bag is full." else "This snack is not on the menu.")
		return
	end
	if action=="card" then
		if owner==player.UserId then Facility.issueCard(player,owner);notify(player,"Replacement employee card issued.") end
		return
	end
	local fn=ACTIONS[action];if not fn then return end
	local founderText=FOUNDER_ACTIONS[action] or (if q:GetAttribute("OwnerOnly")==true then "Founder only." else nil)
	if founderText then
		if player.UserId~=owner then notify(player,founderText);return end
		if not Facility.hasCard(player,owner,true) then notify(player,CARD_TEXT);return end
	else
		-- Fixtures follow the access class of the room they stand in (public rooms need no card).
		local tier=office:GetAttribute("OfficeTier")
		local class=if typeof(tier)=="number" then Plan.accessAt(tier,p.cframe:PointToObjectSpace(part.Position)) else "staff"
		local card=Facility.hasCard(player,owner)
		if not Plan.playerAllows(player.UserId==owner,card,class) then notify(player,if card then DENY[class] or CARD_TEXT else CARD_TEXT);return end
	end
	fn(ctx)
end

-- Access guard (security fallback) ---------------------------------------------------------------
local function inRect(r: any,v: Vector3): boolean
	return v.X&gt;r.x1 and v.X&lt;r.x2 and v.Z&gt;r.z1 and v.Z&lt;r.z2
end
-- Just outside the nearest door of `room` whose far side this player may use (plot-local door
-- centre ± inward*4, whichever point lies outside the room; facing away from the room). Doors owned
-- by neighbouring rooms count too, and flipped doors (inward pointing out of the room) work.
local function outsideDoor(p: any,tier: number,room: any,localPos: Vector3,isOwner: boolean,hasCard: boolean): CFrame?
	local best: CFrame?=nil;local bestDistance=math.huge
	for _,d in Layout.doors(tier) do
		if d.level~=room.level then continue end
		local centre=Vector3.new(d.x,Plan.levelY(d.level)+3,d.z)
		local a,b=centre+d.inward*4,centre-d.inward*4
		local target: Vector3?=nil
		if inRect(room,a) and not inRect(room,b) then target=b elseif inRect(room,b) and not inRect(room,a) then target=a end
		if target then
			local distance=(target-localPos).Magnitude
			if distance&lt;bestDistance and Plan.playerAllows(isOwner,hasCard,(Plan.accessAt(tier,target))) then
				best=p.cframe*CFrame.lookAt(target,target+(target-centre));bestDistance=distance
			end
		end
	end
	return best
end
local function guard(s: any,character: Model,root: BasePart,h: Humanoid?)
	local seat=if h then h.SeatPart else nil
	if seat and seat:IsA("VehicleSeat") then return end -- never yank a driver out of a car
	if Lift.riding(character) then return end -- re-checked after the ride
	for _,p in Plot.all() do
		if not p.owner or not p.office then continue end
		local tier=p.office:GetAttribute("OfficeTier");if typeof(tier)~="number" then continue end
		local localPos=p.cframe:PointToObjectSpace(root.Position)
		if not Plan.inside(tier,localPos) then continue end
		local ownerId=p.owner.UserId;local isOwner=s.userId==ownerId
		local hasCard=isOwner or Facility.hasCard(s.player,ownerId)
		local class,room=Plan.accessAt(tier,localPos)
		if not Plan.playerAllows(isOwner,hasCard,class) then
			local target=(if room then outsideDoor(p,tier,room,localPos,isOwner,hasCard) else nil) or Plot.arrival(p)
			local text=if hasCard then (DENY[class] or "This room is not on your card.").." You were shown back out." else VISITOR_TEXT
			unseat(h);character:PivotTo(target);notify(s.player,text)
		end
		return
	end
end
local function walkSpeed(s: any,h: Humanoid)
	local c=s.data.empire.campus
	local want=if c.boostUntil&gt;os.time() then c.boostSpeed else 16
	local last=speedApplied[s.player]
	if last and last.humanoid==h and last.value==want then return end -- leave other scripts' changes alone
	if h.WalkSpeed~=want then h.WalkSpeed=want end
	speedApplied[s.player]={humanoid=h,value=want}
end
local function atRoutine(player: Player,job: any): boolean
	if job.kind~="sauna" then return nearby(player,job.part,7) end
	local root=rootOf(player);local tier=job.office:GetAttribute("OfficeTier")
	if not root or typeof(tier)~="number" then return false end
	local room=Plan.room(tier,"P0_SAUNA");if not room then return nearby(player,job.part,10) end
	local pos=job.cf:PointToObjectSpace(root.Position);local base=Plan.levelY(room.level)
	return pos.X&gt;room.x1 and pos.X&lt;room.x2 and pos.Z&gt;room.z1 and pos.Z&lt;room.z2 and pos.Y&gt;base-2 and pos.Y&lt;base+14
end
function Facility.tick(dt: number)
	for seat,grace in toiletSeats do
		if not seat.Parent then toiletSeats[seat]=nil
		elseif os.clock()&gt;grace and seat.Occupant==nil then seat.Disabled=true;toiletSeats[seat]=nil end
	end
	for player,job in routines do
		local s=Session.get(player)
		if not s or s.closed or not job.part.Parent or not atRoutine(player,job) or not Facility.hasCard(player,job.owner) then
			routines[player]=nil;notify(player,"Session stopped because you left the station.")
			for _,root in job.roots or {} do
				run(root,0)
				local station=machineStation(job.office,root);if station then station:SetAttribute("PlayerUntil",nil) end
			end
		else
			job.left-=dt
			if job.left&lt;=1e-6 then
				local c=s.data.empire.campus;local boosted=c.boostUntil&gt;os.time();c.boostUntil=math.max(c.boostUntil,os.time()+90);local speed=if job.kind=="workout" then 20 else 18;c.boostSpeed=if boosted then math.max(c.boostSpeed,speed) else speed
				routines[player]=nil;routineCooldown[player]=os.clock()+60;Session.markDirty(s);notify(player,"Session complete · refreshed for 90 seconds.")
			end
		end
	end
	for tool,record in cards do if not tool.Parent or (record.expires&gt;0 and record.expires&lt;=os.time()) then tool:Destroy();cards[tool]=nil end end
	for tool,_ in snackTools do if not tool.Parent then snackTools[tool]=nil end end
	guardClock+=dt;local guardNow=guardClock&gt;=.25;if guardNow then guardClock=0 end
	for _,s in Session.all() do
		if s.closed then continue end
		local character=s.player.Character;local root=rootOf(s.player);local h=humanoidOf(s.player)
		if h then walkSpeed(s,h) end
		if guardNow and character and root then guard(s,character,root,h) end
	end
end
function Facility.economyTick(s: any,dt: number)
	local c=s.data.empire.campus
	if s.data.company then
		c.retailClock+=dt
		if c.retailClock&gt;=30 then
			c.retailClock-=30
			local staff=0;for _,count in s.data.empire.employees do staff+=count end
			local tickets=c.retailLevel+math.floor(staff/24)
			local net=tickets*12
			-- P&amp;L line "retail" (CORE_SPEC 3.6; corefix request 8 / econ request 3)
			c.retailSales+=tickets;c.retailRevenue+=net;Economy.grant(s,net,"retail");Session.markDirty(s)
		end
	end
	local online={};local passes={}
	for _,peer in Session.all() do if not peer.closed and peer.userId~=s.userId then table.insert(online,{id=peer.userId,name=peer.player.DisplayName}) end end
	local granted=guests[s.userId];if granted then for id,expires in granted do if expires&gt;os.time() then table.insert(passes,{id=id,expires=expires}) end end end
	local job=routines[s.player]
	local own=Plot.get(s.player);local opsFolder=if own and own.office then own.office:FindFirstChild("OperationsEmployees") else nil
	s.live.campus={hasCard=Facility.hasCard(s.player,s.userId),online=online,passes=passes,supportStaff=if opsFolder then #opsFolder:GetChildren() else 0,retailNetPerTicket=12,routine=if job then {kind=job.kind,remaining=job.left,seconds=job.seconds} else nil}
end
function Facility.init()
	Doors.setAuthorizer(authorizeDoor)
	Doors.setNotifier(function(player: Player,text: string) notify(player,text) end)
	Lift.init(function(player: Player,ownerId: number): boolean return Facility.hasCard(player,ownerId) end)
	local limits={burst=3,perSecond=1,company=true}
	Remote.bind("UseCampusLift",{burst=4,perSecond=2},Lift.remote)
	Remote.bind("OpenSecurity",{burst=2,perSecond=.5},openSecurity)
	Remote.bind("BuySnack",limits,function(s,p)return buySnack(s,{snackId=p.snackId})end)
	Remote.bind("GrantGuestCard",limits,grantGuest);Remote.bind("RevokeGuestCard",limits,revokeGuest);Remote.bind("UpgradeRetail",limits,upgradeRetail)
	Remote.bind("ReplaceCard",{burst=2,perSecond=.25},function(s,_p)return {ok=Facility.issueCard(s.player,s.userId)}end)
	-- PromptTriggered passes (prompt, player); handle keeps its (player, prompt) signature.
	Prompts.PromptTriggered:Connect(function(q: ProximityPrompt,player: Player) Facility.handle(player,q) end)
	Session.onLoaded(function(s)
		connections[s.player]=s.player.CharacterAdded:Connect(function()task.delay(.5,restore,s)end)
		task.delay(.5,restore,s)
	end)
	Session.onClosing(function(s)
		routines[s.player]=nil;routineCooldown[s.player]=nil;promptTimes[s.player]=nil;speedApplied[s.player]=nil
		if connections[s.player] then connections[s.player]:Disconnect();connections[s.player]=nil end
		guests[s.userId]=nil
		for _,list in guests do list[s.userId]=nil end
		for tool,record in cards do if record.holder==s.player or record.owner==s.userId then tool:Destroy();cards[tool]=nil end end
		for tool,record in snackTools do if record.holder==s.player then tool:Destroy();snackTools[tool]=nil end end
	end)
end
return Facility
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000025"><Properties><string name="Name">VehicleService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Physical company cars. Server validates drivers and input; Roblox simulates the assembly.
-- Bounds: a car is reset to its garage when it leaves every drivable zone of CityPlan (campus district,
-- Business City, airport) or falls below the map. A car parked away from its plot (e.g. at the airport
-- while the founder is abroad) survives office rebuilds; only a car on the plot is cleared then.
-- Game-pass cars (CampusConfig.CARS `pass`): available only while ShopService.owns(player, pass) says so.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Prompts=game:GetService("ProximityPromptService")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Math=require(ReplicatedStorage.Shared.CampusMath)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local CityPlan=require(ReplicatedStorage.Shared.Config.CityPlan)
local Net=require(ReplicatedStorage.Shared.Net)
local CompanyConfig=require(ReplicatedStorage.Shared.Config.CompanyConfig)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Vehicles={cars={} :: {[number]:any}}
-- Anything 12 studs below the B1 garage floor (world Y) fell through the map and is reset.
local FLOOR_LIMIT=Config.STREET_Y+Plan.B1_Y-12
local serial=0
-- ShopService is required lazily and asked defensively: a missing module, a missing owns() or an error
-- all count as "not owned" (VehicleService never depends on the shop being loaded first).
local function passOwned(player: Player,pass: string): boolean
	local ok,mod=pcall(function(): any return require(script.Parent.ShopService) end)
	local shop: any=if ok then mod else nil
	if typeof(shop)~="table" or typeof(shop.owns)~="function" then return false end
	local okOwns,owned=pcall(shop.owns,player,pass)
	return okOwns and owned==true
end
Vehicles.passOwned=passOwned
local function available(s: any,def: any): boolean
	if typeof(def.pass)=="string" then return passOwned(s.player,def.pass) end
	return s.data.empire.campus.cars[def.id]==true
end
-- Is a world position on the plot's site (incl. the garage under it)?
local function onSite(plotCF: CFrame,position: Vector3): boolean
	local l=plotCF:PointToObjectSpace(position);local site=Plan.SITE
	return l.X&gt;site.x1-4 and l.X&lt;site.x2+4 and l.Z&gt;site.z1-4 and l.Z&lt;site.z2+4
end
local function garageSpawn(plot: any): CFrame
	local marker=if plot.office then plot.office:FindFirstChild("GarageSpawn",true) else nil
	local markerCF=if marker then marker:GetAttribute("SpawnCFrame") else nil
	return if typeof(markerCF)=="CFrame" then markerCF else plot.cframe*Plan.GARAGE_SPAWN
end
local function add(model: Model,root: BasePart?,cf: CFrame,name: string,size: Vector3,offset: CFrame,color: Color3,collide: boolean?): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf*offset;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.Anchored=false;p.CanCollide=collide==true;p.Massless=root~=nil;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=model
	if root then local w=Instance.new("WeldConstraint");w.Part0=root;w.Part1=p;w.Parent=p end
	return p
end
local function clear(userId: number)
	local record=Vehicles.cars[userId];if not record then return end
	if record.seat.Occupant then record.seat.Occupant.Sit=false end
	if record.connection then record.connection:Disconnect() end
	record.model:Destroy();Vehicles.cars[userId]=nil
end
local function build(s: any,def: any,cf: CFrame): any
	serial+=1
	local folder=workspace:FindFirstChild("CompanyVehicles")
	if not folder then folder=Instance.new("Folder");folder.Name="CompanyVehicles";folder.Parent=workspace end
	local m=Instance.new("Model");m.Name="CompanyCar_"..tostring(s.userId);m:SetAttribute("OwnerUserId",s.userId);m:SetAttribute("CarId",tostring(serial));m:SetAttribute("VehicleType",def.id)
	local colorDef=CompanyConfig.getColor(s.data.company.color);local color=if colorDef then Color3.fromRGB(unpack(colorDef.rgb)) else Color3.fromRGB(91,125,100)
	local ink=Color3.fromRGB(35,42,40);local cream=Color3.fromRGB(222,219,199)
	local limo=def.id=="limo"
	local accent=color
	if limo then color=Color3.fromRGB(26,28,32) end -- black limousine, company colour as pinstripe
	local root=add(m,nil,cf,"Chassis",Vector3.new(def.width,.8,def.length),CFrame.new(),ink,true);root.CustomPhysicalProperties=PhysicalProperties.new(2,.25,.05);m.PrimaryPart=root
	add(m,root,cf,"Body",Vector3.new(def.width,1.5,def.length-.4),CFrame.new(0,.8,0),color)
	add(m,root,cf,"Hood",Vector3.new(def.width-.2,.6,3.5),CFrame.new(0,1.8,-def.length/2+2),color)
	if def.id=="van" then
		add(m,root,cf,"CargoBody",Vector3.new(def.width-.5,3.8,6.8),CFrame.new(0,2.4,3.4),color)
		for _,side in {-1,1} do add(m,root,cf,"CargoDoor",Vector3.new(def.width/2-.4,3,.15),CFrame.new(side*def.width/4,2.4,6.85),cream) end
	elseif def.id=="sport" then
		add(m,root,cf,"RearSpoiler",Vector3.new(def.width+1,.3,1.3),CFrame.new(0,3.05,def.length/2-1),ink)
		for _,side in {-1,1} do add(m,root,cf,"HoodStripe",Vector3.new(.35,.04,3.1),CFrame.new(side*.5,2.12,-def.length/2+2),cream) end
		add(m,root,cf,"Splitter",Vector3.new(def.width+.5,.22,1),CFrame.new(0,.1,-def.length/2-.4),ink)
	elseif def.id=="executive" then
		add(m,root,cf,"FrontTrim",Vector3.new(def.width-.6,.15,.15),CFrame.new(0,1.45,-def.length/2-.13),cream)
	elseif limo then
		add(m,root,cf,"Pinstripe",Vector3.new(def.width+.04,.18,def.length-1.6),CFrame.new(0,1.35,0),accent)
		add(m,root,cf,"SideGlass",Vector3.new(def.width-.5,1.5,8.6),CFrame.new(0,2.75,2.2),Color3.fromRGB(24,30,36))
		add(m,root,cf,"ChromeGrille",Vector3.new(def.width-1.4,.7,.15),CFrame.new(0,1.05,-def.length/2-.08),Color3.fromRGB(196,198,200))
	end
	local roofLength=if def.id=="van" then 9 elseif limo then 11.4 else 5.8
	local roofZ=if def.id=="van" then 1.8 elseif limo then 2.2 else .35
	local rearZ=if limo then 7.6 else 3
	add(m,root,cf,"Roof",Vector3.new(def.width-.8,.45,roofLength),CFrame.new(0,3.65,roofZ),color)
	local windshield=add(m,root,cf,"Windshield",Vector3.new(def.width-1.1,2,.15),CFrame.new(0,2.7,-2.7-(if limo then .8 else 0))*CFrame.Angles(math.rad(-18),0,0),Color3.fromRGB(117,153,148));windshield.Transparency=.42;windshield.Material=Enum.Material.Glass
	local back=add(m,root,cf,"BackWindow",Vector3.new(def.width-1.1,1.7,.15),CFrame.new(0,2.7,rearZ+.1)*CFrame.Angles(math.rad(12),0,0),windshield.Color);back.Transparency=.4
	for _,side in {-1,1} do
		add(m,root,cf,"RoofPillar",Vector3.new(.28,2.3,.4),CFrame.new(side*(def.width/2-.35),2.7,-2.6-(if limo then .8 else 0)),color)
		add(m,root,cf,"RearPillar",Vector3.new(.35,2.3,.5),CFrame.new(side*(def.width/2-.35),2.7,rearZ),color)
		add(m,root,cf,"Mirror",Vector3.new(.8,.5,1),CFrame.new(side*(def.width/2+.35),2,-2.1),color)
		for _,z in {-def.length*.31,def.length*.31} do
			local wheel=add(m,root,cf,"Wheel",Vector3.new(.8,2.8,2.8),CFrame.new(side*(def.width/2+.12),-.8,z),ink,true);wheel.Shape=Enum.PartType.Cylinder;wheel.CustomPhysicalProperties=PhysicalProperties.new(.7,.08,.05)
			local rim=add(m,root,cf,"WheelRim",Vector3.new(.86,1.65,1.65),CFrame.new(side*(def.width/2+.18),-.8,z),cream);rim.Shape=Enum.PartType.Cylinder
		end
		add(m,root,cf,"Headlight",Vector3.new(1.5,.6,.2),CFrame.new(side*(def.width/2-1.2),1,-def.length/2-.02),cream)
		add(m,root,cf,"TailLight",Vector3.new(1.3,.5,.2),CFrame.new(side*(def.width/2-1),1,def.length/2+.02),Color3.fromRGB(164,66,49))
	end
	add(m,root,cf,"Bumper",Vector3.new(def.width-.3,.45,.4),CFrame.new(0,.3,-def.length/2-.25),ink)
	add(m,root,cf,"SeatBack",Vector3.new(2,2,.4),CFrame.new(-1.35,2,.6),ink)
	add(m,root,cf,"PassengerSeat",Vector3.new(2,.5,2),CFrame.new(1.35,1.5,.2),ink)
	local plate=add(m,root,cf,"CompanyPlate",Vector3.new(2.5,.6,.1),CFrame.new(0,.95,-def.length/2-.16),cream)
	local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(400,100);gui.Parent=plate
	local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text=s.data.company.name;text.TextColor3=ink;text.TextScaled=true;text.Font=Enum.Font.BuilderSansBold;text.Parent=gui
	local seat=Instance.new("VehicleSeat");seat.Name="DriverSeat";seat.Size=Vector3.new(2,.5,2);seat.CFrame=cf*CFrame.new(-1.35,1.5,.2);seat.Color=ink;seat.CanCollide=false;seat.Massless=true;seat.Disabled=true;seat.HeadsUpDisplay=true;seat.MaxSpeed=def.speed;seat.Parent=m
	local weld=Instance.new("WeldConstraint");weld.Part0=root;weld.Part1=seat;weld.Parent=seat
	local attachment=Instance.new("Attachment");attachment.Name="DriveAttachment";attachment.Parent=root
	local velocity=Instance.new("LinearVelocity");velocity.Name="DriveVelocity";velocity.Attachment0=attachment;velocity.RelativeTo=Enum.ActuatorRelativeTo.World;velocity.VelocityConstraintMode=Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis=Vector3.new(1,0,0);velocity.SecondaryTangentAxis=Vector3.new(0,0,1);velocity.ForceLimitsEnabled=true;velocity.ForceLimitMode=Enum.ForceLimitMode.PerAxis;velocity.MaxPlanarAxesForce=Vector2.new(24000,24000);velocity.PlaneVelocity=Vector2.new(0,0);velocity.Parent=root
	local alignment=Instance.new("AlignOrientation");alignment.Attachment0=attachment;alignment.Mode=Enum.OrientationAlignmentMode.OneAttachment;alignment.MaxTorque=32000;alignment.Responsiveness=12;alignment.CFrame=cf.Rotation;alignment.Parent=root
	local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Drive";prompt.ObjectText=def.name;prompt.MaxActivationDistance=10;prompt.RequiresLineOfSight=false;prompt:SetAttribute("OwnerUserId",s.userId);prompt:SetAttribute("VehicleAction",true);prompt.Parent=seat
	m.Parent=folder
	local record={model=m,root=root,seat=seat,velocity=velocity,alignment=alignment,definition=def,home=cf,speed=0,throttle=0,steer=0,inputAt=0,checkClock=0,lastPosition=root.Position,lastInput=-1}
	Vehicles.cars[s.userId]=record
	record.connection=seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant=seat.Occupant
		if occupant then
			local driver=Players:GetPlayerFromCharacter(occupant.Parent)
			if driver~=s.player then occupant.Sit=false;return end
			m:SetAttribute("DriverUserId",s.userId);root:SetNetworkOwner(s.player)
		else
			record.throttle=0;record.steer=0;seat.Disabled=true;m:SetAttribute("DriverUserId",nil);root:SetNetworkOwner(nil)
		end
	end)
	root:SetNetworkOwner(nil)
	return record
end
function Vehicles.spawn(s: any,p: any): any
	local c=s.data.empire.campus
	local def=Config.find(Config.CARS,p.carId or c.selectedCar)
	-- the selected car is a pass car whose pass is gone: the default collection falls back to the Hatch
	if def and p.carId==nil and not available(s,def) then def=Config.find(Config.CARS,"compact") end
	if not def then return {ok=false,err="BAD_INPUT"} end
	if not available(s,def) then return {ok=false,err="NOT_OWNED"} end
	local plot=Plot.get(s.player);if not plot or not plot.office then return {ok=false,err="LOADING"} end
	-- GarageSpawn may sit anywhere inside the office (site/garage models); the plan is the fallback.
	local spawnCF=garageSpawn(plot)
	local previous=Vehicles.cars[s.userId];if previous and previous.seat.Occupant then return {ok=false,err="CAR_OCCUPIED"} end
	if previous and os.clock()-(previous.spawnedAt or 0)&lt;3 then return {ok=false,err="COOLDOWN"} end
	clear(s.userId);local record=build(s,def,spawnCF);record.spawnedAt=os.clock()
	if def.pass then c.cars[def.id]=true end -- shown as owned in the fleet UI (the pass is checked again on every spawn)
	c.selectedCar=def.id;Session.markDirty(s);return {ok=true}
end
function Vehicles.input(player: Player,id: any,throttle: any,steer: any)
	local record=Vehicles.cars[player.UserId]
	if not record or tostring(id)~=record.model:GetAttribute("CarId") or not Math.finiteUnit(throttle) or not Math.finiteUnit(steer) then return end
	local occupant=record.seat.Occupant
	if not occupant or Players:GetPlayerFromCharacter(occupant.Parent)~=player then return end
	local now=os.clock();if now-record.lastInput&lt;1/30 then return end
	record.lastInput=now;record.inputAt=now;record.throttle=throttle;record.steer=steer
end
function Vehicles.tick(dt: number)
	for userId,record in Vehicles.cars do
		if not record.model.Parent then clear(userId);continue end
		local occupant=record.seat.Occupant
		if not occupant or os.clock()-record.inputAt&gt;.8 then record.throttle=0;record.steer=0 end
		local speed,turn=Math.drive(record.speed,record.throttle,record.steer,math.min(dt,.1),record.definition);record.speed=speed
		local root=record.root;local forward=root.CFrame.LookVector
		local yaw=math.atan2(-forward.X,-forward.Z)+turn*dt
		local heading=Vector3.new(-math.sin(yaw),0,-math.cos(yaw))
		record.velocity.PlaneVelocity=Vector2.new(heading.X*speed,heading.Z*speed)
		local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={record.model,if occupant then occupant.Parent else record.model}
		local ground=workspace:Raycast(root.Position,Vector3.new(0,-9,0),params)
		local up=if ground and ground.Normal.Y&gt;.55 then ground.Normal else Vector3.new(0,1,0)
		record.alignment.CFrame=CFrame.lookAt(root.Position,root.Position+heading,up).Rotation
		record.model:SetAttribute("Speed",math.round(math.abs(speed)));record.model:SetAttribute("Steer",record.steer)
		record.checkClock+=dt
		if record.checkClock&gt;=.5 then
			local position=root.Position;local distance=(position-record.lastPosition).Magnitude
			if position.Y&lt;FLOOR_LIMIT or not CityPlan.drivable(position) or distance&gt;record.definition.speed*record.checkClock*1.8+35 or root.AssemblyLinearVelocity.Magnitude&gt;record.definition.speed*2+30 then
				if occupant then occupant.Sit=false end
				record.model:PivotTo(record.home);root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero;record.speed=0
				position=root.Position
			end
			record.lastPosition=position;record.checkClock=0
		end
	end
end
function Vehicles.init()
	Remote.bind("BuyCar",{burst=2,perSecond=.5,company=true},function(s,p)
		local def=Config.find(Config.CARS,p.carId);if not def then return {ok=false,err="BAD_INPUT"} end
		local c=s.data.empire.campus
		if typeof(def.pass)=="string" then
			-- pass car: never sold for cash; with the pass it joins the fleet (and is selected)
			if not passOwned(s.player,def.pass) then return {ok=false,err="NEEDS_PASS"} end
			c.cars[def.id]=true;c.selectedCar=def.id;Session.markDirty(s);return {ok=true}
		end
		if c.cars[def.id] then return {ok=false,err="ALREADY_DONE"} end
		if not Economy.spend(s,def.price) then return {ok=false,err="NO_MONEY"} end
		c.cars[def.id]=true;c.selectedCar=def.id;Session.markDirty(s);return {ok=true}
	end)
	Remote.bind("SpawnCar",{burst=2,perSecond=.25,company=true},Vehicles.spawn)
	Net.getEvent("VehicleInput").OnServerEvent:Connect(Vehicles.input)
	Prompts.PromptTriggered:Connect(function(q,player)
		local s=Session.get(player);if not s or s.closed or not s.data.company or not q.Parent then return end
		local character=player.Character;local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
		if not root or not q.Parent:IsA("BasePart") or (root.Position-q.Parent.Position).Magnitude&gt;14 then return end
		if q:GetAttribute("CampusAction")=="spawnCar" and q:GetAttribute("OwnerUserId")==player.UserId then
			-- the garage stage has no B1: its GarageSpawn marker carries the PickupText (buildings package)
			local plot=Plot.get(player);local marker=if plot and plot.office then plot.office:FindFirstChild("GarageSpawn",true) else nil
			local pick=if marker then marker:GetAttribute("PickupText") else nil
			local result=Vehicles.spawn(s,{});Remote.fire(player,"Notify","CAMPUS_NOTICE",{text=if result.ok then (if typeof(pick)=="string" then pick else "Your car is waiting in the B1 pick-up bay.") else "Car collection unavailable: "..tostring(result.err)})
		elseif q:GetAttribute("VehicleAction")==true and q:GetAttribute("OwnerUserId")==player.UserId then
			local record=Vehicles.cars[player.UserId];local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
			if record and q.Parent==record.seat and humanoid and not record.seat.Occupant then record.seat.Disabled=false;record.seat:Sit(humanoid) end
		end
	end)
	Plot.onChanged(function(plot,s)
		local record=Vehicles.cars[s.userId]
		if record and record.model.Parent and plot and typeof(plot.cframe)=="CFrame" and not onSite(plot.cframe,record.root.Position) then
			-- parked away from the plot (e.g. in the airport car park while the founder is abroad): the
			-- rebuild cannot touch it, so it stays; its reset spot follows the rebuilt garage
			record.home=garageSpawn(plot)
			return
		end
		clear(s.userId)
	end)
	Session.onClosing(function(s)clear(s.userId)end)
end
return Vehicles
