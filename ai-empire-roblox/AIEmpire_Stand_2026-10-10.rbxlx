local ModelMath=require(script.Parent.ModelMath)
local ModelConfig=require(script.Parent.Config.ModelConfig)
local Format=require(script.Parent.Format)
local Journey={}
Journey.STEPS={
 {id="data",label="DATA",app="data",title="Get training data",body="Data Operations · scrape free data or buy a pack. Data quantity and quality determine what your AI learns."},
 {id="compute",label="COMPUTE",app="compute",title="Check your compute",body="GPU control · your laptop can train a 100M model. Larger models need more VRAM; more GPU throughput shortens training."},
 {id="design",label="DESIGN",app="lab",title="Design your model",body="Model Architecture · choose a name, size, focus and recipe. Start small, then increase size when data and hardware support it."},
 {id="train",label="TRAIN",app="lab",title="Train with your own data",body="Training Control · start the run, watch loss and progress, and respond to training decisions."},
 {id="evaluation",label="EVALUATE",app="lab",section="evaluation",title="Evaluate your model",body="Evaluation Lab · compare coding, reasoning, math, creativity, knowledge and reliability before launch."},
 {id="release",label="LAUNCH",app="lab",section="release",title="Release your model",body="Deployment Studio · choose subscription and API prices, target customers and marketing, then launch."},
 {id="grow",label="GROW",app="market",title="Grow and improve",body="Growth · users and API customers pay for your live model. Hire a team and research improvements for the next generation."},
}
function Journey.latest(data: any,trainedOnly: boolean?): any
 for i=#data.modelOrder,1,-1 do local m=data.models[data.modelOrder[i]];if m and m.status~="training" and (not trainedOnly or m.status=="trained") then return m end end
 return nil
end
function Journey.progress(data: any,selection: any?): any
 local size=ModelConfig.getSize(if selection then selection.sizeId else "s100m") or ModelConfig.SIZES[1]
 local stock=ModelMath.dataSummary(data.data);local fleet=ModelMath.fleet(data.gpus)
 local released=data.stats.modelsReleased&gt;0;local trained=data.stats.modelsTrained&gt;0
 local done={stock.total&gt;=ModelConfig.TRAINING.minTokens or trained or released,fleet.vram&gt;=size.vram and fleet.throughput&gt;0 or trained or released,data.training~=nil or trained or released,trained or released,data.empire.quests.journey_evaluation==true or released,released,released and data.stats.totalRevenue&gt;0}
 local index=7;for i=1,7 do if not done[i] then index=i;break end end
 if data.training then index=4 end
 local missing=math.max(0,size.vram-fleet.vram);local hint=""
 if missing&gt;0 then hint=string.format("%s needs %d GB more VRAM · open Hardware",size.label,missing)
 elseif stock.total&lt;ModelConfig.TRAINING.minTokens then hint="Collect at least "..Format.tokens(ModelConfig.TRAINING.minTokens).." tokens before training."
 elseif size.id=="s7b" and not data.empire.research.frontier then hint="7B requires Frontier Architecture research in Company."
 else hint=string.format("%s · %d GB VRAM ready · %s tokens · %.0f%% quality",size.label,fleet.vram,Format.tokens(stock.total),stock.quality*100) end
 return {index=index,done=done,step=Journey.STEPS[index],hint=hint,missingVram=missing,complete=done[7]}
end
return Journey
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000011"><Properties><string name="Name">WorkforceMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Runtime only: never adds derived fields to the player's save.
-- Skill: every hired person has a persistent skill k (1..5, data.empire.staffProfiles[role][i].k,
-- missing = 3). Their productive weight is factor(k) = (7 + k) / 10, so k = 3 is exactly 1.0.
-- Department output (CORE_SPEC 5.1) is ONE formula, watched or not: Math.count(e, role) = O_r computed from
-- saved data only (CompanyOps.output): the people at work today (vacation / sick hashes, unpaid leave,
-- travelling engineers excluded), the seat rule min(H, S) + 0.5 * overflow, morale. StaffService no longer
-- reports anything: a company produces exactly the same whether its owner, a visitor or nobody watches.
--  * Math.capacity = sum of factor over the hired profiles (profiles beyond the hired count are ignored,
--    a missing profile counts as k = 3); kept for screens and older callers.
--  * Math.set is kept as a no-op so old callers (client StateController) stay valid.
local Math={}
Math.MIN_SKILL=1;Math.MAX_SKILL=5;Math.DEFAULT_SKILL=3
function Math.skill(k: any): number
 if typeof(k)~="number" or k~=k then return Math.DEFAULT_SKILL end
 return math.clamp(math.floor(k+.5),Math.MIN_SKILL,Math.MAX_SKILL)
end
-- Productive weight of one employee with skill k (division keeps k = 3 at exactly 1.0).
function Math.factor(k: any): number return (7+Math.skill(k))/10 end
function Math.capacity(empire: any,role: string): number
 local n=empire.employees[role] or 0
 local profiles=empire.staffProfiles
 local list=if typeof(profiles)=="table" then profiles[role] else nil
 if typeof(list)~="table" then return n end
 local total=0
 for i=1,n do
  local p=list[i]
  total+=if typeof(p)=="table" then Math.factor(p.k) else 1
 end
 return total
end
-- Deprecated: the economy no longer reads watched staff states (CORE_SPEC 5.1). No effect.
function Math.set(_empire: any,_counts: any?) end
-- CompanyOps requires this module at load time, so it is required lazily here (no require cycle).
local ops: any=nil
function Math.count(empire: any,role: string): number
 if ops==nil then
  local module=script.Parent:FindFirstChild("CompanyOps")
  if not module then return Math.capacity(empire,role) end
  ops=(require :: any)(module)
 end
 return ops.output(empire,role)
end
return Math
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000022"><Properties><string name="Name">CampusMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Campus helpers shared by server and client. Building volumes and access zones delegate to the
-- single architectural plan (BuildingPlan) so walls, doors and access checks never disagree.
local Config = require(script.Parent.Config.CampusConfig)
local Plan = require(script.Parent.Config.BuildingPlan)
local Employee = require(script.Parent.Config.EmployeeConfig)
local Math = {}
function Math.new(): any
	return {snacks={},retailLevel=1,retailClock=0,retailSales=0,retailRevenue=0,cars={compact=true},selectedCar="compact",boostUntil=0,boostSpeed=16}
end
-- Generated employee name whose first name matches the employee's presentation
-- (EmployeeConfig.isFeminine(index, owner)). Unique within a company for up to 32 x 24 people per
-- presentation; owner nil = 0 (legacy single-argument calls keep working).
function Math.staffName(index: number, owner: number?): string
	local o = owner or 0
	local list = if Employee.isFeminine(index, o) then Config.FIRST_NAMES_F else Config.FIRST_NAMES_M
	local k = index - 1 + Employee.hash(o + 7) % (#list * #Config.LAST_NAMES)
	if index &gt;= 300 and index &lt; 400 then
		-- operations staff (301..316): consecutive indices would give the whole block one surname.
		-- Step k by #list+1 instead (a new surname each) and start past the 240 hired indices, so
		-- within one presentation list no name repeats a hired employee's index-based name.
		k = Employee.hash(o + 7) % (#list * #Config.LAST_NAMES) + 240 + (index - 301) * (#list + 1)
	end
	return list[k % #list + 1] .. " " .. Config.LAST_NAMES[(k // #list) % #Config.LAST_NAMES + 1]
end
-- Name for a persistent staff profile seed, consistent with EmployeeConfig.feminine(seed) unless a
-- presentation is given (for recruiting: generate the seed, then the name from it).
function Math.nameForSeed(seed: number, feminine: boolean?): string
	local f = if feminine == nil then Employee.feminine(seed) else feminine
	local list = if f then Config.FIRST_NAMES_F else Config.FIRST_NAMES_M
	local h = Employee.hash(seed * 3 + 11)
	return list[h % #list + 1] .. " " .. Config.LAST_NAMES[(h // #list) % #Config.LAST_NAMES + 1]
end
-- true/false when the first name is in one of the staff lists, nil for unknown names.
local feminineNames: { [string]: boolean } = {}
for _, n in Config.FIRST_NAMES_F do feminineNames[n] = true end
for _, n in Config.FIRST_NAMES_M do feminineNames[n] = false end
function Math.nameFeminine(name: string): boolean?
	local first = string.match(name, "^%s*(%S+)")
	return if first then feminineNames[first] else nil
end
-- Building-local point inside the occupied building (main block, pavilion, garage, roof deck).
function Math.inside(x: number, y: number, z: number, tier: number): boolean
	return Plan.inside(tier, Vector3.new(x, y, z))
end
function Math.garage(x: number, y: number, z: number): boolean
	return Plan.inGarage(Vector3.new(x, y, z))
end
-- Founder-only or hidden room at this point (founder suite, founder services, secret lab, vault).
function Math.privateZone(x: number, y: number, z: number, tier: number): boolean
	local class, room = Plan.accessAt(tier, Vector3.new(x, y, z))
	return class == "founder" or (room ~= nil and room.hidden == true)
end
-- May an ordinary staff member (public + staff clearance) stand here?
function Math.staffAllowed(x: number, y: number, z: number, tier: number): boolean
	return Plan.employeeAllowed("marketer", tier, Vector3.new(x, y, z))
end
function Math.drive(speed: number, throttle: number, steer: number, dt: number, def: any): (number, number)
	local target=if throttle&gt;=0 then throttle*def.speed else throttle*def.reverse
	local delta=math.clamp(target-speed,-def.acceleration*dt,def.acceleration*dt)
	local nextSpeed=speed+delta
	if math.abs(nextSpeed)&lt;.15 then nextSpeed=0 end
	local turn= -steer*def.turn*math.clamp(math.abs(nextSpeed)/18,0,1)*(if nextSpeed&lt;0 then -1 else 1)
	return nextSpeed,turn
end
function Math.finiteUnit(value: any): boolean
	return typeof(value)=="number" and value==value and value&gt;-math.huge and value&lt;math.huge and math.abs(value)&lt;=1
end
return Math
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000030"><Properties><string name="Name">StudioMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local Config=require(script.Parent.Config.StudioConfig)
local Math={}
function Math.quality(stats: any,kind: any): number
	local ability=(stats[kind.stat] or 0)*0.55+(stats.creativity or 0)*0.2+(stats.reliability or 0)*0.25
	return math.round(100*(1-math.exp(-ability/65))*10)/10
end
function Math.rate(gpus: any,empire: any): number
	local ModelMath=require(script.Parent.ModelMath)
	local Hardware=require(script.Parent.Config.HardwareConfig)
	return ModelMath.fleet(gpus).throughput*Hardware.thermal(empire,ModelMath.fleet(gpus).throughput)*0.35
end
function Math.content(title: string,kind: string,briefId: string?): any
	local brief=Config.find(Config.BRIEFS,briefId)
	if brief then return {headline=brief.headline,sub=brief.sub,items=table.clone(brief.items)} end
	if kind=="shop" then return {headline=title..". Made for everyday.",sub="A small collection of useful objects, chosen with care.",items={"Everyday essentials","The studio collection","New arrivals"}} end
	if kind=="gamebot" then return {headline="Meet your next game companion.",sub="Help players explore, learn and find their next adventure.",items={"Find a route","Explain a quest","Help a teammate"}} end
	if kind=="workflow" then return {headline="Make room for better work.",sub="A clear queue, organised tasks and a calmer team.",items={"Review inbox","Prepare reply","Complete task"}} end
	return {headline=title..". Built with purpose.",sub="A clear idea, carefully made. Discover our work and get in touch.",items={"Our approach","Selected work","Meet the team"}}
end
return Math
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000031"><Properties><string name="Name">ArenaMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- A concrete route planner. Skill changes detours and decisions; every move stays inside the course.
local Math={}
Math.WIDTH=9
Math.HEIGHT=7
local walls={"3:1","3:2","3:3","3:5","3:6","5:2","5:3","5:4","5:5","7:1","7:3","7:4","7:6"}
function Math.blocked(x: number,z: number): boolean
	if x&lt;1 or x&gt;Math.WIDTH or z&lt;1 or z&gt;Math.HEIGHT then return true end
	return table.find(walls,tostring(x)..":"..tostring(z))~=nil
end
function Math.route(stats: any,seed: number): any
	local start={x=1,z=4};local goal={x=9,z=4}
	local queue={start};local seen={['1:4']=true};local parent={};local i=1
	while i&lt;=#queue do
		local cell=queue[i];i+=1
		if cell.x==goal.x and cell.z==goal.z then break end
		for _, d in {{1,0},{0,-1},{0,1},{-1,0}} do
			local x,z=cell.x+d[1],cell.z+d[2];local key=tostring(x)..":"..tostring(z)
			if not Math.blocked(x,z) and not seen[key] then
				seen[key]=true;parent[key]=cell;table.insert(queue,{x=x,z=z})
			end
		end
	end
	local path={goal};local cell=goal
	while cell.x~=start.x or cell.z~=start.z do
		cell=parent[tostring(cell.x)..":"..tostring(cell.z)]
		assert(cell,"arena must have a legal route")
		table.insert(path,1,cell)
	end
	local shortest=#path
	local skill=(stats.reasoning or 0)*0.6+(stats.coding or 0)*0.25+(stats.reliability or 0)*0.15
	local detours=math.max(0,math.floor(5/(1+skill/35)+(seed%3)/2)-1)
	for _=1,detours do
		-- Two legal moves away from and back to an existing cell.
		for n=2,#path-1 do
			local p=path[n]
			if not Math.blocked(p.x,p.z+1) then table.insert(path,n+1,{x=p.x,z=p.z+1});table.insert(path,n+2,{x=p.x,z=p.z});break end
		end
	end
	local secondsPerStep=math.clamp(1.8-(stats.speed or 40)/100,0.55,1.5)
	local score=math.round(skill*0.45+100*shortest/#path+20/secondsPerStep)
	return {path=path,shortest=shortest,moves=#path-1,seconds=(#path-1)*secondsPerStep,stepSeconds=secondsPerStep,score=score,detours=detours}
end
function Math.cargo(stats: any): any
	local correct=math.clamp(math.floor((stats.coding or 0)/15),1,8)
	return {correct=correct,total=8,score=correct*12.5}
end
return Math
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000038"><Properties><string name="Name">EmpireMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local Config = require(script.Parent.Config.EmpireConfig)
local ModelMath = require(script.Parent.ModelMath)
local HardwareConfig = require(script.Parent.Config.HardwareConfig)
local ModelConfig = require(script.Parent.Config.ModelConfig)
local CampusMath=require(script.Parent.CampusMath)
local Workforce=require(script.Parent.WorkforceMath)
local Employee=require(script.Parent.Config.EmployeeConfig)
local Ops=require(script.Parent.CompanyOps)
local MarketConfig=require(script.Parent.Config.MarketConfig)
local Math = {}
Math.MAX_APPLICANTS = 5 -- open job applications at once (RecruitingService)
Math.APPLICATION_SECONDS = 1800 -- an application nobody invited stays open this long (play time, empire.seconds)
function Math.new(): any
	return { campus = CampusMath.new(), office = 1, employees = {}, research = {}, points = 25, researchJob = nil,
		quests = {}, contracts = {}, contractsCompleted = 0, xp = 0, seconds = 0,
		daily = { day = -1, streak = 0 }, lastSeen = 0, history = {}, historyClock = 0, subscriptions = {}, invoices = {}, customers = {}, businessRevenue = 0, projects = {}, projectOrder = {}, projectJob = nil, deliveries = {}, arenaHistory = {}, arenaBest = 0, infrastructure = {cooling=1,trainingShare=0.7},
		staffProfiles = {}, applicants = {}, hireSerial = 0,
		-- CORE_SPEC Appendix A (DATA_VERSION 6): company calendar, B2B pipeline, Lab levels, jet, auto-HR,
		-- Save mode, night shifts, apprentices, unpaid leave, P&amp;L ledger (Template.migrate cleans them)
		calendar = { day = 1 }, deals = Ops.newDeals(), labLevel = 0, jet = false, hr = { auto = true, budget = 0.40 },
		saveMode = "auto", nightShift = {}, apprentices = {}, unpaidLeave = 0, ledger = {} }
end
-- Persistent staff identities: staffProfiles[roleId][i] = {n = name, s = appearance seed,
-- k = skill 1..5, w = wage multiplier} for the i-th hired person of that role (StaffAssignment builds
-- rig i of the role from it). Invariant: #staffProfiles[role] == employees[role].
-- syncProfiles repairs any save to that invariant without changing what the building shows today:
-- a missing name/seed becomes exactly the generated identity StaffAssignment/EmployeeRigDesign use
-- for that person now (global index over EmpireConfig.ROLES order, CampusMath.staffName and
-- EmployeeConfig.seed); missing k = 3 and w = 1 keep the old economy. owner = nil (Template.migrate
-- has no user id) only cleans and truncates; names/seeds are filled once the session knows its owner.
local function cleanProfile(raw: any): any
	local p: any = if typeof(raw) == "table" then raw else {}
	local n, s, k, w = p.n, p.s, p.k, p.w
	return {
		n = if typeof(n) == "string" and string.match(n, "%S") then string.sub(n, 1, 40) else nil,
		s = if typeof(s) == "number" and s == s and math.abs(s) &lt; 1e15 then math.floor(math.abs(s)) % 2147483647 else nil,
		k = Workforce.skill(k),
		w = if typeof(w) == "number" and w == w and w &gt; -math.huge and w &lt; math.huge then math.clamp(w, 0.5, 2) else 1,
	}
end
function Math.profilesConsistent(e: any): boolean
	local profiles = e.staffProfiles
	if typeof(profiles) ~= "table" then return false end
	for _, role in Config.ROLES do
		local list = profiles[role.id]
		local n = e.employees[role.id] or 0
		if typeof(list) ~= "table" or #list ~= n then return false end
		for i = 1, n do
			local p = list[i]
			if typeof(p) ~= "table" or typeof(p.n) ~= "string" or typeof(p.s) ~= "number" or typeof(p.k) ~= "number" or typeof(p.w) ~= "number" then return false end
		end
	end
	return true
end
function Math.syncProfiles(e: any, owner: number?)
	local profiles = if typeof(e.staffProfiles) == "table" then e.staffProfiles else {}
	local clean = {}
	local index = 0
	for _, role in Config.ROLES do
		local list = profiles[role.id]
		local out = {}
		for i = 1, e.employees[role.id] or 0 do
			index += 1
			local p = cleanProfile(if typeof(list) == "table" then list[i] else nil)
			if owner then
				if p.n == nil then p.n = CampusMath.staffName(index, owner) end
				if p.s == nil then p.s = Employee.seed(index, owner) end
			end
			out[i] = p
		end
		clean[role.id] = out
	end
	e.staffProfiles = clean
end
-- Σ wage multipliers of the hired people of a role (old saves: exactly the hired count).
function Math.payroll(e: any, roleId: string): number
	local n = e.employees[roleId] or 0
	local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[roleId] else nil
	if typeof(list) ~= "table" then return n end
	local total = 0
	for i = 1, n do
		local p = list[i]
		local w = if typeof(p) == "table" then p.w else nil
		total += if typeof(w) == "number" and w == w then w else 1
	end
	return total
end
-- Fresh persistent identity for a new hire or applicant: appearance seed from (owner, hireSerial),
-- name from that seed (presentation consistent with EmployeeConfig.feminine(seed), ~50 % women).
-- Names stay unique within the company (team + open applicants). Advances e.hireSerial.
function Math.nextIdentity(e: any, owner: number): (string, number, number)
	local used: { [string]: boolean } = {}
	if typeof(e.staffProfiles) == "table" then
		for _, list in e.staffProfiles do
			if typeof(list) == "table" then for _, p in list do if typeof(p) == "table" and typeof(p.n) == "string" then used[p.n] = true end end end
		end
	end
	if typeof(e.applicants) == "table" then
		for _, a in e.applicants do if typeof(a) == "table" and typeof(a.n) == "string" then used[a.n] = true end end
	end
	local base = Employee.hash(math.floor(math.abs(owner)) % 4294967296 + 0x5bd1e995)
	local serial, seed, name = 0, 0, ""
	for _ = 1, 64 do
		e.hireSerial = math.max(0, math.floor(tonumber(e.hireSerial) or 0)) + 1
		serial = e.hireSerial
		seed = Employee.hash((base + serial * 0x9e3779b9) % 4294967296) % 2147483647
		name = CampusMath.nameForSeed(seed)
		if not used[name] then break end
	end
	return name, seed, serial
end
function Math.staff(e: any): number
	local n = 0
	for _, def in Config.ROLES do n += e.employees[def.id] or 0 end
	return n
end
-- Flat agency fee (CORE_SPEC 4): about a third of a day's wage, the same for every hire.
function Math.hireCost(_e: any, role: any): number
	return math.floor(role.price)
end
-- Department outputs O_r (WorkforceMath.count = CompanyOps.output, CORE_SPEC 5.1) drive every bonus:
--   engineers: training speed 1 + 0.15 O, serving cost x (1 - 0.2 (1 - e^(-O/10)))
--   researchers: research points/s base(stage) + 0.6 O (x duty where it accrues), core-stat bonus
--     floor(50 (1 - e^(-O/10))) / 10 (&lt;= +5) on new models, + Lab level
--   Growth &amp; Sales in the office (field reps excluded): revenue x (1 + 0.4 (1 - e^(-O_g/10)))
-- wage = hired payroll $/s (CompanyOps.wage: profile multipliers, unpaid leave, apprentices, night crew).
function Math.bonuses(e: any): any
	local r = e.research
	local engineers = Workforce.count(e,"engineer")
	local researchers = Workforce.count(e,"researcher")
	local speed = 1 + engineers * 0.15 + (if r.pipeline then 0.2 else 0) + (if r.cluster then 0.35 else 0)
	local stage = Config.OFFICES[math.clamp(math.floor(tonumber(e.office) or 1), 1, #Config.OFFICES)]
	return { speed = speed, wage = Ops.wage(e),
		revenue = 1 + 0.4 * (1 - math.exp(-Ops.growthO(e) / 10)) + (if r.distribution then 0.15 else 0),
		serving = (if r.quantization then 0.85 else 1) * (1 - 0.2 * (1 - math.exp(-engineers / 10))),
		core = (if r.architecture then 4 else 0) + (if r.frontier then 6 else 0) + math.floor(50 * (1 - math.exp(-researchers / 10))) / 10 + math.clamp(math.floor(tonumber(e.labLevel) or 0), 0, Ops.LAB_MAX),
		reliability = if r.alignment then 8 else 0,
		points = stage.points + researchers * 0.6 }
end
-- Training speed: GPUs x staff x thermal; compute reserved for B2B retainers slows training
-- (max(0.3, 1 - reserved / throughput), CORE_SPEC 3.2); a running studio project takes its share.
function Math.trainingRate(gpus: any, total: number, e: any): number
	local fleet = ModelMath.fleet(gpus)
	local reserved = if typeof(e.deals) == "table" then (tonumber(e.deals.reserved) or 0) else 0
	local b2b = math.max(0.3, 1 - reserved / math.max(1e-6, fleet.throughput))
	return math.min(fleet.throughput * Math.bonuses(e).speed * HardwareConfig.thermal(e,fleet.throughput) * b2b * (if e.projectJob then e.infrastructure.trainingShare else 1), total / ModelConfig.TRAINING.minSeconds)
end
function Math.boostStats(stats: any, e: any): (any, number)
	local b = Math.bonuses(e)
	for _, stat in ModelConfig.STATS do
		if stat.weight &gt; 0 then
			local value = math.round(((stats[stat.id] or 0) + b.core + (if stat.id == "reliability" then b.reliability else 0)) * 10) / 10
			stats[stat.id] = math.min(99, value) -- every core stat is capped at 99 (CORE_SPEC 7.5)
		end
	end
	return stats, ModelMath.overall(stats)
end
function Math.progress(data: any, quest: any): number
	local e = data.empire
	if quest.kind == "company" then return if data.company then 1 else 0 end
	if quest.kind == "tokens" then return ModelMath.dataSummary(data.data).total end
	if quest.kind == "gpus" then return ModelMath.fleet(data.gpus).slotsUsed end
	if quest.kind == "staff" then return Math.staff(e) end
	if quest.kind == "office" then return e.office end
	if quest.kind == "research" then
		local count = 0
		for _, def in Config.RESEARCH do if e.research[def.id] then count += 1 end end
		return count
	end
	if quest.kind == "contractsCompleted" then return e.contractsCompleted end
	return data.stats[quest.kind] or 0
end
-- "Next goal" bar (CORE_SPEC 8.2): the first unmet goal of the fixed order, built only from real state.
-- live (optional) = session.live for the ETA: (price + 2 reserve - cash) / net profit per minute.
-- Returns {id, text, have, need, etaMinutes?} or nil when everything is done.
local function liveLines(data: any): ({ [string]: any }, number)
	local lines: { [string]: any } = {}
	local n = 0
	for _, id in data.modelOrder or {} do
		local m = data.models[id]
		if m and m.status == "live" and m.release then
			local line = ((MarketConfig :: any).LINE_OF or {})[m.release.target or "general"] or "consumers"
			if not lines[line] then n += 1 end
			if not lines[line] or (lines[line].overall or 0) &lt; (m.overall or 0) then lines[line] = m end
		end
	end
	return lines, n
end
function Math.nextGoal(data: any, live: any?): any
	local e = data.empire
	local stats = data.stats or {}
	local cash = tonumber(data.money) or 0
	local net = if live then ((tonumber(live.revenue) or 0) - (tonumber(live.cost) or 0)) * 60 else 0
	local function money(id: string, text: string, price: number): any
		local need = price + Ops.reserve(e) * 2
		local eta = if cash &gt;= need then 0 elseif net &gt; 0 then (need - cash) / net else nil
		return { id = id, text = text, have = math.floor(cash), need = price, etaMinutes = eta }
	end
	local office = math.clamp(math.floor(tonumber(e.office) or 1), 1, #Config.OFFICES)
	local lines, nLines = liveLines(data)
	if (stats.modelsTrained or 0) &lt; 1 then return { id = "train", text = "Train your first AI", have = 0, need = 1 } end
	if (stats.modelsReleased or 0) &lt; 1 then return { id = "release", text = "Release it", have = 0, need = 1 } end
	if (tonumber(e.contractsCompleted) or 0) &lt; 1 then
		local first = Ops.CLIENTS[1]
		local trust = if typeof(e.deals) == "table" and typeof(e.deals.trust) == "table" then tonumber(e.deals.trust[first.id]) or 0 else 0
		return { id = "client", text = "Sign your first client (" .. first.name .. ")", have = math.floor(trust * 100), need = 100 }
	end
	if office &lt; 2 then return money("office2", Config.OFFICES[2].name .. " " .. Ops.money(Config.OFFICES[2].price), Config.OFFICES[2].price) end
	if nLines &lt; 2 then return { id = "lines2", text = "Second product line", have = nLines, need = 2 } end
	if office &lt; 3 then return money("office3", Config.OFFICES[3].name .. " " .. Ops.money(Config.OFFICES[3].price), Config.OFFICES[3].price) end
	local region = false
	if typeof(e.deals) == "table" and typeof(e.deals.accounts) == "table" then
		for id in e.deals.accounts do local c = Ops.client(id); if c and c.trip ~= "city" then region = true end end
	end
	if not region then return { id = "region", text = "First region client", have = 0, need = 1 } end
	if office &lt; 4 then return money("office4", Config.OFFICES[4].name .. " " .. Ops.money(Config.OFFICES[4].price), Config.OFFICES[4].price) end
	if not e.research.frontier then return { id = "frontier", text = "Frontier research (7B)", have = 0, need = 1 } end
	if office &lt; 5 then return money("office5", Config.OFFICES[5].name .. " " .. Ops.money(Config.OFFICES[5].price), Config.OFFICES[5].price) end
	local strong = 0
	for _, m in lines do if (m.overall or 0) &gt;= 90 then strong += 1 end end
	if strong &lt; 4 then return { id = "lines90", text = "All 4 lines at 90+", have = strong, need = 4 } end
	local lab = math.floor(tonumber(e.labLevel) or 0)
	if lab &lt; Ops.LAB_MAX then return { id = "lab", text = "Lab level " .. Ops.LAB_MAX, have = lab, need = Ops.LAB_MAX } end
	if e.jet ~= true then return money("jet", "Company jet " .. Ops.money(Ops.JET.price), Ops.JET.price) end
	return nil
end
function Math.eligible(model: any, contract: any): boolean
	return model.status == "live" and (model.stats[contract.stat] or 0) &gt;= contract.minimum
		and (contract.focus == nil or model.focusId == contract.focus)
end
return Math
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000001"><Properties><string name="Name">AircraftModel</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- AircraftModel: generic airliners built from anchored parts (no meshes required, no asset ids, no real brands).
-- Two types with real-world proportions (assets/vehicles/skyliner320|380/manifest.json, 1 stud = 0.28 m):
--   kind "320" (default): narrow-body twin, 134.2 x 127.9 x 42.1 studs at real size;
--   kind "380": double-deck quad, 259.7 x 284.8 x 86.0 studs at real size.
-- Shape: circular (320) / two-circle oval (380) barrel from Cylinder parts; nose, tail cone and wing-body
-- fairing from a few long, overlapping ellipsoids (SpecialMesh Sphere; few slices = few crease lines);
-- wings, winglets, stabilisers and fin are exact planforms built from right-triangle WedgeParts (any
-- triangle = 2 wedges), swept, tapered, with dihedral;
-- underwing engines (intake lip, fan disc with blades and spinner, nacelle, core, exhaust plug, pylon),
-- individual windows (320) or window bands (380), door outlines ("Outline"), cheatline, landing gear,
-- nav/beacon lights. The 320 (full LOD) has a glazed cockpit: a canopy lattice over the lower nose with an
-- airliner's window band - two front panes (V, centre post) and two side windows per side, all exact
-- see-through quads, opaque roof above a dark window surround - plus seats, pedestal, glareshield and an
-- instrument panel with primary flight / navigation displays, so seated pilots show from outside
-- (tests/flight/test_aircraft checks the lines of sight to both heads from the gate A1 lounge).
-- Frame (unchanged contract): nose towards -Z (the CFrame's LookVector), +Y up, origin on the ground (tyre
-- contact) on the centre line - 320: fuselage midpoint; 380: main-gear centroid (same as the Blender FBX).
-- Options (all optional, compatible with the old 25-part model):
--   scale    1 = the old 66-stud reference length for the 320 (callers keep their sizes);
--            AircraftModel.REAL_SCALE = real size (134.2 studs for the 320).
--   livery   tail fin, cheatline, nacelles, winglets;  body: fuselage colour;  collide: fuselage, wings,
--            engines and gear collide (default false = pure decoration);  name: Model name.
--   kind     "320" | "380";  lod "full" (&lt;= ~350 parts) | "medium" (~75) | "low" (&lt;= 30);
--   airline  title text on the fuselage + tail letters (e.g. "AI Empire Air", "Meridian Air"); nil = none;
--   mesh     false = never use an imported mesh.
-- Imported meshes: if ReplicatedStorage.Assets.Aircraft.&lt;Skyliner320|Skyliner380&gt; (or the manifest's
-- ReplicatedStorage.VehicleAssets.&lt;Name&gt;) exists - the owner imported the Blender FBX in Studio - and lod is
-- "full", a scaled, anchored clone is used instead of the parts (see assets/vehicles/IMPORT_IN_ROBLOX.md).
-- Every model gets an invisible PrimaryPart "AircraftRoot" at the origin with Attachments for boarding:
-- DoorL1 (door centre, facing out; attributes BoardingDoor = true and DoorHalf = half door height - the
-- airport package's jet bridges dock there), DoorR1, DoorL2, CaptainSeat, FirstOfficerSeat (rig root of a
-- seated pilot), CockpitCamera (jump seat behind the pilots), CabinCamera (window seat ahead of the wing
-- root, looking out at the wing and the horizon), CabinSeat1..6
-- (AircraftModel.points(kind, scale) returns the same local CFrames plus noseGearZ/doorHalf/cabin data
-- without building anything).
-- Client helpers: parts with attribute Spin (fan discs/blades, axis = local X of the "Fan" disc) and Gear
-- (landing gear) let animators spin the fans and hide the gear in flight (AircraftMover). Decorative parts
-- never collide, touch or query and cast no shadow.
-- AircraftModel.buildHelicopter: the VIP helicopter (~47 parts, rotors with attribute Rotor = main | tail).
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local AircraftModel={}
export type Options={scale: number?,livery: Color3?,body: Color3?,collide: boolean?,name: string?,kind: string?,lod: string?,airline: string?,mesh: boolean?}
export type Points={doorL1: CFrame,doorR1: CFrame,doorL2: CFrame,captain: CFrame,firstOfficer: CFrame,cockpitCamera: CFrame,cabinCamera: CFrame,
	cabinSeats: {CFrame},cabin: {floorY: number,ceilingY: number,wallX: number,z1: number,z2: number,windowY: number},
	length: number,span: number,height: number,noseZ: number,tailZ: number,mainGearZ: number,noseGearZ: number,doorHalf: number}
AircraftModel.REAL_SCALE=134.18/66
local LEGACY=66/134.18 -- scale 1 = the old 66-stud aircraft
local MESH_NAMES: {[string]: string}={["320"]="Skyliner320",["380"]="Skyliner380"}
local rgb=Color3.fromRGB
local WINDOW=rgb(30,38,48)
local GLASS=rgb(34,48,62)
local INK=rgb(36,38,42)
local METAL=rgb(150,154,160)
local LIP=rgb(206,210,214)
local WING=rgb(208,212,218)
local BELLY=rgb(196,202,208)
local GOLD=rgb(212,170,72)

------------------------------------------------------------------------------------------------ types
type Sample={z: number,top: number,bot: number,hw: number,c: number?}
type Station={x: number,le: number,te: number,t: number}
type Engine={x: number,y: number,zf: number,len: number,dia: number,fan: number}
type Spec={
	key: string,length: number,span: number,height: number,noseZ: number,tailZ: number,
	circles: {{y: number,r: number}},barrel: {number},belly: {Vector3},
	nose: {Sample},tail: {Sample},wing: {Station},wingY: number,dihedral: number,
	winglet: {h: number,cant: number,topLe: number,topTe: number,fence: boolean},
	engines: {Engine},hstab: {Station},hstabY: {number},fin: {{y: number,le: number,te: number,t: number}},
	gear: {noseZ: number,noseTop: number,noseD: number,mainX: {number},mainZ: {number},mainTop: number,mainD: number,bogie: {number}},
	decks: {{y: number,z1: number,z2: number,pitch: number,w: number,h: number,band: boolean}},
	doors: {{z: number,y: number,w: number,h: number}},stripeY: number,titleY: number,titleZ: number,
	cockpit: boolean,points: Points,noseFine: {Sample}?,tailFine: {Sample}?,
}
local function sample(z: number,top: number,bot: number,hw: number,c: number?): Sample return {z=z,top=top,bot=bot,hw=hw,c=c} end
local function station(x: number,le: number,te: number,t: number): Station return {x=x,le=le,te=te,t=t} end

