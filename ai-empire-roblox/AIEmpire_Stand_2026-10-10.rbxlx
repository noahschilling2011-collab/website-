	doorL1=CFrame.lookAt(Vector3.new(-12.6,13.6,-90.5),Vector3.new(-30,13.6,-90.5)),doorR1=CFrame.lookAt(Vector3.new(12.6,13.6,-90.5),Vector3.new(30,13.6,-90.5)),
	doorL2=CFrame.lookAt(Vector3.new(-12.4,27.4,-80),Vector3.new(-30,27.4,-80)),
	captain=CFrame.new(-2.4,22.2,-114.5),firstOfficer=CFrame.new(2.4,22.2,-114.5),
	cockpitCamera=CFrame.lookAt(Vector3.new(0,24.2,-110),Vector3.new(0,22,-140)),
	cabinCamera=CFrame.lookAt(Vector3.new(-10.6,15.2,-20),Vector3.new(-60,8,-8)),
	cabinSeats=seatRows({-10.6,-8.9,8.9,10.6},{-20,-17.4,-14.8},12.6),
	cabin={floorY=10.8,ceilingY=21.0,wallX=11.9,z1=-90,z2=48,windowY=15.6},
	length=259.73,span=284.82,height=86.04,noseZ=-126.79,tailZ=132.95,mainGearZ=0,noseGearZ=-100,doorHalf=3.4,
}
local function scaled(cf: CFrame,k: number): CFrame return CFrame.new(cf.Position*k)*cf.Rotation end
-- Local CFrames (model space, studs at the requested scale) for boarding, seats and cameras.
function AircraftModel.points(kind: string?,scale: number?): Points
	local spec=SPECS[kind or "320"] or SPECS["320"]
	local k=(scale or 1)*LEGACY
	local p=spec.points
	local seats: {CFrame}={}
	for _,c in p.cabinSeats do table.insert(seats,scaled(c,k)) end
	local c=p.cabin
	return {doorL1=scaled(p.doorL1,k),doorR1=scaled(p.doorR1,k),doorL2=scaled(p.doorL2,k),captain=scaled(p.captain,k),firstOfficer=scaled(p.firstOfficer,k),
		cockpitCamera=scaled(p.cockpitCamera,k),cabinCamera=scaled(p.cabinCamera,k),cabinSeats=seats,
		cabin={floorY=c.floorY*k,ceilingY=c.ceilingY*k,wallX=c.wallX*k,z1=c.z1*k,z2=c.z2*k,windowY=c.windowY*k},
		length=p.length*k,span=p.span*k,height=p.height*k,noseZ=p.noseZ*k,tailZ=p.tailZ*k,mainGearZ=p.mainGearZ*k,noseGearZ=p.noseGearZ*k,doorHalf=p.doorHalf*k}
end
function AircraftModel.kinds(): {string} return {"320","380"} end

------------------------------------------------------------------------------------------------ builder state
type Ctx={m: Model,cf: CFrame,k: number,collide: boolean,count: number,spec: Spec}
local function finishPart(ctx: Ctx,p: BasePart,lcf: CFrame,color: Color3,material: Enum.Material?,solid: boolean?,shadow: boolean?)
	p.Anchored=true;p.CFrame=ctx.cf*lcf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
	p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	if not (solid and ctx.collide) then p.CanCollide=false;p.CanTouch=false;p.CanQuery=false end
	p.CastShadow=shadow==true
	p.Parent=ctx.m;ctx.count+=1
end
-- Box (or cylinder) in model space: size and position in real studs, scaled by ctx.k.
type PartOpts={solid: boolean?,shadow: boolean?,shape: Enum.PartType?,material: Enum.Material?,transparency: number?}
local function part(ctx: Ctx,name: string,size: Vector3,lcf: CFrame,color: Color3,opts: PartOpts?): Part
	local o: PartOpts=opts or {}
	local p=Instance.new("Part");p.Name=name
	if o.shape then p.Shape=o.shape end
	p.Size=size*ctx.k
	if o.transparency then p.Transparency=o.transparency end
	finishPart(ctx,p,CFrame.new(lcf.Position*ctx.k)*lcf.Rotation,color,o.material,o.solid,o.shadow)
	return p
end
local ALONG=CFrame.Angles(0,math.pi/2,0) -- cylinder axis (local X) along the aircraft (Z)
local function cylZ(ctx: Ctx,name: string,len: number,dia: number,pos: Vector3,color: Color3,solid: boolean?,material: Enum.Material?): Part
	return part(ctx,name,Vector3.new(len,dia,dia),CFrame.new(pos)*ALONG,color,{solid=solid,shadow=solid,shape=Enum.PartType.Cylinder,material=material})
end
local function ellipsoid(ctx: Ctx,name: string,center: Vector3,semi: Vector3,color: Color3,shadow: boolean?): Part
	local p=part(ctx,name,semi*2,CFrame.new(center),color,{shadow=shadow})
	local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p
	return p
end
-- Right triangle as one WedgePart: r = right-angle corner, a = end of the leg along local -Z, b = end of the
-- leg along local +Y; thickness along the normal (WedgePart: vertical face at +Z, slope towards -Z).
local function rightTri(ctx: Ctx,name: string,r: Vector3,a: Vector3,b: Vector3,t: number,color: Color3,solid: boolean?,material: Enum.Material?)
	local la,lb=(a-r).Magnitude,(b-r).Magnitude
	if la&lt;0.03 or lb&lt;0.03 then return end
	local y=(b-r)/lb;local z=-(a-r)/la
	local x=y:Cross(z)
	local w=Instance.new("WedgePart");w.Name=name
	w.Size=Vector3.new(t,lb,la)*ctx.k
	local center=(r+y*(lb/2)-z*(la/2))*ctx.k
	finishPart(ctx,w,CFrame.fromMatrix(center,x,y,z),color,material,solid,solid)
end
-- Any triangle = two right triangles split at the foot of the altitude onto the longest side.
local function tri(ctx: Ctx,name: string,a: Vector3,b: Vector3,c: Vector3,t: number,color: Color3,solid: boolean?,material: Enum.Material?)
	local p,q,v=a,b,c
	local ab,bc,ca=(b-a).Magnitude,(c-b).Magnitude,(a-c).Magnitude
	if bc&gt;=ab and bc&gt;=ca then p,q,v=b,c,a elseif ca&gt;=ab and ca&gt;=bc then p,q,v=c,a,b end
	local d=q-p;local len=d.Magnitude
	if len&lt;0.05 then return end
	local u=d/len
	local h=p+u*math.clamp((v-p):Dot(u),0,len)
	rightTri(ctx,name,h,p,v,t,color,solid,material)
	rightTri(ctx,name,h,q,v,t,color,solid,material)
end
local function quad(ctx: Ctx,name: string,a: Vector3,b: Vector3,c: Vector3,d: Vector3,t: number,color: Color3,solid: boolean?,material: Enum.Material?)
	tri(ctx,name,a,b,c,t,color,solid,material);tri(ctx,name,a,c,d,t,color,solid,material)
end

------------------------------------------------------------------------------------------------ hull surface
-- Half-width of the hull at height y and station z (max over the barrel circles and every ellipsoid sample).
local function ellX(s: Sample,y: number,z: number,c: number): number?
	local cy=(s.top+s.bot)/2;local b=(s.top-s.bot)/2
	local q=1-((y-cy)/b)^2-((z-s.z)/c)^2
	if q&lt;=0 then return nil end
	return s.hw*math.sqrt(q)
end
local function sampleC(list: {Sample},i: number): number
	local s=list[i]
	if s.c then return s.c end
	local n=list[i+1] or list[i-1]
	return math.abs(n.z-s.z)*1.6
end
local function surfX(spec: Spec,y: number,z: number): number?
	local best: number?=nil
	if z&gt;=spec.barrel[1] and z&lt;=spec.barrel[2] then
		for _,c in spec.circles do
			local dy=y-c.y
			if math.abs(dy)&lt;c.r then local x=math.sqrt(c.r*c.r-dy*dy);if not best or x&gt;best then best=x end end
		end
	end
	for _,list in {spec.noseFine or spec.nose,spec.tailFine or spec.tail} do
		for i,s in list do
			local x=ellX(s,y,z,sampleC(list,i))
			if x and (not best or x&gt;best) then best=x end
		end
	end
	return best
end
-- Outward point + normal on side `side` (-1 left, +1 right) at (y, z); normal from finite differences.
local function surface(spec: Spec,side: number,y: number,z: number): (Vector3?,Vector3?)
	local x=surfX(spec,y,z);if not x then return nil,nil end
	local e=0.15
	local xu,xd=surfX(spec,y+e,z) or x,surfX(spec,y-e,z) or x
	local xf,xb=surfX(spec,y,z+e) or x,surfX(spec,y,z-e) or x
	local dxdy=(xu-xd)/(2*e);local dxdz=(xf-xb)/(2*e)
	local n=Vector3.new(side,-dxdy,-dxdz).Unit
	return Vector3.new(side*x,y,z),n
end
-- Thin plate on the hull: centre (y, z), size along the surface (up, along z), lifted `lift` off the skin.
local function skin(ctx: Ctx,name: string,side: number,y: number,z: number,up: number,len: number,color: Color3,thick: number?,lift: number?,material: Enum.Material?,transparency: number?): Part?
	local p,n=surface(ctx.spec,side,y,z)
	if not p or not n then return nil end
	local zAxis=Vector3.new(0,0,1);zAxis=(zAxis-n*n:Dot(zAxis)).Unit
	local yAxis=zAxis:Cross(n)
	local t=thick or 0.1
	local pos=(p+n*((lift or 0.02)+t/2))
	local cf=CFrame.fromMatrix(pos*ctx.k,n,yAxis,zAxis)
	local q=Instance.new("Part");q.Name=name;q.Size=Vector3.new(t,up,len)*ctx.k
	if transparency then q.Transparency=transparency end
	finishPart(ctx,q,cf,color,material,false,false)
	return q
end
-- A strip following the hull between stations z1 and z2 at height y (split into `n` flat pieces).
local function strip(ctx: Ctx,name: string,y1: number,y2: number,z1: number,z2: number,height: number,color: Color3,n: number,material: Enum.Material?)
	for side=-1,1,2 do
		for i=0,n-1 do
			local a,b=i/n,(i+1)/n
			local za,zb=z1+(z2-z1)*a,z1+(z2-z1)*b
			local ya,yb=y1+(y2-y1)*a,y1+(y2-y1)*b
			local pa=surface(ctx.spec,side,ya,za);local pb=surface(ctx.spec,side,yb,zb)
			local pm,nm=surface(ctx.spec,side,(ya+yb)/2,(za+zb)/2)
			if pa and pb and pm and nm then
				local dir=(pb-pa);local len=dir.Magnitude
				if len&gt;0.05 then
					local zAxis=dir/len;local xAxis=(nm-zAxis*nm:Dot(zAxis)).Unit;local yAxis=zAxis:Cross(xAxis)
					local pos=(pa+pb)/2+xAxis*0.08
					local q=Instance.new("Part");q.Name=name;q.Size=Vector3.new(0.08,height,len+0.05)*ctx.k
					finishPart(ctx,q,CFrame.fromMatrix(pos*ctx.k,xAxis,yAxis,zAxis),color,material,false,false)
				end
			end
		end
	end
end
-- Text carrier: an invisible plate on the hull with a SurfaceGui on its outward (Front) face, reading
-- nose -&gt; tail on the left side and tail -&gt; nose on the right side like real titles.
local function title(ctx: Ctx,name: string,side: number,center: Vector3,normal: Vector3,width: number,height: number,text: string,color: Color3)
	local d=Vector3.new(0,0,if side&lt;0 then 1 else -1)
	local up=normal:Cross(d).Unit*(if side&lt;0 then 1 else -1)
	if up.Y&lt;0 then up=-up end
	local xAxis=-d;local zAxis=xAxis:Cross(up)
	if zAxis:Dot(normal)&gt;0 then zAxis=-zAxis;xAxis=-xAxis end
	local q=Instance.new("Part");q.Name=name;q.Size=Vector3.new(width,height,0.05)*ctx.k;q.Transparency=1
	finishPart(ctx,q,CFrame.fromMatrix((center+normal*0.12)*ctx.k,xAxis,up,zAxis),color,nil,false,false)
	local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Front;g.LightInfluence=1;g.CanvasSize=Vector2.new(width*40,height*40);g.Parent=q
	local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1);t.Text=text;t.TextScaled=true
	t.Font=Enum.Font.BuilderSansBold;t.TextColor3=color;t.Parent=g
end

------------------------------------------------------------------------------------------------ components
local function buildHull(ctx: Ctx,body: Color3,detail: number)
	local spec=ctx.spec
	local b1,b2=spec.barrel[1],spec.barrel[2]
	for i,c in spec.circles do
		cylZ(ctx,if i==1 then "Fuselage" else "UpperDeck",b2-b1,c.r*2,Vector3.new(0,c.y,(b1+b2)/2),body,true)
	end
	local function loft(list: {Sample},name: string,step: number)
		for i=1,#list,step do
			local s=list[i];local c=sampleC(list,i)*(if step&gt;1 then 1.35 else 1)
			ellipsoid(ctx,name,Vector3.new(0,(s.top+s.bot)/2,s.z),Vector3.new(s.hw,(s.top-s.bot)/2,c),body,i&lt;=2)
		end
	end
	if detail&gt;=2 then
		loft(spec.noseFine or spec.nose,"Nose",1)
		loft(spec.tailFine or spec.tail,"TailCone",1)
	else
		loft(spec.nose,"Nose",2)
		loft(spec.tail,"TailCone",2)
	end
	ellipsoid(ctx,"BellyFairing",spec.belly[1],spec.belly[2],BELLY,true)
end
-- Glazed cockpit (320 full detail): the upper nose is a canopy lattice (5 stations x 3 bands per side) over
-- the lower nose ellipsoids, closed at the front by a fan of triangles from the windshield base (apex).
-- The window band (10..62 degrees, 0 = side, 90 = crown) is glass on the first two segments (the sliding and
-- the rear side window) and in the front fan (the two front panes, which reach up to 80 degrees and meet at
-- a narrow dark centre post); the roof above and the cheeks below are opaque skin; a dark surround runs along
-- the top of the glazing. Glass panes are exact quads / triangles (wedges), so no gaps open at their edges;
-- skin plates are boxes as wide as the wider edge of their quad. A dark glareshield, an instrument panel with
-- two primary flight displays (sky / ground) and two navigation displays, seat backs and the rear bulkhead
-- give the view depth.
local CANOPY_Z={-61.6,-58.9,-56.2,-53.0,-49.4}
local CANOPY_HW={4.9,5.9,6.55,7.0,7.2} -- half-width at the canopy centre line
local CANOPY_YC={12.7,13.0,13.3,13.55,13.7} -- canopy ellipse centre height
local CANOPY_TOP={18.4,19.5,20.2,20.6,20.9} -- crown height
local CANOPY_TH={-30,10,62,90} -- band angles (degrees); the window band is band 2
local CANOPY_APEX=Vector3.new(0,14.4,-63.6) -- windshield base on the centre line
local FRONT_TOP=80 -- the front panes reach up to this angle on the first ring; above it the centre post
local COCKPIT_GLASS_T=0.62 -- see-through enough that the seated pilots read from the apron, still reads as tinted glass
local function buildCockpit(ctx: Ctx,body: Color3)
	local frame=rgb(40,44,52)
	local function plate(name: string,a: Vector3,b: Vector3,c: Vector3,d: Vector3,color: Color3,thick: number)
		-- quad a-b-c-d (a-b bottom edge, d-c top edge) as one thin box through its centre, as wide as its wider
		-- edge and slightly oversized so neighbours close up
		local center=(a+b+c+d)/4
		local right=((b-a)+(c-d))/2;local upv=((d-a)+(c-b))/2
		local n=right:Cross(upv)
		if n.Magnitude&lt;1e-4 then return end
		n=n.Unit
		local xAxis=right.Unit;local yAxis=n:Cross(xAxis)
		local w=math.max((b-a).Magnitude,(c-d).Magnitude)
		local p=Instance.new("Part");p.Name=name
		p.Size=Vector3.new(w+0.14,math.abs(upv:Dot(yAxis))+0.14,thick)*ctx.k
		finishPart(ctx,p,CFrame.fromMatrix(center*ctx.k,xAxis,yAxis,-n),color,nil,false,false)
	end
	local function glassTri(name: string,a: Vector3,b: Vector3,c: Vector3)
		-- exact triangle, 0.03 studs inside the skin and 2 % larger so its edges tuck under the frame
		local m=(a+b+c)/3
		local n=(b-a):Cross(c-a)
		local inward=if n.Magnitude&gt;1e-5 then n.Unit else Vector3.zero
		if inward:Dot(m-Vector3.new(0,13.5,m.Z+6))&gt;0 then inward=-inward end -- point into the cockpit
		local function g(v: Vector3): Vector3 return m+(v-m)*1.02+inward*0.03 end
		tri(ctx,name,g(a),g(b),g(c),0.1,GLASS,false,Enum.Material.Glass)
	end
	local function P(k: number,deg: number,side: number): Vector3
		local th=math.rad(deg)
		local yc=CANOPY_YC[k];local b=if th&gt;=0 then CANOPY_TOP[k]-yc else 3.2
		return Vector3.new(side*CANOPY_HW[k]*math.cos(th),yc+b*math.sin(th),CANOPY_Z[k])
	end
	local function stripAlong(name: string,a: Vector3,b: Vector3,w: number,color: Color3)
		local mid=(a+b)/2;local d=b-a
		local out=Vector3.new(mid.X,mid.Y-13.5,-2)
		out=if out.Magnitude&gt;1e-3 then out.Unit else Vector3.new(0,1,0)
		local q=Instance.new("Part");q.Name=name
		q.Size=Vector3.new(w,0.06,d.Magnitude+0.1)*ctx.k
		local z=d.Unit;local y=out-z*out:Dot(z);y=y.Unit;local x=y:Cross(z)
		finishPart(ctx,q,CFrame.fromMatrix((mid+y*0.05)*ctx.k,x,y,z),color,nil,false,false)
	end
	for side=-1,1,2 do
		for k=1,#CANOPY_Z-1 do
			for j=1,#CANOPY_TH-1 do
				local a0,a1=CANOPY_TH[j],CANOPY_TH[j+1]
				local pa,pb,pc,pd=P(k,a0,side),P(k+1,a0,side),P(k+1,a1,side),P(k,a1,side)
				if j==2 and k&lt;=2 then
					glassTri("CockpitSideWindow",pa,pb,pc);glassTri("CockpitSideWindow",pa,pc,pd)
				else
					plate("CockpitSkin",pa,pb,pc,pd,body,0.3)
				end
			end
		end
		-- front fan from the windshield base: cheek, front pane (two triangles), centre post
		tri(ctx,"CockpitSkin",CANOPY_APEX,P(1,CANOPY_TH[1],side),P(1,CANOPY_TH[2],side),0.3,body,false)
		glassTri("Windshield",CANOPY_APEX,P(1,CANOPY_TH[2],side),P(1,CANOPY_TH[3],side))
		glassTri("Windshield",CANOPY_APEX,P(1,CANOPY_TH[3],side),P(1,FRONT_TOP,side))
		tri(ctx,"WindshieldPost",CANOPY_APEX,P(1,FRONT_TOP,side),P(1,90,side),0.3,frame,false)
		-- window pillars: A (front pane | sliding window), B, C (behind the rear side window)
		for k=1,3 do
			local a,b=P(k,CANOPY_TH[2],side),P(k,CANOPY_TH[3],side)
			local mid=(a+b)/2;local up=(b-a)
			part(ctx,"CockpitPillar",Vector3.new(0.34,up.Magnitude+0.1,0.34),CFrame.lookAt(mid,mid+up)*CFrame.Angles(-math.pi/2,0,0),frame)
		end
		-- dark surround along the top of the glazing
		stripAlong("WindowSurround",P(1,CANOPY_TH[3],side),P(2,CANOPY_TH[3],side),0.5,frame)
		stripAlong("WindowSurround",P(2,CANOPY_TH[3],side),P(3,CANOPY_TH[3],side),0.5,frame)
		stripAlong("WindowSurround",P(1,CANOPY_TH[3],side),P(1,FRONT_TOP,side),0.45,frame)
	end
	for _,d in ctx.m:GetChildren() do
		if d:IsA("BasePart") and (d.Name=="Windshield" or d.Name=="CockpitSideWindow") then d.Transparency=COCKPIT_GLASS_T end
	end
	-- interior (dark, so every view through the glass reads as a cockpit, never as a hole)
	local wall=rgb(120,124,130) -- light enough that the pilots' dark uniforms stand out against it
	part(ctx,"CockpitBulkhead",Vector3.new(10.4,6.6,0.3),CFrame.new(0,15.0,-50.2),wall)
	part(ctx,"CockpitBulkheadTop",Vector3.new(5.6,2.0,0.3),CFrame.new(0,19.0,-50.2),wall)
	part(ctx,"Glareshield",Vector3.new(7.0,0.5,2.0),CFrame.new(0,15.0,-60.6),rgb(26,28,32))
	-- instrument panel: a dark panel with a primary flight display (sky over ground) and a navigation display
	-- (dark, magenta route) in front of each pilot
	local panelCf=CFrame.new(0,15.55,-59.55)*CFrame.Angles(math.rad(-20),0,0)
	part(ctx,"InstrumentPanel",Vector3.new(6.4,0.9,0.08),panelCf,rgb(38,40,46))
	for _,side in {-1,1} do
		local pfd=panelCf*CFrame.new(side*2.35,0,0.05)
		local nd=panelCf*CFrame.new(side*1.05,0,0.05)
		part(ctx,"PanelScreen",Vector3.new(1.05,0.62,0.04),pfd,rgb(14,16,20))
		part(ctx,"PanelScreen",Vector3.new(1.05,0.62,0.04),nd,rgb(14,16,20))
		part(ctx,"DisplaySky",Vector3.new(0.62,0.26,0.02),pfd*CFrame.new(0,0.12,0.03),rgb(52,128,214),{material=Enum.Material.Neon})
		part(ctx,"DisplayGround",Vector3.new(0.62,0.24,0.02),pfd*CFrame.new(0,-0.13,0.03),rgb(132,86,46),{material=Enum.Material.Neon})
		part(ctx,"DisplayRoute",Vector3.new(0.06,0.44,0.02),nd*CFrame.new(0.05,0.02,0.03)*CFrame.Angles(0,0,math.rad(-14)),rgb(228,70,210),{material=Enum.Material.Neon})
	end
	part(ctx,"Pedestal",Vector3.new(1.3,1.0,3.0),CFrame.new(0,14.5,-58.6),rgb(58,60,66))
	part(ctx,"ThrustLevers",Vector3.new(0.9,0.5,0.25),CFrame.new(0,15.2,-58.9)*CFrame.Angles(math.rad(-25),0,0),rgb(28,30,34))
	for _,x in {-1.9,1.9} do
		part(ctx,"PilotSeat",Vector3.new(1.8,0.7,1.8),CFrame.new(x,14.0,-57.5),rgb(34,36,40))
		part(ctx,"PilotSeatBack",Vector3.new(1.8,3.4,0.45),CFrame.new(x,16.0,-56.35)*CFrame.Angles(math.rad(-8),0,0),rgb(34,36,40))
		part(ctx,"Headrest",Vector3.new(1.3,0.8,0.5),CFrame.new(x,18.05,-56.05),rgb(40,42,48))
	end
end
local function buildWindows(ctx: Ctx,body: Color3,detail: number)
	local spec=ctx.spec
	for _,deck in spec.decks do
		if detail&gt;=2 and not deck.band then
			local z=deck.z1
			while z&lt;=deck.z2 do
				local blocked=false
				for _,d in spec.doors do if math.abs(z-d.z)&lt;d.w/2+0.6 and d.h&gt;4 then blocked=true end end
				if not blocked then for side=-1,1,2 do skin(ctx,"Window",side,deck.y,z,deck.h,deck.w,WINDOW,0.1,0.01) end end
				z+=deck.pitch
			end
		else
			-- window bands, broken at the doors of this deck
			local cuts: {number}={}
			for _,d in spec.doors do if math.abs(d.y-deck.y)&lt;6 and d.z&gt;deck.z1 and d.z&lt;deck.z2 then table.insert(cuts,d.z) end end
			table.sort(cuts)
			local z0=deck.z1
			local pieces: {{number}}={}
			for _,cz in cuts do table.insert(pieces,{z0,cz-2.6});z0=cz+2.6 end
			table.insert(pieces,{z0,deck.z2})
			for _,pc in pieces do
				if pc[2]-pc[1]&gt;2 then
					local segs=if detail&gt;=2 then math.max(1,math.ceil((pc[2]-pc[1])/24)) else 1
					strip(ctx,"WindowBand",deck.y,deck.y,pc[1],pc[2],deck.h*0.85,WINDOW,segs)
				end
			end
		end
	end
	if detail&lt;2 then return end
	-- door outlines: two vertical edges (each two pieces following the hull) + top and bottom edges
	local line=body:Lerp(INK,0.35)
	for _,d in spec.doors do
		for side=-1,1,2 do
			for _,dz in {-d.w/2,d.w/2} do
				for _,f in {-0.25,0.25} do skin(ctx,"Outline",side,d.y+f*d.h,d.z+dz,d.h/2+0.05,0.16,line,0.05,0.03) end
			end
			for _,dy in {-d.h/2,d.h/2} do skin(ctx,"Outline",side,d.y+dy,d.z,0.16,d.w,line,0.05,0.03) end
		end
	end
end
local function buildLivery(ctx: Ctx,livery: Color3,airline: string?,detail: number)
	local spec=ctx.spec
	local y=spec.stripeY
	local b1,b2=spec.barrel[1],spec.barrel[2]
	local n=if detail&gt;=2 then 1 else 1
	strip(ctx,"Cheatline",y,y,b1+0.5,b2,if spec.key=="380" then 1.3 else 0.62,livery,n)
	if detail&gt;=2 then
		strip(ctx,"Pinstripe",y-0.62,y-0.62,b1+0.5,b2,0.2,GOLD,1)
		-- the cheatline sweeps up along the tail cone and runs forward under the cockpit
		local t1,t2=spec.tail[2].z,spec.tail[#spec.tail-2].z
		strip(ctx,"Cheatline",y,y+(spec.tail[#spec.tail-2].bot-spec.tail[2].bot)*0.75,b2,t2,if spec.key=="380" then 1.1 else 0.5,livery,3)
		local n1=spec.nose[3].z
		strip(ctx,"Cheatline",y+0.4,y,n1,b1+0.5,if spec.key=="380" then 1.1 else 0.5,livery,5)
		local _=t1
	end
	if airline and detail&gt;=2 then
		for side=-1,1,2 do
			local p,nrm=surface(spec,side,spec.titleY,spec.titleZ)
			if p and nrm then title(ctx,"Titles",side,p,nrm,if spec.key=="380" then 52 else 26,if spec.key=="380" then 4.4 else 2.1,string.upper(airline),livery) end
		end
	end
end
local function wingY(spec: Spec,x: number): number return spec.wingY+(x-spec.wing[1].x)*math.tan(spec.dihedral) end
local function buildWings(ctx: Ctx,livery: Color3,detail: number)
	local spec=ctx.spec
	local st=spec.wing
	for side=-1,1,2 do
		local function P(s: Station,edge: number): Vector3 return Vector3.new(side*s.x,wingY(spec,s.x),edge) end
		if detail&gt;=1 then
			local step=if detail&gt;=2 then 1 else (#st-1)
			local i=1
			while i&lt;#st do
				local a,b=st[i],st[math.min(i+step,#st)]
				quad(ctx,"Wing",P(a,a.le),P(a,a.te),P(b,b.te),P(b,b.le),(a.t+b.t)/2,WING,true)
				i+=step
			end
		else
			-- low detail: one rotated slab per wing
			local a,b=st[1],st[#st]
			local p1=Vector3.new(side*a.x,wingY(spec,a.x),(a.le+a.te)/2);local p2=Vector3.new(side*b.x,wingY(spec,b.x),(b.le+b.te)/2)
			local mid=(p1+p2)/2;local chord=((a.te-a.le)+(b.te-b.le))/2
			part(ctx,"Wing",Vector3.new((p2-p1).Magnitude,(a.t+b.t)/2,chord),CFrame.lookAt(mid,mid+(p2-p1).Unit:Cross(Vector3.new(0,1,0)))*CFrame.Angles(0,0,0),WING,{solid=true,shadow=true})
		end
		-- blended winglets (320) or wingtip fences (380)
		local tip=st[#st]
		local wl=spec.winglet
		local base=Vector3.new(side*tip.x,wingY(spec,tip.x),0)
		if detail&gt;=1 then
			local top=base.Y+wl.h
			quad(ctx,"Winglet",Vector3.new(base.X,base.Y,tip.le),Vector3.new(base.X,base.Y,tip.te),Vector3.new(base.X+side*wl.cant,top,wl.topTe),Vector3.new(base.X+side*wl.cant,top,wl.topLe),0.5,livery)
			if wl.fence then
				quad(ctx,"Winglet",Vector3.new(base.X,base.Y,tip.le),Vector3.new(base.X,base.Y,tip.te),Vector3.new(base.X,base.Y-wl.h*0.55,tip.te-2),Vector3.new(base.X,base.Y-wl.h*0.55,tip.le+3.5),0.5,livery)
			end
		end
		if detail&gt;=2 then
			-- flap track fairings under the trailing edge
			for f=1,3 do
				local x=st[1].x+(tip.x-st[1].x)*(0.2+f*0.18)
				local i=1;while i&lt;#st-1 and st[i+1].x&lt;x do i+=1 end
				local a,b=st[i],st[i+1];local u=(x-a.x)/(b.x-a.x)
				local te=a.te+(b.te-a.te)*u;local le=a.le+(b.le-a.le)*u;local chord=te-le
				ellipsoid(ctx,"FlapFairing",Vector3.new(side*x,wingY(spec,x)-chord*0.06,te-chord*0.2),Vector3.new(chord*0.035+0.25,chord*0.06+0.3,chord*0.32),WING:Lerp(INK,0.08))
			end
			-- navigation lights: red left, green right; strobe white at the tail
			part(ctx,"NavLight",Vector3.new(0.5,0.5,0.5),CFrame.new(base.X+side*0.2,base.Y+0.2,tip.le+0.6),if side&lt;0 then rgb(255,60,50) else rgb(60,255,120),{material=Enum.Material.Neon,shape=Enum.PartType.Ball})
		end
	end
end
local function buildEngines(ctx: Ctx,livery: Color3,detail: number)
	local spec=ctx.spec
	for _,e in spec.engines do
		for side=-1,1,2 do
			local x=side*e.x
			local zf=e.zf
			local bodyLen=e.len*0.6
			if detail&gt;=1 then
				cylZ(ctx,"EngineLip",e.len*0.04,e.dia*0.985,Vector3.new(x,e.y,zf+e.len*0.02),LIP,true,Enum.Material.Metal)
				cylZ(ctx,"Nacelle",bodyLen,e.dia,Vector3.new(x,e.y,zf+e.len*0.04+bodyLen/2),livery,true)
				cylZ(ctx,"NacelleAft",e.len*0.2,e.dia*0.86,Vector3.new(x,e.y,zf+e.len*0.74),livery,true)
				local fan=cylZ(ctx,"Fan",0.12,e.fan,Vector3.new(x,e.y,zf-0.02),rgb(44,46,50),false,Enum.Material.Metal);fan:SetAttribute("Spin",true)
				cylZ(ctx,"EngineCore",e.len*0.13,e.dia*0.56,Vector3.new(x,e.y-e.dia*0.03,zf+e.len*0.905),METAL,true,Enum.Material.Metal)
				ellipsoid(ctx,"ExhaustPlug",Vector3.new(x,e.y-e.dia*0.03,zf+e.len*0.98),Vector3.new(e.dia*0.17,e.dia*0.17,e.len*0.09),rgb(70,72,76))
				-- pylon from the nacelle top to the wing
				local wy=wingY(spec,e.x)
				local top=e.y+e.dia/2
				local h=math.max(0.6,wy-top+0.4)
				part(ctx,"Pylon",Vector3.new(e.dia*0.13,h+0.8,e.len*0.62),CFrame.new(x,top+h/2-0.3,zf+e.len*0.55),rgb(226,228,232),{shadow=true})
			else
				cylZ(ctx,"Nacelle",e.len,e.dia,Vector3.new(x,e.y,zf+e.len/2),livery,true)
			end
			if detail&gt;=2 then
				local spinner=ellipsoid(ctx,"Spinner",Vector3.new(x,e.y,zf-0.1),Vector3.new(e.fan*0.12,e.fan*0.12,e.fan*0.16),rgb(30,30,34));spinner:SetAttribute("Spin",true)
				for i=0,9 do
					local a=i*math.pi*2/10
					local r=e.fan*0.29
					local blade=part(ctx,"FanBlade",Vector3.new(e.fan*0.36,0.32,0.1),CFrame.new(x+math.cos(a)*r,e.y+math.sin(a)*r,zf-0.1)*CFrame.Angles(0,0,a)*CFrame.Angles(0.5,0,0),rgb(150,154,160),{material=Enum.Material.Metal})
					blade:SetAttribute("Spin",true)
				end
			end
		end
	end
end
local function buildTail(ctx: Ctx,livery: Color3,body: Color3,airline: string?,detail: number)
	local spec=ctx.spec
	local hs=spec.hstab
	for side=-1,1,2 do
		local a,b=hs[1],hs[#hs]
		local ya,yb=spec.hstabY[1],spec.hstabY[2]
		if detail&gt;=1 then
			quad(ctx,"Stabilizer",Vector3.new(side*a.x,ya,a.le),Vector3.new(side*a.x,ya,a.te),Vector3.new(side*b.x,yb,b.te),Vector3.new(side*b.x,yb,b.le),(a.t+b.t)/2,body)
		else
			local p1=Vector3.new(side*a.x,ya,(a.le+a.te)/2);local p2=Vector3.new(side*b.x,yb,(b.le+b.te)/2)
			local mid=(p1+p2)/2
			part(ctx,"Stabilizer",Vector3.new((p2-p1).Magnitude,0.6,((a.te-a.le)+(b.te-b.le))/2),CFrame.lookAt(mid,mid+(p2-p1).Unit:Cross(Vector3.new(0,1,0))),body)
		end
	end
	local f1,f2=spec.fin[1],spec.fin[2]
	if detail&gt;=1 then
		quad(ctx,"Fin",Vector3.new(0,f1.y,f1.le),Vector3.new(0,f1.y,f1.te),Vector3.new(0,f2.y,f2.te),Vector3.new(0,f2.y,f2.le),(f1.t+f2.t)/2,livery,true)
	else
		tri(ctx,"Fin",Vector3.new(0,f1.y,f1.le),Vector3.new(0,f1.y,f1.te),Vector3.new(0,f2.y,(f2.le+f2.te)/2),(f1.t+f2.t)/2,livery,true)
	end
	if detail&gt;=2 then
		-- dorsal fillet in front of the fin, anti-collision beacon, tail logo letters
		local fy=f1.y+(f2.y-f1.y)*0.14
		local fz=f1.le+(f2.le-f1.le)*0.14
		tri(ctx,"DorsalFin",Vector3.new(0,f1.y,f1.le-(f1.te-f1.le)*0.3),Vector3.new(0,f1.y,f1.le+1),Vector3.new(0,fy,fz),f1.t*0.7,livery)
		part(ctx,"Beacon",Vector3.new(0.6,0.35,0.9),CFrame.new(0,spec.circles[#spec.circles].y+spec.circles[#spec.circles].r+0.1,(spec.barrel[1]+spec.barrel[2])/2),rgb(255,60,50),{material=Enum.Material.Neon})
		part(ctx,"TailLight",Vector3.new(0.4,0.4,0.4),CFrame.new(0,spec.tail[#spec.tail].top-0.8,spec.tailZ-0.2),rgb(255,255,250),{material=Enum.Material.Neon,shape=Enum.PartType.Ball})
		if airline then
			local letters=string.upper(string.sub(airline,1,1))
			local first=string.match(airline,"^(%S+)")
			if first and #first&lt;=3 then letters=string.upper(first) end
			local h=(f2.y-f1.y)
			local cy=f1.y+h*0.55;local cz=f1.le+(f2.le-f1.le)*0.55+((f1.te-f1.le)+(f2.te-f2.le))*0.25
			for side=-1,1,2 do
				title(ctx,"TailLogo",side,Vector3.new(side*((f1.t+f2.t)/4+0.02),cy,cz),Vector3.new(side,0,0),h*0.42,h*0.3,letters,Color3.new(1,1,1))
			end
		end
	end
end
local function buildGear(ctx: Ctx,detail: number)
	local spec=ctx.spec
	local g=spec.gear
	local tyre=rgb(26,26,28)
	local strut=rgb(212,214,218)
	local function mark(p: BasePart) p:SetAttribute("Gear",true) end
	-- nose gear
	local nr=g.noseD/2
	if detail&gt;=1 then mark(part(ctx,"NoseGear",Vector3.new(g.noseD*0.18,g.noseTop-nr,g.noseD*0.18),CFrame.new(0,(g.noseTop+nr)/2,g.noseZ),strut,{shape=Enum.PartType.Block,shadow=true})) end
	local noseXs: {number}=if detail&gt;=1 then {-g.noseD*0.26,g.noseD*0.26} else {0}
	for _,x in noseXs do
		mark(part(ctx,"NoseWheel",Vector3.new(g.noseD*0.34,g.noseD,g.noseD),CFrame.new(x,nr,g.noseZ),tyre,{shape=Enum.PartType.Cylinder,solid=true,shadow=true}))
	end
	-- main gear legs (320: 2 x twin wheels; 380: 2 wing bogies x 4 + 2 body bogies x 6)
	local mr=g.mainD/2
	for i,mx in g.mainX do
		local axles=g.bogie[i]
		for side=-1,1,2 do
			local x=side*mx
			local z=g.mainZ[i]
			if detail&gt;=1 then
				mark(part(ctx,"MainGear",Vector3.new(g.mainD*0.16,g.mainTop-mr,g.mainD*0.16),CFrame.new(x,(g.mainTop+mr)/2,z),strut,{shadow=true}))
				if axles&gt;1 then mark(part(ctx,"Bogie",Vector3.new(g.mainD*0.14,g.mainD*0.14,axles*g.mainD*1.05),CFrame.new(x,mr,z),strut)) end
			end
			for a=1,axles do
				local az=z+(a-(axles+1)/2)*g.mainD*1.05
				local pair: {number}=if detail&gt;=1 then {-g.mainD*0.3,g.mainD*0.3} else {0}
				for _,dx in pair do
					mark(part(ctx,"MainWheel",Vector3.new(g.mainD*(if detail&gt;=1 then 0.3 else 0.5),g.mainD,g.mainD),CFrame.new(x+dx,mr,az),tyre,{shape=Enum.PartType.Cylinder,solid=true,shadow=true}))
				end
			end
		end
	end
end
local function cockpitWindowsPainted(ctx: Ctx,detail: number)
	-- closed (painted) cockpit windows on the nose for the 380 and the lower LODs
	local spec=ctx.spec
	local n=spec.nose
	local s=n[math.max(1,#n-3)]
	local y=s.top-(s.top-s.bot)*(if spec.key=="380" then 0.33 else 0.2)
	if detail&gt;=1 then
		for side=-1,1,2 do
			skin(ctx,"CockpitWindow",side,y,n[#n-3].z-0.6,(s.top-s.bot)*0.13,(n[#n-2].z-n[#n-4].z)*0.55,WINDOW,0.1,0.02)
			skin(ctx,"CockpitWindow",side,y,n[#n-2].z,(s.top-s.bot)*0.13,(n[#n-1].z-n[#n-3].z)*0.45,WINDOW,0.1,0.02)
		end
	end
	local f=n[3]
	local fy=f.top-(f.top-f.bot)*0.12
	local fz=f.z+0.25*(n[4].z-f.z)
	part(ctx,"CockpitWindow",Vector3.new(f.hw*1.3,(f.top-f.bot)*0.12,0.3),CFrame.new(0,fy,fz)*CFrame.Angles(math.rad(42),0,0),WINDOW)
end

------------------------------------------------------------------------------------------------ attachments
local function addPoints(m: Model,cf: CFrame,kind: string,scale: number,size: number): BasePart
	local root=Instance.new("Part");root.Name="AircraftRoot";root.Size=Vector3.new(1,1,1)*math.max(0.2,size);root.Transparency=1
	root.Anchored=true;root.CanCollide=false;root.CanTouch=false;root.CanQuery=false;root.CastShadow=false;root.CFrame=cf;root.Parent=m
	local pts=AircraftModel.points(kind,scale)
	local function att(name: string,c: CFrame) local a=Instance.new("Attachment");a.Name=name;a.CFrame=c;a.Parent=root end
	att("DoorL1",pts.doorL1);att("DoorR1",pts.doorR1);att("DoorL2",pts.doorL2)
	local l1=root:FindFirstChild("DoorL1");if l1 then l1:SetAttribute("BoardingDoor",true);l1:SetAttribute("DoorHalf",pts.doorHalf) end
	att("CaptainSeat",pts.captain);att("FirstOfficerSeat",pts.firstOfficer)
	att("CockpitCamera",pts.cockpitCamera);att("CabinCamera",pts.cabinCamera)
	for i,c in pts.cabinSeats do if i&lt;=6 then att("CabinSeat"..i,c) end end
	m.PrimaryPart=root
	return root
end

------------------------------------------------------------------------------------------------ meshes
-- The owner's imported FBX (Studio 3D Importer), if present: ReplicatedStorage.Assets.Aircraft.&lt;Name&gt; or
-- ReplicatedStorage.VehicleAssets.&lt;Name&gt;.
function AircraftModel.meshTemplate(kind: string?): Model?
	local name=MESH_NAMES[kind or "320"]
	if not name then return nil end
	local assets=ReplicatedStorage:FindFirstChild("Assets")
	local folder=if assets then assets:FindFirstChild("Aircraft") else nil
	local t=if folder then folder:FindFirstChild(name) else nil
	if not t then
		local va=ReplicatedStorage:FindFirstChild("VehicleAssets")
		t=if va then va:FindFirstChild(name) else nil
	end
	return if t and t:IsA("Model") then t else nil
end
local function fromMesh(template: Model,cf: CFrame,k: number,o: Options): Model
	local m=template:Clone()
	m.Name=o.name or template.Name
	for _,d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored=true
			local solid=o.collide==true and d.Name=="Fuselage"
			d.CanCollide=solid;d.CanTouch=false;d.CanQuery=solid
			if string.find(d.Name,"Fan") then d:SetAttribute("Spin",true) end
			if string.find(d.Name,"Gear") or string.find(d.Name,"Wheel") then d:SetAttribute("Gear",true) end
		end
	end
	m:PivotTo(CFrame.new())
	if math.abs(k-1)&gt;1e-3 then m:ScaleTo(k) end
	m:PivotTo(cf)
	m.WorldPivot=cf
	return m
end

------------------------------------------------------------------------------------------------ entry
function AircraftModel.build(parent: Instance?,cf: CFrame,opts: Options?): Model
	local o: Options=opts or {}
	local kind=if o.kind and SPECS[o.kind] then o.kind else "320"
	local spec=SPECS[kind]
	local scale=o.scale or 1
	local k=scale*LEGACY
	local lod=o.lod or "full"
	local detail=if lod=="low" then 0 elseif lod=="medium" then 1 else 2
	local body=o.body or rgb(240,241,238)
	local livery=o.livery or rgb(94,136,162)
	if detail==2 and o.mesh~=false then
		local template=AircraftModel.meshTemplate(kind)
		if template then
			local m=fromMesh(template,cf,k,o)
			addPoints(m,cf,kind,scale,k)
			m:SetAttribute("AircraftKind",kind);m:SetAttribute("AircraftMesh",true)
			m.Parent=parent
			return m
		end
	end
	local m=Instance.new("Model");m.Name=o.name or "Aircraft"
	local ctx: Ctx={m=m,cf=cf,k=k,collide=o.collide==true,count=0,spec=spec}
	buildHull(ctx,body,detail)
	if spec.cockpit and detail&gt;=2 then buildCockpit(ctx,body) else cockpitWindowsPainted(ctx,detail) end
	buildWindows(ctx,body,detail)
	buildLivery(ctx,livery,o.airline,detail)
	buildWings(ctx,livery,detail)
	buildEngines(ctx,livery,detail)
	buildTail(ctx,livery,body,o.airline,detail)
	buildGear(ctx,detail)
	addPoints(m,cf,kind,scale,k)
	m:SetAttribute("AircraftKind",kind);m:SetAttribute("AircraftLod",lod)
	m.WorldPivot=cf
	m.Parent=parent
	return m
end

------------------------------------------------------------------------------------------------ helicopter
-- VIP helicopter (twin-engine light helicopter look, ~38 studs long, rotor 32 studs) from ~40 parts, pure
-- decoration (never collides). Frame: nose -Z, skids on y = 0. Main rotor blades carry the attribute
-- Rotor = "main" (spin about +Y through the attribute RotorHub of the model, a Vector3 in model space),
-- tail rotor blades Rotor = "tail" (about the model X axis through TailHub). Options: livery (body colour),
-- trim, name, airline (small title on the tail boom).
export type HeliOptions={livery: Color3?,trim: Color3?,name: string?,airline: string?}
function AircraftModel.buildHelicopter(parent: Instance?,cf: CFrame,opts: HeliOptions?): Model
	local o: HeliOptions=opts or {}
	local body=o.livery or rgb(24,30,44)
	local trim=o.trim or GOLD
	local m=Instance.new("Model");m.Name=o.name or "Helicopter"
	local ctx: Ctx={m=m,cf=cf,k=1,collide=false,count=0,spec=SPECS["320"]}
	local glass=rgb(36,52,66)
	local metal=rgb(70,74,80)
	-- cabin and nose
	ellipsoid(ctx,"HeliCabin",Vector3.new(0,5.4,-1.5),Vector3.new(3.9,3.7,7.2),body,true)
	ellipsoid(ctx,"HeliBelly",Vector3.new(0,3.6,-0.5),Vector3.new(3.5,1.9,6.4),body:Lerp(INK,0.25))
	local nose=ellipsoid(ctx,"HeliNoseGlass",Vector3.new(0,5.9,-6.6),Vector3.new(3.15,2.75,3.6),glass)
	nose.Material=Enum.Material.Glass;nose.Transparency=0.25
	part(ctx,"HeliFrameBar",Vector3.new(0.25,0.25,5.4),CFrame.new(0,8.25,-6.1)*CFrame.Angles(math.rad(-22),0,0),body)
	-- side windows and doors (both sides)
	for _,side in {-1,1} do
		part(ctx,"HeliWindow",Vector3.new(0.12,2.1,3.0),CFrame.new(side*3.72,6.3,-2.6)*CFrame.Angles(0,0,side*math.rad(-6)),glass,{material=Enum.Material.Glass,transparency=0.2})
		part(ctx,"HeliWindow",Vector3.new(0.12,2.0,2.6),CFrame.new(side*3.62,6.25,0.8)*CFrame.Angles(0,0,side*math.rad(-6)),glass,{material=Enum.Material.Glass,transparency=0.2})
		part(ctx,"HeliTrim",Vector3.new(0.1,0.32,11.4),CFrame.new(side*3.86,4.55,-1.2),trim,{material=Enum.Material.Metal})
		-- skids: tube, two struts, upturned front
		part(ctx,"HeliSkid",Vector3.new(16,0.55,0.55),CFrame.new(side*3.3,0.3,-0.6)*ALONG,metal,{shape=Enum.PartType.Cylinder,material=Enum.Material.Metal})
		part(ctx,"HeliSkidTip",Vector3.new(2.4,0.5,0.5),CFrame.new(side*3.3,0.95,-9.2)*CFrame.Angles(math.rad(35),0,0)*ALONG,metal,{shape=Enum.PartType.Cylinder,material=Enum.Material.Metal})
		for _,z in {-4.4,3.0} do
			part(ctx,"HeliStrut",Vector3.new(0.4,3.4,0.6),CFrame.new(side*2.9,1.9,z)*CFrame.Angles(0,0,side*math.rad(14)),metal,{material=Enum.Material.Metal})
		end
		part(ctx,"HeliNavLight",Vector3.new(0.4,0.4,0.4),CFrame.new(side*1.3,7.2,15.6),if side&lt;0 then rgb(255,60,50) else rgb(60,255,120),{material=Enum.Material.Neon,shape=Enum.PartType.Ball})
	end
	-- engine deck, intakes, exhausts
	part(ctx,"HeliEngine",Vector3.new(4.4,2.0,7.4),CFrame.new(0,9.1,0.6),body:Lerp(Color3.new(1,1,1),0.08))
	ellipsoid(ctx,"HeliCowl",Vector3.new(0,9.6,-2.4),Vector3.new(2.2,1.1,2.6),body)
	for _,side in {-1,1} do
		cylZ(ctx,"HeliExhaust",1.4,1.0,Vector3.new(side*1.5,9.4,4.6),rgb(40,40,44),false,Enum.Material.Metal)
		part(ctx,"HeliIntake",Vector3.new(0.12,0.9,1.6),CFrame.new(side*2.22,9.4,-1.0),INK)
	end
	-- tail boom, fin, stabiliser
	cylZ(ctx,"HeliBoom",9.5,2.3,Vector3.new(0,6.6,9.6),body)
	cylZ(ctx,"HeliBoomAft",7.0,1.5,Vector3.new(0,7.1,16.6),body)
	tri(ctx,"HeliFin",Vector3.new(0,6.8,17.4),Vector3.new(0,6.8,20.6),Vector3.new(0,12.4,21.2),0.35,body)
	tri(ctx,"HeliFin",Vector3.new(0,6.8,18.6),Vector3.new(0,6.8,20.6),Vector3.new(0,3.9,20.8),0.35,body)
	part(ctx,"HeliStabilizer",Vector3.new(6.4,0.28,1.8),CFrame.new(0,7.0,15.4),body)
	cylZ(ctx,"HeliTailStripe",1.2,2.42,Vector3.new(0,6.6,12.6),trim)
	local beacon=part(ctx,"HeliBeacon",Vector3.new(0.6,0.35,0.6),CFrame.new(0,10.3,4.2),rgb(255,60,50),{material=Enum.Material.Neon})
	local _=beacon
	-- main rotor: mast, hub, 4 blades
	part(ctx,"HeliMast",Vector3.new(0.7,1.8,0.7),CFrame.new(0,10.9,0.4),metal,{material=Enum.Material.Metal})
	local hub=Vector3.new(0,11.9,0.4)
	part(ctx,"HeliHub",Vector3.new(1.6,0.6,1.6),CFrame.new(hub),rgb(40,42,46),{material=Enum.Material.Metal}):SetAttribute("Rotor","main")
	for i=0,3 do
		local a=i*math.pi/2+math.rad(20)
		local dir=Vector3.new(math.cos(a),0,math.sin(a))
		local blade=part(ctx,"HeliBlade",Vector3.new(15.4,0.14,1.05),CFrame.lookAt(hub+dir*8.2,hub+dir*8.2+dir:Cross(Vector3.new(0,1,0)))*CFrame.Angles(math.rad(4),0,0),rgb(34,36,40))
		blade:SetAttribute("Rotor","main")
	end
	-- tail rotor (left side of the fin), 2 blades
	local tailHub=Vector3.new(-0.6,10.2,20.5)
	part(ctx,"HeliTailHub",Vector3.new(0.5,0.5,0.5),CFrame.new(tailHub),metal,{shape=Enum.PartType.Ball}):SetAttribute("Rotor","tail")
	for _,a in {0,math.pi/2} do
		local blade=part(ctx,"HeliTailBlade",Vector3.new(0.1,4.6,0.5),CFrame.new(tailHub-Vector3.new(0.1,0,0))*CFrame.Angles(a,0,0),rgb(34,36,40))
		blade:SetAttribute("Rotor","tail")
	end
	if o.airline then
		for _,side in {-1,1} do
			title(ctx,"HeliTitle",side,Vector3.new(side*1.16,6.6,10.6),Vector3.new(side,0,0),6.4,0.9,string.upper(o.airline),Color3.new(1,1,1))
		end
	end
	local root=Instance.new("Part");root.Name="HeliRoot";root.Size=Vector3.new(1,1,1);root.Transparency=1;root.Anchored=true
	root.CanCollide=false;root.CanTouch=false;root.CanQuery=false;root.CastShadow=false;root.CFrame=cf;root.Parent=m
	local seat=Instance.new("Attachment");seat.Name="PassengerSeat";seat.CFrame=CFrame.new(1.6,5.6,0.6);seat.Parent=root
	local cam=Instance.new("Attachment");cam.Name="CabinCamera";cam.CFrame=CFrame.lookAt(Vector3.new(1.4,6.6,0.2),Vector3.new(12,2,-6));cam.Parent=root
	m.PrimaryPart=root
	m:SetAttribute("RotorHub",hub);m:SetAttribute("TailHub",tailHub);m:SetAttribute("AircraftKind","heli")
	m.WorldPivot=cf
	m.Parent=parent
	return m
end
return AircraftModel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000002"><Properties><string name="Name">BuildingLayout</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Derived geometry from BuildingPlan: unique interior wall segments with door openings, a flat
-- door list, circulation rectangles (corridors, galleries, lobbies) and slab outlines/holes.
-- Two rooms sharing a boundary produce ONE wall; the envelope and the lift shaft are excluded
-- because the facade and the core generator build them.
local Plan = require(script.Parent.Config.BuildingPlan)
local Layout = {}

export type Opening = { a1: number, a2: number, door: any }
export type Wall = {
	level: number,
	axis: string, -- "x": runs along X at constant z = c ; "z": runs along Z at constant x = c
	c: number,
	a1: number,
	a2: number,
	finish: string, -- solid | glass | panel | fence | barrier (3.6-high glass badge line)
	height: number,
	plus: string?, -- room id on the +c side
	minus: string?, -- room id on the -c side
	openings: { Opening },
}
export type DoorDef = {
	id: string,
	level: number,
	room: string,
	kind: string,
	access: string,
	axis: string,
	x: number,
	z: number,
	w: number,
	h: number,
	inward: Vector3, -- building-local unit vector pointing into the secured room
	exterior: boolean,
	hidden: boolean,
	builder: string, -- "interior" (wall planner) or "exterior" (facade generator)
	swing: string?, -- "out" = leaf swings to the -inward side
	annex: string?, -- "hotel" for guest house doors (the HQ facade generator skips them)
}

-- Room kinds whose corridor-facing walls are glazed partitions.
Layout.GLASS_KINDS = {
	team = true, architecture = true, datalab = true, control = true, evaluation = true, launch = true,
	support = true, studio = true, platform = true, lab = true, hwlab = true, meeting = true, focus = true,
	phone = true, first_ai = true, showroom = true, project_meeting = true, boardroom = true, hr = true,
	fleet = true, b1_lobby = true, roof_lobby = true, garden_lobby = true, gym = true, recovery = true,
	cafe = true, compute = true, mailroom = true,
	hotel_lobby = true, hotel_breakfast = true, hotel_workshop = true, garage_founder = true,
}

local EPS = 0.01

local function roofLevel(tier: number): number
	return Plan.roofLevel(tier)
end

-- Outline lines of a rectangle: (axis, c) with the span [a1,a2] inside the rectangle's side.
local function onOutline(r: any, axis: string, c: number, a1: number, a2: number): boolean
	if axis == "z" and (math.abs(c - r.x1) &lt; EPS or math.abs(c - r.x2) &lt; EPS) then
		return a1 &gt;= r.z1 - EPS and a2 &lt;= r.z2 + EPS
	end
	if axis == "x" and (math.abs(c - r.z1) &lt; EPS or math.abs(c - r.z2) &lt; EPS) then
		return a1 &gt;= r.x1 - EPS and a2 &lt;= r.x2 + EPS
	end
	return false
end

-- Is the line (axis, c) over span [a1,a2] part of the building envelope at this level?
local function envelope(tier: number, level: number, axis: string, c: number, a1: number, a2: number): boolean
	if tier &lt; 1 then
		-- garage stage: the converted garage's outer walls (built by the exterior generator)
		return level == 0 and onOutline(Plan.GARAGE_LAB, axis, c, a1, a2)
	end
	if Plan.hasHotel(tier) and level &gt;= 0 and level &lt; Plan.HOTEL.levels and onOutline(Plan.HOTEL, axis, c, a1, a2) then
		return true -- guest house facade (exterior generator)
	end
	if level == roofLevel(tier) then
		return false -- the roof only has a parapet; head houses build their own walls
	end
	local m = Plan.MAIN
	if level == -1 then
		local g = Plan.GARAGE
		if axis == "z" and (math.abs(c - g.x1) &lt; EPS or math.abs(c - g.x2) &lt; EPS) then
			return true
		end
		if axis == "x" and (math.abs(c - g.z1) &lt; EPS or math.abs(c - g.z2) &lt; EPS) then
			return true
		end
		return false
	end
	local pv = Plan.PAVILION
	if axis == "z" and (math.abs(c - m.x1) &lt; EPS or math.abs(c - m.x2) &lt; EPS) then
		return true -- side facades (main block and pavilion)
	end
	if axis == "x" then
		local front = if level == Plan.founderLevel(tier) then Plan.FOUNDER_FRONT_Z else m.z1
		if math.abs(c - front) &lt; EPS or math.abs(c - m.z1) &lt; EPS then
			return true
		end
		if math.abs(c - m.z2) &lt; EPS then
			return level &gt;= 2 -- levels 0/1: interior link wall to the pavilion
		end
		if level &lt;= 1 and math.abs(c - pv.z2) &lt; EPS then
			return true
		end
	end
	return false
end

local function onShaft(axis: string, c: number, a1: number, a2: number): boolean
	local s = Plan.SHAFT
	if axis == "z" and (math.abs(c - s.x1) &lt; EPS or math.abs(c - s.x2) &lt; EPS) then
		return a1 &gt;= s.z1 - EPS and a2 &lt;= s.z2 + EPS
	end
	if axis == "x" and (math.abs(c - s.z1) &lt; EPS or math.abs(c - s.z2) &lt; EPS) then
		return a1 &gt;= s.x1 - EPS and a2 &lt;= s.x2 + EPS
	end
	return false
end

local function faceLine(r: any, face: string): (string, number, number, number, number)
	-- returns axis, c, a1, a2, side (+1 when the room lies on the +c side of the line)
	if face == "N" then
		return "x", r.z2, r.x1, r.x2, -1
	elseif face == "S" then
		return "x", r.z1, r.x1, r.x2, 1
	elseif face == "E" then
		return "z", r.x2, r.z1, r.z2, -1
	end
	return "z", r.x1, r.z1, r.z2, 1
end

-- An open face (room.open) stays open only towards space of the same access class; elsewhere it
-- becomes a normal wall, so e.g. the public visitor lounge never opens straight into the staff atrium.
local function openLeaks(tier: number, level: number, f: any, mid: number): boolean
	local off = -f.side * 0.5
	local y = Plan.levelY(level) + 1
	local p = if f.axis == "x" then Vector3.new(mid, y, f.c + off) else Vector3.new(f.c + off, y, mid)
	return Plan.accessAt(tier, p) ~= f.room.access
end

local doorCache: { [number]: { DoorDef } } = {}
function Layout.doors(tier: number): { DoorDef }
	local cached = doorCache[tier]
	if cached then
		return cached
	end
	local out: { DoorDef } = {}
	if tier &gt;= 1 then
		table.insert(out, {
			id = "G_ENTRANCE", level = 0, room = "G_LOBBY", kind = "autoslide", access = "public", axis = "x",
			x = 0, z = Plan.ENTRANCE.z, w = Plan.ENTRANCE.x2 - Plan.ENTRANCE.x1, h = 10,
			inward = Vector3.new(0, 0, 1), exterior = true, hidden = false, builder = "exterior",
		})
	end
	for _, r in Plan.rooms(tier) do
		for i, d in r.doors do
			local axis, c, _, _, side = faceLine(r, d.face)
			local x = if axis == "x" then d.at else c
			local z = if axis == "x" then c else d.at
			local inward = if axis == "x" then Vector3.new(0, 0, side) else Vector3.new(side, 0, 0)
			if d.flip then
				inward = -inward
			end
			local exteriorLine = envelope(tier, r.level, axis, c, d.at - d.w / 2, d.at + d.w / 2)
			table.insert(out, {
				id = string.format("%s_D%d", r.id, i),
				level = r.level,
				room = r.id,
				kind = d.kind,
				access = d.access or r.access,
				axis = axis,
				x = x,
				z = z,
				w = d.w,
				h = d.h or (if d.kind == "autoslide" or d.kind == "glassdouble" then 10 else 9),
				inward = inward,
				exterior = d.exterior == true,
				hidden = d.hidden == true or r.hidden == true,
				builder = if exteriorLine then "exterior" else "interior",
				swing = d.swing,
				annex = r.annex,
			})
		end
	end
	doorCache[tier] = out
	return out
end

function Layout.doorsOnLevel(tier: number, level: number): { DoorDef }
	local out = {}
	for _, d in Layout.doors(tier) do
		if d.level == level then
			table.insert(out, d)
		end
	end
	return out
end

local function finishFor(r: any, otherIsRoom: boolean, other: any?): string
	if r.fence then
		return "fence"
	end
	if otherIsRoom then
		return if (r.mood == "founder" or r.mood == "secret") and r.pavilion then "panel" else "solid"
	end
	if r.pavilion and (r.mood == "founder" or r.mood == "secret") then
		return "panel"
	end
	if Layout.GLASS_KINDS[r.kind] then
		return "glass"
	end
	return "solid"
end

-- Explicit interior wall lines that no room face describes on its own.
local function extraLines(tier: number, level: number): { any }
	local out = {}
	if tier &lt; 1 then
		return out -- garage stage: no main block
	end
	if level == 0 or level == 1 then
		table.insert(out, { axis = "x", c = Plan.MAIN.z2, a1 = Plan.MAIN.x1, a2 = Plan.MAIN.x2, finish = "solid" })
	end
	if level == 0 then
		local g = Plan.GATE_LINE
		table.insert(out, { axis = "x", c = g.z, a1 = g.x1, a2 = g.x2, finish = "barrier" })
	end
	return out
end

local wallCache: { [string]: { Wall } } = {}
function Layout.walls(tier: number, level: number): { Wall }
	local key = tier .. ":" .. level
	local cached = wallCache[key]
	if cached then
		return cached
	end
	local isRoof = level == roofLevel(tier)
	-- 1. faces
	type Face = { axis: string, c: number, a1: number, a2: number, side: number, room: any, open: boolean, finish: string? }
	local faces: { Face } = {}
	for _, r in Plan.roomsOnLevel(tier, level) do
		if r.nowalls or (r.outdoor and not r.fence) then
			continue
		end
		local openFaces = {}
		local openList = r.open
		if openList then
			for _, f in openList do
				openFaces[f] = true
			end
		end
		for _, face in { "N", "S", "E", "W" } do
			local axis, c, a1, a2, side = faceLine(r, face)
			if envelope(tier, level, axis, c, a1, a2) or onShaft(axis, c, a1, a2) then
				continue
			end
			if isRoof and r.fence and (math.abs(c - Plan.MAIN.x1) &lt; EPS or math.abs(c - Plan.MAIN.x2) &lt; EPS or math.abs(c - Plan.MAIN.z2) &lt; EPS) then
				continue -- fenced roof zones end at the parapet
			end
			table.insert(faces, { axis = axis, c = c, a1 = a1, a2 = a2, side = side, room = r, open = openFaces[face] == true })
		end
	end
	for _, line in extraLines(tier, level) do
		table.insert(faces, { axis = line.axis, c = line.c, a1 = line.a1, a2 = line.a2, side = 0, room = nil, open = false, finish = line.finish })
	end
	-- 2. group by line
	local groups: { [string]: { Face } } = {}
	local order: { string } = {}
	for _, f in faces do
		local k = f.axis .. string.format("%.2f", f.c)
		if not groups[k] then
			groups[k] = {}
			table.insert(order, k)
		end
		table.insert(groups[k], f)
	end
	table.sort(order)
	local doors = Layout.doorsOnLevel(tier, level)
	local out: { Wall } = {}
	for _, k in order do
		local list = groups[k]
		local axis, c = list[1].axis, list[1].c
		local cuts: { number } = {}
		for _, f in list do
			table.insert(cuts, f.a1)
			table.insert(cuts, f.a2)
			if f.open then
				-- an open face is judged per neighbouring room (see openLeaks): cut at their edges
				for _, r in Plan.roomsOnLevel(tier, level) do
					table.insert(cuts, if axis == "z" then r.z1 else r.x1)
					table.insert(cuts, if axis == "z" then r.z2 else r.x2)
				end
			end
		end
		local sh = Plan.SHAFT
		if axis == "z" then
			table.insert(cuts, sh.z1)
			table.insert(cuts, sh.z2)
		else
			table.insert(cuts, sh.x1)
			table.insert(cuts, sh.x2)
		end
		table.sort(cuts)
		local current: Wall? = nil
		for i = 1, #cuts - 1 do
			local s1, s2 = cuts[i], cuts[i + 1]
			if s2 - s1 &lt; EPS then
				continue
			end
			local mid = (s1 + s2) / 2
			if onShaft(axis, c, mid - EPS, mid + EPS) then
				-- the core generator builds the lift shaft walls; clip shared faces there
				if current then
					table.insert(out, current)
					current = nil
				end
				continue
			end
			local plus, minus = nil, nil
			local anyWall, explicit = false, false
			local explicitFinish: string? = nil
			for _, f in list do
				if mid &gt; f.a1 and mid &lt; f.a2 then
					if not f.open or openLeaks(tier, level, f, mid) then
						anyWall = true
					end
					if f.room == nil then
						explicit = true
						explicitFinish = f.finish
					elseif f.side &gt; 0 then
						plus = f.room
					else
						minus = f.room
					end
				end
			end
			if not anyWall then
				if current then
					table.insert(out, current)
					current = nil
				end
				continue
			end
			local finish
			if plus and minus then
				local a, b = plus :: any, minus :: any
				if a.fence and not b.fence then
					finish = finishFor(b, true, a)
				elseif b.fence and not a.fence then
					finish = finishFor(a, true, b)
				else
					finish = finishFor(a, not (a.fence and b.fence), b)
				end
			elseif plus or minus then
				finish = finishFor((plus or minus) :: any, explicit, nil)
			else
				finish = explicitFinish or "solid"
			end
			if explicitFinish == "barrier" then
				finish = "barrier"
			end
			local height = if tier &lt; 1 then Plan.GARAGE_LAB.height - Plan.SLAB else Plan.FLOOR_HEIGHT - Plan.SLAB
			if isRoof then
				height = if finish == "fence" then 6 else 12
			elseif finish == "fence" then
				height = 6
			elseif finish == "barrier" then
				height = 3.6
			end
			local plusId = if plus then (plus :: any).id else nil
			local minusId = if minus then (minus :: any).id else nil
			if current and current.finish == finish and current.plus == plusId and current.minus == minusId and math.abs(current.a2 - s1) &lt; EPS then
				current.a2 = s2
			else
				if current then
					table.insert(out, current)
				end
				current = { level = level, axis = axis, c = c, a1 = s1, a2 = s2, finish = finish, height = height, plus = plusId, minus = minusId, openings = {} }
			end
		end
		if current then
			table.insert(out, current)
		end
	end
	-- 3. openings: doors lying on a wall line within the segment span
	for _, w in out do
		for _, d in doors do
			if d.builder ~= "interior" or d.axis ~= w.axis then
				continue
			end
			local dc = if d.axis == "x" then d.z else d.x
			local da = if d.axis == "x" then d.x else d.z
			if math.abs(dc - w.c) &lt; EPS and da &gt; w.a1 - EPS and da &lt; w.a2 + EPS then
				table.insert(w.openings, { a1 = math.max(w.a1, da - d.w / 2), a2 = math.min(w.a2, da + d.w / 2), door = d })
			end
		end
		table.sort(w.openings, function(a, b)
			return a.a1 &lt; b.a1
		end)
	end
	wallCache[key] = out
	return out
end

-- Circulation rectangles (main block, levels 0..founder) on a 2-stud grid, greedily merged.
local circCache: { [string]: { any } } = {}
function Layout.circulation(tier: number, level: number): { any }
	local key = tier .. ":" .. level
	local cached = circCache[key]
	if cached then
		return cached
	end
	local out = {}
	if tier &lt; 1 or level &lt; 0 or level &gt;= roofLevel(tier) then
		circCache[key] = out -- (the garage stage has no main block circulation)
		return out
	end
	local m = Plan.MAIN
	local z0 = if level == Plan.founderLevel(tier) then Plan.FOUNDER_FRONT_Z else m.z1
	local G = 2
	local nx = math.floor((m.x2 - m.x1) / G)
	local nz = math.floor((m.z2 - z0) / G)
	local blocked: { [number]: boolean } = {}
	local function block(x1: number, x2: number, z1: number, z2: number)
		for ix = 0, nx - 1 do
			local cx = m.x1 + ix * G + G / 2
			if cx &gt;= x1 and cx &lt;= x2 then
				for iz = 0, nz - 1 do
					local cz = z0 + iz * G + G / 2
					if cz &gt;= z1 and cz &lt;= z2 then
						blocked[iz * nx + ix] = true
					end
				end
			end
		end
	end
	for _, r in Plan.roomsOnLevel(tier, level) do
		if not r.pavilion and not r.annex then
			block(r.x1, r.x2, r.z1, r.z2)
		end
	end
	local s = Plan.SHAFT
	block(s.x1, s.x2, s.z1, s.z2)
	block(Plan.RISER.x1, Plan.RISER.x2, Plan.RISER.z1, Plan.RISER.z2)
	if level &gt;= 1 then
		local a = Plan.ATRIUM
		block(a.x1, a.x2, a.z1, a.z2)
	end
	if level == 0 then
		local p = Plan.PORTAL
		block(p.x1, p.x2, p.z1 - 1, p.z2)
	end
	if level == 1 then
		local v = Plan.LOBBY_VOID
		block(v.x1, v.x2, v.z1, v.z2)
	end
	local used: { [number]: boolean } = {}
	for iz = 0, nz - 1 do
		for ix = 0, nx - 1 do
			local id = iz * nx + ix
			if not blocked[id] and not used[id] then
				local w = 0
				while ix + w &lt; nx and not blocked[iz * nx + ix + w] and not used[iz * nx + ix + w] do
					w += 1
				end
				local h = 1
				local grow = true
				while grow and iz + h &lt; nz do
					for k = 0, w - 1 do
						local cell = (iz + h) * nx + ix + k
						if blocked[cell] or used[cell] then
							grow = false
							break
						end
					end
					if grow then
						h += 1
					end
				end
				for dz = 0, h - 1 do
					for k = 0, w - 1 do
						used[(iz + dz) * nx + ix + k] = true
					end
				end
				table.insert(out, { x1 = m.x1 + ix * G, x2 = m.x1 + (ix + w) * G, z1 = z0 + iz * G, z2 = z0 + (iz + h) * G })
			end
		end
	end
	circCache[key] = out
	return out
end

-- Guest house slabs: ground floor (on the lowered foundation), first floor with the stair void, roof.
local function hotelSlabs(level: number, rects: { any }, holes: { any })
	local h = Plan.HOTEL
	if level &lt; 0 or level &gt; h.levels then
		return
	end
	table.insert(rects, { x1 = h.x1, x2 = h.x2, z1 = h.z1, z2 = h.z2 })
	if level == 1 then
		local st = Plan.HOTEL_STAIR_LAYOUT
		table.insert(holes, { x1 = st.inner.x1, x2 = st.inner.x2, z1 = st.flightA.z1, z2 = st.inner.z2, kind = "hotelstair" })
	end
end

-- Slab outline rectangles (top at levelY) and holes for this level.
function Layout.slabs(tier: number, level: number): ({ any }, { any })
	local m, g, pv = Plan.MAIN, Plan.GARAGE, Plan.PAVILION
	local rects, holes = {}, {}
	if tier &lt; 1 then
		-- garage stage: the converted garage's ground slab only (incl. its outer walls)
		if level == 0 then
			local gl = Plan.GARAGE_LAB
			table.insert(rects, { x1 = gl.x1 - 1, x2 = gl.x2 + 1, z1 = gl.z1 - 1, z2 = gl.z2 + 1 })
		end
		return rects, holes
	end
	local roof = roofLevel(tier)
	if level == -1 then
		table.insert(rects, { x1 = g.x1, x2 = g.x2, z1 = g.z1, z2 = g.z2 })
	elseif level == 0 then
		table.insert(rects, { x1 = g.x1, x2 = g.x2, z1 = g.z1, z2 = g.z2 })
		table.insert(rects, { x1 = pv.x1, x2 = pv.x2, z1 = g.z2, z2 = pv.z2 })
	elseif level == roof then
		table.insert(rects, { x1 = m.x1, x2 = m.x2, z1 = Plan.FOUNDER_FRONT_Z, z2 = m.z2 })
	else
		table.insert(rects, { x1 = m.x1, x2 = m.x2, z1 = m.z1, z2 = m.z2 })
	end
	if level == 1 or level == 2 then
		table.insert(rects, { x1 = pv.x1, x2 = pv.x2, z1 = pv.z1, z2 = pv.z2 })
	end
	local s = Plan.SHAFT
	table.insert(holes, { x1 = s.x1, x2 = s.x2, z1 = s.z1, z2 = s.z2, kind = "shaft" })
	if level &gt;= 0 then
		local st = Plan.STAIR_LAYOUT
		table.insert(holes, { x1 = st.inner.x1, x2 = st.inner.x2, z1 = st.flightA.z1, z2 = st.inner.z2, kind = "stair" })
	end
	if level &gt;= 1 then
		local a = Plan.ATRIUM
		table.insert(holes, { x1 = a.x1, x2 = a.x2, z1 = a.z1, z2 = a.z2, kind = if level == roof then "skylight" else "atrium" })
	end
	if level == 1 then
		local v = Plan.LOBBY_VOID
		table.insert(holes, { x1 = v.x1, x2 = v.x2, z1 = v.z1, z2 = v.z2, kind = "lobbyvoid" })
	end
	if Plan.hasHotel(tier) then
		hotelSlabs(level, rects, holes)
	end
	return rects, holes
end

return Layout
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000003"><Properties><string name="Name">CompanyOps</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- CompanyOps (CORE_SPEC final design, sections 3-6, 8 and 11): the company as a real business.
-- Pure functions of saved company state (data.empire, data.models, data.gpus), play time (empire.seconds)
-- and the visible server clock, so a company earns exactly the same whether anybody watches its
-- building or not. Runs on the server (EmpireService.tick -&gt; Ops.step) and on the client (screens,
-- WorkforceMath.count) with identical results.
--   * one saved company calendar (empire.calendar), play time empire.seconds, 1 game day = 1200 s
--   * time sheet TS(hour): expected share of a team at work (seed-uniform shifts), day average 0.5538
--   * staff presence: vacation / sick days from hashes of the appearance seed (no profile fields), HR
--     collision cap per team, unpaid leave, travelling engineers, apprentices, night crew -&gt; output O_r
--   * B2B pipeline: catalogue client -&gt; founder / Growth &amp; Sales field rep drives (city/region) or flies
--     (abroad) -&gt; deterministic trust bar -&gt; pilot fee + daily retainer -&gt; check-in visit before term end
--   * guest house (stage &gt;= 3): every second region/abroad pilot is hosted at HQ (no flight/hotel, +trust)
--   * running costs besides hired wages: operations staff, drivers, Training Lead, phones, rent and
--     utilities, lunch, fleet leases, trips, guest house, company jet
--   * serving capacity (users) from GPUs, cooling and engineers; B2B reserves part of it; a rack fault
--     takes one compute unit off line until IT fixes it
--   * auto-HR helpers (need, pick, wage budget), Save mode, safety rules (unpaid leave, broke pause)
-- Money only moves through EconomyService (passed in as `Economy`: spend / applyFlow with a ledger category).
local Config = script.Parent.Config
local HardwareConfig = require(Config.HardwareConfig)
local ModelConfig = require(Config.ModelConfig)
local EmpireConfig = require(Config.EmpireConfig)
local MarketConfig = require(Config.MarketConfig)
local EmployeeConfig = require(Config.EmployeeConfig)
local ModelMath = require(script.Parent.ModelMath)
local Workforce = require(script.Parent.WorkforceMath)

local Ops = {}
Ops.DAY = 1200 -- seconds per game day (EmployeeConfig.hour: 900 s 08-18 + 300 s night)
Ops.MONTH = 3600 -- billing month = 3 game days (GameConfig.GAME_MONTH_SECONDS, unchanged)
Ops.AVAILABILITY = 0.9 -- expected share present: 1 - vacation 8.3 % - sick 1.7 % (used for lunch counts and HR maths)
Ops.PILOT_DAYS = 1 -- pilot fee on signing = 1 day of retainer
Ops.TERM_DAYS = 6 -- a retainer runs 2 billing months, then needs a check-in visit to renew
Ops.RENEW_LEAD_DAYS = 0.5
Ops.ACCOUNTS_PER_REP = 2 -- one field rep (Growth &amp; Sales on field duty) looks after &lt;= 2 retainers
Ops.FOUNDER_ACCOUNTS = 2 -- the founder sells too (city clients only)
Ops.DEPART = { from = 8, to = 15 } -- trips start in office hours only (server clock, what the player sees)
Ops.OPS_WAGE = (EmployeeConfig :: any).OPS_WAGE_PER_DAY or 720 -- $ per game day per operations post
Ops.FLEET_LEASE = 100 -- $ per game day per leased field car (one per field rep; the boss's car is owned)
Ops.CASH_MARGIN = 500 -- trips only when cash covers the trip + this
Ops.FIRST_CLIENT_TRUST = 0.5 -- "your friend at CloudDesk": the scripted first pilot signs on the first visit
Ops.MEETING_TRUST = 0.15 -- the founder joins a pilot meeting in person (CityService meeting prompt)
Ops.CAP_PER_UNIT = 15000 -- users served per compute unit (x thermal x engineering factor)
Ops.ENG_CAP = 1.0 -- engineers raise serving capacity by up to +100 % (1 - e^(-O/20))
Ops.ENG_K = 20
Ops.B2B_SCALE = 1 -- tuning knob of the simulator: multiplies every retainer (stays 1)
Ops.UPKEEP_SCALE = 1 -- tuning knob of the simulator (stays 1)
Ops.PHONE = 10 -- $ per employee (hired + operations) per game day: company phones
Ops.DRIVER = { wage = 720, from = 2, more = 4 } -- 1 driver from stage 2, 2 from stage 4 (ops/fleet job)
Ops.TRAINING_LEAD = { wage = 900, from = 3 } -- the apprentices' trainer (Ausbilder)
Ops.APPRENTICE = { wage = 0.4, fee = 0.5, rampDays = 3, graduateDays = 9, startSkill = 1, endSkill = 3 }
Ops.NIGHT = { wage = 1.3, from = 3 } -- night crew: overflow heads (up to the seats) work 22-06 at 1.0, wage x1.3
Ops.HIRE_GAP = 20 -- auto-HR: one hire per 20 s
Ops.HR_BUDGETS = { 0.25, 0.40, 0.55 } -- wage budget slider (share of the 5-minute trailing income)
Ops.HR_STARTERS = 3 -- the first 3 hires are always allowed
Ops.SAVE_MINUTES = 8 -- Save mode: the next office is less than 8 minutes of net profit away
Ops.NEWS_MAX = 40
Ops.NEWS_SHOWN = 20 -- the client (phone, assistant) gets the newest 20 (SessionService trims the replicated copy)
-- bytes per news line incl. the stamp "day 12 10:00: " (Appendix A allows &lt;= 120; 80 keeps the 20 replicated
-- lines + 14 accounts + 7 trips inside the 3 KB deals budget of CORE_SPEC 11.8). Lines are cut on a UTF-8
-- character boundary (Ops.clip), never inside a multi-byte character.
Ops.NEWS_CHARS = 80
Ops.TRIPS_MAX = 16
-- P&amp;L ledger (CORE_SPEC 4, Appendix A): LEDGER_DAYS company days are saved, the newest LEDGER_SHOWN are
-- replicated (SessionService), at most LEDGER_CATEGORIES lines per side and day ("other" included) so the
-- replicated ledger stays &lt;= 2.5 KB even at the caps (CORE_SPEC 11.8).
Ops.LEDGER_DAYS = 7
Ops.LEDGER_SHOWN = 4
Ops.LEDGER_CATEGORIES = 16
-- rack faults (CORE_SPEC 5.2 / 5.5): every installed rack GPU fails with FAULT.rate per game day of play
-- (rolled once per FAULT.every play seconds from a hash of the company and the minute: deterministic,
-- identical watched or not); a fault takes FAULT.units compute units of that GPU off line ("capacity -1 unit
-- per fault", CORE_SPEC 5.5 / 10) until fixed: FAULT.it seconds of repair work with the IT post on duty,
-- FAULT.alone seconds without (the garage has no IT post, IT works 08-18 and from stage 5 also at night).
-- A staffed hardware lab (stage &gt;= 4, engineers &gt;= half their desks) halves the rate.
Ops.FAULT = { rate = 0.06, every = 60, it = 60, alone = 300, hwlab = 0.5, units = 1 }

-- office stages (EmpireConfig.OFFICES index; 1 = Garage Lab, 2..5 = the HQ buildings of plan tiers 1..4)
-- lines = live product lines; clients = B2B account slots; ops = automatic operations posts;
-- upkeep = rent + utilities per game day; food = lunch $ per person per day; trips = farthest trip tier;
-- kitchen = lunches per day; wellness / barista feed morale
Ops.STAGES = {
	{ lines = 1, clients = 2, ops = 0, upkeep = 300, food = 6, guest = false, trips = "city", kitchen = 0, wellness = 0, barista = 0 },
	{ lines = 2, clients = 4, ops = 8, upkeep = 2500, food = 8, guest = false, trips = "city", kitchen = 120, wellness = 0.5, barista = 1 },
	{ lines = 3, clients = 7, ops = 12, upkeep = 9000, food = 8, guest = true, trips = "region", kitchen = 145, wellness = 1, barista = 1 },
	{ lines = 4, clients = 10, ops = 14, upkeep = 24000, food = 8, guest = true, trips = "abroad", kitchen = 145 + 4 * 15, wellness = 1, barista = 1 },
	{ lines = 4, clients = 14, ops = 16, upkeep = 48000, food = 8, guest = true, trips = "abroad", kitchen = 145 + 6 * 15, wellness = 1, barista = 1 },
}
local TIER = { city = 1, region = 2, abroad = 3 }
-- seats per role per stage (BuildingPlan room desks; garage = 5 shared team desks + the founder desk)
-- researcher = design + research + 1/2 evaluation; engineer = engineering + training + 1/2 evaluation;
-- curator = data (+3 First AI data desks at T1); marketer (Growth &amp; Sales) = growth + deployment
Ops.SEATS = {
	{ researcher = 5, engineer = 5, curator = 5, marketer = 5 },
	{ researcher = 15, engineer = 16, curator = 14, marketer = 16 },
	{ researcher = 26, engineer = 28, curator = 32, marketer = 34 },
	{ researcher = 50, engineer = 56, curator = 32, marketer = 34 },
	{ researcher = 93, engineer = 85, curator = 32, marketer = 71 },
}
-- departments (BuildingPlan / DepartmentConfig ids) of each hired role: night shifts are set per department
Ops.ROLE_DEPTS = {
	researcher = { "research", "design", "evaluation" },
	engineer = { "engineering", "training" },
	curator = { "data" },
	marketer = { "growth", "deployment" },
}
-- trips: days away, hotel nights per traveller, fuel, flight per traveller (round trip), hotel $/night, crew
Ops.TRIPS = {
	city = { days = 0.2, nights = 0, fuel = 30, flight = 0, hotel = 0, crew = 1 },
	region = { days = 1, nights = 1, fuel = 90, flight = 0, hotel = 140, crew = 2 },
	abroad = { days = 2, nights = 2, fuel = 40, flight = 700, hotel = 220, crew = 2 },
}
Ops.PER_DIEM = 50 -- per traveller per started day
-- company jet (late purchase from stage JET.stage, a money sink that adds convenience, not income): abroad
-- trips fly the jet with the 2 company pilots instead of the airline - no tickets, 1.5 days instead of 2
-- (1 hotel night), +0.05 trust per abroad visit; fixed running cost per game day (pilot wages + upkeep)
Ops.JET = { price = 900000, stage = 4, pilots = 2, pilotWage = 3000, upkeep = 2500, fuel = 1500, days = 1.5, nights = 1, trust = 0.05 }
Ops.HOSTED = { nightCost = 60, guests = 2, nights = 2, trust = 0.10 } -- client team stays at the guest house
Ops.GUEST = { rooms = 12, occupancy = 0.6, rate = 300, utilities = 400, staff = 2 }
-- one client catalogue (replaces EmpireConfig.CONTRACTS + MarketService.businesses); retainer $/game day,
-- tokens = M tokens per billing month (they reserve compute: deals.reserved = sum tokens / 100).
-- Map a client to its building BY NAME (CityPlan.clientOffice(client.name)), never by id.
Ops.CLIENTS = {
	{ id = "helpdesk", name = "CloudDesk", stat = "reliability", minimum = 24, stage = 1, retainer = 9000, tokens = 40, trip = "city", first = true },
	{ id = "paper", name = "Paper Studio", stat = "creativity", minimum = 30, stage = 1, retainer = 9000, tokens = 50, trip = "city" },
	{ id = "code", name = "ByteWorks", stat = "coding", minimum = 36, stage = 1, retainer = 13500, tokens = 70, trip = "city" },
	{ id = "pixel", name = "Pixel Games", stat = "coding", minimum = 40, stage = 2, retainer = 13500, tokens = 90, trip = "city" },
	{ id = "study", name = "StudySpark", stat = "math", minimum = 40, stage = 2, retainer = 13500, tokens = 90, trip = "city" },
	{ id = "north", name = "North Logistics", stat = "reasoning", minimum = 42, stage = 2, retainer = 15000, tokens = 100, trip = "city" },
	{ id = "civic", name = "Civic Support", stat = "reliability", minimum = 46, stage = 2, retainer = 18000, tokens = 120, trip = "city" },
	{ id = "creative", name = "PixelForge", stat = "creativity", minimum = 48, stage = 3, retainer = 24000, tokens = 160, trip = "region" },
	{ id = "ledger", name = "Ledger Finance", stat = "math", minimum = 50, stage = 3, retainer = 27000, tokens = 180, trip = "region" },
	{ id = "orbitgames", name = "Orbit Games", stat = "coding", minimum = 52, stage = 3, retainer = 30000, tokens = 200, trip = "region" },
	{ id = "atlas", name = "Atlas Search", stat = "knowledge", minimum = 55, stage = 3, retainer = 36000, tokens = 240, trip = "region" },
	{ id = "delta", name = "Delta Robotics", stat = "reasoning", minimum = 60, stage = 4, retainer = 45000, tokens = 300, trip = "region" },
	{ id = "enterprise", name = "Nova Logistics", stat = "reliability", minimum = 62, stage = 4, retainer = 54000, tokens = 360, trip = "region" },
	{ id = "mosaic", name = "Mosaic Worlds", stat = "creativity", minimum = 65, stage = 4, retainer = 63000, tokens = 420, trip = "region" },
	{ id = "helix", name = "Helix Research", stat = "math", minimum = 70, stage = 4, retainer = 78000, tokens = 520, trip = "abroad" },
	{ id = "frontier", name = "Orbit Systems", stat = "reasoning", minimum = 75, stage = 5, retainer = 105000, tokens = 700, trip = "abroad" },
	{ id = "nova", name = "Nova Infrastructure", stat = "coding", minimum = 80, stage = 5, retainer = 135000, tokens = 900, trip = "abroad" },
	{ id = "science", name = "Frontier Science", stat = "reasoning", minimum = 86, stage = 5, retainer = 180000, tokens = 1200, trip = "abroad" },
} :: { any }
local byId: { [string]: any } = {}
for _, c in Ops.CLIENTS do byId[c.id] = c end
Ops.byId = byId
local scaled = false
function Ops.applyScale()
	if scaled then return end
	scaled = true
	for _, c in Ops.CLIENTS do c.retainer = math.floor(c.retainer * Ops.B2B_SCALE) end
	for _, st in Ops.STAGES do st.upkeep = math.floor(st.upkeep * Ops.UPKEEP_SCALE) end
end
function Ops.client(id: any): any
	return if typeof(id) == "string" then byId[id] else nil
end
-- catalogue client by its (case-insensitive) name; CityService meeting prompts carry CityPlan's keys
function Ops.clientByName(name: any): any
	if typeof(name) ~= "string" then return nil end
	local want = string.lower(name)
	for _, c in Ops.CLIENTS do if string.lower(c.name) == want then return c end end
	return nil
end

-- clock and time sheet ------------------------------------------------------------------------------
function Ops.hour(clock: number): number
	local s = clock % Ops.DAY
	if s &lt; 900 then return 8 + s / 90 end
	return (18 + (s - 900) / 300 * 14) % 24
end
-- Expected share of a hired team working at `hour` (seed-uniform shifts: start 7.75-9.0, finish 16.5-18.0,
-- lunch start 11.75-13.5 for 1 h, 0.94 for short breaks). Same function on- and offscreen.
function Ops.timesheet(h: number): number
	local started = math.clamp((h - 7.75) / 1.25, 0, 1)
	local notDone = math.clamp((18 - h) / 1.5, 0, 1)
	local lunch = math.max(0, math.min(h, 13.5) - math.max(h - 1, 11.75)) / 1.75
	return started * notDone * (1 - lunch) * 0.94
end
local mean = 0
for s = 0, Ops.DAY - 1 do mean += Ops.timesheet(Ops.hour(s + 0.5)) end
Ops.TS_MEAN = mean / Ops.DAY -- real-time day average (0.5538)
-- multiplier for accruing "stock" outputs (research points, curated tokens): mean over one game day = 1
function Ops.duty(clock: number): number
	return Ops.timesheet(Ops.hour(clock)) / Ops.TS_MEAN
end
function Ops.inOffice(clock: number): boolean
	local h = Ops.hour(clock)
	return h &gt;= 8 and h &lt; 18
end

-- helpers ---------------------------------------------------------------------------------------------
function Ops.stageIndex(e: any): number
	return math.clamp(math.floor(tonumber(e.office) or 1), 1, #Ops.STAGES)
end
function Ops.stage(e: any): any
	return Ops.STAGES[Ops.stageIndex(e)]
end
function Ops.seats(e: any, role: string): number
	return Ops.SEATS[Ops.stageIndex(e)][role] or 0
end
function Ops.day(e: any): number
	local c = e.calendar
	local day = if typeof(c) == "table" then tonumber(c.day) else nil
	return math.max(1, math.floor(day or 1))
end
local function heads(e: any): number
	local n = 0
	if typeof(e.employees) == "table" then for _, k in e.employees do n += tonumber(k) or 0 end end
	return n
end
Ops.heads = heads
function Ops.opsPosts(e: any): number
	local st = Ops.stage(e)
	return st.ops + (if st.guest then Ops.GUEST.staff else 0)
end
-- morale M = clamp(0.90 + 0.10 lunch + 0.03 wellness + 0.02 barista, 0.90, 1.05)
function Ops.morale(e: any): number
	local st = Ops.stage(e)
	local n = heads(e) + Ops.opsPosts(e)
	local lunch = if st.kitchen == 0 then 0.5 else math.min(1, st.kitchen / math.max(1, n * Ops.AVAILABILITY))
	return math.clamp(0.90 + 0.10 * lunch + 0.03 * st.wellness + 0.02 * st.barista, 0.90, 1.05)
end
-- field reps: Growth &amp; Sales heads on field duty (HR assigns as many as the free account slots need);
-- they are the first n profiles of staffProfiles.marketer
function Ops.fieldReps(e: any): number
	local st = Ops.stage(e)
	local need = math.ceil(math.max(0, st.clients - Ops.FOUNDER_ACCOUNTS) / Ops.ACCOUNTS_PER_REP)
	return math.min(tonumber(e.employees and e.employees.marketer) or 0, need)
end

-- staff presence (CORE_SPEC 5.3) -------------------------------------------------------------------------
local function seedOf(p: any, i: number): number
	local s = if typeof(p) == "table" then p.s else nil
	return if typeof(s) == "number" and s == s then math.floor(math.abs(s)) % 2147483647 else i
end
-- sick on company day `day`: 1.7 % of all person-days
function Ops.isSick(seed: number, day: number): boolean
	return EmployeeConfig.hash(seed * 7919 + day) % 1000 &lt; 17
end
-- vacation day (0..11) of each seed in the 12-day cycle `cycle`, after the HR collision shift: at most
-- ceil(0.10 * team) people of a team share a day; the extra people (highest seed first) move to the next
-- day of the cycle with room. Pure function of the team's seeds.
function Ops.vacationDays(seeds: { number }, cycle: number): { [number]: number }
	local order = {}
	for i, s in seeds do table.insert(order, { s = s, i = i }) end
	table.sort(order, function(a: any, b: any): boolean
		if a.s ~= b.s then return a.s &lt; b.s end
		return a.i &lt; b.i
	end)
	local cap = math.max(1, math.ceil(0.10 * #seeds))
	local used: { [number]: number } = {}
	local out: { [number]: number } = {}
	for _, o in order do
		local d = EmployeeConfig.hash(o.s * 31 + cycle) % 12
		for _ = 1, 12 do
			if (used[d] or 0) &lt; cap then break end
			d = (d + 1) % 12
		end
		used[d] = (used[d] or 0) + 1
		out[o.i] = d
	end
	return out
end
-- unpaid leave (safety rule): empire.unpaidLeave = n newest hires; taken one at a time from the role with
-- the most active heads (ties in EmpireConfig.ROLES order), always that role's last profile
function Ops.leaveCounts(e: any): { [string]: number }
	local out: { [string]: number } = {}
	local n = math.max(0, math.floor(tonumber(e.unpaidLeave) or 0))
	local active: { [string]: number } = {}
	for _, r in EmpireConfig.ROLES do out[r.id] = 0; active[r.id] = tonumber(e.employees and e.employees[r.id]) or 0 end
	for _ = 1, n do
		local best: string? = nil
		for _, r in EmpireConfig.ROLES do
			if active[r.id] &gt; 0 and (best == nil or active[r.id] &gt; active[best :: string]) then best = r.id end
		end
		if best == nil then break end
		active[best] -= 1
		out[best] += 1
	end
	return out
end
-- engineers away on region/abroad pilot trips (rep + 1 engineer; they count as absent like vacation)
function Ops.travellers(e: any): { [string]: number }
	local out: { [string]: number } = { engineer = 0 }
	local d = e.deals
	if typeof(d) ~= "table" or typeof(d.tripList) ~= "table" then return out end
	for _, trip in d.tripList do
		local c = if typeof(trip) == "table" then byId[trip.client] else nil
		if c and trip.kind == "sign" and not trip.founder and not trip.hosted and c.trip ~= "city" then out.engineer += 1 end
	end
	return out
end
-- apprentice skill / wage factor of a profile seed on company `day` (nil = not an apprentice)
function Ops.apprentice(e: any, seed: number, day: number): (number?, number?)
	local map = e.apprentices
	if typeof(map) ~= "table" or next(map) == nil then return nil, nil end -- usual case: no string key built
	local entry = map[tostring(seed)]
	if typeof(entry) ~= "table" then return nil, nil end
	local A = Ops.APPRENTICE
	local age = day - (tonumber(entry.day) or day)
	if age &gt;= A.graduateDays then return nil, nil end
	return math.min(A.endSkill, A.startSkill + math.floor(math.max(0, age) / A.rampDays)), A.wage
end
function Ops.apprenticeCount(e: any): number
	local map = e.apprentices
	if typeof(map) ~= "table" then return 0 end
	local n = 0
	for _ in map do n += 1 end
	return n
end
-- Apprentices whose training is over (graduateDays company days) become regular staff: their profile gets
-- skill endSkill and wage factor 1 and the apprentices entry is removed (no new profile fields; CORE_SPEC
-- 11.1). Returns the names of the graduates (EmpireService writes the news line).
function Ops.graduate(e: any): { string }
	local done: { string } = {}
	local map = e.apprentices
	if typeof(map) ~= "table" or next(map) == nil or typeof(e.staffProfiles) ~= "table" then return done end
	local day = Ops.day(e)
	local A = Ops.APPRENTICE
	for _, list in e.staffProfiles do
		if typeof(list) ~= "table" then continue end
		for _, p in list do
			local key = if typeof(p) == "table" and typeof(p.s) == "number" then tostring(p.s) else nil
			local entry = if key then map[key] else nil
			if key and typeof(entry) == "table" and day - (tonumber(entry.day) or day) &gt;= A.graduateDays then
				p.k = A.endSkill
				p.w = 1
				map[key] = nil
				table.insert(done, tostring(p.n))
			end
		end
	end
	return done
end
function Ops.nightOn(e: any, role: string): boolean
	if Ops.stageIndex(e) &lt; Ops.NIGHT.from then return false end
	local d = e.deals
	if typeof(d) == "table" and (tonumber(d.broke) or 0) &gt;= Ops.DAY then return false end -- broke for a day: paused
	local map = e.nightShift
	if typeof(map) ~= "table" then return false end
	for _, dept in Ops.ROLE_DEPTS[role] or {} do if map[dept] == true then return true end end
	return false
end

-- Who of a role is at work today: per profile index i (1..employees[role]) one of "present", "vacation",
-- "sick", "leave" (unpaid), "trip" (travelling engineer). Pure function of saved data.
function Ops.presence(e: any, role: string): { string }
	local n = math.max(0, math.floor(tonumber(e.employees and e.employees[role]) or 0))
	local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[role] else nil
	local day = Ops.day(e)
	local seeds = {}
	for i = 1, n do seeds[i] = seedOf(if typeof(list) == "table" then list[i] else nil, i) end
	local vac = Ops.vacationDays(seeds, day // 12)
	local leave = Ops.leaveCounts(e)[role] or 0
	local out = {}
	for i = 1, n do
		if i &gt; n - leave then out[i] = "leave"
		elseif vac[i] == day % 12 then out[i] = "vacation"
		elseif Ops.isSick(seeds[i], day) then out[i] = "sick"
		else out[i] = "present" end
	end
	local away = (Ops.travellers(e) :: any)[role] or 0
	for i = n, 1, -1 do
		if away &lt;= 0 then break end
		if out[i] == "present" then out[i] = "trip"; away -= 1 end
	end
	return out
end

-- Department output O_r (CORE_SPEC 5.1) from saved data only:
--   H = sum of f(k) over the people at work today (f = WorkforceMath.factor; apprentices ramp 1 -&gt; 3)
--   O = (min(H, S) + night + 0.5 * rest) * morale,  S = seats of the stage, night = min(H - S, S) with a
--   night shift (stage &gt;= 3), rest = the overflow beyond that. Level outputs use O directly; stock outputs
--   (research points, curated tokens) multiply by duty(clock) where they accrue.
local cache: { [any]: any } = setmetatable({}, { __mode = "k" }) :: any
local function signature(e: any): string
	local parts = { tostring(Ops.day(e)), tostring(e.office), tostring(e.unpaidLeave) }
	for _, r in EmpireConfig.ROLES do
		local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[r.id] else nil
		local last = if typeof(list) == "table" then list[#list] else nil
		table.insert(parts, tostring(e.employees and e.employees[r.id]) .. ":" .. tostring(if typeof(list) == "table" then #list else -1) .. ":" .. tostring(if typeof(last) == "table" then last.s else nil) .. ":" .. tostring(if typeof(last) == "table" then last.k else nil))
	end
	table.insert(parts, tostring(Ops.travellers(e).engineer))
	local appr = 0
	if typeof(e.apprentices) == "table" then for _ in e.apprentices do appr += 1 end end
	table.insert(parts, tostring(appr))
	local night = ""
	if typeof(e.nightShift) == "table" then for _, r in EmpireConfig.ROLES do night ..= if Ops.nightOn(e, r.id) then "1" else "0" end end
	table.insert(parts, night)
	return table.concat(parts, "|")
end
function Ops.output(e: any, role: string): number
	if typeof(e) ~= "table" or typeof(e.employees) ~= "table" then return 0 end
	local sig = signature(e)
	local c = cache[e]
	if c == nil or c.sig ~= sig then
		c = { sig = sig, out = {} }
		cache[e] = c
	end
	local hit = c.out[role]
	if hit ~= nil then return hit end
	local presence = Ops.presence(e, role)
	local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[role] else nil
	local day = Ops.day(e)
	local H = 0
	for i, state in presence do
		if state == "present" then
			local p = if typeof(list) == "table" then list[i] else nil
			local k = if typeof(p) == "table" then p.k else nil
			local ak = Ops.apprentice(e, seedOf(p, i), day)
			H += Workforce.factor(if ak then ak else k)
		end
	end
	local S = Ops.seats(e, role)
	local over = math.max(0, H - S)
	local night = if Ops.nightOn(e, role) then math.min(over, S) else 0
	local O = (math.min(H, S) + night + 0.5 * (over - night)) * Ops.morale(e)
	c.out[role] = O
	return O
end
-- payroll $ per second of the hired team: profile wage multipliers x role wage; unpaid leave pays nothing,
-- apprentices 40 %, night crew x1.3 (the overflow heads beyond the seats, newest first)
function Ops.wage(e: any): number
	local total = 0
	local day = Ops.day(e)
	local leave = Ops.leaveCounts(e)
	for _, role in EmpireConfig.ROLES do
		local n = math.max(0, math.floor(tonumber(e.employees and e.employees[role.id]) or 0))
		local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[role.id] else nil
		local paid = n - (leave[role.id] or 0)
		local S = Ops.seats(e, role.id)
		local nightHeads = if Ops.nightOn(e, role.id) then math.min(math.max(0, paid - S), S) else 0
		for i = 1, paid do
			local p = if typeof(list) == "table" then list[i] else nil
			local w = if typeof(p) == "table" and typeof(p.w) == "number" and p.w == p.w then p.w else 1
			local _, aw = Ops.apprentice(e, seedOf(p, i), day)
			if aw then w *= aw end
			if i &gt; paid - nightHeads then w *= Ops.NIGHT.wage end
			total += w * role.wage
		end
	end
	return total
end
-- Growth &amp; Sales in the office (field reps excluded)
function Ops.growthO(e: any): number
	local n = tonumber(e.employees and e.employees.marketer) or 0
	if n &lt;= 0 then return 0 end
	return Workforce.count(e, "marketer") * (n - Ops.fieldReps(e)) / n
end
-- reachable market share of a segment: the stage's maximum, reached only with enough Growth &amp; Sales
-- in the office (marketing, partnerships, support): REACH_BASE + REACH_PER_FTE per working in-office FTE
Ops.REACH_BASE = 0.2
Ops.REACH_PER_FTE = 0.012
function Ops.reachCap(data: any, stageMax: number): number
	return math.min(stageMax, Ops.REACH_BASE + Ops.REACH_PER_FTE * Ops.growthO(data.empire))
end

-- auto-HR (CORE_SPEC 8.1) -------------------------------------------------------------------------------
-- "department need" (HR never hires past it; the assistant says "at full effect"):
--   researchers: their desks while research or Lab levels are open, afterwards RESEARCH_AFTER of them;
--   Growth &amp; Sales: the field reps the client slots need + max(GROWTH_OFFICE_MAX, heads that reach the
--   stage's reach cap) in the office; engineers and curators: their desks.
Ops.GROWTH_OFFICE_MAX = 24
Ops.RESEARCH_AFTER = 0.25
Ops.LAB_MAX = 10
function Ops.researchOpen(e: any): boolean
	if (tonumber(e.labLevel) or 0) &lt; Ops.LAB_MAX then return true end
	local done = if typeof(e.research) == "table" then e.research else {}
	for _, def in EmpireConfig.RESEARCH do if not done[def.id] then return true end end
	return false
end
-- Lab levels (CORE_SPEC 7.5): level L -&gt; L + 1 costs floor(200 * 1.35^L) research points and
-- $floor(6000 * 1.6^L); +1 core stat on future models each, at most LAB_MAX levels
function Ops.labCost(level: number): (number, number)
	return math.floor(200 * 1.35 ^ level), math.floor(6000 * 1.6 ^ level)
end
function Ops.hrNeed(e: any, role: string): number
	local seats = Ops.seats(e, role)
	if role == "researcher" then return if Ops.researchOpen(e) then seats else math.ceil(seats * Ops.RESEARCH_AFTER) end
	if role == "marketer" then
		local st = Ops.stage(e)
		local field = math.ceil(math.max(0, st.clients - Ops.FOUNDER_ACCOUNTS) / Ops.ACCOUNTS_PER_REP)
		local stageMax = (MarketConfig.STAGE_REACH or {})[Ops.stageIndex(e)] or 0.9
		local reachHeads = math.ceil(math.max(0, stageMax - Ops.REACH_BASE) / Ops.REACH_PER_FTE / (Ops.AVAILABILITY * Ops.morale(e)))
		return math.min(seats, field + math.max(Ops.GROWTH_OFFICE_MAX, reachHeads))
	end
	return seats
end
-- the department with the lowest heads / need below its need (EmpireConfig.ROLES order breaks ties)
Ops.HR_ORDER = { "engineer", "curator", "researcher", "marketer" }
function Ops.hrPick(e: any): string?
	local best, bestRatio = nil, math.huge
	for _, id in Ops.HR_ORDER do
		local need = Ops.hrNeed(e, id)
		local n = tonumber(e.employees and e.employees[id]) or 0
		local ratio = n / math.max(1, need)
		if n &lt; need and ratio &lt; bestRatio - 1e-9 then best = id; bestRatio = ratio end
	end
	return best
end
function Ops.hrSettings(e: any): (boolean, number)
	local hr = if typeof(e.hr) == "table" then e.hr else {}
	local budget = tonumber(hr.budget) or 0.40
	return hr.auto ~= false, budget
end
-- cash kept back by automation: max($1,500, 2 minutes of payroll)
function Ops.reserve(e: any): number
	return math.max(1500, Ops.wage(e) * 120)
end
-- daily payroll of hired (all, incl. unpaid leave) + operations staff: the unpaid-leave thresholds
function Ops.dailyPayroll(e: any): number
	local hired = 0
	for _, role in EmpireConfig.ROLES do
		local n = math.max(0, math.floor(tonumber(e.employees and e.employees[role.id]) or 0))
		local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[role.id] else nil
		for i = 1, n do
			local p = if typeof(list) == "table" then list[i] else nil
			hired += (if typeof(p) == "table" and typeof(p.w) == "number" and p.w == p.w then p.w else 1) * role.wage
		end
	end
	return hired * Ops.DAY + Ops.opsPosts(e) * Ops.OPS_WAGE
end
-- Save mode (auto): the next office is less than SAVE_MINUTES of net profit away; off in the garage until
-- the first client signed. netPerSecond = live revenue - live cost.
function Ops.saveMode(e: any, money: number, netPerSecond: number): boolean
	if e.saveMode == "off" then return false end
	local nextDef = EmpireConfig.OFFICES[Ops.stageIndex(e) + 1]
	if not nextDef then return false end
	if Ops.stageIndex(e) == 1 and (tonumber(e.contractsCompleted) or 0) &lt; 1 then return false end
	local net = netPerSecond * 60
	return net &gt; 0 and (nextDef.price + Ops.reserve(e) * 2 - money) / net &lt; Ops.SAVE_MINUTES
end
-- may HR hire one more `role` person now? payroll (hired + ops) after the hire &lt;= budget x trailing income;
-- the first HR_STARTERS hires always; Save mode stops HR at half the desks; never while broke or on leave
function Ops.hrAllowed(e: any, money: number, income: number, saving: boolean, roleId: string): boolean
	local role = EmpireConfig.find(EmpireConfig.ROLES, roleId)
	if not role then return false end
	local _, budget = Ops.hrSettings(e)
	local staff = heads(e)
	local def = EmpireConfig.OFFICES[Ops.stageIndex(e)]
	local cap = if def then def.staff else 0
	if staff &gt;= cap then return false end
	if money &lt; 0 or (tonumber(e.unpaidLeave) or 0) &gt; 0 then return false end
	if saving and staff &gt;= cap * 0.5 then return false end
	if staff &lt; Ops.HR_STARTERS then return true end
	local payroll = Ops.wage(e) + Ops.opsPosts(e) * Ops.OPS_WAGE / Ops.DAY
	return payroll + role.wage &lt;= budget * math.max(0, income)
end

-- serving capacity, compute, rack faults ----------------------------------------------------------------
local faultState: { [any]: any } = setmetatable({}, { __mode = "k" }) :: any
-- rack GPUs in blade order (PlotService lights blades best GPU first): { {slot, gpu id, throughput} }
function Ops.rack(gpus: any): { any }
	local out = {}
	for i = #HardwareConfig.GPUS, 1, -1 do
		local g = HardwareConfig.GPUS[i]
		if not g.starter then
			for _ = 1, math.max(0, math.floor(tonumber(gpus and gpus[g.id]) or 0)) do table.insert(out, { slot = #out + 1, gpu = g.id, throughput = g.throughput }) end
		end
	end
	return out
end
-- throughput currently off line because of rack faults
function Ops.faultLoss(e: any): number
	local st = faultState[e]
	if not st then return 0 end
	local lost = 0
	for _, f in st.list do lost += f.throughput end
	return lost
end
function Ops.faults(e: any): { any }
	local st = faultState[e]
	return if st then st.list else {}
end
function Ops.itOnDuty(e: any, clock: number): boolean
	local stage = Ops.stageIndex(e)
	if stage &lt; 2 then return false end -- the garage has no IT post
	return Ops.inOffice(clock) or stage &gt;= 5 -- IT works the day shift; from stage 5 an IT engineer is on call at night
end
function Ops.hwlabStaffed(e: any): boolean
	return Ops.stageIndex(e) &gt;= 4 and (tonumber(e.employees and e.employees.engineer) or 0) &gt;= Ops.seats(e, "engineer") * 0.5
end
-- one fault step (EmpireService.tick via Ops.step): repair running faults, roll new ones once per minute
-- of play. seedKey = a number identifying the company (its user id). Returns true when the list changed.
function Ops.faultStep(e: any, gpus: any, seedKey: number, dt: number, clock: number): boolean
	local st = faultState[e]
	if not st then st = { list = {}, minute = nil }; faultState[e] = st end
	local changed = false
	local rack = Ops.rack(gpus)
	local F = Ops.FAULT
	local rate = if Ops.itOnDuty(e, clock) then 1 / F.it else 1 / F.alone
	local keep = {}
	for _, f in st.list do
		f.left -= dt * rate
		local still = rack[f.slot]
		if f.left &gt; 0 and still and still.gpu == f.gpu then table.insert(keep, f) else changed = true end
	end
	st.list = keep
	local minute = math.floor((tonumber(e.seconds) or 0) / F.every)
	if st.minute == nil then st.minute = minute end
	if minute ~= st.minute then
		st.minute = minute
		local p = F.rate * F.every / Ops.DAY * (if Ops.hwlabStaffed(e) then F.hwlab else 1)
		local base = math.floor(math.abs(seedKey)) % 2147483647
		for _, r in rack do
			local broken = false
			for _, f in st.list do if f.slot == r.slot then broken = true end end
			if not broken and EmployeeConfig.hash(base + minute * 131 + r.slot * 7919) % 1000000 &lt; p * 1000000 then
				table.insert(st.list, { slot = r.slot, gpu = r.gpu, throughput = math.min(F.units, r.throughput), left = 1, since = tonumber(e.seconds) or 0 })
				changed = true
			end
		end
	end
	return changed
end
-- serving capacity in users (consumer market), after B2B reservations and rack faults
function Ops.capacity(data: any): number
	local e = data.empire
	local fleet = ModelMath.fleet(data.gpus)
	local throughput = math.max(0, fleet.throughput - Ops.faultLoss(e))
	local thermal = HardwareConfig.thermal(e, fleet.throughput)
	local reserved = (typeof(e.deals) == "table" and tonumber(e.deals.reserved)) or 0
	local eng = 1 + Ops.ENG_CAP * (1 - math.exp(-Workforce.count(e, "engineer") / Ops.ENG_K))
	return math.max(0, throughput * thermal - reserved) * Ops.CAP_PER_UNIT * eng
end
-- buy the company jet (EmpireAction "buyJet"): stage &gt;= JET.stage, paid at once
function Ops.buyJet(session: any, Economy: any): any
	local e = session.data.empire
	if e.jet == true then return { ok = false, err = "OWNED" } end
	if Ops.stageIndex(e) &lt; Ops.JET.stage then return { ok = false, err = "OFFICE" } end
	if not Economy.spend(session, Ops.JET.price, "jetbuy") then return { ok = false, err = "NO_MONEY" } end
	e.jet = true
	return { ok = true }
end

-- calendar ----------------------------------------------------------------------------------------------
-- company date: day + 1 whenever the server day index floor(clock / DAY) changes while the company is online
function Ops.advanceCalendar(e: any, clock: number): number
	local c = e.calendar
	if typeof(c) ~= "table" then c = { day = 1 }; e.calendar = c end
	local index = math.floor(clock / Ops.DAY)
	if typeof(c.index) ~= "number" then c.index = index end
	if index ~= c.index then c.day = Ops.day(e) + 1; c.index = index end
	return c.day
end
function Ops.stamp(e: any, clock: number): string
	local h = Ops.hour(clock)
	return string.format("day %d %02d:%02d", Ops.day(e), math.floor(h), math.floor((h % 1) * 60))
end
local function money(n: number): string
	local text = tostring(math.floor(math.abs(n) + 0.5))
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then formatted = string.sub(formatted, 2) end
	return (if n &lt; 0 then "-$" else "$") .. formatted
end
Ops.money = money

-- trips -------------------------------------------------------------------------------------------------
-- duration (s), hotel nights per traveller, cost of a trip; hosted = client comes to the guest house
function Ops.tripPlan(kind: string, crew: number, hosted: boolean, jet: boolean?): (number, number, number)
	local t = Ops.TRIPS[kind] or Ops.TRIPS.city
	if hosted then
		local h = Ops.HOSTED
		return Ops.DAY, 0, h.guests * h.nights * h.nightCost
	end
	if jet and kind == "abroad" then
		local J = Ops.JET
		local cost = J.fuel + crew * (J.nights * t.hotel + math.ceil(J.days) * Ops.PER_DIEM)
		return J.days * Ops.DAY, J.nights, cost
	end
	local days = math.max(1, math.ceil(t.days))
	local cost = t.fuel + crew * (t.flight + t.nights * t.hotel + days * Ops.PER_DIEM)
	return t.days * Ops.DAY, t.nights, cost
end
local NUMBERS = { "signed", "lost", "nights", "trips", "reserved", "pilots", "hosted", "flights", "jetFlights", "broke" }
function Ops.newDeals(): any
	local d: any = { accounts = {}, trust = {}, tripList = {}, news = {}, skip = {} }
	for _, k in NUMBERS do d[k] = 0 end
	return d
end
-- type repair of empire.deals (Template.migrate does the value checks)
function Ops.ensure(e: any): any
	local d = e.deals
	if typeof(d) ~= "table" then d = Ops.newDeals(); e.deals = d end
	for _, k in { "accounts", "trust", "tripList", "news", "skip" } do if typeof(d[k]) ~= "table" then d[k] = {} end end
	for _, k in NUMBERS do
		local v = tonumber(d[k])
		d[k] = if v and v == v and v &gt; -math.huge and v &lt; math.huge then math.max(0, v) else 0
	end
	if d.pinned ~= nil and not byId[d.pinned] then d.pinned = nil end
	return d
end
-- First `n` bytes of `s`, cut on a UTF-8 character boundary (a cut never splits a multi-byte character:
-- saves must stay valid UTF-8 for the DataStore and the client's text labels).
function Ops.clip(s: string, n: number): string
	if #s &lt;= n then return s end
	local cut = math.max(0, math.floor(n))
	while cut &gt; 0 do
		local b = string.byte(s, cut + 1)
		if b == nil or b &lt; 0x80 or b &gt;= 0xC0 then break end -- next byte starts a character: the cut is clean
		cut -= 1
	end
	return string.sub(s, 1, cut)
end
-- One line in the company log (newest first, &lt;= NEWS_MAX lines of &lt;= NEWS_CHARS bytes). stamp = this
-- company's "day 8 11:54" (Ops.stamp); Ops.post computes it from the company itself.
function Ops.news(d: any, text: string, stamp: string?)
	local line = if stamp and stamp ~= "" then stamp .. ": " .. text else text
	table.insert(d.news, 1, Ops.clip(line, Ops.NEWS_CHARS))
	while #d.news &gt; Ops.NEWS_MAX do table.remove(d.news) end
end
-- News written outside Ops.step (remote handlers, HR, pricing, model releases): stamped with the company's
-- own calendar day and the visible server clock (never another company's day).
function Ops.post(e: any, text: string, clock: number?)
	local d = Ops.ensure(e)
	Ops.news(d, text, Ops.stamp(e, clock or workspace:GetServerTimeNow()))
end
local function liveBest(data: any, stat: string): (number, any)
	local best, model = 0, nil
	for _, id in data.modelOrder or {} do
		local m = data.models[id]
		if m and m.status == "live" and m.stats and (m.stats[stat] or 0) &gt; best then best = m.stats[stat] or 0; model = m end
	end
	return best, model
end
Ops.liveBest = liveBest
local function repSkill(e: any): number
	local list = typeof(e.staffProfiles) == "table" and e.staffProfiles.marketer or nil
	local n = Ops.fieldReps(e)
	if typeof(list) ~= "table" or n == 0 then return 3 end
	local sum, c = 0, 0
	for i = 1, math.min(n, #list) do sum += Workforce.skill(list[i] and list[i].k); c += 1 end
	return if c &gt; 0 then sum / c else 3
end
-- trust gained on one visit (shown as "trust 67 %"): deterministic, no dice
function Ops.trustGain(e: any, data: any, c: any, hosted: boolean, founder: boolean, joined: boolean?): number
	local best = liveBest(data, c.stat)
	local skill = if founder then 3 else repSkill(e)
	local d = Ops.ensure(e)
	local first = if c.first and d.signed == 0 then Ops.FIRST_CLIENT_TRUST else 0
	local jet = if c.trip == "abroad" and not hosted and e.jet == true then Ops.JET.trust else 0
	local meet = if joined then Ops.MEETING_TRUST else 0
	return math.clamp(0.5 + 0.025 * (best - c.minimum) + 0.05 * (skill - 3) + (if hosted then Ops.HOSTED.trust else 0) + first + jet + meet, 0.35, 1)
end
local function eligible(e: any, data: any, c: any): boolean
	local st = Ops.stage(e)
	return Ops.stageIndex(e) &gt;= c.stage and TIER[c.trip] &lt;= TIER[st.trips] and liveBest(data, c.stat) &gt;= c.minimum
end
Ops.eligible = eligible
-- free account slots: min(stage slots, founder accounts + 2 per field rep)
function Ops.accountLimit(e: any): number
	return math.min(Ops.stage(e).clients, Ops.FOUNDER_ACCOUNTS + Ops.ACCOUNTS_PER_REP * Ops.fieldReps(e))
end
-- token capacity for B2B retainers (M tokens per billing month): throughput x 100 x thermal
function Ops.tokenCap(data: any): number
	local fleet = ModelMath.fleet(data.gpus)
	return fleet.throughput * 100 * HardwareConfig.thermal(data.empire, fleet.throughput)
end
-- hosted client teams staying at the guest house right now
function Ops.hostedInHouse(e: any): number
	local d = e.deals
	local n = 0
	if typeof(d) == "table" and typeof(d.tripList) == "table" then for _, t in d.tripList do if typeof(t) == "table" and t.hosted == true then n += 1 end end end
	return n
end
function Ops.hotelGuests(e: any): number
	local g = Ops.GUEST
	return math.floor(g.rooms * g.occupancy + 0.5) + Ops.HOSTED.guests * Ops.hostedInHouse(e)
end

-- safety rules (CORE_SPEC 8.3) ----------------------------------------------------------------------------
-- broke: seconds of continuous negative cash (&gt;= 1 day pauses trips and night crews);
-- unpaid leave: cash &lt; -2 x daily payroll -&gt; one more newest hire on unpaid leave per HIRE_GAP seconds while
-- the net flow is negative; cash &gt; 1 x daily payroll -&gt; everybody back.
local leaveClock: { [any]: number } = setmetatable({}, { __mode = "k" }) :: any
function Ops.safety(e: any, cash: number, netPerSecond: number, dt: number): boolean
	local d = Ops.ensure(e)
	d.broke = if cash &lt; 0 then d.broke + dt else 0
	local daily = Ops.dailyPayroll(e)
	local leave = math.max(0, math.floor(tonumber(e.unpaidLeave) or 0))
	local changed = false
	if leave &gt; 0 and cash &gt; daily then
		e.unpaidLeave = 0
		changed = true
	elseif cash &lt; -2 * daily and netPerSecond &lt; 0 and leave &lt; heads(e) then
		local t = (leaveClock[e] or 0) + dt
		if t &gt;= Ops.HIRE_GAP or leave == 0 then
			t = 0
			e.unpaidLeave = leave + 1
			changed = true
		end
		leaveClock[e] = t
	end
	return changed
end

-- one simulation step (EmpireService.tick, after wages). Economy = EconomyService (spend / applyFlow).
function Ops.step(session: any, dt: number, Economy: any, clock: number)
	Ops.applyScale()
	local data = session.data
	local e = data.empire
	local live = session.live
	local d = Ops.ensure(e)
	local now = tonumber(e.seconds) or 0
	Ops.advanceCalendar(e, clock)
	local stamp = Ops.stamp(e, clock) -- this company's day and the visible hour (per company, never shared)
	local function news(log: any, text: string)
		Ops.news(log, text, stamp)
	end
	local st = Ops.stage(e)
	local tokenCap = Ops.tokenCap(data)
	local inc: { [string]: number } = { b2b = 0, guest = 0 }
	local out: { [string]: number } = { b2bserve = 0, fleet = 0, ops = 0, upkeep = 0, food = 0, guest = 0, jet = 0 }
	local oneIn: { [string]: number } = {}
	local oneOut: { [string]: number } = {}
	local reps = Ops.fieldReps(e)
	local limit = Ops.accountLimit(e)
	local function accountCount(): number
		local n = 0
		for _ in d.accounts do n += 1 end
		return n
	end
	-- (times in accounts / trips are whole play seconds: small saves and snapshots, CORE_SPEC 11.8)
	-- 1. trips that are back
	local still = {}
	for _, trip in d.tripList do
		local c = if typeof(trip) == "table" then byId[trip.client] else nil
		if not c then continue end
		if now &lt; (tonumber(trip.back) or 0) then table.insert(still, trip); continue end
		if trip.kind == "renew" then
			local acc = d.accounts[c.id]
			if acc then acc.expires = math.floor(math.max(acc.expires, now) + Ops.TERM_DAYS * Ops.DAY + 0.5); acc.renewing = nil; news(d, "renewed " .. c.name .. " for " .. Ops.TERM_DAYS .. " days") end
		elseif eligible(e, data, c) and not d.accounts[c.id] then
			d.trust[c.id] = (tonumber(d.trust[c.id]) or 0) + Ops.trustGain(e, data, c, trip.hosted == true, trip.founder == true, trip.joined == true)
			if d.trust[c.id] &gt;= 1 and accountCount() &lt; limit then
				d.trust[c.id] = nil
				d.accounts[c.id] = { expires = math.floor(now + Ops.TERM_DAYS * Ops.DAY + 0.5), since = math.floor(now), founder = if trip.founder == true then true else nil }
				d.signed += 1
				e.contractsCompleted = (tonumber(e.contractsCompleted) or 0) + 1
				if data.company then data.company.reputation = math.min(100, data.company.reputation + 1.5) end
				oneIn.pilot = (oneIn.pilot or 0) + c.retainer * Ops.PILOT_DAYS
				news(d, string.format("signed %s: pilot %s, %s/day", c.name, money(c.retainer * Ops.PILOT_DAYS), money(c.retainer)))
			else
				news(d, string.format("visited %s: trust %d%%", c.name, math.floor(math.min(1, d.trust[c.id] or 0) * 100)))
			end
		end
	end
	d.tripList = still
	-- 2. active retainers
	local used = 0
	local function busyOn(id: string): boolean
		for _, trip in d.tripList do if trip.client == id then return true end end
		return false
	end
	for _, c in Ops.CLIENTS do
		local acc = d.accounts[c.id]
		if acc then
			local term = acc.expires &gt; now or acc.renewing == true
			local best, m = liveBest(data, c.stat)
			local ok = term and Ops.stageIndex(e) &gt;= c.stage and best &gt;= c.minimum and used + c.tokens &lt;= tokenCap
			if ok then
				used += c.tokens
				inc.b2b += c.retainer / Ops.DAY
				local size = m and ModelConfig.getSize(m.sizeId)
				out.b2bserve += c.tokens * (if size then size.serveCost else 0) / Ops.MONTH
			else
				d.accounts[c.id] = nil
				d.lost += 1
				local why = if not term then "no check-in before the term ended"
					elseif best &lt; c.minimum then string.format("needs %s %d, best live %d", c.stat, c.minimum, math.floor(best))
					else "not enough server capacity"
				news(d, "lost " .. c.name .. " (" .. why .. ")")
			end
		end
	end
	d.reserved = used / 100
	-- 3. free sellers start trips: renewals first, then a pinned client, then the most valuable open client.
	--    Founder: city only, one trip at a time, may hold FOUNDER_ACCOUNTS accounts.
	--    The scripted first pilot (CloudDesk) ignores the departure window.
	local office = Ops.hour(clock) &gt;= Ops.DEPART.from and Ops.hour(clock) &lt; Ops.DEPART.to
	local founderBusy, repTrips = false, 0
	for _, trip in d.tripList do if trip.founder then founderBusy = true else repTrips += 1 end end
	local freeReps = reps - repTrips
	local cashOk = data.money &gt;= 0 and d.broke &lt; Ops.DAY
	-- trip costs are booked after the loop below: every start checks the cash still uncommitted in this step,
	-- so several reps leaving together can never take the company below CASH_MARGIN (CORE_SPEC 8.3)
	local committed = 0
	local function openFor(c: any, founder: boolean): boolean
		if founder and c.trip ~= "city" then return false end
		return not d.accounts[c.id] and not busyOn(c.id) and not d.skip[c.id] and eligible(e, data, c) and used + c.tokens &lt;= tokenCap
	end
	local function pickFor(founder: boolean): (any, string?)
		for _, c in Ops.CLIENTS do
			local acc = d.accounts[c.id]
			if acc and not acc.renewing and (acc.founder == true) == founder and acc.expires - now &lt; (Ops.TRIPS[c.trip].days + Ops.RENEW_LEAD_DAYS) * Ops.DAY then return c, "renew" end
		end
		local pending = 0
		for _, trip in d.tripList do if trip.kind == "sign" then pending += 1 end end
		if accountCount() + pending &gt;= limit then return nil, nil end
		if founder then
			local fa = 0
			for _, acc in d.accounts do if acc.founder then fa += 1 end end
			for _, trip in d.tripList do if trip.founder and trip.kind == "sign" then fa += 1 end end
			if fa &gt;= Ops.FOUNDER_ACCOUNTS then return nil, nil end
			-- the scripted first pilot: "your friend at CloudDesk" is always the first client visited
			if d.signed == 0 then
				for _, c in Ops.CLIENTS do
					if c.first and not d.accounts[c.id] and not busyOn(c.id) and eligible(e, data, c) then return c, "sign" end
				end
			end
		end
		local pinned = byId[d.pinned or ""]
		if pinned and openFor(pinned, founder) then return pinned, "sign" end
		for k = #Ops.CLIENTS, 1, -1 do
			local c = Ops.CLIENTS[k]
			if openFor(c, founder) then return c, "sign" end
		end
		return nil, nil
	end
	local function start(c: any, kind: string, founder: boolean): boolean
		local hosted = false
		if kind == "sign" and not founder and st.guest and c.trip ~= "city" then
			hosted = (d.pilots % 2) == 1 -- every second region/abroad pilot is hosted at the guest house
		end
		local crew = if kind == "renew" or founder then 1 else Ops.TRIPS[c.trip].crew
		local jet = e.jet == true
		local duration, nights, cost = Ops.tripPlan(c.trip, crew, hosted, jet)
		if data.money - committed &lt; cost + Ops.CASH_MARGIN then return false end
		committed += cost
		oneOut.trips = (oneOut.trips or 0) + cost
		if not hosted then
			d.nights += crew * nights
			if c.trip == "abroad" then if jet then d.jetFlights += 1 else d.flights += crew end end
		else
			d.hosted += 1
		end
		if kind == "sign" and c.trip ~= "city" and not founder then d.pilots += 1 end
		d.trips += 1
		if kind == "renew" then d.accounts[c.id].renewing = true end
		table.insert(d.tripList, { client = c.id, kind = kind, back = math.floor(now + duration + 0.5), founder = founder, hosted = hosted, crew = if hosted then 0 else crew, left = math.floor(now) })
		local what = if kind == "renew" then "check-in" else "pilot"
		if founder then
			news(d, string.format("founder drives to %s: %s, %s", c.name, what, money(cost)))
		elseif hosted then
			news(d, string.format("hosting %s at the guest house: %s, %s", c.name, what, money(cost)))
		else
			local how = if c.trip == "abroad" then (if jet then "jet" else "flight") .. " + " .. nights .. (if nights == 1 then " night" else " nights")
				elseif c.trip == "region" then "City Hotel night"
				else "car"
			news(d, string.format("rep to %s: %s, %s, %s", c.name, what, how, money(cost)))
		end
		return true
	end
	if cashOk and not founderBusy then
		local c, kind = pickFor(true)
		if c and kind and (office or (c.first and d.signed == 0)) then if start(c, kind, true) then founderBusy = true end end
	end
	while cashOk and office and freeReps &gt; 0 do
		local c, kind = pickFor(false)
		if not c or not kind then break end
		if not start(c, kind, false) then break end
		freeReps -= 1
	end
	-- 4. running costs
	local posts = Ops.opsPosts(e)
	local stageIdx = Ops.stageIndex(e)
	local drivers = if stageIdx &gt;= Ops.DRIVER.more then 2 elseif stageIdx &gt;= Ops.DRIVER.from then 1 else 0
	-- the Training Lead is paid while there are apprentices to train (stage &gt;= 3)
	local lead = if stageIdx &gt;= Ops.TRAINING_LEAD.from and Ops.apprenticeCount(e) &gt; 0 then Ops.TRAINING_LEAD.wage else 0
	local staff = heads(e)
	out.fleet = reps * Ops.FLEET_LEASE / Ops.DAY
	out.ops = ((posts + drivers) * Ops.OPS_WAGE + lead + (staff + posts) * Ops.PHONE) / Ops.DAY
	out.upkeep = st.upkeep / Ops.DAY
	if e.jet == true then out.jet = (Ops.JET.pilots * Ops.JET.pilotWage + Ops.JET.upkeep) / Ops.DAY end
	out.food = (staff + posts) * Ops.AVAILABILITY * st.food / Ops.DAY
	if st.guest then
		local g = Ops.GUEST
		inc.guest = g.rooms * g.occupancy * g.rate / Ops.DAY
		out.guest = g.utilities / Ops.DAY
	end
	-- 5. book everything through EconomyService (4th argument = ledger category)
	local summary: { [string]: any } = {}
	for cat, r in inc do
		if r &gt; 0 then Economy.applyFlow(session, r * dt, 0, cat); live.revenue += r end
		summary[cat] = math.floor(r * 60 + 0.5)
	end
	for cat, c in out do
		if c &gt; 0 then Economy.applyFlow(session, 0, c * dt, cat); live.cost += c end
		summary[cat .. "Cost"] = math.floor(c * 60 + 0.5)
	end
	for cat, amount in oneIn do Economy.applyFlow(session, amount, 0, cat) end
	for cat, amount in oneOut do Economy.applyFlow(session, 0, amount, cat) end
	-- 6. safety rules (broke pause, unpaid leave)
	local wasBroke = d.broke &gt;= Ops.DAY
	if Ops.safety(e, data.money, (live.revenue or 0) - (live.cost or 0), dt) then
		local n = math.floor(tonumber(e.unpaidLeave) or 0)
		news(d, if n &gt; 0 then string.format("cash below -%s: %d newest hires on unpaid leave", money(2 * Ops.dailyPayroll(e)), n) else "cash recovered: everybody is back from unpaid leave")
	end
	if not wasBroke and d.broke &gt;= Ops.DAY then news(d, "cash below $0 for a whole day: trips and night shifts paused") end
	-- 7. what later visuals and the phone need (session.live.ops: replicated lazily)
	local trips = {}
	for _, trip in d.tripList do
		local c = byId[trip.client]
		table.insert(trips, { client = trip.client, name = c and c.name, kind = trip.kind, tier = c and c.trip, back = math.floor(trip.back), founder = trip.founder == true, hosted = trip.hosted == true, crew = trip.crew or 1 })
	end
	summary.accounts = accountCount()
	summary.limit = limit
	summary.slots = st.clients
	summary.travelling = #d.tripList
	summary.trips = trips
	summary.reps = reps
	summary.ops = posts
	summary.drivers = drivers
	summary.guests = if st.guest then Ops.hotelGuests(e) else 0
	summary.day = Ops.day(e)
	summary.paused = d.broke &gt;= Ops.DAY
	live.ops = summary
end
return Ops
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000009"><Properties><string name="Name">Dialogue</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Dialogue: what the people in a company say when you talk to them (TalkService / TalkPanel).
-- AUTHORED, not a language model: every line is a template picked deterministically from the person's
-- appearance seed + the campus day + the topic (several templates per topic), and filled ONLY with real
-- game state:
--   subject = the person, read from the rig: name, RoleId + Role (job title), PersonalitySeed,
--             Activity / Task / Pose, the room they stand in (+ level label, kind, desks in use), their
--             home desk (room, department, desks in use), lunch phase, Skill k and wage $/s (profile).
--   context = who is asking ("owner" or "visitor"), the company facts (Dialogue.facts over the owner's
--             session data/live), places for directions (Dialogue.places over BuildingPlan) and the
--             counts TalkService measures (visitors now/today, conversations today, open faults, desks
--             and desks in use, café seats, guest cards, cars, lunches served when the life package
--             reports them).
-- The building explains itself: "What's this room for?" (room kind / department of the plan room the
-- person stands in), "What does your team do?" (home desk room + department + the role's real effect
-- from EmpireConfig.ROLES.desc) and a floor-by-floor tour (BuildingPlan.levelName for every level).
-- Pure: no Roblox services, so every role x job x state is tested headlessly (tests/talk).
-- Tone: personalityFromSeed(seed).social → confident (&gt;= .66) / calm / shy (&lt; .33).
-- Who may talk: the owner with everyone in the company; visitors only with front-of-house jobs
-- (Dialogue.isPublicJob: reception, hotel reception, security, barista, café host, chef).
-- Flow: lines.options = up to 3 topics + "bye"; Dialogue.step answers one option and returns the next
-- options (follow-ups such as the places of "Where is …?" first, then the topics not asked yet).
-- staffops: absences ("Mia Weber is on vacation today (back on day 14)", "Jonas Klein is sick today") come
-- from CompanyOps.presence over the saved team (facts.away), apprentices from CompanyOps.apprentice
-- (facts.apprentices: training day, skill, 40 % wage), rack faults from CompanyOps.faults; the Training Lead
-- (kind "trainer"), first-day hires, rack repairs, the apprentice tour ("Tour:&lt;room id&gt;"), training session,
-- shadowing and practice have their own lines. Night crew shifts come from the rig's ShiftStart / ShiftEnd.
local Config=require(script.Parent.Config.EmployeeConfig)
local EmpireConfig=require(script.Parent.Config.EmpireConfig)
local Plan=require(script.Parent.Config.BuildingPlan)
local Departments=require(script.Parent.Config.DepartmentConfig)
local Format=require(script.Parent.Format)
local ModelMath=require(script.Parent.ModelMath)
local EmpireMath=require(script.Parent.EmpireMath)
local Ops=require(script.Parent.CompanyOps)
local Dialogue={}
Dialogue.MAX_OPTIONS=4 -- chips shown at once (incl. the goodbye chip)
Dialogue.DAY_SECONDS=1200 -- one campus day (EmployeeConfig.hour)
export type Option={id: string,text: string}
export type Answer={text: string,follow: {Option}?,close: boolean?}
export type Lines={kind: string,tone: string,viewer: string,greeting: string,topics: {Option},options: {Option},answers: {[string]:Answer},farewell: string}
export type Place={id: string,name: string,level: number,label: string,access: string,text: string}
-- Template chooser of one conversation: (topic key, variants) → one variant, stable per person + day.
type Vary=(string,{string})-&gt;string

-- Small helpers ------------------------------------------------------------------------------------
local function num(x: any,default: number?): number
 if typeof(x)=="number" and x==x and x&gt;-math.huge and x&lt;math.huge then return x end
 return default or 0
end
local function first(name: string): string return string.match(name,"^%s*(%S+)") or name end
local function plural(n: number,word: string,many: string?): string
 local whole=math.floor(n+.5)
 return Format.int(whole).." "..(if whole==1 then word else (many or word.."s"))
end
-- "Data &amp; model foundations" → "data &amp; model foundations" (acronyms such as "AI …" stay)
local function lowerFirst(text: string): string
 if string.match(text,"^%u%u") then return text end
 return string.lower(string.sub(text,1,1))..string.sub(text,2)
end
-- "Nimbus Labs'" / "Noah's"
local function possessive(name: string): string return if string.sub(name,-1)=="s" then name.."'" else name.."'s" end
-- "the A, the B and the C"
local function roomList(names: {string}): string
 local out={}
 for _,n in names do table.insert(out,"the "..n) end
 if #out&lt;=1 then return out[1] or "" end
 return table.concat(out,", ",1,#out-1).." and "..out[#out]
end
local function keyHash(key: string): number
 local h=7;for i=1,#key do h=(h*31+string.byte(key,i))%1000003 end;return h
end
-- Deterministic choice per person, campus day and topic (identical on every server).
local function pick&lt;T&gt;(list: {T},seed: number,day: number,key: string): T
 return list[Config.hash(math.floor(math.abs(seed))*7+math.floor(math.abs(day))*131+keyHash(key))%#list+1]
end
local function fill(text: string,vars: {[string]:string}): string
 return (string.gsub(text,"{(%w+)}",function(k: string): string return vars[k] or ("{"..k.."}") end))
end
-- "8:15", "13:05" (EmployeeConfig hours are fractional, 12.5 = 12:30)
function Dialogue.clock(hour: number): string
 local h=math.floor(num(hour))%24;local m=math.floor((num(hour)%1)*60+.5)
 if m&gt;=60 then h=(h+1)%24;m=0 end
 return string.format("%d:%02d",h,m)
end
-- Spoken durations: "45 seconds", "3 min", "2 min 10 s", "1 h 20 min".
function Dialogue.spoken(seconds: number): string
 local s=math.max(0,math.floor(num(seconds)+.5))
 if s&lt;60 then return plural(s,"second") end
 if s&lt;600 then local m,r=s//60,s%60;return if r==0 then tostring(m).." min" else string.format("%d min %d s",m,r) end
 if s&lt;3600 then return tostring(math.floor(s/60+.5)).." min" end
 local h,m=s//3600,math.floor((s%3600)/60+.5)
 if m==60 then h+=1;m=0 end
 return if m==0 then tostring(h).." h" else string.format("%d h %d min",h,m)
end
function Dialogue.initials(name: string): string
 local out=""
 for word in string.gmatch(name,"%S+") do out..=string.sub(word,1,1);if #out&gt;=2 then break end end
 return string.upper(out)
end
function Dialogue.tone(seed: number): string
 local social=Config.personalityFromSeed(num(seed)).social
 return if social&gt;=.66 then "confident" elseif social&lt;.33 then "shy" else "calm"
end

-- Jobs -------------------------------------------------------------------------------------------
local HIRED={researcher=true,engineer=true,curator=true,marketer=true}
local PUBLIC={reception=true,hotel=true,security=true,barista=true,host=true,chef=true}
-- Topic family of a person: the four hired roles by RoleId, operations staff by their job title
-- (EmployeeConfig.OPERATIONS_JOBS incl. jobs added later such as "Hotel Reception", "Housekeeping").
function Dialogue.kind(roleId: string?,job: string?): string
 if roleId and HIRED[roleId] then return roleId end
 local j=string.lower(job or "")
 if string.find(j,"hotel",1,true) then return "hotel" end
 if string.find(j,"reception",1,true) then return "reception" end
 if string.find(j,"security",1,true) or string.find(j,"guard",1,true) then return "security" end
 if string.find(j,"housekeep",1,true) then return "housekeeping" end
 if string.find(j,"clean",1,true) or string.find(j,"janitor",1,true) then return "cleaner" end
 if j=="it" or string.find(j,"^it ") or string.find(j,"it support",1,true) then return "it" end
 if string.find(j,"barista",1,true) then return "barista" end
 if string.find(j,"chef",1,true) or string.find(j,"cook",1,true) then return "chef" end
 if string.find(j,"kitchen",1,true) then return "kitchen" end
 if string.find(j,"host",1,true) then return "host" end
 if string.find(j,"fleet",1,true) or string.find(j,"mechanic",1,true) or string.find(j,"driver",1,true) then return "fleet" end
 if string.find(j,"facilit",1,true) or string.find(j,"maintenance",1,true) then return "facilities" end
 if string.find(j,"mail",1,true) then return "mailroom" end
 if string.find(j,"training lead",1,true) or string.find(j,"trainer",1,true) then return "trainer" end
 return "ops"
end
function Dialogue.isPublicKind(kind: string): boolean return PUBLIC[kind]==true end
-- Front-of-house jobs visitors (other players) may talk to; EmployeeRigDesign makes their prompt Public.
function Dialogue.isPublicJob(job: string?): boolean
 if job==nil then return false end
 return PUBLIC[Dialogue.kind(nil,job)]==true
end

-- Company facts from the owner's session (plain data; same numbers the assistant briefing shows) ----
local function trend(history: any): (number?,number?)
 if typeof(history)~="table" or #history&lt;2 then return nil,nil end
 local function avg(from: number,to: number): number
  local sum,n=0,0
  for i=math.max(1,from),to do local h=history[i];sum+=if typeof(h)=="table" then num(h.profit) else 0;n+=1 end
  return if n&gt;0 then sum/n else 0
 end
 local last=#history;local window=math.min(6,math.floor(last/2))
 local recent=avg(last-window+1,last);local before=avg(last-2*window+1,last-window)
 return recent,recent-before
end
function Dialogue.facts(data: any,live: any): any
 local e: any=if typeof(data.empire)=="table" then data.empire else {}
 local lv: any=if typeof(live)=="table" then live else {}
 local f: any={company=if typeof(data.company)=="table" then tostring(data.company.name) else "the company",
  cash=num(data.money),revenue=num(lv.revenue),cost=num(lv.cost),users=num(lv.users)}
 f.profitPerMin=(f.revenue-f.cost)*60
 f.trendRecent,f.trendDelta=trend(e.history)
 local liveCount,best=0,nil
 local models: any=if typeof(data.models)=="table" then data.models else {}
 for _,id in (if typeof(data.modelOrder)=="table" then data.modelOrder else {}) :: {any} do
  local m=models[id]
  if typeof(m)=="table" and m.status~="training" then
   if not best or num(m.overall)&gt;num(best.overall) then best=m end
   if m.status=="live" then liveCount+=1 end
  end
 end
 f.live=liveCount
 f.best=if best then {name=tostring(best.name),overall=num(best.overall)} else nil
 local stats: any=if typeof(data.stats)=="table" then data.stats else {}
 f.trained=num(stats.modelsTrained);f.released=num(stats.modelsReleased)
 local t=data.training
 if typeof(t)=="table" then
  local m=models[t.modelId];local total=num(t.workTotal);local done=num(t.workDone)
  local ok,rate=pcall(EmpireMath.trainingRate,data.gpus,total,e)
  local r=if ok then num(rate) else 0
  f.training={model=if typeof(m)=="table" then tostring(m.name) else "the new model",progress=if total&gt;0 then math.clamp(done/total,0,1) else 0,
   eta=if r&gt;0 then math.max(0,(total-done)/r) else nil,decision=typeof(t.event)=="table" and t.event.pending==true}
 end
 local staff=0;f.roles={}
 local employees: any=if typeof(e.employees)=="table" then e.employees else {}
 for _,role in EmpireConfig.ROLES do local n=num(employees[role.id]);f.roles[role.id]=n;staff+=n end
 f.staff=staff
 local office=EmpireConfig.OFFICES[num(e.office,1)]
 f.cap=if office then office.staff else nil
 local open,waiting=0,0
 for _,a in (if typeof(e.applicants)=="table" then e.applicants else {}) :: {any} do
  if typeof(a)=="table" then if a.st=="new" then open+=1 else waiting+=1 end end
 end
 f.applicantsOpen=open;f.applicantsWaiting=waiting
 local research: any=if typeof(e.research)=="table" then e.research else {}
 local job=e.researchJob
 if typeof(job)=="table" then
  local def=EmpireConfig.find(EmpireConfig.RESEARCH,job.id)
  local seconds=math.max(1,num(job.seconds,1))
  f.research={name=if def then def.name else tostring(job.id),progress=math.clamp(num(job.elapsed)/seconds,0,1),left=math.max(0,seconds-num(job.elapsed))}
 end
 f.points=num(e.points)
 local doneCount=0
 for _,def in EmpireConfig.RESEARCH do
  if research[def.id] then doneCount+=1
  elseif not f.nextResearch and (not def.prereq or research[def.prereq]) then f.nextResearch={name=def.name,points=def.points,cost=def.cost} end
 end
 f.researchDone=doneCount;f.researchTotal=#EmpireConfig.RESEARCH
 local okData,stock=pcall(ModelMath.dataSummary,if typeof(data.data)=="table" then data.data else {})
 f.tokens=if okData then num(stock.total) else 0;f.quality=if okData then num(stock.quality) else 0
 local okFleet,fleet=pcall(ModelMath.fleet,if typeof(data.gpus)=="table" then data.gpus else {})
 f.vram=if okFleet then num(fleet.vram) else 0;f.slots=if okFleet then num(fleet.slotsUsed) else 0
 -- staffops: who is away today, apprentices, rack faults (same functions the economy uses)
 f.day=Ops.day(e)
 f.away={};f.awayCount={vacation=0,sick=0,trip=0,leave=0};f.apprentices={};f.apprenticeCount=0
 local profiles: any=if typeof(e.staffProfiles)=="table" then e.staffProfiles else {}
 for _,role in EmpireConfig.ROLES do
  if num(employees[role.id])&lt;=0 then continue end
  local list: any=profiles[role.id]
  local okP,presence=pcall(Ops.presence,e,role.id)
  for i,state in (if okP and typeof(presence)=="table" then presence else {}) :: {string} do
   local p=if typeof(list)=="table" then list[i] else nil
   local name=if typeof(p)=="table" and typeof(p.n)=="string" then p.n else nil
   local seed=if typeof(p)=="table" and typeof(p.s)=="number" and p.s==p.s then math.floor(math.abs(p.s))%2147483647 else nil
   if state~="present" and name then
    table.insert(f.away,{name=name,role=role.id,state=state,back=f.day+1})
    f.awayCount[state]=(f.awayCount[state] or 0)+1
   end
   if seed and typeof(e.apprentices)=="table" then
    local entry=e.apprentices[tostring(seed)]
    local skill=Ops.apprentice(e,seed,f.day)
    if skill and typeof(entry)=="table" then
     local age=math.max(0,f.day-num(entry.day,f.day))
     f.apprentices[seed]={name=name or "an apprentice",role=role.id,day=age+1,skill=skill,graduates=num(entry.day,f.day)+Ops.APPRENTICE.graduateDays}
     f.apprenticeCount+=1
    end
   end
  end
 end
 local okF,faults=pcall(Ops.faults,e)
 f.rackFaults=if okF and typeof(faults)=="table" then #faults else 0
 f.stage=Ops.stageIndex(e)
 return f
end

-- Places for "Where is …?" -------------------------------------------------------------------------
-- Building-local geometry → spoken directions. Entering from the street you walk +Z, so +X (east
-- wing, e.g. the café) is on your LEFT and -X (west wing, visitor lounge) on your RIGHT.
local function levelPhrase(tier: number,level: number): string
 if level&lt;0 then return "down on B1"
 elseif level==0 then return "on the ground floor (G)"
 elseif level==Plan.roofLevel(tier) then return "up on the roof (R)" end
 return "on level "..Plan.levelLabel(tier,level)
end
function Dialogue.describe(room: any,tier: number,fromLevel: number?): string
 local cx=(room.x1+room.x2)/2;local cz=(room.z1+room.z2)/2
 local where={}
 if room.pavilion then table.insert(where,"in the pavilion behind the main building")
 elseif room.level&lt;0 and cx&gt;-22 and cx&lt;22 and cz&gt;36 then table.insert(where,"right by the lift")
 else
  if cx&lt;-22 then table.insert(where,"on the right as you come in from the street")
  elseif cx&gt;22 then table.insert(where,"on the left as you come in from the street")
  else table.insert(where,"in the middle of the building") end
  if cz&lt;-16 then table.insert(where,"at the front") elseif cz&gt;54 then table.insert(where,"at the back") end
 end
 local text="The "..room.name.." is "..levelPhrase(tier,room.level)..", "..table.concat(where,", ").."."
 if fromLevel~=nil then
  if fromLevel==room.level then text..=" It's on this floor."
  else text..=" Take the lift or the stairs behind the atrium to "..Plan.levelLabel(tier,room.level).."." end
 end
 return text
end
-- Rooms by id in the order given (unknown or hidden rooms are skipped).
function Dialogue.places(tier: number,ids: {string},fromLevel: number?): {Place}
 local out: {Place}={}
 for _,id in ids do
  local r: any=Plan.room(tier,id)
  if r and not r.hidden then
   table.insert(out,{id=r.id,name=r.name,level=r.level,label=Plan.levelLabel(tier,r.level),access=r.access,text=Dialogue.describe(r,tier,fromLevel)})
  end
 end
 return out
end
-- Which places a person points to (front desk staff know the visitor routes; the owner gets the
-- rooms a founder looks for). Only public rooms for visitors.
local PLACE_IDS: {[string]:{[string]:{string}}}={
 owner={reception={"G_CAFE","F_BOARDROOM","F_OFFICE","B1_DATAHALL","P0_GYM","R_TERRACE"},
  security={"P1_SECURITY","B1_GARAGE","G_COMPUTE","B1_DATAHALL"},hotel={"G_CAFE","B1_GARAGE","G_VISITOR"},
  host={"G_CAFE","G_VISITOR","R_TERRACE"}},
 visitor={reception={"G_CAFE","G_SHOWROOM","G_VISITOR"},security={"G_VISITOR","G_SHOWROOM","G_CAFE"},hotel={"G_CAFE","G_VISITOR","G_SHOWROOM"},
  host={"G_CAFE","G_SHOWROOM","G_VISITOR"},barista={"G_CAFE","G_SHOWROOM","G_VISITOR"},chef={"G_CAFE","G_SHOWROOM","G_VISITOR"}},
}
function Dialogue.placeIds(viewer: string,kind: string): {string}
 local byViewer=PLACE_IDS[viewer] or PLACE_IDS.visitor
 return byViewer[kind] or {}
end

-- What the building has -------------------------------------------------------------------------------
-- Floor by floor from the plan: "B1 garage, data hall &amp; building services · G reception, … · R roof terrace".
function Dialogue.floorGuide(tier: number): string
 local parts={}
 for _,level in Plan.levels(tier) do table.insert(parts,Plan.levelLabel(tier,level).." "..lowerFirst(Plan.levelName(tier,level))) end
 return table.concat(parts," · ")
end
-- What a department does (names from DepartmentConfig; the wording matches its descriptions).
local DEPT_TEXT: {[string]:string}={
 data="Our training data gets collected, filtered, cleaned and tokenized here. Better data makes the next model better.",
 design="Here we decide how big a new model gets and what it should be good at.",
 research="The experiments behind our research projects happen here.",
 evaluation="Every model gets benchmarked here before it ships: coding, reasoning, math, creativity, knowledge and reliability.",
 engineering="The training code gets written here, and models get ready to train on our GPUs.",
 training="From here we watch the GPUs while a model trains: progress, loss and the decisions along the way.",
 growth="Our models meet users and API customers here: pricing, target markets and support.",
 deployment="Launches get prepared here: pick a trained model, set prices and a target market, then market it.",
 operations="Hiring, onboarding and company admin happen here, so every team stays staffed.",
}
-- What a room of a given plan kind is for (rooms without a department).
local ROOM_TEXT: {[string]:string}={
 lobby="This is the {room}. Visitors check in at the desk, and the speed gates behind it keep the offices for people with a company card.",
 visitor_lounge="This is the {room}. Guests and job applicants wait here until someone picks them up.",
 cafe="This is the {room}. The kitchen serves lunch to the whole team here, and anyone can buy coffee and snacks. Snacks give you a speed boost for a while.",
 kitchen_boh="This is the {room}. The chef and the kitchen team cook lunch for the whole company here.",
 showroom="This is the {room}. We show our models to visitors here.",
 atrium="This is the {room}. The lift and the main stairs connect every floor from here.",
 first_ai="This is the {room}, a small team room on the ground floor. Overflow desks for the team are in here.",
 project_meeting="This is the {room}. Teams meet here to plan projects and review models.",
 meeting="This is the {room}, a meeting room. Teams meet here to plan and review their work.",
 boardroom="This is the {room}. Big decisions and model reviews happen around this table.",
 pantry="This is the {room}. Coffee and snacks for the team between tasks.",
 lounge="This is the {room}. People come here for a short break.",
 recovery="This is the {room}. A quiet place to recharge after a workout or the sauna.",
 terrace="This is the {room}. Fresh air between meetings.",
 roof_terrace="This is the {room}. Fresh air and a view over the city, right on top of the building.",
 focus="This is the {room}, a focus room: one desk for quiet, concentrated work.",
 phone="These are the {room}, for private calls.",
 print="This is the {room}: printers, paper and office supplies.",
 hr="This is the {room}. Hiring, onboarding and company admin happen here.",
 datahall="This is the {room}. Our GPU racks live here, and every GPU you install lights up a blade.",
 compute="This is {room}. The servers and the cooling are watched from here.",
 itdesk="This is the {room}. Broken screens and laptops end up here.",
 garage="This is the {room}. The company cars park and charge down here.",
 fleet="This is the {room}. The company cars are looked after from here.",
 workshop="This is the {room}. Cars and hardware get fixed down here.",
 storage="This is {room}. New hardware and supplies are stored here.",
 delivery="This is {room}. Supplies arrive here, and the cleaning carts are parked here.",
 mailroom="This is the {room}. Post and parcels for the whole building are sorted here.",
 gym="This is the {room}. A workout here gives you a speed boost for a while.",
 sauna="This is the {room}. A sauna session gives you a speed boost for a while.",
 showers="These are the {room}, for after a workout.",
 restrooms="These are the {room}.",wc="These are the {room}.",
 security="This is {room}. The camera feeds of the building come in here.",
 founder_office="This is the {room}. It's yours.",founder_bath="This is the {room}, part of the founder suite.",founder_assist="This is the {room}. Your assistant works here.",
 founder_library="This is the {room}, a quiet place for the founder.",archive="This is the {room}. Company records are kept here.",
 vault="This is the {room}. Our trained models are kept safe here.",prototype="This is the {room}. Hardware prototypes are built in here.",
 plant="This is the {room}: power and cooling for the whole building.",ups="This is the {room}. The batteries keep the servers running if the power fails.",
 machine="This is the {room}. The lift motor lives up here.",roof_tech="This is the {room}: cooling and ventilation.",roof_solar="This is the {room}. It makes some of our power.",
 garden_lobby="This is the {room}. It connects the main building with the wellness pavilion.",
 pavilion_roof="This is the {room}, a green roof on top of the pavilion.",
}
-- Desks in a room: "8 desks in here, 5 in use right now."
local function deskLine(desks: any,busy: any,where: string): string
 if typeof(desks)~="number" or desks&lt;=0 then return "" end
 local text=" "..plural(desks,"desk").." "..where
 if typeof(busy)=="number" then text..=", "..Format.int(math.min(busy,desks)).." in use right now" end
 return text.."."
end
-- "What's this room for?" about the plan room the person stands in.
local function roomText(subject: any,c: any): string
 local name=tostring(subject.room or "room")
 local dept=subject.roomDept
 local d=if typeof(dept)=="string" then (Departments.DEPARTMENTS :: any)[dept] else nil
 local text
 if d and subject.roomKind=="focus" then text="This is "..name..", a focus room of "..d.name..": one desk for quiet, concentrated work."
 elseif d and DEPT_TEXT[dept] then
  -- "the Data Operations A" needs no "part of Data Operations"
  text="This is the "..name..(if string.find(name,d.name,1,true) then "" else ", part of "..d.name)..". "..DEPT_TEXT[dept]
 elseif typeof(subject.roomKind)=="string" and ROOM_TEXT[subject.roomKind] then text=fill(ROOM_TEXT[subject.roomKind],{room=name})
 else text="This is the "..name.."." end
 text..=deskLine(subject.roomDesks,subject.roomBusy,"in here")
 if subject.roomKind=="cafe" and typeof(c.dining)=="number" then text..=" "..plural(c.dining,"seat").." at the tables." end
 if subject.roomCamera==true then text..=" It's covered by the security cameras." end
 local label=if typeof(subject.roomAccess)=="string" and subject.roomAccess~="staff" then (Plan.CLASS_LABEL :: any)[subject.roomAccess] else nil
 if typeof(label)=="string" then text..=" The door sign says: "..label.."." end
 return text
end
-- Only rooms with an authored purpose are offered ("What's this room for?" never answers "the Stairs").
function Dialogue.explainsRoom(subject: any): boolean
 if typeof(subject.roomKind)~="string" then return false end
 if ROOM_TEXT[subject.roomKind] then return true end
 return typeof(subject.roomDept)=="string" and DEPT_TEXT[subject.roomDept]~=nil
end
-- Building tour: floors, what each floor is for, the visitor areas, desks.
local function tourText(c: any,owner: boolean,V: Vary): string
 local tier=num(c.tier,1)
 local company=tostring(c.company or (c.facts and c.facts.company) or "The company")
 local top=Plan.levelLabel(tier,Plan.founderLevel(tier))
 local text=fill(V("tour",{"{company} headquarters has {floors} from G up to {top}, plus B1 below and the roof on top.",
  "We have {floors} here, G up to {top}, plus B1 and the roof."}),{company=possessive(company),floors=plural(Plan.floors(tier),"floor"),top=top})
 text..=" Floor by floor: "..Dialogue.floorGuide(tier).."."
 local b=c.building
 local public=if typeof(b)=="table" and typeof(b.publicRooms)=="table" and #b.publicRooms&gt;0 then roomList(b.publicRooms) else nil
 if owner then
  if typeof(c.desks)=="number" and c.desks&gt;0 then
   text..=" "..plural(c.desks,"computer desk").." in total"
   if typeof(c.desksBusy)=="number" then text..=", "..Format.int(math.min(c.desksBusy,c.desks)).." in use right now" end
   text..="."
  end
  if public then text..=" Visitors may use "..public.."." end
 elseif public then
  text..=" As a visitor you're welcome in "..public..". Everything else needs a company card."
 end
 return text
end

-- Phrases ----------------------------------------------------------------------------------------
local ROLE_NAME: {[string]:string}={researcher="AI researcher",engineer="ML engineer",curator="data curator",marketer="growth manager"}
local JOB_PHRASE: {[string]:string}={reception="I run the front desk",hotel="I look after the hotel desk",security="I'm on security",facilities="I keep the building running",
 it="I'm IT support",barista="I'm the barista",chef="I'm the chef",kitchen="I'm on the kitchen team",host="I host the café",fleet="I look after the company cars",
 housekeeping="I'm on housekeeping",cleaner="I keep the place clean",mailroom="I run the mailroom",trainer="I train our apprentices",ops="I'm on the campus team"}
local function hello(hour: number): string
 return if hour&gt;=5 and hour&lt;12 then "Good morning" elseif hour&gt;=12 and hour&lt;17 then "Good afternoon" else "Good evening"
end
local function roomPhrase(subject: any): string
 if typeof(subject.room)~="string" or subject.room=="" then return "" end
 local label=if typeof(subject.level)=="string" then " ("..subject.level..")" else ""
 return " in the "..subject.room..label
end
local function count(f: any,key: string): number return num(f[key]) end
local function profitTrend(f: any): string
 local recent,delta=f.trendRecent,f.trendDelta
 if typeof(recent)~="number" or typeof(delta)~="number" then
  return "We make "..Format.money(num(f.profitPerMin)).." a minute right now."
 end
 local steady=math.abs(delta)&lt;math.max(5,math.abs(recent)*.05)
 if steady then return "Profit is steady at "..Format.money(recent).." a minute." end
 if delta&gt;0 then return "Profit is rising: "..Format.money(recent).." a minute, up "..Format.money(delta).."." end
 return "Profit is falling: "..Format.money(recent).." a minute, down "..Format.money(-delta).."."
end
local function modelsLine(f: any): string
 local live=count(f,"live")
 if live&lt;=0 then
  if f.best then return "Nothing is live yet; our best trained model is "..f.best.name.." at "..string.format("%.1f",f.best.overall).." overall." end
  return "We haven't released a model yet."
 end
 local text=plural(live,"model").." live with "..Format.compact(count(f,"users")).." users."
 if f.best then text..=" Our best is "..f.best.name.." at "..string.format("%.1f",f.best.overall).." overall." end
 return text
end
local function trainingLine(f: any): string
 local t=f.training
 if typeof(t)~="table" then return "Nothing is training right now." end
 local text=t.model.." is training: "..Format.percent(t.progress,0).." done"
 if typeof(t.eta)=="number" then text..=", about "..Dialogue.spoken(t.eta).." to go." else text..=", but it's waiting for compute." end
 if t.decision then text..=" There's a decision waiting for you in the Lab." end
 return text
end
local function researchLine(f: any): string
 local r=f.research
 if typeof(r)=="table" then
  return "We're researching "..r.name..": "..Format.percent(r.progress,0).." done, "..Dialogue.spoken(r.left).." left."
 end
 local n=f.nextResearch
 if typeof(n)=="table" then
  local text="No research project is running. Next up is "..n.name..": "..Format.int(n.points).." RP and "..Format.money(n.cost).."."
  return text.." We have "..Format.int(math.floor(count(f,"points"))).." RP banked."
 end
 return "Every research project is finished. We have "..Format.int(math.floor(count(f,"points"))).." RP banked."
end
-- Research topic: the running project plus what comes after it (the work answer cites only the first part).
local function researchMore(f: any): string
 local text=researchLine(f)
 if typeof(f.research)=="table" then
  text..=" "..Format.int(count(f,"researchDone")).." of "..Format.int(count(f,"researchTotal")).." projects are done"
  if typeof(f.nextResearch)=="table" and f.nextResearch.name~=f.research.name then text..=", and "..f.nextResearch.name.." could come next" end
  text..="."
 end
 return text
end
local function dataLine(f: any): string
 return "We hold "..Format.tokens(count(f,"tokens")).." tokens of training data at "..Format.percent(count(f,"quality"),0).." quality."
end
local function hardwareLine(f: any): string
 local slots=count(f,"slots")
 if slots&lt;=0 then return "We haven't installed a GPU yet." end
 return "We run "..plural(slots,"GPU slot").." with "..Format.int(count(f,"vram")).." GB of VRAM in total."
end
local function marketLine(f: any): string
 if count(f,"live")&lt;=0 then return "Nothing is live, so there's no market data yet. Release a model in Deployment and I'll get to work." end
 return Format.compact(count(f,"users")).." users on "..plural(count(f,"live"),"live model")..". Revenue is "..Format.money(count(f,"revenue")*60).." a minute, costs "..Format.money(count(f,"cost")*60).."."
end
local function staffLine(f: any): string
 local text="We're "..plural(count(f,"staff"),"specialist").." on the team"
 if typeof(f.cap)=="number" then text..=", with desks for "..Format.int(f.cap) end
 return text.."."
end
local function menuLine(menu: any,seed: number,day: number,V: Vary): string
 if typeof(menu)~="table" or #menu==0 then return "The menu board is empty today." end
 local items={}
 for _,item in menu do table.insert(items,tostring(item.name).." "..Format.money(num(item.price))) end
 local special=menu[(math.floor(num(day))%#menu)+1]
 local text=fill(V("menu",{"Today we have {items}. My pick today: the {special}.","On the board today: {items}. I'd go for the {special}."}),
  {items=table.concat(items,", "),special=tostring(special.name)})
 if typeof(special.seconds)=="number" and special.seconds&gt;0 then text..=" It keeps you quick on your feet for "..Dialogue.spoken(special.seconds).."." end
 return text
end

-- staffops: absences and apprentices -------------------------------------------------------------
local AWAY_TEXT: {[string]:string}={vacation="is on vacation today (back on day {back})",sick="is sick today",trip="is away on a client trip",leave="is on unpaid leave until our cash recovers"}
local function awayPhrase(a: any): string
 return a.name.." "..fill(AWAY_TEXT[a.state] or "is away today",{back=tostring(math.floor(num(a.back)))})
end
-- "Mia Weber is on vacation today (back on day 14), Jonas Klein is sick today and 3 more."
local function awayList(list: {any},max: number): string
 local parts={}
 for i=1,math.min(#list,max) do table.insert(parts,awayPhrase(list[i])) end
 local text
 if #parts&lt;=1 then text=parts[1] or ""
 elseif #list&lt;=max then text=table.concat(parts,", ",1,#parts-1).." and "..parts[#parts]
 else text=table.concat(parts,", ") end
 if #list&gt;max then text..=" and "..plural(#list-max,"more","more") end
 return text.."."
end
local function awayText(f: any): string
 local list=if typeof(f.away)=="table" then f.away else {}
 local n=#list
 if n==0 then return "Everybody is in today: nobody on vacation, nobody sick." end
 local text=plural(n,"person","people")..(if n==1 then " is" else " are").." away today: "..awayList(list,3)
 local c=f.awayCount or {}
 local bits={}
 if num(c.vacation)&gt;0 then table.insert(bits,Format.int(num(c.vacation)).." on vacation") end
 if num(c.sick)&gt;0 then table.insert(bits,Format.int(num(c.sick)).." sick") end
 if num(c.trip)&gt;0 then table.insert(bits,Format.int(num(c.trip)).." on client trips") end
 if num(c.leave)&gt;0 then table.insert(bits,Format.int(num(c.leave)).." on unpaid leave") end
 if n&gt;3 and #bits&gt;0 then text..=" In total "..table.concat(bits,", ").."." end
 return text.." HR plans it so that no team misses more than one in ten."
end
-- Teammates of the same role who are away today ("From my team, Mia Weber is sick today.").
local function teamAway(f: any,roleId: any,selfName: any): string
 local list={}
 for _,a in (if typeof(f.away)=="table" then f.away else {}) :: {any} do if a.role==roleId and a.name~=selfName then table.insert(list,a) end end
 if #list==0 then return "" end
 return " From my team, "..awayList(list,2)
end
local function apprenticeOf(subject: any,f: any): any
 local a=if typeof(f.apprentices)=="table" then f.apprentices[math.floor(num(subject.seed))] else nil
 return if typeof(a)=="table" then a else nil
end
local function apprenticesText(f: any): string
 local list={}
 for _,a in (if typeof(f.apprentices)=="table" then f.apprentices else {}) :: {[any]:any} do table.insert(list,a) end
 if #list==0 then return "We have no apprentices right now. Hire one in the Empire app and I'll show them around." end
 table.sort(list,function(a: any,b: any): boolean if a.graduates~=b.graduates then return a.graduates&lt;b.graduates end;return tostring(a.name)&lt;tostring(b.name) end)
 local parts={}
 for i=1,math.min(#list,3) do local a=list[i];table.insert(parts,first(tostring(a.name)).." (day "..Format.int(a.day).." of "..Format.int(Ops.APPRENTICE.graduateDays)..", skill "..Format.int(a.skill)..")") end
 local text="We have "..plural(#list,"apprentice")..": "..table.concat(parts,", ")..(if #list&gt;3 then " and more" else "").."."
 text..=" New apprentices get a tour on their first day, then training every morning at "..Dialogue.clock(Config.APPRENTICE.trainingHours[1])..". "
 text..=first(tostring(list[1].name)).." graduates on day "..Format.int(list[1].graduates).."."
 return text
end
local function tourRoomText(c: any,roomId: string): string
 local r: any=Plan.room(num(c.tier,1),roomId)
 if not r then return "I'm showing our apprentices around the building." end
 local d=if typeof(r.dept)=="string" then (Departments.DEPARTMENTS :: any)[r.dept] else nil
 local purpose=if d and DEPT_TEXT[r.dept] then DEPT_TEXT[r.dept] elseif ROOM_TEXT[r.kind] then fill(ROOM_TEXT[r.kind],{room=r.name}) else ""
 -- "This is the Café. The kitchen serves lunch ..." -&gt; keep what comes after the room's own name
 if string.sub(purpose,1,5)=="This " or string.sub(purpose,1,6)=="These " then purpose=string.match(purpose,"^[^%.:]*[%.:]%s*(.*)$") or "" end
 return "I'm showing our new apprentices around: this is the "..r.name.."."..(if purpose~="" then " "..purpose else "")
end

-- What the person is doing right now (Activity + Task attributes, room, live numbers) ---------------
local TASK_TEXT: {[string]:(any,any,Vary)-&gt;string}={
 RunExperiment=function(s,f,V)
  if typeof(f.research)=="table" then return fill(V("task",{"I'm running experiments for {r}{at}. It's {p} done.","Experiments for {r}{at}: we're at {p}."}),{r=f.research.name,at=roomPhrase(s),p=Format.percent(f.research.progress,0)}) end
  return "I'm running small experiments"..roomPhrase(s).." so we have ideas ready for the next research project." end,
 UseWhiteboard=function(s,_f,V) return V("task",{"I'm sketching architecture ideas on the whiteboard","Whiteboard session: I'm drawing up model ideas"})..roomPhrase(s).."." end,
 ArchitectureStudy=function(s,_f,V) return V("task",{"I'm studying architectures for our next model size","I'm comparing model sizes for our next run"})..roomPhrase(s).."." end,
 AnalyzeModel=function(s,f,_V) if f.best then return "I'm going through the evaluation of "..f.best.name..roomPhrase(s)..": "..string.format("%.1f",f.best.overall).." overall." end;return "I'm setting up benchmarks"..roomPhrase(s)..". There's no trained model to evaluate yet." end,
 ReviewModel=function(s,f,_V) if f.best then return "I'm reviewing "..f.best.name..roomPhrase(s)..": "..string.format("%.1f",f.best.overall).." overall." end;return "I'm preparing the review checklist"..roomPhrase(s)..". Nothing is trained yet." end,
 WriteCode=function(s,f,V)
  if typeof(f.training)=="table" then return fill(V("task",{"I'm writing training code{at}. The run on {m} is at {p}.","Coding{at}. Meanwhile the {m} run is at {p}."}),{at=roomPhrase(s),m=f.training.model,p=Format.percent(f.training.progress,0)}) end
  return V("task",{"I'm writing tooling for the next training run","I'm getting the code ready for our next training run"})..roomPhrase(s).."." end,
 MonitorTraining=function(s,f,_V) if typeof(f.training)=="table" then return "I'm watching the training run"..roomPhrase(s)..". "..trainingLine(f) end;return "I'm checking the training dashboards"..roomPhrase(s)..". Nothing is training right now." end,
 InspectServer=function(s,f,_V) return "I'm checking the servers"..roomPhrase(s)..". "..hardwareLine(f) end,
 InspectHardware=function(s,f,_V) return "I'm testing hardware"..roomPhrase(s)..". "..hardwareLine(f) end,
 CleanDataset=function(s,f,V) return V("task",{"I'm cleaning datasets","I'm filtering out junk from our datasets"})..roomPhrase(s)..". "..dataLine(f) end,
 CheckQuality=function(s,f,_V) return "I'm checking data quality"..roomPhrase(s)..". "..dataLine(f) end,
 MonitorPipeline=function(s,f,_V) return "I'm watching the data pipeline"..roomPhrase(s)..". "..dataLine(f) end,
 AnalyzeMarket=function(s,f,V) return V("task",{"I'm analysing the market","I'm going through the market numbers"})..roomPhrase(s)..". "..marketLine(f) end,
 PlanLaunch=function(s,f,_V) if count(f,"live")&gt;0 then return "I'm planning the next launch"..roomPhrase(s)..". "..modelsLine(f) end;return "I'm preparing our launch plan"..roomPhrase(s)..". "..modelsLine(f) end,
 CheckCustomers=function(s,f,_V) return "I'm checking on our customers"..roomPhrase(s)..". "..marketLine(f) end,
 -- lunch phases from the live staff record (StaffService.recordOf → lunch.phase) when TalkService has it
 Lunch=function(s,_f,V)
  local phase=s.lunch
  if phase=="toQueue" or phase=="queue" then return "I'm in the lunch queue at the servery." end
  if phase=="toSeat" then return "I've got my lunch, just looking for a seat." end
  if phase=="toReturn" or phase=="return" then return "Just bringing my tray back." end
  return V("task",{"I'm having lunch at the café.","Lunch break! I'm eating at the café."}) end,
 Coffee=function(_s,_f,V) return V("task",{"I'm on a short coffee break.","Just a quick coffee, then back to it."}) end,
 Snack=function(_s,_f,_V) return "Just grabbing a snack." end,
 FridgeDrink=function(_s,_f,_V) return "Just getting a cold drink from the fridge." end,
 RoofBreak=function(_s,_f,_V) return "I'm getting some fresh air on the roof." end,
 LoungeBreak=function(_s,_f,_V) return "I'm taking five in the lounge." end,
 TeamMeeting=function(s,_f,_V) return "I'm in the team meeting"..roomPhrase(s).."." end,
 ModelReviewMeeting=function(s,f,_V) return "We're in the model review"..roomPhrase(s)..". "..(if f.best then "We're looking at "..f.best.name.."." else "There's no trained model yet, so it's mostly planning.") end,
 DiscussWork=function(_s,_f,_V) return "I was just talking shop with a colleague." end,
 Leaving=function(_s,_f,_V) return "I'm heading home for the day." end,
 -- staffops
 FirstDay=function(_s,_f,V) return V("task",{"It's my first day! I'm picking up my badge at reception, then I'm off to my new desk.","First day here! Badge from reception first, then my new desk."}) end,
 RackRepair=function(s,f,_V)
  local n=count(f,"rackFaults")
  local text="I'm fixing a server rack"..roomPhrase(s).."."
  if n&gt;0 then
   text..=" "..plural(n,"rack fault").." open right now: each one takes a compute unit offline until it's fixed"
   text..=if num(f.stage,1)&lt;2 then " (about five minutes: there's no IT post in the garage yet)." else " (about a minute while IT is on duty, five minutes otherwise)."
  else text..=" It's fixed: I'm just logging the repair." end
  return text end,
 ApprenticeTour=function(_s,_f,V) return V("task",{"We're on the apprentice tour of the building.","Apprentice tour! We're seeing every department today."}) end,
 TrainingSession=function(s,_f,_V) return "I'm in today's apprentice training session"..roomPhrase(s).."." end,
 TrainingLead=function(s,f,_V) return "I'm teaching today's training session"..roomPhrase(s).." for our "..plural(count(f,"apprenticeCount"),"apprentice").."." end,
 Shadowing=function(s,_f,V) return V("task",{"I'm sitting with a senior colleague to learn how they work","I'm shadowing one of our seniors today"})..roomPhrase(s).."." end,
 Practice=function(s,_f,V) return V("task",{"I'm practising on a small task at my desk","Practice task"})..roomPhrase(s)..". My trainer checks it later." end,
 Coaching=function(_s,_f,_V) return "I'm checking in on one of our apprentices at their desk." end,
}
-- Ops jobs: what the post is about (used when Task is CampusOperations or a job step).
local POST_TEXT: {[string]:(any,any,any,Vary)-&gt;string}={
 reception=function(s,_f,c,V) return fill(V("post",{"I'm looking after the front desk{at}. {n} at the desk today so far.","Front desk duty{at}. {n} here today so far."}),{at=roomPhrase(s),n=plural(num(c.talksToday),"conversation")}) end,
 hotel=function(s,_f,c,_V) if typeof(c.hotel)=="table" and typeof(c.hotel.guests)=="number" then return "I'm at the hotel desk"..roomPhrase(s)..". "..plural(c.hotel.guests,"guest").." checked in tonight." end;return "I'm setting up the hotel desk"..roomPhrase(s)..". The hotel isn't taking guests yet." end,
 security=function(s,_f,c,V) return fill(V("post",{"I'm watching the entrances{at}. {n} in the building right now.","Keeping an eye on the gates{at}. {n} in the building right now."}),{at=roomPhrase(s),n=plural(num(c.visitorsNow),"visitor")}) end,
 facilities=function(s,_f,c,_V) local b=c.building;if typeof(b)=="table" then return "I'm on my facilities round"..roomPhrase(s)..": "..plural(num(b.rooms),"room").." and a lift with "..plural(num(b.stops),"stop").." to keep running." end;return "I'm on my facilities round"..roomPhrase(s).."." end,
 it=function(s,_f,c,V) if typeof(c.faults)=="table" and num(c.faults.count)&gt;0 then return "I'm working through IT tickets"..roomPhrase(s)..": "..plural(c.faults.count,"open fault").."." end;return V("post",{"I'm keeping the computers running","I'm on a desk check"})..roomPhrase(s).."." end,
 barista=function(s,_f,_c,V) return V("post",{"I'm making coffee","Coffee duty"})..roomPhrase(s)..V("post2",{".",". The machine barely gets a rest."}) end,
 chef=function(s,_f,c,V) local text=V("post",{"I'm cooking","I'm at the range"})..roomPhrase(s).."."
  if typeof(c.lunches)=="number" then text..=" "..plural(c.lunches,"lunch","lunches").." served today." end;return text end,
 kitchen=function(s,_f,_c,V) return V("post",{"I'm prepping food and keeping the kitchen clean","Chopping, washing up, handing out lunch: kitchen work"})..roomPhrase(s).."." end,
 host=function(s,_f,c,V) local text=V("post",{"I'm keeping the café tables ready","I'm wiping tables and seating people"})..roomPhrase(s)
  if typeof(c.dining)=="number" then return text..": "..plural(c.dining,"seat").." to look after." end;return text.."." end,
 fleet=function(s,_f,c,V) local text=V("post",{"I'm looking after the cars","Keys, chargers and tyres: I'm looking after the cars"})..roomPhrase(s).."."
  local cars=c.cars;if typeof(cars)=="table" and typeof(cars.owned)=="table" then text..=" We have "..plural(#cars.owned,"company car").."." end;return text end,
 housekeeping=function(s,_f,_c,V) return V("post",{"I'm getting rooms ready","Fresh towels and clean rooms: that's me"})..roomPhrase(s).."." end,
 cleaner=function(s,_f,c,V) local text=V("post",{"I'm cleaning","I'm on my cleaning round"})..roomPhrase(s).."."
  local b=c.building;if typeof(b)=="table" and num(b.restrooms)&gt;0 then text..=" "..plural(b.restrooms,"washroom").." on my list." end;return text end,
 mailroom=function(s,_f,_c,V) return V("post",{"I'm sorting parcels","I'm sorting today's post and parcels"})..roomPhrase(s).."." end,
 trainer=function(s,f,_c,_V) return "I'm planning the next training"..roomPhrase(s)..". "..plural(count(f,"apprenticeCount"),"apprentice").." in the programme right now." end,
 ops=function(s,_f,_c,_V) return "I'm at my post"..roomPhrase(s).."." end,
}
local productive: {[string]:boolean}={WORKING=true,RESEARCH=true,DATA_REVIEW=true,MARKETING=true,SERVER_CHECK=true,MONITOR_TRAINING=true,MODEL_REVIEW=true}
local STATE_TEXT: {[string]:string}={
 WORKING="I'm working",RESEARCH="I'm on research work",DATA_REVIEW="I'm reviewing data",MARKETING="I'm on marketing work",SERVER_CHECK="I'm checking hardware",
 MONITOR_TRAINING="I'm monitoring training",MODEL_REVIEW="I'm reviewing a model",MEETING="I'm in a meeting",TALKING="I'm chatting with a colleague",
 COFFEE_BREAK="I'm on a short break",LUNCH="I'm having lunch",WAIT_AT_DESK="I'm waiting for a free workstation",SELECT_TASK="I'm deciding what to do next",
 ARRIVING="I'm just arriving",LEAVING="I'm heading home",ELEVATOR="I'm waiting for the lift",
}
-- What an operations job step looks like right now (rig attribute Pose, StaffJobs / PropFx contract).
local POSE_TEXT: {[string]:string}={pour="Pulling a coffee right now.",stir="Stirring a pan right now.",plate="Plating up right now.",chop="Chopping vegetables right now.",
 wash="Doing the dishes right now.",wipe="Wiping down right now.",greet="Greeting people at the door right now.",scan="Out on my patrol right now.",
 inspect="Checking the equipment right now.",typeStand="Updating the system right now.",type="At the computer right now.",sort="Sorting parcels right now.",
 plug="Plugging in a car to charge right now.",phone="On the phone right now.",push="Pushing the cart around right now."}
local function taskText(subject: any,f: any,c: any,kind: string,V: Vary): string
 local task=subject.task
 local tourRoom=if typeof(task)=="string" then string.match(task,"^Tour:(.+)$") else nil
 if tourRoom then return tourRoomText(c,tourRoom) end
 local fn=if typeof(task)=="string" then TASK_TEXT[task] else nil
 if fn then return fn(subject,f,V) end
 if not HIRED[kind] and (task==nil or task=="CampusOperations" or subject.activity=="WORKING" or subject.activity==nil) then
  local pose=if typeof(subject.pose)=="string" then POSE_TEXT[subject.pose] else nil
  return (if pose then pose.." " else "")..(POST_TEXT[kind] or POST_TEXT.ops)(subject,f,c,V)
 end
 local state=STATE_TEXT[subject.activity or ""] or "I'm busy with my work"
 local text=state..roomPhrase(subject).."."
 if HIRED[kind] and productive[subject.activity or ""] then
  local extra=if kind=="researcher" then researchLine(f) elseif kind=="engineer" then trainingLine(f) elseif kind=="curator" then dataLine(f) else marketLine(f)
  text..=" "..extra
 end
 return text
end
-- Destination phrase while walking ("On my way to the café").
local WALK_TO: {[string]:string}={Lunch="lunch at the café",Coffee="grab a coffee",Snack="grab a snack",FridgeDrink="get a drink",RoofBreak="the roof for some air",
 LoungeBreak="the lounge",TeamMeeting="a team meeting",ModelReviewMeeting="the model review",DiscussWork="catch up with a colleague",Leaving="head home",
 FirstDay="my new desk",RackRepair="a server rack that needs fixing",ApprenticeTour="the next stop of the apprentice tour",TrainingSession="today's apprentice training",
 TrainingLead="the training room",Shadowing="sit with a senior colleague",Practice="my desk",Coaching="check on an apprentice"}
local function walking(subject: any): string?
 local a=subject.activity
 if a=="WALKING" then
  local to=if typeof(subject.task)=="string" then WALK_TO[subject.task] else nil
  return if to then "I'm on my way to "..to.."." else "I'm on my way to my next task."
 elseif a=="ELEVATOR" then return "I'm waiting for the lift."
 elseif a=="LEAVING" then return "I'm just heading home."
 elseif a=="ARRIVING" then
  if subject.task=="FirstDay" then return "It's my first day! I'm on my way to reception for my badge." end
  return "I'm just arriving."
 end
 return nil
end

-- Greeting ---------------------------------------------------------------------------------------
local GREET: {[string]:{[string]:{string}}}={
 owner={confident={"Hey {viewer}!","{hello}, {viewer}!","Oh, the boss! Hi {viewer}."},calm={"Hi {viewer}.","{hello}, {viewer}.","Hello {viewer}."},
  shy={"Oh — hi, {viewer}.","Um, hi {viewer}.","{hello}… hi {viewer}."}},
 visitor={confident={"Hi there, welcome to {company}!","{hello}! Welcome to {company}."},calm={"{hello}, welcome to {company}.","Hello, welcome to {company}."},
  shy={"Oh, hello — welcome to {company}.","Hi… welcome to {company}."}},
}
local STATUS_BREAK={COFFEE_BREAK="I'm just on a quick break.",LUNCH="I'm just having lunch.",MEETING="We're in a meeting, but go ahead.",TALKING="I was just chatting with a colleague."}
local ASK: {[string]:{string}}={
 owner={"What's up?","What can I do for you?","Need anything?"},
 reception={"How can I help you?","What can I do for you?"},hotel={"How can I help you?","Are you checking in?"},security={"Can I help you?","Everything all right?"},
 barista={"What can I get you?","Coffee?"},host={"Table for one?","Looking for a seat?"},chef={"Hungry?","Here for lunch?"},
}
local function greeting(subject: any,c: any,kind: string,tone: string,seed: number,day: number): string
 local viewer=c.viewer=="owner" and "owner" or "visitor"
 local vars={viewer=first(tostring(c.viewerName or "there")),hello=hello(num(c.hour,9)),company=tostring(c.company or (c.facts and c.facts.company) or "the company")}
 local text=fill(pick(GREET[viewer][tone],seed,day,"greet"),vars)
 if viewer=="visitor" then
  text..=" I'm "..first(subject.name)..". "..(JOB_PHRASE[kind] or JOB_PHRASE.ops).."."
 end
 local moving=walking(subject)
 if moving then text..=" "..moving
 elseif STATUS_BREAK[subject.activity or ""] then text..=" "..STATUS_BREAK[subject.activity]
 elseif viewer=="owner" and not HIRED[kind] then text..=" "..(JOB_PHRASE[kind] or JOB_PHRASE.ops)..roomPhrase(subject).."." end
 local asks=if viewer=="owner" then ASK.owner else (ASK[kind] or ASK.reception)
 return text.." "..pick(asks,seed,day,"ask")
end

-- Topics -----------------------------------------------------------------------------------------
local OPTION_TEXT: {[string]:string}={
 work="What are you working on?",day="How's your day going?",company="How is the company doing?",you="Tell me about yourself.",
 research="How's the research going?",training="How's training going?",data="How's our data looking?",market="How's the market?",
 where="Where is …?",visitors="Busy today?",about="What does this company do?",access="Where am I allowed to go?",cameras="Where's the camera room?",
 building="How's the building?",faults="Any IT problems?",hardware="How's our hardware?",menu="What's on the menu?",lunch="How's lunch service?",
 seat="Where can I sit?",cars="How are the company cars?",rooms="Do you have a room?",clean="How's the cleaning going?",
 team="What does your team do?",room="What's this room for?",tour="What's in this building?",
 away="Who's away today?",apprentices="How are the apprentices doing?",
}
local OWNER_TEXT: {[string]:string}={access="How's building security?",rooms="How's the hotel?"}
-- "room" is only offered while the person stands in a plan room with a purpose (Dialogue.explainsRoom).
local TOPICS: {[string]:{[string]:{string}}}={
 owner={researcher={"work","research","team","company","day","you","room"},engineer={"work","training","team","company","day","you","room"},
  curator={"work","data","team","company","day","you","room"},marketer={"work","market","team","company","day","you","room"},
  reception={"visitors","away","where","tour","work","day","room"},hotel={"rooms","where","work","day","room"},
  security={"access","cameras","visitors","day","room"},facilities={"building","work","tour","day","room"},it={"faults","hardware","work","day","room"},
  barista={"menu","lunch","work","day","room"},chef={"lunch","menu","work","day","room"},kitchen={"lunch","menu","work","day","room"},
  host={"lunch","menu","seat","day","room"},fleet={"cars","work","day","room"},housekeeping={"clean","rooms","day","room"},
  cleaner={"clean","work","day","room"},mailroom={"work","day","building","room"},trainer={"apprentices","work","away","day","room"},ops={"work","day","building","room"}},
 visitor={reception={"about","where","visitors","tour","room"},hotel={"rooms","where","about","tour"},security={"access","where","about","tour"},
  barista={"menu","seat","about","room"},host={"menu","seat","about","room"},chef={"menu","lunch","about","room"}},
}
local BYE: {[string]:{[string]:{string}}}={
 owner={confident={"Anytime, {viewer}! Back to it.","Always good to see you, {viewer}!"},calm={"Sure thing, {viewer}. Back to work.","Okay {viewer}, see you around."},
  shy={"Okay… thanks for stopping by, {viewer}.","Oh — okay. Bye, {viewer}."}},
 visitor={confident={"Enjoy your visit!","Have fun looking around!"},calm={"Have a good visit.","Enjoy your stay."},shy={"Okay, have a nice day.","Um, enjoy your visit."}},
}
-- Openers in front of an answer; each ends a sentence, so the answer may start with a name or a number.
local SOFT: {[string]:{string}}={confident={"Honestly? ","Good question! ",""},calm={"","Let me think. ",""},shy={"Um… ","Oh, okay. ",""}}
-- Opening of "How's your day going?" by tone (no claims, just mood).
local MOOD: {[string]:{string}}={confident={"Great, thanks! ","Busy, the way I like it. ","Pretty good! "},calm={"Fine, thanks. ","Good so far. ",""},shy={"Oh, fine… ","Okay, I think. ",""}}

local function scheduleText(subject: any,c: any,kind: string,tone: string,V: Vary): string
 local hour=num(c.hour,9)
 local now=V("mood",MOOD[tone] or MOOD.calm).."It's "..Dialogue.clock(hour).." now."
 if HIRED[kind] and typeof(subject.shiftStart)=="number" and typeof(subject.shiftEnd)=="number" then
  return now.." I'm on the night crew: "..Dialogue.clock(subject.shiftStart).." to "..Dialogue.clock(subject.shiftEnd)..", while the day team is at home."
 end
 if HIRED[kind] then
  local p=Config.personalityFromSeed(num(subject.seed))
  local text=fill(V("day",{"I start at {a} and leave at {b}. ","My hours are {a} to {b}. "}),{a=Dialogue.clock(p.start),b=Dialogue.clock(p.finish)})
  if hour&lt;p.lunch then text..="Lunch is usually around "..Dialogue.clock(p.lunch).."."
  elseif hour&lt;p.lunch+1.1 then text..="It's my lunch window right now ("..Dialogue.clock(p.lunch).." onwards)."
  else text..="I had lunch around "..Dialogue.clock(p.lunch).."." end
  if apprenticeOf(subject,c.facts or {}) then text..=" Apprentice training is every morning at "..Dialogue.clock(Config.APPRENTICE.trainingHours[1]).."." end
  return now.." "..text
 end
 if typeof(subject.shiftStart)=="number" and typeof(subject.shiftEnd)=="number" then
  return now.." My shift today runs from "..Dialogue.clock(subject.shiftStart).." to "..Dialogue.clock(subject.shiftEnd).."."
 end
 -- operations staff have no personal hours (StaffService keeps role "support" on duty around the clock)
 local post=string.lower(tostring(subject.job or "campus"))
 return now.." "..fill(V("day",{"I'm at the {post} post today.","The campus team covers the building around the clock, so you'll find me at the {post} post."}),{post=post})
end
local function aboutText(subject: any,c: any,V: Vary): string
 local roleName=ROLE_NAME[subject.roleId] or "specialist"
 local appr=apprenticeOf(subject,c.facts or {})
 if appr then
  -- the real apprentice wage (CompanyOps.APPRENTICE.wage of the profile wage) and the ramping skill
  local wage=if typeof(subject.wage)=="number" and subject.wage&gt;0 then subject.wage*Ops.APPRENTICE.wage else nil
  local text="I'm "..subject.name..", an apprentice "..roleName..": day "..Format.int(appr.day).." of my "..Format.int(Ops.APPRENTICE.graduateDays).." training days."
  text..=" My skill is "..Format.int(appr.skill).." out of 5 and goes up every "..Format.int(Ops.APPRENTICE.rampDays).." days."
  if wage then text..=" You pay me "..string.format("$%.2f",wage).." a second while I'm in training." end
  return text.." I graduate on day "..Format.int(appr.graduates).."."
 end
 local skill=if typeof(subject.skill)=="number" then tostring(math.floor(subject.skill+.5)) else nil
 local wage=if typeof(subject.wage)=="number" and subject.wage&gt;0 then subject.wage else nil
 if V("you",{"a","b"})=="b" then
  local text=first(subject.name).." here, your "..roleName.."."
  if skill then text..=" My skill rating is "..skill.." out of 5." end
  if wage then text..=" My wage is "..string.format("$%.2f",wage).." a second ("..Format.money(wage*Dialogue.DAY_SECONDS).." per company day)." end
  return text
 end
 local text="I'm "..subject.name..", one of your "..roleName.."s."
 if skill then text..=" On the team list I'm rated "..skill.." out of 5." end
 if wage then text..=" You pay me "..string.format("$%.2f",wage).." a second — about "..Format.money(wage*Dialogue.DAY_SECONDS).." per company day." end
 return text
end
-- "What does your team do?": home desk room + department, what the role is for, the role's real effect.
local TEAM_TEXT: {[string]:string}={
 researcher="Researchers earn the research points that unlock our research projects.",
 engineer="Engineers turn data and GPUs into trained models.",
 curator="Curators collect and clean the data every model is trained on.",
 marketer="Growth managers bring our live models to users and customers.",
}
local function teamText(subject: any,c: any,kind: string,V: Vary): string
 local f=c.facts or {}
 local desk=subject.desk
 local text=""
 if typeof(desk)=="table" and typeof(desk.room)=="string" then
  local d=if typeof(desk.dept)=="string" then (Departments.DEPARTMENTS :: any)[desk.dept] else nil
  local part=if d and not string.find(desk.room,d.name,1,true) then ", part of "..d.name else ""
  text="My desk is in the "..desk.room..(if typeof(desk.level)=="string" then " ("..desk.level..")" else "")..part.."."
  text..=deskLine(desk.desks,desk.busy,"in there")
  text..=" "
 end
 text..=TEAM_TEXT[kind] or "We keep the company running."
 local role=EmpireConfig.find(EmpireConfig.ROLES,subject.roleId)
 local n=num(f.roles and f.roles[subject.roleId])
 local word=ROLE_NAME[kind] or "specialist"
 if n==1 then text..=" I'm our only "..word.." so far."
 elseif n&gt;1 then text..=" "..fill(V("team",{"We're {n} on the team.","The team has {n} right now."}),{n=plural(n,word)}) end
 if role and typeof(role.desc)=="string" then
  -- EmpireConfig.ROLES desc, e.g. "+0.6 research points/s per employee." → "Each of us adds +0.6 research points/s."
  local gain,rest=string.match(role.desc,"^(.-) per employee%.%s*(.*)$")
  if gain and gain~="" then
   text..=" Each of us adds "..gain
   if rest and rest~="" then text..=" ("..lowerFirst((string.gsub(rest,"%.$","")))..")" end
   text..="."
  else text..=" "..role.desc end
 end
 if kind=="researcher" and typeof(f.nextResearch)=="table" and typeof(f.research)~="table" then text..=" Next up: "..f.nextResearch.name.."." end
 if HIRED[kind] then text..=teamAway(f,subject.roleId,subject.name) end
 return text
end
local function companyText(f: any,V: Vary): string
 local cash=Format.money(count(f,"cash"))
 return fill(V("company",{"We have {cash} in the bank. {trend} {models}","{trend} {models} Cash in the bank: {cash}.","{models} {trend} We have {cash} in the bank."}),
  {cash=cash,trend=profitTrend(f),models=modelsLine(f)})
end
local function visitorsText(c: any,owner: boolean): string
 local now=num(c.visitorsNow);local today=num(c.visitorsToday)
 if owner then
  local f=c.facts or {}
  return plural(now,"visitor").." in the building right now, "..plural(today,"visitor").." so far today. "
   ..plural(count(f,"applicantsWaiting"),"candidate").." waiting in the visitor lounge and "..plural(count(f,"applicantsOpen"),"new application").." open."
 end
 return "You're one of "..plural(math.max(1,today),"visitor").." today — "..plural(math.max(1,now),"guest").." in the building right now. Make yourself at home in the public areas."
end
local function accessText(c: any,owner: boolean): string
 local b=c.building
 local public=if typeof(b)=="table" and typeof(b.publicRooms)=="table" and #b.publicRooms&gt;0 then roomList(b.publicRooms) else "the reception hall"
 if owner then
  local text="Visitors may use "..public..". Everything past the speed gates needs a card."
  if typeof(c.passes)=="number" then text..=" "..plural(c.passes,"guest card").." active right now." end
  return text
 end
 return "Visitors are welcome in "..public..". Past the speed gates you need a guest card from "..tostring(c.ownerName or "the founder").."."
end
local function camerasText(c: any): string
 local b=c.building;local places=c.places
 local where="Campus Security, on level 1 of the pavilion"
 if typeof(places)=="table" then for _,p in places do if p.id=="P1_SECURITY" then where=p.name..", "..levelPhrase(num(c.tier,1),p.level)..(if p.level==1 then " of the pavilion" else "") end end end
 local text="The camera room is "..where..". Founder access only."
 if typeof(b)=="table" and typeof(b.cameras)=="number" then text..=" "..plural(b.cameras,"room").." are on camera." end
 return text
end
local function faultsText(c: any): string
 local racks=num(c.facts and c.facts.rackFaults)
 local rackLine=if racks&gt;0 then " And "..plural(racks,"server rack").." down: each one costs a compute unit until it's fixed, about a minute while IT is on duty." else ""
 local fl=c.faults
 if rackLine~="" and (typeof(fl)~="table" or num(fl.count)&lt;=0) then return "No desk faults, but "..plural(racks,"server rack").." down: each one costs a compute unit until it's fixed, about a minute while IT is on duty." end
 if typeof(fl)~="table" then return "No ticket system is wired up here yet, so I check the desks on my rounds. Nothing has been reported to me." end
 if num(fl.count)&lt;=0 then return "No open faults right now. Every screen I look after is working." end
 local text=plural(fl.count,"open fault").." right now"
 if typeof(fl.rooms)=="table" and #fl.rooms&gt;0 then text..=": "..table.concat(fl.rooms,", ",1,math.min(#fl.rooms,3)) end
 return text..". I'm on it."..rackLine
end
local function buildingText(c: any): string
 local b=c.building
 if typeof(b)~="table" then return "Everything is running." end
 local tier=num(c.tier,1)
 local text="This building has "..plural(num(b.floors),"floor").." from G up to "..Plan.levelLabel(tier,Plan.founderLevel(tier))..", plus B1 and the roof: "
  ..plural(num(b.rooms),"room").." and a lift with "..plural(num(b.stops),"stop").."."
 if typeof(c.desks)=="number" and c.desks&gt;0 then
  text..=" "..plural(c.desks,"computer desk")
  if typeof(c.desksBusy)=="number" then text..=", "..Format.int(math.min(c.desksBusy,c.desks)).." in use right now" end
  text..="."
 end
 return text.." Everything is running."
end
-- Earliest / latest lunch start of any personality (EmployeeConfig.personalityFromSeed), computed once.
local lunchRange: {number}?=nil
function Dialogue.lunchWindow(): (number,number)
 if not lunchRange then
  local lo,hi=math.huge,-math.huge
  for seed=0,1999 do local l=Config.personalityFromSeed(seed).lunch;lo=math.min(lo,l);hi=math.max(hi,l) end
  lunchRange={lo,hi}
 end
 local r=lunchRange :: {number}
 return r[1],r[2]
end
local function lunchText(c: any): string
 local text=if typeof(c.lunches)=="number" then plural(c.lunches,"lunch","lunches").." served today. " else ""
 local service=(Config :: any).LUNCH_SERVICE
 if typeof(service)=="table" and typeof(service[1])=="number" and typeof(service[2])=="number" then
  text..="The kitchen serves lunch from "..Dialogue.clock(service[1]).." to "..Dialogue.clock(service[2])..". "
 end
 local lo,hi=Dialogue.lunchWindow()
 text..="The team goes to lunch between "..Dialogue.clock(lo).." and "..Dialogue.clock(hi).."."
 if typeof(c.dining)=="number" then text..=" We have "..plural(c.dining,"seat").." in the café." end
 return text
end
local function carsText(c: any): string
 local cars=c.cars
 if typeof(cars)~="table" or typeof(cars.owned)~="table" or #cars.owned==0 then return "There's no company car in the garage yet." end
 local text="We have "..plural(#cars.owned,"company car")..": "..table.concat(cars.owned,", ").."."
 if typeof(cars.ready)=="string" then text..=" The "..cars.ready.." is the one set up for you, down on B1." end
 return text
end
local function hotelText(c: any,owner: boolean): string
 local h=c.hotel
 if typeof(h)=="table" and typeof(h.guests)=="number" then
  local text=plural(h.guests,"guest").." checked in tonight"
  if typeof(h.rooms)=="number" then text..=", "..plural(math.max(0,h.rooms-h.guests),"room").." free" end
  return text.."."
 end
 if owner then return "The hotel isn't taking guests yet. Once it opens I'll check in our travelling staff and visitors here." end
 return "Sorry, we aren't taking guests yet."
end
local function cleanText(c: any,kind: string): string
 local b=c.building
 if kind=="housekeeping" then
  local h=c.hotel
  if typeof(h)=="table" and typeof(h.guests)=="number" then return plural(h.guests,"guest room").." to turn around tomorrow morning, plus fresh towels for everyone." end
  if typeof(b)=="table" and num(b.restrooms)&gt;0 then return "No hotel guests yet, so I help keep the main building tidy: "..plural(b.restrooms,"washroom").." on today's list." end
  return "No hotel guests yet, so I help keep the main building tidy."
 end
 if typeof(b)=="table" and num(b.restrooms)&gt;0 then return "Good! "..plural(b.restrooms,"washroom").." and the corridors are on my list today." end
 return "Good! The corridors are on my list today."
end
local function aboutCompany(c: any): string
 local f=c.facts or {}
 local text=tostring(c.company or f.company).." builds AI models"
 if typeof(c.ownerName)=="string" then text..=", founded by "..c.ownerName end
 text..=". "..staffLine(f)
 if count(f,"live")&gt;0 then text..=" "..plural(count(f,"live"),"model").." live right now." end
 return text
end
local function seatText(c: any): string
 local text="Take any free table in the café"
 if typeof(c.dining)=="number" then text..=" — we have "..plural(c.dining,"seat") end
 return text..". The visitor lounge next to reception has sofas too."
end
local function answerFor(id: string,subject: any,c: any,kind: string,tone: string,seed: number,day: number,V: Vary): Answer
 local f=c.facts or {}
 local owner=c.viewer=="owner"
 local soft=pick(SOFT[tone],seed,day,"soft"..id)
 if id=="work" then return {text=taskText(subject,f,c,kind,V)}
 elseif id=="day" then return {text=scheduleText(subject,c,kind,tone,V)}
 elseif id=="company" then return {text=soft..companyText(f,V)}
 elseif id=="you" then return {text=aboutText(subject,c,V)}
 elseif id=="research" then return {text=soft..researchMore(f)}
 elseif id=="training" then return {text=soft..trainingLine(f).." "..hardwareLine(f)}
 elseif id=="data" then return {text=soft..dataLine(f).." "..plural(num(f.roles and f.roles.curator),"curator").." on the team."}
 elseif id=="market" then return {text=soft..marketLine(f)}
 elseif id=="team" then return {text=teamText(subject,c,kind,V)}
 elseif id=="room" then return {text=roomText(subject,c)}
 elseif id=="tour" then return {text=tourText(c,owner,V)}
 elseif id=="visitors" then return {text=visitorsText(c,owner)}
 elseif id=="about" then return {text=aboutCompany(c)}
 elseif id=="access" then return {text=accessText(c,owner)}
 elseif id=="cameras" then return {text=camerasText(c)}
 elseif id=="building" then return {text=buildingText(c)}
 elseif id=="faults" then return {text=faultsText(c)}
 elseif id=="hardware" then return {text=(if typeof(c.desks)=="number" then plural(c.desks,"computer desk").." in the building. " else "")..hardwareLine(f)}
 elseif id=="menu" then return {text=menuLine(c.menu,seed,day,V)}
 elseif id=="lunch" then return {text=lunchText(c)}
 elseif id=="seat" then return {text=seatText(c)}
 elseif id=="cars" then return {text=carsText(c)}
 elseif id=="rooms" then return {text=hotelText(c,owner)}
 elseif id=="clean" then return {text=cleanText(c,kind)}
 elseif id=="away" then return {text=soft..awayText(f)}
 elseif id=="apprentices" then return {text=apprenticesText(f)}
 end
 return {text="Hm, I'm not sure."}
end

-- Lines --------------------------------------------------------------------------------------------
local PAGE=3
function Dialogue.lines(subject: any,c: any): Lines
 local kind=Dialogue.kind(subject.roleId,subject.job)
 local viewer=if c.viewer=="owner" then "owner" else "visitor"
 local seed=num(subject.seed);local day=num(c.day)
 local tone=Dialogue.tone(seed)
 local V: Vary=function(key: string,list: {string}): string return pick(list,seed,day,key) end
 local ids=(TOPICS[viewer][kind] or (if viewer=="owner" then TOPICS.owner.ops else TOPICS.visitor.reception))
 local topics: {Option}={};local answers: {[string]:Answer}={}
 for _,id in ids do
  if id=="room" and not Dialogue.explainsRoom(subject) then continue end
  local option: Option={id=id :: string,text=(if viewer=="owner" then OWNER_TEXT[id] else nil) or OPTION_TEXT[id]}
  table.insert(topics,option)
  if id=="where" then
   -- Pages of chips: up to PAGE places fit on the last page; earlier pages show PAGE-1 places and a
   -- "Somewhere else…" chip that opens the next page (chips stay &lt;= MAX_OPTIONS incl. goodbye).
   local places: {Place}=if typeof(c.places)=="table" then c.places else {}
   for _,p in places do answers["where:"..p.id]={text=p.text} end
   if #places==0 then answers.where={text="I'm new to this floor plan myself, sorry."}
   else
    local pages: {{Option}}={}
    local at=1
    while at&lt;=#places do
     local left=#places-at+1
     local take=if left&lt;=PAGE then left else PAGE-1
     local page: {Option}={}
     for k=at,at+take-1 do table.insert(page,{id="where:"..places[k].id,text=places[k].name}) end
     at+=take
     table.insert(pages,page)
    end
    for k=1,#pages-1 do
     local id=if k==1 then "where:more" else "where:more"..tostring(k)
     table.insert(pages[k],{id=id,text="Somewhere else…"})
     answers[id]={text=if k==1 then "Other places people ask me about:" else "And these:",follow=pages[k+1]}
    end
    answers.where={text=pick({"Sure — where do you want to go?","Happy to help. Which place?","Of course. Where to?"},seed,day,"where"),follow=pages[1]}
   end
  else
   answers[id]=answerFor(id,subject,c,kind,tone,seed,day,V)
  end
 end
 local farewell=fill(V("bye",BYE[viewer][tone]),{viewer=first(tostring(c.viewerName or "there"))})
 answers.bye={text=farewell,close=true}
 local lines: Lines={kind=kind,tone=tone,viewer=viewer,greeting=greeting(subject,c,kind,tone,seed,day),topics=topics,options={},answers=answers,farewell=farewell}
 lines.options=Dialogue.options(lines,{},nil)
 return lines
end
-- Next chips: follow-ups first, then topics not asked yet, always ending with the goodbye chip.
function Dialogue.options(lines: Lines,asked: {[string]:boolean},follow: {Option}?): {Option}
 local out: {Option}={}
 local limit=Dialogue.MAX_OPTIONS-1
 if follow and #follow&gt;0 then
  for _,o in follow do if #out&lt;limit then table.insert(out,o) end end
 else
  for _,o in lines.topics do if #out&lt;limit and not asked[o.id] then table.insert(out,o) end end
 end
 table.insert(out,{id="bye",text=if lines.viewer=="owner" then "Thanks, carry on." else "Thanks, bye!"})
 return out
end
-- Answers option `id` (must be one of the offered ids; TalkService checks). Marks the topic as asked
-- (a place marks "where") and returns the answer plus the next options (empty after "bye").
function Dialogue.step(lines: Lines,asked: {[string]:boolean},id: string): (Answer?,{Option})
 local answer=lines.answers[id]
 if not answer then return nil,{} end
 if answer.close then return answer,{} end
 local topic=string.match(id,"^([^:]+)") or id
 asked[topic]=true
 return answer,Dialogue.options(lines,asked,answer.follow)
end
return Dialogue
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000010"><Properties><string name="Name">FlightPlan</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- FlightPlan: the shared, deterministic timetable and flight paths of the Port Meridian shuttle, the VIP
-- helicopter and the ambient air traffic (package "flight"). Pure data and maths - nothing here creates
-- instances. The server (ShuttleService) and every client (ShuttleController, AirTrafficController) compute
-- exactly the same aircraft position from workspace:GetServerTimeNow(), so the server never sends positions.
--   * Timetable: ONE aircraft flies both legs. A cycle of FP.interval() seconds = leg "out" (City Airport -&gt;
--     Port Meridian: home boarding + the flight) followed by leg "back" (Port Meridian boarding + the flight
--     home); each direction departs once per cycle. cycle k starts at epoch + k*interval, the back leg
--     FP.leg("out").duration later. Port Meridian boarding is CONFIG.pmBoarding; home boarding gets the rest
--     of the interval (at least CONFIG.minBoarding; if the moving phases do not fit, the interval grows).
--   * Phases of a leg (same names both ways): boarding, doors, pushback, taxi, takeoff, climb, cruise,
--     approach, landing, taxiin, deboarding. At Port Meridian the aircraft parks lined up on the runway, so
--     its "pushback" is the engine start and "taxi" the line-up (short holds).
--   * Paths along the real CityPlan geometry: home stand A&lt;shuttleStand&gt; -&gt; pushback onto the taxilane -&gt;
--     taxilane, west exit, taxiway, west connector -&gt; runway, take-off roll east, climb-out, right turn over
--     the sea, cruise south-west, left turn onto a 4-degree final east into Port Meridian's runway, flare,
--     roll-out, teardrop U-turn, stand facing west (left doors towards the terminal). Port Meridian's whole
--     ground track (final, roll-out, stand, take-off roll) runs on FP.PM_LINE, 11 studs off the runway
--     centreline away from the terminal and the towers that line the runway, so the wingtips keep clear of
--     them; the climb-out stays on that line until it is past the towers. The way back: rolling take-off west,
--     right turn north, cruise, left turn onto a westbound final into City Airport, roll-out, west connector,
--     taxiway, taxilane, nose-in to the stand. tests/flight/clearance.py sweeps the real hull along every
--     low pose against the built world.
--   * Ground tracks are polylines with filleted corners, air tracks centripetal Catmull-Rom splines sampled
--     every ~12 studs; speeds follow accelerate/cruise/decelerate profiles in time. Pose = position on the
--     track, heading from the smoothed tangent (reversed for the pushback), pitch from the climb angle plus an
--     angle-of-attack schedule (rotation, climb, flare, de-rotation), bank from the turn rate.
local CityPlan=require(script.Parent.Config.CityPlan)
local FP={}

FP.CONFIG={
	interval=360, -- seconds between two departures in the same direction (tuned by CORE_SPEC: one aircraft, ~6 real
	-- minutes for the round trip; long waits are bridged by the instant charter flight at the counter)
	epoch=0, -- timetable origin (server time, seconds)
	minBoarding=75, -- home boarding at least this long (gate A&lt;shuttleStand&gt;; the rest of the interval goes here too)
	pmBoarding=37, -- Port Meridian boarding (the crew stays aboard for the quick turnaround)
	doors=5,deboarding=10, -- seconds
	startup=6,lineup=4, -- Port Meridian: engine start and line-up holds
	kind="320",scale=1.8, -- the shuttle: AircraftModel kind and scale (the same as the parked stand aircraft)
	pushSpeed=24,pushAcc=5,taxiSpeed=62,taxiAcc=9, -- studs/s, studs/s^2
	liftoff=140,liftoffPM=130,climbSpeed=250,cruiseSpeed=380,approachSpeed=140,touchdown=125,rollout=55,
	gEff=60,maxBank=math.rad(28), -- bank = atan(v^2 * curvature / gEff), clamped
	flights={out="PM 101",back="PM 102"}, -- the numbers on the airport package's gate A1 sign and Port Meridian's board
	airline="Meridian Air",
	charterAfter=180, -- seconds: the check-in counter also offers the instant charter flight when boarding is further away
	heliSpeed=70,heliCruise=60, -- VIP helicopter: studs/s, cruise height above the higher pad
}
FP.PHASES={"boarding","doors","pushback","taxi","takeoff","climb","cruise","approach","landing","taxiin","deboarding"}
FP.PHASE_TEXT={boarding="Boarding",doors="Doors closed",pushback="Pushback",taxi="Taxiing",takeoff="Take-off",climb="Climbing",
	cruise="Cruising",approach="Approach",landing="Landing",taxiin="Taxiing to the gate",deboarding="Arrived"}

export type Track={pts: {Vector3},cum: {number},length: number,marks: {number}}
export type Profile={T: number,L: number,v0: number,vc: number,v1: number,a: number,t1: number,t2: number}
export type Segment={phase: string,mode: string,t0: number,t1: number,track: Track,s0: number,s1: number,prof: Profile,reverse: boolean,hold: CFrame?,aoa0: number,aoa1: number}
export type Leg={dir: string,from: string,to: string,flight: string,segments: {Segment},duration: number,boarding: number,
	phases: {[string]: {t0: number,t1: number}},stand: CFrame,arrivalStand: CFrame}
export type Pose={cf: CFrame,phase: string,speed: number,onGround: boolean,gearDown: boolean,engines: boolean,altitude: number}

local A=CityPlan.AIRPORT
local B=CityPlan.ABROAD
local G=CityPlan.GROUND
local HY=A.apronTop -- home apron / runway top (wheels)
local PY=CityPlan.ROAD_TOP -- Port Meridian runway top
local rad=math.rad
local function v(x: number,y: number,z: number): Vector3 return Vector3.new(x,y,z) end

------------------------------------------------------------------------------------------------ profiles
-- Accelerate v0 -&gt; vc, cruise, decelerate vc -&gt; v1 with |acceleration| a over the distance L. vc is lowered
-- when L is too short; if even the end speed cannot be reached the acceleration is adjusted to fit exactly.
local function profile(L: number,v0: number,vc: number,v1: number,a: number): Profile
	L=math.max(L,1e-3);a=math.max(a,1e-3)
	vc=math.max(vc,v0,v1)
	local d1=(vc*vc-v0*v0)/(2*a);local d3=(vc*vc-v1*v1)/(2*a)
	if d1+d3&gt;L then
		local lowest=math.max(v0,v1)
		local vcFit=math.sqrt(math.max(0,(2*a*L+v0*v0+v1*v1)/2))
		if vcFit&gt;=lowest then vc=vcFit
		else vc=lowest;a=math.max(1e-3,math.abs(v0*v0-v1*v1)/(2*L)) end
		d1=(vc*vc-v0*v0)/(2*a);d3=(vc*vc-v1*v1)/(2*a)
	end
	local t1=(vc-v0)/a;local t3=(vc-v1)/a
	local tc=math.max(0,L-d1-d3)/math.max(vc,1e-3)
	return {T=t1+tc+t3,L=L,v0=v0,vc=vc,v1=v1,a=a,t1=t1,t2=t1+tc}
end
FP.profile=profile
-- Distance and speed after tau seconds.
local function along(p: Profile,tau: number): (number,number)
	if tau&lt;=0 then return 0,p.v0 end
	if tau&gt;=p.T then return p.L,p.v1 end
	if tau&lt;p.t1 then return p.v0*tau+0.5*p.a*tau*tau,p.v0+p.a*tau end
	local d1=p.v0*p.t1+0.5*p.a*p.t1*p.t1
	if tau&lt;p.t2 then return d1+p.vc*(tau-p.t1),p.vc end
	local u=tau-p.t2
	return math.min(p.L,d1+p.vc*(p.t2-p.t1)+p.vc*u-0.5*p.a*u*u),math.max(0,p.vc-p.a*u)
end
FP.along=along

------------------------------------------------------------------------------------------------ tracks
local function makeTrack(pts: {Vector3},marks: {number}?): Track
	local clean: {Vector3}={pts[1]}
	for i=2,#pts do if (pts[i]-clean[#clean]).Magnitude&gt;1e-3 then table.insert(clean,pts[i]) end end
	if #clean==1 then table.insert(clean,clean[1]+Vector3.new(0,0,-1e-3)) end
	local cum: {number}={0}
	for i=2,#clean do cum[i]=cum[i-1]+(clean[i]-clean[i-1]).Magnitude end
	return {pts=clean,cum=cum,length=cum[#cum],marks=marks or {}}
end
FP.makeTrack=makeTrack
function FP.trackPos(tr: Track,s: number): Vector3
	local cum=tr.cum
	if s&lt;=0 then return tr.pts[1] end
	if s&gt;=tr.length then return tr.pts[#tr.pts] end
	local lo,hi=1,#cum
	while hi-lo&gt;1 do
		local mid=(lo+hi)//2
		if cum[mid]&lt;=s then lo=mid else hi=mid end
	end
	local seg=cum[hi]-cum[lo]
	local u=if seg&gt;0 then (s-cum[lo])/seg else 0
	return tr.pts[lo]:Lerp(tr.pts[hi],u)
end
local trackPos=FP.trackPos
-- Smoothed unit tangent at s (central difference over +-d studs).
function FP.tangent(tr: Track,s: number,d: number?): Vector3
	local h=d or 10
	local a=trackPos(tr,math.max(0,s-h));local b=trackPos(tr,math.min(tr.length,s+h))
	local t=b-a
	if t.Magnitude&lt;1e-5 then
		local n=#tr.pts
		t=tr.pts[n]-tr.pts[math.max(1,n-1)]
		if t.Magnitude&lt;1e-5 then return Vector3.new(0,0,-1) end
	end
	return t.Unit
end
-- Ground polyline with filleted corners (radius r, reduced where segments are short). y of every point kept.
function FP.groundTrack(way: {Vector3},r: number): Track
	local pts: {Vector3}={way[1]}
	local n=#way
	for i=2,n-1 do
		local a,b,c=way[i-1],way[i],way[i+1]
		local d1=Vector3.new(a.X-b.X,0,a.Z-b.Z);local d2=Vector3.new(c.X-b.X,0,c.Z-b.Z)
		local l1,l2=d1.Magnitude,d2.Magnitude
		if l1&lt;1e-3 or l2&lt;1e-3 then table.insert(pts,b);continue end
		d1/=l1;d2/=l2
		local alpha=math.acos(math.clamp(d1:Dot(d2),-1,1)) -- interior angle
		if alpha&gt;math.pi-0.02 then table.insert(pts,b);continue end
		local tmax=math.min(if i==2 then l1 else l1/2,if i==n-1 then l2 else l2/2)
		local t=r/math.tan(alpha/2);local radius=r
		if t&gt;tmax then t=tmax;radius=t*math.tan(alpha/2) end
		local p1=b+d1*t;local p2=b+d2*t
		local centre=b+(d1+d2).Unit*(radius/math.sin(alpha/2))
		local a1=math.atan2(p1.Z-centre.Z,p1.X-centre.X);local a2=math.atan2(p2.Z-centre.Z,p2.X-centre.X)
		local da=a2-a1
		while da&gt;math.pi do da-=2*math.pi end
		while da&lt;-math.pi do da+=2*math.pi end
		local steps=math.max(2,math.ceil(math.abs(da)/rad(6)))
		for k=0,steps do
			local ang=a1+da*k/steps
			table.insert(pts,Vector3.new(centre.X+math.cos(ang)*radius,b.Y,centre.Z+math.sin(ang)*radius))
		end
	end
	table.insert(pts,way[n])
	return makeTrack(pts)
end
-- Centripetal Catmull-Rom through `ctrl` (first/last tangents along dirStart/dirEnd), sampled every ~12
-- studs. marks[i] = arc length at control point i (phase boundaries are taken from these).
local function cr(p0: Vector3,p1: Vector3,p2: Vector3,p3: Vector3,u: number): Vector3
	local function knot(t: number,a: Vector3,b: Vector3): number return t+math.max((b-a).Magnitude,1e-3)^0.5 end
	local t0=0;local t1=knot(t0,p0,p1);local t2=knot(t1,p1,p2);local t3=knot(t2,p2,p3)
	local t=t1+(t2-t1)*u
	local a1=p0*((t1-t)/(t1-t0))+p1*((t-t0)/(t1-t0))
	local a2=p1*((t2-t)/(t2-t1))+p2*((t-t1)/(t2-t1))
	local a3=p2*((t3-t)/(t3-t2))+p3*((t-t2)/(t3-t2))
	local b1=a1*((t2-t)/(t2-t0))+a2*((t-t0)/(t2-t0))
	local b2=a2*((t3-t)/(t3-t1))+a3*((t-t1)/(t3-t1))
	return b1*((t2-t)/(t2-t1))+b2*((t-t1)/(t2-t1))
end
-- adjust (optional) maps every sample before the arc lengths are measured (e.g. a corridor clamp).
function FP.airTrack(ctrl: {Vector3},dirStart: Vector3,dirEnd: Vector3,adjust: ((Vector3)-&gt;Vector3)?): Track
	local n=#ctrl
	local ext: {Vector3}={ctrl[1]-dirStart.Unit*120}
	for _,p in ctrl do table.insert(ext,p) end
	table.insert(ext,ctrl[n]+dirEnd.Unit*120)
	local pts: {Vector3}={ctrl[1]}
	local markIdx: {number}={1}
	for i=1,n-1 do
		local p0,p1,p2,p3=ext[i],ext[i+1],ext[i+2],ext[i+3]
		local steps=math.max(2,math.ceil((p2-p1).Magnitude/12))
		for k=1,steps do table.insert(pts,cr(p0,p1,p2,p3,k/steps)) end
		markIdx[i+1]=#pts
	end
	if adjust then for i,p in pts do pts[i]=adjust(p) end end
	local tr=makeTrack(pts)
	-- no duplicate removal happened for spline samples (each step &gt; 0), so indices are valid
	for i,idx in markIdx do tr.marks[i]=tr.cum[math.min(idx,#tr.cum)] end
	return tr
end

------------------------------------------------------------------------------------------------ geometry
local stand=A.standCFrames[A.shuttleStand] or A.standCFrames[1] -- nose north (towards the terminal)
local SX,SZ=stand.X,stand.Z
local TL=A.taxilane
local TZ=(A.taxiway.z1+A.taxiway.z2)/2
local RZ=(A.runway.z1+A.runway.z2)/2
local WEST=A.connectors[1]
local EXIT=A.exits[1]
local PRZ=(B.runway.z1+B.runway.z2)/2
-- Port Meridian's runway is 70 studs wide and lined on the terminal side by the arrival hall and towers whose
-- faces stand ~57 studs from the centreline, less than the shuttle's half span (56.6 + winglet). The whole PM
-- ground track therefore runs 11 studs north of the centreline (main gear still well inside the runway).
FP.PM_LINE=PRZ-11
local PZ=FP.PM_LINE
FP.HOME_STAND=CFrame.new(SX,HY,SZ) -- the parked shuttle (= the airport package's stand aircraft frame)
FP.PM_STAND=CFrame.lookAt(v(140,PY,PZ),v(100,PY,PZ)) -- facing west, left doors towards the terminal
FP.HOME_GATES={(A.gates[A.shuttleStand] or A.gates[1]).Position}
FP.PM_GATES={v(0,G+4,7636),B.checkin[1]+Vector3.new(0,4,0),B.checkin[2]+Vector3.new(0,4,0)}
FP.GATE_RADIUS=36
FP.GATE_NAME={out="A"..A.shuttleStand,back="Port Meridian"}
-- Where a boarded passenger's character is held (anchored, hidden below the apron) while the client shows
-- the ride: under the departure stand, then under the arrival stand from the middle of the cruise.
FP.HOLD={home=CFrame.new(SX,G-40,SZ),abroad=CFrame.new(140,G-40,PZ)}

-- tracks per leg (built once, deterministic)
type LegTracks={push: Track?,taxi: Track?,roll: Track,air: Track,flareFrom: number,climbTo: number,descentFrom: number,rollout: Track,taxiin: Track}
local function outTracks(): LegTracks
	local push=FP.groundTrack({v(SX,HY,SZ),v(SX,HY,TL),v(SX+45,HY,TL)},32)
	local taxi=FP.groundTrack({v(SX+45,HY,TL),v(EXIT,HY,TL),v(EXIT,HY,TZ),v(WEST,HY,TZ),v(WEST,HY,RZ),v(WEST+60,HY,RZ)},40)
	local liftX=WEST+60+900
	local roll=makeTrack({v(WEST+60,HY,RZ),v(liftX,HY,RZ)})
	-- climb-out east, right turn over the sea, cruise south-west, left turn onto the final (PM_LINE, eastbound)
	local ctrl={v(liftX,HY,RZ),v(liftX+400,G+45,RZ),v(liftX+800,G+115,RZ),v(1350,G+200,3150),v(1600,G+300,3600), -- 5 = top of climb
		v(1500,G+420,4200),v(700,G+560,5000),v(-700,G+600,5900),v(-1900,G+520,6600), -- 9 = top of descent
		v(-2600,G+380,7050),v(-2850,G+250,7400),v(-2450,G+170,PZ),v(-1900,G+112,PZ),v(-1300,G+55,PZ),
		v(-850,G+14,PZ) --[[ 15 = flare start ]],v(-700,G+4,PZ),v(-600,PY,PZ)}
	local air=FP.airTrack(ctrl,Vector3.new(1,0,0),Vector3.new(1,0,0))
	local rollout=makeTrack({v(-600,PY,PZ),v(90,PY,PZ)})
	-- teardrop U-turn east of the stand (x &lt;= 250; the decorative aircraft stands at x 420)
	local taxiin=FP.groundTrack({v(90,PY,PZ),v(160,PY,PZ),v(210,PY,PZ-22),v(250,PY,PZ-2),v(225,PY,PZ+20),v(180,PY,PZ+7),v(140,PY,PZ)},14)
	return {push=push,taxi=taxi,roll=roll,air=air,climbTo=air.marks[5],descentFrom=air.marks[9],flareFrom=air.marks[15],rollout=rollout,taxiin=taxiin}
end
local function backTracks(): LegTracks
	local liftX=140-720
	local roll=makeTrack({v(140,PY,PZ),v(liftX,PY,PZ)})
	-- straight climb-out along PM_LINE until past the towers (x &lt; -1040), then the right turn north
	local ctrl={v(liftX,PY,PZ),v(-800,G+20,PZ),v(-1040,G+60,PZ),v(-1300,G+105,PZ-6),v(-1700,G+190,7380),v(-1950,G+330,6950), -- 6 = top of climb
		v(-1700,G+520,6200),v(-500,G+680,5200),v(1000,G+700,4300),v(2300,G+560,3700), -- 10 = top of descent
		v(3000,G+330,3250),v(2700,G+180,RZ),v(2300,G+134,RZ),v(1700,G+86,RZ),
		v(1150,G+22,RZ) --[[ 15 = flare start ]],v(950,G+6,RZ),v(820,HY,RZ)}
	-- never drift towards the terminal side while low over Port Meridian's runway
	local air=FP.airTrack(ctrl,Vector3.new(-1,0,0),Vector3.new(-1,0,0),function(p: Vector3): Vector3
		return if p.X&gt;-1100 and p.Z&gt;PZ then Vector3.new(p.X,p.Y,PZ) else p
	end)
	local rollout=makeTrack({v(820,HY,RZ),v(-700,HY,RZ)})
	local taxiin=FP.groundTrack({v(-700,HY,RZ),v(WEST,HY,RZ),v(WEST,HY,TZ),v(EXIT,HY,TZ),v(EXIT,HY,TL),v(SX,HY,TL),v(SX,HY,SZ)},40)
	return {push=nil,taxi=nil,roll=roll,air=air,climbTo=air.marks[6],descentFrom=air.marks[10],flareFrom=air.marks[15],rollout=rollout,taxiin=taxiin}
end

------------------------------------------------------------------------------------------------ legs
local C=FP.CONFIG
-- Ground handling at the home stand (client visuals, shared maths so the tests can sweep them): the pushback
-- tug pushes the aircraft, disconnects during `detach` seconds at the end of the pushback (moves 24 studs
-- aside) and drives back to its place in `home` seconds; the jet bridge retracts (telescopes `retract` studs
-- and swings `angle` away from the fuselage about its terminal end) while the doors close and docks again in
-- `time` seconds after arrival.
FP.TUG={detach=3,home=18,aside=24}
FP.BRIDGE={angle=math.rad(5),retract=4,time=4}
local segmentPose: (Segment,number)-&gt;Pose
local function pointTrack(cf: CFrame): Track return makeTrack({cf.Position}) end
local function holdSeg(phase: string,cf: CFrame,T: number): Segment
	return {phase=phase,mode="hold",t0=0,t1=T,track=pointTrack(cf),s0=0,s1=0,prof=profile(1e-3,0,0,0,1),reverse=false,hold=cf,aoa0=0,aoa1=0}
end
local function moveSeg(phase: string,mode: string,tr: Track,s0: number,s1: number,prof: Profile,reverse: boolean?,aoa0: number?,aoa1: number?): Segment
	return {phase=phase,mode=mode,t0=0,t1=prof.T,track=tr,s0=s0,s1=s1,prof=prof,reverse=reverse==true,hold=nil,aoa0=aoa0 or 0,aoa1=aoa1 or aoa0 or 0}
end
-- The moving part of a leg (everything after boarding), without times.
local function movingSegments(dir: string): {Segment}
	local segs: {Segment}={}
	if dir=="out" then
		local t=outTracks()
		table.insert(segs,holdSeg("doors",FP.HOME_STAND,C.doors))
		local push=t.push :: Track
		local pushSeg=moveSeg("pushback","ground",push,0,push.length,profile(push.length,0,C.pushSpeed,0,C.pushAcc),true)
		table.insert(segs,pushSeg)
		-- the tug disconnects and drives aside before the aircraft taxis under its own power
		table.insert(segs,holdSeg("pushback",segmentPose(pushSeg,pushSeg.t1).cf,FP.TUG.detach))
		local taxi=t.taxi :: Track
		table.insert(segs,moveSeg("taxi","ground",taxi,0,taxi.length,profile(taxi.length,0,C.taxiSpeed,0,C.taxiAcc)))
		local L=t.roll.length
		table.insert(segs,moveSeg("takeoff","roll",t.roll,0,L,profile(L,0,C.liftoff,C.liftoff,C.liftoff^2/(2*L))))
		local air=t.air
		table.insert(segs,moveSeg("climb","air",air,0,t.climbTo,profile(t.climbTo,C.liftoff,C.climbSpeed,C.climbSpeed,(C.climbSpeed^2-C.liftoff^2)/(2*t.climbTo))))
		local cruiseL=t.descentFrom-t.climbTo
		table.insert(segs,moveSeg("cruise","air",air,t.climbTo,t.descentFrom,profile(cruiseL,C.climbSpeed,C.cruiseSpeed,C.cruiseSpeed,12)))
		local apL=t.flareFrom-t.descentFrom
		table.insert(segs,moveSeg("approach","air",air,t.descentFrom,t.flareFrom,profile(apL,C.cruiseSpeed,C.cruiseSpeed,C.approachSpeed,(C.cruiseSpeed^2-C.approachSpeed^2)/(2*apL)),false,rad(3)))
		local flL=air.length-t.flareFrom
		table.insert(segs,moveSeg("landing","air",air,t.flareFrom,air.length,profile(flL,C.approachSpeed,C.approachSpeed,C.touchdown,(C.approachSpeed^2-C.touchdown^2)/(2*flL)),false,rad(3),rad(6.5)))
		local rL=t.rollout.length
		table.insert(segs,moveSeg("landing","rollout",t.rollout,0,rL,profile(rL,C.touchdown,C.touchdown,12,(C.touchdown^2-144)/(2*rL))))
		local ti=t.taxiin
		table.insert(segs,moveSeg("taxiin","ground",ti,0,ti.length,profile(ti.length,12,26,0,4.5)))
		table.insert(segs,holdSeg("deboarding",FP.PM_STAND,C.deboarding))
	else
		local t=backTracks()
		table.insert(segs,holdSeg("doors",FP.PM_STAND,C.doors))
		table.insert(segs,holdSeg("pushback",FP.PM_STAND,C.startup))
		table.insert(segs,holdSeg("taxi",FP.PM_STAND,C.lineup))
		local L=t.roll.length
		table.insert(segs,moveSeg("takeoff","roll",t.roll,0,L,profile(L,0,C.liftoffPM,C.liftoffPM,C.liftoffPM^2/(2*L))))
		local air=t.air
		table.insert(segs,moveSeg("climb","air",air,0,t.climbTo,profile(t.climbTo,C.liftoffPM,C.climbSpeed,C.climbSpeed,(C.climbSpeed^2-C.liftoffPM^2)/(2*t.climbTo))))
		local cruiseL=t.descentFrom-t.climbTo
		table.insert(segs,moveSeg("cruise","air",air,t.climbTo,t.descentFrom,profile(cruiseL,C.climbSpeed,C.cruiseSpeed,C.cruiseSpeed,12)))
		local apL=t.flareFrom-t.descentFrom
		table.insert(segs,moveSeg("approach","air",air,t.descentFrom,t.flareFrom,profile(apL,C.cruiseSpeed,C.cruiseSpeed,C.approachSpeed,(C.cruiseSpeed^2-C.approachSpeed^2)/(2*apL)),false,rad(3)))
		local flL=air.length-t.flareFrom
		table.insert(segs,moveSeg("landing","air",air,t.flareFrom,air.length,profile(flL,C.approachSpeed,C.approachSpeed,C.touchdown,(C.approachSpeed^2-C.touchdown^2)/(2*flL)),false,rad(3),rad(6.5)))
		local rL=t.rollout.length
		table.insert(segs,moveSeg("landing","rollout",t.rollout,0,rL,profile(rL,C.touchdown,C.touchdown,C.rollout,(C.touchdown^2-C.rollout^2)/(2*rL))))
		local ti=t.taxiin
		table.insert(segs,moveSeg("taxiin","ground",ti,0,ti.length,profile(ti.length,C.rollout,C.taxiSpeed,0,C.taxiAcc)))
		table.insert(segs,holdSeg("deboarding",FP.HOME_STAND,C.deboarding))
	end
	return segs
end
local function fixedTime(segs: {Segment}): number
	local T=0
	for _,s in segs do T+=s.t1-s.t0 end
	return T
end
local cache: {legs: {[string]: Leg},interval: number}?=nil
local function build(): {legs: {[string]: Leg},interval: number}
	if cache then return cache end
	local moving={out=movingSegments("out"),back=movingSegments("back")}
	local pmBoarding=math.max(C.pmBoarding,FP.CREW_TURN)
	local need=fixedTime(moving.out)+fixedTime(moving.back)+pmBoarding+C.minBoarding
	local interval=math.max(C.interval,math.ceil(need))
	local legs: {[string]: Leg}={}
	for _,dir in {"out","back"} do
		local segs=moving[dir]
		local boarding=if dir=="out" then interval-fixedTime(moving.out)-fixedTime(moving.back)-pmBoarding else pmBoarding
		local start=if dir=="out" then FP.HOME_STAND else FP.PM_STAND
		table.insert(segs,1,holdSeg("boarding",start,boarding))
		local t=0
		local phases: {[string]: {t0: number,t1: number}}={}
		for _,s in segs do
			local T=s.t1-s.t0
			s.t0=t;s.t1=t+T;t+=T
			local ph=phases[s.phase]
			if ph then ph.t1=s.t1 else phases[s.phase]={t0=s.t0,t1=s.t1} end
		end
		legs[dir]={dir=dir,from=if dir=="out" then "home" else "abroad",to=if dir=="out" then "abroad" else "home",flight=C.flights[dir],
			segments=segs,duration=t,boarding=boarding,phases=phases,stand=start,arrivalStand=if dir=="out" then FP.PM_STAND else FP.HOME_STAND}
	end
	local c={legs=legs,interval=interval}
	cache=c
	return c
end
-- Rebuild after changing CONFIG (tests).
function FP.reset() cache=nil;FP.resetAmbient() end
function FP.interval(): number return build().interval end
function FP.leg(dir: string): Leg return build().legs[dir] or build().legs.out end

------------------------------------------------------------------------------------------------ timetable
export type State={cycle: number,dir: string,leg: Leg,tau: number,phase: string,legStart: number,phaseStart: number,phaseEnd: number}
-- Where the shuttle is in its timetable at server time `now`.
function FP.at(now: number): State
	local b=build()
	local I=b.interval
	local t=now-C.epoch
	local cycle=math.floor(t/I)
	local u=t-cycle*I
	local outDur=b.legs.out.duration
	local dir=if u&lt;outDur then "out" else "back"
	local leg=b.legs[dir]
	local legStart=C.epoch+cycle*I+(if dir=="out" then 0 else outDur)
	local tau=now-legStart
	local phase="deboarding";local p0,p1=legStart,legStart+leg.duration
	for _,name in FP.PHASES do
		local ph=leg.phases[name]
		if ph and tau&gt;=ph.t0 and tau&lt;ph.t1 then phase=name;p0=legStart+ph.t0;p1=legStart+ph.t1;break end
	end
	return {cycle=cycle,dir=dir,leg=leg,tau=tau,phase=phase,legStart=legStart,phaseStart=p0,phaseEnd=p1}
end
-- Start time (server time) of leg `dir` of cycle k (the back leg starts when the out leg ends).
function FP.legStart(dir: string,cycle: number): number
	local b=build()
	return C.epoch+cycle*b.interval+(if dir=="out" then 0 else b.legs.out.duration)
end
-- The next leg in direction `dir` whose boarding has not ended at `now`: (cycle, legStart, departure time =
-- end of boarding + doors = pushback start, boarding end).
function FP.nextLeg(dir: string,now: number): (number,number,number,number)
	local I=build().interval
	local leg=FP.leg(dir)
	local k=math.floor((now-C.epoch)/I)-1
	for _=1,4 do
		local s=FP.legStart(dir,k)
		local boardEnd=s+leg.phases.boarding.t1
		if boardEnd&gt;now then return k,s,s+leg.phases.pushback.t0,boardEnd end
		k+=1
	end
	local s=FP.legStart(dir,k)
	return k,s,s+leg.phases.pushback.t0,s+leg.phases.boarding.t1
end
-- Seconds of flight (pushback start -&gt; deboarding start) of a leg.
function FP.flightTime(dir: string): number
	local leg=FP.leg(dir)
	return leg.phases.deboarding.t0-leg.phases.pushback.t0
end
-- Seconds until boarding of the next leg in direction dir starts (0 while it is boarding).
function FP.boardingIn(dir: string,now: number): number
	local _,start=FP.nextLeg(dir,now)
	return math.max(0,start-now)
end

------------------------------------------------------------------------------------------------ poses
local function smooth(x: number): number x=math.clamp(x,0,1);return x*x*(3-2*x) end
local function flat(d: Vector3): Vector3
	local f=Vector3.new(d.X,0,d.Z)
	return if f.Magnitude&gt;1e-5 then f.Unit else Vector3.new(0,0,-1)
end
-- Signed bank angle (positive = right wing down) from the heading change around s.
local function bankAt(tr: Track,s: number,speed: number): number
	local D=70
	local a=flat(FP.tangent(tr,math.max(0,s-D),20));local b=flat(FP.tangent(tr,math.min(tr.length,s+D),20))
	local dist=math.min(tr.length,s+D)-math.max(0,s-D)
	if dist&lt;1 then return 0 end
	local ang=math.atan2(a:Cross(b).Y,a:Dot(b)) -- &lt; 0 = right turn (y up, viewed from above)
	local kappa=-ang/dist
	return math.clamp(math.atan(speed*speed*kappa/C.gEff),-C.maxBank,C.maxBank)
end
function segmentPose(seg: Segment,tau: number): Pose
	local local_t=tau-seg.t0
	if seg.mode=="hold" then
		local cf=seg.hold or CFrame.new()
		return {cf=cf,phase=seg.phase,speed=0,onGround=true,gearDown=true,engines=seg.phase~="boarding" and seg.phase~="deboarding",altitude=0}
	end
	local d,speed=along(seg.prof,local_t)
	local s=seg.s0+d
	local tr=seg.track
	local pos=trackPos(tr,s)
	local tan=FP.tangent(tr,s,if seg.mode=="air" then 16 else 6)
	if seg.mode=="ground" or seg.mode=="roll" or seg.mode=="rollout" then
		local heading=flat(tan)
		if seg.reverse then heading=-heading end
		local pitch=0
		if seg.mode=="roll" then pitch=rad(8)*smooth((local_t-(seg.prof.T-2.6))/2.6) end
		if seg.mode=="rollout" then pitch=rad(5)*(1-smooth(local_t/2.6)) end
		local cf=CFrame.lookAt(pos,pos+heading)*CFrame.Angles(pitch,0,0)
		return {cf=cf,phase=seg.phase,speed=speed,onGround=true,gearDown=true,engines=true,altitude=0}
	end
	-- air
	local u=if seg.prof.T&gt;0 then local_t/seg.prof.T else 1
	local aoa=seg.aoa0+(seg.aoa1-seg.aoa0)*smooth(u)
	if seg.phase=="climb" then aoa=rad(3)+rad(5)*(1-smooth(local_t/6)) end
	local bank=bankAt(tr,s,speed)
	local cf=CFrame.lookAt(pos,pos+tan)*CFrame.Angles(0,0,-bank)*CFrame.Angles(aoa,0,0)
	local ground=if pos.Z&gt;5000 then PY else HY
	local alt=pos.Y-ground
	local gear=alt&lt;160 and not (seg.phase=="climb" and local_t&gt;4)
	if seg.phase=="cruise" then gear=false end
	return {cf=cf,phase=seg.phase,speed=speed,onGround=false,gearDown=gear,engines=true,altitude=alt}
end
-- Pose of leg `leg` at time tau (seconds since the leg start).
function FP.legPose(leg: Leg,tau: number): Pose
	local segs=leg.segments
	if tau&lt;=0 then return segmentPose(segs[1],0) end
	for _,seg in segs do
		if tau&lt;seg.t1 then return segmentPose(seg,tau) end
	end
	local last=segs[#segs]
	return segmentPose(last,last.t1)
end
-- Pose of the shuttle at server time `now`.
function FP.pose(now: number): (Pose,State)
	local st=FP.at(now)
	return FP.legPose(st.leg,st.tau),st
end
-- Pushback tug of the home stand: its frame now, given its parked frame (attached to the nose gear).
function FP.tugFrame(st: State,parked: CFrame): CFrame
	if st.dir~="out" then return parked end
	local leg=st.leg
	local push=leg.phases.pushback
	local hold=FP.TUG.detach
	if st.tau&lt;push.t0 then return parked end
	local rel=FP.HOME_STAND:ToObjectSpace(parked)
	if st.tau&lt;push.t1-hold then return FP.legPose(leg,st.tau).cf*rel end
	local endCf=FP.legPose(leg,push.t1-hold).cf
	local attached=endCf*rel
	local aside=CFrame.new(endCf.RightVector*FP.TUG.aside)*attached
	if st.tau&lt;push.t1 then return attached:Lerp(aside,smooth((st.tau-(push.t1-hold))/hold)) end
	local tx=st.tau-leg.phases.taxi.t0
	if tx&gt;=FP.TUG.home then return parked end
	local u=smooth(tx/FP.TUG.home)
	local a,b=aside.Position,parked.Position
	local p=a:Lerp(b,u)
	local dir=flat(b-a)
	local driving=CFrame.lookAt(p,p+dir)
	local turn=smooth((u-0.8)/0.2)
	local r0=driving.Rotation
	local start=smooth(u/0.15)
	r0=aside.Rotation:Lerp(r0,start)
	return CFrame.new(p)*r0:Lerp(parked.Rotation,turn)
end
-- Jet bridge of the home stand: 0 = docked at the door, 1 = retracted (doors closing -&gt; arrival).
function FP.bridgeU(st: State): number
	local ph=st.leg.phases
	if st.dir=="out" then
		if st.phase=="boarding" then return 0 end
		if st.phase=="doors" then return smooth((st.tau-ph.doors.t0)/math.min(FP.BRIDGE.time,ph.doors.t1-ph.doors.t0)) end
		return 1
	end
	if st.phase=="deboarding" then return 1-smooth((st.tau-ph.deboarding.t0)/FP.BRIDGE.time) end
	return 1
end
-- Axes of a jet bridge from its terminal-end point (model attribute TerminalDoor) and its cab floor frame
-- (LookVector towards the aircraft door): pivot, axis (terminal -&gt; cab) and away (from the fuselage).
function FP.bridgeAxes(terminalDoor: Vector3,cab: CFrame): (Vector3,Vector3,Vector3)
	return terminalDoor,flat(cab.Position-terminalDoor),flat(-cab.LookVector)
end
-- Parts of the outer tunnel (fixed at the terminal) vs everything that telescopes.
function FP.bridgeInner(name: string): boolean return string.sub(name,1,11)~="BridgeOuter" end
-- Frame of one jet-bridge part at retraction u: `inner` parts (inner tunnel, drive unit, cab, bellows)
-- telescope towards the terminal along `axis` (unit, terminal -&gt; cab, horizontal); everything swings about
-- the terminal end `pivot` so that the cab moves along `away` (unit, horizontal, away from the fuselage).
function FP.bridgeFrame(cf: CFrame,inner: boolean,u: number,pivot: Vector3,axis: Vector3,away: Vector3): CFrame
	if u&lt;=0 then return cf end
	local r=Vector3.new(axis.X,0,axis.Z)
	local swing=Vector3.new(r.Z,0,-r.X) -- d(cab)/d(angle) for a rotation about +Y
	local sign=if swing:Dot(away)&gt;=0 then 1 else -1
	local p=Vector3.new(pivot.X,0,pivot.Z)
	local out=cf
	if inner then out=CFrame.new(-axis*FP.BRIDGE.retract*u)*out end
	local rot=CFrame.new(p)*CFrame.Angles(0,sign*FP.BRIDGE.angle*u,0)*CFrame.new(-p)
	return rot*out
end
-- Crew (the two pilots), the same pair on every leg. At City Airport they leave the aircraft after arrival
-- (CREW_LEAVE seconds of walking, from the start of deboarding into the next leg's boarding), wait in the
-- crew room, and walk back to the aircraft in the last part of boarding (CREW_WALK seconds, seated
-- CREW_SEATED seconds before boarding ends). At Port Meridian the turnaround is short: both stay aboard
-- ("cockpit"), and the first officer does the exterior walkaround (down the airstairs, round the nose, back
-- up) WALKAROUND seconds from WALKAROUND_START into the boarding. States: "leaving", "crewroom", "walking",
-- "cockpit".
FP.CREW_WALK=22
FP.CREW_LEAVE=20
FP.CREW_SEATED=3
FP.WALKAROUND_START=4
FP.WALKAROUND=30
FP.CREW_TURN=FP.WALKAROUND_START+FP.WALKAROUND+3 -- the shortest Port Meridian boarding
-- (state, seconds since the leave / walk started; nil otherwise)
function FP.crewTimes(st: State): (string,number?)
	local ph=st.leg.phases
	if st.phase=="deboarding" then
		if st.dir=="back" then return "leaving",st.tau-ph.deboarding.t0 end
		return "cockpit",nil -- arrived at Port Meridian: the crew stays aboard
	end
	if st.phase=="boarding" and st.dir=="out" then
		local sinceLeave=st.tau+C.deboarding -- the previous leg's deboarding started this long ago
		local walkStart=math.max(0,ph.boarding.t1-FP.CREW_SEATED-FP.CREW_WALK)
		if st.tau&lt;walkStart and sinceLeave&lt;FP.CREW_LEAVE then return "leaving",sinceLeave end
		if st.tau&lt;walkStart then return "crewroom",nil end
		if st.tau&lt;ph.boarding.t1-FP.CREW_SEATED then return "walking",st.tau-walkStart end
	end
	return "cockpit",nil
end
function FP.crewState(st: State): string
	local state=FP.crewTimes(st)
	return state
end
-- Seconds into the first officer's Port Meridian walkaround (nil outside it).
function FP.walkaround(st: State): number?
	if st.dir~="back" or st.phase~="boarding" then return nil end
	local since=st.tau-FP.WALKAROUND_START
	if since&lt;0 or since&gt;FP.WALKAROUND then return nil end
	return since
end

------------------------------------------------------------------------------------------------ helicopter
-- VIP helicopter between two pads (Port Meridian: airport pad -&gt; Meridian Grand roof). Spool up, vertical
-- lift to hover height, transit at cruise height along the boulevard corridor (x = HELI_CORRIDOR_X, the open
-- axis between the towers), hover over the target, vertical descent, spool down.
export type HeliPlan={from: Vector3,to: Vector3,duration: number,lift: number,transit: number,descend: number,track: Track,prof: Profile}
FP.HELI_SPOOL=3
FP.HELI_HOVER=30
FP.HELI_CORRIDOR_X=0
function FP.heliPlan(from: Vector3,to: Vector3): HeliPlan
	local cruiseY=math.max(from.Y,to.Y)+C.heliCruise
	local fromUp=from+Vector3.new(0,FP.HELI_HOVER,0)
	local toUp=to+Vector3.new(0,FP.HELI_HOVER,0)
	local x=FP.HELI_CORRIDOR_X
	local sz=if to.Z&gt;from.Z then 1 else -1
	local ctrl={fromUp}
	if math.abs(from.X-x)&gt;40 then table.insert(ctrl,Vector3.new((from.X+x)/2,(fromUp.Y+cruiseY)/2,from.Z+sz*60)) end
	table.insert(ctrl,Vector3.new(x,cruiseY,from.Z+sz*110))
	table.insert(ctrl,Vector3.new(x,cruiseY,to.Z-sz*120))
	if math.abs(to.X-x)&gt;40 then table.insert(ctrl,Vector3.new((to.X+x)/2,(toUp.Y+cruiseY)/2,to.Z-sz*60)) end
	table.insert(ctrl,toUp)
	local d0=Vector3.new(ctrl[2].X-fromUp.X,0,ctrl[2].Z-fromUp.Z)
	local d1=Vector3.new(toUp.X-ctrl[#ctrl-1].X,0,toUp.Z-ctrl[#ctrl-1].Z)
	local track=FP.airTrack(ctrl,if d0.Magnitude&gt;0.1 then d0.Unit else Vector3.new(0,0,sz),if d1.Magnitude&gt;0.1 then d1.Unit else Vector3.new(0,0,sz))
	local prof=profile(track.length,0,C.heliSpeed,0,12)
	local lift=7;local descend=9
	return {from=from,to=to,duration=FP.HELI_SPOOL*2+lift+prof.T+descend,lift=lift,transit=prof.T,descend=descend,track=track,prof=prof}
end
-- Helicopter frame (skids on the pad at both ends) and rotor speed 0..1 at tau seconds into the plan.
function FP.heliPose(h: HeliPlan,tau: number): (CFrame,number)
	local rotor=math.clamp(tau/FP.HELI_SPOOL,0,1)*math.clamp((h.duration-tau)/FP.HELI_SPOOL,0,1)
	local first=flat(FP.tangent(h.track,0,30));local last=flat(FP.tangent(h.track,h.track.length,30))
	local t=tau-FP.HELI_SPOOL
	local fromUp=h.from+Vector3.new(0,FP.HELI_HOVER,0)
	local toUp=h.to+Vector3.new(0,FP.HELI_HOVER,0)
	if t&lt;=0 then return CFrame.lookAt(h.from,h.from+first),rotor end
	if t&lt;h.lift then
		local p=h.from:Lerp(fromUp,smooth(t/h.lift))
		return CFrame.lookAt(p,p+first),rotor
	end
	t-=h.lift
	if t&lt;h.transit then
		local d,speed=along(h.prof,t)
		local p=trackPos(h.track,d)
		local heading=flat(FP.tangent(h.track,d,14))
		local accel=if t&lt;h.prof.t1 then 1 elseif t&gt;h.prof.t2 then -1 else 0
		local pitch=-rad(9)*accel*math.clamp(speed/12,0,1)
		local bank=bankAt(h.track,d,speed)
		return CFrame.lookAt(p,p+heading)*CFrame.Angles(0,0,-bank)*CFrame.Angles(pitch,0,0),rotor
	end
	t-=h.transit
	if t&lt;h.descend then
		local p=toUp:Lerp(h.to,smooth(t/h.descend))
		return CFrame.lookAt(p,p+last),rotor
	end
	return CFrame.lookAt(h.to,h.to+last),rotor
end

-- A transfer requested at t (destination "hotel" | "airport"; a = airport pad, b = hotel pad, the helicopter
-- waits at a): to the hotel = ride a-&gt;b, then an empty ferry back; to the airport = ferry a-&gt;b to pick the
-- passenger up, then the ride b-&gt;a. Returns (ride start, ride end, helicopter free again).
function FP.heliTimes(destination: string,t: number,a: Vector3,b: Vector3): (number,number,number)
	local dAB=FP.heliPlan(a,b).duration;local dBA=FP.heliPlan(b,a).duration
	if destination=="hotel" then return t,t+dAB,t+dAB+dBA+2 end
	return t+dAB,t+dAB+dBA,t+dAB+dBA+2
end
-- Helicopter frame at server time now for a transfer started at `start`: (cf, rotor 0..1, carrying passenger).
function FP.heliAt(destination: string,start: number,now: number,a: Vector3,b: Vector3): (CFrame,number,boolean)
	local ab=FP.heliPlan(a,b);local ba=FP.heliPlan(b,a)
	local tau=now-start
	if tau&lt;ab.duration then
		local cf,rotor=FP.heliPose(ab,tau)
		return cf,rotor,destination=="hotel"
	end
	local cf,rotor=FP.heliPose(ba,math.min(tau-ab.duration,ba.duration))
	return cf,rotor,destination=="airport" and tau&lt;ab.duration+ba.duration
end

------------------------------------------------------------------------------------------------ ambient traffic
-- Other airliners at City Airport (client-only visuals), flying the same runway directions as the shuttle:
-- arrivals land west (from the east, like the shuttle's return), roll out to the far west end of the runway
-- (x &lt;= -1000, beyond the taxiway and out of the terminal's view) and fade there; departures appear at that
-- end, lined up east, and take off east like the shuttle. Sky crossings fly straight across the map at
-- 2,400-3,400 studs. Runway events are placed in each cycle where the shuttle does not use the runway or
-- its approach (FP.ambientSlots).
export type Ambient={kind: string,t0: number,duration: number,track: Track,segs: {Segment},livery: number,big: boolean}
local function hash(n: number): number
	n=math.floor(n)%2147483647
	n=(n*1103515245+12345)%2147483648
	n=(n*1103515245+12345)%2147483648
	return n
end
FP.hash=hash
FP.AMBIENT_END_X=-1060 -- where ambient arrivals vanish and departures appear (runway west end, x &gt;= -1100)
local function arrivalSegs(): {Segment}
	local ctrl={v(6500,G+420,RZ),v(4200,G+260,RZ),v(2400,G+130,RZ),v(1400,G+40,RZ),v(1000,G+8,RZ),v(880,HY,RZ)}
	local air=FP.airTrack(ctrl,Vector3.new(-1,0,0),Vector3.new(-1,0,0))
	local roll=makeTrack({v(880,HY,RZ),v(-880,HY,RZ)})
	local off=makeTrack({v(-880,HY,RZ),v(FP.AMBIENT_END_X,HY,RZ)})
	local segs={
		moveSeg("approach","air",air,0,air.length,profile(air.length,230,230,C.touchdown,(230^2-C.touchdown^2)/(2*air.length)),false,rad(3),rad(5.5)),
		moveSeg("landing","rollout",roll,0,roll.length,profile(roll.length,C.touchdown,C.touchdown,24,(C.touchdown^2-24^2)/(2*roll.length))),
		moveSeg("taxiin","ground",off,0,off.length,profile(off.length,24,24,8,1.5)),
	}
	return segs
end
local function departureSegs(): {Segment}
	local x0=FP.AMBIENT_END_X
	local start=CFrame.lookAt(v(x0,HY,RZ),v(x0+10,HY,RZ))
	local roll=makeTrack({v(x0,HY,RZ),v(x0+1000,HY,RZ)})
	local lx=x0+1000
	local ctrl={v(lx,HY,RZ),v(lx+460,G+55,RZ),v(lx+1060,G+190,RZ),v(2200,G+460,3150),v(4200,G+900,3600),v(7000,G+1400,4200)}
	local air=FP.airTrack(ctrl,Vector3.new(1,0,0),Vector3.new(1,0,0.2))
	return {
		holdSeg("taxi",start,4),
		moveSeg("takeoff","roll",roll,0,roll.length,profile(roll.length,0,C.liftoff,C.liftoff,C.liftoff^2/(2*roll.length))),
		moveSeg("climb","air",air,0,air.length,profile(air.length,C.liftoff,280,280,(280^2-C.liftoff^2)/(2*air.length))),
	}
end
local function timed(segs: {Segment}): ({Segment},number)
	local t=0
	for _,s in segs do local T=s.t1-s.t0;s.t0=t;s.t1=t+T;t+=T end
	return segs,t
end
local ambientCache: {arrival: {Segment},departure: {Segment},arrivalT: number,departureT: number}?=nil
local function ambientBase()
	if ambientCache then return ambientCache end
	local a,at=timed(arrivalSegs())
	local d,dt=timed(departureSegs())
	local c={arrival=a,departure=d,arrivalT=at,departureT=dt}
	ambientCache=c
	return c
end
local slotCache: {number}?=nil
function FP.resetAmbient() slotCache=nil;ambientCache=nil end
-- Offsets (seconds into a cycle) where an ambient runway event fits (the longer of arrival / departure).
function FP.ambientSlots(): {number}
	if slotCache then return slotCache end
	local b=build()
	local I=b.interval
	local base=ambientBase()
	local len=math.max(base.arrivalT,base.departureT)
	local busy: {{number}}={}
	local out,back=b.legs.out,b.legs.back
	local backStart=out.duration
	table.insert(busy,{out.phases.taxi.t1-20,out.phases.climb.t0+30})
	table.insert(busy,{backStart+back.phases.approach.t0+(back.phases.approach.t1-back.phases.approach.t0)*0.5,backStart+back.phases.taxiin.t0+20})
	local slots: {number}={}
	local t=5
	while t&lt;I-len and #slots&lt;2 do
		local ok=true
		for _,w in busy do if t+len&gt;w[1] and t-8&lt;w[2] then ok=false end end
		if ok then table.insert(slots,t);t+=len+30 else t+=1 end
	end
	slotCache=slots
	return slots
end
-- Ambient events of cycle k: up to two runway movements and two sky crossings (deterministic per cycle).
export type AmbientEvent={id: string,kind: string,t0: number,duration: number,segs: {Segment}?,from: Vector3?,to: Vector3?,livery: number,lod: string}
function FP.ambient(cycle: number): {AmbientEvent}
	local base=ambientBase()
	local I=build().interval
	local start=C.epoch+cycle*I
	local out: {AmbientEvent}={}
	for i,off in FP.ambientSlots() do
		local h=hash(cycle*7+i)
		local arrival=(h//65536)%2==0 -- a high bit: the low bits of the LCG alternate with a short period
		table.insert(out,{id="rw"..cycle.."_"..i,kind=if arrival then "arrival" else "departure",t0=start+off,
			duration=if arrival then base.arrivalT else base.departureT,segs=if arrival then base.arrival else base.departure,livery=(h//4096)%5+1,lod="medium"})
	end
	for i=1,2 do
		local h=hash(cycle*13+i*101)
		local ang=(h%3600)/3600*math.pi*2
		local alt=G+2400+(h%1000)
		local centre=v(((h//7)%1600)-800,alt,1400+((h//11)%1600))
		local d=Vector3.new(math.cos(ang),0,math.sin(ang))
		table.insert(out,{id="sky"..cycle.."_"..i,kind="sky",t0=start+(i-1)*I/2+((h//13)%60),duration=16000/260,
			from=centre-d*8000,to=centre+d*8000,livery=(h//17)%5+1,lod="low"})
	end
	return out
end
-- Frame of an ambient event at server time now (nil when it is not active).
function FP.ambientPose(e: AmbientEvent,now: number): Pose?
	local tau=now-e.t0
	if tau&lt;0 or tau&gt;e.duration then return nil end
	if e.kind=="sky" then
		local a,b=e.from :: Vector3,e.to :: Vector3
		local p=a:Lerp(b,tau/e.duration)
		return {cf=CFrame.lookAt(p,p+(b-a).Unit),phase="cruise",speed=260,onGround=false,gearDown=false,engines=true,altitude=p.Y-G}
	end
	local segs=e.segs :: {Segment}
	for _,seg in segs do
		if tau&lt;seg.t1 then return segmentPose(seg,tau) end
	end
	return segmentPose(segs[#segs],segs[#segs].t1)
end

return FP
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000011"><Properties><string name="Name">PhoneMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- PhoneMath (package "phone"): the pure helpers of the company phone ("Diensthandy"). No Roblox services, no
-- instances: the server (PhoneService) and the client (PhoneController, UI/Screens/Phone) call the same
-- functions with the same data, and the headless tests check them directly.
--   * time: company time from CompanyOps.hour (one game day = 1200 s, 08:00-18:00 = 900 s), company day from
--     empire.calendar, play-second deadlines (trips, accounts) converted into "Day 9 · 10:30"
--   * messages: every line of the company log (empire.deals.news, "day 8 11:54: signed CloudDesk: ...") becomes
--     one phone message with a sender (Sales, HR, Travel desk ...), plus events the phone derives from the
--     replicated state: who is sick / on vacation today (CompanyOps.presence), rack faults and their fixes
--     (live.compute.faults), new hires and leavers (staff profiles), the next goal (EmpireMath.nextGoal)
--   * calendar: trips under way and their returns, check-in visits before a contract ends, the next shuttle,
--     items other packages add through PhoneService.addCalendarItem
--   * calls: the assistant's texts for the first signed client, a pilot trip abroad / in the region and an
--     affordable office (the real names, times, hotels and prices)
--   * AI chat: the system prompt of a released model from its REAL data, and the clearly labelled offline demo
--     replies (deterministic, quality from the model's real stats) used when TextGenerator is unavailable
-- Nothing here changes money or saved data (CORE_SPEC 11.6: the model chat has no economic effect).
local Shared = script.Parent
local Config = Shared.Config
local Ops = require(Shared.CompanyOps)
local Format = require(Shared.Format)
local EmployeeConfig = require(Config.EmployeeConfig)
local EmpireConfig = require(Config.EmpireConfig)
local ModelConfig = require(Config.ModelConfig)
local HardwareConfig = require(Config.HardwareConfig)

local PhoneMath = {}

PhoneMath.INBOX_MAX = 40 -- messages kept in the phone (the newest 20 news lines + derived events)
PhoneMath.CALLS_MAX = 20 -- call log entries per session (server memory)
PhoneMath.CALL_RING = 25 -- seconds an incoming call rings before it counts as missed
PhoneMath.CALENDAR_MAX = 24 -- items other packages may add per session (PhoneService.addCalendarItem)
PhoneMath.CHAT_MAX_CHARS = 200 -- one chat message of the player (characters)
PhoneMath.CHAT_GAP = 4 -- seconds between two chat requests of one player
PhoneMath.CHAT_PER_MINUTE = 10 -- chat requests per player and minute
PhoneMath.CHAT_GLOBAL_PER_MINUTE = 90 -- the whole server stays below TextGenerator's ~100 requests per minute
PhoneMath.CHAT_MAX_TOKENS = 200 -- short replies
PhoneMath.CHAT_REPLY_CHARS = 700 -- a longer generated text is cut on a character boundary
PhoneMath.CHAT_HISTORY = 20 -- turns kept in memory per model (never saved)
PhoneMath.DEMO_LABEL = "Demo reply (offline)"
PhoneMath.AI_LABEL = "AI reply"

local DAY = Ops.DAY

------------------------------------------------------------------------------------------------ time
-- "11:54" of a visible hour (CompanyOps.hour)
function PhoneMath.clock(hour: number): string
	local h = hour % 24
	local m = math.floor((h % 1) * 60 + 1e-6)
	return string.format("%02d:%02d", math.floor(h), m)
end

-- minutes since the start of a company day (company days start at 08:00, the server day index boundary)
function PhoneMath.dayMinute(hour: number): number
	local h = hour % 24
	return math.floor(((h - 8) % 24) * 60 + 1e-6)
end

-- sort key of a moment: company day and time of that day
function PhoneMath.order(day: number, hour: number): number
	return day * 1440 + PhoneMath.dayMinute(hour)
end

-- company day and visible hour now (clock = workspace:GetServerTimeNow())
function PhoneMath.now(e: any, clock: number): (number, number)
	return Ops.day(e), Ops.hour(clock)
end

-- status bar text: "Day 8 · 11:54"
function PhoneMath.statusText(e: any, clock: number): string
	local day, hour = PhoneMath.now(e, clock)
	return Format.dayClock(day, hour)
end

-- Company day and hour of a server-clock moment `at` (the company day advances whenever the server day index
-- floor(clock / DAY) changes while the company is online: CompanyOps.advanceCalendar).
function PhoneMath.atClock(e: any, clock: number, at: number): (number, number)
	local day = Ops.day(e) + (math.floor(at / DAY) - math.floor(clock / DAY))
	return math.max(1, day), Ops.hour(at)
end

-- Company day and hour of a play-second deadline (trips `back`, accounts `expires`: empire.seconds runs while
-- the company is online, one play second per server second). Past deadlines map to now.
function PhoneMath.atPlay(e: any, clock: number, play: number): (number, number)
	local seconds = tonumber(e.seconds) or 0
	local dt = math.max(0, (tonumber(play) or seconds) - seconds)
	return PhoneMath.atClock(e, clock, clock + dt)
end

-- "10:30" today, "Day 9 · 10:30" another day
function PhoneMath.when(day: number, hour: number, today: number): string
	if day == today then return PhoneMath.clock(hour) end
	return Format.dayClock(day, hour)
end

------------------------------------------------------------------------------------------------ messages
export type Message = {
	key: string,
	from: string, -- sender shown in the list (Sales, HR, Travel desk, IT desk, Assistant ...)
	title: string,
	body: string,
	tone: string, -- "good" | "bad" | "warn" | "info"
	day: number,
	hour: number,
	order: number, -- sort key (newest first)
	source: string, -- "news" | "event" | "server"
}

-- "day 8 11:54: text" -&gt; day, hour, text (a line without a stamp -&gt; day 0)
function PhoneMath.parseNews(line: string): (number, number, string)
	local d, hh, mm, text = string.match(line, "^day (%d+) (%d%d):(%d%d): (.*)$")
	if d and hh and mm and text then
		return tonumber(d) or 0, (tonumber(hh) or 0) + (tonumber(mm) or 0) / 60, text
	end
	return 0, 8, line
end

local function cap(s: string): string
	return string.upper(string.sub(s, 1, 1)) .. string.sub(s, 2)
end

-- Sender, title, body and tone of one company-log text (the texts of CompanyOps.step, EmpireService,
-- AIModelService and PricingService). Unknown texts become a plain company message.
function PhoneMath.classify(text: string): (string, string, string, string)
	local a, b, c, d
	a, b = string.match(text, "^signed (.-): (.*)$")
	if a and b then return "Sales", "Signed " .. a, "New client " .. a .. ": " .. b .. ".", "good" end
	a, b = string.match(text, "^lost (.-) %((.*)%)$")
	if a and b then return "Sales", "Lost " .. a, cap(b) .. ".", "bad" end
	a, b = string.match(text, "^visited (.-): trust (%d+)%%$")
	if a and b then return "Sales", "Back from " .. a, "Trust is at " .. b .. " %. The deal signs at 100 %.", "info" end
	a, b = string.match(text, "^renewed (.-) for (%d+) days$")
	if a and b then return "Sales", "Renewed " .. a, a .. " stays a client for " .. b .. " more days.", "good" end
	a, b, c = string.match(text, "^founder drives to (.-): (.-), (.*)$")
	if a and b and c then return "Travel desk", "You're visiting " .. a, "Your car leaves now: " .. b .. " visit, " .. c .. ".", "info" end
	a, b, c, d = string.match(text, "^rep to (.-): (.-), (.-), (.*)$")
	if a and b and c and d then return "Travel desk", "Trip to " .. a, "A field rep leaves now: " .. b .. " visit, " .. c .. ", " .. d .. ".", "info" end
	a, b, c = string.match(text, "^hosting (.-) at the guest house: (.-), (.*)$")
	if a and b and c then return "Guest house", "Hosting " .. a, a .. " stays at our guest house: " .. b .. " visit, " .. c .. ".", "info" end
	a, b, c = string.match(text, "^HR hired (.-) %((.-), fee (.-)%)$")
	if a and b and c then return "HR", "Welcome " .. a, a .. " joined as " .. b .. " (hiring fee " .. c .. ").", "good" end
	a = string.match(text, "^apprentice (.-) graduated")
	if a then return "HR", a .. " graduated", a .. " finished the apprenticeship: skill 3, full wage.", "good" end
	a = string.match(text, "^moved into the (.*)$")
	if a then return "Company", "Moved into the " .. a, "Welcome to the " .. a .. ". New people start over the next minutes.", "good" end
	a = string.match(text, "^Lab level (%d+)")
	if a then return "Lab", "Lab level " .. a, cap(text) .. ".", "good" end
	if string.find(text, "^Save mode on") then return "Finance", "Save mode on", cap(text) .. ". Research and big purchases pause.", "warn" end
	if string.find(text, "^Save mode off") then return "Finance", "Save mode off", "Normal spending again.", "info" end
	if string.find(text, "^bought the company jet") then return "Company", "Company jet bought", cap(text) .. ".", "good" end
	a = string.match(text, "^founder joined the (.-) meeting")
	if a then return "Sales", "You joined " .. a, cap(text) .. ".", "good" end
	if string.find(text, "^cash recovered") then return "Finance", "Cash recovered", cap(text) .. ".", "good" end
	if string.find(text, "^cash below") then return "Finance", "Cash warning", cap(text) .. ".", "bad" end
	a, b = string.match(text, "^(.-) replaces (.-) %(")
	if a and b then return "Product", a .. " is live", cap(text) .. ".", "good" end
	a, b = string.match(text, "^(.-) launched as (.*)$")
	if a and b then return "Product", a .. " is live", a .. " launched as " .. b .. ".", "good" end
	a, b = string.match(text, "^(.- v%d+): (.*)$")
	if a and b then return "Pricing", a, cap(b) .. ".", "info" end
	local title = if #text &gt; 40 then Ops.clip(text, 38) .. "..." else text
	return "Company", cap(title), cap(text), "info"
end

-- Messages of the replicated company log (newest first; each line keeps its own stamp)
function PhoneMath.newsMessages(deals: any): { Message }
	local out: { Message } = {}
	local news = if typeof(deals) == "table" and typeof(deals.news) == "table" then deals.news else {}
	for i, line in news do
		if typeof(line) ~= "string" then continue end
		local day, hour, text = PhoneMath.parseNews(line)
		local from, title, body, tone = PhoneMath.classify(text)
		table.insert(out, {
			key = "news:" .. line,
			from = from,
			title = title,
			body = body,
			tone = tone,
			day = day,
			hour = hour,
			order = PhoneMath.order(day, hour) - i * 1e-3, -- same minute: the log order (newest first)
			source = "news",
		})
	end
	return out
end

local function roleName(roleId: string): string
	local r = EmpireConfig.find(EmpireConfig.ROLES, roleId)
	return if r then r.name else roleId
end

local function nameList(names: { string }, max: number): string
	local shown = {}
	for i = 1, math.min(#names, max) do shown[i] = names[i] end
	local text = table.concat(shown, ", ")
	if #names &gt; max then text ..= " and " .. (#names - max) .. " more" end
	return text
end

local function profileName(list: any, i: number): string?
	local p = if typeof(list) == "table" then list[i] else nil
	local n = if typeof(p) == "table" then p.n else nil
	return if typeof(n) == "string" and n ~= "" then n else nil
end

-- First names (or "a colleague") of everyone absent today: (sick, vacation, travelling, unpaid leave), each a
-- list of "Name (Role)". Pure function of saved data (CompanyOps.presence: hashes of the appearance seeds).
function PhoneMath.absences(e: any): ({ string }, { string }, { string }, number)
	local sick, vacation, trip = {}, {}, {}
	local leave = 0
	for _, role in EmpireConfig.ROLES do
		local list = if typeof(e.staffProfiles) == "table" then e.staffProfiles[role.id] else nil
		for i, state in Ops.presence(e, role.id) do
			if state == "present" then continue end
			local name = (profileName(list, i) or "A colleague") .. " (" .. role.name .. ")"
			if state == "sick" then table.insert(sick, name)
			elseif state == "vacation" then table.insert(vacation, name)
			elseif state == "trip" then table.insert(trip, name)
			else leave += 1 end
		end
	end
	return sick, vacation, trip, leave
end

local function firstName(entry: string): string
	return string.match(entry, "^(.-) %(") or entry
end

-- "Mia is sick today" (one message per company day; nil when everybody is at work)
function PhoneMath.absenceMessage(e: any): Message?
	local sick, vacation, trip, leave = PhoneMath.absences(e)
	if #sick == 0 and #vacation == 0 and leave == 0 then return nil end
	local day = Ops.day(e)
	local title
	if #sick == 1 then title = firstName(sick[1]) .. " is sick today"
	elseif #sick == 2 then title = firstName(sick[1]) .. " and " .. firstName(sick[2]) .. " are sick today"
	elseif #sick &gt; 2 then title = #sick .. " colleagues are sick today"
	elseif #vacation &gt; 0 then title = #vacation .. (if #vacation == 1 then " colleague is" else " colleagues are") .. " on vacation today"
	else title = leave .. " on unpaid leave today" end
	local parts = {}
	if #sick &gt; 0 then table.insert(parts, "Sick (paid): " .. nameList(sick, 6) .. ".") end
	if #vacation &gt; 0 then table.insert(parts, "Vacation: " .. nameList(vacation, 6) .. ".") end
	if #trip &gt; 0 then table.insert(parts, "Travelling: " .. nameList(trip, 4) .. ".") end
	if leave &gt; 0 then table.insert(parts, leave .. " on unpaid leave until cash recovers.") end
	table.insert(parts, "Their desks are free today; everyone else is at work.")
	return { key = "absence:" .. day, from = "HR", title = title, body = table.concat(parts, " "), tone = if #sick &gt; 0 then "warn" else "info",
		day = day, hour = 8, order = PhoneMath.order(day, 8), source = "event" }
end

local function gpuLabel(id: any): string
	local def = if typeof(id) == "string" then HardwareConfig.getGPU(id) else nil
	return if def then (def :: any).label else "GPU"
end

-- Rack faults that appeared / were fixed between two live.compute.faults lists ({slot, gpu, since}).
-- itOnDuty = live.compute.it (repair takes Ops.FAULT.it s with IT on duty, Ops.FAULT.alone s without).
function PhoneMath.faultEvents(before: { any }?, now: { any }?, itOnDuty: boolean, day: number, hour: number): { Message }
	local out: { Message } = {}
	local function key(f: any): string return tostring(f.slot) .. ":" .. tostring(f.gpu) .. ":" .. tostring(f.since) end
	local old: { [string]: any } = {}
	local beforeList: { any } = before or {}
	local nowList: { any } = now or {}
	for _, f in beforeList do if typeof(f) == "table" then old[key(f)] = f end end
	local new: { [string]: any } = {}
	for _, f in nowList do if typeof(f) == "table" then new[key(f)] = f end end
	local order = PhoneMath.order(day, hour)
	for k, f in new do
		if not old[k] then
			local fix = if itOnDuty then "IT is on it: about " .. Ops.FAULT.it .. " s." else "No IT on duty: it restarts itself in about " .. math.floor(Ops.FAULT.alone / 60) .. " min."
			table.insert(out, { key = "fault:" .. k, from = "IT desk", title = "Rack fault in slot " .. tostring(f.slot),
				body = gpuLabel(f.gpu) .. " in slot " .. tostring(f.slot) .. " is down (" .. Ops.FAULT.units .. " compute unit off line). " .. fix,
				tone = "bad", day = day, hour = hour, order = order, source = "event" })
		end
	end
	for k, f in old do
		if not new[k] then
			table.insert(out, { key = "fixed:" .. k, from = "IT desk", title = "Slot " .. tostring(f.slot) .. " fixed",
				body = gpuLabel(f.gpu) .. " in slot " .. tostring(f.slot) .. " is back online.", tone = "good",
				day = day, hour = hour, order = order + 1e-4, source = "event" })
		end
	end
	table.sort(out, function(x: Message, y: Message): boolean return x.key &lt; y.key end)
	return out
end

-- {[role..":"..seed] = "Name"} of every staff profile
function PhoneMath.staffIndex(e: any): { [string]: string }
	local out: { [string]: string } = {}
	if typeof(e.staffProfiles) ~= "table" then return out end
	for roleId, list in e.staffProfiles do
		if typeof(list) ~= "table" or typeof(roleId) ~= "string" then continue end
		for i, p in list do
			if typeof(p) == "table" and typeof(p.s) == "number" then
				out[roleId .. ":" .. tostring(p.s)] = profileName(list, i) or "A colleague"
			end
		end
	end
	return out
end

-- New hires and leavers between two staffIndex maps. `announced` = names the company log already welcomed
-- ("HR hired Mia ..."): no second message for them.
function PhoneMath.staffEvents(before: { [string]: string }, now: { [string]: string }, announced: { [string]: boolean }, day: number, hour: number): { Message }
	local out: { Message } = {}
	local order = PhoneMath.order(day, hour)
	for k, name in now do
		if before[k] == nil and not announced[name] then
			local roleId = string.match(k, "^(.-):") or ""
			table.insert(out, { key = "hire:" .. k, from = "HR", title = "Welcome " .. name, body = name .. " joined the team as " .. roleName(roleId) .. ".",
				tone = "good", day = day, hour = hour, order = order, source = "event" })
		end
	end
	for k, name in before do
		if now[k] == nil then
			local roleId = string.match(k, "^(.-):") or ""
			table.insert(out, { key = "left:" .. k .. ":" .. day, from = "HR", title = name .. " left", body = name .. " (" .. roleName(roleId) .. ") is no longer with the company.",
				tone = "info", day = day, hour = hour, order = order, source = "event" })
		end
	end
	table.sort(out, function(x: Message, y: Message): boolean return x.key &lt; y.key end)
	return out
end

-- Names the company log welcomed ("HR hired Mia Chen (AI Researcher, fee $1,000)")
function PhoneMath.announcedHires(deals: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	local news = if typeof(deals) == "table" and typeof(deals.news) == "table" then deals.news else {}
	for _, line in news do
		if typeof(line) == "string" then
			local name = string.match(line, "HR hired (.-) %(")
			if name then out[name] = true end
		end
	end
	return out
end

-- "Goal reached" message when EmpireMath.nextGoal moves on (goal = the new goal or nil = all done)
function PhoneMath.goalEvent(before: any, goal: any, day: number, hour: number): Message?
	if typeof(before) ~= "table" or (typeof(goal) == "table" and goal.id == before.id) then return nil end
	local nextText = if typeof(goal) == "table" then " Next goal: " .. tostring(goal.text) .. "." else " Every goal is done."
	return { key = "goal:" .. tostring(before.id), from = "Assistant", title = "Goal reached: " .. tostring(before.text),
		body = "Done: " .. tostring(before.text) .. "." .. nextText, tone = "good", day = day, hour = hour,
		order = PhoneMath.order(day, hour), source = "event" }
end

-- Progress line of a goal: "$12,300 / $27,000 · ~6 min" (money goals) or "1 / 2"
function PhoneMath.goalProgress(goal: any): (string, number)
	if typeof(goal) ~= "table" then return "Every goal is done", 1 end
	local have, need = tonumber(goal.have) or 0, math.max(1, tonumber(goal.need) or 1)
	local text
	if string.find(tostring(goal.id), "^office") or goal.id == "jet" then
		text = Ops.money(math.min(have, need)) .. " / " .. Ops.money(need)
	elseif goal.id == "client" then
		text = "trust " .. math.floor(have) .. " %"
	elseif need &lt;= 1 then
		text = if have &gt;= need then "done" else "not done yet"
	else
		text = math.floor(have) .. " / " .. math.floor(need)
	end
	local eta = tonumber(goal.etaMinutes)
	if eta then text ..= if eta &lt;= 0 then " · ready" else " · ~" .. math.max(1, math.ceil(eta)) .. " min" end
	return text, math.clamp(have / need, 0, 1)
end

-- newest first, at most `max`, one message per key (later lists win)
function PhoneMath.merge(lists: { { Message } }, max: number?): { Message }
	local byKey: { [string]: Message } = {}
	for _, list in lists do for _, m in list do byKey[m.key] = m end end
	local out: { Message } = {}
	for _, m in byKey do table.insert(out, m) end
	table.sort(out, function(a: Message, b: Message): boolean
		if a.order ~= b.order then return a.order &gt; b.order end
		return a.key &lt; b.key
	end)
	local limit = max or PhoneMath.INBOX_MAX
	while #out &gt; limit do table.remove(out) end
	return out
end

function PhoneMath.unread(messages: { Message }, read: { [string]: boolean }): number
	local n = 0
	for _, m in messages do if not read[m.key] then n += 1 end end
	return n
end

------------------------------------------------------------------------------------------------ calendar
export type CalItem = { key: string, title: string, detail: string, day: number, hour: number, order: number, kind: string, now: boolean?, tag: string? }

local WHERE = { city = "Business City", region = "Business City", abroad = "Port Meridian" }

-- Calendar of today and the coming days from the replicated state. clock = workspace:GetServerTimeNow();
-- extra = items of PhoneService.addCalendarItem ({key, title, detail?, at = server clock, kind?});
-- shuttle = {at = server clock of the next departure to Port Meridian, flight = "PM 101", airline}?;
-- hotels = {city = "City Hotel", abroad = "Meridian Grand Hotel"}?. Returns the items (soonest first).
function PhoneMath.calendar(data: any, live: any, clock: number, extra: { any }?, shuttle: any?, hotels: any?): { CalItem }
	local e = data.empire
	local out: { CalItem } = {}
	local today = Ops.day(e)
	local nowOrder = PhoneMath.order(today, Ops.hour(clock))
	local deals = if typeof(e.deals) == "table" then e.deals else {}
	local names: { [string]: any } = {}
	local liveTrips = if typeof(live) == "table" and typeof(live.ops) == "table" and typeof(live.ops.trips) == "table" then live.ops.trips else {}
	for _, t in liveTrips do if typeof(t) == "table" and typeof(t.client) == "string" then names[t.client .. ":" .. tostring(t.back)] = t end end
	local cityHotel = if typeof(hotels) == "table" and typeof(hotels.city) == "string" then hotels.city else "City Hotel"
	local intlHotel = if typeof(hotels) == "table" and typeof(hotels.abroad) == "string" then hotels.abroad else "Meridian Grand Hotel"
	-- trips under way: away now, back at `back`
	for _, trip in (if typeof(deals.tripList) == "table" then deals.tripList else {}) do
		local c = if typeof(trip) == "table" then Ops.client(trip.client) else nil
		if not c then continue end
		local day, hour = PhoneMath.atPlay(e, clock, tonumber(trip.back) or 0)
		local info = names[c.id .. ":" .. tostring(trip.back)]
		local crew = if typeof(info) == "table" then tonumber(info.crew) or 1 else 1
		local title, detail
		if trip.hosted == true then
			title = c.name .. " team at our guest house"
			detail = Ops.HOSTED.guests .. " guests, " .. Ops.HOSTED.nights .. " nights, workshop in the boardroom · leave " .. PhoneMath.when(day, hour, today)
		else
			local who = if trip.founder == true then "You" elseif crew &gt;= 2 then "Field rep + engineer" else "Field rep"
			local what = if trip.kind == "renew" then "check-in visit" else "pilot visit"
			local stay = if c.trip == "abroad" then (if e.jet == true then "company jet, " .. Ops.JET.nights .. " night at the " else "shuttle flight, " .. Ops.TRIPS.abroad.nights .. " nights at the ") .. intlHotel
				elseif c.trip == "region" then Ops.TRIPS.region.nights .. " night at the " .. cityHotel
				else "company car"
			title = who .. ": " .. what .. " at " .. c.name
			detail = WHERE[c.trip] .. " · " .. stay .. " · back " .. PhoneMath.when(day, hour, today)
		end
		table.insert(out, { key = "trip:" .. c.id .. ":" .. tostring(trip.back), title = title, detail = detail, day = day, hour = hour,
			order = PhoneMath.order(day, hour), kind = if c.trip == "abroad" then "flight" else "trip", now = true, tag = if trip.hosted == true then "leave" else "back" })
	end
	-- check-in visits before a contract ends (CompanyOps.step: renewals leave TRIPS.days + RENEW_LEAD_DAYS before)
	local seconds = tonumber(e.seconds) or 0
	for id, acc in (if typeof(deals.accounts) == "table" then deals.accounts else {}) do
		local c = Ops.client(id)
		if not c or typeof(acc) ~= "table" or acc.renewing == true then continue end
		local expires = tonumber(acc.expires) or 0
		local due = expires - (Ops.TRIPS[c.trip].days + Ops.RENEW_LEAD_DAYS) * DAY
		local day, hour = PhoneMath.atPlay(e, clock, due)
		local endDay, endHour = PhoneMath.atPlay(e, clock, expires)
		local overdue = due &lt;= seconds
		table.insert(out, { key = "renew:" .. c.id, title = "Check-in visit: " .. c.name,
			detail = (if overdue then "Due now · waiting for a free seller (trips leave " .. PhoneMath.clock(Ops.DEPART.from) .. "-" .. PhoneMath.clock(Ops.DEPART.to) .. ")" else "Due " .. PhoneMath.when(day, hour, today))
				.. " · contract ends " .. PhoneMath.when(endDay, endHour, today) .. " · " .. Ops.money(c.retainer) .. "/day",
			day = day, hour = hour, order = math.max(nowOrder, PhoneMath.order(day, hour)), kind = "renewal", tag = "due" })
	end
	-- the next shuttle to Port Meridian (public timetable, FlightPlan)
	if typeof(shuttle) == "table" and typeof(shuttle.at) == "number" then
		local day, hour = PhoneMath.atClock(e, clock, shuttle.at)
		table.insert(out, { key = "shuttle:" .. tostring(math.floor(shuttle.at)), title = "Shuttle " .. tostring(shuttle.flight or "") .. " to Port Meridian",
			detail = tostring(shuttle.airline or "Meridian Air") .. " · City Airport gate · departs " .. PhoneMath.when(day, hour, today), day = day, hour = hour,
			order = PhoneMath.order(day, hour), kind = "flight" })
	end
	-- items of other packages (itinerary: flights, hotel, meetings, driver)
	local extraList: { any } = extra or {}
	for _, item in extraList do
		if typeof(item) ~= "table" or typeof(item.title) ~= "string" then continue end
		local day, hour
		if typeof(item.at) == "number" then day, hour = PhoneMath.atClock(e, clock, item.at)
		else day, hour = math.max(1, math.floor(tonumber(item.day) or today)), tonumber(item.hour) or 8 end
		table.insert(out, { key = "item:" .. tostring(item.key), title = item.title, detail = if typeof(item.detail) == "string" then item.detail else PhoneMath.when(day, hour, today),
			day = day, hour = hour, order = PhoneMath.order(day, hour), kind = if typeof(item.kind) == "string" then item.kind else "item" })
	end
	table.sort(out, function(a: CalItem, b: CalItem): boolean
		if (a.now == true) ~= (b.now == true) then return a.now == true end
		if a.order ~= b.order then return a.order &lt; b.order end
		return a.key &lt; b.key
	end)
	return out
end

-- one line about the working day: "Office hours 08:00-18:00 · trips leave 08:00-15:00"
function PhoneMath.dayLine(e: any, clock: number): string
	local hour = Ops.hour(clock)
	local open = Ops.inOffice(clock)
	return (if open then "Office open until 18:00" else "Night · office opens 08:00") .. " · trips leave " .. PhoneMath.clock(Ops.DEPART.from) .. "-" .. PhoneMath.clock(Ops.DEPART.to)
		.. (if open and hour &gt;= Ops.DEPART.to then " (done today)" else "")
end

-- "Today: 2 sick · 1 on vacation · 2 travelling" (nil when everybody is at work and nobody travels)
function PhoneMath.todayLine(e: any, live: any): string?
	local sick, vacation, trip, leave = PhoneMath.absences(e)
	local travelling = if typeof(live) == "table" and typeof(live.ops) == "table" then tonumber(live.ops.travelling) or 0 else 0
	local parts = {}
	if #sick &gt; 0 then table.insert(parts, #sick .. " sick") end
	if #vacation &gt; 0 then table.insert(parts, #vacation .. " on vacation") end
	if leave &gt; 0 then table.insert(parts, leave .. " on leave") end
	if travelling &gt; 0 then table.insert(parts, travelling .. (if travelling == 1 then " trip" else " trips") .. " under way") end
	if #parts == 0 then return nil end
	local _ = trip
	return "Today: " .. table.concat(parts, " · ")
end

------------------------------------------------------------------------------------------------ calls
-- The assistant's call texts (short, real data only). Returned as (title, text).
function PhoneMath.firstClientCall(clientName: string, retainer: number, goal: any): (string, string)
	local nextText = if typeof(goal) == "table" then " Next up: " .. tostring(goal.text) .. "." else ""
	return "First client signed!", "Great news: " .. clientName .. " signed! They pay a pilot fee of " .. Ops.money(retainer * Ops.PILOT_DAYS)
		.. " and " .. Ops.money(retainer) .. " every game day from now on." .. nextText
end

export type TripCall = {
	client: string,
	tier: string, -- "region" | "abroad"
	rep: string?, -- "Mia" (Growth &amp; Sales field rep)
	engineer: string?, -- "Leo" (ML engineer)
	backDay: number,
	backHour: number,
	today: number,
	hotel: string,
	jet: boolean,
	flight: string?, -- "PM 101 at 14:30" (next shuttle) when known
}
function PhoneMath.tripCall(t: TripCall): (string, string)
	local rep = if t.rep then t.rep .. " from Growth &amp; Sales" else "A field rep"
	local eng = if t.engineer then t.engineer .. " from Engineering" else "an engineer"
	local back = PhoneMath.when(t.backDay, t.backHour, t.today)
	if t.tier == "abroad" then
		local how = if t.jet then "fly out on our company jet" elseif t.flight then "fly out on the shuttle " .. t.flight else "fly out on the next shuttle"
		local nights = if t.jet then Ops.JET.nights else Ops.TRIPS.abroad.nights
		return t.client .. " wants to meet", t.client .. " wants to meet in Port Meridian. " .. rep .. " and " .. eng .. " " .. how .. " and stay "
			.. nights .. (if nights == 1 then " night" else " nights") .. " at the " .. t.hotel .. ". They're back " .. (if string.find(back, "Day") then "on " .. back else "at " .. back) .. ". Do you want to join them?"
	end
	return t.client .. " wants to meet", t.client .. " wants a pilot meeting in Business City. " .. rep .. " and " .. eng .. " are driving over now and stay "
		.. Ops.TRIPS.region.nights .. " night at the " .. t.hotel .. ". They're back " .. (if string.find(back, "Day") then "on " .. back else "at " .. back) .. ". Do you want to join them?"
end

function PhoneMath.officeCall(officeName: string, price: number): (string, string)
	return "We can move!", "We have enough cash for the " .. officeName .. " (" .. Ops.money(price) .. ") and a safety reserve. Open Company → Offices when you want to move."
end

------------------------------------------------------------------------------------------------ AI chat
local function statValue(model: any, id: string): number
	local stats = if typeof(model.stats) == "table" then model.stats else {}
	return math.floor(tonumber(stats[id]) or 0)
end

-- best and worst core stat (weight &gt; 0): (bestLabel, bestValue, worstLabel, worstValue)
function PhoneMath.bestWorst(model: any): (string, number, string, number)
	local best, bestV, worst, worstV = "Reasoning", -1, "Reasoning", 1e9
	for _, s in ModelConfig.STATS do
		if s.weight &lt;= 0 then continue end
		local v = statValue(model, s.id)
		if v &gt; bestV then best, bestV = s.label, v end
		if v &lt; worstV then worst, worstV = s.label, v end
	end
	return best, math.max(0, bestV), worst, if worstV == 1e9 then 0 else worstV
end

-- "Nova v2 · 1B · Balanced · Consumer Chat · 63 overall"
function PhoneMath.modelLine(model: any): string
	local size = ModelConfig.getSize(tostring(model.sizeId))
	local focus = ModelConfig.getFocus(tostring(model.focusId))
	local line = ModelConfig.getLine(if typeof(model.release) == "table" then model.release.target else nil)
	return string.format("%s v%d · %s · %s%s · %.0f overall", tostring(model.name), math.floor(tonumber(model.version) or 1), if size then size.label else "?",
		if focus then focus.label else "Balanced", if line then " · " .. line.label else "", tonumber(model.overall) or 0)
end

-- released models of the player: live first, then retired versions; each {id, title, line, live}
function PhoneMath.chatModels(data: any): { any }
	local out = {}
	for _, id in (if typeof(data.modelOrder) == "table" then data.modelOrder else {}) do
		local m = data.models and data.models[id]
		if typeof(m) == "table" and typeof(m.release) == "table" and (m.status == "live" or m.status == "retired") then
			local size = ModelConfig.getSize(tostring(m.sizeId))
			local focus = ModelConfig.getFocus(tostring(m.focusId))
			local line = ModelConfig.getLine(m.release.target)
			table.insert(out, { id = id, title = tostring(m.name) .. " v" .. tostring(m.version), line = PhoneMath.modelLine(m), live = m.status == "live", overall = tonumber(m.overall) or 0,
				sub = (if size then size.label else "?") .. " · " .. (if focus then focus.label else "Balanced") .. (if line then " · " .. line.label else "") })
		end
	end
	table.sort(out, function(a: any, b: any): boolean
		if a.live ~= b.live then return a.live end
		if a.overall ~= b.overall then return a.overall &gt; b.overall end
		return a.id &lt; b.id
	end)
	return out
end

function PhoneMath.chatAllowed(model: any): boolean
	return typeof(model) == "table" and typeof(model.release) == "table" and (model.status == "live" or model.status == "retired")
end

local TONE: { [string]: string } = {
	balanced = "friendly, clear and helpful",
	coding = "concise and technical; you like short code examples",
	reasoning = "calm and careful; you think step by step",
	creative = "playful and imaginative; you enjoy wordplay",
}
local TEMPERATURE: { [string]: number } = { balanced = 0.7, coding = 0.4, reasoning = 0.5, creative = 0.9 }

-- TextGenerator settings of a model: (SystemPrompt, Temperature, TopP, Seed). Built ONLY from the model's real
-- data (name, version, size, focus, product line, overall and core stats, owner company); weak models are
-- told to answer like weak models.
function PhoneMath.systemPrompt(model: any, company: string?): (string, number, number, number)
	local size = ModelConfig.getSize(tostring(model.sizeId))
	local focusId = if TONE[tostring(model.focusId)] then tostring(model.focusId) else "balanced"
	local line = ModelConfig.getLine(if typeof(model.release) == "table" then model.release.target else nil)
	local overall = math.floor(tonumber(model.overall) or 0)
	local stats = {}
	for _, s in ModelConfig.STATS do
		if s.weight &gt; 0 then table.insert(stats, s.label .. " " .. statValue(model, s.id)) end
	end
	local quality
	if overall &lt; 40 then
		quality = "You are a tiny early model. Answer in one or two very simple sentences, often say you are not sure, and you sometimes make small mistakes."
	elseif overall &lt; 60 then
		quality = "You are a decent but limited model. Keep answers short and simple; admit when something is beyond you."
	elseif overall &lt; 80 then
		quality = "You are a capable model. Give clear, correct, short answers."
	else
		quality = "You are an excellent frontier model. Give precise, insightful, short answers."
	end
	local weak = {}
	for _, s in ModelConfig.STATS do
		if s.weight &gt; 0 and statValue(model, s.id) &lt; 40 then table.insert(weak, string.lower(s.label)) end
	end
	local owner = if company and company ~= "" then company else "a young AI startup"
	local prompt = string.format(
		"You are %s v%d, an AI model made by %s in the Roblox game AI Empire. Size %s, focus %s%s. Overall score %d of 100; %s. %s%s Your tone is %s. "
			.. "Stay in character as this model, keep every reply under 80 words, never claim to be a real-world product or company, and keep everything friendly and suitable for all ages.",
		tostring(model.name), math.floor(tonumber(model.version) or 1), owner, if size then size.label else "unknown", focusId,
		if line then ", released as " .. line.label else "", overall, table.concat(stats, ", "), quality,
		if #weak &gt; 0 then " You are weak at " .. table.concat(weak, ", ") .. ": keep those answers basic." else "", TONE[focusId])
	local seed = EmployeeConfig.hash(PhoneMath.textHash(tostring(model.id))) % 2147483647
	return prompt, TEMPERATURE[focusId], 0.9, seed
end

-- small deterministic string hash (FNV-1a style, 32 bit)
function PhoneMath.textHash(s: string): number
	local h = 2166136261
	for i = 1, #s do
		h = bit32.bxor(h, string.byte(s, i))
		h = (h * 16777619) % 4294967296
	end
	return h
end

local function tier(v: number): number
	return if v &gt;= 70 then 3 elseif v &gt;= 45 then 2 else 1
end

-- what a chat message asks for (lower-case keyword match)
function PhoneMath.intent(text: string): string
	local t = " " .. string.lower(text) .. " "
	local function has(...: string): boolean
		for _, w in { ... } do if string.find(t, w, 1, true) then return true end end
		return false
	end
	if string.match(t, "%d+%.?%d*%s*[%+%-%*x/]%s*%d+") or has("calculate", "math", "sum of", "plus", "minus", "times") then return "math" end
	if has("code", "script", "python", "lua", "function", "program", "bug") then return "code" end
	if has("joke", "funny", "laugh") then return "joke" end
	if has("poem", "story", "rhyme", "song", "haiku") then return "story" end
	if has("who are you", "what are you", "your name", "about you", "yourself", "introduce") then return "who" end
	if has("thank", "thx", "great job", "nice") then return "thanks" end
	if has(" hi ", " hey", "hello", "good morning", "hallo", " yo ") then return "greet" end
	if has("what", "why", "how", "explain", "when", "where", "?") then return "fact" end
	return "other"
end

local function pick(list: { string }, seed: number): string
	return list[(seed % #list) + 1]
end

local function numberText(n: number): string
	if math.abs(n - math.round(n)) &lt; 1e-9 then return tostring(math.round(n)) end
	return string.format("%.2f", n)
end

-- first "a op b" of a text: (a, op, b, result) or nil
function PhoneMath.sum(text: string): (number?, string?, number?, number?)
	local a, op, b = string.match(string.lower(text), "(%-?%d+%.?%d*)%s*([%+%-%*x/])%s*(%-?%d+%.?%d*)")
	local x, y = tonumber(a), tonumber(b)
	if not (x and y and op) then return nil, nil, nil, nil end
	local r
	if op == "+" then r = x + y elseif op == "-" then r = x - y elseif op == "*" or op == "x" then r = x * y
	elseif y ~= 0 then r = x / y else return nil, nil, nil, nil end
	return x, op, y, r
end

-- Offline demo reply (always shown with the label PhoneMath.DEMO_LABEL): authored templates filled with the
-- model's REAL stats; deterministic for (model, text, turn). Better stats -&gt; better answers.
function PhoneMath.demoReply(model: any, company: string?, text: string, turn: number): string
	local name = tostring(model.name)
	local version = math.floor(tonumber(model.version) or 1)
	local owner = if company and company ~= "" then company else "my company"
	local size = ModelConfig.getSize(tostring(model.sizeId))
	local focus = ModelConfig.getFocus(tostring(model.focusId))
	local overall = math.floor(tonumber(model.overall) or 0)
	local best, bestV, worst, worstV = PhoneMath.bestWorst(model)
	local seed = EmployeeConfig.hash(PhoneMath.textHash(tostring(model.id) .. "|" .. string.lower(text)) + turn * 7919)
	local general = tier(overall)
	local kind = PhoneMath.intent(text)
	local function low(s: string): string return if general == 1 then string.lower(s) else s end
	if kind == "greet" then
		return low(pick(if general == 3 then {
			"Hello! I'm " .. name .. " v" .. version .. " from " .. owner .. ". Ask me anything - I'm strongest at " .. string.lower(best) .. ".",
			"Hi there! " .. name .. " here, ready to help. What are we working on today?",
		} elseif general == 2 then {
			"Hi! I'm " .. name .. ". What can I do for you?",
			"Hello! " .. name .. " v" .. version .. " here. How can I help?",
		} else {
			"Hi. I am " .. name .. ". I am a small model, still learning.",
			"Hello... I am " .. name .. ". I try my best.",
		}, seed))
	elseif kind == "who" then
		return low(string.format("I'm %s v%d, a %s %s model made by %s. My overall score is %d: best at %s (%d), weakest at %s (%d).",
			name, version, if size then size.label else "small", string.lower(if focus then focus.label else "balanced"), owner, overall, string.lower(best), bestV, string.lower(worst), worstV))
	elseif kind == "math" then
		local m = statValue(model, "math")
		local a, op, b, r = PhoneMath.sum(text)
		if a and op and b and r then
			local shown = (if op == "x" then "*" else op)
			if tier(m) == 3 then return numberText(a) .. " " .. shown .. " " .. numberText(b) .. " = " .. numberText(r) .. "." end
			if tier(m) == 2 then return "That should be " .. numberText(r) .. ". (Math " .. m .. ": I'd double-check bigger sums.)" end
			local off = (seed % 3) + 1
			return "Hmm... " .. numberText(a) .. " " .. shown .. " " .. numberText(b) .. " is " .. numberText(r + (if seed % 2 == 0 then off else -off)) .. "? My math score is only " .. m .. ", please check it."
		end
		return pick(if tier(m) == 3 then { "Give me the numbers and I'll work it out step by step.", "Sure - write the sum like 12 * 7 and I'll solve it." }
			else { "Math is hard for me (math " .. m .. "). Try a small sum like 3 + 4." }, seed)
	elseif kind == "code" then
		local c = statValue(model, "coding")
		if tier(c) == 3 then
			return pick({
				"Here's a clean Luau example:\nlocal function add(a, b)\n  return a + b\nend\nprint(add(2, 3)) -- 5",
				"Sure. Loop over a list in Luau:\nfor i, item in items do\n  print(i, item)\nend",
			}, seed)
		elseif tier(c) == 2 then
			return "Something like this should work:\nprint(\"Hello from " .. name .. "\")\nI can do simple scripts (coding " .. c .. ")."
		end
		return "code... maybe print(\"hello\")? sorry, coding is not my strength yet (coding " .. c .. ")."
	elseif kind == "story" then
		local cr = statValue(model, "creativity")
		if tier(cr) == 3 then
			return pick({
				"Servers hum beneath the moon,\na garage dream becomes a tower soon.\nEvery line of data, every spark -\n" .. owner .. " lights up the dark.",
				"Once, in a tiny garage, a model woke up and asked: \"What is a customer?\" A week later it had a thousand of them - and still no idea what lunch was.",
			}, seed)
		elseif tier(cr) == 2 then
			return "Here's a short one: A little model trained all night, and by morning it could finally say hello. The end!"
		end
		return "once there was a robot. it was nice. the end. (creativity " .. cr .. ")"
	elseif kind == "joke" then
		local cr = statValue(model, "creativity")
		if tier(cr) &gt;= 2 then
			return pick({
				"Why did the neural network go to therapy? It had too many unresolved layers.",
				"I tried to tell a joke about overfitting - but it only worked on my training data.",
				"Why was the GPU so calm? It knew how to keep its cool(ing).",
			}, seed)
		end
		return "a joke... robot walks into a bar. ouch. (creativity " .. cr .. ")"
	elseif kind == "thanks" then
		return low(pick({ "You're welcome!", "Happy to help. That's what " .. owner .. " built me for." }, seed))
	elseif kind == "fact" then
		local k = math.max(statValue(model, "knowledge"), statValue(model, "reasoning"))
		if tier(k) == 3 then
			return "Good question. In demo mode I can't look things up, so here's my approach: break it into parts, check what we know, then test the simplest explanation first."
		elseif tier(k) == 2 then
			return "I'm not completely sure. In demo mode I only have prepared answers - ask me about myself, a joke, a poem, code or a quick sum."
		end
		return "i don't know that yet. maybe my next version will. (knowledge " .. statValue(model, "knowledge") .. ")"
	end
	local r = statValue(model, "reliability")
	if tier(r) &gt;= 2 then
		return "I'm running in demo mode right now, so my answers come from a small set of prepared replies. Try: \"who are you\", \"tell me a joke\", \"write a poem\" or \"12 * 7\"."
	end
	return "...sorry, i did not understand. (demo mode)"
end

return PhoneMath
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000012"><Properties><string name="Name">PricingMath</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Release forecast, "Recommended" price and auto-price (CORE_SPEC 7.7). Pure functions, no services: the
-- server (AIModelService.releaseModel, PricingService) and the client (LabApp, MarketApp) run the same code on
-- the same inputs, so the Lab shows what the server will pick. The market itself is MarketMath.tick; this
-- module only plays it forward on copies (exactly like the economy simulator's portfolioProfit):
--   profit of the WHOLE own portfolio over `seconds`, with the candidate live in its product line (it replaces
--   the line's live model), against the rivals as MarketService passes them, at the company's stage, serving
--   capacity and reach cap, valued with the company's revenue and serving multipliers.
-- Deterministic: menus are scanned in a fixed order, the first best price wins, inputs are ordered lists.

local Shared = script.Parent
local Config = Shared.Config
local MarketConfig = require(Config.MarketConfig)
local ModelConfig = require(Config.ModelConfig)
local MarketMath = require(Shared.MarketMath)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local Types = require(Shared.Types)

type ModelData = Types.ModelData
type PlayerData = Types.PlayerData
type MarketState = Types.MarketState
type LiveModelResult = Types.LiveModelResult

-- One product as MarketMath.tick sees it (MarketMath.LiveEntry + the release target; rivals also carry
-- `player` and `company` like MarketService.entry).
export type Entry = {
	id: string,
	stats: Types.Stats,
	sizeId: string,
	subPrice: number,
	apiPrice: number,
	market: any,
	target: string?,
	player: boolean?,
	company: any?,
}

export type Context = {
	own: { Entry }, -- every live model of the company (real market states; copied before each run)
	rivals: { Entry }, -- NPC labs and other companies (never mutated)
	npcModels: any?, -- as MarketService: {} while NPC labs run as sessions, nil = static MarketConfig.NPC_MODELS
	reputation: number,
	spec: string,
	opts: any, -- MarketMath.tick opts: stage, capacity, reachCap
	revenueMult: number,
	servingMult: number,
}

export type Choice = { sub: number, api: number, profit: number }

-- What a forecast needs to know about the priced model (a ModelData fits).
export type Product = { id: string, stats: Types.Stats, sizeId: string }

local PricingMath = {}

-- CompanyOps (econ package) provides serving capacity and the reach cap. Looked up lazily so this module also
-- loads in a tree without it (then the market runs uncapped, as MarketService does without it).
local opsModule: any = nil
local function companyOps(): any
	if opsModule == nil then
		local found = Shared:FindFirstChild("CompanyOps")
		if found and found:IsA("ModuleScript") then
			local ok, result = pcall(require, found)
			opsModule = if ok then result else false
		else
			return nil -- not there (yet): look again next time
		end
	end
	return if opsModule then opsModule else nil
end

local function emptyMarket(age: number?, vage: number?): any
	return { age = age or 0, vage = vage, users = {}, organic = {}, hype = {}, revenueTotal = 0, peakUsers = 0 }
end

function PricingMath.cloneMarket(m: any): any
	if typeof(m) ~= "table" then
		return emptyMarket(0, 0)
	end
	return {
		age = tonumber(m.age) or 0,
		vage = m.vage,
		users = if typeof(m.users) == "table" then table.clone(m.users) else {},
		organic = if typeof(m.organic) == "table" then table.clone(m.organic) else {},
		hype = if typeof(m.hype) == "table" then table.clone(m.hype) else {},
		revenueTotal = 0,
		peakUsers = 0,
	}
end

-- Entry of a live model (its real market state unless `market` is given).
function PricingMath.entry(model: ModelData, market: any?): Entry
	local release = model.release
	return {
		id = model.id,
		stats = model.stats,
		sizeId = model.sizeId,
		subPrice = if release then release.subPrice else 0,
		apiPrice = if release then release.apiPrice else MarketConfig.API_PRICE.default,
		market = market or model.market,
		target = if release then release.target else nil,
	}
end

-- Rival entry from a live model of another session (server side), flagged like MarketService.entry.
function PricingMath.rivalEntry(model: ModelData, isNPC: boolean, company: any): Entry
	local release = model.release
	local market: any = model.market
	return {
		id = model.id,
		stats = model.stats,
		sizeId = model.sizeId,
		subPrice = if release then release.subPrice else 0,
		apiPrice = if release then release.apiPrice else MarketConfig.API_PRICE.default,
		-- only the version age is read from a rival's market; a light copy keeps the real state untouched
		market = emptyMarket(if market then market.age else 0, if market then market.vage else nil),
		target = if release then release.target else nil,
		player = not isNPC,
		company = company,
	}
end

-- Canonical rival order: (company id, model id). Server and client sort the same way (floating-point sums of
-- the market depend on the order), so both pick the same price.
function PricingMath.sortRivals(list: { Entry })
	table.sort(list, function(a: Entry, b: Entry): boolean
		local ca, cb = tonumber(a.company) or 0, tonumber(b.company) or 0
		if ca ~= cb then
			return ca &lt; cb
		end
		return a.id &lt; b.id
	end)
end

-- Rival entries from the replicated marketplace offers (client side). Offers carry target/npc/vage once the
-- econ package adds them (design/requests/models.md 1); before that NPC = negative provider id.
function PricingMath.rivalsFromOffers(offers: any, own: { [string]: any }): { Entry }
	local list: { Entry } = {}
	if typeof(offers) ~= "table" then
		return list
	end
	for _, offer in offers do
		if typeof(offer) == "table" and typeof(offer.id) == "string" and own[offer.id] == nil and typeof(offer.stats) == "table" then
			local provider = tonumber(offer.providerId) or 0
			local npc = if typeof(offer.npc) == "boolean" then offer.npc else provider &lt; 0
			table.insert(list, {
				id = offer.id,
				stats = offer.stats,
				sizeId = if typeof(offer.sizeId) == "string" then offer.sizeId else "s500m",
				subPrice = tonumber(offer.sub) or 0,
				apiPrice = tonumber(offer.api) or MarketConfig.API_PRICE.default,
				market = emptyMarket(0, tonumber(offer.vage)),
				target = if typeof(offer.target) == "string" then offer.target else nil,
				player = not npc,
				company = provider,
			})
		end
	end
	PricingMath.sortRivals(list)
	return list
end

-- The forecast context of a company. `rivals` from PricingService.rivals (server) or rivalsFromOffers (client).
function PricingMath.context(data: PlayerData, rivals: { Entry }, npcModels: any?): Context
	local e = data.empire
	local company = data.company
	local bonuses = EmpireMath.bonuses(e)
	-- exactly the opts MarketService.tick passes (stage clamped to the stage table, reach cap fallback REACH.max)
	local stageReach = (MarketConfig :: any).STAGE_REACH
	local stages = if typeof(stageReach) == "table" and #stageReach &gt; 0 then #stageReach else 1
	local stage = math.clamp(math.floor(tonumber(e.office) or 1), 1, stages)
	local opts: any = { stage = stage }
	local ops = companyOps()
	if ops and typeof(ops.capacity) == "function" and typeof(ops.reachCap) == "function" then
		opts.capacity = ops.capacity(data)
		opts.reachCap = ops.reachCap(data, (if typeof(stageReach) == "table" then stageReach[stage] else nil) or MarketConfig.REACH.max)
	end
	-- own markets are copied: a context is a snapshot, so a forecast that runs over several frames depends only
	-- on the state when it started
	local own: { Entry } = {}
	for _, id in data.modelOrder do
		local model = data.models[id]
		if model and model.status == "live" and model.release and model.market then
			table.insert(own, PricingMath.entry(model, PricingMath.cloneMarket(model.market)))
		end
	end
	return {
		own = own,
		rivals = rivals,
		npcModels = npcModels,
		reputation = if company then company.reputation else 0,
		spec = if company then company.spec else "general",
		opts = opts,
		revenueMult = tonumber(bonuses.revenue) or 1,
		servingMult = tonumber(bonuses.serving) or 1,
	}
end

-- Market state of a model at release: launch hype from marketing, version age 0 and, when the line already
-- has a live model, the predecessor's users x ModelConfig.MIGRATE per segment plus its word of mouth
-- (CORE_SPEC 7.2). AIModelService.releaseModel uses exactly this, and so does the forecast.
function PricingMath.releaseMarket(target: string, marketing: number, replaced: { ModelData }): MarketState
	local market: any = MarketMath.newMarketState(target, marketing)
	market.vage = 0
	for _, old in replaced do
		local om: any = old.market
		if typeof(om) == "table" then
			if typeof(om.users) == "table" then
				for segment, n in om.users do
					if typeof(n) == "number" and n == n and n &gt; 0 and n &lt; math.huge then
						market.users[segment] = (market.users[segment] or 0) + n * ModelConfig.MIGRATE
					end
				end
			end
			if typeof(om.organic) == "table" then
				for segment, o in om.organic do
					if typeof(o) == "number" and o == o and o &gt; 0 and o &lt; math.huge then
						market.organic[segment] = (market.organic[segment] or 0) + o
					end
				end
			end
		end
	end
	return market
end

-- A forecast in progress (one candidate, one price): the market list, the steps done and the profit so far.
-- PricingService advances runs a few market ticks per frame; PricingMath.profit runs one to the end.
export type Run = {
	ctx: Context,
	list: { Entry },
	candidateId: string,
	steps: number, -- market ticks in total
	done: number, -- market ticks done
	total: number, -- profit so far ($)
	last: any, -- last MarketMath.tick result
}

-- Starts a forecast: the candidate replaces its own entry and every live model of its line; the other own lines
-- run on copies of their (snapshot) market states. candidate.market is advanced in place.
function PricingMath.newRun(ctx: Context, candidate: Entry, seconds: number): Run
	local line = ModelMath.lineOf(candidate.target)
	local list: { Entry } = { candidate }
	for _, entry in ctx.own do
		if entry.id ~= candidate.id and ModelMath.lineOf(entry.target) ~= line then
			table.insert(list, {
				id = entry.id,
				stats = entry.stats,
				sizeId = entry.sizeId,
				subPrice = entry.subPrice,
				apiPrice = entry.apiPrice,
				market = PricingMath.cloneMarket(entry.market),
				target = entry.target,
			})
		end
	end
	return {
		ctx = ctx,
		list = list,
		candidateId = candidate.id,
		steps = math.max(1, math.floor(seconds / ModelConfig.PRICING.step)),
		done = 0,
		total = 0,
		last = nil,
	}
end

-- Advances a run by at most `maxTicks` market ticks of PRICING.step seconds. Returns true when it is finished.
function PricingMath.stepRun(run: Run, maxTicks: number): boolean
	local ctx = run.ctx
	local step = ModelConfig.PRICING.step
	local tick: any = MarketMath.tick -- 7th argument (opts) exists in the CORE_SPEC market tick
	local stop = math.min(run.steps, run.done + math.max(1, math.floor(maxTicks)))
	while run.done &lt; stop do
		local last = tick(run.list, ctx.reputation, ctx.spec, step, ctx.rivals, ctx.npcModels, ctx.opts)
		run.total += (last.revenue * ctx.revenueMult - last.cost * ctx.servingMult) * step
		run.last = last
		run.done += 1
	end
	return run.done &gt;= run.steps
end

-- Total profit ($) of the own portfolio over the run, the candidate's result in the last step (per second) and
-- the last full MarketMath result (capacity, load, waitlist ...).
function PricingMath.runResult(run: Run): (number, LiveModelResult, any)
	local last = run.last
	local mine: LiveModelResult = (last and last.perModel[run.candidateId]) or { users = 0, revenue = 0, cost = 0 }
	return run.total, mine, last
end

-- Plays the market forward: total profit ($) of the own portfolio over `seconds` with `candidate` live, the
-- candidate's result in the last step (per second) and the last full MarketMath result (capacity, waitlist ...).
-- pause (optional) runs after every market tick (use PricingMath.slicer to yield only when a frame budget is
-- used up). The result does not depend on where the forecast pauses.
function PricingMath.profit(ctx: Context, candidate: Entry, seconds: number, pause: (() -&gt; ())?): (number, LiveModelResult, any)
	local run = PricingMath.newRun(ctx, candidate, seconds)
	while not PricingMath.stepRun(run, 1) do
		if pause then
			pause()
		end
	end
	return PricingMath.runResult(run)
end

-- A pause function for long forecasts: calls `yield` (e.g. task.wait) whenever `budget` seconds of CPU time
-- have passed since the last yield, so one frame never spends more than about `budget` on the forecast.
function PricingMath.slicer(budget: number, yield: () -&gt; ()): () -&gt; ()
	local start = os.clock()
	return function()
		if os.clock() - start &gt;= budget then
			yield()
			start = os.clock()
		end
	end
end

-- The price menu in scan order (subs outer, apis inner): ties keep the earlier entry.
PricingMath.MENU = {} :: { { sub: number, api: number } }
for _, sub in ModelConfig.PRICING.subs do
	for _, api in ModelConfig.PRICING.apis do
		table.insert(PricingMath.MENU, { sub = sub, api = api })
	end
end

-- The candidate entry of `model` at one menu price, live in line `target`, on a copy of `market`.
function PricingMath.candidate(model: Product, target: string, market: any, sub: number, api: number): Entry
	return {
		id = model.id,
		stats = model.stats,
		sizeId = model.sizeId,
		subPrice = sub,
		apiPrice = api,
		market = PricingMath.cloneMarket(market),
		target = target,
	}
end

-- Forecast value of one menu price for `model` live in line `target`, starting from a copy of `market`.
function PricingMath.tryPrice(ctx: Context, model: Product, target: string, market: any, sub: number, api: number, seconds: number, pause: (() -&gt; ())?): number
	return (PricingMath.profit(ctx, PricingMath.candidate(model, target, market, sub, api), seconds, pause))
end

-- Best price on the menu for `model` live in line `target`, starting from `market` (copied for every try), over
-- `seconds`. Ties keep the first price in menu order. `pause` (optional) runs after every market tick: the
-- server and the client pass a PricingMath.slicer to spread the work over frames.
function PricingMath.best(ctx: Context, model: Product, target: string, market: any, seconds: number, pause: (() -&gt; ())?): Choice
	local best: Choice = { sub = PricingMath.MENU[1].sub, api = PricingMath.MENU[1].api, profit = -math.huge }
	for _, price in PricingMath.MENU do
		local value = PricingMath.tryPrice(ctx, model, target, market, price.sub, price.api, seconds, pause)
		if value &gt; best.profit then
			best = { sub = price.sub, api = price.api, profit = value }
		end
	end
	return best
end

-- Recommended release price (CORE_SPEC 7.7): best menu price over PRICING.releaseHorizon for the release
-- market (`marketing` already chosen), the line's predecessor migrated.
function PricingMath.recommend(ctx: Context, data: PlayerData, model: ModelData, target: string, marketing: number, pause: (() -&gt; ())?): Choice
	local check = ModelMath.releaseCheck(data, model.id, target)
	local market = PricingMath.releaseMarket(target, marketing, check.replaced)
	return PricingMath.best(ctx, model, target, market, ModelConfig.PRICING.releaseHorizon, pause)
end

-- Marketing the Recommended release pre-selects: up to PRICING.marketingMax of the cash above a reserve of
-- two minutes of payroll (at least $1,500), in MARKETING steps (the simulator's casual release rule).
function PricingMath.recommendedMarketing(money: number, wagePerSecond: number): number
	local step = MarketConfig.MARKETING.step
	local reserve = math.max(1500, wagePerSecond * 120)
	local free = math.max(0, money - reserve)
	return math.max(0, math.min(ModelConfig.PRICING.marketingMax, math.floor(free / step) * step))
end

-- The price that matters for a line: subscription for Consumer Chat / Study App, API for the API lines.
function PricingMath.lineUsesSub(target: string?): boolean
	local line = ModelMath.lineOf(target)
	for _, segment in MarketConfig.SEGMENTS do
		if segment.id == line then
			return segment.priceKind == "sub"
		end
	end
	return true
end

local function priceText(isSub: boolean, value: number): string
	if isSub then
		return if value == 0 then "free" else "$" .. tostring(value)
	end
	return string.format("$%s per 1M tokens", if value % 1 == 0 then tostring(value) else string.format("%.2f", value))
end

-- One-line reason for an automatic price change, e.g. "Servers 97 % full → Consumer Chat price raised to $10".
-- load/capacity from the last market tick (nil when unknown).
function PricingMath.explain(target: string?, oldSub: number, oldApi: number, newSub: number, newApi: number, load: number?, capacity: number?): string
	local line = ModelConfig.getLine(target)
	local name = if line then line.label else "Model"
	local isSub = PricingMath.lineUsesSub(target)
	local old, new = if isSub then oldSub else oldApi, if isSub then newSub else newApi
	if old == new then
		-- only the secondary price moved (e.g. the API price of the chat app)
		isSub = not isSub
		old, new = if isSub then oldSub else oldApi, if isSub then newSub else newApi
	end
	local full = if load and capacity and capacity &gt; 0 and load &lt; math.huge then load / capacity else nil
	if new &gt; old then
		if full and full &gt;= 0.9 then
			return string.format("Servers %d %% full → %s price raised to %s", math.floor(math.min(full, 9.99) * 100 + 0.5), name, priceText(isSub, new))
		end
		return string.format("%s price raised to %s: the forecast earns more at this price", name, priceText(isSub, new))
	end
	return string.format("%s price lowered to %s to win more users", name, priceText(isSub, new))
end

return PricingMath
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000013"><Properties><string name="Name">StatePatch</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Delta encoding for State snapshots (server SessionService -&gt; client StateController).
--
-- The server keeps, per player, a private copy ("shadow") of what it last sent. diff() walks the
-- current state against that shadow, returns only what changed (down to single numbers) and brings
-- the shadow up to date in the same pass. The client applies the patch copy-on-write onto its last
-- state, so StateController.snapshot is always a complete snapshot and no UI code has to know.
-- Why a leaf diff and not per-field signatures: measured on a mature save, the heavy fields
-- (data.models, data.empire.projects, live.marketplace, live.studio) all change every second
-- (user counts, visitors, revenue totals), so whole-field omission would save almost nothing.
--
-- Patch node (only string keys, so it survives Roblox remote serialisation unchanged):
--   s = { [key] = value }   set: scalars or whole new subtrees
--   p = { [key] = Patch }   nested changes
--   d = { key, ... }        deleted keys (dictionaries only)
--   n = number              arrays only: the new length; keys in s/p are tostring(index)

local StatePatch = {}

export type Patch = {
	s: { [string]: any }?,
	p: { [string]: Patch }?,
	d: { string }?,
	n: number?,
}

-- Optional "lazy" spec for diff(): a tree mirroring the state; `true` marks a key whose value is not
-- compared on this pass (the caller runs a pass without the spec now and then to catch up).
-- "*" matches any key (array index or dictionary key).
export type Lazy = { [string]: any }

-- An array whose changed values exceed this share of all its values is sent whole: logs that shift
-- (empire.history, invoices, sorted offer lists after an insert) change every element, where
-- per-index entries would only add key overhead. Arrays where only a few fields per element change
-- (user counts in live.marketplace.offers) stay per-index patches.
StatePatch.WHOLE_ARRAY_SHARE = 0.5

-- Deep copy; also returns the number of scalar values copied
local function copyCount(value: any): (any, number)
	if type(value) ~= "table" then
		return value, 1
	end
	local out = {}
	local count = 0
	for k, v in value do
		local c, n = copyCount(v)
		out[k] = c
		count += n
	end
	return out, math.max(1, count)
end

function StatePatch.copy(value: any): any
	return (copyCount(value))
end

local function keyOf(key: any): string
	return if type(key) == "string" then key else tostring(key)
end

local function addSet(node: Patch?, key: string, value: any): Patch
	local patch: Patch = node or {}
	local s: { [string]: any } = patch.s or {}
	patch.s = s
	s[key] = value
	return patch
end

local function addNested(node: Patch?, key: string, sub: Patch): Patch
	local patch: Patch = node or {}
	local p: { [string]: Patch } = patch.p or {}
	patch.p = p
	p[key] = sub
	return patch
end

local diffTable: (shadow: { [any]: any }, cur: { [any]: any }, lazy: Lazy?) -&gt; (Patch?, boolean, number, number)

-- One child (value is a table). Returns: nil (unchanged) | true + value (set whole) | false + sub-patch,
-- plus changed / total scalar counts. Updates shadow[key].
local function tableChild(shadow: { [any]: any }, key: any, value: { [any]: any }, lazy: any): (boolean?, any, number, number)
	local old = shadow[key]
	-- same kind (array / dictionary; an empty table counts as a dictionary): diff in place
	if type(old) == "table" and (#old &gt; 0) == (#value &gt; 0) then
		local spec: Lazy? = if type(lazy) == "table" then lazy else nil
		local sub, whole, changed, total = diffTable(old, value, spec) -- old now mirrors value (except lazy keys)
		if not sub then
			return nil, nil, 0, total
		end
		if whole then
			if spec then
				shadow[key] = copyCount(value) -- the shadow must equal what was sent, lazy keys included
			end
			return true, value, changed, total
		end
		return false, sub, changed, total
	end
	local copied, count = copyCount(value)
	shadow[key] = copied
	return true, value, count, count
end

-- Returns the patch (nil = unchanged), whether the table should rather be sent whole, and the number
-- of changed / total scalar values.
diffTable = function(shadow: { [any]: any }, cur: { [any]: any }, lazy: Lazy?): (Patch?, boolean, number, number)
	local node: Patch? = nil
	local changedValues, totalValues = 0, 0
	local n = #cur
	if n &gt; 0 then
		local childLazy = if lazy then lazy["*"] else nil
		if childLazy == true then
			return nil, false, 0, n -- the whole array is lazy
		end
		local oldN = #shadow
		for i = 1, n do
			local value = cur[i]
			if type(value) == "table" then
				local whole, payload, changed, total = tableChild(shadow, i, value, childLazy)
				changedValues += changed
				totalValues += total
				if whole then
					node = addSet(node, tostring(i), payload)
				elseif whole == false then
					node = addNested(node, tostring(i), payload)
				end
			else
				totalValues += 1
				local old = shadow[i]
				if old ~= value and (old == old or value == value) then -- NaN -&gt; NaN counts as unchanged
					shadow[i] = value
					changedValues += 1
					node = addSet(node, tostring(i), value)
				end
			end
		end
		local i = n + 1
		while shadow[i] ~= nil do
			shadow[i] = nil
			i += 1
		end
		if not node and oldN == n then
			return nil, false, 0, totalValues
		end
		local patch: Patch = node or {}
		patch.n = n
		return patch, changedValues &gt; totalValues * StatePatch.WHOLE_ARRAY_SHARE, changedValues, totalValues
	end
	local any = if lazy then lazy["*"] else nil
	for key, value in cur do
		local childLazy = if lazy then (lazy[key] or any) else nil
		if childLazy == true then
			totalValues += 1
		elseif type(value) == "table" then
			local whole, payload, changed, total = tableChild(shadow, key, value, childLazy)
			changedValues += changed
			totalValues += total
			if whole then
				node = addSet(node, keyOf(key), payload)
			elseif whole == false then
				node = addNested(node, keyOf(key), payload)
			end
		else
			totalValues += 1
			local old = shadow[key]
			if old ~= value and (old == old or value == value) then
				shadow[key] = value
				changedValues += 1
				node = addSet(node, keyOf(key), value)
			end
		end
	end
	for key in shadow do
		if cur[key] == nil then
			shadow[key] = nil
			local patch: Patch = node or {}
			node = patch
			local d = patch.d or {}
			patch.d = d
			table.insert(d, keyOf(key))
		end
	end
	return node, false, changedValues, totalValues
end

-- Compares cur with shadow (both dictionaries), updates shadow to mirror cur and returns what changed
-- (nil when nothing did). Values in the patch may be references into cur: serialise right away.
-- lazy (optional): keys skipped on this pass (see Lazy); they keep their last sent value meanwhile.
function StatePatch.diff(shadow: { [any]: any }, cur: { [any]: any }, lazy: Lazy?): Patch?
	local patch, whole = diffTable(shadow, cur, lazy)
	if patch and whole then -- only possible when the root itself is an array
		local s: { [string]: any } = {}
		for k, v in cur do
			s[keyOf(k)] = v
		end
		for k in shadow do
			shadow[k] = nil
		end
		for k, v in cur do
			shadow[k] = StatePatch.copy(v)
		end
		return { s = s, n = #cur }
	end
	return patch
end

-- Returns a new table = old with the patch applied. old is never modified; unchanged subtrees are
-- shared with it.
function StatePatch.apply(old: any, patch: Patch): { [any]: any }
	local out: { [any]: any } = if type(old) == "table" then table.clone(old) else {}
	local arrayMode = patch.n ~= nil
	local s = patch.s
	if s then
		for k, v in s do
			out[if arrayMode then (tonumber(k) or k) else k] = v
		end
	end
	local p = patch.p
	if p then
		for k, sub in p do
			local key: any = if arrayMode then (tonumber(k) or k) else k
			out[key] = StatePatch.apply(out[key], sub)
		end
	end
	local d = patch.d
	if d then
		for _, k in d do
			out[k] = nil
		end
	end
	local n = patch.n
	if n then
		local i = n + 1
		while out[i] ~= nil do
			out[i] = nil
			i += 1
		end
	end
	return out
end

return StatePatch
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000015"><Properties><string name="Name">ServerScriptService</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000035"><Properties><string name="Name">Server</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">Lib</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Guard</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Eingabeprüfung für alles, was vom Client kommt. Grundsatz: nichts glauben, alles prüfen.
-- Jede Funktion gibt den bereinigten Wert oder nil zurück.

local Guard = {}

function Guard.finite(value: any): number?
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return value
end

function Guard.number(value: any, min: number, max: number): number?
	local n = Guard.finite(value)
	if n == nil or n &lt; min or n &gt; max then
		return nil
	end
	return n
end

function Guard.integer(value: any, min: number, max: number): number?
	local n = Guard.number(value, min, max)
	if n == nil or n % 1 ~= 0 then
		return nil
	end
	return n
end

-- auf ein Raster runden (Slider-Werte) und Floating-Point-Reste abschneiden
function Guard.snap(value: number, step: number): number
	return math.round(math.round(value / step) * step * 100) / 100
end

-- kurze technische IDs (Config-IDs, GUIDs)
function Guard.id(value: any): string?
	if typeof(value) ~= "string" or #value == 0 or #value &gt; 64 then
		return nil
	end
	if string.find(value, "[^%w_%-]") then
		return nil
	end
	return value
end

local function isInvisible(code: number): boolean
	return (code &gt;= 0x200B and code &lt;= 0x200F) -- Zero-Width, LRM/RLM
		or (code &gt;= 0x202A and code &lt;= 0x202E) -- Bidi-Overrides
		or (code &gt;= 0x2066 and code &lt;= 0x2069) -- Bidi-Isolates
		or code == 0xFEFF
end

-- Freitext (Firmen-/Modellnamen): gültiges UTF-8, keine Steuer-/Unsichtbar-Zeichen, Länge in Zeichen.
-- Ersetzt NICHT den Roblox-Textfilter – der kommt danach (Lib/TextFilter).
function Guard.text(value: any, minLength: number, maxLength: number): string?
	if typeof(value) ~= "string" or #value &gt; maxLength * 4 then
		return nil
	end
	if utf8.len(value) == nil then
		return nil
	end
	local cleaned = (string.gsub(value, "%s+", " "))
	cleaned = string.match(cleaned, "^%s*(.-)%s*$") or ""
	if string.find(cleaned, "%c") then
		return nil
	end
	for _, code in utf8.codes(cleaned) do
		if isInvisible(code) then
			return nil
		end
	end
	local length = utf8.len(cleaned) or 0
	if length &lt; minLength or length &gt; maxLength then
		return nil
	end
	return cleaned
end

return Guard
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">RateLimiter</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Token-Bucket pro Spieler: `burst` Anfragen sofort, danach `perSecond` nachfüllend.

export type Limiter = {
	allow: (player: Player) -&gt; boolean,
	forget: (player: Player) -&gt; (),
}

type Bucket = { tokens: number, last: number }

local RateLimiter = {}

function RateLimiter.new(burst: number, perSecond: number): Limiter
	local buckets: { [Player]: Bucket } = {}

	local function allow(player: Player): boolean
		local now = os.clock()
		local bucket = buckets[player]
		if not bucket then
			bucket = { tokens = burst, last = now }
			buckets[player] = bucket
		end
		bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * perSecond)
		bucket.last = now
		if bucket.tokens &lt; 1 then
			return false
		end
		bucket.tokens -= 1
		return true
	end

	local function forget(player: Player)
		buckets[player] = nil
	end

	return { allow = allow, forget = forget }
end

return RateLimiter
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Remote</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Sicherheits-Schicht für alle Client-Anfragen:
--   1. Rate-Limit pro Spieler und Remote
--   2. Spielerdaten müssen geladen sein
--   3. Payload muss eine Tabelle sein (Felder prüft der Handler mit Guard)
--   4. Fehler im Handler werden abgefangen -&gt; Client bekommt nur einen Code, nie einen Stacktrace

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)
local ServerTypes = require(script.Parent.ServerTypes)

type Session = ServerTypes.Session
-- company = true: Aktion erst nach der Firmengründung erlaubt
export type Limits = { burst: number, perSecond: number, company: boolean? }

local Remote = {}

local folder: Folder? = nil
local limiters: { RateLimiter.Limiter } = {}
local sessionProvider: (Player) -&gt; Session? = function(_player: Player)
	return nil
end

function Remote.setup()
	assert(folder == nil, "Remote.setup doppelt aufgerufen")
	local created = Instance.new("Folder")
	created.Name = Net.FOLDER
	for _, name in Net.FUNCTIONS do
		local fn = Instance.new("RemoteFunction")
		fn.Name = name
		fn.Parent = created
	end
	for _, name in Net.EVENTS do
		local event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = created
	end
	created.Parent = ReplicatedStorage
	folder = created

	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in limiters do
			limiter.forget(player)
		end
	end)
end

-- SessionService meldet sich hier an (kein zirkuläres require)
function Remote.setSessionProvider(provider: (Player) -&gt; Session?)
	sessionProvider = provider
end

function Remote.bind(name: string, limits: Limits, handler: ServerTypes.Handler)
	assert(folder, "Remote.setup zuerst aufrufen")
	local fn = folder:FindFirstChild(name)
	assert(fn and fn:IsA("RemoteFunction"), "Unbekanntes Remote: " .. name)
	local limiter = RateLimiter.new(limits.burst, limits.perSecond)
	table.insert(limiters, limiter)

	fn.OnServerInvoke = function(player: Player, payload: any): ServerTypes.Result
		if not limiter.allow(player) then
			return { ok = false, err = "RATE_LIMIT" }
		end
		local session = sessionProvider(player)
		if not session or session.closed then
			return { ok = false, err = "LOADING" }
		end
		if limits.company and not session.data.company then
			return { ok = false, err = "NO_COMPANY" }
		end
		local cleanPayload: ServerTypes.Payload = if typeof(payload) == "table" then payload else {}
		local ok, result = pcall(handler, session, cleanPayload)
		if not ok then
			warn(`[Remote] {name} von {player.Name} fehlgeschlagen: {result}`)
			return { ok = false, err = "SERVER_ERROR" }
		end
		return result
	end
end

function Remote.fire(player: Player, name: string, ...: any)
	assert(folder, "Remote.setup zuerst aufrufen")
	local event = folder:FindFirstChild(name)
	if event and event:IsA("RemoteEvent") then
		event:FireClient(player, ...)
	end
end

return Remote
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">ServerTypes</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Server-interne Typen. Eigenes Modul, damit Lib und Services sich nicht gegenseitig requiren müssen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)

export type Session = {
	player: Player,
	userId: number,
	data: Types.PlayerData,
	live: Types.LiveInfo, -- Laufzeitwerte, nicht gespeichert
	dirty: boolean,
	lastSent: number,
	nextSaveAt: number,
	saving: boolean,
	closed: boolean, -- keine Änderungen/Saves mehr
	released: boolean, -- Schließen läuft bereits
	rng: Random,
	seq: number?, -- Nummer des zuletzt gesendeten State-Snapshots/-Deltas (SessionService)
	shadow: any?, -- private Kopie des zuletzt gesendeten Stands {data, live}; Basis für Deltas
	urgent: boolean?, -- Remote-Aufruf seit dem letzten Senden: schneller senden (REPLICATE_URGENT_SECONDS)
	sweptAt: number?, -- letzter Abgleich inkl. der "lazy" Zähler (REPLICATE_LAZY_SECONDS)
}

export type Payload = { [string]: any }
export type Result = { [string]: any }
export type Handler = (session: Session, payload: Payload) -&gt; Result

return {}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Template</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Startdaten eines neuen Spielers + Migrationen alter Spielstände.
--
-- Neues Feld in einer späteren Phase:
--   1. GameConfig.DATA_VERSION um 1 erhöhen
--   2. hier in MIGRATIONS[alteVersion] das Feld setzen (z. B. data.employees = {})
--   3. Template.new() um das Feld ergänzen
-- Alte Spielstände werden beim Laden Schritt für Schritt hochgezogen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

local EmpireMath = require(ReplicatedStorage.Shared.EmpireMath)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local ShopConfig=require(ReplicatedStorage.Shared.Config.ShopConfig)
local DepartmentConfig=require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local CompanyOps=require(ReplicatedStorage.Shared.CompanyOps)
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local ModelConfig=require(ReplicatedStorage.Shared.Config.ModelConfig)
local Template = {}

local function finiteNumber(v: any): boolean
	return typeof(v) == "number" and v == v and v &gt; -math.huge and v &lt; math.huge
end
local function marketUsers(m: any): number
	local n = 0
	local market = m.market
	if typeof(market) == "table" and typeof(market.users) == "table" then
		for _, u in market.users do if finiteNumber(u) and u &gt; 0 then n += u end end
	end
	return n
end
local function clearMarket(m: any)
	if typeof(m.market) == "table" then
		m.market.users = {}
		m.market.organic = {}
		m.market.hype = {}
	end
end
-- CORE_SPEC 7.1 / 7.2 for saves from before product lines: one live model per line and at most
-- MarketConfig.PRODUCT_SLOTS[office] live lines (old saves could run clones side by side).
--  * per line the best live model stays (overall, then users, then the order of modelOrder); every other live
--    model of that line retires into it like a release of a new version: replacedBy = kept id, its users x
--    ModelConfig.MIGRATE and its word of mouth (organic) move over (AIModelService.releaseModel / PricingMath);
--  * lines beyond the office's slots (fewest users first) go back to "trained": they keep their release data
--    and history and can be released again into a free line.
function Template.normaliseLines(d: any)
	local models, order = d.models, d.modelOrder
	if typeof(models) ~= "table" or typeof(order) ~= "table" then return end
	local lines: { [string]: { any } } = {}
	local lineOrder: { string } = {}
	for _, id in order do
		local m = if typeof(id) == "string" then models[id] else nil
		if typeof(m) == "table" and m.status == "live" and typeof(m.release) == "table" then
			local line = ModelMath.lineOf(if typeof(m.release.target) == "string" then m.release.target else nil)
			if not lines[line] then lines[line] = {}; table.insert(lineOrder, line) end
			table.insert(lines[line], m)
		end
	end
	local kept: { any } = {}
	for _, line in lineOrder do
		local list = lines[line]
		local best = list[1]
		for _, m in list do
			local ov, bo = tonumber(m.overall) or 0, tonumber(best.overall) or 0
			if ov &gt; bo or (ov == bo and marketUsers(m) &gt; marketUsers(best)) then best = m end
		end
		for _, m in list do
			if m ~= best then
				local om, bm = m.market, best.market
				if typeof(om) == "table" and typeof(bm) == "table" then
					if typeof(bm.users) ~= "table" then bm.users = {} end
					if typeof(bm.organic) ~= "table" then bm.organic = {} end
					if typeof(om.users) == "table" then
						for seg, n in om.users do
							if typeof(seg) == "string" and finiteNumber(n) and n &gt; 0 then bm.users[seg] = (tonumber(bm.users[seg]) or 0) + n * ModelConfig.MIGRATE end
						end
					end
					if typeof(om.organic) == "table" then
						for seg, o in om.organic do
							if typeof(seg) == "string" and finiteNumber(o) and o &gt; 0 then bm.organic[seg] = (tonumber(bm.organic[seg]) or 0) + o end
						end
					end
				end
				m.status = "retired"
				m.replacedBy = best.id
				clearMarket(m)
			end
		end
		table.insert(kept, { line = line, model = best, users = marketUsers(best) })
	end
	local slots = ModelMath.productSlots(if typeof(d.empire) == "table" then d.empire.office else nil)
	if #kept &gt; slots then
		table.sort(kept, function(a: any, b: any): boolean
			if a.users ~= b.users then return a.users &gt; b.users end
			return a.line &lt; b.line
		end)
		for i = slots + 1, #kept do
			local m = kept[i].model
			m.status = "trained"
			clearMarket(m)
		end
	end
end

-- Robux shop records (ShopService). receipts/order are server-only (SessionService never sends them):
-- receipts[PurchaseId] = os.time() of the grant, order = the same ids oldest first (trimmed to
-- ShopConfig.RECEIPTS_KEPT). vouchers[key] = unredeemed count. passes = fallback cache of game-pass
-- ownership, used only while Roblox can't be asked. tips = supporter tips received.
function Template.newShop(): any
	return { receipts = {}, order = {}, vouchers = {}, passes = {}, tips = 0 }
end

function Template.new(): Types.PlayerData
	local data: Types.PlayerData = {
		version = GameConfig.DATA_VERSION,
		empire = EmpireMath.new(),
		company = nil,
		money = GameConfig.START_MONEY,
		data = {},
		gpus = { laptop = 1 },
		models = {},
		modelOrder = {},
		training = nil,
		lastScrapeAt = 0,
		stats = {
			totalRevenue = 0,
			totalCost = 0,
			modelsTrained = 0,
			modelsReleased = 0,
			peakUsers = 0,
			bestOverall = 0,
		},
	}
	-- not part of Types.PlayerData (shared type); added untyped like the other optional save fields
	;(data :: any).shop = Template.newShop()
	;(data :: any).trainings = {} -- DATA_VERSION 6: reserved for training slots 2..4 (CORE_SPEC 7.6)
	return data
end

-- MIGRATIONS[v] hebt einen Spielstand von Version v auf v + 1.
local MIGRATIONS: { [number]: (data: any) -&gt; () } = {
	[1] = function(data: any) data.empire = EmpireMath.new() end,
	[3] = function(data: any) end,
	[4] = function(data: any) end,
	[2] = function(data: any) end, -- nested defaults preserve existing founder progress
	-- 5 -&gt; 6 (CORE_SPEC 2.4): the Garage Lab is inserted as office 1. A founded company keeps its building:
	-- old tier k becomes stage k + 1 (same plan tier through BuildingPlan.OFFICE_TIER_OFFSET = 1); a save
	-- that never founded a company starts in the garage.
	[5] = function(d: any)
		local e = d.empire
		if typeof(e) ~= "table" then return end
		if d.company then
			e.office = math.clamp(math.floor(tonumber(e.office) or 1) + 1, 2, 5) -- old tier k -&gt; stage k+1 (same building)
		else
			e.office = 1 -- never founded: start in the garage
		end
		d.trainings = if typeof(d.trainings) == "table" then d.trainings else {} -- reserved for slots 2..4 (7.6)
		-- the lease auction is gone: its customers / revenue are empty compatibility fields (2.4)
		e.customers = {}
		e.businessRevenue = 0
		-- one live model per product line, live lines within the stage's slots (7.1 / 7.2)
		Template.normaliseLines(d)
	end,
}

-- Open job applications (RecruitingService): at most MAX_APPLICANTS well-formed entries survive.
-- Private traits (true skill, temperament) are not stored; the server derives them from `serial`.
local APPLICANT_STATUS={new=true,invited=true,interviewing=true}
local function cleanApplicants(raw: any): {any}
	local out={}
	if typeof(raw)~="table" then return out end
	local function finite(v: any): boolean return typeof(v)=="number" and v==v and v&gt;-math.huge and v&lt;math.huge end
	for _,a in raw do
		if #out&gt;=EmpireMath.MAX_APPLICANTS then break end
		if typeof(a)~="table" or typeof(a.id)~="string" or #a.id&gt;24 or not EmpireConfig.find(EmpireConfig.ROLES,a.role) then continue end
		if typeof(a.n)~="string" or not finite(a.s) or not finite(a.serial) or not finite(a.ask) or not finite(a.at) then continue end
		local asked={}
		if typeof(a.q)=="table" then for _,q in a.q do if typeof(q)=="string" and #q&lt;=24 and #asked&lt;7 then table.insert(asked,q) end end end
		table.insert(out,{id=a.id,serial=math.floor(math.abs(a.serial)),role=a.role,n=string.sub(a.n,1,40),s=math.floor(math.abs(a.s))%2147483647,
			xp=if finite(a.xp) then math.clamp(math.floor(a.xp),0,40) else 0,prev=if typeof(a.prev)=="string" then string.sub(a.prev,1,48) else "",
			spec=if typeof(a.spec)=="string" then string.sub(a.spec,1,48) else "",ask=math.clamp(a.ask,0.8,1.5),at=a.at,
			st=if typeof(a.st)=="string" and APPLICANT_STATUS[a.st] then a.st else "new",q=asked,
			r=if finite(a.r) then math.clamp(math.floor(a.r),1,3) else nil,low=if a.low==true then true else nil})
	end
	return out
end

-- Repairs data.shop without ever dropping something a player paid for: unknown voucher keys are kept
-- (a voucher removed from ShopConfig must not vanish), counts are clamped, receipts/order rebuilt.
local SHOP_KEY_MAX = 32
local SHOP_LIST_MAX = 32
local RECEIPT_ID_MAX = 128
local function shopKey(key: any): boolean
	return typeof(key) == "string" and #key &gt; 0 and #key &lt;= SHOP_KEY_MAX and string.find(key, "[^%w_]") == nil
end
function Template.cleanShop(raw: any): any
	local shop = Template.newShop()
	if typeof(raw) ~= "table" then
		return shop
	end
	local function finite(v: any): boolean
		return typeof(v) == "number" and v == v and v &gt; -math.huge and v &lt; math.huge
	end
	-- receipts: string id -&gt; grant time. order: the same ids, oldest first, no duplicates.
	local receipts: { [string]: number } = {}
	if typeof(raw.receipts) == "table" then
		for id, at in raw.receipts do
			if typeof(id) == "string" and #id &gt; 0 and #id &lt;= RECEIPT_ID_MAX then
				receipts[id] = if finite(at) then at else 0
			end
		end
	end
	local order: { string } = {}
	local listed: { [string]: boolean } = {}
	if typeof(raw.order) == "table" then
		for _, id in raw.order do
			if typeof(id) == "string" and receipts[id] ~= nil and not listed[id] then
				listed[id] = true
				table.insert(order, id)
			end
		end
	end
	-- receipts missing from order count as the oldest (sorted by grant time, then id: deterministic)
	local missing: { string } = {}
	for id in receipts do
		if not listed[id] then
			table.insert(missing, id)
		end
	end
	table.sort(missing, function(a: string, b: string): boolean
		if receipts[a] ~= receipts[b] then
			return receipts[a] &lt; receipts[b]
		end
		return a &lt; b
	end)
	for i, id in missing do
		table.insert(order, i, id)
	end
	while #order &gt; ShopConfig.RECEIPTS_KEPT do
		receipts[table.remove(order, 1) :: string] = nil
	end
	shop.receipts = receipts
	shop.order = order
	if typeof(raw.vouchers) == "table" then
		local n = 0
		for key, count in raw.vouchers do
			if shopKey(key) and finite(count) and n &lt; SHOP_LIST_MAX then
				local c = math.clamp(math.floor(count), 0, ShopConfig.VOUCHER_MAX)
				if c &gt; 0 then
					shop.vouchers[key] = c
					n += 1
				end
			end
		end
	end
	if typeof(raw.passes) == "table" then
		local n = 0
		for key, owned in raw.passes do
			if shopKey(key) and owned == true and n &lt; SHOP_LIST_MAX then
				shop.passes[key] = true
				n += 1
			end
		end
	end
	shop.tips = if finite(raw.tips) then math.max(0, math.floor(raw.tips)) else 0
	return shop
end

-- CORE_SPEC Appendix A cleaners (DATA_VERSION 6 fields). Runs after the nested defaults, so every field
-- exists; repairs types and value ranges without dropping valid progress.
local function finite(v: any): boolean
	return typeof(v) == "number" and v == v and v &gt; -math.huge and v &lt; math.huge
end
local HR_BUDGETS = { [0.25] = true, [0.40] = true, [0.55] = true }
local TRIP_KINDS = { sign = true, renew = true }
function Template.cleanCompany(raw: any)
	local e = raw.empire
	-- company calendar: day integer &gt;= 1, index (server day index of the last tick) number or nil
	local cal = if typeof(e.calendar) == "table" then e.calendar else {}
	e.calendar = { day = if finite(cal.day) then math.max(1, math.floor(cal.day)) else 1, index = if finite(cal.index) then math.floor(cal.index) else nil }
	-- B2B pipeline (CompanyOps.ensure does the type part): only catalogue clients, &lt;= 16 well-formed trips,
	-- &lt;= 40 news lines of &lt;= 120 characters, finite numbers &gt;= 0
	local d = CompanyOps.ensure(e)
	local accounts = {}
	for id, acc in d.accounts do
		if CompanyOps.client(id) and typeof(acc) == "table" and finite(acc.expires) then
			accounts[id] = { expires = math.floor(math.max(0, acc.expires)), since = if finite(acc.since) then math.floor(math.max(0, acc.since)) else 0,
				founder = if acc.founder == true then true else nil, renewing = if acc.renewing == true then true else nil }
		end
	end
	d.accounts = accounts
	local trust = {}
	for id, t in d.trust do if CompanyOps.client(id) and finite(t) and t &gt; 0 then trust[id] = math.min(t, 2) end end
	d.trust = trust
	local trips = {}
	for _, t in d.tripList do
		if #trips &gt;= CompanyOps.TRIPS_MAX then break end
		if typeof(t) == "table" and CompanyOps.client(t.client) and TRIP_KINDS[t.kind] and finite(t.back) then
			table.insert(trips, { client = t.client, kind = t.kind, back = math.floor(math.max(0, t.back) + 0.5), founder = t.founder == true, hosted = t.hosted == true,
				crew = if finite(t.crew) then math.clamp(math.floor(t.crew), 0, 2) else 1, left = if finite(t.left) then math.floor(t.left) else nil, joined = if t.joined == true then true else nil })
		end
	end
	d.tripList = trips
	local news = {}
	for _, line in d.news do
		if #news &gt;= CompanyOps.NEWS_MAX then break end
		if typeof(line) == "string" then table.insert(news, CompanyOps.clip(line, CompanyOps.NEWS_CHARS)) end
	end
	d.news = news
	local skip = {}
	for id, v in d.skip do if CompanyOps.client(id) and v == true then skip[id] = true end end
	d.skip = skip
	-- Lab level 0..10, jet boolean, auto-HR settings, Save mode, night shifts, apprentices, unpaid leave
	e.labLevel = if finite(e.labLevel) then math.clamp(math.floor(e.labLevel), 0, CompanyOps.LAB_MAX) else 0
	e.jet = e.jet == true
	local hr = if typeof(e.hr) == "table" then e.hr else {}
	local budget = tonumber(hr.budget)
	if budget then budget = math.round(budget * 100) / 100 end
	e.hr = { auto = hr.auto ~= false, budget = if budget and HR_BUDGETS[budget] then budget else 0.40 }
	e.saveMode = if e.saveMode == "off" then "off" else "auto"
	local night = {}
	if typeof(e.nightShift) == "table" then
		for dept, on in e.nightShift do if typeof(dept) == "string" and DepartmentConfig.DEPARTMENTS[dept] and on == true then night[dept] = true end end
	end
	e.nightShift = night
	local seeds: { [string]: boolean } = {}
	for _, list in e.staffProfiles do
		if typeof(list) == "table" then for _, p in list do if typeof(p) == "table" and finite(p.s) then seeds[tostring(p.s)] = true end end end
	end
	local apprentices = {}
	if typeof(e.apprentices) == "table" then
		for key, a in e.apprentices do
			if typeof(key) == "string" and seeds[key] and typeof(a) == "table" and finite(a.day) then apprentices[key] = { day = math.max(1, math.floor(a.day)) } end
		end
	end
	e.apprentices = apprentices
	e.unpaidLeave = if finite(e.unpaidLeave) then math.clamp(math.floor(e.unpaidLeave), 0, EmpireMath.staff(e)) else 0
	-- the lease auction is gone (CORE_SPEC 2.4): empty compatibility fields, also for saves migrated earlier
	e.customers = {}
	e.businessRevenue = 0
	-- P&amp;L ledger: &lt;= LEDGER_DAYS day keys, each {i = income by category, o = costs by category} with
	-- &lt;= LEDGER_CATEGORIES finite entries per side ("other" included; the smallest extra lines merge into it)
	local ledger = {}
	if typeof(e.ledger) == "table" then
		local days = {}
		for key, entry in e.ledger do
			local day = tonumber(key)
			if typeof(key) == "string" and day and finite(day) and day == math.floor(day) and day &gt;= 1 and typeof(entry) == "table" then table.insert(days, day) end
		end
		table.sort(days, function(a: number, b: number): boolean return a &gt; b end)
		for k = 1, math.min(CompanyOps.LEDGER_DAYS, #days) do
			local entry = e.ledger[tostring(days[k])]
			local clean = { i = {}, o = {} }
			for _, side in { "i", "o" } do
				if typeof(entry[side]) == "table" then
					local cats = {}
					for cat, v in entry[side] do
						if typeof(cat) == "string" and #cat &gt; 0 and #cat &lt;= 16 and finite(v) then table.insert(cats, { cat = cat, v = v }) end
					end
					table.sort(cats, function(a: any, b: any): boolean
						if a.v ~= b.v then return a.v &gt; b.v end
						return a.cat &lt; b.cat
					end)
					local n, other, hasOther = 0, 0, false
					for _, c in cats do
						if c.cat == "other" then other += c.v; hasOther = true
						elseif n &lt; CompanyOps.LEDGER_CATEGORIES - 1 then clean[side][c.cat] = c.v; n += 1
						else other += c.v; hasOther = true end
					end
					if hasOther then clean[side].other = other end
				end
			end
			ledger[tostring(days[k])] = clean
		end
	end
	e.ledger = ledger
	-- reserved v2 training slots: string keys "2".."4" only (empty in v1)
	local trainings = {}
	if typeof(raw.trainings) == "table" then
		for key, job in raw.trainings do if (key == "2" or key == "3" or key == "4") and typeof(job) == "table" then trainings[key] = job end end
	end
	raw.trainings = trainings
	-- model fields of CORE_SPEC 7 (models package): version age, successor link, auto-price flag
	if typeof(raw.models) == "table" then
		for _, m in raw.models do
			if typeof(m) ~= "table" then continue end
			if typeof(m.market) == "table" then
				local vage = m.market.vage
				m.market.vage = if finite(vage) and vage &gt;= 0 then vage elseif finite(m.market.age) then math.max(0, m.market.age) else 0
			end
			if m.replacedBy ~= nil and (typeof(m.replacedBy) ~= "string" or typeof(raw.models[m.replacedBy]) ~= "table") then m.replacedBy = nil end
			if typeof(m.release) == "table" then m.release.auto = m.release.auto ~= false end
		end
	end
end

-- Gibt (Daten, nil) oder (nil, Grund) zurück. Ein Grund bedeutet: NICHT überschreiben, Spieler kicken.
function Template.migrate(raw: any): (Types.PlayerData?, string?)
	if typeof(raw) ~= "table" then
		if raw == nil then return Template.new(), nil end
		return nil, "invalid save; original preserved"
	end
	local version = if typeof(raw.version) == "number" then raw.version else 0
	if version &gt; GameConfig.DATA_VERSION then
		return nil, "save is from a newer game version"
	end
	while version &lt; GameConfig.DATA_VERSION do
		local step = MIGRATIONS[version]
		if step then
			step(raw)
		end
		version += 1
	end
	raw.version = version

	-- fehlende Felder auffüllen: robust gegen halbe Spielstände
	local defaults: any = Template.new()
	for key, value in defaults do
		if raw[key] == nil then
			raw[key] = value
		end
	end
	if typeof(raw.stats) ~= "table" then
		raw.stats = defaults.stats
	end
	for key, value in defaults.stats do
		if raw.stats[key] == nil then
			raw.stats[key] = value
		end
	end
	-- Nested defaults protect migrations without clearing existing progress.
	if typeof(raw.empire) ~= "table" then raw.empire = EmpireMath.new() end
	for key, value in EmpireMath.new() do
		if raw.empire[key] == nil then raw.empire[key] = value end
	end
	local e = raw.empire
	for _, key in {"employees", "research", "quests", "contracts", "history", "subscriptions", "invoices", "customers", "projects", "projectOrder", "deliveries", "arenaHistory"} do
		if typeof(e[key]) ~= "table" then e[key] = {} end
	end
	if typeof(e.infrastructure)~="table" then e.infrastructure={cooling=1,trainingShare=0.7} end
	e.infrastructure.cooling=math.clamp(math.floor(tonumber(e.infrastructure.cooling) or 1),1,8)
	e.infrastructure.trainingShare=math.clamp(tonumber(e.infrastructure.trainingShare) or 0.7,0.25,0.9)
	if e.projectJob~=nil and typeof(e.projectJob)~="table" then e.projectJob=nil end
	e.arenaBest=math.max(0,tonumber(e.arenaBest) or 0)
	e.historyClock = math.clamp(tonumber(e.historyClock) or 0,0,10)
	if typeof(e.daily) ~= "table" then e.daily = {day=-1,streak=0} end
	e.daily.day = tonumber(e.daily.day) or -1
	e.daily.streak = math.clamp(math.floor(tonumber(e.daily.streak) or 0),0,7)
	e.office = math.clamp(math.floor(tonumber(e.office) or 1),1,#EmpireConfig.OFFICES)
	local remaining=EmpireConfig.OFFICES[e.office].staff
	local cleanEmployees={}
	for _,role in EmpireConfig.ROLES do
		local n=tonumber(e.employees[role.id]) or 0
		if n~=n or n==math.huge or n==-math.huge then n=0 end
		n=math.clamp(math.floor(n),0,remaining);cleanEmployees[role.id]=n;remaining-=n
	end
	e.employees=cleanEmployees
	-- Staff identities follow the cleaned counts (240 cap included). Without the user id only the
	-- shape is repaired; RecruitingService fills generated names/seeds when the session loads, which
	-- are exactly the identities the building shows today (EmpireMath.syncProfiles).
	EmpireMath.syncProfiles(e,nil)
	e.hireSerial=math.max(0,math.floor(tonumber(e.hireSerial) or 0))
	if e.hireSerial~=e.hireSerial or e.hireSerial==math.huge then e.hireSerial=0 end
	e.applicants=cleanApplicants(e.applicants)
	if typeof(e.campus)~="table" then e.campus=CampusMath.new() end
	local c=e.campus
	for k,v in CampusMath.new() do if c[k]==nil then c[k]=v end end
	local function number(value: any,default: number): number
		local n=tonumber(value);return if n and n==n and n&lt;math.huge and n&gt; -math.huge then n else default
	end
	c.retailLevel=math.clamp(math.floor(number(c.retailLevel,1)),1,4)
	c.retailClock=math.clamp(number(c.retailClock,0),0,29.99)
	c.retailSales=math.max(0,math.floor(number(c.retailSales,0)));c.retailRevenue=math.max(0,number(c.retailRevenue,0))
	c.boostUntil=math.clamp(number(c.boostUntil,0),0,os.time()+240);c.boostSpeed=math.clamp(number(c.boostSpeed,16),16,21)
	local snacks={};local slots=16
	for _,def in CampusConfig.SNACKS do
		local count=if typeof(c.snacks)=="table" then number(c.snacks[def.id],0) else 0
		count=math.clamp(math.floor(count),0,slots);snacks[def.id]=count;slots-=count
	end
	c.snacks=snacks
	local cars={compact=true}
	for _,def in CampusConfig.CARS do if typeof(c.cars)=="table" and c.cars[def.id]==true then cars[def.id]=true end end
	c.cars=cars;c.selectedCar=if typeof(c.selectedCar)=="string" and cars[c.selectedCar] then c.selectedCar else "compact"
	for _,key in {"points","xp","seconds","contractsCompleted"} do
		e[key] = math.max(0, tonumber(e[key]) or 0)
	end
	Template.cleanCompany(raw)
	-- Robux records: old saves get an empty shop (filled above), malformed ones are repaired. No
	-- DATA_VERSION bump needed: a pure addition, like staffProfiles.
	raw.shop = Template.cleanShop(raw.shop)
	return raw :: Types.PlayerData, nil
end

return Template
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">TextFilter</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Roblox-Pflicht: Text, den andere Spieler sehen (Firmen- und Modellnamen), muss gefiltert werden.

local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")

local TextFilter = {}

-- Gibt den gefilterten Text zurück, oder nil, wenn der Filter nicht erreichbar ist. Yieldet.
function TextFilter.forBroadcast(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and typeof(result) == "string" then
		return result
	end
	-- ungeprüft: ob der Filter in einem unveröffentlichten Studio-Ort fehlschlägt. Falls ja, darf Studio
	-- weiterlaufen (niemand sonst sieht den Text). Auf echten Servern wird ohne Filter abgelehnt.
	if RunService:IsStudio() then
		return text
	end
	warn("[TextFilter] Filter nicht erreichbar:", result)
	return nil
end

return TextFilter
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000033"><Properties><string name="Name">Services</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">AIModelService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- KI-Modelle: Training starten und fortschreiben, Trainings-Events, Release, Preise, Retire.
--
-- CORE_SPEC 7 (models package):
--   * product lines: the release target is the line; one live model per line. Releasing into a line that has
--     a live model makes the new model its next version: it takes over ModelConfig.MIGRATE of the users and the
--     word of mouth, the old one retires with replacedBy = new id. A new line beyond MarketConfig.PRODUCT_SLOTS
--     of the office returns LINE_LIMIT.
--   * ageing: model.market.vage (seconds since the last version) is 0 at release and after a refinement;
--     MarketMath.tick advances it while the model is live.
--   * refinement: at most ModelConfig.REFINE.limit runs (REFINE_LIMIT), cost x (1 + 0.5 * runs), additive
--     gain, every core stat &lt;= 99; a live model keeps serving with its current version meanwhile.
--   * MODEL_LIMIT counts non-retired models only; old retired models beyond RETIRED_KEEP are pruned.
--   * pricing: Recommended release price and auto-price (model.release.auto) via PricingService.
--
-- Ablauf eines Trainings:
--   StartTraining prüft Name/Größe/Fokus, plant mit ModelMath (GPU, VRAM, Daten, Kosten) und zieht
--   die Kosten ab. tick() schreibt jede Sekunde Arbeit fort (GPU-Käufe beschleunigen sofort).
--   Bei eventAt (35 %) wird einmal ein Event gewürfelt. Entscheidungs-Events pausieren das Training,
--   bis der Spieler wählt oder der Timer abläuft (dann gilt die Default-Wahl).
--   Am Ende berechnet computeStats die Stats aus den Daten vom Trainingsstart (Daten werden nicht verbraucht).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local ModelConfig = require(ReplicatedStorage.Shared.Config.ModelConfig)
local MarketConfig = require(ReplicatedStorage.Shared.Config.MarketConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local EmpireMath = require(ReplicatedStorage.Shared.EmpireMath)
local PricingMath = require(ReplicatedStorage.Shared.PricingMath)
local Format = require(ReplicatedStorage.Shared.Format)
local Types = require(ReplicatedStorage.Shared.Types)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local TextFilter = require(script.Parent.Parent.Lib.TextFilter)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local PricingService = require(script.Parent.PricingService)
local CompanyOps = require(ReplicatedStorage.Shared.CompanyOps)

type Session = ServerTypes.Session
type TrainingState = Types.TrainingState
type EventDef = ModelConfig.EventDef
type ChoiceDef = ModelConfig.ChoiceDef

local T = ModelConfig.TRAINING
local EPOCHS = 10
local MODEL_LIMIT_DEFAULT = 80 -- used only until GameConfig.MODEL_LIMIT exists (econ package)

local function modelLimit(): number
	local limit = (GameConfig :: any).MODEL_LIMIT
	return if typeof(limit) == "number" then limit else MODEL_LIMIT_DEFAULT
end

local AIModelService = {}

local function addLog(training: TrainingState, line: string)
	table.insert(training.log, line)
	while #training.log &gt; T.logLines do
		table.remove(training.log, 1)
	end
end

local function specOf(session: Session): string
	local company = session.data.company
	return if company then company.spec else "general"
end

-- "Nova" -&gt; Version 1, zweites "Nova" -&gt; Version 2 (Anzeige "Nova v2")
local function versionFor(data: Types.PlayerData, name: string): number
	local lower = string.lower(name)
	local count, highest = 0, 0
	for _, model in data.models do
		if string.lower(model.name) == lower then
			count += 1
			highest = math.max(highest, tonumber(model.version) or 0)
		end
	end
	-- refinements raise model.version, so the next "Nova" never reuses a number a refined Nova already shows
	return math.max(count, highest) + 1
end

-- Line label for news and notices ("Consumer Chat").
local function lineLabel(target: string?): string
	local line = ModelConfig.getLine(target)
	return if line then line.label else "Model"
end

-- One stamped line in the company news feed (CompanyOps.post: the company's own day, the visible hour).
local function news(session: Session, text: string)
	local e = session.data.empire
	if typeof(e) == "table" then
		CompanyOps.post(e, text)
	end
end

-- A retired model keeps its history (revenueTotal, peakUsers, ages) but no per-segment state.
local function clearMarket(model: Types.ModelData)
	local market = model.market
	if market then
		market.users = {}
		market.organic = {}
		market.hype = {}
	end
end

-- Saves stay bounded although retired models no longer count toward MODEL_LIMIT: beyond RETIRED_KEEP the
-- oldest retired models are removed, except one that is training or is the source of a studio project.
-- replacedBy chains are re-linked around a removed model (StudioService follows them to the live successor).
local function pruneRetired(data: Types.PlayerData): number
	local retired: { string } = {}
	for _, id in data.modelOrder do
		local model = data.models[id]
		if model and model.status == "retired" then
			table.insert(retired, id)
		end
	end
	local excess = #retired - ModelConfig.RETIRED_KEEP
	if excess &lt;= 0 then
		return 0
	end
	local protected: { [string]: boolean } = {}
	if data.training then
		protected[data.training.modelId] = true
	end
	local projects = if typeof(data.empire) == "table" then data.empire.projects else nil
	if typeof(projects) == "table" then
		for _, project in projects do
			if typeof(project) == "table" and typeof(project.sourceId) == "string" then
				protected[project.sourceId] = true
			end
		end
	end
	local removed: { [string]: boolean } = {}
	for _, id in retired do
		if excess &lt;= 0 then
			break
		end
		if not protected[id] then
			removed[id] = true
			excess -= 1
		end
	end
	for _, model in data.models do
		local successor = (model :: any).replacedBy
		local hops = 0
		while typeof(successor) == "string" and removed[successor] and hops &lt; 64 do
			local next = data.models[successor]
			successor = if next then (next :: any).replacedBy else nil
			hops += 1
		end
		if (model :: any).replacedBy ~= successor then
			(model :: any).replacedBy = successor
		end
	end
	local order: { string } = {}
	local count = 0
	for _, id in data.modelOrder do
		if removed[id] then
			data.models[id] = nil
			count += 1
		else
			table.insert(order, id)
		end
	end
	data.modelOrder = order
	return count
end

local function bestOverallExcept(data: Types.PlayerData, exceptId: string): number
	local best = 0
	for id, model in data.models do
		if id ~= exceptId and model.status ~= "training" then
			best = math.max(best, model.overall)
		end
	end
	return best
end

-- Loss-Punkte gleichmäßig über den Fortschritt (Punkt i gehört zu Fortschritt (i-1)/(N-1))
local function updateLoss(session: Session, training: TrainingState)
	local progress = training.workDone / training.workTotal
	local wanted = math.clamp(math.floor(progress * (T.lossPoints - 1)) + 1, 1, T.lossPoints)
	while #training.loss &lt; wanted do
		local p = #training.loss / (T.lossPoints - 1)
		local value = ModelMath.lossAt(p, training.expected, session.rng:NextNumber(-0.05, 0.05))
		table.insert(training.loss, math.round(value * 1000) / 1000)
	end
end

local function logEpochs(training: TrainingState)
	local epoch = math.min(EPOCHS - 1, math.floor(training.workDone / training.workTotal * EPOCHS))
	while training.epoch &lt; epoch do
		training.epoch += 1
		local loss = training.loss[#training.loss] or T.lossStart
		addLog(training, string.format("Epoch %d/%d  loss %.3f", training.epoch, EPOCHS, loss))
	end
end

local function stretchRemaining(training: TrainingState, timeMult: number)
	local remaining = training.workTotal - training.workDone
	training.workTotal = training.workDone + remaining * timeMult
end

-- Wendet eine Event-Wahl an. Gibt einen Fehlercode zurück oder nil.
local function applyChoice(session: Session, training: TrainingState, choice: ChoiceDef, auto: boolean): string?
	local event = training.event
	if not event or not event.pending then
		return "NO_EVENT"
	end
	if choice.costFactor then
		local extra = math.floor(training.cost * choice.costFactor)
		if not EconomyService.spend(session, extra, "training") then
			return "NO_MONEY"
		end
		training.cost += extra
	end
	if choice.timeMult then
		stretchRemaining(training, choice.timeMult)
	end
	local note = choice.desc
	if choice.quality then
		local hit = true
		if choice.gamble then
			hit = session.rng:NextNumber() &lt; choice.gamble
		end
		if hit then
			training.qualityMod *= choice.quality
			note = if choice.gamble then "quality took a hit" else choice.desc
		else
			note = "loss recovered, no damage"
		end
		event.outcome = if hit then choice.id else choice.id .. "_lucky"
	else
		event.outcome = choice.id
	end
	event.pending = false
	addLog(training, (if auto then "Timeout -&gt; " else "") .. choice.label .. ": " .. note)
	return nil
end

-- Timeout: Default-Wahl; falls die Geld kostet und keins da ist, die nächste kostenlose Option
local function autoResolve(session: Session, training: TrainingState, def: EventDef)
	local ordered: { ChoiceDef } = {}
	local default = if def.default then ModelConfig.getChoice(def, def.default) else nil
	if default then
		table.insert(ordered, default)
	end
	local choices = def.choices
	if choices then
		for _, choice in choices do
			if choice ~= default then
				table.insert(ordered, choice)
			end
		end
	end
	for _, choice in ordered do
		if applyChoice(session, training, choice, true) == nil then
			return
		end
	end
	local event = training.event
	if event then
		event.pending = false
		event.outcome = "skipped"
	end
end

local function rollEvent(session: Session, training: TrainingState, now: number)
	training.eventRolled = true
	local def = ModelMath.rollEvent(function()
		return session.rng:NextNumber()
	end, specOf(session))
	if not def then
		return
	end
	if def.choices then
		training.event = { id = def.id, pending = true, expiresAt = now + T.decisionTimeout, outcome = nil }
		if def.id == "instability" and #training.loss &gt; 0 then
			training.loss[#training.loss] += 0.8 -- sichtbarer Ausschlag im Graphen
		end
		addLog(training, "[!] " .. def.title)
		Remote.fire(session.player, "Notify", "TRAINING_EVENT", { eventId = def.id })
	else
		if def.timeMult then
			stretchRemaining(training, def.timeMult)
		end
		if def.quality then
			training.qualityMod *= def.quality
		end
		training.event = { id = def.id, pending = false, expiresAt = 0, outcome = "auto" }
		addLog(training, "[*] " .. def.title .. ": " .. def.text)
	end
end

local function finish(session: Session, training: TrainingState)
	local data = session.data
	data.training = nil
	local model = data.models[training.modelId]
	if model then
		local stats, overall = ModelMath.computeStats(
			model.sizeId,
			model.focusId,
			model.dataUsed,
			specOf(session),
			training.qualityMod,
			function(n: number): number
				return session.rng:NextNumber(-n, n)
			end
		)
		-- Lab levels and research reach new models through bonuses.core (EmpireMath, before the 99 cap)
		stats, overall = EmpireMath.boostStats(stats, data.empire)
		if training.refinement and training.baseStats then
			-- CORE_SPEC 7.4: additive gain per core stat, shrinking with every run, capped at 99
			local runs = math.max(0, math.floor(tonumber(model.iterations) or 0))
			local gain = ModelMath.refineGain(model.dataUsed.quality, training.qualityMod, runs)
			for _, stat in ModelConfig.STATS do
				if stat.weight &gt; 0 and stat.id ~= "reliability" then
					stats[stat.id] = math.min(ModelConfig.STAT_CAP, math.round(((training.baseStats[stat.id] or 1) + gain) * 10) / 10)
				end
			end
			model.iterations = runs + 1
			model.version += 1
			local market: any = model.market
			if market then
				market.vage = 0 -- a refinement is a new version: the model is young again
			end
		end
		stats, overall = ModelMath.capStats(stats)
		local previousBest = bestOverallExcept(data, model.id)
		model.stats = stats
		model.overall = overall
		if model.status == "training" then
			-- a live model keeps serving while it is refined (status stays "live"); a save from before that
			-- rule paused it: it goes live again only if its line is still free
			local release = model.release
			local free = release ~= nil and model.market ~= nil and #ModelMath.releaseCheck(data, model.id, release.target).replaced == 0
			model.status = if training.resumeLive and free then "live" else "trained"
		end
		model.trainedAt = os.time()
		model.trainCost = if training.refinement then model.trainCost + training.cost else training.cost
		data.stats.bestOverall = math.max(data.stats.bestOverall, overall)
		data.stats.modelsTrained += 1
		Remote.fire(session.player, "Notify", "TRAINING_COMPLETE", {
			modelId = model.id,
			overall = overall,
			previousBest = previousBest,
		})
	end
	SessionService.markDirty(session)
	PlotService.refresh(session)
end

local function trainingTick(session: Session, dt: number)
	local training = session.data.training
	if not training then
		return
	end
	local trainee = session.data.models[training.modelId]
	if not trainee then
		session.data.training = nil -- kaputter Zustand: Training ohne Modell
		SessionService.markDirty(session)
		return
	end
	if training.refinement and training.resumeLive and trainee.status == "training" then
		-- refinement started before CORE_SPEC 7.4 paused serving: the model serves again if its line is free
		local release = trainee.release
		if release and trainee.market and #ModelMath.releaseCheck(session.data, trainee.id, release.target).replaced == 0 then
			trainee.status = "live"
		end
	end

	local now = workspace:GetServerTimeNow()
	local event = training.event
	if event and event.pending then
		if now &lt; event.expiresAt then
			return -- pausiert, wartet auf Entscheidung
		end
		local def = ModelConfig.getEvent(event.id)
		if def then
			autoResolve(session, training, def)
		else
			event.pending = false
		end
	end

	local rate = EmpireMath.trainingRate(session.data.gpus, training.workTotal, session.data.empire)
	training.workDone = math.min(training.workTotal, training.workDone + rate * dt)
	updateLoss(session, training)
	if not training.eventRolled and training.workDone / training.workTotal &gt;= T.eventAt then
		rollEvent(session, training, now)
	end
	logEpochs(training)
	SessionService.markDirty(session)

	local pending = training.event ~= nil and (training.event :: Types.TrainingEventState).pending
	if training.workDone &gt;= training.workTotal and not pending then
		finish(session, training)
	end
end

-- Einmal pro Server-Tick für jede Session
function AIModelService.tick(session: Session, dt: number)
	trainingTick(session, dt)
	PricingService.tick(session, dt) -- auto-price scheduling; the forecasts run in PricingService's frame worker
end

-- Debug: Training sofort abschließen
function AIModelService.finishNow(session: Session): boolean
	local training = session.data.training
	if not training then
		return false
	end
	local event = training.event
	if event and event.pending then
		local def = ModelConfig.getEvent(event.id)
		if def then
			autoResolve(session, training, def)
		end
	end
	training.workDone = training.workTotal
	updateLoss(session, training)
	finish(session, training)
	return true
end

local function startTraining(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local recipeId=if payload.recipeId==nil then "steady" else Guard.id(payload.recipeId)
	if not recipeId or not ModelConfig.getRecipe(recipeId) then return {ok=false,err="BAD_INPUT"} end
	if session.data.training then
		return { ok = false, err = "TRAINING_ACTIVE" }
	end
	local name = Guard.text(payload.name, GameConfig.MODEL_NAME_MIN, GameConfig.MODEL_NAME_MAX)
	if not name then
		return { ok = false, err = "BAD_NAME" }
	end
	local sizeId = Guard.id(payload.sizeId)
	local focusId = Guard.id(payload.focusId)
	local size = if sizeId then ModelConfig.getSize(sizeId) else nil
	local focus = if focusId then ModelConfig.getFocus(focusId) else nil
	if not size or not focus then
		return { ok = false, err = "BAD_INPUT" }
	end

	if size.id == "s7b" and not session.data.empire.research.frontier then
		return {ok=false, err="PREREQUISITE"}
	end
	if ModelMath.activeModels(session.data) &gt;= modelLimit() then return {ok=false, err="MODEL_LIMIT"} end
	local plan = ModelMath.plan(size, ModelMath.fleet(session.data.gpus), ModelMath.dataSummary(session.data.data),recipeId)
	if not plan.ok then
		return { ok = false, err = plan.reason }
	end
	if session.data.money &lt; plan.cost then
		return { ok = false, err = "NO_MONEY" }
	end

	local filtered = TextFilter.forBroadcast(name, session.userId) -- yieldet
	if filtered == nil then
		return { ok = false, err = "FILTER_DOWN" }
	end
	if filtered ~= name then
		return { ok = false, err = "NAME_FILTERED" }
	end

	-- Nach dem Yield alles neu prüfen: zweite Anfrage, GPU verkauft, Geld ausgegeben, Spieler weg
	if session.closed then
		return { ok = false, err = "LOADING" }
	end
	local data = session.data
	if data.training then
		return { ok = false, err = "TRAINING_ACTIVE" }
	end
	local fleet = ModelMath.fleet(data.gpus)
	local summary = ModelMath.dataSummary(data.data)
	plan = ModelMath.plan(size, fleet, summary,recipeId)
	if not plan.ok then
		return { ok = false, err = plan.reason }
	end
	if ModelMath.activeModels(data) &gt;= modelLimit() then return {ok=false, err="MODEL_LIMIT"} end
	if not EconomyService.spend(session, plan.cost, "training") then
		return { ok = false, err = "NO_MONEY" }
	end

	local expectedStats, expected = ModelMath.computeStats(size.id, focus.id, summary, specOf(session), ModelMath.recipeFactor(size,summary,recipeId), nil)
	expectedStats, expected = EmpireMath.boostStats(expectedStats, data.empire)
	expectedStats, expected = ModelMath.capStats(expectedStats)
	local id = HttpService:GenerateGUID(false)
	local model: Types.ModelData = {
		id = id,
		name = name,
		version = versionFor(data, name),
		sizeId = size.id,
		focusId = focus.id,
		status = "training",
		createdAt = os.time(),
		trainedAt = nil,
		stats = {},
		overall = 0,
		trainCost = plan.cost,
		dataUsed = summary,
		release = nil,
		market = nil,
	}
	data.models[id] = model
	table.insert(data.modelOrder, id)
	pruneRetired(data)

	local training: TrainingState = {
		modelId = id,
		workTotal = plan.work,
		workDone = 0,
		cost = plan.cost,
		expected = expected,
		qualityMod = ModelMath.recipeFactor(size,summary,recipeId),
		eventRolled = false,
		event = nil,
		epoch = 0,
		loss = { math.round(ModelMath.lossAt(0, expected, 0) * 1000) / 1000 },
		log = {},
	}
	addLog(training, `Allocating {fleet.vram} GB VRAM for {size.label} params`)
	addLog(training, `Tokenizing {Format.tokens(summary.total)} tokens`)
	addLog(training, "Training started")
	data.training = training

	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true, modelId = id }
end

local function improveModel(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local data = session.data
	if data.training then return {ok=false,err="TRAINING_ACTIVE"} end
	local id = Guard.id(payload.modelId)
	local model = if id then data.models[id] else nil
	if not model or (model.status ~= "trained" and model.status ~= "live") then return {ok=false,err="BAD_MODEL"} end
	if (tonumber(model.iterations) or 0) &gt;= ModelConfig.REFINE.limit then return {ok=false,err="REFINE_LIMIT"} end
	local summary = ModelMath.dataSummary(data.data)
	if summary.total &lt; model.dataUsed.total + 1e8 then return {ok=false,err="NEW_DATA"} end
	local size = ModelConfig.getSize(model.sizeId)
	if not size then return {ok=false,err="BAD_MODEL"} end
	local plan = ModelMath.plan(size, ModelMath.fleet(data.gpus), summary)
	if not plan.ok then return {ok=false,err=plan.reason} end
	local refine = ModelMath.refinePlan(model, plan)
	if not refine.ok then return {ok=false,err=refine.err} end
	local cost = refine.cost
	if not EconomyService.spend(session,cost,"refine") then return {ok=false,err="NO_MONEY"} end
	local resume = model.status == "live"
	local base = table.clone(model.stats)
	model.dataUsed = summary
	if not resume then model.status = "training" end -- a live model keeps serving its current version
	data.training = {modelId=model.id,refinement=true,baseStats=base,resumeLive=resume,
		workTotal=refine.work,workDone=0,cost=cost,expected=math.min(ModelConfig.STAT_CAP,model.overall+5),
		qualityMod=1,eventRolled=false,event=nil,epoch=0,loss={ModelMath.lossAt(0,model.overall,0)},
		log={if resume then "Refinement: fresh data + your own checkpoint. Serving continues with the current version." else "Refinement: fresh data + your own checkpoint.",
			`Refinement {refine.runs + 1} of {refine.limit}. Every stat stays at most {ModelConfig.STAT_CAP}.`}}
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return {ok=true,modelId=model.id}
end

local function resolveEvent(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local training = session.data.training
	local event = if training then training.event else nil
	if not training or not event or not event.pending then
		return { ok = false, err = "NO_EVENT" }
	end
	local def = ModelConfig.getEvent(event.id)
	local choiceId = Guard.id(payload.choice)
	local choice = if def and choiceId then ModelConfig.getChoice(def, choiceId) else nil
	if not choice then
		return { ok = false, err = "BAD_INPUT" }
	end
	local err = applyChoice(session, training, choice, false)
	if err then
		return { ok = false, err = err }
	end
	SessionService.markDirty(session)
	return { ok = true, outcome = event.outcome }
end

local function parsePrices(payload: ServerTypes.Payload): (number?, number?)
	local sub = Guard.number(payload.subPrice, 0, 1000)
	local api = Guard.number(payload.apiPrice, MarketConfig.API_PRICE.min, MarketConfig.API_PRICE.max)
	if sub == nil or not MarketConfig.isSubPrice(sub) or api == nil then
		return nil, nil
	end
	return sub, Guard.snap(api, MarketConfig.API_PRICE.step)
end

local function modelFromPayload(session: Session, payload: ServerTypes.Payload): Types.ModelData?
	local id = Guard.id(payload.modelId)
	return if id then session.data.models[id] else nil
end

-- Release a trained model into a product line (CORE_SPEC 7.1/7.2/7.7).
-- payload: modelId, target, marketing, auto (default true), subPrice/apiPrice (needed when auto == false).
-- auto: the server picks the Recommended price (forecast-best menu price) and keeps auto-pricing the model;
-- otherwise the player's prices are used and auto-price is off for this model.
local function releaseModel(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local model = modelFromPayload(session, payload)
	if not model or model.status ~= "trained" then
		return { ok = false, err = "BAD_MODEL" }
	end
	local auto = payload.auto ~= false
	local sub, api = parsePrices(payload)
	local marketingRaw = Guard.number(payload.marketing, 0, MarketConfig.MARKETING.max)
	local target = Guard.id(payload.target)
	if (not auto and (sub == nil or api == nil)) or marketingRaw == nil or not target or not MarketConfig.isTarget(target) then
		return { ok = false, err = "BAD_INPUT" }
	end
	if payload.auto ~= nil and typeof(payload.auto) ~= "boolean" then
		return { ok = false, err = "BAD_INPUT" }
	end
	local data = session.data
	local marketing = math.min(Guard.snap(marketingRaw, MarketConfig.MARKETING.step), MarketConfig.MARKETING.max)
	local function precheck(): string?
		if model.status ~= "trained" or data.models[model.id] ~= model then
			return "BAD_MODEL"
		end
		local check = ModelMath.releaseCheck(data, model.id, target)
		if not check.ok then
			return check.err or "LINE_LIMIT"
		end
		if marketing &gt; 0 and data.money &lt; marketing then -- free releases work in debt, as EconomyService.spend(0)
			return "NO_MONEY"
		end
		return nil
	end
	local err = precheck()
	if err then
		return { ok = false, err = err }
	end
	if auto then
		-- the forecast runs over a few frames (one menu price per frame): re-check everything afterwards
		local choice = PricingService.recommend(session, model, target, marketing, true)
		sub, api = choice.sub, choice.api
		if session.closed then
			return { ok = false, err = "LOADING" }
		end
		err = precheck()
		if err then
			return { ok = false, err = err }
		end
	end
	if sub == nil or api == nil then
		return { ok = false, err = "BAD_INPUT" }
	end
	if not EconomyService.spend(session, marketing, "marketing") then
		return { ok = false, err = "NO_MONEY" }
	end
	local check = ModelMath.releaseCheck(data, model.id, target)

	model.status = "live"
	local release: any = {
		subPrice = sub,
		apiPrice = api,
		marketing = marketing,
		target = target,
		releasedAt = os.time(),
		auto = auto,
	}
	model.release = release
	model.market = PricingMath.releaseMarket(target, marketing, check.replaced)
	-- one live model per line: the predecessor(s) retire, their users moved over (not wiped)
	local predecessor = check.replaced[1]
	for _, old in check.replaced do
		old.status = "retired"
		;(old :: any).replacedBy = model.id
		clearMarket(old)
	end
	data.stats.modelsReleased += 1
	data.stats.bestOverall = math.max(data.stats.bestOverall, model.overall)
	if predecessor then
		news(session, `{model.name} v{model.version} replaces {predecessor.name} v{predecessor.version} ({lineLabel(target)}, {math.floor(ModelConfig.MIGRATE * 100 + 0.5)}% of users move)`)
	else
		news(session, `{model.name} v{model.version} launched as {lineLabel(target)}`)
	end
	SessionService.markDirty(session)
	Remote.fire(session.player, "Notify", "MODEL_LIVE", {
		modelId = model.id,
		replacedId = if predecessor then predecessor.id else nil,
		line = check.line,
	})
	return { ok = true, subPrice = sub, apiPrice = api, auto = auto, replacedId = if predecessor then predecessor.id else nil }
end

-- Auto-price on/off for one live model (EmpireAction {action="autoPrice"} delegates here; UpdatePricing
-- {auto = bool} is the same switch). Switching it on re-prices the model on the next tick.
function AIModelService.setAutoPrice(session: Session, modelId: any, on: any): ServerTypes.Result
	local id = Guard.id(modelId)
	local model = if id then session.data.models[id] else nil
	local release = if model then model.release else nil
	if not model or model.status ~= "live" or not release then
		return { ok = false, err = "BAD_MODEL" }
	end
	if typeof(on) ~= "boolean" then
		return { ok = false, err = "BAD_INPUT" }
	end
	;(release :: any).auto = on
	if on then
		PricingService.schedule(session, model.id)
	end
	SessionService.markDirty(session)
	return { ok = true, auto = on }
end

-- A manual price switches auto-price off for that model (CORE_SPEC 7.7). {modelId, auto = bool} without
-- prices only toggles auto-price.
local function updatePricing(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local model = modelFromPayload(session, payload)
	local release = if model then model.release else nil
	if not model or model.status ~= "live" or not release then
		return { ok = false, err = "BAD_MODEL" }
	end
	if payload.subPrice == nil and payload.apiPrice == nil and payload.auto ~= nil then
		return AIModelService.setAutoPrice(session, model.id, payload.auto)
	end
	local sub, api = parsePrices(payload)
	if sub == nil or api == nil then
		return { ok = false, err = "BAD_INPUT" }
	end
	release.subPrice = sub
	release.apiPrice = api
	;(release :: any).auto = false
	SessionService.markDirty(session)
	return { ok = true, auto = false }
end

local function retireModel(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local model = modelFromPayload(session, payload)
	if not model or model.status ~= "live" then
		return { ok = false, err = "BAD_MODEL" }
	end
	model.status = "retired"
	clearMarket(model)
	SessionService.markDirty(session)
	return { ok = true }
end

-- Reviewing a server-owned benchmark records the tutorial step without changing model scores.
local function evaluateModel(session: Session,payload: ServerTypes.Payload): ServerTypes.Result
 local model=modelFromPayload(session,payload)
 if not model or model.status=="training" then return {ok=false,err="BAD_MODEL"} end
 session.data.empire.quests.journey_evaluation=true;SessionService.markDirty(session)
 return {ok=true,modelId=model.id}
end
function AIModelService.init()
 Remote.bind("EvaluateModel",{burst=2,perSecond=.5,company=true},evaluateModel)
	Remote.bind("ImproveModel", {burst=2,perSecond=0.5,company=true}, improveModel)
	Remote.bind("StartTraining", { burst = 3, perSecond = 0.5, company = true }, startTraining)
	Remote.bind("ResolveEvent", { burst = 4, perSecond = 1, company = true }, resolveEvent)
	Remote.bind("ReleaseModel", { burst = 3, perSecond = 0.5, company = true }, releaseModel)
	Remote.bind("UpdatePricing", { burst = 8, perSecond = 3, company = true }, updatePricing)
	Remote.bind("RetireModel", { burst = 3, perSecond = 0.5, company = true }, retireModel)
	PricingService.init()
end

return AIModelService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">CompanyService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Firmengründung. Name wird geprüft (Guard) und durch den Roblox-Textfilter geschickt,
-- weil andere Spieler ihn auf dem Firmenschild sehen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local CompanyConfig = require(ReplicatedStorage.Shared.Config.CompanyConfig)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local TextFilter = require(script.Parent.Parent.Lib.TextFilter)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local PlotService = require(script.Parent.PlotService)

type Session = ServerTypes.Session

local CompanyService = {}

local function createCompany(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	if session.data.company then
		return { ok = false, err = "ALREADY_FOUNDED" }
	end
	local name = Guard.text(payload.name, GameConfig.COMPANY_NAME_MIN, GameConfig.COMPANY_NAME_MAX)
	if not name then
		return { ok = false, err = "BAD_NAME" }
	end
	local logo = payload.logo
	if typeof(logo) ~= "string" or not CompanyConfig.isLogo(logo) then
		return { ok = false, err = "BAD_INPUT" }
	end
	local colorId = Guard.id(payload.color)
	local specId = Guard.id(payload.spec)
	if not colorId or not CompanyConfig.getColor(colorId) or not specId or not CompanyConfig.getSpec(specId) then
		return { ok = false, err = "BAD_INPUT" }
	end

	local filtered = TextFilter.forBroadcast(name, session.userId) -- yieldet
	if filtered == nil then
		return { ok = false, err = "FILTER_DOWN" }
	end
	if filtered ~= name then
		return { ok = false, err = "NAME_FILTERED" }
	end
	-- Während des Yields kann eine zweite Anfrage durchgelaufen oder der Spieler gegangen sein
	if session.closed or session.data.company then
		return { ok = false, err = "ALREADY_FOUNDED" }
	end

	session.data.company = {
		name = name,
		logo = logo,
		color = colorId,
		spec = specId,
		foundedAt = os.time(),
		reputation = 0,
	}
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true }
end

function CompanyService.init()
	Remote.bind("CreateCompany", { burst = 3, perSecond = 0.2 }, createCompany)
end

return CompanyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">ComputeService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Compute: GPUs kaufen/verkaufen. Das Rack hat RACK_SLOTS Plätze, der Start-Laptop belegt keinen.
-- Verkaufen während eines Trainings nur, solange der restliche VRAM den laufenden Job noch trägt.
-- Rack slots per office stage: HardwareConfig.slots (3 / 6 / 12 / 24 / 48, x1.5 with Distributed Cluster).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardwareConfig = require(ReplicatedStorage.Shared.Config.HardwareConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local ModelConfig = require(ReplicatedStorage.Shared.Config.ModelConfig)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)

type Session = ServerTypes.Session

local ComputeService = {}

local function gpuFromPayload(payload: ServerTypes.Payload): HardwareConfig.GPUDef?
	local gpuId = Guard.id(payload.gpuId)
	local gpu = if gpuId then HardwareConfig.getGPU(gpuId) else nil
	if not gpu or gpu.starter then
		return nil
	end
	return gpu
end

local function buyGPU(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local gpu = gpuFromPayload(payload)
	if not gpu then
		return { ok = false, err = "BAD_INPUT" }
	end
	if ModelMath.fleet(session.data.gpus).slotsUsed &gt;= HardwareConfig.slots(session.data.empire) then
		return { ok = false, err = "RACK_FULL" }
	end
	if not EconomyService.spend(session, gpu.price, "gpu") then
		return { ok = false, err = "NO_MONEY" }
	end
	session.data.gpus[gpu.id] = (session.data.gpus[gpu.id] or 0) + 1
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true }
end

local function sellGPU(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local gpu = gpuFromPayload(payload)
	if not gpu then
		return { ok = false, err = "BAD_INPUT" }
	end
	if session.data.empire.projectJob then return {ok=false,err="PROJECT_ACTIVE"} end
	if session.data.training then
		-- allowed while the remaining VRAM still fits the running job (CORE_SPEC: GPU swaps when servers are full)
		local job = session.data.models[session.data.training.modelId or ""]
		local size = job and ModelConfig.getSize(job.sizeId)
		local left = table.clone(session.data.gpus)
		left[gpu.id] = (left[gpu.id] or 0) - 1
		if not size or ModelMath.fleet(left).vram &lt; size.vram then
			return { ok = false, err = "TRAINING_ACTIVE" }
		end
	end
	local owned = session.data.gpus[gpu.id] or 0
	if owned &lt;= 0 then
		return { ok = false, err = "NOT_OWNED" }
	end
	if owned &gt; 1 then
		session.data.gpus[gpu.id] = owned - 1
	else
		(session.data.gpus :: any)[gpu.id] = nil -- Eintrag entfernen statt 0 speichern
	end
	EconomyService.grant(session, math.floor(gpu.price * HardwareConfig.SELL_REFUND), "gpusale")
	SessionService.markDirty(session)
	PlotService.refresh(session)
	return { ok = true }
end

local function setShare(s: any,p: any): any
	local share=Guard.number(p.share,.25,.9)
	if not share then return {ok=false,err="BAD_INPUT"} end
	s.data.empire.infrastructure.trainingShare=share;SessionService.markDirty(s);return {ok=true}
end
local function cooling(s: any,_p: any): any
	local level=s.data.empire.infrastructure.cooling
	if level&gt;=8 then return {ok=false,err="MAX_COOLING"} end
	if not EconomyService.spend(s,math.floor(8000*1.7^(level-1)),"cooling") then return {ok=false,err="NO_MONEY"} end
	s.data.empire.infrastructure.cooling+=1;SessionService.markDirty(s);PlotService.refresh(s);return {ok=true}
end
function ComputeService.init()
	Remote.bind("SetComputeShare",{burst=3,perSecond=1,company=true},setShare)
	Remote.bind("UpgradeCooling",{burst=2,perSecond=.5,company=true},cooling)
	Remote.bind("BuyGPU", { burst = 4, perSecond = 2, company = true }, buyGPU)
	Remote.bind("SellGPU", { burst = 4, perSecond = 2, company = true }, sellGPU)
end

return ComputeService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">DatasetService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Trainingsdaten: kostenlos scrapen (langsam, schlecht) oder Pakete kaufen.
-- Preise und Mengen kommen nur aus DataConfig – der Client schickt nur Paket-ID und Anzahl.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataConfig = require(ReplicatedStorage.Shared.Config.DataConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)

type Session = ServerTypes.Session

local DatasetService = {}

local function scrape(session: Session, _payload: ServerTypes.Payload): ServerTypes.Result
	local now = workspace:GetServerTimeNow()
	local remaining = session.data.lastScrapeAt + DataConfig.SCRAPE.cooldown - now
	if remaining &gt; 0 then
		return { ok = false, err = "COOLDOWN", wait = remaining }
	end
	session.data.lastScrapeAt = now
	ModelMath.addTokens(session.data.data, DataConfig.SCRAPE.type, DataConfig.SCRAPE.tokens, DataConfig.SCRAPE.quality)
	SessionService.markDirty(session)
	return { ok = true, tokens = DataConfig.SCRAPE.tokens }
end

local function buyData(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local packId = Guard.id(payload.packId)
	local pack = if packId then DataConfig.getPack(packId) else nil
	local count = Guard.integer(payload.count, 1, DataConfig.MAX_BUY)
	if not pack or not count then
		return { ok = false, err = "BAD_INPUT" }
	end
	if not EconomyService.spend(session, pack.price * count, "data") then
		return { ok = false, err = "NO_MONEY" }
	end
	ModelMath.addTokens(session.data.data, pack.type, pack.tokens * count, pack.quality)
	SessionService.markDirty(session)
	return { ok = true, tokens = pack.tokens * count }
end

function DatasetService.init()
	Remote.bind("Scrape", { burst = 3, perSecond = 0.5, company = true }, scrape)
	Remote.bind("BuyData", { burst = 6, perSecond = 3, company = true }, buyData)
end

return DatasetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">DebugService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Debug-Befehle zum Testen. Nur in Studio oder für UserIds in GameConfig.DEV_USER_IDS.
-- Befehle: money (+$100K), data (+10B Tokens je Typ, Qualität 80 %), finish (Training sofort fertig),
-- rep (+25 Reputation), reset (Spielstand auf Start zurücksetzen; Robux-Käufe data.shop bleiben).
-- Nur in Studio (nie live, auch nicht für DEV_USER_IDS): pass {key} setzt ein Game-Pass-Flag für diese
-- Sitzung (nicht gespeichert), voucher {key} schreibt einen Gutschein gut (ShopConfig-Schlüssel).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local DataConfig = require(ReplicatedStorage.Shared.Config.DataConfig)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local Template = require(script.Parent.Parent.Lib.Template)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local AIModelService = require(script.Parent.AIModelService)
local ShopService = require(script.Parent.ShopService)

type Session = ServerTypes.Session

local DebugService = {}

function DebugService.allowed(userId: number): boolean
	return RunService:IsStudio() or table.find(GameConfig.DEV_USER_IDS, userId) ~= nil
end

local function run(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	if not DebugService.allowed(session.userId) then
		return { ok = false, err = "NOT_ALLOWED" }
	end
	local cmd = Guard.id(payload.cmd)
	if cmd == "money" then
		EconomyService.grant(session, 100_000, "debug")
	elseif cmd == "data" then
		for _, dataType in DataConfig.TYPES do
			ModelMath.addTokens(session.data.data, dataType.id, 1e10, 0.8)
		end
	elseif cmd == "finish" then
		if not AIModelService.finishNow(session) then
			return { ok = false, err = "NO_TRAINING" }
		end
	elseif cmd == "rep" then
		local company = session.data.company
		if company then
			company.reputation = math.min(100, company.reputation + 25)
		end
	elseif cmd == "reset" then
		-- Robux purchases (receipts, vouchers, pass cache) are real money: never reset them
		local shop = (session.data :: any).shop
		session.data = Template.new()
		if shop ~= nil then
			(session.data :: any).shop = shop
		end
		-- reset the market numbers in place: live also carries fields other services own and set
		-- only on change (admin, shop, workforce ...); replacing the table would drop them
		local live = session.live
		live.users = 0
		live.revenue = 0
		live.cost = 0
		live.perModel = {}
		live.npcUsers = {}
		-- company summaries of CompanyOps / EmpireService: rewritten on the next company tick
		local extra = live :: any
		extra.ops = nil
		extra.compute = nil
		extra.waitlist = 0
		extra.load = 0
		extra.demand = 0
		PlotService.refresh(session)
	elseif cmd == "pass" or cmd == "voucher" then
		if not RunService:IsStudio() then
			return { ok = false, err = "NOT_ALLOWED" }
		end
		local key = Guard.id(payload.key)
		local granted = if key == nil then false
			elseif cmd == "pass" then ShopService.debugGrantPass(session, key)
			else ShopService.debugGrantVoucher(session, key)
		if not granted then
			return { ok = false, err = "BAD_INPUT" }
		end
	else
		return { ok = false, err = "BAD_INPUT" }
	end
	SessionService.markDirty(session)
	print(`[Debug] {session.player.Name}: {cmd}`)
	return { ok = true }
end

function DebugService.init()
	Remote.bind("Debug", { burst = 8, perSecond = 4 }, run)
end

return DebugService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">EconomyService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Geld wird nur hier verändert. Der Client nennt nie Beträge, die er bekommt –
-- alle Preise kommen aus den Configs auf dem Server.
-- P&amp;L ledger (CORE_SPEC 4, Appendix A): every flow with a category is added to
-- data.empire.ledger[tostring(company day)] = { i = income by category, o = costs by category }.
-- Whole dollars are stored (small JSON); the fractions are carried in memory per category.
-- At most LEDGER_DAYS days and LEDGER_CATEGORIES categories per side and day (overflow -&gt; "other").
-- spend / grant without a category are booked as "other", so the ledger always adds up to the change in
-- cash (applyFlow's default is "market").

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CompanyOps = require(ReplicatedStorage.Shared.CompanyOps)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local SessionService = require(script.Parent.SessionService)

type Session = ServerTypes.Session

local EconomyService = {}
EconomyService.LEDGER_DAYS = CompanyOps.LEDGER_DAYS
EconomyService.LEDGER_CATEGORIES = CompanyOps.LEDGER_CATEGORIES

local function valid(amount: number): boolean
	return amount == amount and amount &gt;= 0 and amount &lt; math.huge
end

-- fractional remainders per empire table: carry[e]["i:market"] = 0.37
local carry: { [any]: { [string]: number } } = setmetatable({}, { __mode = "k" }) :: any

local function book(session: Session, side: string, category: string, amount: number)
	if amount &lt;= 0 or typeof(category) ~= "string" then
		return
	end
	local e = (session.data :: any).empire
	if typeof(e) ~= "table" then
		return
	end
	local cal = e.calendar
	local day = if typeof(cal) == "table" and typeof(cal.day) == "number" then math.max(1, math.floor(cal.day)) else 1
	local ledger = e.ledger
	if typeof(ledger) ~= "table" then
		ledger = {}
		e.ledger = ledger
	end
	local key = tostring(day)
	local entry = ledger[key]
	if typeof(entry) ~= "table" then
		entry = { i = {}, o = {} }
		ledger[key] = entry
		-- keep the newest LEDGER_DAYS days
		local keys = {}
		for k in ledger do
			local n = tonumber(k)
			if n then table.insert(keys, n) else ledger[k] = nil end
		end
		table.sort(keys, function(a: number, b: number): boolean return a &gt; b end)
		for i = EconomyService.LEDGER_DAYS + 1, #keys do
			ledger[tostring(keys[i])] = nil
		end
	end
	local map = entry[side]
	if typeof(map) ~= "table" then
		map = {}
		entry[side] = map
	end
	local cat = string.sub(category, 1, 16)
	if map[cat] == nil and cat ~= "other" then
		-- at most LEDGER_CATEGORIES lines per side and day, "other" included
		local n = 0
		for key in map do
			if key ~= "other" then
				n += 1
			end
		end
		if n &gt;= EconomyService.LEDGER_CATEGORIES - 1 then
			cat = "other"
		end
	end
	local c = carry[e]
	if not c then
		c = {}
		carry[e] = c
	end
	local slot = side .. ":" .. cat
	local total = (c[slot] or 0) + amount
	local whole = math.floor(total)
	c[slot] = total - whole
	if whole &gt; 0 or map[cat] == nil then
		map[cat] = (map[cat] or 0) + whole
	end
end
EconomyService.book = book

-- Zieht `amount` ab, wenn genug da ist. Ein negatives Konto blockiert alle Ausgaben &gt; 0.
-- category (optional, default "other"): the cost line of the P&amp;L ledger.
function EconomyService.spend(session: Session, amount: number, category: string?): boolean
	if not valid(amount) then
		return false
	end
	if amount == 0 then
		return true -- kostenlose Aktionen (z. B. Release ohne Marketing) gehen auch mit Schulden
	end
	if session.data.money &lt; amount then
		return false
	end
	session.data.money -= amount
	session.data.stats.totalCost += amount
	book(session, "o", category or "other", amount)
	SessionService.markDirty(session)
	return true
end

-- category (optional, default "other"): the income line of the P&amp;L ledger.
function EconomyService.grant(session: Session, amount: number, category: string?)
	if not valid(amount) then
		return
	end
	session.data.money += amount
	book(session, "i", category or "other", amount)
	SessionService.markDirty(session)
end

-- Laufende Einnahmen/Kosten (pro Tick). Darf ins Minus gehen. category (optional, default "market"):
-- the ledger line of CORE_SPEC 4 (market, b2b, pilot, studio, guest, wages, ops, upkeep, food, fleet,
-- trips, b2bserve, jet, ...). Revenue counts toward totalRevenue (pilot fees included).
function EconomyService.applyFlow(session: Session, revenue: number, cost: number, category: string?)
	if not valid(revenue) or not valid(cost) then
		return
	end
	session.data.money += revenue - cost
	session.data.stats.totalRevenue += revenue
	session.data.stats.totalCost += cost
	local cat = category or "market"
	if revenue &gt; 0 then
		book(session, "i", cat, revenue)
	end
	if cost &gt; 0 then
		book(session, "o", cat, cost)
	end
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">MarketService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One server economy: shared consumer/API demand (MarketMath, CORE_SPEC 3.1) and paid player API access.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local CompanyConfig = require(Shared.Config.CompanyConfig)
local GameConfig = require(Shared.Config.GameConfig)
local MarketConfig = require(Shared.Config.MarketConfig)
local ModelMath = require(Shared.ModelMath)
local MarketMath = require(Shared.MarketMath)
local EmpireMath = require(Shared.EmpireMath)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local Remote = require(script.Parent.Parent.Lib.Remote)
local Guard = require(script.Parent.Parent.Lib.Guard)
local SessionService = require(script.Parent.SessionService)
local Economy = require(script.Parent.EconomyService)
local NPC=require(script.Parent.NPCService)
local Ops=require(Shared.CompanyOps)
local Market = {offers = {} :: {any}, customers = {} :: {any}}
local clock = 0
-- CORE_SPEC 3.2: the server-wide lease auction is removed. Business clients are per company
-- (CompanyOps B2B pipeline: field reps, trips, trust, daily retainers), so players never race for them.
local function all(): {any}
	local list = {}
	for _, s in SessionService.all() do
		if not s.closed and s.data.company then table.insert(list,s) end
	end
	for _, n in NPC.sessions do table.insert(list,n) end
	table.sort(list,function(a,b) return a.userId &lt; b.userId end)
	return list
end
local function seller(id: number): any
	for _, s in all() do if s.userId == id then return s end end
	return nil
end
local function entry(s: any, model: any): any
	return {id=model.id,stats=model.stats,sizeId=model.sizeId,subPrice=model.release.subPrice,
		apiPrice=model.release.apiPrice,market=model.market,target=model.release.target,player=not s.isNPC,company=s.userId}
end
-- Investor Relations pass (ShopService, CORE_SPEC 11.7): own market revenue x INVESTOR_MULTIPLIER after the
-- shares are computed, so it never changes another player's share; never applied to B2B. Required lazily.
local shop: any = nil
local function shopFactor(session: any): number
	if session.isNPC then return 1 end
	if shop == nil then
		local module = script.Parent:FindFirstChild("ShopService")
		shop = if module then (require :: any)(module) else false
	end
	if shop and typeof(shop.revenueMultiplier) == "function" then
		local ok, factor = pcall(shop.revenueMultiplier, session)
		if ok and typeof(factor) == "number" and factor == factor then return factor end
	end
	return 1
end
local function invoice(s: any, text: string, amount: number)
	table.insert(s.data.empire.invoices,1,{time=os.time(),text=text,amount=amount})
	while #s.data.empire.invoices&gt;20 do table.remove(s.data.empire.invoices) end
end
function Market.accessPrice(model: any): number
	return math.max(100,math.floor(model.release.subPrice*100 + model.release.apiPrice*50))
end
local function transfer(buyer: any, provider: any, model: any, fee: number, auto: boolean): boolean
	-- No yielding between the two ledger writes. Prices are server derived, never client supplied.
	if not Economy.spend(buyer,fee,"api") then return false end
	Economy.applyFlow(provider,fee,0,"api")
	buyer.data.empire.subscriptions = {providerId=provider.userId,modelId=model.id,
		provider=provider.data.company.name,name=model.name,score=model.overall,stats=table.clone(model.stats),
		price=fee,expires=os.time()+GameConfig.GAME_MONTH_SECONDS,autoRenew=auto}
	invoice(buyer,"API access: "..model.name,-fee)
	invoice(provider,"API customer: "..buyer.data.company.name,fee)
	SessionService.markDirty(buyer); SessionService.markDirty(provider)
	return true
end
local function buy(buyer: any, payload: any): any
	local providerId = Guard.integer(payload.providerId,-100000003,1e12)
	local modelId = Guard.id(payload.modelId)
	if not providerId or not modelId then return {ok=false,err="BAD_INPUT"} end
	if providerId==0 or providerId==buyer.userId then return {ok=false,err="SELF_PURCHASE"} end
	local sub = buyer.data.empire.subscriptions
	if sub.expires and sub.expires&gt;os.time() then return {ok=false,err="ACCESS_ACTIVE"} end
	local provider = seller(providerId)
	if not provider then return {ok=false,err="SELLER_OFFLINE"} end
	local model = provider.data.models[modelId]
	if not model or model.status~="live" or not model.release then return {ok=false,err="BAD_MODEL"} end
	local fee = Market.accessPrice(model)
	if payload.quotedPrice~=fee then return {ok=false,err="QUOTE_CHANGED"} end
	if not transfer(buyer,provider,model,fee,payload.autoRenew==true) then return {ok=false,err="NO_MONEY"} end
	return {ok=true}
end
local function cancel(buyer: any, _payload: any): any
	buyer.data.empire.subscriptions.autoRenew=false
	SessionService.markDirty(buyer)
	return {ok=true}
end
-- Version age shown on a marketplace offer (client release forecast, CORE_SPEC 7.7): whole OFFER_AGE_STEP
-- seconds, compared lazily (SessionService.LAZY): -8 fit at most over 3600 s, so a 30 s step moves the age
-- penalty by &lt; 0.07 fit points while the offers stay cheap to replicate (CORE_SPEC 11.8).
Market.OFFER_AGE_STEP = 30
function Market.offerAge(market: any): number
	local vage = tonumber(market and market.vage) or 0
	return math.floor(math.max(0, vage) / Market.OFFER_AGE_STEP) * Market.OFFER_AGE_STEP
end
function Market.tickGlobal(dt: number)
	clock += dt
	local offers = {}
	local sessions = all()
	for _, s in sessions do
		for _, id in s.data.modelOrder do
			local m = s.data.models[id]
			if m and m.status=="live" and m.release and m.market then
				table.insert(offers,{providerId=s.userId,company=s.data.company.name,id=id,name=m.name,
					overall=m.overall,stats=m.stats,sub=m.release.subPrice,api=m.release.apiPrice,
					price=Market.accessPrice(m),users=MarketMath.totalUsers(m.market),iterations=m.iterations or 0,
					target=m.release.target,npc=s.isNPC==true,vage=Market.offerAge(m.market)})
			end
		end
		local sub=s.data.empire.subscriptions
		if sub.expires and sub.expires&lt;=os.time() then
			local provider = seller(sub.providerId)
			local model = if provider then provider.data.models[sub.modelId] else nil
			if sub.autoRenew and model and model.status=="live" and Market.accessPrice(model)==sub.price then
				if not transfer(s,provider,model,sub.price,true) then sub.autoRenew=false end
			else sub.autoRenew=false end
		end
	end
	table.sort(offers,function(a,b)
		if a.overall~=b.overall then return a.overall&gt;b.overall end
		if a.providerId~=b.providerId then return a.providerId&lt;b.providerId end
		return a.id&lt;b.id
	end)
	Market.offers=offers
	Market.customers={} -- compatibility: the lease auction is gone (CompanyOps clients are per company)
	for _, s in NPC.sessions do Market.tick(s,dt) end
end
function Market.tick(session: any, dt: number)
	local data = session.data
	local company = data.company
	if not company then return end
	local entries, rivals = {}, {}
	for _, s in all() do
		for _, id in s.data.modelOrder do
			local m = s.data.models[id]
			if m and m.status=="live" and m.release and m.market then
				table.insert(if s==session then entries else rivals,entry(s,m))
			end
		end
	end
	-- stage reach cap, serving capacity (users) and the Growth &amp; Sales reach cap of this company
	local stage=math.clamp(math.floor(tonumber(data.empire.office) or 1),1,#(MarketConfig.STAGE_REACH or {1}))
	local opts={stage=stage,capacity=Ops.capacity(data),reachCap=Ops.reachCap(data,(MarketConfig.STAGE_REACH or {})[stage] or MarketConfig.REACH.max)}
	local live=MarketMath.tick(entries,company.reputation,company.spec,dt,rivals,if #NPC.sessions&gt;0 then {} else nil,opts)
	local b=EmpireMath.bonuses(data.empire)
	local cycle=EmpireConfig.cycle(workspace:GetServerTimeNow())
	local factor=b.revenue*cycle.revenue*shopFactor(session)
	live.revenue*=factor; live.cost*=b.serving*cycle.cost
	for _, r in live.perModel do r.revenue*=factor; r.cost*=b.serving*cycle.cost end
	-- Electricity while serving is distinct from the upfront training electricity budget.
	local fleet=ModelMath.fleet(data.gpus)
	if #entries&gt;0 then live.cost+=fleet.throughput*0.025 end
	live.marketplace={offers=Market.offers,customers=Market.customers}
	-- Merge, never replace: session.live also carries fields other services own (workforce from
	-- StaffService, admin from AdminService, campus, empire, studio, arena, rankings ...).
	local current=session.live :: any
	for key,value in live :: any do current[key]=value end
	Economy.applyFlow(session,live.revenue*dt,live.cost*dt,"market")
	local oldRank=CompanyConfig.rankFor(data.stats.peakUsers)
	data.stats.peakUsers=math.max(data.stats.peakUsers,live.users)
	company.reputation=MarketMath.reputationStep(company.reputation,live.users,data.stats.bestOverall,dt)
	if #entries&gt;0 then SessionService.markDirty(session) end
	local newRank=CompanyConfig.rankFor(data.stats.peakUsers)
	if newRank~=oldRank then Remote.fire(session.player,"Notify","RANK_UP",{rank=newRank}) end
end
function Market.init()
	Remote.bind("BuyModelAccess",{burst=2,perSecond=0.5,company=true},buy)
	Remote.bind("CancelModelAccess",{burst=2,perSecond=0.5,company=true},cancel)
end
return Market
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">PlotService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Twelve campus plots with enough space for roads, shop streets and basement ramps.
-- Owns the office lifecycle: build → DoorService.register → LiftService.attach, and the reverse
-- (detach → unregister → destroy) on rebuilds and when the founder leaves.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Players=game:GetService("Players")
local Lighting=game:GetService("Lighting")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local CompanyConfig=require(ReplicatedStorage.Shared.Config.CompanyConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local SessionService=require(script.Parent.SessionService)
local Design=require(script.Parent.HeadquartersDesign)
local Doors=require(script.Parent.DoorService)
local Lift=require(script.Parent.LiftService) -- LiftService must never require PlotService (cycle)
local Plot={}
local plots: {any}={}
local changed: {(any,any)-&gt;()}={}
local function accent(session: any): Color3
	local company=session.data.company
	local def=if company then CompanyConfig.getColor(company.color) else nil
	return if def then Color3.fromRGB(def.rgb[1],def.rgb[2],def.rgb[3]) else Color3.fromRGB(120,154,129)
end
function Plot.get(player: Player): any
	for _,p in plots do if p.owner==player then return p end end
	return nil
end
function Plot.all(): {any} return plots end
function Plot.onChanged(fn: (any,any)-&gt;()) table.insert(changed,fn) end
-- Front plaza in front of the entrance canopy, facing the building (world CFrame).
function Plot.arrival(p: any): CFrame
	local at=Plan.ARRIVAL
	return p.cframe*CFrame.lookAt(at,Vector3.new(at.X,at.Y,Plan.ENTRANCE.z))
end
local function announce(p: any,session: any)
	for _,fn in changed do fn(p,session) end
end
-- CityService registers whether a player is travelling or abroad: an office rebuild must not pull them
-- back from the airport or Port Meridian (a respawn resets the travel state first, so it still sends home).
local awayCheck: ((Player)-&gt;boolean)?=nil
function Plot.setAwayCheck(fn: (Player)-&gt;boolean) awayCheck=fn end
local function sendHome(player: Player,p: any)
	local character=player.Character;if not character then return end
	local root=character:WaitForChild("HumanoidRootPart",5);if not root then return end
	if p.owner~=player or not character.Parent then return end
	local away=awayCheck;if away and away(player) then return end
	character:PivotTo(Plot.arrival(p))
end
local function rootOf(player: Player): BasePart?
	local character=player.Character
	local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end
-- Players standing in the building volume of `tier` (plot-local). Drivers stay in their cars: the
-- garage footprint (Plan.GARAGE) is identical for every tier.
local function occupants(p: any,tier: number,except: Player?): {Player}
	local out={}
	for _,player in Players:GetPlayers() do
		local root=rootOf(player);local character=player.Character
		local h=if character then character:FindFirstChildOfClass("Humanoid") else nil
		local seat=if h then h.SeatPart else nil
		if player~=except and root and not (seat and seat:IsA("VehicleSeat")) and Plan.inside(tier,p.cframe:PointToObjectSpace(root.Position)) then
			table.insert(out,player)
		end
	end
	return out
end
local function evacuate(p: any,list: {Player})
	for _,player in list do
		local character=player.Character;local h=if character then character:FindFirstChildOfClass("Humanoid") else nil
		if character and character.Parent then
			if h then local seat=h.SeatPart;local weld=if seat then seat:FindFirstChild("SeatWeld") else nil;if weld then weld:Destroy() end;h.Sit=false end
			character:PivotTo(Plot.arrival(p))
		end
	end
end
local function connect(office: Model)
	Doors.register(office);Lift.attach(office)
end
local function disconnect(office: Model)
	Lift.detach(office);Doors.unregister(office)
end
local function setText(gui: Instance?,text: string)
	local label=if gui then gui:FindFirstChildWhichIsA("TextLabel",true) else nil
	if label then (label :: TextLabel).Text=text end
end
function Plot.refresh(session: any)
	local p=Plot.get(session.player);local office=if p then p.office else nil;if not office then return end
	local tier=session.data.empire.office -- office index: EmpireConfig.OFFICES[tier].name below
	local planTier=Design.tierFor(session) -- the building (plan tier): session.planTier or Plan.tierForOffice(office)
	if office:GetAttribute("OfficeTier")~=planTier then
		local oldTier=office:GetAttribute("OfficeTier")
		disconnect(office)
		-- Documented safety exception: visitors inside the old building would be left standing in
		-- the air after the rebuild, so they are moved to the plaza. The founder keeps sendHome.
		local inside=if typeof(oldTier)=="number" then occupants(p,oldTier,session.player) else {}
		office:Destroy();office=Design.build(p.cframe,session,accent(session));office.Parent=p.model;p.office=office
		connect(office)
		evacuate(p,inside)
		announce(p,session);task.spawn(sendHome,session.player,p)
	end
	local staffKey=""
	for _,role in EmpireConfig.ROLES do staffKey..=role.id..tostring(session.data.empire.employees[role.id] or 0) end
	if office:GetAttribute("StaffKey")~=staffKey then Design.staff(office,p.cframe,session) end
	office:SetAttribute("CoolingLevel",session.data.empire.infrastructure.cooling)
	local anchor=office:FindFirstChild("SignAnchor",true);local sign=if anchor then anchor:FindFirstChild("Sign") else nil
	local title=if sign then sign:FindFirstChild("Label") else nil
	local def=EmpireConfig.OFFICES[math.clamp(math.floor(tonumber(tier) or 1),1,#EmpireConfig.OFFICES)]
	local name=if session.data.company then session.data.company.name.."\n"..def.name else session.player.DisplayName.."'s Headquarters"
	if title and title:IsA("TextLabel") then title.Text=name else setText(sign,name) end
	if session.data.company then
		local company: string=session.data.company.name
		-- guest-house name signs (hotel annex, plan tier &gt;= 2) follow a rename like the HQ boards (hotelpolish request 2)
		local boards: {[string]:string}={ReceptionSign="WELCOME TO\n"..company,KitchenBrand=company.."\nSNACK CLUB",CompanyStele=company,
			LobbyHouseSign=string.upper(company),ParapetNameBand=string.upper(company)}
		for boardName,text in boards do
			local board=office:FindFirstChild(boardName,true);local gui=if board then board:FindFirstChildWhichIsA("SurfaceGui",true) else nil
			setText(gui,text)
		end
	end
	local colors: {Color3}={}
	for i=#HardwareConfig.GPUS,1,-1 do
		local gpu=HardwareConfig.GPUS[i]
		if not gpu.starter then for _=1,session.data.gpus[gpu.id] or 0 do table.insert(colors,accent(session)) end end
	end
	local blades=office:FindFirstChild("Blades")
	if blades then for i,blade in blades:GetChildren() do
		if blade:IsA("BasePart") then local lit=i&lt;=#colors;blade:SetAttribute("Lit",lit);blade.Color=if lit then colors[i] else Color3.fromRGB(39,46,43) end
	end end
	office:SetAttribute("Training",session.data.training~=nil)
end
local function vacantPad(p: any)
	local s=Plan.SITE
	local pad=Instance.new("Part");pad.Name="VacantPad";pad.Size=Vector3.new(s.x2-s.x1,24,s.z2-s.z1)
	pad.CFrame=p.cframe*CFrame.new((s.x1+s.x2)/2,-12,(s.z1+s.z2)/2);pad.Color=Color3.fromRGB(140,154,127);pad.Material=Enum.Material.Grass;pad.Anchored=true;pad.Parent=p.model
end
function Plot.claim(session: any)
	if Plot.get(session.player) then return end
	local p=nil;for _,candidate in plots do if not candidate.owner then p=candidate;break end end
	if not p then warn("[Campus] No free plot. Set Max Players to 12.");return end
	local vacant=p.model:FindFirstChild("VacantPad");if vacant then vacant:Destroy() end
	p.owner=session.player;p.office=Design.build(p.cframe,session,accent(session));p.office.Parent=p.model
	connect(p.office)
	Plot.refresh(session);announce(p,session)
	p.characterConn=session.player.CharacterAdded:Connect(function()task.delay(.25,sendHome,session.player,p)end)
	task.delay(.25,sendHome,session.player,p)
end
function Plot.release(player: Player)
	local p=Plot.get(player);if not p then return end
	if p.characterConn then p.characterConn:Disconnect() end
	-- Same safety exception as a rebuild: visitors still inside (e.g. in B1, which the vacant pad
	-- fills) are moved to the plaza once the building is gone.
	local tier=if p.office then p.office:GetAttribute("OfficeTier") else nil
	local inside=if typeof(tier)=="number" then occupants(p,tier,player) else {}
	if p.office then disconnect(p.office);p.office:Destroy() end
	p.owner=nil;p.office=nil;p.characterConn=nil
	vacantPad(p)
	evacuate(p,inside)
end
function Plot.init()
	-- Warm stone under Future lighting; EnvironmentDiffuse/SpecularScale live in the place file and
	-- StaffService drives ClockTime from the campus day (15.8 is only the value before its first tick).
	Lighting.ClockTime=15.8;Lighting.Brightness=2.2;Lighting.Ambient=Color3.fromRGB(88,92,96);Lighting.OutdoorAmbient=Color3.fromRGB(128,134,138)
	local old=workspace:FindFirstChild("Plots");if old then old:Destroy() end
	local folder=Instance.new("Folder");folder.Name="Plots";folder.Parent=workspace
	for i=1,Config.PLOT_COUNT do
		local row=if i&lt;=6 then -1 else 1;local x=((i-1)%6-2.5)*Config.PITCH
		local center=Vector3.new(x,Config.STREET_Y,row*Config.ROW_OFFSET)
		local cf=CFrame.lookAt(center,Vector3.new(x,Config.STREET_Y,0))
		local model=Instance.new("Model");model.Name=string.format("Plot_%02d",i);model.Parent=folder
		model:SetAttribute("CampusCFrame",cf);model:SetAttribute("PlotIndex",i)
		local p={index=i,cframe=cf,model=model}
		vacantPad(p)
		table.insert(plots,p)
	end
	SessionService.onLoaded(Plot.claim);SessionService.onClosing(function(s)Plot.release(s.player)end)
end
return Plot
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">SaveService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Persistenz. Nur hier wird der DataStore angefasst.
--
-- Aufbau eines Eintrags: { data = PlayerData, meta = { lockJobId, lockTime, saveCount } }
-- Session-Lock: Beim Laden schreibt der Server seine JobId in meta. Ein anderer Server, der den
-- Spieler gleichzeitig lädt (schneller Serverwechsel), wartet. Ein Lock älter als
-- SESSION_LOCK_TIMEOUT gilt als tot (Server abgestürzt) und wird übernommen.
-- Jeder Save prüft, ob der Lock noch uns gehört – sonst wird NICHT geschrieben (kein Dupe/Rollback).
--
-- Offline-Modus: In einem unveröffentlichten Ort (PlaceId 0) oder ohne Studio-API-Zugriff läuft das
-- Spiel ohne Speichern weiter, statt kaputtzugehen.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local SESSION_ID = if game.JobId ~= "" then game.JobId else HttpService:GenerateGUID(false)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)
local Template = require(script.Parent.Parent.Lib.Template)

local SaveService = {}
SaveService.enabled = false

local store: DataStore? = nil

local function keyFor(userId: number): string
	return GameConfig.KEY_PREFIX .. tostring(userId)
end

-- NaN/inf sind in JSON nicht speicherbar und würden den Spielstand zerstören
local function sanitize(value: any): any
	local kind = typeof(value)
	if kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return 0
		end
		return value
	elseif kind == "table" then
		local copy = {}
		for key, inner in value do
			copy[key] = sanitize(inner)
		end
		return copy
	end
	return value
end

local function waitForBudget()
	for _ = 1, 20 do
		if DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) &gt; 0 then
			return
		end
		task.wait(0.5)
	end
end

function SaveService.init()
	if game.PlaceId == 0 then
		warn("[Save] Unveröffentlichter Ort (PlaceId 0): Speichern ist AUS. Zum Speichern: Ort veröffentlichen.")
		return
	end
	local ok, err = pcall(function()
		local candidate = DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)
		candidate:GetAsync("__probe")
		store = candidate
	end)
	if ok then
		SaveService.enabled = true
	else
		warn("[Save] DataStore nicht erreichbar, Speichern ist AUS:", err)
	end
end

-- Lädt und sperrt den Spielstand. Gibt (Daten, nil) oder (nil, Grund) zurück.
function SaveService.load(userId: number): (Types.PlayerData?, string?)
	local activeStore = store
	if not SaveService.enabled or not activeStore then
		if RunService:IsStudio() or game.PlaceId == 0 then return Template.new(), nil end
		return nil, "storage unavailable; please rejoin"
	end
	local key = keyFor(userId)
	local jobId = SESSION_ID

	for attempt = 1, GameConfig.LOAD_ATTEMPTS do
		local lockedElsewhere = false
		local loaded: any = nil
		local invalidReason: string? = nil
		waitForBudget()
		local ok, err = pcall(function()
			activeStore:UpdateAsync(key, function(old: any)
				lockedElsewhere = false
				loaded = nil
				invalidReason = nil
				local now = os.time()
				if old ~= nil and (typeof(old) ~= "table" or typeof(old.data) ~= "table") then
					invalidReason = "invalid save; original preserved"
					return nil
				end
				if typeof(old) == "table" and typeof(old.meta) == "table" then
					local owner = old.meta.lockJobId
					local age = now - (tonumber(old.meta.lockTime) or 0)
					if owner ~= nil and owner ~= jobId and age &lt; GameConfig.SESSION_LOCK_TIMEOUT then
						lockedElsewhere = true
						return nil -- nichts schreiben, später erneut versuchen
					end
				end
				local record = if typeof(old) == "table" then old else { data = Template.new(), meta = {} }
				local migrated, reason = Template.migrate(record.data)
				if not migrated then
					invalidReason = reason or "invalid save; original preserved"
					return nil
				end
				record.data = migrated
				if typeof(record.meta) ~= "table" then
					record.meta = {}
				end
				record.meta.lockJobId = jobId
				record.meta.lockTime = now
				loaded = record.data
				return record
			end)
		end)
		if ok and invalidReason then return nil, invalidReason end
		if ok and not lockedElsewhere then
			return loaded, nil
		end
		if not ok then
			warn(`[Save] Laden fehlgeschlagen (Versuch {attempt}): {err}`)
		end
		task.wait(GameConfig.LOAD_RETRY_SECONDS)
	end
	return nil, "save could not be loaded"
end

-- Speichert. release = true gibt den Lock frei (Spieler verlässt den Server).
-- Rückgabe: (gespeichert, Lock verloren)
function SaveService.save(userId: number, data: Types.PlayerData, release: boolean): (boolean, boolean)
	local activeStore = store
	if not SaveService.enabled or not activeStore then
		return true, false
	end
	local key = keyFor(userId)
	local jobId = SESSION_ID
	local payload = sanitize(data)

	for attempt = 1, GameConfig.SAVE_ATTEMPTS do
		local lostLock = false
		waitForBudget()
		local ok, err = pcall(function()
			activeStore:UpdateAsync(key, function(old: any)
				lostLock = false
				local meta = if typeof(old) == "table" and typeof(old.meta) == "table" then old.meta else {}
				if meta.lockJobId ~= nil and meta.lockJobId ~= jobId then
					lostLock = true
					return nil -- eine andere Session besitzt die Daten: nicht überschreiben
				end
				return {
					data = payload,
					meta = {
						lockJobId = if release then nil else jobId,
						lockTime = os.time(),
						saveCount = (tonumber(meta.saveCount) or 0) + 1,
					},
				}
			end)
		end)
		if ok then
			if lostLock then
				warn(`[Save] Lock für {userId} gehört einem anderen Server – nicht gespeichert.`)
			end
			return not lostLock, lostLock
		end
		warn(`[Save] Speichern fehlgeschlagen (Versuch {attempt}): {err}`)
		task.wait(2 ^ attempt)
	end
	return false, false
end

-- Lock freigeben, ohne Daten zu schreiben (Spieler hat den Server verlassen, bevor das Laden fertig war)
function SaveService.releaseLock(userId: number)
	local activeStore = store
	if not SaveService.enabled or not activeStore then
		return
	end
	local jobId = SESSION_ID
	pcall(function()
		activeStore:UpdateAsync(keyFor(userId), function(old: any)
			if typeof(old) == "table" and typeof(old.meta) == "table" and old.meta.lockJobId == jobId then
				old.meta.lockJobId = nil
				return old
			end
			return nil
		end)
	end)
end

return SaveService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">SessionService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Hält die geladenen Spielerdaten im Speicher, schickt Snapshots an den Client und speichert.
-- Andere Services verändern session.data und rufen danach SessionService.markDirty(session).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local ModelConfig = require(ReplicatedStorage.Shared.Config.ModelConfig)
local Types = require(ReplicatedStorage.Shared.Types)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local StatePatch = require(ReplicatedStorage.Shared.StatePatch)
local CompanyOps = require(ReplicatedStorage.Shared.CompanyOps)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SaveService = require(script.Parent.SaveService)

type Session = ServerTypes.Session

local SessionService = {}

local sessions: { [Player]: Session } = {}
local loadedCallbacks: { (Session) -&gt; () } = {}
local closingCallbacks: { (Session) -&gt; () } = {}

local function emptyLive(): Types.LiveInfo
	return { users = 0, revenue = 0, cost = 0, perModel = {}, npcUsers = {} }
end

function SessionService.get(player: Player): Session?
	return sessions[player]
end

function SessionService.all(): { [Player]: Session }
	return sessions
end

-- urgent = true: a direct player action outside Remote.bind (e.g. a ProximityPrompt) — send after
-- REPLICATE_URGENT_SECONDS instead of the steady REPLICATE_SECONDS. Remote calls are urgent anyway.
function SessionService.markDirty(session: Session, urgent: boolean?)
	session.dirty = true
	if urgent then
		session.urgent = true
	end
end

function SessionService.onLoaded(callback: (Session) -&gt; ())
	table.insert(loadedCallbacks, callback)
end

function SessionService.onClosing(callback: (Session) -&gt; ())
	table.insert(closingCallbacks, callback)
end

-- Replication (State remote). The first snapshot and every RequestState answer are FULL and reset
-- the per-player baseline (session.shadow = private copy of what was sent). Regular updates are
-- DELTAS: StatePatch.diff sends only values that changed since the last send to THAT player, the
-- client applies them onto its copy (StateController). seq/base let the client detect a missing
-- delta; it then fetches the full state once via RequestState.
-- Rate: at most every REPLICATE_SECONDS; right after a remote call of the player (the session
-- provider below marks it urgent) already after REPLICATE_URGENT_SECONDS, so actions feel instant.

-- data.shop.* entries the client never needs (purchase receipts / processed order ids): never sent
local SERVER_ONLY_SHOP_KEYS = { "receipts", "order" }

-- Counters that change every simulation second but are secondary on screen: compared (and sent)
-- only every REPLICATE_LAZY_SECONDS. Everything else in the same tables (new entries, status,
-- prices, removals) still goes out immediately. Root = { data, live }; "*" = every entry.
-- CORE_SPEC 11.8: the company log (deals.news), trust bars, the broke timer, the P&amp;L ledger and the
-- per-minute company summary (live.ops), waitlist and load change every second but are secondary: every 5 s.
-- Marketplace offers: users and the version age (vage, +1 per second for every live model on the server).
local LAZY: StatePatch.Lazy = {
	data = { empire = {
		projects = { ["*"] = { visitors = true, revenueTotal = true } },
		deals = { news = true, trust = true, broke = true },
		ledger = true,
	} },
	live = {
		studio = { gallery = { ["*"] = { visitors = true, revenueTotal = true } } },
		marketplace = { offers = { ["*"] = { users = true, vage = true } } },
		ops = true,
		waitlist = true,
		load = true,
		demand = true,
	},
}

SessionService.LAZY = LAZY

-- What the client gets of the company state (CORE_SPEC 11.8 byte budget: deals &lt;= 3 KB, ledger &lt;= 2.5 KB):
--  * the company log keeps CompanyOps.NEWS_MAX (40) lines in the save; the phone shows the newest NEWS_SHOWN (20);
--  * trust bars to 0.001 (shown as "trust 67 %"; the save keeps the exact value);
--  * accounts as {expires, renewing?} and trips as {client, kind, back, founder?, hosted?}: what the screens and
--    CompanyOps on the client (presence / travellers, guest-house guests) read; since, crew and left stay
--    server-side (live.ops.trips carries the crew of every trip);
--  * the P&amp;L ledger: the newest LEDGER_SHOWN company days of the LEDGER_DAYS saved.
local NEWS_SHOWN = CompanyOps.NEWS_SHOWN
local LEDGER_SHOWN = CompanyOps.LEDGER_SHOWN

local function compactDeals(deals: any): any
	local out = table.clone(deals)
	local news = deals.news
	if type(news) == "table" and #news &gt; NEWS_SHOWN then
		out.news = table.move(news, 1, NEWS_SHOWN, 1, {})
	end
	if type(deals.trust) == "table" then
		local trust = {}
		for id, t in deals.trust do
			trust[id] = if type(t) == "number" then math.floor(t * 1000 + 0.5) / 1000 else t
		end
		out.trust = trust
	end
	if type(deals.accounts) == "table" then
		local accounts = {}
		for id, acc in deals.accounts do
			if type(acc) == "table" then
				accounts[id] = if acc.renewing == true then { expires = acc.expires, renewing = true } else { expires = acc.expires }
			end
		end
		out.accounts = accounts
	end
	if type(deals.tripList) == "table" then
		local trips = {}
		for _, t in deals.tripList do
			if type(t) == "table" then
				table.insert(trips, { client = t.client, kind = t.kind, back = t.back, founder = if t.founder == true then true else nil, hosted = if t.hosted == true then true else nil })
			end
		end
		out.tripList = trips
	end
	return out
end

local function newestDays(ledger: any): any
	local keys = {}
	for key in ledger do
		local n = tonumber(key)
		if n then table.insert(keys, n) end
	end
	if #keys &lt;= LEDGER_SHOWN then
		return ledger
	end
	table.sort(keys, function(a: number, b: number): boolean return a &gt; b end)
	local out = {}
	for i = 1, LEDGER_SHOWN do
		local key = tostring(keys[i])
		out[key] = ledger[key]
	end
	return out
end

-- data may already be a shallow clone (cloned = true): then it is changed in place
local function trimCompany(data: any, cloned: boolean): any
	local e = data.empire
	if type(e) ~= "table" then
		return data
	end
	local deals = e.deals
	local ledger = e.ledger
	if type(deals) ~= "table" and type(ledger) ~= "table" then
		return data
	end
	local trimmedEmpire = table.clone(e)
	if type(deals) == "table" then
		trimmedEmpire.deals = compactDeals(deals)
	end
	if type(ledger) == "table" then
		trimmedEmpire.ledger = newestDays(ledger)
	end
	local trimmed = if cloned then data else table.clone(data)
	trimmed.empire = trimmedEmpire
	return trimmed
end

-- What the client gets of data: server-only shop records stripped, the company state trimmed (above).
-- Shallow clones only along the changed paths (the save table itself is never modified).
function SessionService.replicatedData(data: Types.PlayerData): Types.PlayerData
	local out: any = data
	local cloned = false
	local shop = (data :: any).shop
	if type(shop) == "table" then
		local strip = false
		for _, key in SERVER_ONLY_SHOP_KEYS do
			if shop[key] ~= nil then
				strip = true
			end
		end
		if strip then
			local trimmedShop = table.clone(shop)
			for _, key in SERVER_ONLY_SHOP_KEYS do
				trimmedShop[key] = nil
			end
			out = table.clone(data)
			out.shop = trimmedShop
			cloned = true
		end
	end
	return trimCompany(out, cloned)
end
local replicatedData = SessionService.replicatedData

local function nextSeq(session: Session): number
	local seq = (session.seq or 0) + 1
	session.seq = seq
	return seq
end

-- Full snapshot (first send, RequestState). Resets the delta baseline for this player.
function SessionService.snapshot(session: Session): Types.Snapshot
	local data = replicatedData(session.data)
	local live = session.live
	session.shadow = StatePatch.copy({ data = data, live = live })
	return {
		seq = nextSeq(session),
		saveEnabled = SaveService.enabled,
		serverTime = workspace:GetServerTimeNow(),
		data = data,
		live = live,
	}
end

-- Changes since the last snapshot sent to this player. nil when nothing changed or when there is no
-- baseline yet (SessionService.snapshot creates it). lazy = true skips the LAZY counters this time.
function SessionService.delta(session: Session, lazy: boolean?): Types.StateDelta?
	local shadow = session.shadow
	if shadow == nil then
		return nil
	end
	local root = { data = replicatedData(session.data), live = session.live }
	local patch = StatePatch.diff(shadow, root, if lazy then LAZY else nil)
	if patch == nil then
		return nil
	end
	local base = session.seq or 0
	return {
		seq = nextSeq(session),
		base = base,
		saveEnabled = SaveService.enabled,
		serverTime = workspace:GetServerTimeNow(),
		patch = patch,
	}
end

-- Sends changed sessions to their clients (see the replication note above)
function SessionService.flush(now: number)
	for _, session in sessions do
		if session.dirty and not session.closed then
			local gap = now - session.lastSent
			if gap &gt;= GameConfig.REPLICATE_SECONDS or (session.urgent and gap &gt;= GameConfig.REPLICATE_URGENT_SECONDS) then
				session.dirty = false
				session.urgent = false
				session.lastSent = now
				if session.shadow == nil then
					session.sweptAt = now
					Remote.fire(session.player, "State", SessionService.snapshot(session))
				else
					local sweep = now - (session.sweptAt or 0) &gt;= GameConfig.REPLICATE_LAZY_SECONDS
					if sweep then
						session.sweptAt = now
					end
					local delta = SessionService.delta(session, not sweep)
					if delta then
						Remote.fire(session.player, "State", delta)
					end
				end
			end
		end
	end
end

local function saveSession(session: Session, release: boolean)
	local _, lostLock = SaveService.save(session.userId, session.data, release)
	if lostLock and not release then
		-- Ein anderer Server hat übernommen: hier nichts mehr verändern oder speichern
		session.closed = true
		session.player:Kick("AI Empire: Your company was opened on another server.")
	end
end

function SessionService.autosave(now: number)
	for _, session in sessions do
		if not session.saving and not session.closed and now &gt;= session.nextSaveAt then
			session.saving = true
			session.nextSaveAt = now + GameConfig.AUTOSAVE_SECONDS
			task.spawn(function()
				saveSession(session, false)
				session.saving = false
			end)
		end
	end
end

local function onPlayerAdded(player: Player)
	local data, reason = SaveService.load(player.UserId)
	if player.Parent == nil then
		-- schon wieder weg, während wir geladen haben
		if data then
			SaveService.releaseLock(player.UserId)
		end
		return
	end
	if not data then
		player:Kick(`AI Empire: Your save could not be loaded ({reason}). Please rejoin in a minute.`)
		return
	end

	-- Ein offenes Trainings-Event aus der letzten Sitzung bekommt einen frischen Timer
	local training = data.training
	if training and training.event and training.event.pending then
		training.event.expiresAt = workspace:GetServerTimeNow() + ModelConfig.TRAINING.decisionTimeout
	end

	local now = os.clock()
	local session: Session = {
		player = player,
		userId = player.UserId,
		data = data,
		live = emptyLive(),
		dirty = true,
		lastSent = 0,
		nextSaveAt = now + GameConfig.AUTOSAVE_SECONDS + math.random() * 15, -- gestaffelt
		saving = false,
		closed = false,
		released = false,
		rng = Random.new(),
	}
	sessions[player] = session
	for _, callback in loadedCallbacks do
		task.spawn(callback, session)
	end
end

local function closeSession(player: Player)
	local session = sessions[player]
	if not session or session.released then
		return -- unbekannt oder wird schon geschlossen (PlayerRemoving + BindToClose gleichzeitig)
	end
	session.released = true
	local lockLost = session.closed -- closed ohne released = anderer Server hat übernommen
	session.closed = true
	for _, callback in closingCallbacks do
		local ok, err = pcall(callback :: (Session) -&gt; any, session)
		if not ok then
			warn("[Session] closing callback:", err)
		end
	end
	if not lockLost then
		-- laufenden Autosave abwarten, dann final speichern und Lock freigeben
		local waited = 0
		while session.saving and waited &lt; 15 do
			task.wait(0.2)
			waited += 0.2
		end
		session.saving = true
		saveSession(session, true)
	end
	sessions[player] = nil
end

function SessionService.init()
	-- Remote.bind asks for the session on every (rate-limit approved) remote call of the player:
	-- whatever the handler changes goes out on the next Heartbeat instead of the steady cadence.
	Remote.setSessionProvider(function(player: Player): Session?
		local session = sessions[player]
		if session then
			session.urgent = true
		end
		return session
	end)

	Remote.bind("RequestState", { burst = 4, perSecond = 1 }, function(session, _payload)
		return { ok = true, state = SessionService.snapshot(session) }
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(closeSession)

	game:BindToClose(function()
		local pending = 0
		local players = {}
		for player in sessions do
			table.insert(players, player)
		end
		for _, player in players do
			pending += 1
			task.spawn(function()
				closeSession(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending &gt; 0 and os.clock() - started &lt; 25 do
			task.wait(0.25)
		end
	end)
end

return SessionService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000000"><Properties><string name="Name">CampusSoundService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusAudioConfig)
local Service={}
function Service.play(parent: Instance,key: string)
 local id=Config.INTERACTIONS[key];if not id or id=="" then return end
 local sound=Instance.new("Sound");sound.Name="CampusSFX";sound.SoundId=id;sound.Volume=.12;sound.RollOffMinDistance=3;sound.RollOffMaxDistance=28;sound.RollOffMode=Enum.RollOffMode.InverseTapered;sound.Parent=parent;sound:Play()
 task.delay(8,function()if sound.Parent then sound:Destroy() end end)
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000004"><Properties><string name="Name">BuildingStateService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Live architecture: every value comes from the same session that owns the building.
-- Screens (attribute LiveScreen=&lt;kind&gt;, SurfaceGui Desktop -&gt; Header/Body/Footer/ProgressTrack.Fill)
-- are registered once per office and rewritten only near players (1 s close by, 6 s further away).
-- Texts describe real state only: idle rooms say they are idle, guidance repeats the real rule.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local EmpireMath=require(ReplicatedStorage.Shared.EmpireMath)
local Workforce=require(ReplicatedStorage.Shared.WorkforceMath)
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local Format=require(ReplicatedStorage.Shared.Format)
local MarketMath=require(ReplicatedStorage.Shared.MarketMath)
local ModelConfig=require(ReplicatedStorage.Shared.Config.ModelConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local StudioConfig=require(ReplicatedStorage.Shared.Config.StudioConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Ops=require(ReplicatedStorage.Shared.CompanyOps)
local Plot=require(script.Parent.PlotService)
local Session=require(script.Parent.SessionService)
local Service={}
local EPOCHS=10 -- AIModelService logs ten epochs per run
local FOOTER="DATA → COMPUTE → DESIGN → TRAIN → EVALUATE → LAUNCH"
-- Screens whose header turns amber (client side) while a training decision waits.
local ALERT_KINDS={training=true,compute=true,engineering=true,journey=true,founder=true,lobby=true,boardroom=true}
local clock=0;local caches: {[Instance]:any}=setmetatable({},{__mode="k"}) :: any

-- Optional services (DoorService, LiftService) are required lazily: a missing or failing module
-- only removes those lines from the security screen, it never breaks the other screens.
local optional: {[string]:any}={}
local function service(name: string): any
	local known=optional[name]
	if known~=nil then return if known==false then nil else known end
	local ok,mod=pcall(function(): any
		local m=script.Parent:FindFirstChild(name)
		return if m and m:IsA("ModuleScript") then (require :: any)(m) else nil
	end)
	if not ok then warn(`[Screens] {name} unavailable: {mod}`) end
	optional[name]=if ok and mod then mod else false
	return if ok then mod else nil
end
local function inspect(name: string,office: Model): any
	local svc=service(name)
	if not svc or typeof(svc.inspect)~="function" then return nil end
	local ok,result=pcall(svc.inspect,office)
	return if ok then result else nil
end

local function proximity(position: Vector3,positions: {Vector3}): number
	local min=math.huge;for _,p in positions do min=math.min(min,(p-position).Magnitude) end;return min
end
local function attr(i: Instance?,name: string): any return if i then i:GetAttribute(name) else nil end
local function title(model: any): string return if model then model.name.." v"..model.version else "No model yet" end
local function words(id: string): string
	-- "ModelReviewMeeting" / "MODEL REVIEW" -&gt; "Model review meeting" / "Model review"
	local text=string.lower((string.gsub(id,"(%l)(%u)","%1 %2")))
	return string.upper(string.sub(text,1,1))..string.sub(text,2)
end
local function hourText(hour: number?): string
	if typeof(hour)~="number" then return "--:--" end
	local minutes=math.floor((hour%24)*60+.5)
	return string.format("%02d:%02d",(minutes//60)%24,minutes%60)
end
local function count(t: any): number
	if typeof(t)=="number" then return t end
	if typeof(t)~="table" then return 0 end
	local n=0;for _,v in t do if v then n+=1 end end;return n
end

-- Company state helpers (CORE_SPEC 3.2 / 5.5 / 11.5): B2B accounts, trips, compute ------------------------
local function money(n: number): string return Ops.money(n) end
local function accountsOf(e: any): ({any},number)
	local list,retainer={},0
	local d=e.deals
	if typeof(d)=="table" and typeof(d.accounts)=="table" then
		for _,c in Ops.CLIENTS do
			local acc=d.accounts[c.id]
			if acc then table.insert(list,{client=c,acc=acc});retainer+=c.retainer end
		end
	end
	return list,retainer
end
local function tripsOf(s: any): {any}
	local ops=s.live and s.live.ops
	if typeof(ops)=="table" and typeof(ops.trips)=="table" then return ops.trips end
	local d=s.data.empire.deals
	return if typeof(d)=="table" and typeof(d.tripList)=="table" then d.tripList else {}
end
local function tripShort(t: any): string
	local c=Ops.client(t.client);local name=if c then c.name else tostring(t.client)
	if t.hosted then return name.." team at the guest house" end
	local who=if t.founder then "Founder" elseif (tonumber(t.crew) or 1)&gt;=2 then "Rep + engineer" else "Rep"
	return string.format("%s → %s (%s)",who,name,if t.kind=="renew" then "check-in" else "pilot")
end
-- the company day an account ends on (the calendar moves with the server day)
local function endDay(e: any,expires: number): number
	local into=(workspace:GetServerTimeNow()%Ops.DAY)/Ops.DAY
	return Ops.day(e)+math.floor(into+math.max(0,expires-(tonumber(e.seconds) or 0))/Ops.DAY)
end

-- Screen registry ---------------------------------------------------------------------------
local function stationOf(p: BasePart,office: Model): Model?
	local node: Instance?=p.Parent
	for _=1,4 do
		if not node or node==office then return nil end
		if node:IsA("Model") and node:GetAttribute("WorkstationId")~=nil and node:GetAttribute("WorkstationType")~=nil then return node end
		node=node.Parent
	end
	return nil
end
local function roomOf(p: BasePart,office: Model,tier: number,cf: CFrame?): (string?,string?,number?)
	local node: Instance?=p.Parent
	while node and node~=office do
		local id=node:GetAttribute("RoomId")
		if typeof(id)=="string" then
			local r=Plan.room(tier,id)
			return id,(node:GetAttribute("RoomName") or (if r then r.name else id)) :: string,(node:GetAttribute("Level") or (if r then r.level else nil)) :: number?
		end
		node=node.Parent
	end
	if cf then
		local v=cf:PointToObjectSpace(p.Position);local r=Plan.roomAt(tier,v)
		if r then return r.id,r.name,r.level end
		return nil,nil,Plan.levelAt(tier,v.Y)
	end
	return nil,nil,nil
end
local function scan(office: Model): any
	local cache=caches[office];if cache then return cache end
	local tier=Plan.clampTier(tonumber(office:GetAttribute("OfficeTier")) or 1) -- plan tier 0 = garage stage
	local cf=office:GetAttribute("CampusCFrame");local frame: CFrame?=if typeof(cf)=="CFrame" then cf else nil
	cache={screens={},byPart={},meetings={},cameras=0,tier=tier,cf=frame,visitors=0,security=nil,securityAt=-math.huge}
	for _,p in office:GetDescendants() do
		if p:IsA("BasePart") and p:GetAttribute("LiveScreen") then
			local roomId,roomName,level=roomOf(p,office,tier,frame)
			local entry={part=p,kind=tostring(p:GetAttribute("LiveScreen")),w=stationOf(p,office),roomId=roomId,roomName=roomName,level=level,next=0}
			table.insert(cache.screens,entry);cache.byPart[p]=entry
		elseif p:IsA("Model") and p:GetAttribute("WorkstationType")=="Meeting" then
			local room=tostring(p:GetAttribute("MeetingRoom") or p:GetAttribute("HomeRoom") or "")
			cache.meetings[room]=cache.meetings[room] or {};table.insert(cache.meetings[room],p)
		elseif p:IsA("BasePart") and p:GetAttribute("CameraId")~=nil then
			cache.cameras+=1
		end
	end
	caches[office]=cache;return cache
end

-- Shared value helpers ----------------------------------------------------------------------
function Service.assetValue(data: any): number
	local total=data.money
	for _,gpu in HardwareConfig.GPUS do total+=(data.gpus[gpu.id] or 0)*(gpu.price or 0) end
	for i=2,data.empire.office do total+=EmpireConfig.OFFICES[i].price end
	for _,car in CampusConfig.CARS do if data.empire.campus.cars[car.id] then total+=car.price end end
	return total
end
local function sizeOf(id: string?): any return if id then ModelConfig.getSize(id) else nil end
local function focusLabel(id: string?): string local f=if id then ModelConfig.getFocus(id) else nil;return if f then f.label else "Balanced" end
-- Largest size the fleet's VRAM fits and the next size up (7B also needs Frontier research).
local function vramFit(d: any): (any,any)
	local vram=ModelMath.fleet(d.gpus).vram;local fit,nextSize=nil,nil
	for _,size in ModelConfig.SIZES do
		if size.vram&lt;=vram then fit=size elseif not nextSize then nextSize=size end
	end
	return fit,nextSize
end
-- Guidance that repeats JourneyMath's real checks: VRAM first, then data, then research.
local function guidance(d: any): string
	local flow=Journey.progress(d)
	local fit,nextSize=vramFit(d);local vram=ModelMath.fleet(d.gpus).vram
	if flow.missingVram&gt;0 then
		-- JourneyMath checks the smallest size on the server, so a smaller size is no option here.
		local smallest=ModelConfig.getSize("s100m") or ModelConfig.SIZES[1]
		return string.format("%s needs %d GB more VRAM · Open Hardware",smallest.label,flow.missingVram)
	end
	if not fit then return "Open Hardware: no model size fits your VRAM yet." end
	local stock=ModelMath.dataSummary(d.data)
	if stock.total&lt;ModelConfig.TRAINING.minTokens then return flow.hint end
	if nextSize then
		local missing=nextSize.vram-vram
		return string.format("%s needs %d GB more VRAM · Open Hardware or choose a smaller model size",nextSize.label,missing)
	end
	if not d.empire.research.frontier then return "7B fits your VRAM; it requires Frontier Architecture research." end
	return flow.hint
end
local function gpuCount(d: any): number
	local n=0;for _,gpu in HardwareConfig.GPUS do n+=d.gpus[gpu.id] or 0 end;return n
end
local function researchBonuses(b: any): string
	local parts={}
	if b.core&gt;0 then table.insert(parts,string.format("+%d core stats",b.core)) end
	if b.reliability&gt;0 then table.insert(parts,string.format("+%d reliability",b.reliability)) end
	if b.serving&lt;1 then table.insert(parts,string.format("serving cost -%.0f%%",(1-b.serving)*100)) end
	return if #parts&gt;0 then table.concat(parts," · ") else "no research bonuses yet"
end
local function liveModels(d: any): {any}
	local out={};for _,id in d.modelOrder do local m=d.models[id];if m and m.status=="live" then table.insert(out,m) end end;return out
end
local function usersOf(s: any,m: any): number
	local r=s.live.perModel and s.live.perModel[m.id]
	if r and typeof(r.users)=="number" then return r.users end
	return if m.market then MarketMath.totalUsers(m.market) else 0
end
local function benchmarks(m: any): string
	local st=m.stats or {}
	return string.format("R%.0f C%.0f M%.0f Cr%.0f K%.0f Rl%.0f",st.reasoning or 0,st.coding or 0,st.math or 0,st.creativity or 0,st.knowledge or 0,st.reliability or 0)
end
local function trainingLine(d: any): string?
	local t=d.training;if not t then return nil end
	return string.format("%s %.0f%% · epoch %d / %d",if t.refinement then "refining" else "training",math.clamp(t.workDone/math.max(1,t.workTotal),0,1)*100,t.epoch or 0,EPOCHS)
end
local function rankOf(s: any): string
	if s.live.rankings and s.live.rankings.boards then
		for i,row in s.live.rankings.boards.overall or {} do if row.userId==s.userId then return "#"..i end end
	end
	return "Not listed"
end
-- Live building state (doors, lift, cameras), cached per office for one second ---------------
-- LiftService.inspect: {attached, state, level, target, door, queue={hall={levels},car={levels}}, riders,
-- tickets (count), reason}. Cabin attributes CurrentLevel/LiftState are the fallback.
local function liftState(office: Model): any
	local info=inspect("LiftService",office)
	local cabin=office:FindFirstChild("LiftCabin",true)
	local out={state=attr(cabin,"LiftState"),level=attr(cabin,"CurrentLevel"),target=nil,calls=0,riders=0,queue=0,attached=cabin~=nil}
	if typeof(info)=="table" then
		if info.attached==false then out.attached=false end
		out.state=info.state or info.status or out.state
		out.level=info.level or info.currentLevel or out.level
		out.target=info.target
		local q=info.queue
		if typeof(q)=="table" and (q.hall~=nil or q.car~=nil) then out.calls=count(q.hall)+count(q.car)
		else out.calls=count(info.hall)+count(info.car);out.queue=count(q) end
		out.riders=count(info.riders)
		out.queue+=count(info.tickets)
	end
	return out
end
local function securityState(office: Model,cache: any): any
	local now=os.clock()
	if cache.security and now-cache.securityAt&lt;1 then return cache.security end
	local doors=inspect("DoorService",office)
	local st={known=typeof(doors)=="table",doors=0,open=0,locked=0,computeOpen=0,lift=liftState(office),cameras=cache.cameras}
	if st.known then
		for _,door in doors do
			if typeof(door)~="table" or door.kind=="cubicle" or door.kind=="fridge" then continue end
			st.doors+=1
			if door.state=="locked" then st.locked+=1
			elseif door.state=="open" or door.state=="opening" or door.state=="closing" then
				st.open+=1;if door.access=="compute" then st.computeOpen+=1 end
			end
		end
	end
	cache.security=st;cache.securityAt=now
	return st
end
local function liftText(tier: number,lift: any): string
	if not lift.attached then return "Lift not running yet · use the stairs" end
	local level=if typeof(lift.level)=="number" then Plan.levelLabel(tier,lift.level) else "?"
	local state=if typeof(lift.state)=="string" then string.lower((string.gsub(lift.state,"_"," "))) else nil
	if state=="out of service" then return "Lift out of service at "..level.." · use the stairs" end
	if typeof(lift.target)=="number" and lift.target~=lift.level then
		return string.format("Lift %s → %s · %d riding",level,Plan.levelLabel(tier,lift.target),lift.riders)
	end
	return string.format("Lift %s at %s · %d calls · %d staff waiting",state or "ready",level,lift.calls,lift.queue)
end
local function meetingInfo(ctx: any,fallback: string?): (string,number,number,{string},string?)
	local entry=ctx.entry;local cache=ctx.cache
	local room=attr(ctx.screen,"MeetingRoom") or fallback
	if typeof(room)~="string" and entry and entry.roomId then
		local r=Plan.room(ctx.tier,entry.roomId);room=if r and r.meeting then r.meeting else entry.roomId
	end
	local seats=if cache and typeof(room)=="string" then cache.meetings[room] or {} else {}
	local used,people,topic=0,{},nil
	for _,m in seats do
		local seat=m:FindFirstChildWhichIsA("Seat",true)
		if m:GetAttribute("OccupiedBy")~=nil or (seat and seat.Occupant) then
			used+=1
			local name=m:GetAttribute("EmployeeName");if typeof(name)=="string" and #people&lt;4 then table.insert(people,name) end
			local task=m:GetAttribute("Software");if typeof(task)=="string" and not topic then topic=words(task) end
		end
	end
	return tostring(room or "Meeting room"),#seats,used,people,topic
end

-- Presentations -----------------------------------------------------------------------------
type Ctx={s: any,d: any,e: any,w: Model?,screen: BasePart?,office: Model?,cache: any,entry: any,tier: number,company: string,footer: string}
local P: {[string]:(Ctx)-&gt;(string,string,string,number)}={}

P.data=function(c)
	local d=c.d;local stock=ModelMath.dataSummary(d.data)
	local general=d.data.general;local code=d.data.code;local mathData=d.data.math
	return "DATA OPERATIONS",string.format("General  %s tokens\nCode       %s tokens\nMath       %s tokens\nQuality    %.1f%%\nCurator production  %s tokens/s",Format.tokens(if general then general.tokens else 0),Format.tokens(if code then code.tokens else 0),Format.tokens(if mathData then mathData.tokens else 0),stock.quality*100,Format.tokens(Workforce.count(c.e,"curator")*300000)),c.footer,stock.quality
end
P.training=function(c)
	local d,e=c.d,c.e;local t=d.training;local fleet=ModelMath.fleet(d.gpus)
	local n=gpuCount(d)
	local cluster=string.format("%d GPU%s · %d GB VRAM · cooling %d / 8",n,if n==1 then "" else "s",fleet.vram,e.infrastructure.cooling)
	if not t then
		local fit=vramFit(d);local last=Journey.latest(d)
		return "GPU CLUSTER · IDLE",table.concat({
			"No training run. The cluster is idle.",cluster,
			if fit then "Fits models up to "..fit.label else "No model size fits yet",
			guidance(d),
			if last then string.format("Last model  %s · overall %.1f",title(last),last.overall or 0) else "No model trained yet",
		},"\n"),c.footer,0
	end
	local m=d.models[t.modelId];local size=sizeOf(m and m.sizeId)
	local progress=math.clamp(t.workDone/math.max(1,t.workTotal),0,1)
	local loss=t.loss[#t.loss]
	local name=string.format("%s · %s · %s",title(m),if size then size.label else "?",focusLabel(m and m.focusId))
	local event=t.event
	if event and event.pending then
		local def=ModelConfig.getEvent(event.id)
		local choices={};if def and def.choices then for _,ch in def.choices do table.insert(choices,ch.label) end end
		local default=if def and def.default and def.choices then ModelConfig.getChoice(def,def.default) else nil
		local left=math.max(0,math.ceil((event.expiresAt or 0)-workspace:GetServerTimeNow()))
		return "TRAINING DECISION REQUIRED",table.concat({
			if def then def.title..": "..def.text else "A training decision is waiting.",
			"Choose  "..table.concat(choices," / "),
			string.format("Automatic choice in %d s: %s",left,if default then default.label else "default"),
			string.format("%s paused at %.1f%% · epoch %d / %d",title(m),progress*100,t.epoch or 0,EPOCHS),
			"Decide in Lab → Training Control",
		},"\n"),c.footer,progress
	end
	local rate=EmpireMath.trainingRate(d.gpus,t.workTotal,e)
	local eta=if rate&gt;0 then (t.workTotal-t.workDone)/rate else math.huge
	return if t.refinement then "MODEL REFINEMENT" else "MODEL TRAINING",table.concat({
		name,
		string.format("Progress  %.1f%%  ·  epoch %d / %d",progress*100,t.epoch or 0,EPOCHS),
		string.format("Loss  %s  ·  expected overall %.1f",if loss then string.format("%.3f",loss) else "—",t.expected or 0),
		if eta&lt;math.huge then "Time left  about "..Format.duration(eta) else "Time left  waiting for compute",
		cluster,
	},"\n"),c.footer,progress
end
-- Data hall / compute operations / IT desk (user request 23): load, rack faults, compute reserved for clients
P.compute=function(c)
	local s,d,e=c.s,c.d,c.e;local live=s.live;local fleet=ModelMath.fleet(d.gpus)
	local compute=if typeof(live.compute)=="table" then live.compute else {}
	local capacity=tonumber(live.capacity) or 0;local load=tonumber(live.load) or 0;local waiting=tonumber(live.waitlist) or 0
	local serving=#liveModels(d)&gt;0
	local full=if capacity&gt;0 then load/capacity else 0
	local faults=if typeof(compute.faults)=="table" then compute.faults else {}
	local accounts=accountsOf(e)
	local lines={}
	table.insert(lines,if not serving then "No model is serving · the racks idle" elseif capacity&lt;=0 then string.format("Serving %s users",Format.compact(live.users or 0)) else string.format("Servers %d%% full · %s users",math.floor(full*100+.5),Format.compact(live.users or 0)))
	if waiting&gt;0 then table.insert(lines,string.format("%s users waiting for capacity",Format.int(waiting))) end
	table.insert(lines,string.format("GPUs %d / %d slots · %.1f units · cooling %d%%",fleet.slotsUsed,HardwareConfig.slots(e),fleet.throughput,math.floor(HardwareConfig.thermal(e,fleet.throughput)*100+.5)))
	table.insert(lines,string.format("Reserved for clients %.1f units · %d account%s",tonumber(compute.reserved) or 0,#accounts,if #accounts==1 then "" else "s"))
	if #faults==0 then table.insert(lines,"Rack faults  none · every blade online")
	else
		for i=1,math.min(2,#faults) do
			local f=faults[i];local gpu=HardwareConfig.getGPU(tostring(f.gpu))
			table.insert(lines,string.format("Rack R%d fault · %s · %s",tonumber(f.slot) or 0,if gpu then gpu.label else tostring(f.gpu),if compute.it then "IT on the way" else "no IT on duty"))
		end
		if #faults&gt;2 then table.insert(lines,string.format("+ %d more rack faults",#faults-2)) end
	end
	table.insert(lines,if d.training then "Training  "..(trainingLine(d) or "running") else "Training  idle")
	local header=if #faults&gt;0 then "DATA HALL · RACK FAULT" elseif waiting&gt;0 then "DATA HALL · OVER CAPACITY" elseif serving and capacity&gt;0 then string.format("DATA HALL · %d%% LOAD",math.floor(full*100+.5)) elseif serving then "DATA HALL · SERVING" else "DATA HALL · IDLE"
	local footer=if Ops.stageIndex(e)&lt;2 then "Garage rack · no IT desk yet" elseif compute.it then "IT on duty · a fault takes about "..Ops.FAULT.it.." s to fix" else "No IT on duty · faults take about "..math.floor(Ops.FAULT.alone/60).." min"
	return header,table.concat(lines,"\n"),footer,math.clamp(full,0,1)
end
P.engineering=function(c)
	local d=c.d;local fleet=ModelMath.fleet(d.gpus);local stock=ModelMath.dataSummary(d.data)
	local current=if d.training then d.models[d.training.modelId] else Journey.latest(d)
	local progress=if d.training then math.clamp(d.training.workDone/math.max(1,d.training.workTotal),0,1) else 0
	local mode=if c.w then tostring(c.w:GetAttribute("WorkstationId") or "") else ""
	if #mode%2==0 then return "AI EMPIRE / DEV",string.format("model = %q\ndata.tokens = %s\ncompute.vram = %d GB\ntraining.status = %q\nteam.engineers = %.1f",title(current),Format.tokens(stock.total),fleet.vram,if d.training then "RUNNING" else "IDLE",Workforce.count(c.e,"engineer")),c.footer,progress end
	return P.training(c)
end
P.research=function(c)
	local e=c.e;local job=e.researchJob;local p=if job then math.clamp(job.elapsed/math.max(1,job.seconds),0,1) else 0
	local def=if job then EmpireConfig.find(EmpireConfig.RESEARCH,job.id) else nil
	return if job then "RESEARCH ACTIVE" else "RESEARCH · IDLE",string.format("Study  %s\nProgress  %.1f%%\nResearch points  %s\nProduction  %.1f points/s\n%s",if def then def.name else if job then job.id else "No active study",p*100,Format.compact(e.points),EmpireMath.bonuses(e).points,if job then "Better architecture helps your next model." else "Start a study in Company → Research."),c.footer,p
end
P.design=function(c)
	local d=c.d;local vram=ModelMath.fleet(d.gpus).vram;local lines={}
	for _,size in ModelConfig.SIZES do
		local research=size.id=="s7b" and not d.empire.research.frontier
		local state=if size.vram&gt;vram then string.format("needs %d GB more%s",size.vram-vram,if research then " + Frontier" else "") elseif research then "needs Frontier research" else "fits"
		table.insert(lines,string.format("%s  ·  %d GB VRAM  ·  %s",size.label,size.vram,state))
	end
	table.insert(lines,"Choose SIZE + FOCUS + RECIPE · good data decides quality")
	return "MODEL ARCHITECTURE",table.concat(lines,"\n"),guidance(d),0
end
P.evaluation=function(c)
	local m=Journey.latest(c.d);if not m then return "MODEL EVALUATION","No trained model yet.\nTrain a model, then compare its six benchmark scores here.",c.footer,0 end
	return "EVALUATION / "..title(m),string.format("Reasoning %.1f   Coding %.1f\nMath %.1f          Creativity %.1f\nKnowledge %.1f  Reliability %.1f\nOverall %.1f\n%s",m.stats.reasoning or 0,m.stats.coding or 0,m.stats.math or 0,m.stats.creativity or 0,m.stats.knowledge or 0,m.stats.reliability or 0,m.overall,if m.status=="trained" then "READY FOR RELEASE" else string.upper(m.status)),c.footer,math.min(1,m.overall/100)
end
P.growth=function(c)
	local s,d,e=c.s,c.d,c.e
	local accounts,retainer=accountsOf(e)
	return "DEPLOYMENT / CUSTOMERS",string.format("Users  %s\nRevenue  %s\nBusiness clients  %d · %s/day\nLive releases  %d\nModel → pricing → target → marketing → launch",Format.compact(s.live.users),Format.perDay(s.live.revenue),#accounts,money(retainer),d.stats.modelsReleased),c.footer,0
end
P.deployment=P.growth
P.milestones=function(c)
	local d=c.d
	return "COMPANY MILESTONES",string.format("Models trained  %d\nModels launched  %d\nBest benchmark  %.1f\nTotal revenue  %s\nYour next generation starts here.",d.stats.modelsTrained,d.stats.modelsReleased,d.stats.bestOverall,Format.money(d.stats.totalRevenue)),c.company,0
end
P.history=function(c)
	local d=c.d;local lines={}
	for i=math.max(1,#d.modelOrder-4),#d.modelOrder do local m=d.models[d.modelOrder[i]];if m then table.insert(lines,title(m).." / "..m.status.." / "..string.format("%.1f",m.overall or 0)) end end
	return "MODEL HISTORY",if #lines&gt;0 then table.concat(lines,"\n") else "Your first trained model starts the story.",c.company,0
end
P.journey=function(c)
	local flow=Journey.progress(c.d)
	return "BUILD YOUR FIRST AI",string.format("%d / 7  /  %s\n%s\nDATA → GPU → MODEL → TRAIN\nEVALUATE → RELEASE → GROW",flow.index,string.upper(flow.step.title),flow.step.body),guidance(c.d),(flow.index-1)/7
end
local function overview(c: Ctx,header: string): (string,string,string,number)
	local s,d=c.s,c.d;local best=Journey.latest(d)
	local body=string.format("Users %s   /   Revenue %s\nTeam %d    /    GPUs %d\nBest AI %.1f   /   Rank %s\nAsset value %s  /  Total revenue %s\n%s",Format.compact(s.live.users),Format.perDay(s.live.revenue),EmpireMath.staff(d.empire),gpuCount(d),d.stats.bestOverall,rankOf(s),Format.money(Service.assetValue(d)),Format.money(d.stats.totalRevenue),if d.training then "Training "..title(d.models[d.training.modelId]) else title(best))
	return header,body,"Live company data / "..(if s.live.rankings then s.live.rankings.status else "Rankings loading"),0
end
P.lobby=function(c) return overview(c,string.upper(c.company)) end
P.founder=function(c) return overview(c,"FOUNDER / COMPANY CONTROL") end
P.boardroom=function(c)
	-- The topic only shows while the boardroom seats are actually in use.
	local _,_,used,_,topic=meetingInfo(c,"Boardroom")
	if used&gt;0 and not topic then local t=attr(c.office,"MeetingTopic");topic=if typeof(t)=="string" then words(t) else nil end
	return overview(c,if used&gt;0 then string.upper(topic or "Board meeting") else "COMPANY REVIEW")
end

-- Reception (G_LOBBY): today's visitors, applicants and trips; the guest-house reception (H0_LOBBY) shows its guests
P.reception=function(c)
	local s,e=c.s,c.e;local campus=s.live.campus
	local trips=tripsOf(s)
	if c.entry and typeof(c.entry.roomId)=="string" and string.sub(c.entry.roomId,1,3)=="H0_" then
		local guests=attr(c.office,"HotelGuests");local rooms=attr(c.office,"HotelRooms")
		local hosted={}
		for _,t in trips do if t.hosted then local cl=Ops.client(t.client);table.insert(hosted,if cl then cl.name else tostring(t.client)) end end
		local g=Ops.GUEST
		local lines={
			string.format("Rooms %d · guests tonight %d",tonumber(rooms) or g.rooms,tonumber(guests) or Ops.hotelGuests(e)),
			if #hosted&gt;0 then "Client teams in house  "..table.concat(hosted,", ") else "No client team in house right now",
			string.format("Outside guests %d rooms · %s per night",math.floor(g.rooms*g.occupancy+.5),money(g.rate)),
			string.format("Company day %d · %s",Ops.day(e),hourText(Ops.hour(workspace:GetServerTimeNow()))),
		}
		return "GUEST HOUSE · RECEPTION",table.concat(lines,"\n"),"Client teams of hosted pilots stay two nights",0
	end
	local present,total=0,0
	for _,role in EmpireConfig.ROLES do for _,st in Ops.presence(e,role.id) do total+=1;if st=="present" then present+=1 end end end
	local applicants,waiting=0,0
	for _,a in e.applicants or {} do if a.st=="new" then applicants+=1 else waiting+=1 end end
	local lines={
		string.format("Visitors in the building  %d  ·  guest cards %d",if c.cache then c.cache.visitors else 0,if campus and campus.passes then #campus.passes else 0),
		string.format("Day %d · %s · team %d / %d in today",Ops.day(e),hourText(Ops.hour(workspace:GetServerTimeNow())),present,total),
		string.format("Candidates in the lounge %d · applications %d",waiting,applicants),
	}
	if #trips==0 then table.insert(lines,"Trips today  nobody is travelling")
	else
		for i=1,math.min(3,#trips) do table.insert(lines,"Trip  "..tripShort(trips[i])) end
		if #trips&gt;3 then table.insert(lines,string.format("+ %d more trips",#trips-3)) end
	end
	local accounts=accountsOf(e)
	table.insert(lines,string.format("Business clients %d · hosted visits %d",#accounts,typeof(e.deals)=="table" and e.deals.hosted or 0))
	return "WELCOME TO "..string.upper(c.company),table.concat(lines,"\n"),"Café &amp; showroom open to all · cards pass the speed gates",0
end
P.directory=function(c)
	local lift=if c.office then liftState(c.office) else nil;local lines={}
	for level=Plan.roofLevel(c.tier),-1,-1 do
		table.insert(lines,Plan.floorTitle(c.tier,level)..(if lift and lift.level==level then "   ← lift" else ""))
	end
	local here=if c.entry and typeof(c.entry.level)=="number" then "You are on "..Plan.floorTitle(c.tier,c.entry.level) else "Lift and stairs behind the atrium"
	return "BUILDING DIRECTORY",table.concat(lines,"\n"),here,0
end
P.showroom=function(c)
	local s,d=c.s,c.d;local released={}
	for _,id in d.modelOrder do local m=d.models[id];if m and m.release and (m.status=="live" or m.status=="retired") then table.insert(released,m) end end
	if #released==0 then return "MODEL SHOWROOM","No model released yet.\nTrain, evaluate and release your first model in the Lab;\nit will be presented here with its live users.",c.company,0 end
	local live=0;for _,m in released do if m.status=="live" then live+=1 end end
	local lines={string.format("Portfolio  %d released  ·  %d live",#released,live)}
	for i=#released,math.max(1,#released-2),-1 do
		local m=released[i]
		table.insert(lines,if m.status=="live" then string.format("%s · live · %.1f · %s users",title(m),m.overall or 0,Format.compact(usersOf(s,m))) else string.format("%s · %s · %.1f",title(m),m.status,m.overall or 0))
	end
	local ranked=table.clone(released);table.sort(ranked,function(a,b)return (a.overall or 0)&gt;(b.overall or 0) end)
	local a,b=ranked[1],ranked[2]
	if b then
		table.insert(lines,string.format("Best two  %s %.1f  vs  %s %.1f",title(a),a.overall or 0,title(b),b.overall or 0))
		table.insert(lines,benchmarks(a).."  /  "..benchmarks(b))
	else table.insert(lines,"Release a second model to compare benchmarks.") end
	return "MODEL SHOWROOM",table.concat(lines,"\n"),"R reason · C code · M math · Cr creative · K know · Rl reliable",if a then math.min(1,(a.overall or 0)/100) else 0
end
-- B2B clients (CORE_SPEC 3.2): accounts with their retainer, trips under way, the best lead
P.customers=function(c)
	local s,e=c.s,c.e;local lines={}
	local accounts,retainer=accountsOf(e)
	local limit=Ops.accountLimit(e)
	local ops=if typeof(s.live.ops)=="table" then s.live.ops else {}
	if #accounts==0 then
		table.insert(lines,"No business client yet.")
		table.insert(lines,"Your sales team visits clients by itself (08:00–15:00);")
		table.insert(lines,"a signed client pays a pilot fee, then every day.")
	else
		table.insert(lines,string.format("Accounts %d / %d · %s/day",#accounts,limit,money(retainer)))
		for i=1,math.min(4,#accounts) do
			local a=accounts[i]
			table.insert(lines,string.format("%s · %s/day · %s",a.client.name,money(a.client.retainer),if a.acc.renewing then "check-in under way" else "until day "..endDay(e,tonumber(a.acc.expires) or 0)))
		end
		if #accounts&gt;4 then table.insert(lines,string.format("+ %d more accounts",#accounts-4)) end
	end
	local trips=tripsOf(s)
	if #trips&gt;0 then table.insert(lines,"On the road  "..tripShort(trips[1])..(if #trips&gt;1 then string.format(" + %d",#trips-1) else "")) end
	local d2=e.deals;local bestLead,bestTrust=nil,-1
	if typeof(d2)=="table" and typeof(d2.trust)=="table" then
		for id,t in d2.trust do local cl=Ops.client(id);if cl and (tonumber(t) or 0)&gt;bestTrust and not (typeof(d2.accounts)=="table" and d2.accounts[id]) then bestTrust=tonumber(t) or 0;bestLead=cl end end
	end
	if bestLead then table.insert(lines,string.format("Best lead  %s · trust %d%%",bestLead.name,math.floor(math.min(1,bestTrust)*100))) end
	table.insert(lines,string.format("Signed %d · lost %d · retainers %s",typeof(d2)=="table" and d2.signed or 0,typeof(d2)=="table" and d2.lost or 0,Format.perDay((tonumber(ops.b2b) or 0)/60)))
	return "BUSINESS CLIENTS",table.concat(lines,"\n"),c.company,math.clamp(#accounts/math.max(1,limit),0,1)
end
P.product=function(c)
	local e=c.e;local job=e.projectJob;local lines={};local published,delivered=0,0
	for _,id in e.projectOrder do local item=e.projects[id];if item then
		if item.status=="published" then published+=1 end;if item.delivered then delivered+=1 end
	end end
	if #e.projectOrder==0 then return "PRODUCT STUDIO","No studio projects yet.\nBuild a website, online shop, game companion or\noffice automation with your model in Studio.",c.company,0 end
	table.insert(lines,string.format("Projects  %d  ·  %d published  ·  %d delivered",#e.projectOrder,published,delivered))
	local progress=0
	if job then
		local item=e.projects[job.id];progress=math.clamp(job.done/math.max(1,job.total),0,1)
		table.insert(lines,string.format("Building  %s · %.0f%% · quality %.1f",if item then item.name else "project",progress*100,if item then item.quality or 0 else 0))
	else table.insert(lines,"No project building · compute is free for training") end
	for i=#e.projectOrder,math.max(1,#e.projectOrder-3),-1 do
		local item=e.projects[e.projectOrder[i]]
		if item and (not job or item.id~=job.id) then
			local kind=StudioConfig.find(StudioConfig.KINDS,item.kind)
			table.insert(lines,string.format("%s · %s · %s · q %.1f",tostring(item.name),if kind then kind.name else tostring(item.kind),tostring(item.status),item.quality or 0))
		end
	end
	return "PRODUCT STUDIO",table.concat(lines,"\n"),c.company,progress
end
P.hr=function(c)
	local e=c.e;local b=EmpireMath.bonuses(e);local staff=EmpireMath.staff(e);local stage=Ops.stageIndex(e);local cap=EmpireConfig.OFFICES[stage].staff
	local lines={string.format("Team  %d / %d desks  ·  %d operations staff",staff,cap,Ops.opsPosts(e))}
	local vacation,sick=0,0
	for _,role in EmpireConfig.ROLES do
		local here=0
		for _,st in Ops.presence(e,role.id) do if st=="present" then here+=1 elseif st=="vacation" then vacation+=1 elseif st=="sick" then sick+=1 end end
		table.insert(lines,string.format("%s  %d / %d desks  ·  %d in today",if string.sub(role.name,-5)=="Sales" then role.name else role.name.."s",e.employees[role.id] or 0,Ops.seats(e,role.id),here))
	end
	table.insert(lines,string.format("Today  %d on vacation · %d sick · morale %d%%",vacation,sick,math.floor(Ops.morale(e)*100+.5)))
	table.insert(lines,"Wages  "..Format.money(b.wage*Ops.DAY).."/day"..(if Ops.apprenticeCount(e)&gt;0 then string.format("  ·  %d apprentices",Ops.apprenticeCount(e)) else ""))
	local nextOffice=EmpireConfig.OFFICES[stage+1]
	local hint=if staff&lt;cap then string.format("%d desks free · %s",cap-staff,if Ops.hrSettings(e) then "HR hires automatically" else "hire in Company → Team")
		elseif nextOffice then string.format("All desks filled · %s adds %d desks (%s)",nextOffice.name,nextOffice.staff-cap,Format.money(nextOffice.price))
		else "All desks filled in the largest headquarters"
	return "PEOPLE &amp; COMPANY",table.concat(lines,"\n"),hint,math.clamp(staff/math.max(1,cap),0,1)
end
P.security=function(c)
	if not c.office or not c.cache then return "CAMPUS SECURITY","Live building data appears once the headquarters is online.",c.company,0 end
	local st=securityState(c.office,c.cache);local lift=st.lift
	local outOfService=typeof(lift.state)=="string" and string.upper(lift.state)=="OUT_OF_SERVICE"
	local attention=st.locked&gt;0 or outOfService
	local lines={}
	if st.known and st.doors&gt;0 then
		table.insert(lines,string.format("Doors  %d  ·  %d moving or open  ·  %d locked",st.doors,st.open,st.locked))
		-- Compute Operations (G) and the Data Hall (B1) share the compute access class.
		table.insert(lines,if st.computeOpen&gt;0 then string.format("Compute areas  %d door open for staff passing",st.computeOpen) else "Compute Operations &amp; Data Hall doors closed")
	else table.insert(lines,"Door status not available yet") end
	table.insert(lines,liftText(c.tier,lift))
	table.insert(lines,string.format("Cameras  %d channels live",st.cameras))
	table.insert(lines,string.format("Visitors in the building  %d",c.cache.visitors))
	return if attention then "SECURITY · ATTENTION" else "SECURITY · ALL CLEAR",table.concat(lines,"\n"),if st.locked&gt;0 then "Lockdown active · exits keep working" else "Founder security desk · live",0
end
P.vault=function(c)
	local d=c.d;local lines={}
	for i=#d.modelOrder,math.max(1,#d.modelOrder-4),-1 do
		local m=d.models[d.modelOrder[i]]
		if not m then continue end
		local running=d.training and d.training.modelId==m.id
		table.insert(lines,if running then title(m).." · "..(trainingLine(d) or "training") else string.format("%s · %s · %.1f · %s",title(m),m.status,m.overall or 0,benchmarks(m)))
	end
	if #lines==0 then return "MODEL VAULT · CONFIDENTIAL","The vault is empty.\nEvery trained model version is archived here.",c.company,0 end
	return "MODEL VAULT · CONFIDENTIAL",table.concat(lines,"\n"),"R reason · C code · M math · Cr creative · K know · Rl reliable",0
end
P.secretlab=function(c)
	local d,e=c.d,c.e;local job=e.researchJob;local b=EmpireMath.bonuses(e)
	local unlocked={};for _,r in EmpireConfig.RESEARCH do if e.research[r.id] then table.insert(unlocked,r.name) end end
	local nextDef=nil
	for _,r in EmpireConfig.RESEARCH do if not e.research[r.id] and (not r.prereq or e.research[r.prereq]) and not (job and job.id==r.id) then nextDef=r;break end end
	local p=if job then math.clamp(job.elapsed/math.max(1,job.seconds),0,1) else 0
	local def=if job then EmpireConfig.find(EmpireConfig.RESEARCH,job.id) else nil
	local lines={
		if job then string.format("Active  %s · %.0f%% · %s left",if def then def.name else job.id,p*100,Format.duration(job.seconds-job.elapsed)) else "No study running in the lab",
		string.format("Unlocked %d / %d  %s",#unlocked,#EmpireConfig.RESEARCH,if #unlocked&gt;0 then table.concat(unlocked,", ") else "none yet"),
		if b.core&gt;0 or b.reliability&gt;0 then "Next models gain "..researchBonuses({core=b.core,reliability=b.reliability,serving=1}).."." else "Next models train without architecture bonuses yet.",
		string.format("Research runs at %.1f points/s with %s banked.",b.points,Format.compact(e.points)),
		if nextDef then string.format("Next breakthrough: %s (%d points).",nextDef.name,nextDef.points) else "Every known research project is complete.",
	}
	if d.stats.bestOverall&gt;0 then table.insert(lines,string.format("Best model so far: %.1f overall.",d.stats.bestOverall)) end
	return "PRIVATE RESEARCH",table.concat(lines,"\n"),"Founder only · not shown anywhere else",p
end
P.meeting=function(c)
	local room,seats,used,people,topic=meetingInfo(c)
	local name=if c.entry and c.entry.roomName then c.entry.roomName else words(room)
	if used==0 then return string.upper(name),if seats&gt;0 then string.format("Free\n%d seats · no meeting running",seats) else "Free\nNo meeting running",c.company,0 end
	if not topic then local t=attr(c.office,"MeetingTopic");topic=if typeof(t)=="string" then words(t) else "Team meeting" end
	local untilTime=attr(c.office,"MeetingUntil");local now=workspace:GetServerTimeNow()
	-- MeetingUntil is only trusted when it is a server timestamp (StaffService clock may differ).
	local ends=if typeof(untilTime)=="number" and untilTime&gt;1e6 and untilTime&gt;now then string.format(" · ends in %d min",math.ceil((untilTime-now)/60)) else ""
	return string.upper(name),string.format("In use · %s\n%d of %d seats taken%s\n%s",topic or "Team meeting",used,seats,ends,table.concat(people,", ")),c.company,math.clamp(used/math.max(1,seats),0,1)
end
P.cafe=function(c)
	local campus=c.e.campus;local lines={}
	for _,def in CampusConfig.SNACKS do table.insert(lines,string.format("%s  %s  ·  walk boost %d s",def.name,Format.money(def.price),def.seconds)) end
	table.insert(lines,string.format("Retail level %d / 4  ·  %s sales  ·  %s net",campus.retailLevel,Format.int(campus.retailSales),Format.money(campus.retailRevenue)))
	return "HOUSE KITCHEN · MENU",table.concat(lines,"\n"),"Open to visitors · pay at the counter",math.clamp(campus.retailLevel/4,0,1)
end
P.fleet=function(c)
	local campus=c.e.campus;local lines={};local owned=0
	for _,car in CampusConfig.CARS do
		local has=campus.cars[car.id]==true;if has then owned+=1 end
		table.insert(lines,string.format("%s  ·  %s  ·  %d studs/s",car.name,if campus.selectedCar==car.id then "selected" elseif has then "owned" else Format.money(car.price),car.speed))
	end
	return "COMPANY FLEET",table.concat(lines,"\n"),"Collect a car at the fleet desk or in Campus → Fleet",owned/math.max(1,#CampusConfig.CARS)
end
-- Fleet office (B1_FLEET): leased field cars, trips on the road, drivers, the company jet
P.operations=function(c)
	local s,e=c.s,c.e;local stage=Ops.stageIndex(e)
	local reps=Ops.fieldReps(e);local trips=tripsOf(s)
	local drivers=if stage&gt;=Ops.DRIVER.more then 2 elseif stage&gt;=Ops.DRIVER.from then 1 else 0
	local lines={
		string.format("Field cars leased %d · %s/day each",reps,money(Ops.FLEET_LEASE)),
		string.format("Drivers %d · %s/day each",drivers,money(Ops.DRIVER.wage)),
	}
	if #trips==0 then table.insert(lines,"On the road  nobody")
	else for i=1,math.min(3,#trips) do table.insert(lines,"On the road  "..tripShort(trips[i])) end end
	table.insert(lines,if e.jet==true then "Company jet  in the airport hangar · 2 pilots" elseif stage&gt;=Ops.JET.stage then "Company jet  not bought ("..money(Ops.JET.price)..")" else "Company jet  from the "..EmpireConfig.OFFICES[Ops.JET.stage].name)
	return "FLEET OPERATIONS",table.concat(lines,"\n"),"Cars for field reps · the boss's cars in Campus → Fleet",math.clamp(#trips/math.max(1,reps),0,1)
end
P.platform=function(c)
	local s,d,e=c.s,c.d,c.e;local live=liveModels(d)
	if #live==0 then return "PLATFORM OPERATIONS","No model is serving yet.\nRelease a trained model in the Lab to go live.",c.company,0 end
	local lines={
		string.format("Live models  %d  ·  %s users",#live,Format.compact(s.live.users)),
		string.format("Revenue %s  ·  costs %s",Format.perDay(s.live.revenue),Format.money(s.live.cost*Ops.DAY).."/day"),
	}
	for i=1,math.min(3,#live) do
		local m=live[i];local r=s.live.perModel and s.live.perModel[m.id]
		table.insert(lines,string.format("%s · %s users · %s",title(m),Format.compact(usersOf(s,m)),Format.perDay(if r then r.revenue or 0 else 0)))
	end
	local accounts=accountsOf(e)
	local reserved=if typeof(s.live.compute)=="table" then tonumber(s.live.compute.reserved) or 0 else 0
	table.insert(lines,string.format("Business clients  %d · %.1f compute units reserved",#accounts,reserved))
	if d.training and e.projectJob then table.insert(lines,string.format("Training uses %.0f%% of compute while a project builds",e.infrastructure.trainingShare*100)) end
	return "PLATFORM OPERATIONS",table.concat(lines,"\n"),"All live models serving normally",0
end
P.prototype=function(c)
	local d,e=c.d,c.e;local b=EmpireMath.bonuses(e);local vram=ModelMath.fleet(d.gpus).vram
	local m=Journey.latest(d,true);local lines={}
	if m then
		local size=sizeOf(m.sizeId)
		table.insert(lines,string.format("%s · %s · %s · overall %.1f",title(m),if size then size.label else "?",focusLabel(m.focusId),m.overall or 0))
		table.insert(lines,"Trained, not released · evaluate and release in the Lab")
		if size then table.insert(lines,string.format("%s needs %d GB VRAM · you have %d GB",size.label,size.vram,vram)) end
	else
		table.insert(lines,"No unreleased prototype right now.")
		table.insert(lines,"Trained models wait here until you release them.")
	end
	local _,nextSize=vramFit(d)
	table.insert(lines,if nextSize then string.format("Next size %s needs %d GB (%d GB more)",nextSize.label,nextSize.vram,nextSize.vram-vram) else "Your VRAM fits every model size")
	table.insert(lines,"Research  "..researchBonuses(b))
	table.insert(lines,string.format("Training speed x%.2f with team and research",b.speed))
	return "PROTOTYPE LAB",table.concat(lines,"\n"),guidance(d),0
end
P.secondary=function(c)
	local stock=ModelMath.dataSummary(c.d.data);local wf=c.s.live.workforce
	return "COMPANY OS / TEAM",string.format("Team  %d specialists\nData  %s tokens\nCompany time  %s",EmpireMath.staff(c.e),Format.tokens(stock.total),hourText(if wf then wf.hour else nil)),c.company,0
end

local TASK_KIND: {[string]:string}={
	CleanDataset="data",CheckQuality="data",MonitorPipeline="data",WriteCode="engineering",MonitorTraining="training",
	RunExperiment="research",ArchitectureStudy="research",AnalyzeModel="evaluation",ReviewModel="evaluation",
	AnalyzeMarket="growth",CheckCustomers="growth",PlanLaunch="growth",InspectServer="compute",InspectHardware="compute",
}
-- kind: LiveScreen kind; w: workstation Model of the screen (or nil); screen: the screen Part.
function Service.presentation(s: any,kind: string,w: Model?,screen: BasePart?): (string,string,string,number)
	local d=s.data;local company=if d.company then d.company.name else "Your Company"
	local office=if screen then screen:FindFirstAncestor("Office") else nil
	local cache=if office and office:IsA("Model") then scan(office) else nil
	local entry=if cache and screen then cache.byPart[screen] else nil
	local footer=FOOTER
	if w and w:GetAttribute("OccupiedBy") then
		if (tonumber(w:GetAttribute("LoginUntil")) or 0)&gt;workspace:GetServerTimeNow() then return "EMPLOYEE LOGIN",tostring(w:GetAttribute("EmployeeName") or ""),company,0 end
		local taskId=w:GetAttribute("Software")
		if kind=="secondary" then
			local stock=ModelMath.dataSummary(d.data);local wf=s.live.workforce
			return "COMPANY OS / TEAM",string.format("%s\nTask  %s\nWorkstation  %s\nData  %s tokens\nCompany time  %s",tostring(w:GetAttribute("EmployeeName") or "Employee"),if typeof(taskId)=="string" then words(taskId) else "Working",tostring(w:GetAttribute("WorkstationId") or ""),Format.tokens(stock.total),hourText(if wf then wf.hour else nil)),company,0
		end
		if typeof(taskId)=="string" and TASK_KIND[taskId] then kind=TASK_KIND[taskId] end
		footer=tostring(w:GetAttribute("EmployeeName") or "Employee").." / "..(if typeof(taskId)=="string" then words(taskId) else "Working")
	elseif w and w:GetAttribute("WorkstationType")=="Computer" then
		return company,"WORKSTATION LOCKED\nAvailable for your team's next task.\nUse this terminal to open Company OS.","SECURE / EMPLOYEE CARD",0
	end
	local tier=if cache then cache.tier else Plan.tierForOffice(d.empire.office)
	local ctx: Ctx={s=s,d=d,e=d.empire,w=w,screen=screen,office=if office and office:IsA("Model") then office else nil,cache=cache,entry=entry,tier=tier,company=company,footer=footer}
	local present=P[kind]
	if present then return present(ctx) end
	-- Unknown kinds show the company overview rather than an empty screen.
	return overview(ctx,company)
end
local function write(s: any,entry: any,time: number)
	local p: BasePart=entry.part
	local gui=p:FindFirstChild("Desktop");if not gui then return end
	local w: Model?=entry.w
	local kind=entry.kind;local header: string,body: string,footer: string,fill: number
	if w and w:GetAttribute("OccupiedBy") and (tonumber(w:GetAttribute("LoginUntil")) or 0)&gt;time then
		header="EMPLOYEE LOGIN";body=tostring(w:GetAttribute("EmployeeName") or "");footer="Company OS / secure session";fill=.15
	else header,body,footer,fill=Service.presentation(s,kind,w,p) end
	local texts: {[string]:string}={Header=header,Body=body,Footer=footer}
	for name,text in texts do
		local label=gui:FindFirstChild(name)
		if label and label:IsA("TextLabel") and label.Text~=text then label.Text=text end
	end
	local track=gui:FindFirstChild("ProgressTrack");local bar=if track then track:FindFirstChild("Fill") else nil
	if bar and bar:IsA("GuiObject") then
		local size=UDim2.fromScale(math.clamp(fill,0,1),1);if bar.Size~=size then bar.Size=size end
	end
	local t=s.data.training
	local alert=t~=nil and t.event~=nil and t.event.pending==true and (ALERT_KINDS[kind]==true or (w~=nil and w:GetAttribute("Software")=="MonitorTraining"))
	if p:GetAttribute("TrainingAlert")~=alert then p:SetAttribute("TrainingAlert",alert) end
end
function Service.tick(dt: number)
	clock+=dt;if clock&lt;1 then return end;clock=0
	local positions={};local players={}
	for _,s in Session.all() do if not s.closed and s.player.Character and s.player.Character.PrimaryPart then
		local position=s.player.Character.PrimaryPart.Position;table.insert(positions,position);table.insert(players,{userId=s.userId,position=position})
	end end
	local time=workspace:GetServerTimeNow()
	for _,p in Plot.all() do if p.office and p.owner then
		local s=Session.get(p.owner);if not s or s.closed then continue end
		local cache=scan(p.office)
		-- Visitors: other players standing inside this headquarters right now.
		local visitors=0
		if cache.cf then for _,other in players do
			if other.userId~=s.userId and Plan.inside(cache.tier,cache.cf:PointToObjectSpace(other.position)) then visitors+=1 end
		end end
		cache.visitors=visitors
		for _,entry in cache.screens do
			local screen=entry.part
			local distance=proximity(screen.Position,positions)
			if screen.Parent and distance&lt;250 then local interval=if distance&lt;120 then 1 else 6
				if entry.next&lt;=time then write(s,entry,time);entry.next=time+interval end
			end
		end
		local t=s.data.training
		p.office:SetAttribute("Training",t~=nil);p.office:SetAttribute("TrainingAlert",t~=nil and t.event~=nil and t.event.pending==true)
	end end
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000007"><Properties><string name="Name">WorkstationService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Workstation and activity registry per office (Models with WorkstationId, see SPEC §5/§10).
-- Built by ONE descendants scan and cached until reset (staff reassignment) or a new office.
-- Doors are not scanned here: navigation asks DoorService. One NPC per station; a seated player
-- (Seat.Occupant) blocks a chair for everyone, a player's workout (PlayerUntil) blocks a machine.
-- Props (design/PROPFX_CONTRACT.md): PropId -&gt; root; NPCs drive them with one FxUntil write per use
-- (useProp). Station attributes JobPose / JobItem / UseProp / StandCFrame are applied by perform and
-- undone by release (rig attributes Pose / Holding are written only when they change).
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Sound=require(script.Parent.CampusSoundService)
local Doors=require(script.Parent.DoorService)
local Workstations={}
local registries: {[Instance]:any}=setmetatable({},{__mode="k"}) :: any
local MACHINES={KitchenCoffeeMachine=true,PantryCoffee=true}
local MACHINE_RANGE=10
local function key(id: any): string return tostring(id) end
-- A reset (staff rebuild after hire/fire) keeps the old registry until the next scan, which moves
-- reservations of records that survive the rebuild (visitors, the assistant) onto the new entries.
-- Employees release their stations before the rebuild (StaffService.destroy), so theirs are gone.
local previous: { [Model]: any } = setmetatable({} :: any, { __mode = "k" })
function Workstations.scan(office: Model): any
 local existing=registries[office];if existing then return existing end
 local registry={all={},byId={},byKind={},meetings={},nodes={},machines={},kitchenMachine=nil::BasePart?,fridge=nil::Model?,props={}::{[string]:Instance},queue={},mops={}}
 for _,m in office:GetDescendants() do
  local propId=m:GetAttribute("PropId")
  if typeof(propId)=="string" and not registry.props[propId] then registry.props[propId]=m end
  if m:IsA("Model") then
   local id=m:GetAttribute("WorkstationId")
   if id~=nil then
    local position=m:GetAttribute("InteractionPosition")
    if typeof(position)~="Vector3" then position=m:GetPivot().Position end
    local seat=m:FindFirstChildWhichIsA("Seat",true)
    local w={model=m,id=id,kind=m:GetAttribute("WorkstationType") or "Unknown",department=m:GetAttribute("Department"),role=m:GetAttribute("Role"),
     floor=m:GetAttribute("Floor") or 0,access=m:GetAttribute("RoomAccess"),room=m:GetAttribute("HomeRoom"),meetingRoom=m:GetAttribute("MeetingRoom"),
     group=m:GetAttribute("ConversationGroup"),position=position,seat=seat,allow={},machine=nil,
     index=m:GetAttribute("QueueIndex") or m:GetAttribute("MopIndex")}
    registry.byId[id]=w;table.insert(registry.all,w)
   elseif m.Name=="Door_G_FRIDGE" then registry.fridge=m end
  elseif m:IsA("BasePart") then
   if MACHINES[m.Name] then table.insert(registry.machines,m);if m.Name=="KitchenCoffeeMachine" then registry.kitchenMachine=m end
   elseif m:GetAttribute("NavigationNode") then table.insert(registry.nodes,m) end
  end
 end
 table.sort(registry.all,function(a,b)return key(a.id)&lt;key(b.id) end)
 for _,w in registry.all do
  local list=registry.byKind[w.kind];if not list then list={};registry.byKind[w.kind]=list end;table.insert(list,w)
  if w.kind=="Meeting" then
   local room=w.meetingRoom or w.room or "Meeting"
   local group=registry.meetings[room];if not group then group={id=room,level=w.floor,seats={}};registry.meetings[room]=group end
   table.insert(group.seats,w)
  elseif w.kind=="Queue" then table.insert(registry.queue,w)
  elseif w.kind=="Mop" then table.insert(registry.mops,w) end
 end
 local function byIndex(a: any,b: any): boolean return (tonumber(a.index) or 0)&lt;(tonumber(b.index) or 0) end
 table.sort(registry.queue,byIndex);table.sort(registry.mops,byIndex)
 local old=previous[office];previous[office]=nil
 if old then
  for id,ow in old.byId do
   local r=ow.reserved;local nw=registry.byId[id]
   if r and nw and nw.model==ow.model and (not r.model or r.model.Parent) then
    nw.reserved=r;if r.station==ow then r.station=nw end
   end
  end
 end
 registries[office]=registry;return registry
end
function Workstations.reset(office: Model) previous[office]=registries[office] or previous[office];registries[office]=nil end
-- Current level of an employee record (building-local height → Plan level).
function Workstations.levelOf(e: any): number
 local y=e.cf:PointToObjectSpace(e.root.Position).Y
 return Plan.levelAt(e.tier,y) or (if y&lt;0 then -1 else 0)
end
function Workstations.allowed(w: any,e: any): boolean
 if not w.model.Parent then return false end
 local cached=w.allow[e.role]
 if cached==nil then
  -- Static per office: role clearance for the room class and the plan zone at the standing point.
  cached=Plan.roleAllows(e.role,w.access) and (w.role==nil or w.role=="any" or w.role==e.role) and Plan.employeeAllowed(e.role,e.tier,e.cf:PointToObjectSpace(w.position))
  w.allow[e.role]=cached
 end
 return cached
end
function Workstations.available(w: any,e: any): boolean
 if not (Workstations.allowed(w,e) and (not w.reserved or w.reserved==e) and (not w.seat or not w.seat.Occupant or w.seat.Occupant==e.humanoid)) then return false end
 local player=w.model:GetAttribute("PlayerUntil") -- a player's workout session on this machine
 return not (typeof(player)=="number" and player&gt;workspace:GetServerTimeNow())
end
-- Rig attributes for the client (EmployeeController): written only when they change.
function Workstations.setPose(e: any,pose: string?)
 if e.pose==pose then return end
 e.pose=pose;if e.model.Parent then e.model:SetAttribute("Pose",pose) end
end
function Workstations.setItem(e: any,item: string?)
 if e.item==item then return end
 e.item=item;if e.model.Parent then e.model:SetAttribute("Holding",item) end
end
-- One state write on a prop root: works for `seconds` (&lt;= 0 stops it). Returns the root or nil.
function Workstations.useProp(office: Model,id: any,seconds: number): Instance?
 if typeof(id)~="string" then return nil end
 local root=Workstations.scan(office).props[id]
 if not root or not root.Parent then return nil end
 root:SetAttribute("FxUntil",if seconds&gt;0 then workspace:GetServerTimeNow()+seconds else 0)
 return root
end
function Workstations.reserve(w: any,e: any): boolean
 if not Workstations.available(w,e) then return false end
 if e.station and e.station~=w then Workstations.release(e) end
 w.reserved=e;w.model:SetAttribute("ReservedBy",e.index);e.station=w;return true
end
-- Frees the station, the seat weld, the anchor and a finished cup, and undoes what perform applied
-- from the station (pose, item, prop in use, a snap onto a machine). Safe to call repeatedly.
function Workstations.release(e: any)
 local w=e.station
 if w and w.reserved==e then
  w.reserved=nil;w.model:SetAttribute("ReservedBy",nil);w.model:SetAttribute("OccupiedBy",nil);w.model:SetAttribute("EmployeeName",nil);w.model:SetAttribute("Software",nil);w.model:SetAttribute("LoginUntil",nil)
 end
 if e.usingProp then
  -- stop the prop only if nobody (a player) restarted it meanwhile
  local root=Workstations.scan(e.office).props[e.usingProp]
  if root and root:GetAttribute("FxUntil")==e.usingPropUntil then root:SetAttribute("FxUntil",0) end
  e.usingProp=nil;e.usingPropUntil=nil
 end
 if e.stationPose then e.stationPose=nil;Workstations.setPose(e,nil) end
 if e.stationItem then e.stationItem=nil;Workstations.setItem(e,nil) end
 if e.humanoid and e.humanoid.Parent then e.humanoid.Sit=false end
 if e.snapped and e.root and e.root.Parent then
  -- step back off the machine onto the floor point the employee walked to
  local back=e.snapped;e.snapped=nil
  e.root.CFrame=CFrame.new(back)*(e.root.CFrame-e.root.CFrame.Position)
 end
 if e.root and e.root.Parent then e.root.Anchored=false end
 local cup=e.model:FindFirstChild("EmployeeCup");if cup and (not e.carryCupUntil or workspace:GetServerTimeNow()&gt;=e.carryCupUntil) then cup:Destroy();e.model:SetAttribute("HoldingCup",false) end
 e.station=nil
end
-- Best free station for a task. Coffee-style tasks (nearest=true) take the closest point, counting
-- each level of difference as 80 studs so the pantry on the employee's own floor wins.
function Workstations.choose(e: any,taskDef: any): any
 local list=Workstations.scan(e.office).byKind[taskDef.type];if not list then return nil end
 local here=e.root.Position;local level=Workstations.levelOf(e)
 local best=nil;local score=-math.huge
 for _,w in list do
  if taskDef.room and w.meetingRoom~=taskDef.room then continue end
  if taskDef.access and w.access~=taskDef.access then continue end
  if taskDef.type=="Service" and e.home~=nil and key(e.home)~="" and key(w.id)~=key(e.home) then continue end
  if not Workstations.available(w,e) then continue end
  local flat=Vector3.new(w.position.X-here.X,0,w.position.Z-here.Z).Magnitude
  local levels=math.abs(w.floor-level)
  local value=if taskDef.nearest then -(flat+levels*80)
   else (if Config.departmentMatch(taskDef,w.department) then 120 else 0)+(if e.home~=nil and key(w.id)==key(e.home) then 45 else 0)-flat*.15-levels*12
  if value&gt;score then best=w;score=value end
 end
 return best
end
-- Nearest coffee machine part within MACHINE_RANGE of a station (cached per station).
function Workstations.machineFor(office: Model,w: any): BasePart?
 if w.machine==nil then
  local best: BasePart?=nil;local distance=MACHINE_RANGE
  for _,m in Workstations.scan(office).machines do
   local d=(m.Position-w.position).Magnitude;if m.Parent and d&lt;=distance then best=m;distance=d end
  end
  w.machine=best or false
 end
 return if w.machine then w.machine else nil
end
-- opts.stand: work standing in front of a seated station (IT fixing a desk) instead of sitting down.
function Workstations.perform(e: any,time: number,opts: {stand: boolean?}?): boolean
 local w=e.station;if not w or w.reserved~=e or not Workstations.available(w,e) then return false end
 if w.kind=="Coffee" then
  local machine=Workstations.machineFor(e.office,w)
  if machine then
   Sound.play(machine,"coffee");e.brewMachine=machine;e.brewUntil=time+4
   machine:SetAttribute("FxUntil",workspace:GetServerTimeNow()+4) -- PropFx: steam + brew light for 4 s (client)
  end
 elseif w.kind=="Fridge" then
  local door=Workstations.scan(e.office).fridge;if door then Doors.requestNPC(e.model,door) end
 end
 w.model:SetAttribute("OccupiedBy",e.index);w.model:SetAttribute("EmployeeName",e.name);w.model:SetAttribute("Software",e.task.id);w.model:SetAttribute("LoginUntil",workspace:GetServerTimeNow()+1.8)
 e.model:SetAttribute("Workstation",w.id);e.model:SetAttribute("WorkstationType",w.kind);e.model:SetAttribute("Task",e.task.id)
 local pose=w.model:GetAttribute("JobPose");if typeof(pose)=="string" then e.stationPose=true;Workstations.setPose(e,pose) end
 local item=w.model:GetAttribute("JobItem");if typeof(item)=="string" then e.stationItem=true;Workstations.setItem(e,item) end
 local use=w.model:GetAttribute("UseProp")
 if typeof(use)=="string" then
  local root=Workstations.useProp(e.office,use,600)
  if root then e.usingProp=use;e.usingPropUntil=root:GetAttribute("FxUntil") end
 end
 local stand=w.model:GetAttribute("StandCFrame")
 if typeof(stand)=="CFrame" then
  -- machines you stand on (treadmill): snap onto the belt, back to the floor point on release
  e.snapped=w.position;e.humanoid:MoveTo(e.root.Position);e.humanoid.AutoRotate=false
  e.root.CFrame=stand;e.root.Anchored=true
  return true
 end
 if w.seat and not (opts and opts.stand) then
  -- Sit is the engine's real seat weld, rather than a character placed in front of a desk.
  e.humanoid.AutoRotate=false;e.root.Anchored=false;w.seat:Sit(e.humanoid)
  e.root.Anchored=true
 else
  e.humanoid:MoveTo(e.root.Position);e.humanoid.AutoRotate=false
  local target=w.model:GetAttribute("FacingPosition")
  if typeof(target)~="Vector3" then target=if w.model.PrimaryPart then w.model.PrimaryPart.Position else nil end
  if typeof(target)=="Vector3" then
   local delta=Vector3.new(target.X-e.root.Position.X,0,target.Z-e.root.Position.Z)
   if delta.Magnitude&gt;.2 then e.root.CFrame=CFrame.lookAt(e.root.Position,e.root.Position+delta) end
  end
  e.root.Anchored=true
 end
 return true
end
-- Admin diagnostics: totals plus per-type {total, reserved, occupied}.
function Workstations.inspect(office: Model): any
 local out={total=0,reserved=0,occupied=0,playerSeated=0,byType={}}
 for _,w in Workstations.scan(office).all do
  local t=out.byType[w.kind];if not t then t={total=0,reserved=0,occupied=0};out.byType[w.kind]=t end
  local occupant=if w.seat then w.seat.Occupant else nil
  local occupied=w.model:GetAttribute("OccupiedBy")~=nil or occupant~=nil
  out.total+=1;t.total+=1
  if w.reserved then out.reserved+=1;t.reserved+=1 end
  if occupied then out.occupied+=1;t.occupied+=1 end
  if occupant and (not w.reserved or occupant~=w.reserved.humanoid) then out.playerSeated+=1 end
 end
 return out
end
return Workstations
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000008"><Properties><string name="Name">EmployeeNavigation</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Bounded asynchronous path jobs. Ordinary travel is Humanoid movement, never PivotTo.
-- Contract: every Nav.go ends in exactly ONE callback(ok) unless Nav.cancel aborts it first (cancel
-- never calls back: whoever cancels owns the employee state). A destination outside the employee's
-- clearance calls back(false) at once; every other ending goes through finish(), which clears e.nav
-- and bumps the token BEFORE calling back. Async path results and engine events carry the token and
-- are dropped once it changed.
-- Levels: Plan.levelAt. Different levels → stairs or lift by personality and level distance (lift for
-- 3+ levels, usually for 2 and for B1). A route that starts or ends in the guest house (Plan.annexAt)
-- never uses the HQ lift: it walks (its own stair), and a failed path retries via the stair entry of the
-- building part it starts in. Buildings without a lift (garage stage, plan tier 0) only walk. Lift: walk to
-- the lobby wait point, LiftService.npcCall, then follow the ticket (walk to target while waiting/board/exit, stand still while riding, continue on
-- done; failed or a wait &gt; LIFT_WAIT → stairs). Stairs: one path through the smooth stair ramps; if
-- that fails, a path to Plan.stairEntry(level) first.
-- Doors: DoorService.doorsNear(root, DOOR_SCAN); a closed door whose doorway the next part of the route
-- crosses (Layout door line test; Sensor test for doors outside the plan) is requested
-- (DoorService.requestNPC, within its 8-stud range) and the employee holds outside its Sensor, ~2.5
-- studs before it, until isPassable (DOOR_WAIT timeout → recompute). A door class the role may not
-- enter fails the route. Speed gates are ordinary doors here (one lane = one door).
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Pathfinding=game:GetService("PathfindingService")
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout=require(ReplicatedStorage.Shared.BuildingLayout)
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Doors=require(script.Parent.DoorService)
local Lift=require(script.Parent.LiftService)
local Nav={}
local queue={};local activeJobs=0
local REACH=2.2 -- horizontal distance at which a waypoint counts as reached
local DOOR_GAP=2.5 -- wait this far before a closed door's Sensor
local DOOR_SCAN=12 -- doorsNear radius: swing-door Sensors reach ~7 studs from the doorway, so a 7-stud scan would find them too late
local REQUEST_RANGE=7.6 -- DoorService.requestNPC accepts employees within 8 studs of the doorway centre
local LIFT_TIMEOUT=180 -- absolute safety net for a whole ride
local AGENT={AgentRadius=1.2,AgentHeight=5.6,AgentCanJump=false,AgentCanClimb=false,WaypointSpacing=5} -- radius fits 3-stud speed-gate lanes
local costCache: {[string]:{[string]:number}}={}
local doorDefs: {[number]:{[string]:any}}={}
-- PathfindingModifier labels are access classes; forbidden classes cost math.huge (impassable).
local function costs(role: string): {[string]:number}
 local cached=costCache[role];if cached then return cached end
 local c: {[string]:number}={}
 for _,class in Plan.CLASSES do c[class]=if Plan.roleAllows(role,class) then 1 else math.huge end
 costCache[role]=c;return c
end
local function doorDef(tier: number,id: any): any
 local map=doorDefs[tier]
 if not map then
  local built: {[string]:any}={};for _,d in Layout.doors(tier) do built[d.id]=d end
  doorDefs[tier]=built;map=built
 end
 return if typeof(id)=="string" then map[id] else nil
end
local function allowed(e: any,p: Vector3): boolean
 return Plan.employeeAllowed(e.role,e.tier,e.cf:PointToObjectSpace(p))
end
local function levelAt(e: any,p: Vector3): number
 local y=e.cf:PointToObjectSpace(p).Y;return Plan.levelAt(e.tier,y) or (if y&lt;0 then -1 else 0)
end
local function flat(a: Vector3,b: Vector3): number return Vector3.new(a.X-b.X,0,a.Z-b.Z).Magnitude end
local function disconnect(e: any)
 if e.blocked then e.blocked:Disconnect();e.blocked=nil end
 if e.moveFinished then e.moveFinished:Disconnect();e.moveFinished=nil end
end
local function stand(e: any)
 if e.humanoid and e.humanoid.Parent and e.root.Parent and not e.root.Anchored then e.humanoid:MoveTo(e.root.Position) end
end
local function dropTicket(e: any,n: any)
 if n.ticket then Lift.npcCancel(n.ticket);n.ticket=nil end
 if n.liftActivity then n.liftActivity=false;e.model:SetAttribute("Activity",e.state) end
end
-- Abort without callback.
function Nav.cancel(e: any)
 local n=e.nav
 e.navToken=(e.navToken or 0)+1;e.nav=nil;e.queued=false;disconnect(e)
 if n then dropTicket(e,n) end
 stand(e)
end
-- The single place that ends a started route.
local function finish(e: any,ok: boolean)
 local n=e.nav;if not n then return end
 local cb=n.callback
 e.navToken=(e.navToken or 0)+1;e.nav=nil;e.queued=false;disconnect(e);dropTicket(e,n)
 if ok then e.model:SetAttribute("NavigationIssue",nil) else stand(e) end
 cb(ok)
end
local function enqueue(e: any,at: number)
 local n=e.nav;if not n then return end
 n.retryAt=at;n.points=nil;n.door=nil;n.phase="queued"
 if e.queued then return end
 e.queued=true;table.insert(queue,{employee=e,token=e.navToken})
end
local function fail(e: any,time: number,reason: string)
 local n=e.nav;if not n then return end
 disconnect(e);n.points=nil;n.door=nil;n.retries+=1;stand(e);e.model:SetAttribute("NavigationIssue",reason)
 if n.retries&gt;=3 then e.model:SetAttribute("NavigationIssue","Waiting for a clear route");finish(e,false)
 else enqueue(e,time+.5*n.retries) end
end
-- Plan tier of the building this walker is in: the office's OfficeTier (the built plan tier), else e.tier.
local function planTier(e: any): number
 local office=e.office
 local t=if typeof(office)=="Instance" then office:GetAttribute("OfficeTier") else nil
 return if typeof(t)=="number" then t else (tonumber(e.tier) or 1)
end
-- "hotel" when the world point lies in the guest house of this office's tier (nil = HQ / site).
local function annexOf(e: any,p: Vector3): string?
 return Plan.annexAt(planTier(e),e.cf:PointToObjectSpace(p))
end
local function chooseMode(e: any,from: number,to: number): string
 if from==to then return "walk" end
 local span=math.abs(to-from);local fondness=e.personality.stairs or .5;local basement=from&lt;0 or to&lt;0
 if span&gt;=3 then return "lift" end
 if span==2 then return if fondness&gt;.8 and not basement then "stairs" else "lift" end
 if basement then return if fondness&gt;.85 then "stairs" else "lift" end
 return if fondness&lt;.25 then "lift" else "stairs"
end
local function toStairs(e: any,time: number,reason: string)
 local n=e.nav;if not n then return end
 dropTicket(e,n);n.mode="stairs";n.stage="walk";n.viaStair=false;n.goal=nil
 e.model:SetAttribute("NavigationIssue",reason);stand(e);enqueue(e,time)
end
local function goal(e: any,n: any): Vector3
 if n.stage=="toLift" then return e.cf*Plan.liftWaitPoint(n.source,n.slot)
 elseif n.stage=="toStair" then
  if n.annex then return e.cf*Plan.stairEntryFor(annexOf(e,e.root.Position),n.source) end
  return e.cf*Plan.stairEntry(n.source)
 end
 return n.target
end
local function callLift(e: any,time: number)
 local n=e.nav;if not n then return end
 local ticket=Lift.npcCall(e.office,e.model,n.source,n.destination)
 if not ticket then toStairs(e,time,"Lift unavailable");return end
 n.ticket=ticket;n.stage="lift";n.phase="lift";n.liftStart=time;n.liftState="waiting";n.liftActivity=true;n.goal=nil
 e.model:SetAttribute("Activity","ELEVATOR")
end
local function arrived(e: any,time: number)
 local n=e.nav;if not n then return end
 disconnect(e);n.points=nil
 if n.stage=="toLift" then callLift(e,time)
 elseif n.stage=="toStair" then n.stage="walk";enqueue(e,time)
 else finish(e,true) end
end
local function nextWaypoint(e: any,time: number)
 local n=e.nav;if not n or not n.points then return end
 while n.index&lt;=#n.points and flat(n.points[n.index].Position,e.root.Position)&lt;REACH and math.abs(n.points[n.index].Position.Y-e.root.Position.Y)&lt;6 do n.index+=1 end
 if n.index&gt;#n.points then arrived(e,time);return end
 local point=n.points[n.index]
 n.phase="moving";n.deadline=time+math.max(3,flat(point.Position,e.root.Position)/e.personality.walkSpeed+3)
 e.humanoid:MoveTo(point.Position)
end
-- A direct path failed: stairs routes retry via the stair entry, a lift lobby route takes the stairs.
local function unreachable(e: any,time: number)
 local n=e.nav;if not n then return end
 if n.stage=="walk" and n.mode=="stairs" and not n.viaStair then n.viaStair=true;n.stage="toStair";enqueue(e,time);return end
 if n.stage=="toLift" then toStairs(e,time,"Lift lobby unreachable");return end
 fail(e,time,"Path unavailable")
end
function Nav.go(e: any,target: Vector3,time: number,callback: (boolean)-&gt;())
 Nav.cancel(e)
 if not allowed(e,target) then e.model:SetAttribute("NavigationIssue","Restricted destination");callback(false);return end
 e.humanoid.EvaluateStateMachine=true;e.root.Anchored=false;e.humanoid.Sit=false;e.humanoid.AutoRotate=true;e.humanoid.WalkSpeed=e.personality.walkSpeed
 pcall(function()e.root:SetNetworkOwner(nil)end)
 local source=levelAt(e,e.root.Position);local destination=levelAt(e,target);local mode=chooseMode(e,source,destination)
 -- guest house routes and buildings without a lift never call the HQ lift (stairs = one walked path)
 local annex=annexOf(e,e.root.Position)~=nil or annexOf(e,target)~=nil
 if mode=="lift" and (annex or planTier(e)&lt;1) then mode="stairs" end -- plan tier 0: no lift (Plan.liftStops empty)
 e.nav={target=target,callback=callback,retries=0,index=1,retryAt=time,source=source,destination=destination,mode=mode,
  stage=if mode=="lift" then "toLift" else "walk",slot=e.index%6+1,phase="queued",doorRequests={},annex=if annex then true else nil}
 enqueue(e,time)
end
function Nav.pump(time: number)
 local launched=0
 for i=#queue,1,-1 do
  local entry=queue[i];local e=entry.employee
  if entry.token~=e.navToken then table.remove(queue,i)
  elseif not e.nav or not e.model.Parent then table.remove(queue,i);e.queued=false
  elseif time&gt;=e.nav.retryAt and activeJobs&lt;Config.MAX_PATH_JOBS and launched&lt;Config.MAX_PATH_JOBS then
   table.remove(queue,i);e.queued=false;activeJobs+=1;launched+=1
   local n=e.nav;n.phase="computing";n.source=levelAt(e,e.root.Position)
   local token=e.navToken;local start=e.root.Position;local target=goal(e,n)
   task.spawn(function()
    local path: Path?=nil
    local ok=pcall(function()
     local params=table.clone(AGENT) :: any;params.Costs=costs(e.role)
     local p=Pathfinding:CreatePath(params);path=p;p:ComputeAsync(start,target)
    end)
    activeJobs-=1 -- always reached: the job slot can never leak
    local now=e.now or time
    if token~=e.navToken or not e.nav or not e.model.Parent then return end
    if not ok or not path or path.Status~=Enum.PathStatus.Success then unreachable(e,now);return end
    local points=path:GetWaypoints()
    if #points&lt;1 then fail(e,now,"Empty route");return end
    for _,p in points do if not allowed(e,p.Position) then fail(e,now,"Restricted waypoint");return end end
    local m=e.nav;m.points=points;m.index=1;m.doorRequests={}
    disconnect(e)
    e.blocked=path.Blocked:Connect(function(index)
     local cur=e.nav;if token==e.navToken and cur and cur.points and cur.phase=="moving" and index&gt;=cur.index then fail(e,e.now or now,"Path blocked") end
    end)
    e.moveFinished=e.humanoid.MoveToFinished:Connect(function(reached)
     local cur=e.nav;if token~=e.navToken or not cur or cur.phase~="moving" or not cur.points then return end
     local point=cur.points[cur.index];if not point then return end
     if flat(point.Position,e.root.Position)&lt;=REACH+.8 then cur.index+=1;nextWaypoint(e,e.now or now)
     elseif not reached then fail(e,e.now or now,"Move timed out") end
    end)
    nextWaypoint(e,now)
   end)
  end
 end
end
-- Door geometry ----------------------------------------------------------------------------
local function sensorOf(door: Model): BasePart?
 local s=door:FindFirstChild("Sensor");return if s and s:IsA("BasePart") then s else nil
end
-- Doorway centre as DoorService measures NPC request range (the Sensor sits on the closed leaves).
local function doorCentre(door: Model): Vector3
 local s=sensorOf(door);return if s then s.Position else door:GetPivot().Position
end
local function insideBox(box: BasePart,p: Vector3,margin: number): boolean
 local l=box.CFrame:PointToObjectSpace(p);local h=box.Size/2
 return math.abs(l.X)&lt;=h.X+margin and math.abs(l.Z)&lt;=h.Z+margin and math.abs(l.Y)&lt;=h.Y+4
end
-- Horizontal distance from a point to the door Sensor box (0 = inside).
local function gapAt(e: any,door: Model,def: any,p: Vector3): number
 local sensor=sensorOf(door)
 if sensor then
  local l=sensor.CFrame:PointToObjectSpace(p);local h=sensor.Size/2
  local dx=math.max(math.abs(l.X)-h.X,0);local dz=math.max(math.abs(l.Z)-h.Z,0)
  return math.sqrt(dx*dx+dz*dz)
 end
 if def then
  local q=e.cf:PointToObjectSpace(p)
  return math.max(math.abs(if def.axis=="x" then q.Z-def.z else q.X-def.x)-def.w/2,0)
 end
 return math.max(flat(door:GetPivot().Position,p)-3,0)
end
-- Does the next stretch of the route (root → next three waypoints) pass through this doorway?
local function onRoute(e: any,n: any,door: Model,def: any): boolean
 local kind=door:GetAttribute("DoorKind")
 if kind=="cubicle" or kind=="fridge" then return false end
 local pts={e.root.Position}
 for k=n.index,math.min(n.index+2,#n.points) do table.insert(pts,n.points[k].Position) end
 if def then
  local base=Plan.levelY(def.level);local half=def.w/2+.6;local centre=if def.axis=="x" then def.x else def.z
  for i=1,#pts-1 do
   local a=e.cf:PointToObjectSpace(pts[i]);local b=e.cf:PointToObjectSpace(pts[i+1])
   local da=if def.axis=="x" then a.Z-def.z else a.X-def.x
   local db=if def.axis=="x" then b.Z-def.z else b.X-def.x
   if da~=db and ((da&lt;=0 and db&gt;=0) or (da&gt;=0 and db&lt;=0)) then
    local t=da/(da-db)
    local u=if def.axis=="x" then a.X+(b.X-a.X)*t else a.Z+(b.Z-a.Z)*t
    local y=a.Y+(b.Y-a.Y)*t
    if math.abs(u-centre)&lt;=half and y&gt;base-3 and y&lt;base+12 then return true end
   end
  end
  return false
 end
 local sensor=sensorOf(door);if not sensor then return false end
 for i=1,#pts-1 do for s=0,8 do if insideBox(sensor,pts[i]:Lerp(pts[i+1],s/8),.25) then return true end end end
 return false
end
-- Where to wait for a closed door: outside its Sensor, ~DOOR_GAP before it, but never beyond
-- DoorService's NPC request range (wide swing doors have Sensors ~7 studs deep on each side).
local function holdPoint(e: any,n: any,door: Model,def: any,gap: number): Vector3
 local here=e.root.Position;local centre=doorCentre(door)
 local toward=Vector3.new(centre.X-here.X,0,centre.Z-here.Z)
 if gap&lt;=0 then
  -- Inside the Sensor: step back out, stopping at DOOR_GAP or before leaving the request range.
  local away=-toward
  if away.Magnitude&lt;.1 then
   local back=n.points and n.points[math.max(1,n.index-1)]
   away=if back then Vector3.new(back.Position.X-here.X,0,back.Position.Z-here.Z) else Vector3.xAxis
   if away.Magnitude&lt;.1 then away=Vector3.xAxis end
  end
  local dir=away.Unit;local s=0
  while s&lt;10 do
   local p=here+dir*s;local g=gapAt(e,door,def,p)
   if g&gt;=.5 and (g&gt;=DOOR_GAP or (p-centre).Magnitude&gt;REQUEST_RANGE-.4) then return p end
   s+=.25
  end
  return here+dir*s
 end
 if toward.Magnitude&lt;.1 then return here end
 local dir=toward.Unit;local first: number?=nil;local inRange: number?=nil;local edge: number?=nil;local s=0
 while s&lt;=gap+1 do
  local p=here+dir*s;local g=gapAt(e,door,def,p)
  if not first and g&lt;=DOOR_GAP then first=s end
  if not inRange and (p-centre).Magnitude&lt;=REQUEST_RANGE then inRange=s end
  if g&lt;=.5 then edge=s;break end
  s+=.25
 end
 local stop=math.max(first or 0,inRange or 0)
 if edge then stop=math.min(stop,edge) end
 return here+dir*stop
end
local function request(e: any,n: any,door: Model,time: number)
 if time&gt;=(n.doorRequests[door] or 0) and (e.root.Position-doorCentre(door)).Magnitude&lt;=REQUEST_RANGE+.3 then
  Doors.requestNPC(e.model,door);n.doorRequests[door]=time+.75
 end
end
-- true while the employee is held by a door (or the route just failed).
local function doorTick(e: any,n: any,time: number): boolean
 if n.door then
  local door=n.door
  if not door.Parent or Doors.isPassable(door) then n.door=nil;nextWaypoint(e,time);return false end
  if time&gt;=n.doorUntil then n.door=nil;fail(e,time,"Door did not open");return true end
  request(e,n,door,time)
  return true
 end
 for _,door in Doors.doorsNear(e.office,e.root.Position,DOOR_SCAN) do
  if Doors.isPassable(door) then continue end
  local def=doorDef(e.tier,door:GetAttribute("DoorId"))
  if not onRoute(e,n,door,def) then continue end
  local class=door:GetAttribute("AccessClass")
  if not Plan.roleAllows(e.role,if typeof(class)=="string" then class else nil) then fail(e,time,"Door access denied");return true end
  request(e,n,door,time)
  local gap=gapAt(e,door,def,e.root.Position)
  if gap&lt;=DOOR_GAP+e.personality.walkSpeed*.3 then
   n.door=door;n.doorUntil=time+Config.DOOR_WAIT;n.phase="door"
   local p=holdPoint(e,n,door,def,gap)
   e.humanoid:MoveTo(Vector3.new(p.X,e.root.Position.Y,p.Z))
   return true
  end
 end
 return false
end
-- Lift ticket ------------------------------------------------------------------------------
local function liftTick(e: any,n: any,time: number)
 local info=Lift.npcTicket(n.ticket)
 local state=if info then info.state else "failed"
 n.liftState=state
 if state=="done" then
  n.ticket=nil;n.liftActivity=false;e.model:SetAttribute("Activity",e.state)
  n.mode="walk";n.stage="walk";n.retries=0;n.goal=nil;enqueue(e,time);return
 end
 if state=="failed" then toStairs(e,time,"Lift failed");return end
 if (state=="waiting" or state=="board") and time-n.liftStart&gt;Config.LIFT_WAIT then toStairs(e,time,"Lift wait timeout");return end
 if time-n.liftStart&gt;LIFT_TIMEOUT then toStairs(e,time,"Lift ride timeout");return end
 if state=="riding" then
  if n.goal then n.goal=nil;stand(e) end
  return
 end
 local target=if info then info.target else nil
 if typeof(target)=="Vector3" and (not n.goal or (n.goal-target).Magnitude&gt;.5 or time&gt;=n.goalAt) then
  n.goal=target;n.goalAt=time+3
  if flat(target,e.root.Position)&gt;.8 then e.humanoid:MoveTo(target) end
 end
end
function Nav.tick(e: any,time: number)
 local n=e.nav;if not n then return end
 if n.phase=="lift" then liftTick(e,n,time);return end
 if (n.phase~="moving" and n.phase~="door") or not n.points then return end
 if doorTick(e,n,time) then return end
 if e.nav~=n or n.phase~="moving" or not n.points then return end
 if n.deadline and time&gt;n.deadline then fail(e,time,"Stuck; recomputing");return end
 local point=n.points[n.index]
 if point and flat(point.Position,e.root.Position)&lt;REACH and math.abs(point.Position.Y-e.root.Position.Y)&lt;6 then n.index+=1;nextWaypoint(e,time) end
end
-- Diagnostics / LOD helpers.
function Nav.liftBusy(e: any): boolean
 local n=e.nav
 return (n~=nil and n.ticket~=nil) or Lift.riding(e.model)
end
function Nav.ticketState(e: any): string?
 local n=e.nav;return if n and n.ticket then n.liftState else nil
end
function Nav.stage(e: any): string?
 local n=e.nav;return if n then string.format("%s/%s/%s",n.mode,n.stage,n.phase) else nil
end
return Nav
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000014"><Properties><string name="Name">EmployeeRigDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Original R6-compatible rigs. No downloaded avatars, clothes or animation asset IDs.
-- Identity: an appearance seed (EmployeeConfig.seed(index, owner), or a persistent staff profile's
-- seed) drives build, face, hair, outfit and role details, so the same person always returns with the
-- same look. Presentation (feminine/masculine) always matches the first name: generated names come
-- from CampusMath.staffName(index, owner), which uses the same EmployeeConfig.isFeminine rule; a
-- profile name from the staff lists decides the presentation itself.
-- At most MAX_PARTS parts per rig; accessories are non-colliding, massless, unqueryable and welded.
-- Head: the standard R6 head (2x1x1 part, Head mesh 1.25) slightly flattened in depth so the
-- SurfaceGui face sits in front of the mesh surface; visible head ~1.25 wide.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Collection=game:GetService("CollectionService")
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local Dialogue=require(ReplicatedStorage.Shared.Dialogue)
local Rig={}
Rig.MAX_PARTS=22
export type Profile={n: string?,s: number?,k: number?}
local rgb=Color3.fromRGB
local SKINS={rgb(255,226,201),rgb(241,206,172),rgb(232,190,152),rgb(214,170,133),rgb(198,148,106),rgb(176,124,86),rgb(150,103,72),rgb(122,82,56),rgb(96,64,45),rgb(72,48,36)}
local HAIR={rgb(24,21,20),rgb(44,34,28),rgb(70,52,38),rgb(101,70,45),rgb(128,82,48),rgb(156,96,56),rgb(196,160,104),rgb(224,204,158),rgb(146,58,40),rgb(58,84,122)}
local HAIR_WEIGHTS={7,7,6,5,3,2,3,2,2,1}
local GREY={rgb(124,122,120),rgb(160,158,154),rgb(206,204,198)}
local SHIRTS={rgb(236,236,230),rgb(178,202,224),rgb(232,200,200),rgb(190,220,200),rgb(214,200,172),rgb(198,190,222),rgb(150,154,158),rgb(70,74,80),rgb(44,58,92),rgb(58,88,70),rgb(118,44,56),rgb(204,164,70),rgb(52,118,128),rgb(34,34,36),rgb(226,214,236),rgb(240,226,206)}
local TROUSERS={rgb(40,50,76),rgb(52,56,62),rgb(28,28,30),rgb(170,150,110),rgb(110,114,120),rgb(64,88,128),rgb(96,72,52),rgb(88,92,62)}
local SKIRTS={rgb(40,50,76),rgb(52,56,62),rgb(28,28,30),rgb(176,140,96),rgb(92,98,70),rgb(106,44,52),rgb(64,88,128),rgb(120,124,130),rgb(150,112,130)}
local TIGHTS={rgb(30,30,32),rgb(52,54,60),rgb(40,46,66)}
local SHOES={rgb(226,224,216),rgb(26,26,28),rgb(98,66,44),rgb(150,152,156),rgb(40,50,76),rgb(170,126,84),rgb(120,40,48)}
local BLAZERS={rgb(40,52,84),rgb(58,62,68),rgb(176,140,96),rgb(92,98,70),rgb(106,44,52),rgb(164,166,168),rgb(210,196,184)}
local KNITS={rgb(210,196,170),rgb(64,96,74),rgb(164,90,58),rgb(128,130,134),rgb(52,62,96),rgb(150,112,130)}
local HOODIES={rgb(130,134,140),rgb(36,36,40),rgb(52,82,62),rgb(110,40,50),rgb(74,90,110)}
local VESTS={rgb(120,124,128),rgb(48,58,88),rgb(110,84,60),rgb(40,40,42)}
local FRAMES={rgb(30,30,32),rgb(96,62,40),rgb(190,160,96),rgb(170,172,176)}
local METALS={rgb(212,180,96),rgb(200,202,206),rgb(236,232,222)}
local LANYARD={researcher=rgb(126,96,186),engineer=rgb(40,150,140),curator=rgb(64,120,196),marketer=rgb(226,128,60),support=rgb(88,160,96)}
-- none, blazer, cardigan, hoodie, vest
local OVERLAY_WEIGHTS: {[string]:{number}}={researcher={3,1,3,1,2},engineer={3,1,1,4,1},curator={3,1,3,2,2},marketer={1,5,2,1,2}}
local OVERLAY_WEIGHTS_F: {[string]:{number}}={researcher={3,2,4,1,1},engineer={3,2,2,3,1},curator={3,2,4,2,1},marketer={2,6,3,1,1}}
local OVERLAYS={"none","blazer","cardigan","hoodie","vest"}
local STYLES_F={"long","bob","bun","ponytail","braids","curls"};local STYLE_WEIGHTS_F={4,3,2,3,1,2}
local STYLES_M={"short","buzz","sidepart","curls"};local STYLE_WEIGHTS_M={5,2,4,2}
-- Operations staff wear uniform tones per job (Config.OPERATIONS_JOBS); skirt=true allows a skirt.
local UNIFORMS: {[string]:any}={
 Reception={shirt=rgb(236,236,230),jacket=rgb(38,52,82),trousers=rgb(44,48,56),shoes=rgb(30,28,28),skirt=true},
 Security={shirt=rgb(232,232,228),jacket=rgb(30,34,40),trousers=rgb(28,31,36),shoes=rgb(20,20,22),tie=rgb(26,26,30)},
 Facilities={shirt=rgb(74,96,118),trousers=rgb(56,62,70),shoes=rgb(60,48,38)},
 ["IT Support"]={shirt=rgb(52,118,128),trousers=rgb(160,142,108),shoes=rgb(220,220,214)},
 Barista={shirt=rgb(40,40,42),trousers=rgb(36,38,42),shoes=rgb(30,28,28),apron=rgb(122,86,58)},
 Chef={shirt=rgb(242,242,238),trousers=rgb(70,72,76),shoes=rgb(30,28,28),hat=rgb(246,246,242)},
 ["Kitchen Team"]={shirt=rgb(238,238,232),trousers=rgb(40,42,46),shoes=rgb(30,28,28),apron=rgb(34,36,40)},
 ["Cafe Host"]={shirt=rgb(128,44,54),trousers=rgb(40,40,44),shoes=rgb(60,40,30),vest=rgb(48,40,40),skirt=true},
 Fleet={shirt=rgb(46,56,74),trousers=rgb(40,46,56),shoes=rgb(40,34,30),hivis=rgb(204,222,70)},
 ["Hotel Reception"]={shirt=rgb(236,236,230),jacket=rgb(82,46,58),trousers=rgb(44,48,56),shoes=rgb(30,28,28),skirt=true},
 Housekeeping={shirt=rgb(196,214,220),trousers=rgb(70,74,82),shoes=rgb(60,48,38),apron=rgb(236,236,230)},
 Cleaner={shirt=rgb(52,92,150),trousers=rgb(52,56,62),shoes=rgb(40,34,30),hivis=rgb(204,222,70)},
 Mailroom={shirt=rgb(150,112,70),trousers=rgb(56,62,70),shoes=rgb(60,48,38)},
 -- shuttle pilots (ShuttleService, role "pilot"): white shirt, navy jacket and tie, uniform cap with a gold band
 Pilot={shirt=rgb(244,244,240),jacket=rgb(26,34,58),trousers=rgb(26,34,58),shoes=rgb(18,18,20),tie=rgb(20,26,44),cap=rgb(26,34,58)},
}
-- Counter-based stream over EmployeeConfig.hash: identical on every server, no correlated draws.
local function stream(seed: number): (number)-&gt;number
 local state=Config.hash(seed)
 return function(n: number): number
  state=(state+0x9e3779b9)%4294967296
  return Config.hash(state)%n+1
 end
end
local function weighted(pick: (number)-&gt;number,weights: {number}): number
 local total=0;for _,w in weights do total+=w end
 local roll=pick(total)
 for i,w in weights do roll-=w;if roll&lt;=0 then return i end end
 return #weights
end
-- profile (optional, persistent identity): n = name, s = appearance seed, k = skill 1..5.
function Rig.build(parent: Instance,owner: number,index: number,role: string,pose: CFrame,profile: Profile?): Model
 local job=if role=="support" then Config.OPERATIONS_JOBS[index-300] elseif role=="pilot" then "Pilot" else Config.ROLES[role]
 local seed=if profile and profile.s then math.floor(math.abs(profile.s))%2147483647 else Config.seed(index,owner)
 local name=if profile and profile.n then profile.n else CampusMath.staffName(index,owner)
 local feminine: boolean
 if profile then
  local byName=CampusMath.nameFeminine(name)
  feminine=if byName~=nil then byName elseif profile.s then Config.feminine(seed) else Config.isFeminine(index,owner)
 else feminine=Config.isFeminine(index,owner) end
 local pick=stream(seed)
 local function fraction(): number return (pick(1001)-1)/1000 end
 -- Build within 0.92..1.06: feminine builds a little shorter and narrower on average.
 local sy=if feminine then .92+fraction()*.1 else .95+fraction()*.11
 local sx=math.clamp(sy+(if feminine then -.02 else 0)+(fraction()-.5)*.07,.92,1.06)
 local skin=SKINS[pick(#SKINS)]
 local older=pick(100)&lt;=16
 local hair=if older then GREY[pick(#GREY)] else HAIR[weighted(pick,HAIR_WEIGHTS)]
 local style=if feminine then STYLES_F[weighted(pick,STYLE_WEIGHTS_F)] else STYLES_M[weighted(pick,STYLE_WEIGHTS_M)]
 local shirt=SHIRTS[pick(#SHIRTS)];local trousers=TROUSERS[pick(#TROUSERS)];local shoes=SHOES[pick(#SHOES)]
 local overlay=OVERLAYS[weighted(pick,(if feminine then OVERLAY_WEIGHTS_F[role] else OVERLAY_WEIGHTS[role]) or {1,0,0,0,0})]
 local jacket=if overlay=="blazer" then BLAZERS[pick(#BLAZERS)] elseif overlay=="cardigan" then KNITS[pick(#KNITS)] elseif overlay=="hoodie" then HOODIES[pick(#HOODIES)] else VESTS[pick(#VESTS)]
 local glasses=pick(100)&lt;=(if role=="researcher" then 40 elseif role=="support" then 15 else 26)+(if older then 25 else 0)
 local frame=FRAMES[pick(#FRAMES)];local tinted=pick(12)==1
 local facial=pick(100);local labCoat=role=="researcher" and pick(100)&lt;=30;local headphones=role=="engineer" and pick(100)&lt;=35
 local skirtRoll=pick(100);local skirtColor=SKIRTS[pick(#SKIRTS)];local bareLegs=pick(100)&lt;=40;local tights=TIGHTS[pick(#TIGHTS)];local dressRoll=pick(100)
 local earrings=feminine and pick(100)&lt;=45;local metal=METALS[pick(#METALS)]
 local brow=pick(3);local mouthStyle=pick(2)
 local uniform=if job then UNIFORMS[job] else nil
 if uniform then
  shirt=uniform.shirt;trousers=uniform.trousers;shoes=uniform.shoes
  overlay=if uniform.jacket then "blazer" elseif uniform.vest then "vest" else "none";jacket=uniform.jacket or uniform.vest or shirt
  if uniform.hat then style="chef" end
 end
 if labCoat then overlay="labcoat";jacket=rgb(240,240,236) end
 -- Skirt or dress (feminine, about 40%; uniforms only where allowed). Kept short so it reads as a
 -- skirt standing and sits on the lap when the seated legs swing forward.
 local skirt=feminine and skirtRoll&lt;=40 and (uniform==nil or uniform.skirt==true)
 local dress=skirt and overlay=="none" and uniform==nil and dressRoll&lt;=50
 if skirt then
  if uniform then skirtColor=uniform.trousers end
  if dress then shirt=skirtColor end
  trousers=if bareLegs then skin else tights
 end
 if overlay~="none" and overlay~="vest" and jacket==shirt then shirt=SHIRTS[(table.find(SHIRTS,shirt) or 1)%#SHIRTS+1] end
 local sleeve=if overlay=="blazer" or overlay=="cardigan" or overlay=="hoodie" or overlay=="labcoat" then jacket elseif dress and dressRoll&lt;=20 then skin else shirt
 local model=Instance.new("Model");model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic;model.Name="Employee_"..index;model:SetAttribute("OwnerUserId",owner);model:SetAttribute("StaffIndex",index);model:SetAttribute("EmployeeName",name);model:SetAttribute("RoleId",role);model:SetAttribute("Role",job or "Campus Operations");model:SetAttribute("AccessClass","employee");model:SetAttribute("Activity","ARRIVING");model:SetAttribute("PersonalitySeed",seed);model:SetAttribute("StaffAnimated",true)
 model:SetAttribute("Presentation",if feminine then "feminine" else "masculine")
 if profile and profile.k then model:SetAttribute("Skill",profile.k) end
 local count=0
 local function at(x: number,y: number,z: number): CFrame return CFrame.new(x*sx,y*sy,z*sx) end
 local function part(partName: string,size: Vector3,where: CFrame,color: Color3,collide: boolean?,ball: boolean?): Part
  count+=1
  local p=Instance.new("Part");p.Name=partName
  if ball then local d=size.X*math.min(sx,sy);p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(d,d,d) else p.Size=Vector3.new(size.X*sx,size.Y*sy,size.Z*sx) end
  p.CFrame=pose*where;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.CanCollide=collide==true;p.CanTouch=false;p.Massless=partName~="HumanoidRootPart";p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=model;return p
 end
 local function fits(n: number): boolean return count+n&lt;=Rig.MAX_PARTS end
 local root=part("HumanoidRootPart",Vector3.new(2,2,1),CFrame.new(),shirt,true);root.Transparency=1;root.Anchored=true;model.PrimaryPart=root
 local torso=part("Torso",Vector3.new(2,2,1),CFrame.new(),shirt,true)
 local head=part("Head",Vector3.new(2,1,1),at(0,1.5,0),skin)
 local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.new(1.25,1.25,.96);mesh.Parent=head
 local leftArm=part("Left Arm",Vector3.new(1,2,1),at(-1.5,0,0),sleeve)
 local rightArm=part("Right Arm",Vector3.new(1,2,1),at(1.5,0,0),sleeve)
 local leftLeg=part("Left Leg",Vector3.new(1,2,1),at(-.5,-2,0),trousers)
 local rightLeg=part("Right Leg",Vector3.new(1,2,1),at(.5,-2,0),trousers)
 local function joint(jointName: string,p0: BasePart,p1: BasePart,c0: CFrame,c1: CFrame)
  local m=Instance.new("Motor6D");m.Name=jointName;m.Part0=p0;m.Part1=p1;m.C0=c0;m.C1=c1;m.Parent=p0
 end
 joint("RootJoint",root,torso,CFrame.new(),CFrame.new())
 joint("Neck",torso,head,at(0,1,0),at(0,-.5,0))
 joint("Left Shoulder",torso,leftArm,at(-1,.5,0),at(.5,.5,0))
 joint("Right Shoulder",torso,rightArm,at(1,.5,0),at(-.5,.5,0))
 joint("Left Hip",torso,leftLeg,at(-.5,-1,0),at(0,1,0))
 joint("Right Hip",torso,rightLeg,at(.5,-1,0),at(0,1,0))
 local function accessory(partName: string,size: Vector3,where: CFrame,color: Color3,target: BasePart,material: Enum.Material?,ball: boolean?): Part?
  if not fits(1) then return nil end
  local p=part(partName,size,where,color,false,ball);p.CanQuery=false;if material then p.Material=material end
  local weld=Instance.new("WeldConstraint");weld.Part0=target;weld.Part1=p;weld.Parent=p;return p
 end
 local H=1.5 -- head centre above the root
 for _,side in {-1,1} do
  accessory("Hand",Vector3.new(1.04,.52,1.04),at(side*1.5,-.76,0),skin,if side&lt;0 then leftArm else rightArm)
  accessory("Shoe",Vector3.new(1.04,.36,1.12),at(side*.5,-2.82,-.05),shoes,if side&lt;0 then leftLeg else rightLeg)
 end
 -- Lanyard in the role colour; a tie wearer clips the badge to the chest pocket instead.
 if uniform and uniform.tie then accessory("IDBadge",Vector3.new(.42,.5,.05),at(.55,.42,-.6),rgb(227,230,215),torso)
 else
  accessory("Lanyard",Vector3.new(.09,1.2,.04),at(0,.25,-.58),LANYARD[role] or LANYARD.support,torso)
