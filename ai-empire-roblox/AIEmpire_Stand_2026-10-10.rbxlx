local C,F=Theme.colors,Theme.font
local Controller={}
local player=Players.LocalPlayer
local panel: ScreenGui?=nil
local openComputer: (string,string?)-&gt;()=function(_app: string,_section: string?) end
local MESSAGES: {[string]:string}={
 APPLICANT_GONE="This application is no longer open.",
 ALREADY_INVITED="This candidate is already on the way to the visitor lounge.",
 NO_OFFICE="Your headquarters is still being prepared. Try again in a moment.",
 NOT_HERE="Talk to the candidate in the visitor lounge first.",
 ASKED="You already asked that.",
 QUESTION_LIMIT="That's enough questions. Time to decide.",
 OFFER_DECLINED="They already turned down the lower offer.",
 NO_ASK="There is no question to answer right now.",
 NO_ASSISTANT="Your assistant isn't at her desk yet.",
 ASSISTANT_BUSY="She is already on a coffee run.",
 COFFEE_COOLDOWN="A fresh coffee in a little while. She just brought one.",
 STAFF_FULL="All desks are filled. Upgrade your office or dismiss an employee first.",
}
function Controller.message(err: string?): string
 return if err and MESSAGES[err] then MESSAGES[err] else Action.message(err)
end
-- Remote call with readable error toasts for the people codes.
function Controller.call(name: string,payload: {[string]:any}): (boolean,any)
 local ok,res=Action.call(name,payload,true)
 if not ok and res.err~="BUSY" then Toast.show("error",Controller.message(res.err)) end
 return ok,res
end
local function recruit(payload: {[string]:any}): (boolean,any) return Controller.call("RecruitAction",payload) end

-- Assistant briefing panel ------------------------------------------------------------------------
local function closePanel()
 if panel then panel:Destroy();panel=nil end
end
local W,H=660,600
local function showBriefing(data: any)
 closePanel()
 local screen=Instance.new("ScreenGui");screen.Name="PeopleAssistant";screen.ResetOnSpawn=false;screen.DisplayOrder=41;screen.Parent=player:WaitForChild("PlayerGui");panel=screen
 local box=Kit.frame(screen,UDim2.fromOffset(W,H),UDim2.fromScale(.5,.5));box.AnchorPoint=Vector2.new(.5,.5)
 box.BackgroundColor3=C.panel;box.BackgroundTransparency=0;Kit.corner(box,14);Kit.stroke(box,.85)
 local scale=Instance.new("UIScale");scale.Parent=box
 local function fit()
  local camera=workspace.CurrentCamera;local vp=if camera then camera.ViewportSize else Vector2.new(1280,720)
  scale.Scale=math.clamp(math.min((vp.Y-24)/H,(vp.X-24)/W),.3,1)
 end
 fit()
 local camera=workspace.CurrentCamera
 if camera then
  local resize=camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() if scale.Parent then fit() end end)
  screen.Destroying:Connect(function() resize:Disconnect() end)
 end
 local inner=Kit.frame(box,UDim2.new(1,-32,1,-32),UDim2.fromOffset(16,16))
 local initials="";for word in string.gmatch(tostring(data.name),"%S+") do initials..=string.sub(word,1,1) end
 Conversation.avatar(inner,string.upper(string.sub(initials,1,2)),tonumber(data.seed) or 0,56).Position=UDim2.fromOffset(0,0)
 local title=Kit.text(inner,tostring(data.name),21,F.bold,C.text);title.Position=UDim2.fromOffset(70,2)
 Kit.text(inner,tostring(data.role)..(if typeof(data.company)=="string" then "  ·  "..data.company else ""),14,F.medium,C.muted).Position=UDim2.fromOffset(70,30)
 local closeTop=Kit.button(inner,"Close","ghost",UDim2.fromOffset(92,32));closeTop.AnchorPoint=Vector2.new(1,0);closeTop.Position=UDim2.new(1,0,0,0)
 Kit.onClick(closeTop,closePanel)
 local scroll=Kit.scroll(inner,UDim2.new(1,0,1,-126),UDim2.fromOffset(0,68))
 local stack=Kit.stack(scroll,10);Kit.padding(stack,0,8,8,0)
 -- recommendations first: what to do next
 local recs=Kit.card(stack,1,8)
 local stroke=recs:FindFirstChildOfClass("UIStroke");if stroke then stroke.Transparency=.35;Theme.bindAccent(stroke,"Color") end
 local head=Kit.text(recs,"My recommendations",16,F.bold,C.text);head.LayoutOrder=0
 for i,rec in data.recommendations or {} do
  local rowFrame=Kit.frame(recs,UDim2.fromScale(1,0));rowFrame.AutomaticSize=Enum.AutomaticSize.Y;rowFrame.LayoutOrder=i
  local hasApp=typeof(rec.app)=="string"
  local label=Kit.para(rowFrame,tostring(i)..".  "..tostring(rec.text),15,C.text)
  label.Size=UDim2.new(1,if hasApp then -96 else 0,0,0)
  if hasApp then
   local go=Kit.button(rowFrame,"Open","secondary",UDim2.fromOffset(86,30));go.AnchorPoint=Vector2.new(1,0);go.Position=UDim2.fromScale(1,0);go.TextSize=14
   Kit.onClick(go,function() closePanel();openComputer(rec.app,if typeof(rec.section)=="string" then rec.section else nil) end)
  end
 end
 for i,section in data.sections or {} do
  local card=Kit.card(stack,i+1,4)
  local t=Kit.text(card,tostring(section.title),15,F.bold,C.text);t.LayoutOrder=0
  for j,row in section.rows or {} do
   local line=Kit.frame(card,UDim2.fromScale(1,0));line.AutomaticSize=Enum.AutomaticSize.Y;line.LayoutOrder=j
   local key=Kit.text(line,tostring(row[1]),14,F.medium,C.muted);key.AutomaticSize=Enum.AutomaticSize.None;key.Size=UDim2.fromOffset(170,20)
   local value=Kit.para(line,tostring(row[2]),14,C.text);value.Position=UDim2.fromOffset(178,1);value.Size=UDim2.new(1,-178,0,0)
  end
 end
 local footer=Kit.frame(inner,UDim2.new(1,0,0,46),UDim2.new(0,0,1,-46));Kit.list(footer,10,true)
 local coffee=data.coffee or {}
 local cooldown=tonumber(coffee.cooldown) or 0
 local canOrder=false
 local coffeeText
 if coffee.carrying then coffeeText="She has your coffee"
 elseif coffee.state~="post" and coffee.state~="toPost" and coffee.state~="retryHome" then coffeeText=if coffee.state=="absent" then "Not at her desk" else "On a coffee run"
 elseif cooldown&gt;0 then coffeeText="Coffee in "..Format.duration(cooldown)
 else coffeeText="Bring me a coffee · "..Format.money(tonumber(coffee.price) or 0);canOrder=true end
 local cup=Kit.button(footer,coffeeText,"primary",UDim2.new(.36,-8,1,0));cup.LayoutOrder=1;cup.TextSize=15
 Kit.setDisabled(cup,not canOrder)
 local refresh=Kit.button(footer,"Refresh analysis","secondary",UDim2.new(.25,-8,1,0));refresh.LayoutOrder=2;refresh.TextSize=15
 local apps=Kit.button(footer,"Open applications","secondary",UDim2.new(.25,-8,1,0));apps.LayoutOrder=3;apps.TextSize=15
 local close=Kit.button(footer,"Close","ghost",UDim2.new(.14,0,1,0));close.LayoutOrder=4;close.TextSize=15
 Kit.onClick(cup,function()
  task.spawn(function()
   local ok,res=Controller.call("AssistantAction",{action="coffee"})
   if ok then Toast.show("success",tostring(data.name).." is getting your coffee from the tea kitchen.",4) end
   if typeof(res)=="table" and typeof(res.assistant)=="table" and panel==screen then showBriefing(res.assistant) end
  end)
 end)
 Kit.onClick(refresh,function()
  task.spawn(function()
   local ok,res=Controller.call("AssistantAction",{action="brief"})
   if ok and typeof(res.assistant)=="table" and panel==screen then showBriefing(res.assistant) end
  end)
 end)
 Kit.onClick(apps,function() closePanel();openComputer("empire","team") end)
 Kit.onClick(close,closePanel)
 if UserInputService.GamepadEnabled then GuiService.SelectedObject=cup end
 -- walking away closes the panel
 local character=player.Character;local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
 local start=if root and root:IsA("BasePart") then root.Position else nil
 task.spawn(function()
  while panel==screen do
   task.wait(.5)
   local c=player.Character;local r=if c then c:FindFirstChild("HumanoidRootPart") else nil
   if start and r and r:IsA("BasePart") and (r.Position-start).Magnitude&gt;30 then closePanel();break end
  end
 end)
end

function Controller.init(open: (string,string?)-&gt;())
 openComputer=open
 State.onNotify(function(kind,payload)
  if kind=="INTERVIEW_OPEN" and typeof(payload.id)=="string" then
   closePanel();Conversation.open(payload,recruit)
  elseif kind=="ASSISTANT_OPEN" and typeof(payload.name)=="string" then
   if not Conversation.isOpen() then showBriefing(payload) end
  elseif (kind=="PEOPLE_NOTICE" or kind=="ASSISTANT_NOTICE") and typeof(payload.text)=="string" then
   Toast.show("info",payload.text,if kind=="ASSISTANT_NOTICE" then 7 else 5)
  end
 end)
 player.CharacterAdded:Connect(function() closePanel();Conversation.close() end)
end
return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000045"><Properties><string name="Name">PhoneController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Company phone, client side (package "phone"). Builds the phone's view model from REAL state and feeds
-- UI/Screens/Phone:
--   * messages: the company log (empire.deals.news) plus events derived from snapshot changes (PhoneMath):
--     who is sick / on vacation today, rack faults and fixes (live.compute.faults), new hires / leavers, goals
--     reached (EmpireMath.nextGoal); messages other packages send through PhoneService.message. Read state lives
--     in this session (everything that happened before you joined counts as read; nothing runs offline).
--   * calls: the call log of PhoneService (Notify PHONE_CALL + PhoneAction inbox), answers through the remote
--   * calendar: PhoneMath.calendar from tripList / accounts / the shuttle timetable + items of other packages
--   * AI chat: PhoneAction chat (server-side TextGenerator or labelled demo replies), history in memory only
-- The remote is used only for actions (chat, answers, contacts, settings, inbox/calendar refresh); badges update
-- from snapshot changes. Keyboard P / gamepad Y open the phone, gamepad B goes back. The phone hides while the
-- Computer or the intro is open and closes when a talk / interview / assistant / lift panel opens.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Ops = require(Shared.CompanyOps)
local PhoneMath = require(Shared.PhoneMath)
local EmpireMath = require(Shared.EmpireMath)
local Types = require(Shared.Types)
local State = require(script.Parent.StateController)
local Action = require(script.Parent.ActionController)
local UI = script.Parent.Parent.UI
local Toast = require(UI.Toast)
local Phone = require(UI.Screens.Phone)
local Computer = require(UI.Screens.Computer)
local Screens = require(UI.Phone.PhoneScreens)

type Message = PhoneMath.Message
type Snapshot = Types.Snapshot
type View = Screens.View

local Controller = {}

Controller.PANELS = { TalkPanel = true, PeopleInterview = true, PeopleAssistant = true, CampusLift = true, CampusSecurity = true }
Controller.CHAT_TURNS = 40 -- turns kept per model on the client (memory only)

local MESSAGES: { [string]: string } = {
	CHAT_COOLDOWN = "Wait a moment before your next message.",
	FILTER_DOWN = "The chat filter is unavailable right now. Try again in a moment.",
	TOO_LONG = "That message is too long (200 characters at most).",
	NO_MODEL = "Only released models can chat.",
	NO_CALL = "This call has ended.",
}
function Controller.message(err: string?): string
	return if err and MESSAGES[err] then MESSAGES[err] else Action.message(err)
end

-- state of this session
local read: { [string]: boolean } = {}
local events: { [string]: Message } = {}
local newsList: { Message } = {}
local newsSig = ""
local serverMessages: { Message } = {}
local messages: { Message } = {}
local calls: { any } = {}
local results: { [string]: any } = {}
local dial: { [string]: any } = {}
local extraCalendar: { any } = {}
local settings = { autoTrips = false, popups = true, saved = false }
local hooks = { itinerary = false, driver = false }
local chats: { [string]: any } = {}
local prev: { [string]: any } = { ready = false }
local fetched = false
local lastSnapshot: Snapshot? = nil
local shuttleCache: { at: number, value: any } = { at = -math.huge, value = nil }
local currentView: View? = nil

-- direct remote call (own pcall: a waiting chat reply must not block answers through ActionController's lock)
local function invoke(payload: { [string]: any }): (boolean, { [string]: any })
	local ok, result = pcall(function(): any
		return Net.getFunction("PhoneAction"):InvokeServer(payload)
	end)
	if not ok or typeof(result) ~= "table" then return false, { ok = false, err = "NETWORK" } end
	return result.ok == true, result
end
Controller._invoke = invoke

local function serverMessage(m: any): Message
	local day, hour = tonumber(m.day) or 0, tonumber(m.hour) or 8
	return { key = "srv:" .. tostring(m.id), from = tostring(m.from), title = tostring(m.title), body = tostring(m.body), tone = tostring(m.tone or "info"),
		day = day, hour = hour, order = PhoneMath.order(day, hour), source = "server" }
end

local function hotels(): { [string]: string }?
	local ok, City = pcall(function(): any return require(Shared.Config.CityPlan) end)
	if ok and typeof(City) == "table" and City.CITY_HOTEL and City.INTL_HOTEL then
		return { city = tostring(City.CITY_HOTEL.name), abroad = tostring(City.INTL_HOTEL.name) }
	end
	return nil
end

-- the next shuttle to Port Meridian (public FlightPlan timetable), refreshed every 10 s
local function shuttle(clock: number): any
	if clock - shuttleCache.at &lt; 10 then return shuttleCache.value end
	shuttleCache.at = clock
	local ok, value = pcall(function(): any
		local FP = require(Shared.FlightPlan)
		local _, _, departure = FP.nextLeg("out", clock)
		return { at = departure, flight = FP.CONFIG.flights.out, airline = FP.CONFIG.airline }
	end)
	shuttleCache.value = if ok then value else nil
	return shuttleCache.value
end

------------------------------------------------------------------------------------------------ view
local function missedCount(): number
	local n = 0
	for _, c in calls do if (c.state == "missed" and c.seen ~= true) or c.state == "ringing" then n += 1 end end
	return n
end

-- full = the phone is (being) opened: calendar and chat models are rebuilt; closed, the badges are enough
local todayCache = { sig = "", line = nil :: string? }
local function buildView(snapshot: Snapshot, full: boolean): View
	local data = snapshot.data
	local e = data.empire
	local live = snapshot.live
	local clock = workspace:GetServerTimeNow()
	local day, hour = PhoneMath.now(e, clock)
	local goal = EmpireMath.nextGoal(data, live)
	local goalView = nil
	if goal then
		local progress, fraction = PhoneMath.goalProgress(goal)
		goalView = { text = tostring(goal.text), progress = progress, fraction = fraction }
	end
	local phones = Ops.heads(e) + Ops.opsPosts(e)
	local old = currentView
	local calendar = if full or not old then PhoneMath.calendar(data, live, clock, extraCalendar, shuttle(clock), hotels()) else old.calendar
	local models = if full or not old then PhoneMath.chatModels(data) else old.models
	-- "Today: 2 sick · ..." needs CompanyOps.presence of every role: only when the day, the team or the trips change
	local travelling = if typeof(live.ops) == "table" then tonumber(live.ops.travelling) or 0 else 0
	local tsig = tostring(prev.absence) .. ":" .. travelling
	if tsig ~= todayCache.sig then
		todayCache.sig = tsig
		todayCache.line = PhoneMath.todayLine(e, live)
	end
	return {
		company = if data.company then data.company.name else "",
		status = PhoneMath.clock(hour),
		dayText = "Day " .. day,
		today = day,
		dayLine = PhoneMath.dayLine(e, clock),
		todayLine = todayCache.line,
		goal = goalView,
		messages = messages,
		read = read,
		unread = PhoneMath.unread(messages, read),
		calls = calls,
		missed = missedCount(),
		results = results,
		dial = dial,
		calendar = calendar,
		models = models,
		chats = chats,
		settings = { autoTrips = settings.autoTrips, popups = settings.popups, saved = settings.saved },
		phones = phones,
		phoneCost = string.format("%d phone%s × %s per game day = %s/day (team and operations staff).", phones, if phones == 1 then "" else "s", Ops.money(Ops.PHONE), Ops.money(phones * Ops.PHONE)),
		stage = Ops.stageIndex(e),
		hooks = { itinerary = hooks.itinerary, driver = hooks.driver },
	}
end

local function publish(full: boolean?)
	local snapshot = lastSnapshot
	if not snapshot or not snapshot.data.company then return end
	local v = buildView(snapshot, full == true or Phone.isOpen())
	currentView = v
	Phone.setView(v)
end
Controller.publish = publish

function Controller.view(): View?
	return currentView
end

------------------------------------------------------------------------------------------------ snapshot -&gt; messages
local function remerge()
	local derived: { Message } = {}
	for _, m in events do table.insert(derived, m) end
	messages = PhoneMath.merge({ newsList, derived, serverMessages })
end

local function fetchInbox()
	task.spawn(function()
		local ok, res = invoke({ action = "inbox" })
		if not ok then return end
		if typeof(res.calls) == "table" then
			local known: { [string]: any } = {}
			for _, c in calls do known[tostring(c.id)] = c end
			calls = res.calls
			for _, c in calls do
				local local_ = known[tostring(c.id)]
				if local_ and local_.seen == true then c.seen = true end
			end
		end
		if typeof(res.messages) == "table" then
			serverMessages = {}
			for _, m in res.messages do if typeof(m) == "table" then table.insert(serverMessages, serverMessage(m)) end end
		end
		if typeof(res.settings) == "table" then settings.autoTrips = res.settings.autoTrips == true end
		settings.saved = res.saved == true
		if typeof(res.hooks) == "table" then
			hooks.itinerary = res.hooks.itinerary == true
			hooks.driver = res.hooks.driver == true
		end
		remerge()
		publish()
	end)
end

local function fetchCalendar()
	task.spawn(function()
		local ok, res = invoke({ action = "calendar" })
		if ok and typeof(res.items) == "table" then
			extraCalendar = res.items
			publish()
		end
	end)
end

local function copyFaults(list: any): { any }
	local out = {}
	if typeof(list) == "table" then for _, f in list do if typeof(f) == "table" then table.insert(out, { slot = f.slot, gpu = f.gpu, since = f.since }) end end end
	return out
end

local function process(snapshot: Snapshot)
	lastSnapshot = snapshot
	local data = snapshot.data
	if not data.company then return end
	local e = data.empire
	local live = snapshot.live
	local clock = workspace:GetServerTimeNow()
	local day, hour = PhoneMath.now(e, clock)
	-- company log
	local deals = if typeof(e.deals) == "table" then e.deals else {}
	local news = if typeof(deals.news) == "table" then deals.news else {}
	local sig = tostring(news[1]) .. "#" .. #news
	if sig ~= newsSig then
		newsSig = sig
		newsList = PhoneMath.newsMessages(deals)
	end
	-- absences (one message per company day; recomputed when the day or the team changes)
	local heads = Ops.heads(e)
	local absenceSig = tostring(day) .. ":" .. heads .. ":" .. tostring(e.unpaidLeave)
	if prev.absence ~= absenceSig then
		prev.absence = absenceSig
		local m = PhoneMath.absenceMessage(e)
		if m then events[m.key] = m else events["absence:" .. day] = nil end
	end
	-- hires and leavers
	local staffSig = 0
	if typeof(e.staffProfiles) == "table" then for _, list in e.staffProfiles do if typeof(list) == "table" then staffSig += #list end end end
	if prev.staffSig ~= staffSig then
		local index = PhoneMath.staffIndex(e)
		if prev.ready and prev.staff then
			for _, m in PhoneMath.staffEvents(prev.staff, index, PhoneMath.announcedHires(deals), day, hour) do events[m.key] = m end
		end
		prev.staff = index
		prev.staffSig = staffSig
	end
	-- rack faults
	local compute = if typeof(live.compute) == "table" then live.compute else nil
	local faults = copyFaults(compute and compute.faults)
	if prev.ready then
		for _, m in PhoneMath.faultEvents(prev.faults, faults, compute ~= nil and compute.it == true, day, hour) do events[m.key] = m end
	end
	prev.faults = faults
	-- goals
	local goal = EmpireMath.nextGoal(data, live)
	local goalLite = if goal then { id = goal.id, text = goal.text } else nil
	if prev.ready then
		local m = PhoneMath.goalEvent(prev.goal, goal, day, hour)
		if m then events[m.key] = m end
	end
	prev.goal = goalLite
	-- first snapshot of the session: what already happened counts as read (today's absences stay new)
	if not prev.ready then
		prev.ready = true
		for _, m in newsList do read[m.key] = true end
	end
	remerge()
	if not fetched then
		fetched = true
		fetchInbox()
		fetchCalendar()
	end
	publish()
end
Controller._process = process

------------------------------------------------------------------------------------------------ actions (deps)
local function upsertCall(call: any)
	for i, c in calls do
		if c.id == call.id then calls[i] = call; return end
	end
	for _, c in calls do if c.state == "ringing" then c.state = "missed" end end
	table.insert(calls, 1, call)
	while #calls &gt; PhoneMath.CALLS_MAX do table.remove(calls) end
end

local function markRead(keys: { string })
	local changed = false
	for _, k in keys do
		if not read[k] then read[k] = true; changed = true end
	end
	if changed then task.defer(publish) end
end

local function readCalls()
	local changed = false
	for _, c in calls do
		if c.state == "missed" and c.seen ~= true then c.seen = true; changed = true end
	end
	if changed then
		task.defer(publish)
		task.spawn(invoke, { action = "read", what = "calls" })
	end
end

local function openComputer(app: string, section: string?)
	Phone.close()
	Computer.open(app, section)
end

local function answer(id: string, how: string)
	local key = tostring(id)
	if results[key] and results[key].pending then return end
	results[key] = { pending = true }
	publish()
	task.spawn(function()
		local ok, res = invoke({ action = "call", id = id, answer = how })
		if typeof(res.call) == "table" then upsertCall(res.call) end
		if ok then
			local call = res.call or {}
			results[key] = { text = if typeof(res.text) == "string" then res.text elseif how == "accept" then "Call ended." else "Call declined.", soon = res.soon == true }
			if how == "accept" and typeof(call.open) == "string" then
				openComputer(call.open, if typeof(call.section) == "string" then call.section else nil)
			end
		else
			results[key] = { text = Controller.message(res.err) }
		end
		publish()
	end)
end

local function dialContact(contact: string)
	if contact == "assistant" then
		task.spawn(function()
			local ok, res = invoke({ action = "call", contact = "assistant" })
			if ok then Phone.close() else Toast.show("error", Controller.message(res.err)) end
		end)
		return
	end
	dial[contact] = { pending = true }
	publish()
	task.spawn(function()
		local ok, res = invoke({ action = "call", contact = contact })
		dial[contact] = { text = if ok and typeof(res.text) == "string" then res.text else Controller.message(res.err), soon = res.soon == true }
		publish()
	end)
end

local function setSetting(key: string, value: boolean)
	if key == "popups" then
		settings.popups = value
		publish()
		return
	end
	task.spawn(function()
		local ok, res = invoke({ action = "setting", key = key, value = value })
		if ok and typeof(res.settings) == "table" then
			settings.autoTrips = res.settings.autoTrips == true
			settings.saved = res.saved == true
		elseif not ok then
			Toast.show("error", Controller.message(res.err))
		end
		publish()
	end)
end

local function chatOf(modelId: string): any
	local chat = chats[modelId]
	if not chat then
		chat = { turns = {}, waiting = false, last = -math.huge }
		chats[modelId] = chat
	end
	return chat
end

local function push(chat: any, turn: any)
	table.insert(chat.turns, turn)
	while #chat.turns &gt; Controller.CHAT_TURNS do table.remove(chat.turns, 1) end
end

local function sendChat(modelId: string, text: string)
	local chat = chatOf(modelId)
	if chat.waiting then return end
	local clean = string.match(text, "^%s*(.-)%s*$") or ""
	if clean == "" then return end
	local now = os.clock()
	if now - chat.last &lt; PhoneMath.CHAT_GAP then
		push(chat, { who = "system", text = string.format("Wait %d s before your next message.", math.ceil(PhoneMath.CHAT_GAP - (now - chat.last))) })
		publish()
		return
	end
	chat.last = now
	local mine: { [string]: any } = { who = "you", text = clean, pending = true }
	push(chat, mine)
	chat.waiting = true
	publish()
	task.spawn(function()
		local ok, res = invoke({ action = "chat", modelId = modelId, text = clean })
		chat.waiting = false
		mine.pending = nil
		if ok and typeof(res.reply) == "string" then
			if typeof(res.user) == "string" then mine.text = res.user end -- the filtered text
			push(chat, { who = "model", text = res.reply, label = tostring(res.label or PhoneMath.DEMO_LABEL), source = tostring(res.source or "demo") })
		else
			mine.failed = true
			local why = Controller.message(res.err)
			if res.err == "CHAT_COOLDOWN" and typeof(res.wait) == "number" then why = string.format("Wait %d s before your next message.", res.wait) end
			push(chat, { who = "system", text = why })
		end
		publish()
	end)
end

local function resetChat(modelId: string)
	chats[modelId] = nil
	publish()
	task.spawn(invoke, { action = "chat", modelId = modelId, reset = true })
end

local deps: Screens.Deps = {
	markRead = markRead,
	readCalls = readCalls,
	answer = answer,
	dial = dialContact,
	setSetting = setSetting,
	sendChat = sendChat,
	resetChat = resetChat,
	openComputer = openComputer,
	close = function() Phone.close() end,
	refresh = function() publish(true) end,
}
Controller.deps = deps

------------------------------------------------------------------------------------------------ public client API
-- Open the phone (optionally on a screen: "messages" | "calls" | "calendar" | "contacts" | "chat" | "settings").
function Controller.open(screen: string?, arg: any?)
	Phone.open(screen, arg)
end
-- Open the chat with one of the player's released models (other UIs, e.g. a "Chat" button in the Market app).
function Controller.openChat(modelId: string)
	Controller.open("thread", modelId)
end

------------------------------------------------------------------------------------------------ notifications
local function onNotify(kind: string, payload: { [string]: any })
	if kind == "PHONE_CALL" and typeof(payload.id) == "string" then
		upsertCall(payload)
		publish()
		if Phone.isHidden() then
			Toast.show("info", tostring(payload.from) .. " called: " .. tostring(payload.title) .. ". Open your phone to call back.", 6)
		elseif settings.popups or Phone.isOpen() then
			Phone.incoming(payload)
		end
	elseif kind == "PHONE_UPDATE" then
		if payload.what == "calendar" then fetchCalendar() else fetchInbox() end
	end
end

------------------------------------------------------------------------------------------------ visibility + input
local function hudHidden(pg: Instance): boolean?
	local hud = pg:FindFirstChild("AIEmpire_HUD")
	local root = hud and hud:FindFirstChild("Root")
	local frame = root and root:FindFirstChild("HUD")
	if frame and frame:IsA("GuiObject") then return not frame.Visible end
	return nil
end

local function updateHidden(pg: Instance)
	local snapshot = State.snapshot
	local company = snapshot ~= nil and snapshot.data.company ~= nil
	local hud = hudHidden(pg)
	Phone.setHidden(not company or hud == true or Computer.isOpen())
end
Controller._updateHidden = updateHidden

function Controller.init()
	local player = Players.LocalPlayer
	local pg = player:WaitForChild("PlayerGui")
	Phone.mount(pg, deps)
	Phone.setHidden(true)
	State.onChange(function(snapshot: Snapshot)
		process(snapshot)
		updateHidden(pg)
	end)
	State.onNotify(onNotify)
	-- a talk / interview / assistant / lift panel closes the phone (they sit in the middle of the screen)
	pg.ChildAdded:Connect(function(child: Instance)
		if Controller.PANELS[child.Name] then Phone.close() end
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if input.KeyCode == Enum.KeyCode.ButtonB and Phone.isOpen() then
			Phone.back()
		elseif processed then
			return
		elseif input.KeyCode == Enum.KeyCode.P or input.KeyCode == Enum.KeyCode.ButtonY then
			if not Phone.isHidden() then
				Phone.toggle()
			end
		end
	end)
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			updateHidden(pg)
			tick += 1
			if tick % 4 == 0 and Phone.isOpen() then publish() end -- status bar clock once per second
		end
	end)
end

return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000046"><Properties><string name="Name">PropFxController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- PropFxController: client-side animation of every PropFx prop (contract: design/PROPFX_CONTRACT.md).
--   * Registry from CollectionService tag "PropFx" (+ legacy "ClusterFan"); the tag signals also cover
--     streaming, so a prop that streams in registers again and captures its home pose again.
--   * The server only writes FxState / FxUntil (or a linked station's OccupiedBy); everything that moves,
--     glows, steams or burns here is local to this client.
--   * LOD from the camera, rebuilt every 0.5 s: &lt; 60 studs every frame, 60–120 studs at 10 Hz, beyond
--     (or &gt; 24 studs above/below) the prop is put back to its home pose once and sleeps.
--   * CFrames of one frame go out in a single workspace:BulkMoveTo(parts, cframes, FireCFrameChanged).
--   * staffops: rack faults (CompanyOps faults mirrored by StaffEvents onto the GPU blade + rack door:
--     FxState "broken", FaultSlot, FaultUntil): the blade blinks red, the door LEDs blink red with a
--     "R3 · FAULT" banner, and a local beacon with a label "Rack R3 · fault · capacity −1" and the
--     economy's repair estimate sits on the rack. All client-only, active-set LOD like every prop.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Ops = require(ReplicatedStorage.Shared.CompanyOps)

local Controller = {}
local TAG = "PropFx"
local LEGACY_FAN = "ClusterFan"
local NEAR, FAR, VERTICAL = 60, 120, 24
local MID_STEP = 0.1 -- 10 Hz between NEAR and FAR
local STATE_STEP = 0.1 -- state attributes are re-read at most 10x per second per prop
local SCAN_STEP = 0.5
local HINGE_TIME, SLIDE_TIME = 0.45, 0.8
local PAPER_EVERY = 1.6
local BREATH_PERIOD, BREATH_DEPTH = 3.2, 0.35
local BROKEN_TEXT = "FAULT · IT NOTIFIED"
local FAULT_RED = Color3.fromRGB(235, 52, 44)
local FAULT_DIM = Color3.fromRGB(96, 20, 18)
local FAULT_BLINK = 2 -- Hz
local MOTION = { spin = true, belt = true, slider = true, hinge = true, arm = true }
local AXES: { [string]: Vector3 } = { x = Vector3.xAxis, y = Vector3.yAxis, z = Vector3.zAxis }
local DEFAULT_RATE: { [string]: number } = { spin = 6, belt = 3, blink = 2, flow = 0.8, slider = 0, ticker = 60 }

type Moving = { part: BasePart, home: CFrame, rel: CFrame, link: number }
type Look = { part: BasePart, color: Color3, material: Enum.Material, transparency: number, show: number? }
export type Prop = {
	root: Instance,
	kinds: { [string]: boolean },
	office: Instance?,
	pivot: CFrame, -- home pivot (Model root) / home CFrame of the root part (Part root)
	position: Vector3,
	moving: { Moving },
	glow: { Look },
	show: { Look },
	breathe: Look?,
	emitters: { ParticleEmitter },
	fires: { Fire },
	gui: SurfaceGui?,
	ticker: TextLabel?,
	leds: { Frame },
	axis: Vector3,
	rate: number,
	travel: number,
	hinge: Vector3,
	idle: string,
	color: Color3,
	text: string?,
	station: string?,
	stationModel: Instance?,
	gate: string?,
	meeting: string?,
	joints: { CFrame }?,
	outPart: BasePart?,
	-- runtime
	angle: number,
	phase: number,
	alpha: number,
	working: boolean,
	broken: boolean,
	effects: boolean?, -- last applied on/off state of emitters/fires/show parts
	glowOn: boolean?,
	overlay: Frame?,
	sheet: BasePart?,
	sheetStart: number,
	nextSheet: number,
	active: boolean,
	near: boolean,
	nextAt: number,
	stateAt: number,
	lastAt: number,
	ledAt: number,
	moved: boolean,
	fault: any?, -- staffops: client-only rack fault effects while broken (beacon, label, banner, colours)
}

local props: { [Instance]: Prop } = {}
local activeList: { Prop } = {}
local stationMaps: { [Instance]: { map: { [string]: Instance }, builtAt: number } } = setmetatable({}, { __mode = "k" }) :: any
local scanClock = 0
local sheetsFolder: Folder? = nil

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function num(v: any, default: number): number
	return if typeof(v) == "number" and v == v then v else default
end

local function lookOf(p: BasePart, show: number?): Look
	return { part = p, color = p.Color, material = p.Material, transparency = p.Transparency, show = show }
end

-- WorkstationId -&gt; station model for one office (one descendants pass, rebuilt at most every 10 s while
-- a lookup fails: stations may still be streaming in).
local function stationModel(office: Instance, id: string, now: number): Instance?
	local entry = stationMaps[office]
	if entry and entry.map[id] and entry.map[id].Parent then
		return entry.map[id]
	end
	if entry and now - entry.builtAt &lt; 10 then
		return nil
	end
	local map: { [string]: Instance } = {}
	for _, d in office:GetDescendants() do
		if d:IsA("Model") then
			local wid = d:GetAttribute("WorkstationId")
			if typeof(wid) == "string" then
				map[wid] = d
			end
		end
	end
	stationMaps[office] = { map = map, builtAt = now }
	return map[id]
end

local function liftMoving(office: Instance): boolean
	local lift = office:FindFirstChild("Lift")
	local cabin = if lift then lift:FindFirstChild("LiftCabin") else nil
	return cabin ~= nil and cabin:GetAttribute("LiftState") == "MOVING"
end

-- Working rule of the contract: broken &gt; FxUntil / FxState / station occupant / gate &gt; idle.
function Controller.state(p: Prop, now: number): (boolean, boolean)
	local root = p.root
	local state = root:GetAttribute("FxState")
	if state == "broken" then
		return false, true
	end
	local untilTime = root:GetAttribute("FxUntil")
	local working = (typeof(untilTime) == "number" and untilTime &gt; now) or state == "working"
	if not working and p.station then
		if not (p.stationModel and p.stationModel.Parent) and p.office then
			p.stationModel = stationModel(p.office, p.station, now)
		end
		working = p.stationModel ~= nil and p.stationModel:GetAttribute("OccupiedBy") ~= nil
	end
	if not working and p.gate and p.office then
		local office = p.office
		if p.gate == "Training" then
			working = office:GetAttribute("Training") == true
		elseif p.gate == "Hour" then
			local h = office:GetAttribute("CompanyHour")
			working = typeof(h) == "number" and h &gt;= 8 and h &lt; 18
		elseif p.gate == "Lift" then
			working = liftMoving(office)
		elseif p.gate == "Meeting" then
			local untilMeeting = office:GetAttribute("MeetingUntil")
			working = office:GetAttribute("MeetingRoom") == p.meeting and typeof(untilMeeting) == "number" and untilMeeting &gt; now
		end
	end
	if working and p.breathe then
		working = p.breathe.part:GetAttribute("Lit") == true
	end
	return working, false
end

-- Home CFrame of a part: the pose captured now, unless a legacy home attribute (FanHome / BeltHome /
-- SpinBase, world space from build time) sits on the same spot - then the part may have been caught
-- mid-animation by an older server and the legacy home is the true rest pose.
local function homeOf(part: BasePart): CFrame
	for _, name in { "FanHome", "BeltHome", "SpinBase" } do
		local legacy = part:GetAttribute(name)
		if typeof(legacy) == "CFrame" and (legacy.Position - part.Position).Magnitude &lt; 0.6 then
			return legacy
		end
	end
	return part.CFrame
end

local function parseKinds(root: Instance): { [string]: boolean }
	local kinds: { [string]: boolean } = {}
	local fx = root:GetAttribute("Fx")
	if typeof(fx) == "string" then
		for kind in string.gmatch(fx, "[%a]+") do
			kinds[kind] = true
		end
	elseif CollectionService:HasTag(root, LEGACY_FAN) then
		kinds.spin = true
	end
	return kinds
end

function Controller.register(root: Instance): Prop?
	if props[root] then
		return props[root]
	end
	if not (root:IsA("BasePart") or root:IsA("Model")) then
		return nil
	end
	local kinds = parseKinds(root)
	if next(kinds) == nil then
		return nil
	end
	local legacyFan = root:GetAttribute("Fx") == nil and CollectionService:HasTag(root, LEGACY_FAN)
	local motion = false
	for kind in kinds do
		if MOTION[kind] then
			motion = true
		end
	end
	local first = next(kinds) :: string
	local axisName = root:GetAttribute("FxAxis")
	local pivot: CFrame
	if root:IsA("BasePart") then
		pivot = homeOf(root)
	else
		pivot = (root :: Model):GetPivot()
	end
	local hinge = root:GetAttribute("FxHinge")
	local color = root:GetAttribute("FxColor")
	local text = root:GetAttribute("FxText")
	local station = root:GetAttribute("FxStation")
	local gate = root:GetAttribute("FxGate")
	local meeting = root:GetAttribute("FxMeeting")
	local idle = root:GetAttribute("FxIdle")
	local p: Prop = {
		root = root,
		kinds = kinds,
		office = root:FindFirstAncestor("Office"),
		pivot = pivot,
		position = pivot.Position,
		moving = {},
		glow = {},
		show = {},
		breathe = nil,
		emitters = {},
		fires = {},
		gui = nil,
		ticker = nil,
		leds = {},
		axis = AXES[if typeof(axisName) == "string" then axisName else (if legacyFan then "z" else "y")] or Vector3.yAxis,
		rate = num(root:GetAttribute("FxRate"), if legacyFan then 8 else (DEFAULT_RATE[first] or 1)),
		travel = num(root:GetAttribute("FxTravel"), 0),
		hinge = if typeof(hinge) == "Vector3" then hinge else Vector3.zero,
		idle = if typeof(idle) == "string" then idle else "off",
		color = if typeof(color) == "Color3" then color else Color3.fromRGB(120, 220, 140),
		text = if typeof(text) == "string" then text else nil,
		station = if typeof(station) == "string" and station ~= "" then station else nil,
		stationModel = nil,
		gate = if typeof(gate) == "string" then gate elseif legacyFan then "Training" else nil,
		meeting = if typeof(meeting) == "string" then meeting else nil,
		joints = nil,
		outPart = nil,
		angle = 0,
		phase = 0,
		alpha = 0,
		working = false,
		broken = false,
		effects = nil,
		glowOn = nil,
		overlay = nil,
		sheet = nil,
		sheetStart = 0,
		nextSheet = 0,
		active = false,
		near = false,
		nextAt = 0,
		stateAt = 0,
		lastAt = 0,
		ledAt = 0,
		moved = false,
		fault = nil,
	}
	-- parts: the root part itself plus descendants
	local parts: { BasePart } = {}
	if root:IsA("BasePart") then
		table.insert(parts, root)
	end
	local flagged = false
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			if d:GetAttribute("FxMove") == true then
				flagged = true
			end
		elseif d:IsA("ParticleEmitter") then
			table.insert(p.emitters, d)
		elseif d:IsA("Fire") then
			table.insert(p.fires, d)
		elseif d:IsA("SurfaceGui") and not p.gui then
			p.gui = d
		elseif d:IsA("Frame") and string.match(d.Name, "^LED%d+$") then
			table.insert(p.leds, d)
		end
	end
	if root:IsA("Model") and kinds.arm then
		local joints: { CFrame } = {}
		for k = 1, 3 do
			local j = root:GetAttribute("FxJoint" .. k)
			joints[k] = if typeof(j) == "CFrame" then j else CFrame.identity
		end
		p.joints = joints
	end
	for _, part in parts do
		local isRoot = (part :: any) == root
		if motion then
			local moves
			if root:IsA("BasePart") then
				moves = true -- a Part root moves rigidly with its children
			elseif kinds.arm then
				moves = typeof(part:GetAttribute("FxLink")) == "number"
			else
				moves = (not flagged) or part:GetAttribute("FxMove") == true
			end
			if moves then
				local home = if isRoot then pivot else part.CFrame
				table.insert(p.moving, { part = part, home = home, rel = pivot:Inverse() * home, link = num(part:GetAttribute("FxLink"), 0) })
			end
		end
		if part:GetAttribute("FxGlow") == true then
			table.insert(p.glow, lookOf(part))
		end
		local show = part:GetAttribute("FxShow")
		if typeof(show) == "number" then
			table.insert(p.show, lookOf(part, show))
		end
		if part:GetAttribute("FxOut") == true then
			p.outPart = part
		end
	end
	if kinds.blink and #p.glow == 0 and root:IsA("BasePart") then
		table.insert(p.glow, lookOf(root))
	end
	if kinds.flow and #p.show == 0 and root:IsA("BasePart") and p.travel == 0 then
		table.insert(p.show, lookOf(root, 0.5))
	end
	if kinds.breathe and root:IsA("BasePart") then
		p.breathe = lookOf(root)
	end
	if kinds.ticker and p.gui then
		local label = p.gui:FindFirstChildWhichIsA("TextLabel")
		p.ticker = label
	end
	if not p.outPart then
		if root:IsA("BasePart") then
			p.outPart = root
		else
			p.outPart = (root :: Model).PrimaryPart or root:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	props[root] = p
	return p
end

local function destroySheet(p: Prop)
	if p.sheet then
		p.sheet:Destroy()
		p.sheet = nil
	end
end

local function setOverlay(p: Prop, text: string?, broken: boolean)
	if p.overlay then
		p.overlay:Destroy()
		p.overlay = nil
	end
	if not text or not p.gui then
		return
	end
	local frame = Instance.new("Frame")
	frame.Name = "FxOverlay"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = if broken then Color3.fromRGB(70, 18, 18) else Color3.fromRGB(16, 40, 24)
	frame.BackgroundTransparency = 0.15
	frame.ZIndex = 10
	local label = Instance.new("TextLabel")
	label.Name = "FxText"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.BuilderSansBold
	label.TextColor3 = if broken then Color3.fromRGB(255, 120, 110) else Color3.fromRGB(150, 240, 170)
	label.ZIndex = 11
	label.Parent = frame
	frame.Parent = p.gui
	p.overlay = frame
end

-- Property effects that follow the on/off state (emitters, fires, show parts, screen overlay).
local function applyEffects(p: Prop, on: boolean)
	if p.effects == on then
		return
	end
	p.effects = on
	for _, e in p.emitters do
		if e.Parent then
			e.Enabled = on
		end
	end
	for _, f in p.fires do
		if f.Parent then
			f.Enabled = on
		end
	end
	if not on then
		for _, look in p.show do
			if look.part.Parent then
				look.part.Transparency = look.transparency
			end
		end
	end
	if p.kinds.screen then
		if p.broken then
			setOverlay(p, BROKEN_TEXT, true)
		elseif on and p.text then
			setOverlay(p, p.text, false)
		else
			setOverlay(p, nil, false)
		end
	end
end

local function setGlow(p: Prop, on: boolean)
	if p.glowOn == on then
		return
	end
	p.glowOn = on
	for _, look in p.glow do
		local part = look.part
		if part.Parent then
			part.Color = if on then p.color else look.color
			part.Material = if on then Enum.Material.Neon else look.material
		end
	end
end

local function localFolder(): Folder
	local folder = sheetsFolder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "PropFxLocal"
		f.Parent = workspace
		sheetsFolder = f
		folder = f
	end
	return folder :: Folder
end

-- Rack fault label text: "Rack R3 · fault · capacity −1" and the economy's repair estimate (FaultUntil).
function Controller.faultText(slot: number?, untilTime: number?, now: number): (string, string)
	local units = Ops.FAULT.units
	local title = string.format("Rack R%s · fault · capacity −%d", if slot then tostring(slot) else "?", units)
	local sub
	if typeof(untilTime) == "number" then
		local left = math.max(0, math.floor(untilTime - now + 0.5))
		if left &gt;= 90 then
			sub = string.format("Repair · back in ~%d min", math.floor(left / 60 + 0.5))
		elseif left &gt; 0 then
			sub = string.format("Repair · back in ~%d s", left)
		else
			sub = "Repair · finishing"
		end
	else
		sub = "IT notified"
	end
	return title, sub
end

-- Beacon + label on top of a broken GPU blade's rack (blade front face = -Z, rack body behind it).
local function faultBeacon(blade: BasePart): (Part, BillboardGui, TextLabel, TextLabel, PointLight)
	local beacon = Instance.new("Part")
	beacon.Name = "RackFaultBeacon"
	beacon.Shape = Enum.PartType.Ball
	beacon.Size = Vector3.new(0.5, 0.5, 0.5)
	beacon.Anchored = true
	beacon.CanCollide = false
	beacon.CanTouch = false
	beacon.CanQuery = false
	beacon.CastShadow = false
	beacon.Material = Enum.Material.Neon
	beacon.Color = FAULT_RED
	beacon.CFrame = blade.CFrame * CFrame.new(0, blade.Size.Y / 2 + 1.75, 1.94)
	local light = Instance.new("PointLight")
	light.Color = FAULT_RED
	light.Range = 10
	light.Brightness = 2
	light.Shadows = false
	light.Parent = beacon
	local gui = Instance.new("BillboardGui")
	gui.Name = "RackFaultLabel"
	gui.Size = UDim2.fromOffset(240, 52)
	gui.StudsOffset = Vector3.new(0, 1.4, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	local frame = Instance.new("Frame")
	frame.Name = "Card"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(40, 12, 12)
	frame.BackgroundTransparency = 0.12
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = FAULT_RED
	stroke.Thickness = 2
	stroke.Parent = frame
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0, 10, 0, 5)
	title.Size = UDim2.new(1, -20, 0, 22)
	title.Font = Enum.Font.BuilderSansBold
	title.TextSize = 16
	title.TextColor3 = Color3.fromRGB(255, 214, 208)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Parent = frame
	local sub = Instance.new("TextLabel")
	sub.Name = "Status"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.new(0, 10, 0, 27)
	sub.Size = UDim2.new(1, -20, 0, 20)
	sub.Font = Enum.Font.BuilderSans
	sub.TextSize = 14
	sub.TextColor3 = Color3.fromRGB(255, 160, 150)
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.TextTruncate = Enum.TextTruncate.AtEnd
	sub.Parent = frame
	gui.Parent = beacon
	beacon.Parent = localFolder()
	return beacon, gui, title, sub, light
end
Controller.faultBeacon = faultBeacon

-- "R3 · FAULT" banner across the top of the rack door's surface (above the LED column).
local function faultBanner(gui: SurfaceGui, slot: number?): Frame
	local banner = Instance.new("Frame")
	banner.Name = "FxFault"
	banner.Size = UDim2.new(1, 0, 0, 78)
	banner.BackgroundColor3 = Color3.fromRGB(70, 16, 16)
	banner.BackgroundTransparency = 0.05
	banner.BorderSizePixel = 0
	banner.ZIndex = 10
	local label = Instance.new("TextLabel")
	label.Name = "FxText"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = string.format("R%s · FAULT", if slot then tostring(slot) else "?")
	label.TextScaled = true
	label.TextWrapped = false
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = label
	label.Font = Enum.Font.BuilderSansBold
	label.TextColor3 = Color3.fromRGB(255, 120, 110)
	label.ZIndex = 11
	label.Parent = banner
	banner.Parent = gui
	return banner
end
Controller.faultBanner = faultBanner

-- Turns the fault effects off and restores the blade colour / LED colours.
function Controller.clearFault(p: Prop)
	local f: any = p.fault
	if not f then
		return
	end
	p.fault = nil
	if f.beacon then
		f.beacon:Destroy()
	end
	if f.banner then
		f.banner:Destroy()
	end
	if p.breathe and p.breathe.part.Parent then
		p.breathe.part.Color = p.breathe.color
		p.breathe.part.Material = p.breathe.material
	end
	for led, color in f.leds do
		if led.Parent then
			led.BackgroundColor3 = color
		end
	end
end

-- One fault step of a broken blade / rack door (active props only).
function Controller.fault(p: Prop, now: number)
	local root = p.root
	local f: any = p.fault
	if not f then
		f = { leds = {}, on = nil, textAt = 0 }
		p.fault = f
		local slot = root:GetAttribute("FaultSlot")
		if p.kinds.breathe and root:IsA("BasePart") then
			f.beacon, f.gui, f.title, f.sub, f.light = faultBeacon(root)
		end
		if p.kinds.leds then
			for _, led in p.leds do
				f.leds[led] = led.BackgroundColor3
			end
			if p.gui then
				f.banner = faultBanner(p.gui, if typeof(slot) == "number" then slot else nil)
			end
		end
	end
	local on = math.floor(now * FAULT_BLINK * 2) % 2 == 0
	if f.on ~= on then
		f.on = on
		if p.breathe and p.breathe.part.Parent then
			p.breathe.part.Color = if on then FAULT_RED else FAULT_DIM
			p.breathe.part.Material = if on then Enum.Material.Neon else p.breathe.material
		end
		for led in f.leds do
			if led.Parent then
				led.BackgroundColor3 = if on then FAULT_RED else FAULT_DIM
			end
		end
		if f.light then
			f.light.Enabled = on
		end
		if f.beacon then
			f.beacon.Color = if on then FAULT_RED else FAULT_DIM
		end
	end
	if f.title and now &gt;= f.textAt then
		f.textAt = now + 0.5
		local slot = root:GetAttribute("FaultSlot")
		local untilTime = root:GetAttribute("FaultUntil")
		local title, sub = Controller.faultText(if typeof(slot) == "number" then slot else nil, if typeof(untilTime) == "number" then untilTime else nil, now)
		f.title.Text = title
		f.sub.Text = sub
	end
end

-- Back to the build pose: called when a prop leaves the active set or unregisters.
function Controller.reset(p: Prop, parts: { BasePart }?, cframes: { CFrame }?)
	if p.moved then
		for _, m in p.moving do
			if m.part.Parent then
				if parts and cframes then
					table.insert(parts, m.part)
					table.insert(cframes, m.home)
				else
					m.part.CFrame = m.home
				end
			end
		end
		p.moved = false
	end
	p.angle, p.phase, p.alpha = 0, 0, 0
	Controller.clearFault(p)
	p.broken = false
	p.effects = nil
	applyEffects(p, false)
	p.effects = nil
	setGlow(p, false)
	p.glowOn = nil
	if p.breathe and p.breathe.part.Parent then
		p.breathe.part.Transparency = p.breathe.transparency
	end
	if p.ticker then
		p.ticker.Position = UDim2.new()
	end
	for _, led in p.leds do
		if led.Parent then
			led.BackgroundTransparency = 0
		end
	end
	destroySheet(p)
	p.working = false
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

local function sheetPart(p: Prop, now: number)
	local out = p.outPart
	if not out or not out.Parent then
		return
	end
	local folder = localFolder()
	local sheet = Instance.new("Part")
	sheet.Name = "FxSheet"
	sheet.Anchored = true
	sheet.CanCollide = false
	sheet.CanTouch = false
	sheet.CanQuery = false
	sheet.CastShadow = false
	sheet.Size = Vector3.new(math.min(out.Size.X * 0.6, 1.1), 0.02, math.min(out.Size.Z * 0.6, 1.4))
	sheet.Color = Color3.fromRGB(246, 246, 240)
	sheet.Material = Enum.Material.SmoothPlastic
	sheet.CFrame = out.CFrame * CFrame.new(0, out.Size.Y * 0.25, -out.Size.Z * 0.3)
	sheet.Parent = folder
	p.sheet = sheet
	p.sheetStart = now
end

-- One animation step of an active prop. CFrame writes are appended to (parts, cframes).
function Controller.animate(p: Prop, now: number, dt: number, parts: { BasePart }, cframes: { CFrame })
	if now &gt;= p.stateAt then
		p.stateAt = now + STATE_STEP
		local working, broken = Controller.state(p, now)
		if broken ~= p.broken then
			p.broken = broken
			p.effects = nil -- re-apply the screen overlay
		end
		p.working = working
	end
	local kinds = p.kinds
	if p.broken and (kinds.breathe or kinds.leds) then
		Controller.fault(p, now)
	elseif p.fault then
		Controller.clearFault(p)
	end
	local on = p.working or p.idle == "on"
	local factor = if p.working or p.idle == "on" then 1 elseif p.idle == "slow" then 0.25 else 0
	applyEffects(p, on and (kinds.steam or kinds.flame or kinds.flow or kinds.screen) ~= nil)
	-- target envelope for eased motion (hinge, slider, arm, flow bob)
	local easeTime = if kinds.hinge then HINGE_TIME else SLIDE_TIME
	local target = if on then 1 else 0
	local before = p.alpha
	if p.alpha ~= target then
		local stepA = dt / easeTime
		p.alpha = if target &gt; p.alpha then math.min(target, p.alpha + stepA) else math.max(target, p.alpha - stepA)
	end
	p.phase += p.rate * dt * factor
	-- motion: only written when something changed this step (a stopped fan keeps its angle)
	if #p.moving &gt; 0 then
		local transform: CFrame? = nil
		local eased = p.alpha ~= before
		if kinds.spin then
			if factor &gt; 0 then
				p.angle = (p.angle + p.rate * dt * factor) % (2 * math.pi)
				transform = CFrame.fromAxisAngle(p.axis, p.angle)
			end
		elseif kinds.belt then
			if factor &gt; 0 then
				local travel = if p.travel &gt; 0 then p.travel else 1.6
				transform = CFrame.new(p.axis * ((p.phase % travel) - travel / 2))
			end
		elseif kinds.slider then
			if eased or (p.rate &gt; 0 and p.alpha &gt; 0) then
				local wave = if p.rate &gt; 0 then 0.5 - 0.5 * math.cos(2 * math.pi * p.phase) else 1
				transform = CFrame.new(p.axis * (p.travel * smooth(p.alpha) * wave))
			end
		elseif kinds.hinge then
			if eased then
				local h = CFrame.new(p.hinge)
				transform = h * CFrame.fromAxisAngle(p.axis, p.travel * smooth(p.alpha)) * h:Inverse()
			end
		elseif kinds.flow and p.travel ~= 0 then
			if eased or p.alpha &gt; 0 then
				local wave = 0.5 - 0.5 * math.cos(2 * math.pi * p.phase)
				transform = CFrame.new(p.axis * (p.travel * p.alpha * wave))
			end
		end
		if kinds.arm and p.joints then
			if eased or p.alpha &gt; 0 then
				local j = p.joints
				local a = smooth(p.alpha)
				local t1 = j[1] * CFrame.Angles(0, 0.9 * a * math.sin(1.1 * now), 0) * j[1]:Inverse()
				local t2 = t1 * j[2] * CFrame.Angles(0, 0, 0.35 * a * math.sin(2.2 * now + 0.5)) * j[2]:Inverse()
				local t3 = t2 * j[3] * CFrame.Angles(0, 0, 0.5 * a * math.sin(2.2 * now + 1.6)) * j[3]:Inverse()
				local chain = { t1, t2, t3 }
				for _, m in p.moving do
					if m.part.Parent then
						table.insert(parts, m.part)
						table.insert(cframes, p.pivot * chain[math.clamp(m.link, 1, 3)] * m.rel)
					end
				end
				p.moved = a &gt; 0
			end
		elseif transform then
			for _, m in p.moving do
				if m.part.Parent then
					table.insert(parts, m.part)
					table.insert(cframes, p.pivot * transform * m.rel)
				end
			end
			p.moved = transform ~= CFrame.identity
		end
	end
	-- glow / blink
	if kinds.blink or kinds.flame then
		local lit = on
		if lit and kinds.blink and p.rate &gt; 0 then
			lit = math.floor(now * p.rate * 2) % 2 == 0
		end
		setGlow(p, lit)
	end
	-- water shimmer while visible
	if on and kinds.flow then
		for _, look in p.show do
			if look.part.Parent and look.show then
				look.part.Transparency = math.clamp(look.show + 0.08 * math.sin(now * 2 * math.pi * math.max(p.rate, 0.5)), 0, 0.95)
			end
		end
	end
	-- GPU blades breathe in one slow wave while training
	if kinds.breathe and p.breathe then
		local part = p.breathe.part
		if part.Parent then
			if p.working then
				local index = num(part:GetAttribute("RackIndex"), 1)
				local phase = (now / BREATH_PERIOD + index * 0.04) * 2 * math.pi
				part.Transparency = BREATH_DEPTH * (0.5 - 0.5 * math.cos(phase))
			elseif part.Transparency ~= p.breathe.transparency then
				part.Transparency = p.breathe.transparency
			end
		end
	end
	-- rack status LEDs flicker (always; faster while working)
	if kinds.leds and #p.leds &gt; 0 and now &gt;= p.ledAt and not p.fault then
		p.ledAt = now + (if p.working then 0.15 else 0.6)
		local tick = math.floor(now * 7)
		for i, led in p.leds do
			if led.Parent then
				led.BackgroundTransparency = if (tick * 31 + i * 17) % 5 == 0 then 0.65 else 0
			end
		end
	end
	-- scrolling ticker
	if kinds.ticker and p.ticker and p.gui then
		local label = p.ticker
		local canvas = label.Parent and (label.Parent :: any).AbsoluteSize or Vector2.zero
		local width = math.max(label.TextBounds.X, 300)
		local span = width + math.max(canvas.X, 200)
		label.Position = UDim2.fromOffset(math.max(canvas.X, 200) - (now * p.rate) % span, 0)
	end
	-- paper sheets out of printers / copiers
	if kinds.paper then
		if p.sheet then
			local age = now - p.sheetStart
			if age &gt; PAPER_EVERY or not p.sheet.Parent then
				destroySheet(p)
			else
				local out = p.outPart
				if out and out.Parent then
					table.insert(parts, p.sheet)
					table.insert(cframes, out.CFrame * CFrame.new(0, out.Size.Y * 0.25, -out.Size.Z * 0.3 - math.min(age, 1) * 1.1))
				end
			end
		elseif p.working and now &gt;= p.nextSheet then
			p.nextSheet = now + PAPER_EVERY + 0.2
			sheetPart(p, now)
		end
	end
end

function Controller.unregister(root: Instance)
	local p = props[root]
	if not p then
		return
	end
	props[root] = nil
	if root.Parent then
		Controller.reset(p)
	else
		destroySheet(p)
	end
end

-- LOD pass: which props are active / near the camera. Props leaving the active set are reset once.
function Controller.scan(camera: Vector3, parts: { BasePart }?, cframes: { CFrame }?)
	table.clear(activeList)
	for root, p in props do
		if not root.Parent then
			props[root] = nil
			continue
		end
		local delta = p.position - camera
		local distance = delta.Magnitude
		local active = distance &lt; FAR and math.abs(delta.Y) &lt; VERTICAL
		if not active and p.active then
			Controller.reset(p, parts, cframes)
		end
		p.active = active
		p.near = distance &lt; NEAR
		if active then
			table.insert(activeList, p)
		end
	end
end

-- One frame: animate the active set (near every frame, mid-range at 10 Hz), then batch the CFrames.
function Controller.step(now: number, parts: { BasePart }?, cframes: { CFrame }?): ({ BasePart }, { CFrame })
	local outParts: { BasePart } = parts or {}
	local outFrames: { CFrame } = cframes or {}
	for _, p in activeList do
		if p.near or now &gt;= p.nextAt then
			local dt = if p.lastAt &gt; 0 then math.clamp(now - p.lastAt, 0, 0.5) else 0
			p.lastAt = now
			p.nextAt = now + MID_STEP
			Controller.animate(p, now, dt, outParts, outFrames)
		end
	end
	return outParts, outFrames
end

function Controller.flush(parts: { BasePart }, cframes: { CFrame })
	if #parts &gt; 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Controller.registry(): { [Instance]: Prop }
	return props
end
function Controller.active(): { Prop }
	return activeList
end

function Controller.init()
	for _, tag in { TAG, LEGACY_FAN } do
		for _, inst in CollectionService:GetTagged(tag) do
			Controller.register(inst)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst: Instance)
			Controller.register(inst)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst: Instance)
			-- a prop tagged twice (PropFx + legacy ClusterFan) stays while one tag remains
			if not CollectionService:HasTag(inst, TAG) and not CollectionService:HasTag(inst, LEGACY_FAN) then
				Controller.unregister(inst)
			end
		end)
	end
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	RunService.PreRender:Connect(function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		table.clear(parts)
		table.clear(cframes)
		scanClock += dt
		if scanClock &gt;= SCAN_STEP then
			scanClock = 0
			Controller.scan(camera.CFrame.Position, parts, cframes)
		end
		Controller.step(serverNow(), parts, cframes)
		Controller.flush(parts, cframes)
	end)
end

return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000047"><Properties><string name="Name">ShuttleController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- ShuttleController (package "flight", client only; required and initialised by TravelController).
--   * The Port Meridian shuttle: a local AircraftModel (kind/scale from ReplicatedStorage.Shuttle) posed every
--     frame from workspace:GetServerTimeNow() with FlightPlan (the server only publishes timetable attributes,
--     never positions). One BulkMoveTo per frame (AircraftMover), fans spin with the engines on, gear retracts.
--     Distance LOD: full model within 900 studs of the camera, medium up to 5,000, nothing beyond (riders
--     always see the full model). The airport package's parked aircraft on the shuttle stand is hidden locally
--     (the shuttle parks exactly there, at the same scale, so the jet bridge still meets its door).
--   * The two pilots: clones of the server-built rigs (ReplicatedStorage.Shuttle.Crew) walk from the CrewRoom
--     marker through the gate and the jet bridge (Port Meridian: from the terminal up a client airstair) into
--     the cockpit and sit there (visible through the windshield) until they leave after arrival; poses from
--     EmployeeController.pose (no animation assets).
--   * Tickets and boarding: check-in -&gt; TravelAction {action="ticket"}; a boarding pass panel counts down
--     (all times computed locally from FlightPlan); a beacon marks the gate; the gate board shows the live
--     status of the next departure ("missed it" = the next one). Board prompt -&gt; {action="board"}.
--   * The ride (Player attribute ShuttleLeg set by the server): scriptable camera on the local aircraft -
--     window seat (cabin window frame overlay, wing and engine outside), cockpit (over the pilots' shoulders)
--     or outside chase view; flight info panel; cabin announcements by the captain. The character itself is
--     held by the server (see ShuttleService), so nothing here needs physics or network ownership.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local CityPlan=require(ReplicatedStorage.Shared.Config.CityPlan)
local FP=require(ReplicatedStorage.Shared.FlightPlan)
local Aircraft=require(ReplicatedStorage.Shared.AircraftModel)
local Format=require(ReplicatedStorage.Shared.Format)
local Mover=require(script.Parent.AircraftMover)
local Action=require(script.Parent.ActionController)
local Employee=require(script.Parent.EmployeeController)
local Toast=require(script.Parent.Parent.UI.Toast)
local Theme=require(script.Parent.Parent.UI.Theme)
local Shuttle={}
local player=Players.LocalPlayer
Shuttle.LOD_FULL=900
Shuttle.LOD_FAR=5000
Shuttle.CREW_NEAR=420 -- pilots are only built/updated near the camera (or on board)

local MESSAGES: {[string]: string}={
	NO_TICKET="Check in at a counter first to get your boarding pass.",
	NOT_AT_GATE="Walk to the gate to board.",
	NOT_AT_CHECKIN="Walk up to a check-in counter first.",
	NO_MONEY="You need "..Format.money(CityPlan.TRAVEL.ticket).." for the return ticket to Port Meridian.",
	LEAVE_VEHICLE="Leave your car before boarding.",
	BUSY="You are already on board.",
	ALREADY_ABROAD="You are already abroad. Check in at Port Meridian Airport to fly home.",
	NOT_ABROAD="You are already at home.",
	SHUTTLE_OFF="The shuttle is not flying right now.",
	LOADING="Still loading - try again in a moment.",
	RATE_LIMIT="Slow down a little.",
}
local function message(err: any): string
	if typeof(err)=="string" and MESSAGES[err] then return MESSAGES[err] end
	return Action.message(if typeof(err)=="string" then err else nil)
end
local function clock(seconds: number): string
	seconds=math.max(0,math.floor(seconds))
	return string.format("%d:%02d",seconds//60,seconds%60)
end
Shuttle.clock=clock

------------------------------------------------------------------------------------------------ state
local folder: Folder?=nil
local clientFolder: Folder?=nil
type Plane={model: Model,mover: Mover.Mover,lod: string,last: CFrame?}
local plane: Plane?=nil
local fanAngle=0
local lastState: FP.State?=nil
type Ticket={flight: string,to: string,gate: string,departs: number,boardingStarts: number,boardingEnds: number,destination: string}
local ticket: Ticket?=nil
local riding: string?=nil -- ShuttleLeg key while on board
local rideMode="window"
local hiddenStand: Model?=nil
local hiddenConn: RBXScriptConnection?=nil
local airstairs: Model?=nil
function Shuttle.active(): boolean
	local f=folder or ReplicatedStorage:FindFirstChild("Shuttle")
	return f~=nil and f:IsA("Folder") and f:GetAttribute("Enabled")==true
end
function Shuttle.ticket(): Ticket? return ticket end
function Shuttle.riding(): string? return riding end
function Shuttle.plane(): Model? return if plane then plane.model else nil end
local function kindScale(): (string,number)
	local f=folder
	local kind=if f and typeof(f:GetAttribute("Kind"))=="string" then f:GetAttribute("Kind") :: string else FP.CONFIG.kind
	local scale=if f and typeof(f:GetAttribute("Scale"))=="number" then f:GetAttribute("Scale") :: number else FP.CONFIG.scale
	return kind,scale
end
local ptsKey="";local ptsCache: Aircraft.Points?=nil
local function points(): Aircraft.Points
	local kind,scale=kindScale()
	local key=kind..":"..scale
	local c=ptsCache
	if c and key==ptsKey then return c end
	local p=Aircraft.points(kind,scale)
	ptsCache=p;ptsKey=key
	return p
end
local function ensureClientFolder(): Folder
	local cf=clientFolder
	if cf and cf.Parent then return cf end
	local f=Instance.new("Folder");f.Name="ShuttleClient";f.Parent=workspace
	clientFolder=f
	return f
end

------------------------------------------------------------------------------------------------ aircraft
local function destroyPlane()
	if plane then plane.model:Destroy();plane=nil end
end
local function buildPlane(lod: string,cf: CFrame)
	destroyPlane()
	local kind,scale=kindScale()
	-- the full model collides locally (players cannot walk through the parked shuttle); far LODs never do
	local m=Aircraft.build(nil,cf,{kind=kind,scale=scale,lod=lod,livery=Color3.fromRGB(24,120,128),airline=FP.CONFIG.airline,name="ShuttleAircraft",collide=lod=="full"})
	m:SetAttribute("ShuttleClient",true)
	m.Parent=ensureClientFolder()
	plane={model=m,mover=Mover.new(m,cf),lod=lod}
end
-- The airport package parks an aircraft on the shuttle stand; the shuttle replaces it locally.
local nextStandSearch=0
local function hideStandAircraft(t: number)
	if hiddenStand and hiddenStand.Parent then return end
	hiddenStand=nil
	if t&lt;nextStandSearch then return end
	nextStandSearch=t+3 -- searched only every 3 s while it is not streamed in
	local world=workspace:FindFirstChild("WorldCity")
	if not world then return end
	-- AirportBuilder: WorldCity/Airport/Apron/ParkedAircraft (a few dozen children); full search as a fallback
	local airport=world:FindFirstChild("Airport")
	local apron=if airport then airport:FindFirstChild("Apron") else nil
	local list=if apron then apron:GetChildren() else world:GetDescendants()
	for _,d in list do
		if d:IsA("Model") and d.Name=="ParkedAircraft" and d:GetAttribute("Stand")==CityPlan.AIRPORT.shuttleStand then
			local function hidePart(p: Instance)
				if p:IsA("BasePart") then p.LocalTransparencyModifier=1;p.CanCollide=false;p.CanQuery=false end
			end
			for _,p in d:GetDescendants() do hidePart(p) end
			-- the model is not Atomic: parts that stream in later are hidden as they arrive
			if hiddenConn then hiddenConn:Disconnect() end
			hiddenConn=d.DescendantAdded:Connect(hidePart)
			hiddenStand=d
			return
		end
	end
end

------------------------------------------------------------------------------------------------ airstairs (Port Meridian)
local function buildAirstairs(): Model
	local m=Instance.new("Model");m.Name="ShuttleAirstairs"
	local pts=points()
	local stand=FP.PM_STAND
	local door=stand*pts.doorL1 -- outward = LookVector
	local sill=door.Position.Y-pts.doorHalf
	local out=door.LookVector
	local side=out:Cross(Vector3.new(0,1,0))
	local ground=CityPlan.ROAD_TOP
	local h=sill-ground
	local run=h*1.25
	local function part(name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?)
		local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
		p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic;p.Parent=m
	end
	local top=Vector3.new(door.Position.X,sill,door.Position.Z)+out*0.9
	local bottom=top+out*run-Vector3.new(0,h,0)
	local mid=(top+bottom)/2
	local len=(top-bottom).Magnitude
	local frame=CFrame.lookAt(mid,mid+(bottom-top).Unit)
	part("StairFlight",Vector3.new(4.2,0.4,len),frame,Color3.fromRGB(190,194,198),Enum.Material.DiamondPlate)
	local steps=math.max(4,math.floor(h/0.9))
	for i=1,steps-1 do
		local p=top:Lerp(bottom,i/steps)
		part("StairStep",Vector3.new(4.2,0.2,0.5),CFrame.lookAt(p+Vector3.new(0,0.2,0),p+Vector3.new(0,0.2,0)+out),Color3.fromRGB(150,154,158),Enum.Material.Metal)
	end
	for _,s in {-1,1} do
		part("Handrail",Vector3.new(0.25,0.25,len),frame*CFrame.new(s*2.1,3.2,0),Color3.fromRGB(230,232,234),Enum.Material.Metal)
		for k=0,2 do
			local p=top:Lerp(bottom,k/2)+side*s*2.1
			part("RailPost",Vector3.new(0.2,3.2,0.2),CFrame.new(p+Vector3.new(0,1.6,0)),Color3.fromRGB(230,232,234),Enum.Material.Metal)
		end
	end
	part("Platform",Vector3.new(4.6,0.4,2.2),CFrame.lookAt(top+out*0.6,top+out*2),Color3.fromRGB(190,194,198),Enum.Material.DiamondPlate)
	-- the tow truck under the stairs
	local base=(top+bottom)/2;base=Vector3.new(base.X,ground+1.4,base.Z)
	part("StairTruck",Vector3.new(5.6,2.4,run*0.8),CFrame.lookAt(base,base+out),Color3.fromRGB(236,236,232))
	part("StairTruckStripe",Vector3.new(5.7,0.5,run*0.8),CFrame.lookAt(base+Vector3.new(0,0.4,0),base+Vector3.new(0,0.4,0)+out),Color3.fromRGB(24,120,128))
	for _,s in {-1,1} do for _,f in {-0.3,0.3} do
		local w=base+side*s*2.6+out*(run*f)-Vector3.new(0,0.6,0)
		local p=Instance.new("Part");p.Name="StairWheel";p.Shape=Enum.PartType.Cylinder;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
		p.Size=Vector3.new(0.7,1.6,1.6);p.CFrame=CFrame.lookAt(w,w+out)*CFrame.Angles(0,math.pi/2,0);p.Color=Color3.fromRGB(26,26,28);p.Material=Enum.Material.Rubber;p.Parent=m
	end end
	m:SetAttribute("Bottom",bottom+Vector3.new(0,3,0));m:SetAttribute("Top",top+Vector3.new(0,3,0))
	return m
end
local function setAirstairs(show: boolean)
	if show and not airstairs then
		local m=buildAirstairs();m.Parent=ensureClientFolder();airstairs=m
	elseif not show and airstairs then
		airstairs:Destroy();airstairs=nil
	end
end

------------------------------------------------------------------------------------------------ crew
type CrewMember={model: Model,root: BasePart,joints: {[string]: Motor6D},seed: number,seat: CFrame,delay: number,visible: boolean?,parts: {BasePart}}
local crew: {CrewMember}={}
local function dropCrew()
	for _,c in crew do c.model:Destroy() end
	table.clear(crew)
end
local function buildCrew(): boolean
	if #crew&gt;0 then return true end
	local f=folder
	local templates=if f then f:FindFirstChild("Crew") else nil
	if not templates then return false end
	local pts=points()
	for i,name in {"Captain","FirstOfficer"} do
		local t=templates:FindFirstChild(name)
		if t and t:IsA("Model") then
			local m=t:Clone()
			local hum=m:FindFirstChildOfClass("Humanoid");if hum then hum:Destroy() end
			local root=m:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local joints: {[string]: Motor6D}={}
				local parts: {BasePart}={}
				for _,d in m:GetDescendants() do
					if d:IsA("Motor6D") then joints[d.Name]=d end
					if d:IsA("BasePart") then
						d.CanCollide=false;d.CanQuery=false;d.CanTouch=false;d.CastShadow=false
						if d.Name~="HumanoidRootPart" then table.insert(parts,d) end
					end
				end
				root.Anchored=true
				m.Parent=ensureClientFolder()
				local seed=m:GetAttribute("PersonalitySeed")
				table.insert(crew,{model=m,root=root,joints=joints,seed=if typeof(seed)=="number" then seed else i*97,seat=if i==1 then pts.captain else pts.firstOfficer,delay=(i-1)*1.4,visible=nil,parts=parts})
			else m:Destroy() end
		end
	end
	return #crew&gt;0
end
local function cachedBridge(): (Vector3?,Vector3?)
	local world=workspace:FindFirstChild("WorldCity")
	local bridge=if world then world:FindFirstChild("JetBridge_A"..CityPlan.AIRPORT.shuttleStand,true) else nil
	if not bridge then return nil,nil end
	local td=bridge:GetAttribute("TerminalDoor");local ad=bridge:GetAttribute("AircraftDoor")
	return if typeof(td)=="Vector3" then td else nil,if typeof(ad)=="Vector3" then ad else nil
end
local function crewRoomPoints(): {Vector3}
	local a=CityPlan.AIRPORT
	local p0=a.crewRoom.Position
	local door=p0+Vector3.new(0,0,9)
	local world=workspace:FindFirstChild("WorldCity")
	local marker=if world then world:FindFirstChild("CrewRoom",true) else nil
	if marker then
		local inner=marker:FindFirstChild("CrewRoom")
		local m=if marker:IsA("BasePart") then marker elseif inner and inner:IsA("BasePart") then inner else nil
		local d=if m then m:GetAttribute("Door") else nil
		if typeof(d)=="Vector3" then door=Vector3.new(d.X,p0.Y,d.Z) end
	end
	return {p0,door}
end
-- Walk path (world points, root height) from the departure terminal to the cockpit seat for the plane at cf.
local function crewPath(atHome: boolean,cf: CFrame,seat: CFrame): {Vector3}
	local pts=points()
	local door=cf*pts.doorL1
	local floorY=cf.Position.Y+pts.cabin.floorY+3
	local inCabin={cf*Vector3.new(pts.doorL1.X*0.55,pts.cabin.floorY+3,pts.doorL1.Z),cf*Vector3.new(0,pts.cabin.floorY+3,pts.doorL1.Z-1.5),
		cf*Vector3.new(0,pts.cabin.floorY+3,seat.Z+3.2),cf*Vector3.new(seat.X,seat.Y,seat.Z+1.2)}
	local path: {Vector3}={}
	local sillPoint=Vector3.new(door.Position.X,floorY,door.Position.Z)+door.LookVector*0.8
	if atHome then
		local room=crewRoomPoints()
		local td,_=cachedBridge()
		local g=CityPlan.AIRPORT.gates[CityPlan.AIRPORT.shuttleStand] or CityPlan.AIRPORT.gates[1]
		local terminalDoor=td or Vector3.new(g.Position.X-11.4,CityPlan.GROUND+3.5,CityPlan.AIRPORT.terminal.z2)
		-- out of the crew room onto the concourse, then straight down the boarding lane (between the queue
		-- belts, west of the gate desk) to the jet bridge door
		table.insert(path,room[1]);table.insert(path,room[2])
		table.insert(path,Vector3.new(room[2].X,room[1].Y,room[2].Z+5))
		table.insert(path,Vector3.new(terminalDoor.X,room[1].Y,room[2].Z+6))
		table.insert(path,Vector3.new(terminalDoor.X,room[1].Y,terminalDoor.Z))
		table.insert(path,sillPoint+door.LookVector*4)
	else
		local stairs=airstairs
		local bottom=if stairs and typeof(stairs:GetAttribute("Bottom"))=="Vector3" then stairs:GetAttribute("Bottom") :: Vector3 else sillPoint+door.LookVector*14
		table.insert(path,Vector3.new(cf.Position.X-40,CityPlan.GROUND+3.5,CityPlan.ABROAD.terminal.z1-2))
		table.insert(path,bottom+door.LookVector*4)
		table.insert(path,bottom)
		table.insert(path,sillPoint+door.LookVector*1.2)
	end
	table.insert(path,sillPoint)
	for _,p in inCabin do table.insert(path,p) end
	return path
end
local function along(path: {Vector3},u: number): (Vector3,Vector3)
	local total=0
	for i=2,#path do total+=(path[i]-path[i-1]).Magnitude end
	local s=math.clamp(u,0,1)*total
	for i=2,#path do
		local seg=(path[i]-path[i-1]).Magnitude
		if s&lt;=seg or i==#path then
			local dir=path[i]-path[i-1]
			local f=if seg&gt;0 then math.clamp(s/seg,0,1) else 1
			return path[i-1]:Lerp(path[i],f),if dir.Magnitude&gt;1e-3 then dir.Unit else Vector3.new(0,0,-1)
		end
		s-=seg
	end
	return path[#path],Vector3.new(0,0,-1)
end
local function poseCrew(c: CrewMember,cf: CFrame,sitting: boolean,walking: boolean,t: number,near: boolean)
	c.root.CFrame=cf
	if not near then return end
	local transforms=Employee.pose(if sitting then "WORKING" else "WALKING",sitting,walking,t,c.seed)
	for name,tr in transforms do
		local j=c.joints[name]
		if j and j.Parent then j.Transform=tr end
	end
end
local pathKey=""
local pathCache: {[number]: {Vector3}}={}
local function updateCrew(st: FP.State,pose: FP.Pose,t: number,camPos: Vector3)
	local near=riding~=nil or (camPos-pose.cf.Position).Magnitude&lt;Shuttle.CREW_NEAR
	if not near then if #crew&gt;0 then dropCrew() end return end
	if not buildCrew() then return end
	local state,since=FP.crewTimes(st)
	local atHome=(st.dir=="out" and st.phase=="boarding") or (st.dir=="back" and st.phase=="deboarding")
	local closeUp=riding~=nil or (camPos-pose.cf.Position).Magnitude&lt;160
	for idx,c in crew do
		local visible=true
		if (state=="walking" or state=="leaving") and since then
			local walkT=since-c.delay
			local dur=(if state=="walking" then FP.CREW_WALK else FP.CREW_LEAVE)-2
			local u=math.clamp(walkT/dur,0,1)
			if state=="leaving" then u=1-u end
			local key=(if atHome then "home" else "pm")..st.dir..st.cycle..state
			if key~=pathKey then pathKey=key;table.clear(pathCache) end
			local path=pathCache[idx]
			if not path then path=crewPath(atHome,pose.cf,c.seat);pathCache[idx]=path end
			local p,dir=along(path,u)
			local flatDir=Vector3.new(dir.X,0,dir.Z)
			if state=="leaving" then flatDir=-flatDir end
			if flatDir.Magnitude&lt;1e-3 then flatDir=pose.cf.LookVector*Vector3.new(1,0,1) end
			local seated=u&gt;=0.999
			if seated then poseCrew(c,pose.cf*c.seat,true,false,t,closeUp)
			else poseCrew(c,CFrame.lookAt(p,p+flatDir.Unit),false,walkT&gt;0 and walkT&lt;dur,t,closeUp) end
			-- before the walk starts / after it ends the pilot is inside the terminal
			visible=not ((state=="walking" and walkT&lt;0) or (state=="leaving" and walkT&gt;dur))
		elseif state=="cockpit" then
			poseCrew(c,pose.cf*c.seat,true,false,t,closeUp)
		else
			visible=false
		end
		if c.visible~=visible then
			c.visible=visible
			for _,d in c.parts do d.LocalTransparencyModifier=if visible then 0 else 1 end
		end
	end
end

------------------------------------------------------------------------------------------------ boarding pass + gate
local passGui: ScreenGui?=nil
local passText: TextLabel?=nil
local beacon: Part?=nil
local gateBoards: {BillboardGui}={}
local function playerGui(): Instance? return player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui",2) end
local function closePass()
	if passGui then passGui:Destroy();passGui=nil;passText=nil end
	if beacon then beacon:Destroy();beacon=nil end
end
local function openPass()
	closePass()
	local pg=playerGui()
	if not pg then return end
	local gui=Instance.new("ScreenGui");gui.Name="ShuttlePass";gui.ResetOnSpawn=false;gui.DisplayOrder=25
	local box=Instance.new("Frame");box.Name="Pass";box.AnchorPoint=Vector2.new(1,0.5);box.Position=UDim2.new(1,-16,0.5,40);box.Size=UDim2.fromOffset(270,96)
	box.BackgroundColor3=Theme.colors.panel;box.BackgroundTransparency=0.06;box.BorderSizePixel=0;box.Parent=gui
	local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,10);corner.Parent=box
	local stripe=Instance.new("Frame");stripe.Size=UDim2.new(0,6,1,0);stripe.BackgroundColor3=Color3.fromRGB(24,120,128);stripe.BorderSizePixel=0;stripe.Parent=box
	local t=Instance.new("TextLabel");t.Name="Text";t.BackgroundTransparency=1;t.Position=UDim2.fromOffset(16,6);t.Size=UDim2.new(1,-24,1,-12)
	t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Top;t.TextWrapped=true;t.RichText=false
	t.Font=Theme.font.medium;t.TextSize=15;t.TextColor3=Theme.colors.text;t.Text="";t.Parent=box
	gui.Parent=pg
	passGui=gui;passText=t
	-- a beacon over the boarding gate
	local tk=ticket
	if tk then
		local pos=if tk.to=="abroad" then FP.HOME_GATES[1] else FP.PM_GATES[1]
		local b=Instance.new("Part");b.Name="ShuttleGateBeacon";b.Anchored=true;b.CanCollide=false;b.CanTouch=false;b.CanQuery=false;b.CastShadow=false
		b.Shape=Enum.PartType.Cylinder;b.Size=Vector3.new(26,1.2,1.2);b.CFrame=CFrame.new(pos+Vector3.new(0,16,0))*CFrame.Angles(0,0,math.pi/2)
		b.Color=Color3.fromRGB(24,170,180);b.Material=Enum.Material.Neon;b.Transparency=0.35;b.Parent=ensureClientFolder()
		local bb=Instance.new("BillboardGui");bb.Size=UDim2.fromOffset(200,44);bb.StudsOffsetWorldSpace=Vector3.new(0,16,0);bb.AlwaysOnTop=true;bb.MaxDistance=400;bb.Parent=b
		local l=Instance.new("TextLabel");l.BackgroundTransparency=1;l.Size=UDim2.fromScale(1,1);l.TextScaled=true;l.Font=Theme.font.bold;l.TextColor3=Color3.new(1,1,1)
		l.TextStrokeTransparency=0.4;l.Text=(if tk.to=="abroad" then "Gate "..tk.gate else "Boarding")..(" · "..tk.flight);l.Parent=bb
		beacon=b
	end
end
-- Status line of the next departure in direction dir at time t (gate boards, pass).
function Shuttle.statusText(dir: string,t: number): (string,string)
	local st=FP.at(t)
	local leg=FP.leg(dir)
	if st.dir==dir and st.phase=="boarding" then
		return "BOARDING",clock(st.legStart+leg.phases.pushback.t0-t)
	end
	if st.dir==dir and st.phase=="doors" then return "GATE CLOSED",clock(st.legStart+leg.phases.pushback.t0-t) end
	if st.dir==dir and st.tau&lt;leg.phases.deboarding.t0 then
		local _,_,dep=FP.nextLeg(dir,t+1)
		return "DEPARTED",clock(dep-t)
	end
	local _,start,dep=FP.nextLeg(dir,t)
	return if start-t&lt;60 then "BOARDING SOON" else "ON TIME",clock(dep-t)
end
local function updatePass(t: number)
	local tk=ticket
	local label=passText
	if not tk or not label then return end
	local dir=if tk.to=="abroad" then "out" else "back"
	local st=FP.at(t)
	local leg=FP.leg(dir)
	local route=if tk.to=="abroad" then "City Airport  →  Port Meridian" else "Port Meridian  →  City Airport"
	local line: string
	if st.dir==dir and st.phase=="boarding" then
		line="BOARDING NOW at "..(if tk.to=="abroad" then "gate "..tk.gate else "the gate").." · departs in "..clock(st.legStart+leg.phases.pushback.t0-t)
	else
		local _,start,dep=FP.nextLeg(dir,t)
		if t&gt;tk.boardingEnds+1 and dep&gt;tk.departs+1 then
			line="You missed "..tk.flight..". Your pass is valid for the next one: boarding in "..clock(start-t).." (departs "..clock(dep-t)..")."
		else
			line="Boarding in "..clock(start-t).." at "..(if tk.to=="abroad" then "gate "..tk.gate else "the gate").." · departs in "..clock(dep-t)
		end
	end
	label.Text="BOARDING PASS · "..tk.flight.."\n"..route.."\n"..line
end
local function updateGateBoards(t: number)
	local gates=workspace:FindFirstChild("ShuttleGates")
	if not gates then return end
	local pg=playerGui()
	if not pg then return end
	type Board={part: string,dir: string,dest: string}
	local defs: {Board}={{part="GateBoardHome",dir="out",dest="PORT MERIDIAN"},{part="GateBoardAbroad",dir="back",dest="CITY AIRPORT"}}
	for i,def in defs do
		local part=gates:FindFirstChild(def.part)
		local existing=gateBoards[i]
		if not part or not part:IsA("BasePart") then if existing then existing.Enabled=false end continue end
		local gui: BillboardGui
		if existing and existing.Parent then gui=existing
		else
			gui=Instance.new("BillboardGui");gui.Name="ShuttleGateBoard";gui.Size=UDim2.fromOffset(260,74);gui.StudsOffsetWorldSpace=Vector3.new(0,7,0)
			gui.MaxDistance=90;gui.LightInfluence=0;gui.ResetOnSpawn=false
			local bg=Instance.new("Frame");bg.Size=UDim2.fromScale(1,1);bg.BackgroundColor3=Color3.fromRGB(18,24,36);bg.BackgroundTransparency=0.1;bg.BorderSizePixel=0;bg.Parent=gui
			local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,6);c.Parent=bg
			local l=Instance.new("TextLabel");l.Name="Text";l.BackgroundTransparency=1;l.Size=UDim2.new(1,-12,1,-8);l.Position=UDim2.fromOffset(6,4)
			l.Font=Enum.Font.RobotoMono;l.TextSize=15;l.TextColor3=Color3.fromRGB(250,206,80);l.TextXAlignment=Enum.TextXAlignment.Left;l.Parent=bg
			gui.Parent=pg
			gateBoards[i]=gui
		end
		gui.Adornee=part;gui.Enabled=true
		local status,left=Shuttle.statusText(def.dir,t)
		local text=gui:FindFirstChild("Text",true)
		if text and text:IsA("TextLabel") then
			text.Text=FP.CONFIG.flights[def.dir].."  "..def.dest.."\n"..status.."\nDEPARTS IN "..left
		end
	end
end

------------------------------------------------------------------------------------------------ ride
local rideGui: ScreenGui?=nil
local rideInfo: TextLabel?=nil
local windowFrame: Frame?=nil
local chaseEye: Vector3?=nil
local function rideButtonText(): string
	return "View: "..(if rideMode=="window" then "Window seat" elseif rideMode=="cockpit" then "Cockpit" else "Outside")
end
local function openRide()
	if rideGui then return end
	local pg=playerGui()
	if not pg then return end
	local gui=Instance.new("ScreenGui");gui.Name="ShuttleRide";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.DisplayOrder=80
	-- cabin window: a rounded transparent frame whose huge stroke paints the cabin wall around it
	local win=Instance.new("Frame");win.Name="CabinWindow";win.AnchorPoint=Vector2.new(0.5,0.5);win.Position=UDim2.fromScale(0.5,0.5)
	win.Size=UDim2.fromScale(0.42,0.62);win.BackgroundTransparency=1;win.Parent=gui
	local wc=Instance.new("UICorner");wc.CornerRadius=UDim.new(0.45,0);wc.Parent=win
	local wall=Instance.new("UIStroke");wall.Thickness=1800;wall.Color=Color3.fromRGB(214,212,204);wall.ApplyStrokeMode=Enum.ApplyStrokeMode.Border;wall.Parent=win
	local rim=Instance.new("Frame");rim.Name="Rim";rim.AnchorPoint=Vector2.new(0.5,0.5);rim.Position=UDim2.fromScale(0.5,0.5);rim.Size=UDim2.new(1,0,1,0);rim.BackgroundTransparency=1;rim.Parent=win
	local rc=Instance.new("UICorner");rc.CornerRadius=UDim.new(0.45,0);rc.Parent=rim
	local rs=Instance.new("UIStroke");rs.Thickness=14;rs.Color=Color3.fromRGB(168,166,160);rs.ApplyStrokeMode=Enum.ApplyStrokeMode.Border;rs.Parent=rim
	windowFrame=win
	local box=Instance.new("Frame");box.Name="FlightInfo";box.AnchorPoint=Vector2.new(0.5,0);box.Position=UDim2.new(0.5,0,0,58);box.Size=UDim2.fromOffset(420,74)
	box.BackgroundColor3=Theme.colors.panel;box.BackgroundTransparency=0.08;box.BorderSizePixel=0;box.Parent=gui
	local bc=Instance.new("UICorner");bc.CornerRadius=UDim.new(0,10);bc.Parent=box
	local info=Instance.new("TextLabel");info.BackgroundTransparency=1;info.Position=UDim2.fromOffset(14,6);info.Size=UDim2.new(1,-150,1,-12)
	info.TextXAlignment=Enum.TextXAlignment.Left;info.TextYAlignment=Enum.TextYAlignment.Center;info.Font=Theme.font.medium;info.TextSize=15
	info.TextColor3=Theme.colors.text;info.TextWrapped=true;info.Text="";info.Parent=box
	rideInfo=info
	local button=Instance.new("TextButton");button.Name="ViewButton";button.AnchorPoint=Vector2.new(1,0.5);button.Position=UDim2.new(1,-10,0.5,0);button.Size=UDim2.fromOffset(128,40)
	button.BackgroundColor3=Theme.colors.raised;button.TextColor3=Theme.colors.text;button.Font=Theme.font.bold;button.TextSize=14;button.Text=rideButtonText();button.AutoButtonColor=true;button.Parent=box
	local btc=Instance.new("UICorner");btc.CornerRadius=UDim.new(0,8);btc.Parent=button
	button.Activated:Connect(function()
		rideMode=if rideMode=="window" then "cockpit" elseif rideMode=="cockpit" then "outside" else "window"
		button.Text=rideButtonText()
		chaseEye=nil
	end)
	gui.Parent=pg
	rideGui=gui
end
local function closeRide()
	if rideGui then rideGui:Destroy();rideGui=nil;rideInfo=nil;windowFrame=nil end
	local camera=workspace.CurrentCamera
	if camera then
		camera.CameraType=Enum.CameraType.Custom
		camera.FieldOfView=70
		local character=player.Character
		local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid then camera.CameraSubject=humanoid end
	end
	chaseEye=nil
end
local function updateRideCamera(pose: FP.Pose,dt: number)
	local camera=workspace.CurrentCamera
	if not camera then return end
	camera.CameraType=Enum.CameraType.Scriptable
	local pts=points()
	local win=windowFrame
	if win then win.Visible=rideMode=="window" end
	if rideMode=="window" then
		camera.FieldOfView=62
		camera.CFrame=pose.cf*pts.cabinCamera
	elseif rideMode=="cockpit" then
		camera.FieldOfView=55 -- narrower: the windshield, not the cockpit ceiling, fills the view
		camera.CFrame=pose.cf*pts.cockpitCamera
	else
		camera.FieldOfView=60
		local want=(pose.cf*CFrame.new(-pts.span*0.55,pts.height*0.55,pts.length*1.15)).Position
		local prevEye=chaseEye
		local eye: Vector3=if prevEye then prevEye:Lerp(want,math.clamp(dt*2.5,0,1)) else want
		chaseEye=eye
		camera.CFrame=CFrame.lookAt(eye,pose.cf.Position+Vector3.new(0,pts.height*0.3,0))
	end
end
local ANNOUNCE: {[string]: string}={
	climb="The seat belt sign is now off. Enjoy the view of the coast on the left side.",
	approach="Cabin crew, please prepare for landing.",
	taxiin="Welcome! Please stay seated until we reach the gate.",
}
local function announce(st: FP.State)
	local f=folder
	local captain=if f and typeof(f:GetAttribute("CaptainName"))=="string" then f:GetAttribute("CaptainName") :: string else ""
	if st.phase=="pushback" then
		local dest=if st.dir=="out" then "Port Meridian" else "City Airport"
		Toast.show("info","This is your captain"..(if captain~="" then ", "..captain else "")..". Welcome aboard "..FP.CONFIG.airline.." flight "..st.leg.flight
			.." to "..dest..". Flight time today is about "..math.max(1,math.floor(FP.flightTime(st.dir)/60+0.5)).." minutes. Sit back and enjoy the flight.",8)
	elseif ANNOUNCE[st.phase] then
		Toast.show("info",ANNOUNCE[st.phase],5)
	end
end
local function updateRideInfo(st: FP.State,t: number)
	local info=rideInfo
	if not info then return end
	local leg=st.leg
	local route=if st.dir=="out" then "City Airport  →  Port Meridian" else "Port Meridian  →  City Airport"
	local arrive=st.legStart+leg.phases.deboarding.t0-t
	local phase=FP.PHASE_TEXT[st.phase] or st.phase
	local extra=if st.phase=="boarding" then " · departs in "..clock(st.legStart+leg.phases.pushback.t0-t) else " · arrival in "..clock(arrive)
	info.Text=leg.flight.." · "..route.."\n"..phase..extra
end

------------------------------------------------------------------------------------------------ actions
local busy=false
function Shuttle.checkIn(to: string)
	if busy then return end
	busy=true
	local ok,res=Action.call("TravelAction",{action="ticket",to=to},true)
	busy=false
	if not ok then Toast.show("error",message(res.err));return end
	ticket={flight=tostring(res.flight or ""),to=tostring(res.to or to),gate=tostring(res.gate or ""),departs=tonumber(res.departs) or 0,
		boardingStarts=tonumber(res.boardingStarts) or 0,boardingEnds=tonumber(res.boardingEnds) or 0,destination=tostring(res.destination or "")}
	openPass()
	local t=workspace:GetServerTimeNow()
	local tk=ticket :: Ticket
	local where=if tk.to=="abroad" then "gate "..tk.gate.." (airside, past security)" else "the gate"
	local paid=if typeof(res.price)=="number" and res.price&gt;0 then " · "..Format.money(res.price).." paid, return flight included" else ""
	if t&gt;=tk.boardingStarts then
		Toast.show("success","Checked in: "..tk.flight.." to "..tk.destination..paid..". Boarding now at "..where..".",7)
	else
		Toast.show("success","Checked in: "..tk.flight.." to "..tk.destination..paid..". Boarding starts in "..clock(tk.boardingStarts-t).." at "..where..".",7)
	end
	updatePass(t)
end
function Shuttle.board()
	if busy then return end
	busy=true
	local ok,res=Action.call("TravelAction",{action="board"},true)
	busy=false
	if ok then return end
	if res.err=="NOT_BOARDING" then
		local t=workspace:GetServerTimeNow()
		local starts=tonumber(res.boardingStarts) or t
		Toast.show("info",tostring(res.flight or "The shuttle").." is not boarding yet. Boarding starts in "..clock(starts-t)..".",5)
	else
		Toast.show("error",message(res.err))
	end
end

------------------------------------------------------------------------------------------------ frame
local accum=0
local function step(dt: number)
	local f=folder
	if not f or f:GetAttribute("Enabled")~=true then destroyPlane();dropCrew();return end
	local t=workspace:GetServerTimeNow()
	local pose,st=FP.pose(t)
	local camera=workspace.CurrentCamera
	local camPos=if camera then camera.CFrame.Position else pose.cf.Position
	local dist=(camPos-pose.cf.Position).Magnitude
	local want=if riding then "full" elseif dist&lt;Shuttle.LOD_FULL then "full" elseif dist&lt;Shuttle.LOD_FAR then "medium" else "none"
	if want=="none" then destroyPlane()
	elseif not plane or plane.lod~=want then buildPlane(want,pose.cf) end
	local pl=plane
	if pl then
		-- parked with the engines off: nothing moves, no BulkMoveTo at all
		if pose.engines or pl.last~=pose.cf then
			if pose.engines then fanAngle=(fanAngle+dt*(if pose.onGround and pose.speed&lt;1 then 9 else 26))%(math.pi*2) end
			Mover.move(pl.mover,pose.cf,fanAngle)
			pl.last=pose.cf
		end
		Mover.setGear(pl.mover,pose.gearDown)
	end
	-- announcements + ride
	local prev=lastState
	if riding and prev and (prev.phase~=st.phase) then announce(st) end
	lastState=st
	if riding then openRide();updateRideCamera(pose,dt) end
	-- Port Meridian airstairs while the shuttle stands there (before the crew: their path uses the stairs)
	local atPM=(st.dir=="back" and (st.phase=="boarding" or st.phase=="doors")) or (st.dir=="out" and st.phase=="deboarding")
	setAirstairs(atPM and (camPos-FP.PM_STAND.Position).Magnitude&lt;1500)
	updateCrew(st,pose,t,camPos)
	accum+=dt
	if accum&gt;=0.25 then
		accum=0
		hideStandAircraft(t)
		updatePass(t)
		updateGateBoards(t)
		if riding then updateRideInfo(st,t) end
	end
end
Shuttle.step=step

------------------------------------------------------------------------------------------------ init
local function onLeg()
	local key=player:GetAttribute("ShuttleLeg")
	if typeof(key)=="string" and key~="" then
		riding=key
		ticket=nil
		closePass()
		rideMode="window"
		openRide()
		Toast.show("success","Welcome aboard! Find your window seat - use the View button to change the camera.",5)
	elseif riding then
		riding=nil
		closeRide()
		local state=player:GetAttribute("TravelState")
		if state=="abroad" then
			Toast.show("success","Welcome to Port Meridian! Your return flight is included - check in at the counters to fly home.",7)
		elseif state==nil then
			Toast.show("success","Welcome back to City Airport! Your car waits in the car park west of the terminal.",6)
		end
	end
end
function Shuttle.init()
	task.spawn(function()
		local f=ReplicatedStorage:WaitForChild("Shuttle",30)
		if not f or not f:IsA("Folder") then return end
		folder=f
		RunService.RenderStepped:Connect(step)
	end)
	player:GetAttributeChangedSignal("ShuttleLeg"):Connect(onLeg)
	player:GetAttributeChangedSignal("TravelState"):Connect(function()
		-- a ticket is moot once the state changes (flight, respawn, arrival)
		local state=player:GetAttribute("TravelState")
		if ticket and state~=nil and state~="flying" then ticket=nil;closePass() end
	end)
	player.CharacterAdded:Connect(function()
		if ticket and ticket.to=="home" then ticket=nil;closePass() end
		if riding then riding=nil;closeRide() end
	end)
	if player:GetAttribute("ShuttleLeg")~=nil then onLeg() end
end
return Shuttle
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000048"><Properties><string name="Name">TalkController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Talking to people on the client: Notify TALK_OPEN → UI/Screens/TalkPanel, TALK_CLOSE (the server ended
-- the conversation) → last line + close, TALK_NOTICE (one-liners such as "Maya is off duty") → toast.
-- Replies go through TalkAction {action=say|close} (TalkService validates everything).
-- Talk prompts ("EmployeeTalk" on every staff rig) are shown locally only when they can work: own staff
-- or a Public front-of-house prompt (same rule as WorldController), not while the person is off duty /
-- inactive, and not while they are talking to someone (attribute TalkingTo, set by the server).
-- One AttributeChanged connection per rig; no per-frame work.
local Players=game:GetService("Players")
local Collection=game:GetService("CollectionService")
local State=require(script.Parent.StateController)
local Action=require(script.Parent.ActionController)
local UI=script.Parent.Parent.UI
local Toast=require(UI.Toast)
local TalkPanel=require(UI.Screens.TalkPanel)
local Conversation=require(UI.Screens.Conversation)
local Controller={}
local player=Players.LocalPlayer
local watched: {[Instance]:RBXScriptConnection}={}
local MESSAGES: {[string]:string}={
 NPC_BUSY="They're talking to someone else right now.",
 OFF_DUTY="They're off duty. Try again during working hours.",
 TOO_FAR="You walked away, so the conversation ended.",
 NPC_GONE="They're no longer here.",
 NO_TALK="That conversation has ended.",
 NOT_PUBLIC="Only this company's founder can talk to them.",
 UNAVAILABLE="They can't talk right now.",
}
function Controller.message(err: string?): string
 return if err and MESSAGES[err] then MESSAGES[err] else Action.message(err)
end
function Controller.call(payload: {[string]:any}): (boolean,any)
 local ok,res=Action.call("TalkAction",payload,true)
 if not ok and res.err~="BUSY" and res.err~="RATE_LIMIT" then Toast.show("error",Controller.message(res.err)) end
 return ok,res
end
-- Prompt visibility -----------------------------------------------------------------------------------
local function promptOf(model: Instance): ProximityPrompt?
 local head=model:FindFirstChild("Head")
 local prompt=if head then head:FindFirstChild("EmployeeTalk") else nil
 return if prompt and prompt:IsA("ProximityPrompt") then prompt else nil
end
function Controller.promptEnabled(model: Instance,prompt: ProximityPrompt): boolean
 local allowed=prompt:GetAttribute("OwnerUserId")==player.UserId or prompt:GetAttribute("Public")==true
 return allowed and model:GetAttribute("OffDuty")~=true and model:GetAttribute("Activity")~="INACTIVE" and model:GetAttribute("TalkingTo")==nil
end
local function refresh(model: Instance)
 local prompt=promptOf(model)
 if not prompt then return end
 local enabled=Controller.promptEnabled(model,prompt)
 if prompt.Enabled~=enabled then prompt.Enabled=enabled end
end
local function watch(model: Instance)
 if watched[model] or not model:IsA("Model") then return end
 watched[model]=model.AttributeChanged:Connect(function(name: string)
  if name=="OffDuty" or name=="TalkingTo" or name=="Activity" then refresh(model) end
 end)
 task.defer(refresh,model) -- after WorldController's own DescendantAdded pass
end
local function unwatch(model: Instance)
 local c=watched[model];if c then c:Disconnect();watched[model]=nil end
end
function Controller.init()
 State.onNotify(function(kind,payload)
  if kind=="TALK_OPEN" and typeof(payload.id)=="string" then
   if Conversation.isOpen() then
    -- an interview is open: don't stack panels, end the new conversation right away
    task.spawn(function() Controller.call({action="close",id=payload.id}) end)
    return
   end
   TalkPanel.open(payload,Controller.call)
  elseif kind=="TALK_CLOSE" then
   if typeof(payload.id)=="string" and TalkPanel.current()==payload.id then TalkPanel.finish(if typeof(payload.text)=="string" then payload.text else nil) end
  elseif kind=="TALK_NOTICE" and typeof(payload.text)=="string" then
   Toast.show("info",payload.text,5)
  elseif (kind=="INTERVIEW_OPEN" or kind=="ASSISTANT_OPEN") and TalkPanel.isOpen() then
   -- an interview or the assistant briefing takes over the screen: end the chat
   local id=TalkPanel.current()
   TalkPanel.close()
   task.spawn(function() Controller.call({action="close",id=id}) end)
  end
 end)
 player.CharacterAdded:Connect(function() TalkPanel.close() end)
 for _,m in Collection:GetTagged("CompanyEmployee") do watch(m) end
 Collection:GetInstanceAddedSignal("CompanyEmployee"):Connect(watch)
 Collection:GetInstanceRemovedSignal("CompanyEmployee"):Connect(unwatch)
end
return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000049"><Properties><string name="Name">TravelController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- World travel on the client (everything here is local; the server never receives per-frame data):
--   * Check-in counters (prompt CityAction="checkin", FlightTo): while the scheduled Port Meridian shuttle
--     runs (ReplicatedStorage.Shuttle, Enabled) the counter sells a boarding pass and ShuttleController takes
--     over (gate, boarding prompt CityAction="board", the visible ride with two pilots, arrival); air traffic
--     and the VIP helicopter are AirTrafficController's. Fallback when the shuttle is off: fade to black,
--     TravelAction {action="flight"}; while the server streams the arrival hall and moves the character, a
--     short client-only cutscene plays (a plane over a client-side sea and clouds, camera following it), then
--     the screen fades back in at the arrival hall.
--   * GPS guide: TravelController.guide(destinationId) fetches a CityPlan route from the server
--     (TravelAction {action="route"}) and draws it - glowing dashes along the road and a beacon with the
--     distance at the destination - until the player arrives or clear() is called. Notify "TRAVEL_GUIDE"
--     {to=id} (CityService.guide) lets server systems such as appointments start one.
--   * Info kiosks (prompt CityAction="navigate", To) and a compact GPS panel while driving the own car.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local ProximityPromptService=game:GetService("ProximityPromptService")
local CityPlan=require(ReplicatedStorage.Shared.Config.CityPlan)
local Format=require(ReplicatedStorage.Shared.Format)
local Aircraft=require(ReplicatedStorage.Shared.AircraftModel)
local State=require(script.Parent.StateController)
local Shuttle=require(script.Parent.ShuttleController)
local AirTraffic=require(script.Parent.AirTrafficController)
local Action=require(script.Parent.ActionController)
local Toast=require(script.Parent.Parent.UI.Toast)
local Theme=require(script.Parent.Parent.UI.Theme)
local Kit=require(script.Parent.Parent.UI.Kit)
local Travel={}
local player=Players.LocalPlayer
local MESSAGES: {[string]: string}={
	NO_MONEY="You need "..Format.money(CityPlan.TRAVEL.ticket).." for the return ticket to Port Meridian.",
	NOT_AT_CHECKIN="Walk up to a check-in counter first.",
	LEAVE_VEHICLE="Leave your car before checking in.",
	BUSY="Your flight is already boarding.",
	ALREADY_ABROAD="You are already abroad. Check in at Port Meridian Airport to fly home.",
	NOT_ABROAD="You are already at home.",
	CANCELLED="The flight was cancelled - your ticket was refunded.",
	FLIGHT_REQUIRED="That place is abroad: fly from City Airport (south of Business City) to get there.",
	OFF_MAP="No road leads there from here.",
	NO_ROUTE="No road leads there from here.",
	LOADING="Still loading - try again in a moment.",
	RATE_LIMIT="Slow down a little.",
}
local function message(err: any): string
	if typeof(err)=="string" and MESSAGES[err] then return MESSAGES[err] end
	return Action.message(if typeof(err)=="string" then err else nil)
end
local function rootPart(): BasePart?
	local character=player.Character
	local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

------------------------------------------------------------------------------------------------ overlay
local overlay: ScreenGui?=nil
local shade: Frame?=nil
local caption: TextLabel?=nil
local function ensureOverlay(): (Frame,TextLabel)
	local s,c=shade,caption
	if overlay and overlay.Parent and s and c then return s,c end
	local gui=Instance.new("ScreenGui");gui.Name="TravelOverlay";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.DisplayOrder=90
	local f=Instance.new("Frame");f.Size=UDim2.fromScale(1,1);f.BackgroundColor3=Color3.new(0,0,0);f.BackgroundTransparency=1;f.BorderSizePixel=0;f.Parent=gui
	local t=Instance.new("TextLabel");t.AnchorPoint=Vector2.new(.5,1);t.Position=UDim2.new(.5,0,1,-48);t.Size=UDim2.fromOffset(640,44)
	t.BackgroundTransparency=1;t.TextColor3=Theme.colors.text;t.Font=Theme.font.bold;t.TextSize=26;t.Text="";t.TextTransparency=1;t.Parent=gui
	gui.Parent=player:WaitForChild("PlayerGui")
	overlay,shade,caption=gui,f,t
	return f,t
end
local function fade(target: number,seconds: number)
	local f=ensureOverlay()
	local tween=TweenService:Create(f,TweenInfo.new(seconds,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=target})
	tween:Play();task.wait(seconds)
end
local function say(text: string)
	local _,t=ensureOverlay();t.Text=text;t.TextTransparency=if text=="" then 1 else 0
end

------------------------------------------------------------------------------------------------ cutscene
-- A client-only scene high above the empty sea between home and Port Meridian (nothing streams there):
-- a sea plane, a few clouds and the aircraft, which flies forward while the camera circles it.
Travel.SCENE_ORIGIN=CFrame.new(0,2600,5600)
function Travel.buildScene(): (Model,Model)
	local scene=Instance.new("Model");scene.Name="FlightCutscene"
	local o=Travel.SCENE_ORIGIN
	local function deco(name: string,size: Vector3,cf: CFrame,color: Color3,shape: Enum.PartType?,transparency: number?): Part
		local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
		p.Size=size;p.CFrame=cf;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.Transparency=transparency or 0
		if shape then p.Shape=shape end
		p.Parent=scene;return p
	end
	deco("Sea",Vector3.new(2048,1,2048),o*CFrame.new(0,-420,-900),Color3.fromRGB(70,118,150))
	local rng=Random.new(20261003) -- the same clouds on every flight
	for _=1,22 do
		local d=rng:NextNumber(30,70)
		deco("Cloud",Vector3.new(d,d,d),o*CFrame.new(rng:NextNumber(-260,260),rng:NextNumber(-140,-30),-rng:NextNumber(0,2000)),Color3.fromRGB(245,246,248),Enum.PartType.Ball,.15)
	end
	local plane=Aircraft.build(scene,o,{scale=1.6,livery=Theme.accent,name="CutscenePlane"}) -- company colour livery
	return scene,plane
end
local function cutscene(seconds: number)
	local camera=workspace.CurrentCamera
	if not camera then task.wait(seconds);return end
	local scene,plane=Travel.buildScene()
	scene.Parent=workspace
	camera.CameraType=Enum.CameraType.Scriptable
	local o=Travel.SCENE_ORIGIN
	local t0=os.clock()
	local connection=RunService.RenderStepped:Connect(function()
		local t=math.clamp((os.clock()-t0)/seconds,0,1)
		local pcf=o*CFrame.new(0,math.sin(t*math.pi*2)*6,-t*1500)*CFrame.Angles(0,0,math.sin(t*5)*.06)
		plane:PivotTo(pcf)
		local a=1.9+t*1.6 -- the camera swings from the left wing round behind the tail
		local eye=pcf.Position+Vector3.new(math.cos(a)*150,40-t*18,math.sin(a)*150+40)
		camera.CFrame=CFrame.lookAt(eye,pcf.Position)
	end)
	task.wait(seconds)
	connection:Disconnect()
	scene:Destroy()
	camera.CameraType=Enum.CameraType.Custom -- the normal player camera, following the character again
	local character=player.Character
	local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then camera.CameraSubject=humanoid end
end
local flying=false
function Travel.fly(to: string)
	if flying or (to~="abroad" and to~="home") then return end
	flying=true
	Travel.clear()
	fade(0,.6)
	say("Checking in…")
	local ok,res=Action.call("TravelAction",{action="flight",to=to},true)
	if not ok then
		say("");fade(1,.5);flying=false
		Toast.show("error",message(res.err))
		return
	end
	local seconds=if typeof(res.seconds)=="number" then math.clamp(res.seconds,3,20) else CityPlan.TRAVEL.flightSeconds
	say("Flight to "..tostring(res.destination or "Port Meridian"))
	task.spawn(fade,1,.8)
	cutscene(seconds-.6)
	fade(0,.4)
	say("")
	task.wait(.2)
	fade(1,.8)
	flying=false
	if to=="abroad" then
		Toast.show("success","Welcome to Port Meridian. Your return flight is included - check in at the counters to fly home.",6)
	else
		Toast.show("success","Welcome back! Your car waits in the airport car park west of the terminal.",6)
	end
end

------------------------------------------------------------------------------------------------ GPS guide
local guideFolder: Folder?=nil
local guideTarget: Vector3?=nil
local guideName=""
local guideLabel: TextLabel?=nil
local guideSerial=0
function Travel.clear()
	guideSerial+=1
	if guideFolder then guideFolder:Destroy() end
	guideFolder=nil;guideTarget=nil;guideLabel=nil
end
function Travel.active(): boolean return guideFolder~=nil end
-- Draws a route (points from CityPlan.route). Segments inside a campus plot (garage, ramp) are skipped.
function Travel.draw(points: {Vector3},name: string)
	Travel.clear()
	if #points&lt;2 then return end
	local folder=Instance.new("Folder");folder.Name="TravelGuide"
	local color=Theme.accent
	local function dash(cf: CFrame)
		local p=Instance.new("Part");p.Name="GuideDash";p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
		p.Size=Vector3.new(1.4,.12,6);p.CFrame=cf;p.Color=color;p.Material=Enum.Material.Neon;p.Transparency=.15;p.Parent=folder
	end
	local y=CityPlan.GROUND+.8
	local count=0
	for i=1,#points-1 do
		local a,b=points[i],points[i+1]
		if CityPlan.plotAt(a) or CityPlan.plotAt(b) then continue end
		local from,to=Vector3.new(a.X,y,a.Z),Vector3.new(b.X,y,b.Z)
		local len=(to-from).Magnitude
		if len&lt;1 then continue end
		local dir=(to-from)/len
		local s=6
		while s&lt;len and count&lt;600 do
			local p=from+dir*s
			dash(CFrame.lookAt(p,p+dir))
			s+=16;count+=1
		end
	end
	local target=points[#points]
	local beacon=Instance.new("Part");beacon.Name="GuideBeacon";beacon.Anchored=true;beacon.CanCollide=false;beacon.CanTouch=false;beacon.CanQuery=false;beacon.CastShadow=false
	beacon.Shape=Enum.PartType.Cylinder;beacon.Size=Vector3.new(80,3,3);beacon.CFrame=CFrame.new(target.X,CityPlan.GROUND+40,target.Z)*CFrame.Angles(0,0,math.pi/2)
	beacon.Color=color;beacon.Material=Enum.Material.Neon;beacon.Transparency=.35;beacon.Parent=folder
	local gui=Instance.new("BillboardGui");gui.Name="GuideLabel";gui.Size=UDim2.fromOffset(260,52);gui.AlwaysOnTop=true;gui.StudsOffsetWorldSpace=Vector3.new(0,46,0);gui.Adornee=beacon;gui.Parent=beacon
	local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.TextColor3=Color3.new(1,1,1);label.TextStrokeTransparency=.4
	label.Font=Theme.font.bold;label.TextScaled=true;label.Text=name;label.Parent=gui
	folder.Parent=workspace
	guideFolder,guideTarget,guideName,guideLabel=folder,target,name,label
end
-- Fetch a route for a destination id (CityPlan.DESTINATIONS or "home") and draw it.
function Travel.guide(id: string)
	task.spawn(function()
		local token=guideSerial
		local ok,res=Action.call("TravelAction",{action="route",to=id},true)
		if token~=guideSerial then return end -- cleared, replaced or a flight started meanwhile
		if not ok then Toast.show("error",message(res.err));return end
		if typeof(res.points)~="table" then return end
		local points: {Vector3}={}
		for _,p in res.points do if typeof(p)=="Vector3" then table.insert(points,p) end end
		local name=if typeof(res.name)=="string" then res.name else "Destination"
		Travel.draw(points,name)
		Toast.show("info","Route to "..name.." · "..Format.int(tonumber(res.length) or 0).." studs. Follow the glowing line.",5)
	end)
end
local function watchArrival()
	while true do
		task.wait(.5)
		local target=guideTarget;local root=rootPart()
		if target and root then
			local d=CityPlan.flat(root.Position,target)
			local label=guideLabel
			if label then label.Text=guideName.."\n"..Format.int(d).." studs" end
			if d&lt;=CityPlan.TRAVEL.arriveRadius then
				local name=guideName
				Travel.clear()
				Toast.show("success","You have arrived at "..name..".",4)
			end
		end
	end
end

------------------------------------------------------------------------------------------------ GPS panel
local panel: ScreenGui?=nil
local function closePanel() if panel then panel:Destroy();panel=nil end end
local function driving(): boolean
	local character=player.Character
	local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
	local seat=if humanoid then humanoid.SeatPart else nil
	return seat~=nil and seat:IsA("VehicleSeat") and seat.Parent~=nil and seat.Parent:GetAttribute("OwnerUserId")==player.UserId
end
local function openPanel()
	closePanel()
	local gui=Instance.new("ScreenGui");gui.Name="TravelGPS";gui.ResetOnSpawn=false;gui.DisplayOrder=30;gui.Parent=player:WaitForChild("PlayerGui");panel=gui
	local box=Kit.frame(gui,UDim2.fromOffset(250,44),UDim2.new(0,16,.5,-120));box.BackgroundColor3=Theme.colors.panel;box.BackgroundTransparency=.08;Kit.corner(box,10);Kit.stroke(box,.85)
	local toggle=Kit.button(box,"GPS · choose a destination","secondary",UDim2.new(1,-12,0,32));toggle.Position=UDim2.fromOffset(6,6)
	local list: ScrollingFrame?=nil
	Kit.onClick(toggle,function()
		if list then list:Destroy();list=nil;box.Size=UDim2.fromOffset(250,44);return end
		box.Size=UDim2.fromOffset(250,330)
		local scroll=Kit.scroll(box,UDim2.new(1,-12,1,-50),UDim2.fromOffset(6,44));list=scroll
		Kit.list(scroll,4)
		local entries: {{string}}={{"home","My HQ"}}
		if Travel.active() then table.insert(entries,1,{"","Clear route"}) end
		for _,d in CityPlan.DESTINATION_LIST do
			if d.zone~="abroad" and (d.kind~="landmark" or d.zone=="downtown") then table.insert(entries,{d.id,d.name}) end
		end
		for i,e in entries do
			local b=Kit.button(scroll,e[2],if e[1]=="" then "ghost" else "secondary",UDim2.new(1,-8,0,30));b.LayoutOrder=i;b.TextSize=14
			Kit.onClick(b,function()
				if e[1]=="" then Travel.clear() else Travel.guide(e[1]) end
				if list then list:Destroy();list=nil;box.Size=UDim2.fromOffset(250,44) end
			end)
		end
	end)
end
local function watchDriving()
	while true do
		task.wait(.5)
		local d=driving()
		if d and not panel then openPanel() elseif not d and panel then closePanel() end
	end
end

------------------------------------------------------------------------------------------------ init
function Travel.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt,who: Player)
		if who~=player then return end
		local action=prompt:GetAttribute("CityAction")
		if action=="checkin" then
			local to=prompt:GetAttribute("FlightTo")
			if typeof(to)=="string" then
				if Shuttle.active() then ensureOverlay();task.spawn(Shuttle.checkIn,to) else task.spawn(Travel.fly,to) end
			end
		elseif action=="board" then
			task.spawn(Shuttle.board)
		elseif action=="navigate" then
			local to=prompt:GetAttribute("To")
			if typeof(to)=="string" then Travel.guide(to) end
		end
	end)
	State.onNotify(function(kind,payload)
		if kind=="TRAVEL_GUIDE" and typeof(payload.to)=="string" then Travel.guide(payload.to) end
	end)
	-- a flight or a respawn ends any guide
	player:GetAttributeChangedSignal("TravelState"):Connect(function() if player:GetAttribute("TravelState")~=nil then Travel.clear() end end)
	player.CharacterAdded:Connect(function() Travel.clear() end)
	task.spawn(watchArrival)
	task.spawn(watchDriving)
	Shuttle.init()
	AirTraffic.init()
end
return Travel
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000056"><Properties><string name="Name">UI</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000046"><Properties><string name="Name">Apps</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">ComputeApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Compute (user request 23 "the servers really work", CORE_SPEC 3.1 / 3.2 / 5.5): what the GPUs are doing right now
-- (business clients' reserved compute, serving users, free headroom, units off line by rack faults), capacity vs load
-- with the waitlist, the training speed left over, active rack faults with the IT repair countdown, running power and
-- serving costs, the rack with the GPU slots of the office stage, cooling, the studio split and the GPU shop.
-- Every number comes from the replicated state (live.compute / capacity / load / waitlist / ops / perModel) or the
-- shared formulas (CompanyOps.capacity, EmpireMath.trainingRate, HardwareConfig.thermal / slots).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local HardwareConfig = require(Shared.Config.HardwareConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local CompanyOps = require(Shared.CompanyOps)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot

local TIER_SHADE: { [string]: (Color3) -&gt; Color3 } = {
	consumer = Theme.darker(0.35),
	workstation = function(color: Color3): Color3
		return color
	end,
	accelerator = Theme.lighter(0.55),
}
-- electricity while anything is live: throughput x this $/s (MarketService.tick; HardwareConfig.SERVE_POWER once the
-- econ owner exports it, see design/requests/apps.md)
local SERVE_POWER: number = (HardwareConfig :: any).SERVE_POWER or 0.025
local MAX_SLOTS = 72 -- 48 GPU slots x 1.5 with Distributed Cluster (Global AI HQ)

local ComputeApp = {}

local root: Frame? = nil
local refresh: (Snapshot) -&gt; () = function(_snapshot: Snapshot) end

-- What the fleet does right now, in effective compute units (throughput x thermal, CompanyOps.capacity):
-- clients = reserved for business clients, serving = used by users, free = headroom, offline = rack faults.
export type Split = { total: number, clients: number, serving: number, free: number, offline: number, load: number, capacity: number, waitlist: number }
function ComputeApp.split(data: any, live: any): Split
	local e = data.empire
	local compute = if typeof(live.compute) == "table" then live.compute else {}
	local fleet = ModelMath.fleet(data.gpus)
	local units = tonumber(compute.units) or fleet.throughput
	local lost = math.clamp(tonumber(compute.lost) or 0, 0, units)
	local thermal = HardwareConfig.thermal(e, units)
	local reserved = tonumber(compute.reserved) or (if typeof(e.deals) == "table" then tonumber(e.deals.reserved) else nil) or 0
	local online = (units - lost) * thermal
	local clients = math.min(reserved, online)
	local consumer = math.max(0, online - reserved)
	local capacity = tonumber(live.capacity) or 0
	local load = tonumber(live.load) or 0
	local used = if capacity &gt; 0 then consumer * math.min(1, load / capacity) else 0
	return {
		total = units * thermal, clients = clients, serving = used, free = math.max(0, consumer - used), offline = lost * thermal,
		load = load, capacity = capacity, waitlist = tonumber(live.waitlist) or 0,
	}
end

-- training speed share left by the business clients' reservation (EmpireMath.trainingRate with and without it)
function ComputeApp.trainingShare(data: any): number
	local e = data.empire
	local fleet = ModelMath.fleet(data.gpus)
	if fleet.throughput &lt;= 0 then
		return 1
	end
	local free = table.clone(e)
	local deals: { [string]: any } = if typeof(e.deals) == "table" then table.clone(e.deals) else {}
	deals.reserved = 0
	free.deals = deals
	local full = EmpireMath.trainingRate(data.gpus, 1e18, free)
	return if full &gt; 0 then EmpireMath.trainingRate(data.gpus, 1e18, e) / full else 1
end

-- extra serving capacity (users) of one more GPU of this kind (CompanyOps.capacity with the GPU added)
function ComputeApp.extraUsers(data: any, gpuId: string): number
	local gpus = table.clone(data.gpus)
	gpus[gpuId] = (gpus[gpuId] or 0) + 1
	local withGpu = table.clone(data)
	withGpu.gpus = gpus
	return math.max(0, CompanyOps.capacity(withGpu) - CompanyOps.capacity(data))
end

local function gpuLabel(id: string): string
	local def = HardwareConfig.getGPU(id)
	return if def then def.label else id
end

local function stageList(): string
	local parts = {}
	for i, slots in HardwareConfig.STAGE_SLOTS do
		table.insert(parts, string.format("%s %d", string.gsub(EmpireConfig.OFFICES[i].name, "Headquarters", "HQ"), slots))
	end
	return table.concat(parts, " · ")
end

function ComputeApp.mount(parent: Frame, navigation: Kit.Nav)
	root = parent

	local scroll = Kit.scroll(parent)
	scroll.Name = "ComputeScroll"
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)

	Kit.heading(scroll, "COMPUTE", "Your GPUs serve your users, carry the compute your business clients reserve and train your models. More throughput = more users and faster training, more VRAM = bigger models.", 1)

	-- Servers: what the fleet does right now
	local servers = Kit.card(scroll, 2, 10)
	servers.Name = "Servers"
	local serverHead = Kit.frame(servers, UDim2.new(1, 0, 0, 26))
	serverHead.LayoutOrder = 1
	local serverTitle = Kit.text(serverHead, "Servers", 20, F.bold, C.text)
	serverTitle.Name = "Load"
	local serverTag = Kit.tag(serverHead, "OK", C.good)
	serverTag.AnchorPoint = Vector2.new(1, 0.5)
	serverTag.Position = UDim2.fromScale(1, 0.5)
	local serverText = Kit.para(servers, "", 14, C.muted, 2)
	local waitText = Kit.para(servers, "", 15, C.warn, 3)
	waitText.Name = "Waitlist"
	waitText.Font = F.bold
	local splitBar = Kit.splitBar(servers, 16, 4)
	splitBar.frame.Name = "Split"
	local legend = Kit.frame(servers, UDim2.new(1, 0, 0, 18))
	legend.LayoutOrder = 5
	Kit.list(legend, 16, true)
	local colors = {
		clients = C.warn,
		serving = Theme.accent,
		free = C.raised:Lerp(C.white, 0.18),
		offline = C.bad,
	}
	local _, lClients = Kit.legend(legend, colors.clients, "", 1)
	local _, lServing = Kit.legend(legend, colors.serving, "", 2)
	local _, lFree = Kit.legend(legend, colors.free, "", 3)
	local offlineChip, lOffline = Kit.legend(legend, colors.offline, "", 4)
	local trainText = Kit.para(servers, "", 14, C.muted, 6)
	trainText.Name = "Training"
	Kit.divider(servers, 7)
	Kit.caption(servers, "Rack faults", 8)
	local faultRows = Kit.stack(servers, 4, 9)
	faultRows.Name = "Faults"
	local faultNote = Kit.para(servers, "", 13, C.dim, 10)
	Kit.divider(servers, 11)
	Kit.caption(servers, "Running costs per game day", 12)
	local costText = Kit.para(servers, "", 14, C.muted, 13)
	costText.Name = "Costs"

	-- Rack: fleet and GPU slots of the office stage
	local fleetCard = Kit.card(scroll, 3, 12)
	local metrics = Kit.grid(fleetCard, 4, 48, 10, 1)
	local mThroughput = Kit.metric(metrics, "Throughput", 1, 20)
	local mTflops = Kit.metric(metrics, "Peak", 2, 20)
	local mVram = Kit.metric(metrics, "VRAM", 3, 20)
	local mPower = Kit.metric(metrics, "Power cost", 4, 20)
	local rackHead = Kit.frame(fleetCard, UDim2.new(1, 0, 0, 18))
	rackHead.LayoutOrder = 2
	Kit.caption(rackHead, "Server rack")
	local rackText = Kit.text(rackHead, "", 13, F.bold, C.muted)
	rackText.AnchorPoint = Vector2.new(1, 0)
	rackText.Position = UDim2.fromScale(1, 0)
	local rack = Kit.frame(fleetCard, UDim2.fromScale(1, 0))
	rack.Name = "Rack"
	rack.AutomaticSize = Enum.AutomaticSize.Y
	rack.LayoutOrder = 3
	local rackGrid = Instance.new("UIGridLayout")
	rackGrid.CellPadding = UDim2.fromOffset(6, 6)
	rackGrid.SortOrder = Enum.SortOrder.LayoutOrder
	rackGrid.Parent = rack
	local slots: { { frame: Frame, label: TextLabel } } = {}
	for i = 1, MAX_SLOTS do
		local slot = Kit.frame(rack)
		slot.Name = "Slot" .. i
		slot.LayoutOrder = i
		slot.BackgroundTransparency = 0
		slot.BackgroundColor3 = C.raised
		Kit.corner(slot, 5)
		local label = Kit.text(slot, "", 11, F.bold, C.bg)
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.5)
		slots[i] = { frame = slot, label = label }
	end
	local stageText = Kit.para(fleetCard, "GPU slots per office: " .. stageList() .. " (×1.5 with Distributed Cluster).", 13, C.dim, 4)
	stageText.Name = "StageSlots"
	local speedText = Kit.para(fleetCard, "", 14, C.muted, 5)

	local operations = Kit.card(scroll, 4, 10)
	Kit.caption(operations, "Compute operations", 1)
	local thermal = Kit.para(operations, "", 13, C.muted, 2)
	local cooling = Kit.button(operations, "UPGRADE COOLING", "secondary", UDim2.new(1, 0, 0, 34))
	cooling.LayoutOrder = 3
	Kit.onClick(cooling, function()
		ActionController.call("UpgradeCooling", {})
	end)
	Kit.caption(operations, "GPU split while a studio project builds", 4)
	local shares = Kit.segmented(operations, { { id = "0.35", label = "35% training" }, { id = "0.5", label = "50%" }, { id = "0.7", label = "70%" }, { id = "0.9", label = "90%" } }, "0.7", function(id)
		ActionController.call("SetComputeShare", { share = tonumber(id) })
	end)
	shares.frame.LayoutOrder = 5
	Kit.para(operations, "More training compute leaves less capacity for studio projects. Business clients reserve their own compute. Better cooling prevents large clusters from slowing down.", 13, C.dim, 6)

	-- Shop
	Kit.caption(scroll, "Hardware", 5)
	local list = Kit.stack(scroll, 10, 6)
	list.Name = "Shop"
	local rowRefs: { [string]: { owned: TextLabel, buy: TextButton?, sell: TextButton? } } = {}
	for index, gpu in HardwareConfig.GPUS do
		local row = Kit.frame(list, UDim2.new(1, 0, 0, 96))
		row.Name = "GPU_" .. gpu.id
		row.LayoutOrder = index
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = C.panel2
		Kit.corner(row, 12)
		Kit.stroke(row, 0.92)
		Kit.padding(row, 12, 14, 12, 16)

		local nameRow = Kit.frame(row, UDim2.new(1, -260, 0, 24))
		Kit.list(nameRow, 8, true)
		local name = Kit.text(nameRow, gpu.label, 18, F.bold, C.text)
		name.LayoutOrder = 1
		Kit.tag(nameRow, gpu.tier, if gpu.starter then C.dim else C.muted, 2)
		local stats = Kit.text(
			row,
			`{gpu.throughput} units/s · {gpu.vram} GB VRAM · ${gpu.powerCost} power per unit`,
			14,
			F.medium,
			C.muted
		)
		stats.Position = UDim2.fromOffset(0, 30)
		local owned = Kit.text(row, "", 14, F.bold, C.text)
		owned.Name = "Owned"
		owned.Position = UDim2.fromOffset(0, 52)

		local refs: { owned: TextLabel, buy: TextButton?, sell: TextButton? } = { owned = owned, buy = nil, sell = nil }
		if gpu.starter then
			local included = Kit.text(row, "Included", 15, F.medium, C.dim)
			included.AnchorPoint = Vector2.new(1, 0.5)
			included.Position = UDim2.fromScale(1, 0.5)
		else
			local buy = Kit.button(row, `BUY {Format.money(gpu.price)}`, "primary", UDim2.fromOffset(150, 38))
			buy.Name = "Buy"
			buy.AnchorPoint = Vector2.new(1, 0.5)
			buy.Position = UDim2.new(1, -96, 0.5, 0)
			buy.TextSize = 14
			local sell = Kit.button(row, "SELL", "ghost", UDim2.fromOffset(86, 38))
			sell.Name = "Sell"
			sell.AnchorPoint = Vector2.new(1, 0.5)
			sell.Position = UDim2.fromScale(1, 0.5)
			sell.TextSize = 14
			Kit.onClick(buy, function()
				local ok = ActionController.call("BuyGPU", { gpuId = gpu.id })
				if ok then
					Toast.show("success", `{gpu.label} installed in your rack.`)
				end
			end)
			Kit.onClick(sell, function()
				local refund = math.floor(gpu.price * HardwareConfig.SELL_REFUND)
				local ok = ActionController.call("SellGPU", { gpuId = gpu.id })
				if ok then
					Toast.show("info", `Sold {gpu.label} for {Format.money(refund)}.`)
				end
			end)
			refs.buy = buy
			refs.sell = sell
		end
		rowRefs[gpu.id] = refs
	end
	Kit.para(scroll, `Selling refunds {Format.percent(HardwareConfig.SELL_REFUND)} and is locked while a model trains.`, 13, C.dim, 7)

	refresh = function(snapshot: Snapshot)
		local data: any = snapshot.data
		local live: any = snapshot.live
		local e = data.empire
		local fleet = ModelMath.fleet(data.gpus)
		local compute = if typeof(live.compute) == "table" then live.compute else {}
		local ops = if typeof(live.ops) == "table" then live.ops else {}
		local anyLive = false
		for _, id in data.modelOrder do
			local m = data.models[id]
			if m and m.status == "live" then
				anyLive = true
				break
			end
		end

		-- servers: load, waitlist, split
		local sp = ComputeApp.split(data, live)
		local full = if sp.capacity &gt; 0 then sp.load / sp.capacity else 0
		if not anyLive then
			serverTitle.Text = "Servers idle"
			serverText.Text = "No model is live yet. Release one in Models and users start using your GPUs."
			serverTag.Text = "IDLE"
			serverTag.TextColor3 = C.dim
		else
			serverTitle.Text = string.format("Servers %d %% full", math.floor(full * 100 + 0.5))
			local limit = HardwareConfig.thermal(e, fleet.throughput)
			serverText.Text = string.format("%s users online · capacity %s (counted in 500M-model users: bigger models need more compute per user).%s",
				Format.compact(live.users or 0), Format.compact(sp.capacity),
				if limit &lt; 1 then string.format(" Cooling limits the fleet to %.0f of %.0f units.", fleet.throughput * limit, fleet.throughput) else "")
			local over = full &gt; 1
			serverTag.Text = if over then "OVER CAPACITY" elseif full &gt; 0.85 then "NEARLY FULL" else "OK"
			serverTag.TextColor3 = if over then C.bad elseif full &gt; 0.85 then C.warn else C.good
		end
		-- the GPU that adds the most users among those the company can pay now (else the cheapest one)
		local cash = StateController.money()
		local cheapest = math.huge
		for _, gpu in HardwareConfig.GPUS do
			if not gpu.starter then cheapest = math.min(cheapest, gpu.price) end
		end
		local best, bestId = 0, nil :: string?
		for _, gpu in HardwareConfig.GPUS do
			if not gpu.starter and gpu.price &lt;= math.max(cash, cheapest) then
				local extra = ComputeApp.extraUsers(data, gpu.id)
				if extra &gt; best then
					best = extra
					bestId = gpu.id
				end
			end
		end
		waitText.Visible = sp.waitlist &gt; 0
		if sp.waitlist &gt; 0 then
			waitText.Text = if bestId and best &gt;= 1
				then string.format("%s users waiting — buy GPUs. A %s serves %s more.", Format.int(sp.waitlist), gpuLabel(bestId), Format.int(best))
				else string.format("%s users waiting — your cooling is the limit: upgrade cooling first.", Format.int(sp.waitlist))
		end
		splitBar.set({
			{ value = sp.clients, color = colors.clients },
			{ value = sp.serving, color = colors.serving },
			{ value = sp.free, color = colors.free },
			{ value = sp.offline, color = colors.offline },
		}, sp.total)
		local function u(n: number): string
			return string.format("%.1f u", n)
		end
		lClients.Text = "Business clients " .. u(sp.clients)
		lServing.Text = "Users " .. u(sp.serving)
		lFree.Text = "Free " .. u(sp.free)
		lOffline.Text = "Rack faults " .. u(sp.offline)
		offlineChip.Visible = sp.offline &gt; 0
		local share = ComputeApp.trainingShare(data)
		trainText.Text = if (tonumber(compute.reserved) or 0) &gt; 0
			then string.format("Training runs at %d %% speed: business clients reserve %.1f of %.1f compute units (training never drops below 30 %%).", math.floor(share * 100 + 0.5), tonumber(compute.reserved) or 0, fleet.throughput)
			else "Training runs at full speed: no compute is reserved for business clients."

		-- faults (live.compute.faults: slot = blade order, best GPU first; repair FAULT.it s with IT on duty)
		local faults = if typeof(compute.faults) == "table" then compute.faults else {}
		local it = compute.it == true
		local F_ = CompanyOps.FAULT
		local texts: { string } = {}
		for _, f in faults do
			-- the server keeps the exact repair progress; the client counts down from the fault's start (approximate)
			local elapsed = math.max(0, (tonumber(e.seconds) or 0) - (tonumber(f.since) or 0))
			local left = math.max(0, (if it then F_.it else F_.alone) - elapsed)
			local eta = if left &lt;= 0 then "almost fixed" elseif left &lt; 90 then string.format("~%d s", math.ceil(left)) else string.format("~%d min", math.ceil(left / 60))
			table.insert(texts, string.format("Rack R%d fault · %s · %s · %s", tonumber(f.slot) or 0, gpuLabel(tostring(f.gpu)), if it then "IT on the way" else "no IT on duty", eta))
		end
		if #texts == 0 then
			table.insert(texts, "No faults. Every rack runs normally.")
		end
		local labels = {}
		for _, child in faultRows:GetChildren() do
			if child:IsA("TextLabel") then table.insert(labels, child) end
		end
		for i, text in texts do
			local line = labels[i] or Kit.para(faultRows, "", 14, C.bad, i)
			line.Name = "Fault" .. i
			line.LayoutOrder = i
			line.Font = F.medium
			line.Text = text
			line.TextColor3 = if #faults == 0 then C.good else C.bad
		end
		for i = #texts + 1, #labels do
			labels[i]:Destroy()
		end
		faultNote.Text = string.format("A fault takes %d compute unit off line until it is fixed: about %d s while IT is on duty, %d min without (%s). A staffed hardware lab halves the fault rate.",
			F_.units, F_.it, math.floor(F_.alone / 60), if CompanyOps.stageIndex(e) &lt; 2 then "the garage has no IT desk" elseif CompanyOps.stageIndex(e) &gt;= 5 then "IT is also on call at night" else "IT works 08:00–18:00")

		-- running costs: power while serving, serving per model, client serving (live.ops $/min)
		local power = if anyLive then fleet.throughput * SERVE_POWER * CompanyOps.DAY else 0
		local serving = 0
		if typeof(live.perModel) == "table" then
			for _, r in live.perModel do
				serving += (tonumber(r.cost) or 0) * CompanyOps.DAY
			end
		end
		local b2bServe = (tonumber(ops.b2bserveCost) or 0) * CompanyOps.DAY / 60
		costText.Text = string.format("Power while serving %s · serving users %s · serving business clients %s · cooling has no running cost (one-off upgrades below).",
			CompanyOps.money(power), CompanyOps.money(serving), CompanyOps.money(b2bServe))

		-- rack
		local infrastructure = e.infrastructure
		local budget = HardwareConfig.thermal(e, 1e9) * 1e9 -- compute units the cooling keeps at full speed
		thermal.Text = "Cooling level " .. tostring(infrastructure.cooling) .. " / 8 · " .. Format.percent(HardwareConfig.thermal(e, fleet.throughput)) .. " sustained GPU performance · cools up to " .. string.format("%.0f", budget) .. " compute units"
		cooling.Text = "UPGRADE COOLING · " .. Format.money(math.floor(8000 * 1.7 ^ (infrastructure.cooling - 1)))
		Kit.setDisabled(cooling, infrastructure.cooling &gt;= 8 or data.money &lt; math.floor(8000 * 1.7 ^ (infrastructure.cooling - 1)))
		shares.set(tostring(infrastructure.trainingShare))
		mThroughput.value.Text = `{fleet.throughput} u/s`
		mTflops.value.Text = `{Format.compact(fleet.throughput * HardwareConfig.TFLOPS_PER_UNIT, 0)} TFLOPS`
		mVram.value.Text = `{fleet.vram} GB`
		mPower.value.Text = `${string.format("%.1f", fleet.costPerWork)}/unit`

		local slotCount = math.min(MAX_SLOTS, HardwareConfig.slots(e))
		local cols = math.min(12, slotCount)
		local cellH = if slotCount &gt; 24 then 24 else 32
		rackGrid.CellSize = UDim2.new(1 / cols, -6 * (cols - 1) / cols, 0, cellH)
		local broken: { [number]: boolean } = {}
		for _, f in faults do
			broken[tonumber(f.slot) or 0] = true
		end
		-- fill the rack from strong to weak GPUs (like the blades in the data hall: CompanyOps.rack order)
		local filled = 0
		for _, r in CompanyOps.rack(data.gpus) do
			filled += 1
			local slot = slots[filled]
			if slot then
				local def = HardwareConfig.getGPU(r.gpu)
				local shade = TIER_SHADE[r.gpu]
				slot.frame.BackgroundColor3 = if broken[r.slot] then C.bad elseif shade then shade(Theme.accent) else Theme.accent
				slot.label.Text = if broken[r.slot] then "!" elseif def then "T" .. string.sub(def.tier, -1) else ""
			end
		end
		for i = 1, MAX_SLOTS do
			slots[i].frame.Visible = i &lt;= slotCount
			if i &gt; filled then
				slots[i].frame.BackgroundColor3 = C.raised
				slots[i].label.Text = ""
			end
		end
		rackText.Text = `{fleet.slotsUsed}/{HardwareConfig.slots(e)} slots used · {#faults} fault{if #faults == 1 then "" else "s"}`

		local parts: { string } = {}
		for _, size in ModelConfig.SIZES do
			if size.id == "s7b" and not e.research.frontier then
				table.insert(parts, "7B: research required")
			elseif fleet.vram &lt; size.vram then
				table.insert(parts, `{size.label}: needs {size.vram} GB`)
			else
				local plan = ModelMath.plan(size, fleet, { total = math.huge, quality = 0, shares = {} })
				local rate = EmpireMath.trainingRate(data.gpus, plan.work, e)
				table.insert(parts, `{size.label}: {Format.duration(if rate &gt; 0 then plan.work / rate else 0)}`)
			end
		end
		speedText.Text = "Training time: " .. table.concat(parts, " · ")

		local money = StateController.money()
		local rackFull = fleet.slotsUsed &gt;= HardwareConfig.slots(e)
		local training = data.training ~= nil
		for _, gpu in HardwareConfig.GPUS do
			local refs = rowRefs[gpu.id]
			if refs then
				local count = data.gpus[gpu.id] or 0
				local extra = if gpu.starter then 0 else ComputeApp.extraUsers(data, gpu.id)
				refs.owned.Text = if gpu.starter then `Owned: {count}` else `Owned: {count} · one more serves +{Format.compact(extra)} users`
				local buy, sell = refs.buy, refs.sell
				if buy then
					Kit.setDisabled(buy, rackFull or money &lt; gpu.price)
					buy.Text = if rackFull then "RACK FULL" else `BUY {Format.money(gpu.price)}`
				end
				if sell then
					Kit.setDisabled(sell, count &lt;= 0 or training)
				end
			end
		end
	end

	StateController.onChange(function(snapshot: Snapshot)
		if parent.Visible and navigation.isOpen() then
			refresh(snapshot)
		end
	end)
	Theme.onAccent(function()
		local snapshot = StateController.snapshot
		if snapshot and parent.Visible then
			refresh(snapshot)
		end
	end)
end

function ComputeApp.onShow()
	local snapshot = StateController.snapshot
	if snapshot and root then
		refresh(snapshot)
	end
end

return ComputeApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">DataApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Trainingsdaten: Inventar pro Typ, kostenloses Scrapen, Datenmarkt.
-- Jede Paket-Karte zeigt, wie viel Overall das Paket für die im Lab gewählte Größe bringen würde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local DataConfig = require(Shared.Config.DataConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot

local TYPE_COLORS: { [string]: Color3 } = {
	general = Color3.fromRGB(96, 165, 250),
	code = Color3.fromRGB(52, 211, 153),
	math = Color3.fromRGB(251, 191, 36),
}

local DataApp = {}

local root: Frame? = nil
local refresh: (Snapshot) -&gt; () = function(_snapshot: Snapshot) end

local function typeLabel(id: string): string
	for _, dataType in DataConfig.TYPES do
		if dataType.id == id then
			return dataType.label
		end
	end
	return id
end

function DataApp.mount(parent: Frame, navigation: Kit.Nav)
	root = parent

	local scroll = Kit.scroll(parent)
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)

	Kit.heading(scroll, "TRAINING DATA", "More data makes models smarter, better data makes them reliable. Data is not used up by training.", 1)

	-- Inventar
	local inventory = Kit.card(scroll, 2, 10)
	local invHead = Kit.frame(inventory, UDim2.new(1, 0, 0, 20))
	invHead.LayoutOrder = 1
	Kit.caption(invHead, "Your datasets")
	local totalText = Kit.text(invHead, "", 14, F.bold, C.text)
	totalText.AnchorPoint = Vector2.new(1, 0)
	totalText.Position = UDim2.fromScale(1, 0)
	local tiles = Kit.grid(inventory, #DataConfig.TYPES, 86, 10, 2)
	local tileRefs: { [string]: { tokens: TextLabel, bar: Kit.Bar, quality: TextLabel } } = {}
	for index, dataType in DataConfig.TYPES do
		local tile = Kit.frame(tiles)
		tile.LayoutOrder = index
		tile.BackgroundTransparency = 0.3
		tile.BackgroundColor3 = C.bg
		Kit.corner(tile, 10)
		Kit.padding(tile, 10, 12, 10, 12)
		Kit.list(tile, 4)
		local name = Kit.text(tile, dataType.label, 13, F.bold, TYPE_COLORS[dataType.id] or C.muted)
		name.LayoutOrder = 1
		local tokens = Kit.text(tile, "0", 22, F.black, C.text)
		tokens.LayoutOrder = 2
		local bar = Kit.bar(tile, 6, 3, TYPE_COLORS[dataType.id])
		local quality = Kit.text(tile, "", 12, F.medium, C.dim)
		quality.LayoutOrder = 4
		tileRefs[dataType.id] = { tokens = tokens, bar = bar, quality = quality }
	end
	local readiness = Kit.para(inventory, "", 14, C.muted, 3)

	-- Scrapen
	local scrapeCard = Kit.card(scroll, 3, 8)
	local scrapeTitle = Kit.text(scrapeCard, "Scrape the web", 18, F.bold, C.text)
	scrapeTitle.LayoutOrder = 1
	Kit.para(
		scrapeCard,
		`Free, but slow and messy: {Format.tokens(DataConfig.SCRAPE.tokens)} tokens of {typeLabel(DataConfig.SCRAPE.type)} at {Format.percent(DataConfig.SCRAPE.quality)} quality, every {DataConfig.SCRAPE.cooldown}s.`,
		14,
		C.muted,
		2
	)
	local scrapeButton = Kit.button(scrapeCard, "SCRAPE", "secondary", UDim2.fromOffset(200, 42))
	scrapeButton.LayoutOrder = 3
	Kit.onClick(scrapeButton, function()
		local ok = ActionController.call("Scrape", {})
		if ok then
			Toast.show("success", `+{Format.tokens(DataConfig.SCRAPE.tokens)} tokens scraped.`)
		end
	end)

	-- Markt
	local marketCaption = Kit.caption(scroll, "Data market", 4)
	marketCaption.TextSize = 13
	local deltaNote = Kit.para(scroll, "", 13, C.dim, 5)
	local packGrid = Kit.grid(scroll, 2, 148, 12, 6)
	local packRefs: { [string]: { delta: TextLabel, buy: TextButton, buy5: TextButton } } = {}
	for index, pack in DataConfig.PACKS do
		local card = Kit.frame(packGrid)
		card.LayoutOrder = index
		card.BackgroundTransparency = 0.05
		card.BackgroundColor3 = C.panel2
		Kit.corner(card, 12)
		Kit.stroke(card, 0.92)
		Kit.padding(card, 12, 14, 12, 14)

		local name = Kit.text(card, pack.label, 17, F.bold, C.text)
		name.Position = UDim2.new()
		local tag = Kit.tag(card, typeLabel(pack.type), TYPE_COLORS[pack.type] or C.muted)
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.fromScale(1, 0)
		local info = Kit.text(card, `{Format.tokens(pack.tokens)} tokens · quality {Format.percent(pack.quality)}`, 14, F.medium, C.muted)
		info.Position = UDim2.fromOffset(0, 26)
		local delta = Kit.text(card, "", 14, F.bold, C.good)
		delta.Position = UDim2.fromOffset(0, 48)
		local price = Kit.text(card, Format.money(pack.price), 18, F.black, C.text)
		price.AnchorPoint = Vector2.new(0, 1)
		price.Position = UDim2.fromScale(0, 1)
		local buy5 = Kit.button(card, "x5", "ghost", UDim2.fromOffset(52, 36))
		buy5.AnchorPoint = Vector2.new(1, 1)
		buy5.Position = UDim2.fromScale(1, 1)
		buy5.TextSize = 14
		local buy = Kit.button(card, "BUY", "primary", UDim2.fromOffset(86, 36))
		buy.AnchorPoint = Vector2.new(1, 1)
		buy.Position = UDim2.new(1, -60, 1, 0)
		buy.TextSize = 14

		local function purchase(count: number)
			local ok = ActionController.call("BuyData", { packId = pack.id, count = count })
			if ok then
				Toast.show("success", `Bought {count}x {pack.label} (+{Format.tokens(pack.tokens * count)} tokens).`, 2)
			end
		end
		Kit.onClick(buy, function()
			purchase(1)
		end)
		Kit.onClick(buy5, function()
			purchase(5)
		end)
		packRefs[pack.id] = { delta = delta, buy = buy, buy5 = buy5 }
	end

	refresh = function(snapshot: Snapshot)
		local data = snapshot.data
		local summary = ModelMath.dataSummary(data.data)
		totalText.Text = `{Format.tokens(summary.total)} tokens · avg quality {Format.percent(summary.quality)}`
		local largest = 1
		for _, stock in data.data do
			largest = math.max(largest, stock.tokens)
		end
		for id, refs in tileRefs do
			local stock = data.data[id]
			local tokens = if stock then stock.tokens else 0
			refs.tokens.Text = Format.tokens(tokens)
			refs.bar.set(tokens / largest)
			refs.quality.Text = if stock then `quality {Format.percent(stock.quality)}` else "none yet"
		end

		local ui = StateController.ui
		local size = ModelConfig.getSize(ui.sizeId)
		local company = data.company
		local spec = if company then company.spec else "general"
		if size then
			local ready = ModelMath.readiness(size, summary)
			readiness.Text = `Data fill for a {size.label} model: {Format.percent(ready.fill)}`
				.. (if ready.fill &lt; 1 then ` (full at {Format.tokens(size.dataNeed)} tokens)` else " - full! Quality matters most now.")
			deltaNote.Text = `Green numbers: Overall change for your selected {size.label} {string.lower(ui.focusId)} model in the Lab.`
			local baseStats, baseOverall = ModelMath.computeStats(size.id, ui.focusId, summary, spec, 1, nil)
			baseStats, baseOverall = EmpireMath.boostStats(baseStats, data.empire)
			for _, pack in DataConfig.PACKS do
				local refs = packRefs[pack.id]
				if refs then
					local stock = ModelMath.copyStock(data.data)
					ModelMath.addTokens(stock, pack.type, pack.tokens, pack.quality)
					local packStats, withPack = ModelMath.computeStats(size.id, ui.focusId, ModelMath.dataSummary(stock), spec, 1, nil)
					packStats, withPack = EmpireMath.boostStats(packStats, data.empire)
					local diff = withPack - baseOverall
					refs.delta.Text = `{Format.signed(diff)} Overall on {size.label}`
					refs.delta.TextColor3 = if diff &gt; 0.05 then C.good elseif diff &lt; -0.05 then C.bad else C.dim
				end
			end
		end

		local money = StateController.money()
		for _, pack in DataConfig.PACKS do
			local refs = packRefs[pack.id]
			if refs then
				Kit.setDisabled(refs.buy, money &lt; pack.price)
				Kit.setDisabled(refs.buy5, money &lt; pack.price * 5)
			end
		end
	end

	StateController.onChange(function(snapshot: Snapshot)
		if parent.Visible and navigation.isOpen() then
			refresh(snapshot)
		end
	end)
	StateController.onUiChange(function()
		local snapshot = StateController.snapshot
		if snapshot and parent.Visible then
			refresh(snapshot)
		end
	end)

	-- Cooldown-Anzeige läuft unabhängig vom Snapshot-Takt
	RunService.RenderStepped:Connect(function()
		local snapshot = StateController.snapshot
		if not snapshot or not parent.Visible or not navigation.isOpen() then
			return
		end
		local remaining = snapshot.data.lastScrapeAt + DataConfig.SCRAPE.cooldown - workspace:GetServerTimeNow()
		if remaining &gt; 0 then
			scrapeButton.Text = `COOLDOWN {math.ceil(remaining)}s`
			Kit.setDisabled(scrapeButton, true)
		else
			scrapeButton.Text = `SCRAPE (+{Format.tokens(DataConfig.SCRAPE.tokens)})`
			Kit.setDisabled(scrapeButton, false)
		end
	end)
end

function DataApp.onShow()
	local snapshot = StateController.snapshot
	if snapshot and root then
		refresh(snapshot)
	end
end


return DataApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">LabApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Modell-Labor. Vier Ansichten, je nach Zustand:
--   creator  -&gt; Modell entwerfen (Name, Größe, Fokus) mit Live-Schätzung
--   training -&gt; Fortschritt, Loss-Graph, Events mit Entscheidung, Log
--   result   -&gt; Ergebnis mit Stats und Vergleich
--   release  -&gt; Preise, Marketing, Zielgruppe, Prognose, Launch
-- CORE_SPEC 7 (models package): product lines with one live model each (a release into a live line is its
-- next version), refinement count x/3 (the model keeps serving), stat cap 99, Lab level with its price,
-- Recommended price preselected + Auto price, forecast with live rivals (PricingMath = the server's math).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local MarketConfig = require(Shared.Config.MarketConfig)
local ModelMath = require(Shared.ModelMath)
local EmpireMath = require(Shared.EmpireMath)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local MarketMath = require(Shared.MarketMath)
local PricingMath = require(Shared.PricingMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)
local ModelsUI = require(script.Parent.ModelsUI)

local C = Theme.colors
local F = Theme.font
local T = ModelConfig.TRAINING

type Snapshot = Types.Snapshot
type ModelData = Types.ModelData

local NAME_IDEAS = { "Nova", "Atlas", "Echo", "Pulse", "Quill", "Sage", "Orbit", "Flux", "Iris", "Vega", "Lumen", "Spark" }
local CORE_STATS = { "reasoning", "coding", "math", "creativity", "knowledge", "reliability" }
local LOSS_MIN, LOSS_MAX = 0.6, 5.2
local FORECAST_SECONDS = ModelConfig.PRICING.cardSeconds
local STAT_CAP = ModelConfig.STAT_CAP
local MARKETING_TIERS = { 5_000, 10_000, 25_000, 50_000, 100_000, 250_000 }

local LabApp = {}

local nav: Kit.Nav? = nil
local container: Frame? = nil
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local view = "creator"
local resultId: string? = nil
local resultBest: number? = nil
local releaseId: string? = nil
local views: { [string]: GuiObject } = {}
local refreshers: { [string]: (Snapshot) -&gt; () } = {}
local nameBox: TextBox? = nil

---------------------------------------------------------------------------- Helfer

local function statLabel(id: string): string
	for _, stat in ModelConfig.STATS do
		if stat.id == id then
			return stat.label
		end
	end
	return id
end

local function sizeLabel(id: string): string
	local size = ModelConfig.getSize(id)
	return if size then size.label else id
end

local function focusLabel(id: string): string
	local focus = ModelConfig.getFocus(id)
	return if focus then focus.label else id
end

local function modelTitle(model: ModelData): string
	return `{model.name} v{model.version}`
end

local function trim(text: string): string
	return string.match(text, "^%s*(.-)%s*$") or ""
end

local function validName(text: string): boolean
	local length = utf8.len(trim(text))
	return length ~= nil and length &gt;= GameConfig.MODEL_NAME_MIN and length &lt;= GameConfig.MODEL_NAME_MAX
end

local function bestOverall(data: Types.PlayerData, exceptId: string?): number
	local best = 0
	for id, model in data.models do
		if id ~= exceptId and model.status ~= "training" then
			best = math.max(best, model.overall)
		end
	end
	return best
end

local function specOf(data: Types.PlayerData): string
	local company = data.company
	return if company then company.spec else "general"
end

local function decideView(snapshot: Snapshot): string
	local data = snapshot.data
	if data.training then
		return "training"
	end
	local rid = releaseId
	if rid then
		local model: ModelData? = data.models[rid]
		if model and model.status == "trained" then
			return "release"
		end
		releaseId = nil
	end
	local res = resultId
	if res then
		local model: ModelData? = data.models[res]
		if model and model.status ~= "training" then
			return "result"
		end
		resultId = nil
	end
	return "creator"
end

local function render()
	local snapshot = StateController.snapshot
	if not snapshot then
		return
	end
	local nextView = decideView(snapshot)
	if nextView ~= view then
		view = nextView
		for id, frame in views do
			frame.Visible = id == view
		end
	end
	local refresh = refreshers[view]
	if refresh then
		refresh(snapshot)
	end
end

local function header(parent: Instance, captionText: string, order: number): (TextLabel, TextLabel, TextLabel)
	local head = Kit.stack(parent, 2, order)
	local caption = Kit.caption(head, captionText, 1)
	local title = Kit.text(head, "", 24, F.display, C.text)
	title.LayoutOrder = 2
	local sub = Kit.text(head, "", 15, F.medium, C.muted)
	sub.LayoutOrder = 3
	return caption, title, sub
end

local function scrollView(parent: Frame, id: string): ScrollingFrame
	local scroll = Kit.scroll(parent)
	scroll.Name = id
	scroll.Visible = id == view
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)
	views[id] = scroll
	return scroll
end

local function animateNumber(label: TextLabel, target: number)
	task.spawn(function()
		local start = os.clock()
		local duration = 1.1
		while label.Parent do
			local t = math.min(1, (os.clock() - start) / duration)
			local eased = 1 - (1 - t) ^ 3
			label.Text = string.format("%.1f", target * eased)
			if t &gt;= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

---------------------------------------------------------------------------- Creator

local function buildCreator(parent: Frame)
	local scroll = scrollView(parent, "creator")
	Kit.heading(scroll, "MODEL LAB", "Pick a size and a focus, then train on your GPUs. Bigger models need more VRAM and much more data. Each product line runs one live model; a new release into a live line is its next version.", 1)

	local left, right = Kit.columns(scroll, 0.52, 16, 2)

	-- Konfiguration
	local config = Kit.card(left, 1, 10)
	Kit.caption(config, "Model name", 1)
	local box = Kit.input(config, "e.g. Nova")
	box.LayoutOrder = 2
	box.Text = NAME_IDEAS[math.random(1, #NAME_IDEAS)]
	nameBox = box

	local sizeOptions: { Kit.Option } = {}
	for _, size in ModelConfig.SIZES do
		table.insert(sizeOptions, { id = size.id, label = size.label })
	end
	local focusOptions: { Kit.Option } = {}
	for _, focus in ModelConfig.FOCUSES do
		table.insert(focusOptions, { id = focus.id, label = focus.label })
	end

	Kit.caption(config, "Size (parameters)", 3)
	local sizeSeg = Kit.segmented(config, sizeOptions, StateController.ui.sizeId, function(id: string)
		StateController.setSelection(id, StateController.ui.focusId)
		render()
	end)
	sizeSeg.frame.LayoutOrder = 4
	local sizeHint = Kit.para(config, "", 13, C.dim, 5)

	Kit.caption(config, "Training focus", 6)
	local focusSeg = Kit.segmented(config, focusOptions, StateController.ui.focusId, function(id: string)
		StateController.setSelection(StateController.ui.sizeId, id)
		render()
	end)
	focusSeg.frame.LayoutOrder = 7
	local focusHint = Kit.para(config, "", 13, C.dim, 8)

	Kit.caption(config,"Training budget &amp; validation",9)
	local recipeOptions={};for _,recipe in ModelConfig.RECIPES do table.insert(recipeOptions,{id=recipe.id,label=recipe.label}) end
	local recipes=Kit.segmented(config,recipeOptions,StateController.ui.recipeId or "steady",function(id) StateController.setRecipe(id);render() end)
	recipes.frame.LayoutOrder=10
	local recipeHint=Kit.para(config,"",13,C.dim,11)

	-- Produktlinien (CORE_SPEC 7.1): eine Zeile je Linie, welches Modell sie hält, freie Plätze
	local linesCard = Kit.card(left, 2, 8)
	local linesCaption = Kit.caption(linesCard, "Product lines", 1)
	type LineUi = { frame: Frame, detail: TextLabel, tag: TextLabel }
	local lineUi: { [string]: LineUi } = {}
	for index, line in ModelConfig.LINES do
		local row = Kit.frame(linesCard, UDim2.new(1, 0, 0, 46))
		row.LayoutOrder = 1 + index
		row.BackgroundTransparency = 0.3
		row.BackgroundColor3 = C.bg
		Kit.corner(row, 10)
		local name = Kit.text(row, line.label, 15, F.bold, C.text)
		name.Position = UDim2.fromOffset(12, 5)
		local detail = Kit.text(row, "", 13, F.medium, C.muted)
		detail.AutomaticSize = Enum.AutomaticSize.None
		detail.Size = UDim2.new(1, -110, 0, 18)
		detail.Position = UDim2.fromOffset(12, 24)
		detail.TextTruncate = Enum.TextTruncate.AtEnd
		local tag = Kit.tag(row, "free", C.dim)
		tag.AnchorPoint = Vector2.new(1, 0.5)
		tag.Position = UDim2.new(1, -10, 0.5, 0)
		lineUi[line.target] = { frame = row, detail = detail, tag = tag }
	end
	local linesNote = Kit.para(linesCard, "", 13, C.dim, 9)

	-- Fertige, noch nicht veröffentlichte Modelle
	local readyCard = Kit.card(left, 3, 8)
	Kit.caption(readyCard, "Ready to launch", 1)
	local readyList = Kit.stack(readyCard, 8, 2)
	local readyEmpty = Kit.para(readyCard, `Your trained checkpoints appear here. Add 100M fresh tokens to refine a checkpoint with your own GPUs (at most {ModelConfig.REFINE.limit} times per model; every stat caps at {STAT_CAP}).`, 14, C.dim, 3)
	local readyKey = ""

	-- Schätzung
	local est = Kit.card(right, 1, 10)
	Theme.bindAccent(est, "BackgroundColor3", Theme.tint(0.88)) -- Hero-Fläche
	Kit.caption(est, "Expected result", 1)
	local overallRow = Kit.row(est, 58, 14, 2)
	local expected = Kit.text(overallRow, "--", 40, F.display)
	expected.LayoutOrder = 1
	Theme.bindAccent(expected, "TextColor3")
	local info = Kit.frame(overallRow, UDim2.new())
	info.AutomaticSize = Enum.AutomaticSize.XY
	info.LayoutOrder = 2
	Kit.list(info, 2)
	Kit.caption(info, "Overall (estimate)", 1)
	local bestText = Kit.text(info, "", 14, F.medium, C.muted)
	bestText.LayoutOrder = 2

	local rows: { [string]: Kit.StatRow } = {}
	for index, id in CORE_STATS do
		rows[id] = Kit.statRow(est, statLabel(id), 2 + index)
	end
	local capNote = Kit.para(est, "", 12, C.dim, 9)
	Kit.divider(est, 10)
	local metrics = Kit.grid(est, 2, 46, 10, 11)
	local mTime = Kit.metric(metrics, "Training time", 1, 18)
	local mCost = Kit.metric(metrics, "Training cost", 2, 18)
	local mVram = Kit.metric(metrics, "VRAM", 3, 18)
	local mCompute = Kit.metric(metrics, "Compute", 4, 18)
	Kit.caption(est, "Data fill", 12)
	local fillBar = Kit.bar(est, 10, 13)
	local fillText = Kit.para(est, "", 13, C.dim, 14)
	local train = Kit.button(est, "START TRAINING", "primary", UDim2.new(1, 0, 0, 50))
	train.LayoutOrder = 15
	train.TextSize = 17
	Kit.para(est, "1 training slot: one training or refinement runs at a time.", 12, C.dim, 16)

	-- Lab-Level (CORE_SPEC 7.5): nach dem Forschungsbaum, +1 auf jeden Kern-Stat neuer Modelle
	local labCard = Kit.card(right, 2, 8)
	local labTop = Kit.frame(labCard, UDim2.new(1, 0, 0, 28))
	labTop.LayoutOrder = 1
	local labTitle = Kit.text(labTop, "Lab level 0", 20, F.display, C.text)
	labTitle.Position = UDim2.fromOffset(0, 2)
	local labTag = Kit.tag(labTop, "0 / 10", C.muted)
	labTag.AnchorPoint = Vector2.new(1, 0.5)
	labTag.Position = UDim2.new(1, 0, 0.5, 0)
	local labBar = Kit.bar(labCard, 8, 2)
	Kit.para(labCard, `Every level adds +1 to every core stat of the models you train next (stats cap at {STAT_CAP}). Your researchers unlock levels after the whole research tree.`, 13, C.dim, 3)
	local labCost = Kit.para(labCard, "", 14, C.muted, 4)
	local labBuy = Kit.button(labCard, "UPGRADE LAB", "secondary", UDim2.new(1, 0, 0, 42))
	labBuy.LayoutOrder = 5
	local labCanBuy = false

	local action: string? = nil -- "train" | "compute" | "data"

	local function rebuildReady(data: Types.PlayerData)
		local ids: { string } = {}
		for _, id in data.modelOrder do
			local model: ModelData? = data.models[id]
			if model and model.status == "trained" then
				table.insert(ids, id)
			end
		end
		local parts: { string } = {}
		for _, id in ids do
			table.insert(parts, id .. ":" .. tostring(data.models[id].iterations or 0))
		end
		local key = table.concat(parts, ",")
		if key == readyKey then
			return
		end
		readyKey = key
		for _, child in readyList:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for index, id in ids do
			local model = data.models[id]
			local row = Kit.frame(readyList, UDim2.new(1, 0, 0, 56))
			row.LayoutOrder = index
			row.BackgroundTransparency = 0.3
			row.BackgroundColor3 = C.bg
			Kit.corner(row, 10)
			local name = Kit.text(row, modelTitle(model), 16, F.bold, C.text)
			name.Position = UDim2.fromOffset(12, 8)
			name.AutomaticSize = Enum.AutomaticSize.None
			name.Size = UDim2.new(1,-300,0,22)
			name.TextTruncate = Enum.TextTruncate.AtEnd
			local sub = Kit.text(
				row,
				`{sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · Overall {string.format("%.1f", model.overall)} · {ModelsUI.refineText(model)}`,
				13,
				F.medium,
				C.muted
			)
			sub.Position = UDim2.fromOffset(12, 30)
			sub.AutomaticSize = Enum.AutomaticSize.None
			sub.Size = UDim2.new(1,-300,0,18)
			sub.TextTruncate = Enum.TextTruncate.AtEnd
			local runs = math.floor(tonumber(model.iterations) or 0)
			local atLimit = runs &gt;= ModelConfig.REFINE.limit
			local refine = Kit.button(row, if atLimit then "REFINED" else `REFINE {runs + 1}/{ModelConfig.REFINE.limit}`, "secondary", UDim2.fromOffset(110,36))
			refine.AnchorPoint = Vector2.new(1,0.5)
			refine.Position = UDim2.new(1,-125,0.5,0)
			refine.TextSize = 14
			Kit.setDisabled(refine, atLimit)
			Kit.onClick(refine,function() ModelsUI.call("ImproveModel",{modelId=id}) end)
			local button = Kit.button(row, "RELEASE", "primary", UDim2.fromOffset(104, 36))
			button.AnchorPoint = Vector2.new(1, 0.5)
			button.Position = UDim2.new(1, -10, 0.5, 0)
			button.TextSize = 14
			Kit.onClick(button, function()
				releaseId = id
				resultId = nil
				render()
			end)
		end
		readyEmpty.Visible = #ids == 0
	end

	refreshers.creator = function(snapshot: Snapshot)
		local data = snapshot.data
		local ui = StateController.ui
		sizeSeg.set(ui.sizeId)
		focusSeg.set(ui.focusId)
		local size = ModelConfig.getSize(ui.sizeId)
		local focus = ModelConfig.getFocus(ui.focusId)
		if not size or not focus then
			return
		end
		local fleet = ModelMath.fleet(data.gpus)
		local summary = ModelMath.dataSummary(data.data)
		local recipeId=ui.recipeId or "steady"
		recipes.set(recipeId)
		recipeHint.Text=ModelConfig.getRecipe(recipeId).desc
		local plan = ModelMath.plan(size, fleet, summary,recipeId)
		local stats, overall = ModelMath.computeStats(size.id, focus.id, summary, specOf(data), ModelMath.recipeFactor(size,summary,recipeId), nil)
		stats, overall = EmpireMath.boostStats(stats, data.empire)
		stats, overall = ModelMath.capStats(stats)
		plan.rate = EmpireMath.trainingRate(data.gpus, plan.work, data.empire)
		plan.seconds = if plan.rate &gt; 0 then plan.work / plan.rate else 0

		expected.Text = string.format("%.1f", overall)
		local best = bestOverall(data, nil)
		bestText.Text = if best &gt; 0
			then `your best: {string.format("%.1f", best)}  ({Format.signed(overall - best)})`
			else "your first model"
		for id, row in rows do
			row.set(stats[id] or 0, STAT_CAP)
		end
		local level = math.floor(tonumber(data.empire.labLevel) or 0)
		capNote.Text = `Every stat caps at {STAT_CAP}.` .. (if level &gt; 0 then ` Lab level {level} adds +{level} to each.` else "")

		-- product lines
		local lineRows, usedLines, slots = ModelsUI.lines(data)
		local slotText = if slots == math.huge then tostring(usedLines) else `{usedLines} / {slots}`
		linesCaption.Text = `Product lines · {slotText} live at {ModelsUI.officeName(data.empire.office)}`
		for _, lineRow in lineRows do
			local refs = lineUi[lineRow.line.target]
			local model = lineRow.model
			if model then
				refs.detail.Text = `{model.name} v{model.version} · line v{lineRow.version} · Overall {string.format("%.1f", model.overall)} · {ModelsUI.ageText(model)}`
					.. (if lineRow.extra &gt; 0 then ` · +{lineRow.extra} more` else "")
				refs.detail.TextColor3 = C.text
				refs.tag.Text = "LIVE"
				refs.tag.TextColor3 = C.good
			elseif lineRow.open then
				local left = slots - usedLines
				refs.detail.Text = `Free: {left} more line{if left == 1 then "" else "s"} at this office`
				refs.detail.TextColor3 = C.muted
				refs.tag.Text = "FREE"
				refs.tag.TextColor3 = C.muted
			else
				local nextStage = ModelsUI.officeForLines(usedLines)
				refs.detail.Text = if nextStage then `Another line opens with {ModelsUI.officeName(nextStage)}` else "All lines are in use"
				refs.detail.TextColor3 = C.dim
				refs.tag.Text = "LOCKED"
				refs.tag.TextColor3 = C.dim
			end
		end
		linesNote.Text = `One live model per line. A release into a live line is its next version: it takes over {math.floor(ModelConfig.MIGRATE * 100 + 0.5)} % of the users. Models age: up to -8 fit after 3 game days, so ship new versions.`

		-- Lab level
		local lab = ModelsUI.lab(data, StateController.money())
		labTitle.Text = `Lab level {lab.level}`
		labTag.Text = `{lab.level} / {lab.max}`
		labBar.set(lab.level / math.max(1, lab.max))
		labCost.Text = lab.reason
		labCanBuy = lab.canBuy
		labBuy.Text = if lab.level &gt;= lab.max then "LAB AT MAX LEVEL" else `UPGRADE LAB · {Format.int(lab.points)} RP + {Format.money(lab.cash)}`
		Kit.setDisabled(labBuy, not lab.canBuy)

		mTime.value.Text = if plan.rate &gt; 0 then Format.duration(plan.seconds) else "--"
		mCost.value.Text = Format.money(plan.cost)
		mVram.value.Text = `{size.vram} of {fleet.vram} GB`
		mVram.value.TextColor3 = if fleet.vram &gt;= size.vram then C.text else C.bad
		mCompute.value.Text = `{string.format("%g", math.round(fleet.throughput * 10) / 10)} units/s`

		local readiness = ModelMath.readiness(size, summary)
		fillBar.set(readiness.fill)
		fillText.Text = `{Format.tokens(summary.total)} tokens · fill {Format.percent(readiness.fill)} · quality {Format.percent(summary.quality)}`
			.. (if readiness.fill &lt; 1 then "  (more data = smarter model)" else "")

		for _, other in ModelConfig.SIZES do
			sizeSeg.setDim(other.id, fleet.vram &lt; other.vram or (other.id == "s7b" and not data.empire.research.frontier))
		end
		sizeHint.Text = `{size.label} params · needs {size.vram} GB VRAM · full data at {Format.tokens(size.dataNeed)} tokens`
		local parts: { string } = {}
		for _, stat in ModelConfig.STATS do
			local mult = focus.mult[stat.id]
			if mult then
				table.insert(parts, `{stat.label} {Format.signed((mult - 1) * 100, 0)}%`)
			end
		end
		focusHint.Text = if #parts &gt; 0 then table.concat(parts, " · ") else "No bonus, no weakness."

		local nameText = if nameBox then nameBox.Text else ""
		action = nil
		local label: string
		if not validName(nameText) then
			label = `NAME NEEDS {GameConfig.MODEL_NAME_MIN}-{GameConfig.MODEL_NAME_MAX} CHARACTERS`
		elseif plan.reason == "NO_GPU" then
			label = "NO GPU · OPEN COMPUTE"
			action = "compute"
		elseif plan.reason == "VRAM" then
			label = `NEEDS {size.vram-fleet.vram} GB MORE VRAM · OPEN COMPUTE`
			action = "compute"
		elseif plan.reason == "NO_DATA" then
			label = "NEED TRAINING DATA · OPEN DATA"
			action = "data"
		elseif size.id == "s7b" and not data.empire.research.frontier then
			label = "RESEARCH FRONTIER ARCHITECTURE · COMPANY"
			action = "empire"
		elseif StateController.money() &lt; plan.cost then
			label = `NEED {Format.money(plan.cost)}`
		else
			label = `START TRAINING · {Format.money(plan.cost)}`
			action = "train"
		end
		train.Text = label
		Kit.setDisabled(train, action == nil)
		rebuildReady(data)
	end

	Kit.onClick(labBuy, function()
		if not labCanBuy then
			return
		end
		local ok = ModelsUI.call("EmpireAction", { action = "labLevel" })
		if ok then
			Toast.show("success", "Lab upgraded: new models get +1 on every core stat.")
		end
	end)

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if view == "creator" then
			render()
		end
	end)

	Kit.onClick(train, function()
		local currentNav = nav
		if action == "compute" and currentNav then
			currentNav.show("compute")
			return
		elseif action == "data" and currentNav then
			currentNav.show("data")
			return
		elseif action == "empire" and currentNav then
			currentNav.show("empire")
			return
		elseif action ~= "train" then
			return
		end
		local name = trim(box.Text)
		local ui = StateController.ui
		ActionController.call("StartTraining", { name = name, sizeId = ui.sizeId, focusId = ui.focusId, recipeId=ui.recipeId })
		-- Rückmeldung ist die Trainingsansicht selbst, die mit dem nächsten Snapshot erscheint
	end)
end

---------------------------------------------------------------------------- Training

local function buildTraining(parent: Frame)
	local scroll = scrollView(parent, "training")
	local _, title, sub = header(scroll, "Training in progress", 1)

	local progressCard = Kit.card(scroll, 2, 8)
	local progressRow = Kit.frame(progressCard, UDim2.new(1, 0, 0, 30))
	progressRow.LayoutOrder = 1
	local percent = Kit.text(progressRow, "0%", 26, F.black, C.text)
	local eta = Kit.text(progressRow, "", 16, F.bold, C.muted)
	eta.AnchorPoint = Vector2.new(1, 0)
	eta.Position = UDim2.fromScale(1, 0)
	local bar = Kit.bar(progressCard, 14, 2)

	local lossCard = Kit.card(scroll, 3, 8)
	Theme.bindAccent(lossCard, "BackgroundColor3", Theme.tint(0.9)) -- Signatur: der Trainingslauf
	local lossRow = Kit.frame(lossCard, UDim2.new(1, 0, 0, 20))
	lossRow.LayoutOrder = 1
	Kit.caption(lossRow, "Training loss (lower is better)")
	local lossValue = Kit.text(lossRow, "", 16, F.bold, C.text)
	lossValue.AnchorPoint = Vector2.new(1, 0)
	lossValue.Position = UDim2.fromScale(1, 0)
	lossValue.Font = F.display
	local graph = Kit.frame(lossCard, UDim2.new(1, 0, 0, 190))
	graph.LayoutOrder = 2
	graph.BackgroundTransparency = 0.2
	graph.BackgroundColor3 = C.bg
	graph.ClipsDescendants = true
	Kit.corner(graph, 10)
	for i = 1, 3 do
		local line = Kit.frame(graph, UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, i / 4, 0))
		line.BackgroundTransparency = 0.94
		line.BackgroundColor3 = C.line
	end
	local lossBars: { Frame } = {}
	for i = 1, T.lossPoints do
		local b = Kit.frame(graph, UDim2.new(1 / T.lossPoints, -3, 0.02, 0), UDim2.new((i - 1) / T.lossPoints, 1, 1, 0))
		b.AnchorPoint = Vector2.new(0, 1)
		b.BackgroundTransparency = 0.88
		Theme.bindAccent(b, "BackgroundColor3")
		Kit.corner(b, 2)
		local fade = Instance.new("UIGradient") -- Säulen leuchten oben, laufen nach unten aus
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(0, 0.7)
		fade.Parent = b
		lossBars[i] = b
	end

	local metrics = Kit.grid(scroll, 4, 50, 10, 4)
	local mCompute = Kit.metric(metrics, "Compute", 1, 18)
	local mCost = Kit.metric(metrics, "Cost", 2, 18)
	local mData = Kit.metric(metrics, "Data", 3, 18)
	local mQuality = Kit.metric(metrics, "Quality mod", 4, 18)

	-- Entscheidungs-Event
	local eventCard = Kit.card(scroll, 5, 10)
	eventCard.Visible = false
	local eventStroke = eventCard:FindFirstChildOfClass("UIStroke")
	if eventStroke then
		eventStroke.Color = C.warn
		eventStroke.Transparency = 0.3
		eventStroke.Thickness = 2
		local lit = eventStroke:FindFirstChildOfClass("UIGradient") -- Warnrahmen gleichmäßig, ohne Lichtverlauf
		if lit then
			lit:Destroy()
		end
	end
	local eventTitle = Kit.text(eventCard, "", 22, F.black, C.warn)
	eventTitle.LayoutOrder = 1
	local eventText = Kit.para(eventCard, "", 15, C.text, 2)
	local choiceRow = Kit.grid(eventCard, 2, 66, 10, 3)
	local choiceButtons: { TextButton } = {}
	local choiceIds: { string } = {}
	for i = 1, 2 do
		local button = Kit.button(choiceRow, "", if i == 1 then "secondary" else "warn")
		button.LayoutOrder = i
		button.RichText = true
		button.TextWrapped = true
		choiceButtons[i] = button
		choiceIds[i] = ""
		Kit.onClick(button, function()
			local choice = choiceIds[i]
			if choice ~= "" then
				ActionController.call("ResolveEvent", { choice = choice })
			end
		end)
	end
	local countdown = Kit.para(eventCard, "", 13, C.muted, 4)
	local currentEvent = ""
	local defaultLabel = ""

	local logCard = Kit.card(scroll, 6, 4)
	Kit.caption(logCard, "Log", 0)
	local logLabels: { TextLabel } = {}
	for i = 1, T.logLines do
		local line = Kit.text(logCard, "", 13, F.mono, C.muted)
		line.LayoutOrder = i
		logLabels[i] = line
	end

	refreshers.training = function(snapshot: Snapshot)
		local data = snapshot.data
		local training = data.training
		if not training then
			return
		end
		local model: ModelData? = data.models[training.modelId]
		if model then
			title.Text = modelTitle(model)
			if training.refinement then
				local run = math.floor(tonumber(model.iterations) or 0) + 1
				sub.Text = `Refinement {run}/{ModelConfig.REFINE.limit} · {sizeLabel(model.sizeId)} · `
					.. (if model.status == "live" then "keeps serving users with the current version" else `expected overall ~{string.format("%.0f", training.expected)}`)
			else
				sub.Text = `{sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · expected overall ~{string.format("%.0f", training.expected)}`
			end
			mData.value.Text = Format.tokens(model.dataUsed.total)
		end

		local count = #training.loss
		for i, b in lossBars do
			local value = training.loss[i]
			if value then
				local h = math.clamp((value - LOSS_MIN) / (LOSS_MAX - LOSS_MIN), 0.03, 1)
				b.Size = UDim2.new(1 / T.lossPoints, -3, h, 0)
				b.BackgroundTransparency = if i == count then 0 else 0.25
				b.BackgroundColor3 = if i == count then Theme.accent:Lerp(C.white, 0.45) else Theme.accent
			else
				b.Size = UDim2.new(1 / T.lossPoints, -3, 0.02, 0)
				b.BackgroundTransparency = 0.88
				b.BackgroundColor3 = Theme.accent
			end
		end
		lossValue.Text = string.format("%.3f", training.loss[count] or T.lossStart)

		local fleet = ModelMath.fleet(data.gpus)
		mCompute.value.Text = `{fleet.throughput} u/s`
		mCost.value.Text = Format.money(training.cost)
		mQuality.value.Text = string.format("x%.2f", training.qualityMod)
		mQuality.value.TextColor3 = if training.qualityMod &lt; 1
			then C.bad
			elseif training.qualityMod &gt; 1 then C.good
			else C.text

		for i, line in logLabels do
			line.Text = training.log[i] or ""
		end

		local event = training.event
		local def = if event and event.pending then ModelConfig.getEvent(event.id) else nil
		local choices = if def then def.choices else nil
		eventCard.Visible = choices ~= nil
		if def and choices and event and currentEvent ~= event.id then
			currentEvent = event.id
			eventTitle.Text = def.title
			eventText.Text = def.text .. " Training is paused until you decide."
			defaultLabel = ""
			for i, button in choiceButtons do
				local choice = choices[i]
				button.Visible = choice ~= nil
				if choice then
					choiceIds[i] = choice.id
					button.Text = `&lt;b&gt;{Kit.escape(choice.label)}&lt;/b&gt;\n&lt;font size="13"&gt;{Kit.escape(choice.desc)}&lt;/font&gt;`
					if choice.id == def.default then
						defaultLabel = choice.label
					end
				else
					choiceIds[i] = ""
				end
			end
		elseif not choices then
			currentEvent = ""
		end
	end

	RunService.RenderStepped:Connect(function()
		local currentNav = nav
		local snapshot = StateController.snapshot
		if not currentNav or not currentNav.isOpen() or view ~= "training" or not snapshot then
			return
		end
		local training = snapshot.data.training
		if not training then
			return
		end
		local done, total = StateController.trainingWork()
		local fraction = if total &gt; 0 then done / total else 0
		bar.set(fraction)
		percent.Text = Format.percent(fraction)
		local event = training.event
		if event and event.pending then
			eta.Text = "PAUSED"
			eta.TextColor3 = C.warn
			local remaining = math.max(0, event.expiresAt - workspace:GetServerTimeNow())
			countdown.Text = `Auto-picks "{defaultLabel}" in {math.ceil(remaining)}s`
		else
			eta.Text = "ETA " .. Format.duration(StateController.trainingEta())
			eta.TextColor3 = C.muted
		end
	end)
end

---------------------------------------------------------------------------- Result

local function buildResult(parent: Frame)
	local scroll = scrollView(parent, "result")
	local caption, title, sub = header(scroll, "Training complete", 1)
	caption.TextColor3 = C.good

	local scoreCard = Kit.card(scroll, 2, 6)
	Theme.bindAccent(scoreCard, "BackgroundColor3", Theme.tint(0.88))
	local scoreRow = Kit.row(scoreCard, 84, 18, 1)
	local score = Kit.text(scoreRow, "0.0", 64, F.display)
	score.LayoutOrder = 1
	Theme.bindAccent(score, "TextColor3")
	local scoreInfo = Kit.frame(scoreRow, UDim2.new())
	scoreInfo.AutomaticSize = Enum.AutomaticSize.XY
	scoreInfo.LayoutOrder = 2
	Kit.list(scoreInfo, 4)
	Kit.caption(scoreInfo, "Overall score", 1)
	local delta = Kit.text(scoreInfo, "", 18, F.bold, C.good)
	delta.LayoutOrder = 2
	local rankText = Kit.para(scoreCard, "", 14, C.muted, 2)

	local statsCard = Kit.card(scroll, 3, 8)
	Kit.caption(statsCard, "Benchmarks", 0)
	local rows: { [string]: Kit.StatRow } = {}
	for index, stat in ModelConfig.STATS do
		rows[stat.id] = Kit.statRow(statsCard, stat.label, index)
	end

	local buttons = Kit.row(scroll, 50, 10, 4)
	local release = Kit.button(buttons, "RELEASE", "primary", UDim2.fromOffset(190, 48))
	release.LayoutOrder = 1
	local retrain = Kit.button(buttons, "REFINE", "secondary", UDim2.fromOffset(160, 48))
	retrain.LayoutOrder = 2
	local later = Kit.button(buttons, "LATER", "ghost", UDim2.fromOffset(110, 48))
	later.LayoutOrder = 3

	local animatedFor: string? = nil

	refreshers.result = function(snapshot: Snapshot)
		local id = resultId
		local model: ModelData? = if id then snapshot.data.models[id] else nil
		if not model or not id then
			return
		end
		title.Text = modelTitle(model)
		sub.Text = `{sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · cost {Format.money(model.trainCost)}`
		if animatedFor ~= id then
			animatedFor = id
			animateNumber(score, model.overall)
		end
		local best = resultBest or bestOverall(snapshot.data, id)
		if best &lt;= 0 then
			delta.Text = "Your first model!"
			delta.TextColor3 = C.good
		else
			local diff = model.overall - best
			delta.Text = `{Format.signed(diff)} vs your best ({string.format("%.1f", best)})`
			delta.TextColor3 = if diff &gt;= 0 then C.good else C.bad
		end
		for statId, row in rows do
			row.set(model.stats[statId] or 0, if (statId == "speed" or statId == "efficiency") then 100 else STAT_CAP)
		end
		local runs = math.floor(tonumber(model.iterations) or 0)
		retrain.Text = if runs &gt;= ModelConfig.REFINE.limit then "REFINED 3/3" else `REFINE {runs + 1}/{ModelConfig.REFINE.limit}`
		Kit.setDisabled(retrain, runs &gt;= ModelConfig.REFINE.limit)
		release.Visible = model.status == "trained"

		-- Marktvergleich nach Overall: live Rivalen (NPC-Labore + andere Firmen aus dem Marktplatz) + eigene Live-Modelle
		local better, total = 0, 1
		local strongestName, strongest = "", 0
		local marketplace: any = snapshot.live.marketplace
		local npcList: { any } = if marketplace then {} else MarketConfig.NPC_MODELS
		for _, npc in npcList do
			local overall = ModelMath.overall(npc.stats)
			total += 1
			if overall &gt; model.overall then
				better += 1
			end
			if overall &gt; strongest then
				strongest = overall
				strongestName = `{npc.company} {npc.name}`
			end
		end
		for _, other in snapshot.data.models do
			if other.status == "live" and other.id ~= id then
				total += 1
				if other.overall &gt; model.overall then
					better += 1
				end
			end
		end
		for _, other in (snapshot.live.marketplace and snapshot.live.marketplace.offers) or {} do
			if not snapshot.data.models[other.id] then
				total += 1
				if other.overall &gt; model.overall then better += 1 end
				if other.overall &gt; strongest then strongest=other.overall; strongestName=other.company.." / "..other.name end
			end
		end
		rankText.Text = `Market check: would rank #{better + 1} of {total} by overall. `
			.. (if model.overall &gt;= strongest
				then "That beats every rival model!"
				else `Strongest rival: {strongestName} ({string.format("%.1f", strongest)}).`)
	end

	Kit.onClick(release, function()
		releaseId = resultId
		resultId = nil
		render()
	end)
	Kit.onClick(retrain, function()
		if resultId then
			local ok=ModelsUI.call("ImproveModel",{modelId=resultId})
			if ok then resultId=nil; render() end
		end
	end)
	Kit.onClick(later, function()
		resultId = nil
		render()
	end)
end

---------------------------------------------------------------------------- Release

local function playLaunch(modelName: string)
	local parent = container
	if not parent then
		return
	end
	local overlay = Kit.blocker(parent, C.bg, 1)
	overlay.ZIndex = 40
	Kit.tween(overlay, 0.2, { BackgroundTransparency = 0.06 })
	local big = Kit.text(overlay, "3", 120, F.black, C.text)
	big.AnchorPoint = Vector2.new(0.5, 0.5)
	big.Position = UDim2.fromScale(0.5, 0.45)
	big.ZIndex = 41
	local scale = Instance.new("UIScale")
	scale.Parent = big
	local subLabel = Kit.text(overlay, "", 20, F.medium, C.muted)
	subLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	subLabel.Position = UDim2.fromScale(0.5, 0.64)
	subLabel.ZIndex = 41

	task.spawn(function()
		for _, step in { "3", "2", "1" } do
			big.Text = step
			scale.Scale = 1.5
			Kit.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			task.wait(0.6)
		end
		big.Text = "MODEL LIVE"
		big.TextSize = 84
		big.TextColor3 = Theme.accent
		scale.Scale = 0.6
		Kit.tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		subLabel.Text = `{modelName} is now serving users`
		task.wait(1.6)
		Kit.tween(overlay, 0.3, { BackgroundTransparency = 1 })
		Kit.tween(big, 0.3, { TextTransparency = 1 })
		Kit.tween(subLabel, 0.3, { TextTransparency = 1 })
		task.wait(0.32)
		overlay:Destroy()
		local currentNav = nav
		if currentNav then
			currentNav.show("market")
		end
	end)
end

local function buildRelease(parent: Frame)
	local scroll = scrollView(parent, "release")
	local _, title, sub = header(scroll, "Launch", 1)
	local left, right = Kit.columns(scroll, 0.55, 16, 2)

	local subPrice = 5
	local apiPrice = MarketConfig.API_PRICE.default
	local marketing = 0
	local target = "general"
	local autoMode = true -- Auto price: the server sets the Recommended price now and re-checks it every 5 min
	local manualTouched = false
	local configuredFor: string? = nil
	local updateForecast: () -&gt; () = function() end
	local requestRecommendation: () -&gt; () = function() end
	local rec: PricingMath.Choice? = nil
	local recKey = ""
	local recGen = 0

	-- Produktlinie (CORE_SPEC 7.1/7.2)
	local lineCard = Kit.card(left, 1, 10)
	Kit.caption(lineCard, "Product line", 1)
	local lineOptions: { Kit.Option } = {}
	for _, line in ModelConfig.LINES do
		table.insert(lineOptions, { id = line.target, label = line.short })
	end
	local lineSeg = Kit.segmented(lineCard, lineOptions, target, function(id: string)
		target = id
		requestRecommendation()
		updateForecast()
	end)
	lineSeg.frame.LayoutOrder = 2
	local lineInfo = Kit.para(lineCard, "", 14, C.text, 3)
	Kit.para(lineCard, "Marketing hits the line's own audience hardest. In the other segments a model is offered too, but clearly weaker than a specialist.", 13, C.dim, 4)

	-- Preis
	local pricing = Kit.card(left, 2, 10)
	Kit.caption(pricing, "Price", 1)
	local subSeg: Kit.Segmented
	local apiSlider: Kit.Slider
	local function paintControls()
		subSeg.set(tostring(subPrice))
		apiSlider.set(apiPrice)
		for _, price in MarketConfig.SUB_PRICES do
			subSeg.setDim(tostring(price), autoMode and price ~= subPrice)
		end
	end
	local modeSeg = Kit.segmented(pricing, {
		{ id = "auto", label = "Auto price" },
		{ id = "manual", label = "Manual" },
	}, "auto", function(id: string)
		autoMode = id == "auto"
		if autoMode and rec then
			subPrice, apiPrice = rec.sub, rec.api
		end
		paintControls()
		updateForecast()
	end)
	modeSeg.frame.LayoutOrder = 2
	local recText = Kit.para(pricing, "", 14, C.text, 3)
	local function toManual()
		manualTouched = true
		if autoMode then
			autoMode = false
			modeSeg.set("manual")
		end
	end

	Kit.caption(pricing, "Subscription (per month = 3 game days)", 4)
	local subOptions: { Kit.Option } = {}
	for _, price in MarketConfig.SUB_PRICES do
		table.insert(subOptions, { id = tostring(price), label = if price == 0 then "Free" else `${price}` })
	end
	subSeg = Kit.segmented(pricing, subOptions, tostring(subPrice), function(id: string)
		toManual()
		subPrice = tonumber(id) or 0
		paintControls()
		updateForecast()
	end)
	subSeg.frame.LayoutOrder = 5
	Kit.para(pricing, "Consumer Chat and Study App users pay a monthly subscription.", 13, C.dim, 6)

	local apiRow = Kit.frame(pricing, UDim2.new(1, 0, 0, 18))
	apiRow.LayoutOrder = 7
	Kit.caption(apiRow, "API price (per 1M tokens)")
	local apiValue = Kit.text(apiRow, "", 16, F.bold, C.text)
	apiValue.AnchorPoint = Vector2.new(1, 0)
	apiValue.Position = UDim2.fromScale(1, 0)
	apiSlider = Kit.slider(
		pricing,
		MarketConfig.API_PRICE.min,
		MarketConfig.API_PRICE.max,
		MarketConfig.API_PRICE.step,
		apiPrice,
		function(value: number)
			toManual()
			apiPrice = value
			updateForecast()
		end
	)
	apiSlider.frame.LayoutOrder = 8
	Kit.para(pricing, "Developer API and Business API customers pay per token. Serving costs you money per token too.", 13, C.dim, 9)

	local mktRow = Kit.frame(pricing, UDim2.new(1, 0, 0, 18))
	mktRow.LayoutOrder = 10
	Kit.caption(mktRow, "Marketing budget")
	local mktValue = Kit.text(mktRow, "", 16, F.bold, C.text)
	mktValue.AnchorPoint = Vector2.new(1, 0)
	mktValue.Position = UDim2.fromScale(1, 0)
	local mktSlider = Kit.slider(pricing, 0, MarketConfig.MARKETING.max, MarketConfig.MARKETING.step, 0, function(value: number)
		marketing = value
		requestRecommendation()
		updateForecast()
	end)
	mktSlider.frame.LayoutOrder = 11
	Kit.para(pricing, "Hype at launch. Fades over about 10 minutes, word of mouth stays.", 13, C.dim, 12)
	local modeNote = Kit.para(pricing, "", 12, C.dim, 13)

	-- rechts: Passung und Prognose
	local fitCard = Kit.card(right, 1, 8)
	Kit.caption(fitCard, "Audience fit (what each group values)", 0)
	local fitRows: { [string]: Kit.StatRow } = {}
	for index, segment in MarketConfig.SEGMENTS do
		fitRows[segment.id] = Kit.statRow(fitCard, segment.label, index)
	end

	local forecastCard = Kit.card(right, 2, 10)
	Kit.caption(forecastCard, "Forecast after 5 minutes", 0)
	local forecastGrid = Kit.grid(forecastCard, 2, 46, 10, 1)
	local fUsers = Kit.metric(forecastGrid, "Users", 1, 20)
	local fNet = Kit.metric(forecastGrid, "Net income", 2, 20)
	local fRevenue = Kit.metric(forecastGrid, "Revenue", 3, 16)
	local fServing = Kit.metric(forecastGrid, "Serving cost", 4, 16)
	local fCompany = Kit.para(forecastCard, "", 13, C.muted, 2)
	local fServers = Kit.para(forecastCard, "", 13, C.dim, 3)
	Kit.para(forecastCard, "Live rivals and your other lines are simulated with the real market rules. Real numbers move with reputation and the market cycle.", 12, C.dim, 4)

	local launch = Kit.button(right, "LAUNCH", "primary", UDim2.new(1, 0, 0, 52))
	launch.LayoutOrder = 3
	launch.TextSize = 17
	local back = Kit.button(right, "BACK", "ghost", UDim2.new(1, 0, 0, 40))
	back.LayoutOrder = 4

	-- Recommended price on the client: the same forecast the server runs at launch, spread over frames
	requestRecommendation = function()
		local snapshot = StateController.snapshot
		local id = releaseId
		local model: ModelData? = if snapshot and id then snapshot.data.models[id] else nil
		if not snapshot or not model or not id then
			return
		end
		local key = `{id}|{target}|{marketing}|{snapshot.data.empire.office}`
		if key == recKey then
			return
		end
		recKey = key
		recGen += 1
		local gen = recGen
		rec = nil
		local forModel: ModelData = model
		local forTarget, forMarketing = target, marketing
		task.spawn(function()
			local ok, choice = pcall(function(): PricingMath.Choice
				local ctx = ModelsUI.context(snapshot)
				-- one frame of work at most PRICING.clientBudget of CPU, then yield; a newer request cancels this one
				return PricingMath.recommend(ctx, snapshot.data, forModel, forTarget, forMarketing, PricingMath.slicer(ModelConfig.PRICING.clientBudget, function()
					task.wait()
					if gen ~= recGen then
						error("stale", 0)
					end
				end))
			end)
			if not ok or gen ~= recGen then
				return
			end
			rec = choice
			if autoMode or not manualTouched then
				subPrice, apiPrice = choice.sub, choice.api
				paintControls()
			end
			updateForecast()
		end)
	end

	updateForecast = function()
		local snapshot = StateController.snapshot
		local id = releaseId
		local model: ModelData? = if snapshot and id then snapshot.data.models[id] else nil
		if not snapshot or not model or not id then
			return
		end
		local data = snapshot.data
		apiValue.Text = Format.price(apiPrice)
		mktValue.Text = Format.money(marketing)
		local money = StateController.money()
		mktValue.TextColor3 = if marketing &gt; money then C.bad else C.text

		-- line: successor, free slot or LINE_LIMIT
		local check = ModelMath.releaseCheck(data, id, target)
		local lineName = ModelsUI.lineLabel(target)
		local predecessor = check.replaced[1]
		if predecessor then
			local users = 0
			for _, old in check.replaced do
				local market = old.market
				if market then
					for _, n in market.users do
						users += n
					end
				end
			end
			lineInfo.Text = `{lineName}: successor of {predecessor.name} v{predecessor.version}. Becomes version {ModelMath.lineVersion(data, predecessor.id) + 1} of the line and takes over {math.floor(ModelConfig.MIGRATE * 100 + 0.5)} % of its {Format.compact(users)} users; {predecessor.name} v{predecessor.version} retires.`
			lineInfo.TextColor3 = C.text
		elseif check.ok then
			local slots = if check.slots == math.huge then "" else ` ({check.usedLines + 1} of {check.slots} lines)`
			lineInfo.Text = `{lineName}: a new product line{slots}.`
			lineInfo.TextColor3 = C.text
		else
			lineInfo.Text = `All {check.slots} product lines of {ModelsUI.officeName(data.empire.office)} are live. Pick a live line to release a new version there, or move to a bigger office for another line.`
			lineInfo.TextColor3 = C.warn
		end

		-- price mode texts
		if rec then
			recText.Text = `Recommended: {ModelsUI.priceText(rec.sub, rec.api)}. Best company profit over the next 30 minutes in the forecast.`
		else
			recText.Text = "Calculating the Recommended price from the live market..."
		end
		modeNote.Text = if autoMode
			then "Auto price: the server sets the Recommended price at launch and re-checks it every 5 minutes. Any manual price switches it off for this model."
			else "Manual price: auto price stays off for this model until you switch it on again in the Market app."

		-- 5-minute forecast of this model with live rivals, capacity and your other lines
		local ctx = ModelsUI.context(snapshot)
		local candidate: PricingMath.Entry = {
			id = id,
			stats = model.stats,
			sizeId = model.sizeId,
			subPrice = subPrice,
			apiPrice = apiPrice,
			market = PricingMath.releaseMarket(target, marketing, check.replaced),
			target = target,
		}
		local _, result, last = PricingMath.profit(ctx, candidate, FORECAST_SECONDS)
		local bonuses = EmpireMath.bonuses(data.empire)
		local cycle = EmpireConfig.cycle(snapshot.serverTime)
		local revenue = result.revenue * bonuses.revenue * cycle.revenue
		local cost = result.cost * bonuses.serving * cycle.cost
		fUsers.value.Text = Format.compact(result.users)
		fRevenue.value.Text = Format.money(revenue * Format.DAY_SECONDS) .. "/day"
		fServing.value.Text = Format.money(cost * Format.DAY_SECONDS) .. "/day"
		fNet.value.Text = Format.perDay(revenue - cost)
		fNet.value.TextColor3 = if revenue &gt;= cost then C.good else C.bad
		fCompany.Text = if rec then `With the Recommended price your company earns about {Format.money(rec.profit)} in the next 30 minutes.` else ""
		local serving = ModelsUI.serving(last)
		fServers.Text = if serving.known and (serving.full &gt;= 0.85 or serving.waitlist &gt;= 1)
			then `After launch: {serving.text}.`
			else ""

		if not check.ok then
			launch.Text = "NO FREE PRODUCT LINE"
			Kit.setDisabled(launch, true)
		elseif marketing &gt; money then
			launch.Text = "NOT ENOUGH MONEY FOR THIS BUDGET"
			Kit.setDisabled(launch, true)
		else
			local line = ModelConfig.getLine(target)
			local short = string.upper(if line then line.short else lineName)
			local what = if predecessor then `NEW VERSION · {short}` else `LAUNCH {short}`
			launch.Text = what .. (if marketing &gt; 0 then ` · {Format.money(marketing)} MARKETING` else "")
			Kit.setDisabled(launch, false)
		end
	end

	refreshers.release = function(snapshot: Snapshot)
		local id = releaseId
		local model: ModelData? = if id then snapshot.data.models[id] else nil
		if not model or not id then
			return
		end
		local data = snapshot.data
		title.Text = modelTitle(model)
		sub.Text = `Overall {string.format("%.1f", model.overall)} · {sizeLabel(model.sizeId)} · {focusLabel(model.focusId)} · {ModelsUI.refineText(model)}`

		local money = StateController.money()
		local step = MarketConfig.MARKETING.step
		local affordable = math.max(0, math.min(MarketConfig.MARKETING.max, math.floor(money / step) * step))

		local fits: { { target: string, fit: number } } = {}
		for _, segment in MarketConfig.SEGMENTS do
			local fit = MarketMath.fit(model.stats, segment)
			local row = fitRows[segment.id]
			if row then
				row.set(fit)
			end
			for _, line in ModelConfig.LINES do
				if ModelMath.lineOf(line.target) == segment.id then
					table.insert(fits, { target = line.target, fit = fit })
				end
			end
		end

		if configuredFor ~= id then
			configuredFor = id
			autoMode = true
			manualTouched = false
			modeSeg.set("auto")
			subPrice = 5
			apiPrice = MarketConfig.API_PRICE.default
			marketing = PricingMath.recommendedMarketing(money, EmpireMath.bonuses(data.empire).wage)
			-- best-fitting line that this office allows (a live line = new version, else a free slot)
			table.sort(fits, function(a, b): boolean
				return a.fit &gt; b.fit
			end)
			target = fits[1] and fits[1].target or "general"
			for _, option in fits do
				if ModelMath.releaseCheck(data, id, option.target).ok then
					target = option.target
					break
				end
			end
			lineSeg.set(target)
			paintControls()
		end
		for _, line in ModelConfig.LINES do
			lineSeg.setDim(line.target, not ModelMath.releaseCheck(data, id, line.target).ok)
		end
		-- Regler-Bereich in festen Stufen über dem verfügbaren Geld: fein genug am Anfang,
		-- springt aber nicht bei jedem Einnahmen-Tick
		local range = MARKETING_TIERS[#MARKETING_TIERS]
		for _, tier in MARKETING_TIERS do
			if tier &gt;= affordable then
				range = tier
				break
			end
		end
		mktSlider.setRange(0, range)
		mktSlider.set(marketing)
		marketing = mktSlider.get()
		requestRecommendation()
		updateForecast()
	end

	Kit.onClick(launch, function()
		local id = releaseId
		local snapshot = StateController.snapshot
		local model: ModelData? = if snapshot and id then snapshot.data.models[id] else nil
		if not model or not id then
			return
		end
		local payload: { [string]: any } = { modelId = id, target = target, marketing = marketing, auto = autoMode }
		if not autoMode then
			payload.subPrice = subPrice
			payload.apiPrice = apiPrice
		end
		local ok = ModelsUI.call("ReleaseModel", payload)
		if ok then
			releaseId = nil
			configuredFor = nil
			recKey = ""
			playLaunch(modelTitle(model))
			render()
		end
	end)
	Kit.onClick(back, function()
		releaseId = nil
		render()
	end)
end

---------------------------------------------------------------------------- Einstieg

function LabApp.mount(parent: Frame, navigation: Kit.Nav)
	container = parent
	nav = navigation
	buildCreator(parent)
	buildTraining(parent)
	buildResult(parent)
	buildRelease(parent)

	StateController.onChange(function(_snapshot)
		if parent.Visible and navigation.isOpen() then
			render()
		end
	end)
	StateController.onUiChange(function()
		if parent.Visible and view == "creator" then
			render()
		end
	end)
	StateController.onNotify(function(kind: string, payload: { [string]: any })
		if kind == "TRAINING_COMPLETE" then
			resultId = if typeof(payload.modelId) == "string" then payload.modelId else nil
			resultBest = if typeof(payload.previousBest) == "number" then payload.previousBest else nil
			releaseId = nil
			if navigation.isOpen() then
				navigation.show("lab")
			end
		elseif kind == "TRAINING_EVENT" then
			if navigation.isOpen() then
				navigation.show("lab")
			end
		end
	end)
end

function LabApp.onShow()
	render()
end

-- Von außen (HUD "Launch ..."): direkt die Release-Ansicht eines fertigen Modells öffnen
function LabApp.openRelease(modelId: string)
	releaseId = modelId
	resultId = nil
	render()
end

function LabApp.openSection(section: string)
 local snapshot=StateController.snapshot;if not snapshot then return end
 if section=="evaluation" then
  local model=Journey.latest(snapshot.data)
  if model then resultId=model.id;releaseId=nil;render();task.spawn(function()ActionController.call("EvaluateModel",{modelId=model.id})end)
  else Toast.show("info","Train a model first. Its real benchmark scores will appear here.") end
 elseif section=="release" then
  local model=Journey.latest(snapshot.data,true)
  if model then LabApp.openRelease(model.id) else Toast.show("info","No unreleased trained model yet. Train and evaluate a checkpoint first.") end
 end
end
return LabApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">MarketApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Markt: Gesamtzahlen, eigene Live-Modelle (Preise ändern, zurückziehen), Rangliste gegen NPCs.
-- CORE_SPEC 7 (models package): serving capacity / waitlist (live.capacity/load/waitlist), product lines with
-- the model that holds each line and the slots of the office, per model: line version, age, refinements x/3
-- (the model keeps serving while refining), Auto price toggle with the last automatic price change.
-- Money is shown per game day (CORE_SPEC 6: 1 day = 1200 s; prices per month = 3 game days).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local MarketConfig = require(Shared.Config.MarketConfig)
local CompanyConfig = require(Shared.Config.CompanyConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local ModelMath = require(Shared.ModelMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)
local ModelsUI = require(script.Parent.ModelsUI)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot
type ModelData = Types.ModelData

type Card = {
	frame: Frame,
	users: Kit.Metric,
	revenue: Kit.Metric,
	serving: Kit.Metric,
	net: Kit.Metric,
	overall: TextLabel,
	segments: TextLabel,
	lineInfo: TextLabel,
	modeSeg: Kit.Segmented,
	priceNote: TextLabel,
	subSeg: Kit.Segmented,
	apiValue: TextLabel,
	apiLocal: number,
	touchedAt: number,
	refine: TextButton,
}

type LineUi = { detail: TextLabel, tag: TextLabel }

type Row = {
	frame: Frame,
	rank: TextLabel,
	dot: Frame,
	name: TextLabel,
	company: TextLabel,
	overall: TextLabel,
	users: TextLabel,
	price: TextLabel,
}

type Entry = {
	name: string,
	company: string,
	overall: number,
	users: number,
	sub: number,
	api: number,
	color: Color3,
	mine: boolean,
}

local API_STEP = 0.5

local MarketApp = {}

local root: Frame? = nil
local refresh: (Snapshot) -&gt; () = function(_snapshot: Snapshot) end

local function sizeLabel(id: string): string
	local size = ModelConfig.getSize(id)
	return if size then size.label else id
end

local function priceText(sub: number, api: number): string
	return (if sub == 0 then "Free" else `${sub}/mo`) .. ` · {Format.price(api)}`
end

local function nextRank(peak: number): string
	for _, rank in CompanyConfig.RANKS do
		if rank.minUsers &gt; peak then
			return `Next: {rank.name} at {Format.compact(rank.minUsers)} peak users`
		end
	end
	return "Top rank reached"
end

function MarketApp.mount(parent: Frame, navigation: Kit.Nav)
	root = parent

	local scroll = Kit.scroll(parent)
	Kit.padding(scroll, 2, 14, 20, 2)
	Kit.list(scroll, 14)

	Kit.heading(scroll, "MARKET", "A shared market for this server: your models, the AI labs and other companies compete for users in four product lines. Prices are per month (1 month = 3 game days = 1 hour); money is shown per game day.", 1)

	-- Kennzahlen
	local summary = Kit.stack(scroll, 10, 2) -- Kennzahlen ohne Karte: reine Information
	local grid = Kit.grid(summary, 3, 48, 12, 1)
	local mUsers = Kit.metric(grid, "Users", 1, 22)
	local mNet = Kit.metric(grid, "Net income", 2, 22)
	local mRep = Kit.metric(grid, "Reputation", 3, 22)
	local mRevenue = Kit.metric(grid, "Revenue", 4, 16)
	local mServing = Kit.metric(grid, "Serving cost", 5, 16)
	local mRank = Kit.metric(grid, "Rank", 6, 16)
	local rankNote = Kit.para(summary, "", 13, C.dim, 2)

	-- Serverkapazität (CORE_SPEC 3.1): Nutzer über der Kapazität warten
	local servingRow = Kit.stack(summary, 6, 3)
	local servingTop = Kit.frame(servingRow, UDim2.new(1, 0, 0, 20))
	servingTop.LayoutOrder = 1
	Kit.caption(servingTop, "Serving capacity")
	local servingValue = Kit.text(servingTop, "", 14, F.bold, C.text)
	servingValue.AnchorPoint = Vector2.new(1, 0)
	servingValue.Position = UDim2.fromScale(1, 0)
	local servingBar = Kit.bar(servingRow, 8, 2)
	local servingNote = Kit.para(servingRow, "", 13, C.dim, 3)

	-- Produktlinien (CORE_SPEC 7.1): welches Modell welche Linie hält, freie Plätze der Bürostufe
	local linesCard = Kit.card(scroll, 2, 8)
	local linesCaption = Kit.caption(linesCard, "Product lines", 1)
	local lineUi: { [string]: LineUi } = {}
	for index, line in ModelConfig.LINES do
		local row = Kit.frame(linesCard, UDim2.new(1, 0, 0, 44))
		row.LayoutOrder = 1 + index
		row.BackgroundTransparency = 0.3
		row.BackgroundColor3 = C.bg
		Kit.corner(row, 10)
		local name = Kit.text(row, line.label, 15, F.bold, C.text)
		name.Position = UDim2.fromOffset(12, 4)
		local detail = Kit.text(row, "", 13, F.medium, C.muted)
		detail.AutomaticSize = Enum.AutomaticSize.None
		detail.Size = UDim2.new(1, -100, 0, 18)
		detail.Position = UDim2.fromOffset(12, 23)
		detail.TextTruncate = Enum.TextTruncate.AtEnd
		local tag = Kit.tag(row, "free", C.dim)
		tag.AnchorPoint = Vector2.new(1, 0.5)
		tag.Position = UDim2.new(1, -10, 0.5, 0)
		lineUi[line.target] = { detail = detail, tag = tag }
	end
	local linesNote = Kit.para(linesCard, "", 13, C.dim, 9)

	local accessCard = Kit.card(scroll, 3, 10)
	Kit.caption(accessCard, "Your API subscription", 1)
	local accessInfo = Kit.para(accessCard, "", 14, C.muted, 2)
	local cancelAccess = Kit.button(accessCard, "STOP AUTO-RENEW", "secondary", UDim2.fromOffset(190,34))
	cancelAccess.LayoutOrder = 3
	Kit.onClick(cancelAccess,function() ActionController.call("CancelModelAccess",{}) end)
	Kit.para(accessCard,"API access adds research points while active. You keep training your own model. The provider receives your payment; access never copies their model or leaderboard score.",13,C.dim,4)
	Kit.caption(scroll,"Provider exchange · player companies",4)
	local exchange = Kit.stack(scroll,10,5)
	local providerRows: {[string]:any} = {}
	local providerKey = ""
	local customerCard = Kit.card(scroll,6,10)
	Kit.caption(customerCard,"Business clients · receipts",1)
	local businessInfo = Kit.para(customerCard,"",14,C.muted,2)
	local businessRows = {}
	for i=1,12 do
		businessRows[i]=Kit.para(customerCard,"",13,C.muted,i+2)
	end
	local ledger = Kit.para(customerCard,"",13,C.dim,15)

	-- Eigene Live-Modelle
	Kit.caption(scroll, "Your live models", 7)
	local cardList = Kit.stack(scroll, 12, 8)
	local emptyNote = Kit.para(scroll, "No live models yet. Train one in the Lab and launch it.", 14, C.dim, 9)
	local cards: { [string]: Card } = {}
	local cardKey = ""

	-- Rangliste
	Kit.caption(scroll, "Intelligence leaderboard · live models", 10)
	local board = Kit.card(scroll, 11, 2)
	local headerRow = Kit.frame(board, UDim2.new(1, 0, 0, 22))
	headerRow.LayoutOrder = 0
	local function headerCell(text: string, width: UDim, x: UDim, right: boolean?)
		local label = Kit.cell(headerRow, string.upper(text), width, 11, F.bold, C.dim)
		label.Position = UDim2.new(x, UDim.new(0, 0))
		if right then
			label.TextXAlignment = Enum.TextXAlignment.Right
		end
	end
	headerCell("#", UDim.new(0, 30), UDim.new(0, 0))
	headerCell("Model", UDim.new(0.34, -40), UDim.new(0, 40))
	headerCell("Company", UDim.new(0.26, 0), UDim.new(0.34, 10))
	headerCell("Overall", UDim.new(0, 64), UDim.new(0.6, 10), true)
	headerCell("Users", UDim.new(0, 80), UDim.new(0.6, 84), true)
	headerCell("Price", UDim.new(0.4, -184), UDim.new(0.6, 174), true)
	local rows: { Row } = {}

	local function makeRow(index: number): Row
		local frame = Kit.frame(board, UDim2.new(1, 0, 0, 34))
		frame.LayoutOrder = index
		frame.BackgroundColor3 = Theme.accent
		frame.BackgroundTransparency = 1
		Kit.corner(frame, 8)
		local rank = Kit.cell(frame, "", UDim.new(0, 30), 15, F.bold, C.dim)
		local dot = Kit.dot(frame, C.dim, 10)
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.new(0, 34, 0.5, 0)
		local name = Kit.cell(frame, "", UDim.new(0.34, -52), 15, F.bold, C.text)
		name.Position = UDim2.fromOffset(52, 0)
		local company = Kit.cell(frame, "", UDim.new(0.26, 0), 14, F.medium, C.muted)
		company.Position = UDim2.new(0.34, 10, 0, 0)
		local overall = Kit.cell(frame, "", UDim.new(0, 64), 15, F.bold, C.text)
		overall.Position = UDim2.new(0.6, 10, 0, 0)
		overall.TextXAlignment = Enum.TextXAlignment.Right
		local users = Kit.cell(frame, "", UDim.new(0, 80), 15, F.bold, C.text)
		users.Position = UDim2.new(0.6, 84, 0, 0)
		users.TextXAlignment = Enum.TextXAlignment.Right
		local price = Kit.cell(frame, "", UDim.new(0.4, -184), 13, F.medium, C.muted)
		price.Position = UDim2.new(0.6, 174, 0, 0)
		price.TextXAlignment = Enum.TextXAlignment.Right
		return {
			frame = frame,
			rank = rank,
			dot = dot,
			name = name,
			company = company,
			overall = overall,
			users = users,
			price = price,
		}
	end

	local function buildCard(order: number, model: ModelData): Card
		local frame = Kit.card(cardList, order, 10)
		local top = Kit.frame(frame, UDim2.new(1, 0, 0, 26))
		top.LayoutOrder = 1
		local titleRow = Kit.frame(top, UDim2.new(1, -140, 1, 0))
		Kit.list(titleRow, 8, true)
		local name = Kit.text(titleRow, `{model.name} v{model.version}`, 19, F.bold, C.text)
		name.LayoutOrder = 1
		Kit.tag(titleRow, sizeLabel(model.sizeId), C.muted, 2)
		Kit.tag(titleRow, ModelsUI.lineLabel(model.release and model.release.target), Theme.accent, 3)
		Kit.tag(titleRow, "LIVE", C.good, 4)
		local overall = Kit.text(top, "", 15, F.bold, C.muted)
		overall.AnchorPoint = Vector2.new(1, 0.5)
		overall.Position = UDim2.fromScale(1, 0.5)

		local metrics = Kit.grid(frame, 4, 44, 10, 2)
		local users = Kit.metric(metrics, "Users", 1, 18)
		local revenue = Kit.metric(metrics, "Revenue", 2, 18)
		local serving = Kit.metric(metrics, "Serving", 3, 18)
		local net = Kit.metric(metrics, "Net", 4, 18)
		local segments = Kit.para(frame, "", 13, C.dim, 3)
		local lineInfo = Kit.para(frame, "", 13, C.muted, 4)

		-- Preismodus (CORE_SPEC 7.7): Auto price hält den Empfohlenen Preis, jede manuelle Änderung schaltet ihn ab
		local modeRow = Kit.frame(frame, UDim2.new(1, 0, 0, 36))
		modeRow.LayoutOrder = 5
		local card: Card
		local modeSeg = Kit.segmented(modeRow, {
			{ id = "auto", label = "Auto price" },
			{ id = "manual", label = "Manual" },
		}, if model.release and (model.release :: any).auto == false then "manual" else "auto", function(id: string)
			card.touchedAt = os.clock()
			ModelsUI.setAutoPrice(model.id, id == "auto")
		end, 34)
		modeSeg.frame.Size = UDim2.fromOffset(230, 34)
		local priceNote = Kit.text(modeRow, "", 13, F.medium, C.dim)
		priceNote.AutomaticSize = Enum.AutomaticSize.None
		priceNote.Size = UDim2.new(1, -244, 1, 0)
		priceNote.Position = UDim2.fromOffset(244, 0)
		priceNote.TextWrapped = true
		priceNote.TextTruncate = Enum.TextTruncate.AtEnd

		local controls = Kit.frame(frame, UDim2.new(1, 0, 0, 38))
		controls.LayoutOrder = 6
		local subCaption = Kit.caption(controls, "Sub")
		subCaption.Position = UDim2.new(0, 0, 0.5, 0)
		subCaption.AnchorPoint = Vector2.new(0, 0.5)
		local options: { Kit.Option } = {}
		for _, price in MarketConfig.SUB_PRICES do
			table.insert(options, { id = tostring(price), label = if price == 0 then "Free" else `${price}` })
		end
		local release = model.release
		local subSeg = Kit.segmented(controls, options, tostring(if release then release.subPrice else 0), function(id: string)
			card.touchedAt = os.clock()
			modeSeg.set("manual") -- a manual price switches auto-price off for this model
			ActionController.call("UpdatePricing", {
				modelId = model.id,
				subPrice = tonumber(id) or 0,
				apiPrice = card.apiLocal,
			})
		end, 36)
		subSeg.frame.Size = UDim2.fromOffset(230, 36)
		subSeg.frame.Position = UDim2.fromOffset(38, 1)

		local apiCaption = Kit.caption(controls, "API")
		apiCaption.Position = UDim2.new(0, 284, 0.5, 0)
		apiCaption.AnchorPoint = Vector2.new(0, 0.5)
		local minus = Kit.button(controls, "-", "secondary", UDim2.fromOffset(34, 34))
		minus.Position = UDim2.fromOffset(316, 2)
		local apiValue = Kit.text(controls, "", 15, F.bold, C.text)
		apiValue.AutomaticSize = Enum.AutomaticSize.None
		apiValue.Size = UDim2.fromOffset(64, 38)
		apiValue.Position = UDim2.fromOffset(354, 0)
		apiValue.TextXAlignment = Enum.TextXAlignment.Center
		local plus = Kit.button(controls, "+", "secondary", UDim2.fromOffset(34, 34))
		plus.Position = UDim2.fromOffset(422, 2)
		local retire = Kit.button(controls, "RETIRE", "danger", UDim2.fromOffset(110, 34))
		retire.AnchorPoint = Vector2.new(1, 0)
		retire.Position = UDim2.new(1, 0, 0, 2)
		retire.TextSize = 13

		local refineRow = Kit.row(frame, 34, 10, 7)
		local refine = Kit.button(refineRow, "REFINE CHECKPOINT", "secondary", UDim2.fromOffset(190, 32))
		Kit.onClick(refine, function()
			ModelsUI.call("ImproveModel", { modelId = model.id })
		end)
		Kit.para(frame, `Add 100M new tokens, then refine with your GPUs: the model keeps serving with the current version meanwhile. At most {ModelConfig.REFINE.limit} refinements per model, each costs 50 % more; every stat stays at most {ModelConfig.STAT_CAP}.`, 13, C.dim, 8)

		card = {
			frame = frame,
			users = users,
			revenue = revenue,
			serving = serving,
			net = net,
			overall = overall,
			segments = segments,
			lineInfo = lineInfo,
			modeSeg = modeSeg,
			priceNote = priceNote,
			subSeg = subSeg,
			apiValue = apiValue,
			apiLocal = if release then release.apiPrice else MarketConfig.API_PRICE.default,
			touchedAt = 0,
			refine = refine,
		}

		local function stepApi(direction: number)
			local P = MarketConfig.API_PRICE
			local value = math.clamp(math.round((card.apiLocal + direction * API_STEP) * 100) / 100, P.min, P.max)
			if value == card.apiLocal then
				return
			end
			card.apiLocal = value
			card.touchedAt = os.clock()
			modeSeg.set("manual")
			apiValue.Text = Format.price(value)
			ActionController.call("UpdatePricing", {
				modelId = model.id,
				subPrice = tonumber(subSeg.get()) or 0,
				apiPrice = value,
			})
		end
		Kit.onClick(minus, function()
			stepApi(-1)
		end)
		Kit.onClick(plus, function()
			stepApi(1)
		end)

		local armedAt = 0
		Kit.onClick(retire, function()
			if os.clock() - armedAt &gt; 3 then
				armedAt = os.clock()
				retire.Text = "CONFIRM?"
				task.delay(3, function()
					if retire.Parent then
						retire.Text = "RETIRE"
					end
				end)
				return
			end
			armedAt = 0
			local ok = ActionController.call("RetireModel", { modelId = model.id })
			if ok then
				Toast.show("info", `{model.name} v{model.version} was retired.`)
			end
		end)
		return card
	end

	refresh = function(snapshot: Snapshot)
		local data = snapshot.data
		local live = snapshot.live
		local company = data.company

		mUsers.value.Text = Format.compact(live.users)
		mNet.value.Text = Format.perDay(live.revenue - live.cost)
		mNet.value.TextColor3 = if live.revenue &gt;= live.cost then C.good else C.bad
		mRevenue.value.Text = Format.money(live.revenue * Format.DAY_SECONDS) .. "/day"
		mServing.value.Text = Format.money(live.cost * Format.DAY_SECONDS) .. "/day"
		mRep.value.Text = if company then string.format("%.1f", company.reputation) else "0"
		mRank.value.Text = CompanyConfig.rankFor(data.stats.peakUsers)
		rankNote.Text = `Peak users: {Format.compact(data.stats.peakUsers)} · {nextRank(data.stats.peakUsers)}`

		-- serving capacity and waitlist ("12,400 waiting — buy GPUs")
		local serving = ModelsUI.serving(live)
		servingRow.Visible = serving.known
		if serving.known then
			servingValue.Text = if serving.waitlist &gt;= 1 then `{Format.int(serving.waitlist)} waiting` else Format.percent(math.min(serving.full, 9.99)) .. " full"
			servingValue.TextColor3 = if serving.waitlist &gt;= 1 then C.bad elseif serving.full &gt;= 0.85 then C.warn else C.text
			servingBar.set(serving.full)
			servingNote.Text = `{serving.text} · capacity {Format.compact(serving.capacity)} users (500M-model equivalents), demand {Format.compact(serving.load)}`
			servingNote.TextColor3 = if serving.waitlist &gt;= 1 then C.warn else C.dim
		end

		-- product lines
		local lineRows, usedLines, slots = ModelsUI.lines(data)
		local slotText = if slots == math.huge then tostring(usedLines) else `{usedLines} / {slots}`
		linesCaption.Text = `Product lines · {slotText} live at {ModelsUI.officeName(data.empire.office)}`
		for _, lineRow in lineRows do
			local refs = lineUi[lineRow.line.target]
			local model = lineRow.model
			if model then
				refs.detail.Text = `{model.name} v{model.version} · line v{lineRow.version} · Overall {string.format("%.1f", model.overall)} · {ModelsUI.ageText(model)} · {ModelsUI.refineText(model)}`
					.. (if lineRow.extra &gt; 0 then ` · +{lineRow.extra} more` else "")
				refs.detail.TextColor3 = C.text
				refs.tag.Text = "LIVE"
				refs.tag.TextColor3 = C.good
			elseif lineRow.open then
				local left = slots - usedLines
				refs.detail.Text = `Free: {left} more line{if left == 1 then "" else "s"} at this office · launch a model here from the Lab`
				refs.detail.TextColor3 = C.muted
				refs.tag.Text = "FREE"
				refs.tag.TextColor3 = C.muted
			else
				local nextStage = ModelsUI.officeForLines(usedLines)
				refs.detail.Text = if nextStage then `Opens with {ModelsUI.officeName(nextStage)}` else "All lines are in use"
				refs.detail.TextColor3 = C.dim
				refs.tag.Text = "LOCKED"
				refs.tag.TextColor3 = C.dim
			end
		end
		linesNote.Text = `One live model per line. A new release into a live line replaces it and takes over {math.floor(ModelConfig.MIGRATE * 100 + 0.5)} % of its users. Models age (up to -8 fit after 3 game days), so ship new versions.`

		local subscription=data.empire.subscriptions
		local active=typeof(subscription.expires)=="number" and subscription.expires&gt;os.time()
		accessInfo.Text=if active then subscription.provider .. " / " .. subscription.name .. " · " .. Format.money(subscription.price) .. "/month · " .. Format.duration(subscription.expires-os.time()) .. " left · " .. (if subscription.autoRenew then "Auto-renew ON" else "One month, no automatic renewal") else "No active provider. Choose a player offer below."
		cancelAccess.Visible=active and subscription.autoRenew==true
		local market=live.marketplace or {offers={},customers={}}
		local ids={}
		for _,offer in market.offers do table.insert(ids,tostring(offer.providerId)..":"..offer.id) end
		local newKey=table.concat(ids,",")
		if newKey~=providerKey then
			providerKey=newKey
			for _,refs in providerRows do refs.frame:Destroy() end
			table.clear(providerRows)
			for index,offer in market.offers do
				local key=tostring(offer.providerId)..":"..offer.id
				local card=Kit.card(exchange,index,10)
				local title=Kit.text(card,offer.company.." / "..offer.name,17,F.bold,C.text)
				title.LayoutOrder=1
				local detail=Kit.para(card,"",13,C.muted,2)
				local actions=Kit.row(card,34,10,3)
				local purchase=Kit.button(actions,"BUY ONE MONTH","primary",UDim2.fromOffset(175,32))
				local renew=Kit.button(actions,"SUBSCRIBE + AUTO-RENEW","secondary",UDim2.fromOffset(235,32))
				renew.LayoutOrder=2
				local refs={frame=card,detail=detail,purchase=purchase,renew=renew,offer=offer}
				providerRows[key]=refs
				local function buyAccess(auto: boolean)
					local current=refs.offer
					ActionController.call("BuyModelAccess",{providerId=current.providerId,modelId=current.id,quotedPrice=current.price,autoRenew=auto})
				end
				Kit.onClick(purchase,function() buyAccess(false) end)
				Kit.onClick(renew,function() buyAccess(true) end)
			end
		end
		for _,offer in market.offers do
			local refs=providerRows[tostring(offer.providerId)..":"..offer.id]
			if refs then
				refs.offer=offer
				local mine=data.models[offer.id]~=nil
				refs.detail.Text=string.format("%.1f intelligence pts · %d refinements · %s / game month%s",offer.overall,offer.iterations,Format.money(offer.price),if mine then " · Your model" else "")
				Kit.setDisabled(refs.purchase,mine or active or data.money&lt;offer.price)
				Kit.setDisabled(refs.renew,mine or active or data.money&lt;offer.price)
			end
		end
		businessInfo.Text=ModelsUI.businessText(data)
		for index,label in businessRows do
			local customer=market.customers[index]
			label.Visible=customer~=nil
			if customer then
				label.Text=customer.name.." · "..customer.stat.." ≥ "..tostring(customer.minimum).." · "..customer.provider.." · "..(if customer.price&gt;0 then Format.money(customer.price).."/month, renews in "..Format.duration(customer.remaining) else "Budget "..Format.money(customer.budget).."/month")
			end
		end
		local receipts={}
		for i=1,math.min(4,#data.empire.invoices) do
			local bill=data.empire.invoices[i]
			table.insert(receipts,bill.text.." · "..Format.money(bill.amount))
		end
		ledger.Text=if #receipts&gt;0 then table.concat(receipts,"\n") else "No API access receipts yet."

		-- Karten neu aufbauen, wenn sich die Menge der Live-Modelle ändert
		local liveIds: { string } = {}
		for _, id in data.modelOrder do
			local model: ModelData? = data.models[id]
			if model and model.status == "live" then
				table.insert(liveIds, id)
			end
		end
		local key = table.concat(liveIds, ",")
		if key ~= cardKey then
			cardKey = key
			for _, card in cards do
				card.frame:Destroy()
			end
			table.clear(cards)
			for index, id in liveIds do
				cards[id] = buildCard(index, data.models[id])
			end
		end
		emptyNote.Visible = #liveIds == 0

		for id, card in cards do
			local model: ModelData? = data.models[id]
			local release = if model then model.release else nil
			local result = live.perModel[id]
			if model and release then
				card.overall.Text = `Overall {string.format("%.1f", model.overall)} / {ModelConfig.STAT_CAP}`
				local users = if result then result.users else 0
				local revenue = if result then result.revenue else 0
				local cost = if result then result.cost else 0
				card.users.value.Text = Format.compact(users)
				card.revenue.value.Text = Format.money(revenue * Format.DAY_SECONDS) .. "/day"
				card.serving.value.Text = Format.money(cost * Format.DAY_SECONDS) .. "/day"
				card.net.value.Text = Format.money((revenue - cost) * Format.DAY_SECONDS) .. "/day"
				card.net.value.TextColor3 = if revenue &gt;= cost then C.good else C.bad
				local market = model.market
				local parts: { string } = {}
				for _, segment in MarketConfig.SEGMENTS do
					local count = if market then market.users[segment.id] or 0 else 0
					table.insert(parts, `{segment.label} {Format.compact(count)}`)
				end
				card.segments.Text = table.concat(parts, " · ")
				local predecessor = ModelsUI.predecessor(data, model.id)
				card.lineInfo.Text = `{ModelsUI.lineLabel(release.target)} · line v{ModelMath.lineVersion(data, model.id)}`
					.. (if predecessor then ` (successor of {predecessor.name} v{predecessor.version})` else "")
					.. ` · {ModelsUI.ageText(model)} · {ModelsUI.refineText(model)}`
				local auto = (release :: any).auto ~= false
				-- kurz nach eigener Änderung nicht vom (evtl. älteren) Snapshot überschreiben lassen
				if os.clock() - card.touchedAt &gt; 1.5 then
					card.subSeg.set(tostring(release.subPrice))
					card.apiLocal = release.apiPrice
					card.modeSeg.set(if auto then "auto" else "manual")
				end
				card.apiValue.Text = Format.price(card.apiLocal)
				card.priceNote.Text = ModelsUI.autoPriceText(live, model)
				local runs = math.floor(tonumber(model.iterations) or 0)
				local refining = data.training ~= nil and data.training.modelId == id
				card.refine.Text = if refining then "REFINING…" elseif runs &gt;= ModelConfig.REFINE.limit then `REFINED {runs}/{ModelConfig.REFINE.limit}` else `REFINE {runs + 1}/{ModelConfig.REFINE.limit}`
				Kit.setDisabled(card.refine, refining or runs &gt;= ModelConfig.REFINE.limit or data.training ~= nil)
			end
		end

		-- Rangliste
		local entries: { Entry } = {}
		local npcList: { any } = if live.marketplace then {} else MarketConfig.NPC_MODELS
		for _, npc in npcList do
			table.insert(entries, {
				name = npc.name,
				company = npc.company,
				overall = ModelMath.overall(npc.stats),
				users = live.npcUsers[npc.id] or 0,
				sub = npc.subPrice,
				api = npc.apiPrice,
				color = Theme.rgb(npc.rgb),
				mine = false,
			})
		end
		for _, id in liveIds do
			local model = data.models[id]
			local release = model.release
			local result = live.perModel[id]
			table.insert(entries, {
				name = `{model.name} v{model.version}`,
				company = if company then company.name else "You",
				overall = model.overall,
				users = if result then result.users else 0,
				sub = if release then release.subPrice else 0,
				api = if release then release.apiPrice else 0,
				color = Theme.accent,
				mine = true,
			})
		end
		for _,offer in market.offers do
			if not data.models[offer.id] then
				table.insert(entries,{name=offer.name,company=offer.company,overall=offer.overall,users=offer.users,sub=offer.sub,api=offer.api,color=C.muted,mine=false})
			end
		end
		table.sort(entries, function(a: Entry, b: Entry): boolean
			if a.overall == b.overall then return a.company &lt; b.company end
			return a.overall &gt; b.overall
		end)
		while #rows &lt; #entries do
			table.insert(rows, makeRow(#rows + 1))
		end
		for index, row in rows do
			local entry = entries[index]
			row.frame.Visible = entry ~= nil
			if entry then
				row.rank.Text = tostring(index)
				row.dot.BackgroundColor3 = entry.color
				row.name.Text = entry.name
				row.name.TextColor3 = if entry.mine then Theme.accent else C.text
				row.company.Text = entry.company
				row.overall.Text = string.format("%.1f", entry.overall)
				row.users.Text = Format.compact(entry.users)
				row.price.Text = priceText(entry.sub, entry.api)
				row.frame.BackgroundColor3 = Theme.accent
				row.frame.BackgroundTransparency = if entry.mine then 0.88 else 1
			end
		end
	end

	StateController.onChange(function(snapshot: Snapshot)
		if parent.Visible and navigation.isOpen() then
			refresh(snapshot)
		end
	end)
end

function MarketApp.onShow()
	local snapshot = StateController.snapshot
	if snapshot and root then
		refresh(snapshot)
	end
end

return MarketApp
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000026"><Properties><string name="Name">CampusApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local Math=require(ReplicatedStorage.Shared.EmpireMath)
local Format=require(ReplicatedStorage.Shared.Format)
local Ops=require(ReplicatedStorage.Shared.CompanyOps)
local UI=script.Parent.Parent
local State=require(UI.Parent.Controllers.StateController)
local Action=require(UI.Parent.Controllers.ActionController)
local Theme=require(UI.Theme)
local Kit=require(UI.Kit)
local Toast=require(UI.Toast)
local Security=require(UI.Parent.Controllers.SecurityController)
local C,F=Theme.colors,Theme.font
local App={}
local watchers={}
local scroll: ScrollingFrame?=nil
local navigator: any=nil
local current="building"
local function watch(fn: (any)-&gt;())table.insert(watchers,fn);if State.snapshot then fn(State.snapshot) end end
local function title(p: Instance,text: string)local t=Kit.para(p,text,19,C.text,1);t.Font=F.bold;return t end
local function para(p: Instance,text: string,order: number?)return Kit.para(p,text,14,C.muted,order or 2)end
local function call(name: string,p: any,message: string)
	task.spawn(function()local ok=Action.call(name,p);if ok then Toast.show("success",message) end end)
end
local function button(p: Instance,text: string,fn: ()-&gt;(),order: number?)
	local b=Kit.button(p,text,"primary",UDim2.new(1,0,0,40));b.LayoutOrder=order or 5;Kit.onClick(b,fn);return b
end
-- Building texts are generated from the shared BuildingPlan, so they always describe the
-- headquarters this tier actually builds (levels, pavilion, founder services, roof, garage).
local function names(tier: number,keep: (any)-&gt;boolean): string
	local list={}
	for _,r in Plan.rooms(tier) do if not r.hidden and keep(r) and not table.find(list,r.name) then table.insert(list,r.name) end end
	return table.concat(list,", ")
end
local function directory(tier: number): string
	if tier&lt;1 then return Plan.floorTitle(tier,0) end -- the Garage Lab: one level, no roof terrace, no B1
	local lines={}
	for level=Plan.roofLevel(tier),-1,-1 do table.insert(lines,Plan.floorTitle(tier,level)) end
	return table.concat(lines,"\n")
end
local GETTING_AROUND="The automatic doors in the front portal open for everyone into the double-height reception hall. Visitors need no card for the hall, the café, the showroom and the visitor lounge. Badge speed gates at the back of the hall lead into the staff atrium; walk straight through it to the lift lobby. The lift stops at every level from B1 to the roof: call it at a landing, step inside and choose your floor on the cabin panel.\nThe stairs are right of the lift (as you face it), the restrooms left of it. Every lift lobby has a floor directory; nameplates beside each door show who may enter.\nTeam areas need a company or guest card, labs and technical rooms are reserved for their staff, and founder rooms open only for you."
local GETTING_AROUND_GARAGE="The Garage Lab has one level and no lift: the shared lab with 5 team desks, the glazed founder corner, your assistant's desk by the door, a WC and the porch where applicants wait. Your car is parked in front of the garage. The fenced site around it is where your first headquarters will stand: sign your first business client and save the price, then move up from the Office tab."
local SHARED_FOUNDER_FLOOR={boardroom=true,meeting=true,hr=true,lounge=true,team=true}
-- office index (stage 1..5) -&gt; the building's plan tier (0 = Garage Lab)
local function tierOf(s: any): number return Plan.tierForOffice(s.data.empire.office) end
local function building(p: Instance)
	local hero=Kit.card(p,1);local heading=title(hero,"Your headquarters");local info=para(hero,"")
	watch(function(s)
		local e=s.data.empire;heading.Text=EmpireConfig.OFFICES[e.office].name
		if tierOf(s)&lt;1 then
			info.Text=string.format("Stage %d of %d · the converted garage: 5 team desks, the founder corner and a %d-blade GPU shelf\n%d / %d specialists · no operations staff yet (the founder orders pizza)\nNext: %s for %s once your first business client has signed",e.office,#EmpireConfig.OFFICES,Plan.GARAGE_STAGE.blades,Math.staff(e),EmpireConfig.OFFICES[e.office].staff,EmpireConfig.OFFICES[e.office+1].name,Format.money(EmpireConfig.OFFICES[e.office+1].price))
		else
			info.Text=string.format("Stage %d of %d · %d storeys + garage level B1 + roof terrace · 164 × 208 studs incl. the rear pavilion\n%d / %d specialists + %d operations staff (reception, security, café, facilities, IT, fleet)\nPublic reception hall, café and showroom · badge speed gates to the staff atrium · lift from B1 to the roof",e.office,#EmpireConfig.OFFICES,Plan.floors(tierOf(s)),Math.staff(e),EmpireConfig.OFFICES[e.office].staff,Ops.opsPosts(e))
		end
	end)
	local map=Kit.card(p,2);title(map,"Building directory");local levels=para(map,"")
	watch(function(s)levels.Text=directory(tierOf(s))end)
	local directions=Kit.card(p,3);title(directions,"Getting around");local directionsText=para(directions,GETTING_AROUND)
	watch(function(s)directionsText.Text=if tierOf(s)&lt;1 then GETTING_AROUND_GARAGE else GETTING_AROUND end)
	local pavilion=Kit.card(p,4);title(pavilion,"Wellness pavilion");local wellnessRooms=para(pavilion,"")
	watch(function(s)wellnessRooms.Text="Behind the main building on G, through the Wellness Corridor at the back of the ground floor: "..names(tierOf(s),function(r)return r.pavilion==true and r.level==0 and r.kind~="pavilion_corridor" end)..". Open to your team and guest card holders."end)
	local services=Kit.card(p,5);title(services,"Founder services");local serviceRooms=para(services,"")
	watch(function(s)serviceRooms.Text="Above the wellness pavilion on level 1, behind two secure doors that open only for your founder card: "..names(tierOf(s),function(r)return r.pavilion==true and r.level==1 and r.kind~="pavilion_corridor" end)..". The Prototype Lab has no sign; look for the flush panel in the corridor. One archive shelf is not what it seems."end)
	local top=Kit.card(p,6);title(top,"Founder floor &amp; roof terrace");local topRooms=para(top,"")
	watch(function(s)
		local tier=tierOf(s);local founder=Plan.founderLevel(tier)
		topRooms.Text=string.format("Level %s · founder only: %s.\nLevel %s · shared with your team: %s and the Executive Terrace in front of the setback.\nRoof (%s): %s with lounge seating, reached by lift and stairs. The pavilion roof garden opens from both corridor ends on level 2.",
			Plan.levelLabel(tier,founder),names(tier,function(r)return r.level==founder and r.access=="founder" end),
			Plan.levelLabel(tier,founder),names(tier,function(r)return r.level==founder and r.access~="founder" and SHARED_FOUNDER_FLOOR[r.kind]==true end),
			Plan.levelLabel(tier,Plan.roofLevel(tier)),names(tier,function(r)return r.level==Plan.roofLevel(tier) and r.kind=="roof_terrace" end))
	end)
	local garage=Kit.card(p,7);title(garage,"B1 · Garage &amp; Data Hall");local garageRooms=para(garage,"")
	watch(function(s)garageRooms.Text="Underground below the main building, reached by lift, stairs or the driveable ramp from the street: "..names(tierOf(s),function(r)return r.level==-1 and r.kind~="stair" and r.kind~="liftpit" and r.kind~="service_passage" and r.kind~="spine" end)..". The Data Hall is the company data centre and open to compute engineers only. Collect your company car at the fleet office or from the Fleet tab."end)
	local staff=Kit.card(p,8);title(staff,"A team that has a day")
	para(staff,"Each specialist has a personal workstation, role and schedule. Employees walk through doors, ride the lift, use seats, meet colleagues and take staggered coffee, lunch and lounge breaks. Data, research, training and growth bonuses use the same working team. Founder rooms remain private.")
	local security=Kit.card(p,9);title(security,"Founder camera control")
	para(security,"Live views of your own headquarters, grouped by level: reception hall, atrium, work floors, café, Compute Operations, Data Hall, garage, wellness pavilion, founder rooms and roof. Restrooms, showers, the sauna and your private bathroom never have cameras. The Campus Security room in the founder services wing opens the same live views.")
	button(security,"Open live campus cameras",Security.open)
	local wellness=Kit.card(p,10);title(wellness,"Use the rooms")
	para(wellness,"Treadmills and bikes: stay nearby for an 18-second session. Sauna: relax near the heater for 12 seconds. Completed sessions give a short walking boost. Toilets have usable seats, occupied cubicles and flush buttons. Taps and showers run water and switch off automatically. Chairs and benches are real seats.")
	-- the Garage Lab (plan tier 0) has no pavilion, founder floor, roof terrace, B1 garage or wellness rooms
	watch(function(s)
		local hq=tierOf(s)&gt;=1
		for _,card in {pavilion,services,top,garage,wellness} do card.Visible=hq end
	end)
end
local function access(p: Instance)
	local card=Kit.card(p,1);title(card,"Your employee card");local status=para(card,"")
	watch(function(s)status.Text=if s.live.campus and s.live.campus.hasCard then "Card active · as founder, every door of your headquarters opens for you" else "Your card is missing. Print a replacement below." end)
	button(card,"Print replacement card",function()call("ReplaceCard",{},"New card added to your backpack.")end)
	local help=Kit.card(p,2);title(help,"Invite someone to visit")
	para(help,"Visitors need no card for the reception hall, café, showroom and visitor lounge. Give another player a guest card for one hour to open the speed gates and team areas too: atrium, work floors, wellness pavilion and roof terrace. Technical rooms, Compute Operations, the Data Hall, research labs and every founder room stay closed. Your admin powers never open someone else's private rooms. Revoking a guest card immediately ends access.")
	for i=1,11 do
		local row=Kit.card(p,i+2);local name=title(row,"");local info=para(row,"");local selected: number?=nil;local active=false
		local b=button(row,"Issue guest card",function()
			if selected then call(if active then "RevokeGuestCard" else "GrantGuestCard",{userId=selected},if active then "Guest access revoked." else "One-hour guest card issued.") end
		end)
		watch(function(s)
			local live=s.live.campus;local peer=if live then live.online[i] else nil;row.Visible=peer~=nil;selected=if peer then peer.id else nil;active=false
			if not peer then return end
			for _,pass in live.passes do if pass.id==peer.id then active=true end end
			name.Text=peer.name;info.Text=if active then "Guest card active" else "No guest access to your company";b.Text=if active then "Revoke guest card" else "Issue one-hour guest card"
		end)
	end
end
local function fleet(p: Instance)
	local help=Kit.card(p,1);title(help,"Your company fleet")
	para(help,"A Founder’s Hatch is included. Purchase other cars with company cash. Collect one active car in your underground parking; choose Drive at its seat. Your fleet ownership is saved. An occupied car must be parked and left before collecting another.")
	for i,def in Config.CARS do
		local pass=(def :: any).pass -- game pass car (Executive Limo): ownership comes from the pass (ShopService)
		local card=Kit.card(p,i+1);title(card,def.name);para(card,string.format("%s · top speed %d studs/s · reverse %d studs/s",if pass then "Game pass car" elseif def.price==0 then "Included with your company" else Format.money(def.price),def.speed,def.reverse))
		local owned,hasPass=false,false
		local b=button(card,"",function()
			if pass and not hasPass then if navigator then navigator.show("shop") end;return end
			if pass and not owned then call("BuyCar",{carId=def.id},"Added to your fleet. Collect it below.");return end
			call(if owned then "SpawnCar" else "BuyCar",{carId=def.id},if owned then "Car ready to collect." else "Car purchased. Collect it below.")
		end)
		watch(function(s)
			owned=s.data.empire.campus.cars[def.id]==true
			local shop=(s.live :: any).shop
			hasPass=pass~=nil and typeof(shop)=="table" and typeof(shop.passes)=="table" and shop.passes[pass]==true
			if pass then
				b.Text=if not hasPass then "Get the pass" elseif owned then "Collect" else "Add to fleet";Kit.setDisabled(b,false)
			else
				b.Text=if owned then "Collect" else "Buy · "..Format.money(def.price);Kit.setDisabled(b,not owned and s.data.money&lt;def.price)
			end
		end)
	end
end
local function shops(p: Instance)
	local hero=Kit.card(p,1);local heading=title(hero,"Your company stores");local info=para(hero,"")
	watch(function(s)
		local c=s.data.empire.campus;heading.Text=s.data.company.name.." / Company stores"
		info.Text=string.format("Retail level %d / 4 · %d sales · %s net revenue\nNPC retail traffic is simulated every 30 seconds. More staff and store upgrades increase visits. Each simulated ticket earns $12 after stock costs.",c.retailLevel,c.retailSales,Format.money(c.retailRevenue))
	end)
	local upgrade=button(hero,"Upgrade store",function()call("UpgradeRetail",{},"Company stores upgraded.")end)
	watch(function(s)local cost=Config.RETAIL[s.data.empire.campus.retailLevel];upgrade.Text=if cost then "Upgrade stores · "..Format.money(cost) else "Stores fully upgraded";Kit.setDisabled(upgrade,not cost or s.data.money&lt;(cost or 0))end)
	local help=Kit.card(p,2);title(help,"House Kitchen &amp; Snack Club")
	para(help,"Buy at the kitchen or shop counter to pay the menu price. The buttons below deliver a snack to your backpack for an extra $15. Equip it, then click or tap to eat. Snacks temporarily improve walk speed; the latest snack replaces the previous effect.")
	for i,def in Config.SNACKS do
		local card=Kit.card(p,i+2);title(card,def.name);local stock=para(card,"")
		local b=button(card,"Deliver · "..Format.money(def.price+15),function()call("BuySnack",{snackId=def.id},"Snack delivered to your backpack.")end)
		watch(function(s)stock.Text=string.format("In your bag: %d · walk speed %d for %ds",s.data.empire.campus.snacks[def.id] or 0,def.speed,def.seconds);Kit.setDisabled(b,s.data.money&lt;def.price+15)end)
	end
end
local builders={building=building,access=access,fleet=fleet,shops=shops}
local function render()
	if not scroll then return end;watchers={}
	for _,child in scroll:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
	local stack=Kit.stack(scroll,12);Kit.padding(stack,0,8,24,0);builders[current](stack);scroll.CanvasPosition=Vector2.zero
end
function App.mount(parent: Frame,nav: any)
	navigator=nav
	local head=Kit.frame(parent,UDim2.new(1,0,0,38));local text=Kit.text(head,"Campus",24,F.display,C.text);text.Position=UDim2.fromOffset(0,2)
	local tabs=Kit.row(parent,40,8);tabs.Position=UDim2.fromOffset(0,44);tabs.Size=UDim2.new(1,0,0,40)
	for _,def in {{"building","Building"},{"access","Cards &amp; guests"},{"fleet","Fleet"},{"shops","Stores &amp; snacks"}} do
		local b=Kit.button(tabs,def[2],"secondary",UDim2.new(.25,-6,1,0));Kit.onClick(b,function()current=def[1];render()end)
	end
	scroll=Kit.scroll(parent,UDim2.new(1,0,1,-98),UDim2.fromOffset(0,98))
	State.onChange(function(s)if not s.data.company then return end;if #watchers==0 then render()end;for _,fn in watchers do fn(s)end end)
end
function App.onShow()if #watchers==0 and State.snapshot and State.snapshot.data.company then render() end end
-- Prompts and the HUD can open a tab directly (building, access, fleet, shops).
function App.openSection(section: string)
	if builders[section] then current=section;render() end
end
return App
