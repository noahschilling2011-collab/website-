-- Test-Abkürzungen. Sichtbar nur in Studio oder für GameConfig.DEV_USER_IDS.
-- Der Server prüft das unabhängig davon noch einmal (DebugService.allowed).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local UI = script.Parent
local Client = UI.Parent
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors

local COMMANDS: { { cmd: string, label: string, done: string } } = {
	{ cmd = "money", label = "+ $100K", done = "+$100,000" },
	{ cmd = "data", label = "+ 10B tokens per type", done = "+10B tokens of every data type" },
	{ cmd = "finish", label = "Finish training now", done = "Training finished" },
	{ cmd = "rep", label = "+ 25 reputation", done = "+25 reputation" },
}

local DebugPanel = {}

local panel: Frame? = nil

function DebugPanel.allowed(): boolean
	return RunService:IsStudio() or table.find(GameConfig.DEV_USER_IDS, Players.LocalPlayer.UserId) ~= nil
end

function DebugPanel.mount(parent: Frame)
	local frame = Kit.panel(parent, UDim2.fromOffset(240, 0), UDim2.new(0, 16, 0.55, 0))
	frame.AnchorPoint = Vector2.new(0, 0.5)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.Visible = false
	frame.Name = "DebugPanel"
	Kit.padding(frame, 12)
	Kit.list(frame, 8)
	local caption = Kit.caption(frame, "Dev tools (Studio only)", 0)
	caption.TextColor3 = C.warn
	panel = frame

	for index, def in COMMANDS do
		local button = Kit.button(frame, def.label, "secondary", UDim2.new(1, 0, 0, 36))
		button.LayoutOrder = index
		button.TextSize = 14
		Kit.onClick(button, function()
			local ok = ActionController.call("Debug", { cmd = def.cmd })
			if ok then
				Toast.show("info", "[Dev] " .. def.done)
			end
		end)
	end

	local reset = Kit.button(frame, "Reset save", "danger", UDim2.new(1, 0, 0, 36))
	reset.LayoutOrder = #COMMANDS + 1
	reset.TextSize = 14
	local armedAt = 0
	Kit.onClick(reset, function()
		if os.clock() - armedAt &gt; 3 then
			armedAt = os.clock()
			reset.Text = "Click again to reset"
			task.delay(3, function()
				reset.Text = "Reset save"
			end)
			return
		end
		armedAt = 0
		reset.Text = "Reset save"
		local ok = ActionController.call("Debug", { cmd = "reset" })
		if ok then
			Toast.show("warn", "[Dev] Save reset. Starting over.")
		end
	end)

	local close = Kit.button(frame, "Close", "ghost", UDim2.new(1, 0, 0, 30))
	close.LayoutOrder = #COMMANDS + 2
	close.TextSize = 13
	Kit.onClick(close, DebugPanel.toggle)
end

function DebugPanel.toggle()
	local frame = panel
	if frame then
		frame.Visible = not frame.Visible
	end
end

return DebugPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">Kit</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- UI-Bausteine. Bewusst typisiert (Instance.new + direkte Property-Zuweisung), damit luau-lsp
-- falsche Property-Namen findet. Größen sind Design-Pixel (UIRoot skaliert alles passend).

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local C = Theme.colors
local F = Theme.font

export type Nav = { show: (appId: string) -&gt; (), close: () -&gt; (), isOpen: () -&gt; boolean }
export type ButtonStyle = "primary" | "secondary" | "ghost" | "danger" | "warn"
export type Option = { id: string, label: string }
export type Bar = { frame: Frame, fill: Frame, set: (fraction: number) -&gt; () }
export type Segmented = {
	frame: Frame,
	set: (id: string) -&gt; (),
	get: () -&gt; string,
	setDim: (id: string, dim: boolean) -&gt; (),
}
export type Slider = {
	frame: Frame,
	set: (value: number) -&gt; (),
	get: () -&gt; number,
	setRange: (min: number, max: number) -&gt; (),
}
export type StatRow = { frame: Frame, set: (value: number, max: number?) -&gt; () }
export type Metric = { frame: Frame, value: TextLabel, label: TextLabel }
export type Icon = { frame: Frame, setColor: (color: Color3) -&gt; () }

local Kit = {}

function Kit.tween(
	inst: Instance,
	seconds: number,
	goals: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local tween = TweenService:Create(inst, info, goals)
	tween:Play()
	return tween
end

function Kit.corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = parent
	return corner
end

function Kit.stroke(parent: Instance, transparency: number?, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color or C.line
	stroke.Transparency = transparency or 0.9
	stroke.Thickness = thickness or 1
	stroke.Parent = parent
	return stroke
end

function Kit.padding(parent: Instance, top: number, right: number?, bottom: number?, left: number?): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingRight = UDim.new(0, right or top)
	padding.PaddingBottom = UDim.new(0, bottom or top)
	padding.PaddingLeft = UDim.new(0, left or right or top)
	padding.Parent = parent
	return padding
end

function Kit.list(parent: Instance, gap: number?, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, gap or 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	if horizontal then
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	layout.Parent = parent
	return layout
end

function Kit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = rotation or 90
	gradient.Parent = parent
	return gradient
end

function Kit.frame(parent: Instance?, size: UDim2?, position: UDim2?): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = size or UDim2.fromScale(1, 1)
	frame.Position = position or UDim2.new()
	frame.Parent = parent
	return frame
end

-- Spalte mit Inhaltshöhe (volle Breite)
function Kit.stack(parent: Instance, gap: number?, order: number?): Frame
	local frame = Kit.frame(parent, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = order or 0
	Kit.list(frame, gap)
	return frame
end

-- Zeile mit fester Höhe, Kinder nebeneinander
function Kit.row(parent: Instance, height: number, gap: number?, order: number?): Frame
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, height))
	frame.LayoutOrder = order or 0
	Kit.list(frame, gap, true)
	return frame
end

-- Glas-Kante: oben hell, nach unten fast unsichtbar (Licht von oben)
function Kit.litStroke(parent: Instance, top: number?): UIStroke
	local stroke = Kit.stroke(parent, 0, C.line, 1)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, top or 0.78),
		NumberSequenceKeypoint.new(0.4, 0.9),
		NumberSequenceKeypoint.new(1, 0.95),
	})
	gradient.Parent = stroke
	return stroke
end

-- Großes Glas-Panel (Fenster, HUD)
function Kit.panel(parent: Instance?, size: UDim2?, position: UDim2?): Frame
	local frame = Kit.frame(parent, size, position)
	frame.BackgroundColor3 = C.panel
	frame.BackgroundTransparency = 0.02
	Kit.corner(frame, 12)
	Kit.stroke(frame, 0.87)
	return frame
end

-- Inhaltskarte mit Innenabstand und Liste
function Kit.card(parent: Instance, order: number?, gap: number?): Frame
	local frame = Kit.frame(parent, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = order or 0
	frame.BackgroundColor3 = C.panel2
	frame.BackgroundTransparency = 0
	Kit.corner(frame, 10)
	Kit.stroke(frame, 0.93)
	Kit.padding(frame, 16)
	Kit.list(frame, gap or 10)
	return frame
end

function Kit.text(parent: Instance?, text: string, size: number?, font: Enum.Font?, color: Color3?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = text
	label.TextSize = size or 16
	label.Font = font or F.medium
	label.TextColor3 = color or C.text
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.AutomaticSize = Enum.AutomaticSize.XY
	label.Size = UDim2.new()
	label.Parent = parent
	return label
end

-- Fließtext über die volle Breite mit Umbruch
function Kit.para(parent: Instance, text: string, size: number?, color: Color3?, order: number?): TextLabel
	local label = Kit.text(parent, text, size or 15, F.regular, color or C.muted)
	label.Size = UDim2.fromScale(1, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.LayoutOrder = order or 0
	return label
end

-- Abschnittsname: normale Schreibung, gedämpft (keine Großbuchstaben-Etiketten)
function Kit.caption(parent: Instance, text: string, order: number?): TextLabel
	local label = Kit.text(parent, text, 13, F.medium, C.muted)
	label.LayoutOrder = order or 0
	return label
end

-- Fester Textblock (z. B. Spalte in einer Tabelle)
function Kit.cell(parent: Instance, text: string, width: UDim, size: number?, font: Enum.Font?, color: Color3?): TextLabel
	local label = Kit.text(parent, text, size or 15, font, color)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.Size = UDim2.new(width, UDim.new(1, 0))
	label.TextTruncate = Enum.TextTruncate.AtEnd
	return label
end

function Kit.tag(parent: Instance, text: string, color: Color3, order: number?): TextLabel
	local label = Kit.text(parent, string.upper(text), 11, F.bold, color)
	label.BackgroundColor3 = C.bg -- dunkle Basis: lesbar auch über hellem Himmel
	label.BackgroundTransparency = 0.15
	label.LayoutOrder = order or 0
	Kit.corner(label, 6)
	Kit.stroke(label, 0.55, color)
	Kit.padding(label, 3, 7, 3, 7)
	return label
end

function Kit.dot(parent: Instance, color: Color3, size: number?): Frame
	local dot = Kit.frame(parent, UDim2.fromOffset(size or 10, size or 10))
	dot.BackgroundTransparency = 0
	dot.BackgroundColor3 = color
	Kit.corner(dot, (size or 10) // 2 + 1)
	return dot
end

function Kit.divider(parent: Instance, order: number?): Frame
	local line = Kit.frame(parent, UDim2.new(1, 0, 0, 1))
	line.BackgroundTransparency = 0.92
	line.BackgroundColor3 = C.line
	line.LayoutOrder = order or 0
	return line
end

-- Für RichText: Spielertexte (Namen) immer escapen
function Kit.escape(text: string): string
	return (
		string.gsub(text, "[&amp;&lt;&gt;\"']", {
			["&amp;"] = "&amp;amp;",
			["&lt;"] = "&amp;lt;",
			["&gt;"] = "&amp;gt;",
			['"'] = "&amp;quot;",
			["'"] = "&amp;apos;",
		})
	)
end

---------------------------------------------------------------------------- Buttons

function Kit.button(parent: Instance?, text: string, style: ButtonStyle?, size: UDim2?): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Text = text
	button.Font = F.bold
	button.TextSize = 16
	button.Size = size or UDim2.fromOffset(140, 40)
	button.Parent = parent
	Kit.corner(button, 10)

	local kind = style or "secondary"
	if kind == "primary" then
		Theme.bindAccent(button, "BackgroundColor3")
		button.BackgroundTransparency = 0
		button.TextColor3 = C.bg
	elseif kind == "danger" or kind == "warn" then
		local color = if kind == "danger" then C.bad else C.warn
		button.BackgroundColor3 = color
		button.BackgroundTransparency = 0.82
		button.TextColor3 = color
		Kit.stroke(button, 0.55, color)
	elseif kind == "ghost" then
		button.BackgroundColor3 = C.raised
		button.BackgroundTransparency = 1
		button.TextColor3 = C.muted
		Kit.stroke(button, 0.84)
	else
		button.BackgroundColor3 = C.raised
		button.BackgroundTransparency = 0
		button.TextColor3 = C.text
		Kit.litStroke(button, 0.8)
	end
	button:SetAttribute("BaseBg", button.BackgroundTransparency)

	-- kleines "Juice": Hover und Druck skalieren den Button
	local scale = Instance.new("UIScale")
	scale.Parent = button
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			Kit.tween(scale, 0.15, { Scale = 1.015 })
		end
	end)
	button.MouseLeave:Connect(function()
		Kit.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			Kit.tween(scale, 0.08, { Scale = 0.98 })
		end
	end)
	button.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	return button
end

function Kit.setDisabled(button: TextButton, disabled: boolean)
	if (button:GetAttribute("Disabled") == true) == disabled then
		return
	end
	button:SetAttribute("Disabled", disabled)
	local base = button:GetAttribute("BaseBg")
	local baseBg = if typeof(base) == "number" then base else 0
	button.BackgroundTransparency = if disabled then math.min(1, baseBg + 0.5) else baseBg
	button.TextTransparency = if disabled then 0.45 else 0
end

-- Klick-Handler, der deaktivierte Buttons ignoriert
function Kit.onClick(button: GuiButton, callback: () -&gt; ())
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") == true then
			return
		end
		callback()
	end)
end

-- Unsichtbarer Vollflächen-Button: schluckt Klicks/Touches (Kamera dreht sich nicht mit)
function Kit.blocker(parent: Instance, color: Color3, transparency: number): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Text = ""
	button.Size = UDim2.fromScale(1, 1)
	button.BackgroundColor3 = color
	button.BackgroundTransparency = transparency
	button.Modal = true -- gibt die Maus frei, falls die Kamera sie festhält
	button.Parent = parent
	return button
end

---------------------------------------------------------------------------- Eingaben

function Kit.input(parent: Instance, placeholder: string, size: UDim2?): TextBox
	local box = Instance.new("TextBox")
	box.ClearTextOnFocus = false
	box.Text = ""
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = C.dim
	box.Font = F.medium
	box.TextSize = 18
	box.TextColor3 = C.text
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.BackgroundColor3 = C.bg
	box.BackgroundTransparency = 0.25
	box.BorderSizePixel = 0
	box.ClipsDescendants = true
	box.Size = size or UDim2.new(1, 0, 0, 44)
	box.Parent = parent
	Kit.corner(box, 10)
	Kit.padding(box, 0, 14, 0, 14)
	local stroke = Kit.stroke(box, 0.84)
	box.Focused:Connect(function()
		stroke.Color = Theme.accent
		stroke.Transparency = 0.2
	end)
	box.FocusLost:Connect(function()
		stroke.Color = C.line
		stroke.Transparency = 0.84
	end)
	return box
end

function Kit.segmented(
	parent: Instance,
	options: { Option },
	initial: string,
	onSelect: (id: string) -&gt; (),
	height: number?
): Segmented
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, height or 38))
	frame.BackgroundColor3 = C.bg
	frame.BackgroundTransparency = 0.25
	Kit.corner(frame, 10)
	Kit.stroke(frame, 0.9)
	Kit.padding(frame, 3)
	Kit.list(frame, 3, true)

	local count = #options
	local buttons: { [string]: TextButton } = {}
	local dimmed: { [string]: boolean } = {}
	local selected = initial

	local function paint()
		for id, button in buttons do
			local on = id == selected
			button.BackgroundColor3 = if on then Theme.accent else C.raised
			button.BackgroundTransparency = if on then 0 else 1
			button.TextColor3 = if on then C.bg elseif dimmed[id] then C.dim else C.muted
		end
	end

	for index, option in options do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = option.label
		button.Font = F.bold
		button.TextSize = 15
		button.Size = UDim2.new(1 / count, -3 * (count - 1) / count, 1, 0)
		button.LayoutOrder = index
		button.Parent = frame
		Kit.corner(button, 8)
		buttons[option.id] = button
		button.Activated:Connect(function()
			if selected == option.id then
				return
			end
			selected = option.id
			paint()
			onSelect(option.id)
		end)
	end
	paint()
	Theme.onAccent(function()
		paint()
	end)

	return {
		frame = frame,
		set = function(id: string)
			selected = id
			paint()
		end,
		get = function(): string
			return selected
		end,
		setDim = function(id: string, dim: boolean)
			dimmed[id] = dim
			paint()
		end,
	}
end

function Kit.slider(
	parent: Instance,
	min: number,
	max: number,
	step: number,
	value: number,
	onChange: (value: number) -&gt; ()
): Slider
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, 30))
	local track = Instance.new("TextButton")
	track.AutoButtonColor = false
	track.Text = ""
	track.BorderSizePixel = 0
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.new(0, 10, 0.5, 0)
	track.Size = UDim2.new(1, -20, 0, 8)
	track.BackgroundColor3 = C.raised
	track.Parent = frame
	Kit.corner(track, 4)

	local fill = Kit.frame(track, UDim2.fromScale(0, 1))
	fill.BackgroundTransparency = 0
	Theme.bindAccent(fill, "BackgroundColor3")
	Kit.corner(fill, 4)

	local knob = Kit.frame(track, UDim2.fromOffset(20, 20))
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundTransparency = 0
	knob.BackgroundColor3 = C.white
	Kit.corner(knob, 10)
	Kit.stroke(knob, 0.3, C.bg, 2)

	local lo, hi, current = min, max, value
	local dragging = false

	local function clampSnap(v: number): number
		local snapped = math.round((v - lo) / step) * step + lo
		return math.round(math.clamp(snapped, lo, math.max(lo, hi)) * 100) / 100
	end

	local function paint()
		local fraction = if hi &gt; lo then (current - lo) / (hi - lo) else 0
		fill.Size = UDim2.fromScale(fraction, 1)
		knob.Position = UDim2.fromScale(fraction, 0.5)
	end

	local function updateFrom(x: number)
		local width = track.AbsoluteSize.X
		if width &lt;= 0 then
			return
		end
		local fraction = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		local v = clampSnap(lo + fraction * (hi - lo))
		if v ~= current then
			current = v
			paint()
			onChange(v)
		end
	end

	local function begin(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			updateFrom(input.Position.X)
		end
	end
	track.InputBegan:Connect(begin)
	knob.InputBegan:Connect(begin)
	-- ungeprüft: X-Koordinaten von InputObject und AbsolutePosition stimmen bei seitlichen Notch-Insets überein
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			updateFrom(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)
	paint()

	return {
		frame = frame,
		set = function(v: number)
			current = clampSnap(v)
			paint()
		end,
		get = function(): number
			return current
		end,
		setRange = function(newMin: number, newMax: number)
			lo, hi = newMin, math.max(newMin, newMax)
			current = clampSnap(current)
			paint()
		end,
	}
end

---------------------------------------------------------------------------- Anzeigen

-- Fortschrittsbalken. Ohne color folgt die Füllung der Akzentfarbe.
function Kit.bar(parent: Instance, height: number?, order: number?, color: Color3?): Bar
	local h = height or 8
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, h))
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = C.raised
	frame.LayoutOrder = order or 0
	frame.ClipsDescendants = true
	Kit.corner(frame, math.ceil(h / 2))
	local fill = Kit.frame(frame, UDim2.fromScale(0, 1))
	fill.BackgroundTransparency = 0
	if color then
		fill.BackgroundColor3 = color
	else
		Theme.bindAccent(fill, "BackgroundColor3")
	end
	Kit.corner(fill, math.ceil(h / 2))
	Kit.gradient(fill, Color3.fromRGB(170, 176, 190), C.white, 0) -- Füllung wird nach rechts heller
	return {
		frame = frame,
		fill = fill,
		set = function(fraction: number)
			local f = if fraction == fraction then math.clamp(fraction, 0, 1) else 0
			fill.Size = UDim2.fromScale(f, 1)
		end,
	}
end

-- Stacked bar: segments side by side, each a share of `total` (sum of the values when total is nil).
-- Segments with value 0 are hidden; the rest of the track stays empty (C.raised).
export type SplitBar = { frame: Frame, set: (segments: { { value: number, color: Color3 } }, total: number?) -&gt; () }
function Kit.splitBar(parent: Instance, height: number?, order: number?): SplitBar
	local h = height or 12
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, h))
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = C.raised
	frame.LayoutOrder = order or 0
	frame.ClipsDescendants = true
	Kit.corner(frame, math.ceil(h / 2))
	local parts: { Frame } = {}
	return {
		frame = frame,
		set = function(segments: { { value: number, color: Color3 } }, total: number?)
			local sum = 0
			for _, seg in segments do
				sum += math.max(0, if seg.value == seg.value then seg.value else 0)
			end
			local whole = math.max(total or sum, 1e-9)
			local x = 0
			for i, seg in segments do
				if i &gt; #parts then
					local made = Kit.frame(frame)
					made.BackgroundTransparency = 0
					table.insert(parts, made)
				end
				local part = parts[i]
				local share = math.clamp(math.max(0, if seg.value == seg.value then seg.value else 0) / whole, 0, math.max(0, 1 - x))
				part.Visible = share &gt; 0
				part.BackgroundColor3 = seg.color
				part.Position = UDim2.fromScale(x, 0)
				part.Size = UDim2.fromScale(share, 1)
				x += share
			end
			for i = #segments + 1, #parts do
				parts[i].Visible = false
			end
		end,
	}
end

-- Legend chip: coloured dot + short text (for split bars and charts)
function Kit.legend(parent: Instance, color: Color3, text: string, order: number?): (Frame, TextLabel)
	local holder = Kit.frame(parent, UDim2.new(0, 0, 0, 18))
	holder.AutomaticSize = Enum.AutomaticSize.X
	holder.LayoutOrder = order or 0
	Kit.list(holder, 6, true)
	local dot = Kit.dot(holder, color, 9)
	dot.LayoutOrder = 1
	local label = Kit.text(holder, text, 13, F.medium, C.muted)
	label.LayoutOrder = 2
	return holder, label
end

-- Zeile "Name ▓▓▓▓░░ Wert" für Modell-Stats
function Kit.statRow(parent: Instance, label: string, order: number?): StatRow
	local row = Kit.frame(parent, UDim2.new(1, 0, 0, 22))
	row.LayoutOrder = order or 0
	local name = Kit.cell(row, label, UDim.new(0, 92), 14, F.medium, C.muted)
	name.Position = UDim2.new()
	local track = Kit.frame(row, UDim2.new(1, -150, 0, 6), UDim2.new(0, 98, 0.5, -3))
	track.BackgroundTransparency = 0
	track.BackgroundColor3 = C.raised
	Kit.corner(track, 3)
	local fill = Kit.frame(track, UDim2.fromScale(0, 1))
	fill.BackgroundTransparency = 0
	Theme.bindAccent(fill, "BackgroundColor3")
	Kit.corner(fill, 3)
	local value = Kit.cell(row, "0", UDim.new(0, 44), 14, F.bold, C.text)
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.fromScale(1, 0)
	value.TextXAlignment = Enum.TextXAlignment.Right
	return {
		frame = row,
		set = function(v: number, max: number?)
			fill.Size = UDim2.fromScale(math.clamp(v / (max or 100), 0, 1), 1)
			value.Text = string.format("%.0f", v)
		end,
	}
end

-- Kennzahl: kleine Überschrift + großer Wert
function Kit.metric(parent: Instance, label: string, order: number?, valueSize: number?): Metric
	local frame = Kit.frame(parent, UDim2.new())
	frame.AutomaticSize = Enum.AutomaticSize.XY
	frame.LayoutOrder = order or 0
	Kit.list(frame, 2)
	local caption = Kit.caption(frame, label, 1)
	local value = Kit.text(frame, "–", valueSize or 20, F.bold, C.text)
	value.LayoutOrder = 2
	return { frame = frame, value = value, label = caption }
end

-- Zwei Spalten nebeneinander (links/rechts), jeweils mit Inhaltshöhe
function Kit.columns(parent: Instance, leftShare: number, gap: number?, order: number?): (Frame, Frame)
	local holder = Kit.frame(parent, UDim2.fromScale(1, 0))
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.LayoutOrder = order or 0
	local g = gap or 14
	local left = Kit.frame(holder, UDim2.new(leftShare, -g / 2, 0, 0))
	left.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(left, 12)
	local right = Kit.frame(holder, UDim2.new(1 - leftShare, -g / 2, 0, 0), UDim2.new(leftShare, g / 2, 0, 0))
	right.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(right, 12)
	return left, right
end

-- Raster mit festen Spalten und fester Zellenhöhe, Gesamthöhe automatisch
function Kit.grid(parent: Instance, columns: number, cellHeight: number, gap: number?, order: number?): Frame
	local frame = Kit.frame(parent, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = order or 0
	local g = gap or 10
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / columns, -g * (columns - 1) / columns, 0, cellHeight)
	grid.CellPadding = UDim2.fromOffset(g, g)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = frame
	return frame
end

function Kit.scroll(parent: Instance, size: UDim2?, position: UDim2?): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = size or UDim2.fromScale(1, 1)
	scroll.Position = position or UDim2.new()
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 5
	scroll.ScrollBarImageColor3 = C.white
	scroll.ScrollBarImageTransparency = 0.75
	scroll.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
	scroll.Parent = parent
	return scroll
end

-- Seitenkopf einer App: Titel in der Display-Schrift, darunter eine Zeile Erklärung
function Kit.heading(parent: Instance, title: string, subtitle: string?, order: number?): TextLabel
	local head = Kit.stack(parent, 6, order)
	local label = Kit.text(head, title, 22, F.display, C.text)
	label.LayoutOrder = 1
	if subtitle then
		Kit.para(head, subtitle, 14, C.muted, 2)
	end
	return label
end

-- Kleine Linien-Icons aus Frames (keine Emoji, keine Asset-IDs): lab, data, compute, market
function Kit.icon(parent: Instance, kind: string, size: number?): Icon
	local s = size or 20
	local frame = Kit.frame(parent, UDim2.fromOffset(s, s))
	local fills: { Frame } = {}
	local rings: { UIStroke } = {}
	local function block(x: number, y: number, w: number, h: number, radius: number?)
		local b = Kit.frame(frame, UDim2.fromScale(w, h), UDim2.fromScale(x, y))
		b.BackgroundTransparency = 0
		Kit.corner(b, radius or 2)
		table.insert(fills, b)
	end
	local function ring(x: number, y: number, w: number, h: number, radius: number)
		local r = Kit.frame(frame, UDim2.fromScale(w, h), UDim2.fromScale(x, y))
		Kit.corner(r, radius)
		table.insert(rings, Kit.stroke(r, 0, C.white, 2))
	end
	if kind == "empire" then
		block(0.12,0.25,0.76,0.68,2)
		ring(0.3,0.02,0.4,0.23,2)
	elseif kind == "lab" then -- Neuron
		ring(0.08, 0.08, 0.84, 0.84, s)
		block(0.34, 0.34, 0.32, 0.32, s)
	elseif kind == "data" then -- gestapelte Datensätze
		block(0.04, 0.1, 0.92, 0.2)
		block(0.04, 0.4, 0.92, 0.2)
		block(0.04, 0.7, 0.92, 0.2)
	elseif kind == "compute" then -- Chip mit Pins
		ring(0.18, 0.18, 0.64, 0.64, 3)
		block(0.38, 0.38, 0.24, 0.24, 1)
		block(0, 0.3, 0.12, 0.1, 1)
		block(0, 0.6, 0.12, 0.1, 1)
		block(0.88, 0.3, 0.12, 0.1, 1)
		block(0.88, 0.6, 0.12, 0.1, 1)
	elseif kind=="studio" then
		ring(.06,.12,.88,.76,2);block(.12,.19,.76,.12);block(.14,.4,.3,.38);block(.5,.4,.32,.1);block(.5,.62,.32,.1)
	elseif kind=="campus" then
		ring(.15,.18,.7,.75,1);block(.05,.88,.9,.1);block(.3,.34,.12,.15);block(.57,.34,.12,.15);block(.44,.65,.12,.28)
	elseif kind=="shop" then -- shopping bag with handle
		ring(.14,.34,.72,.58,3);ring(.32,.08,.36,.36,6);block(.14,.5,.72,.08)
	elseif kind=="arena" then
		ring(.1,.05,.8,.57,3);block(.43,.6,.14,.22);block(.25,.85,.5,.1)
	else -- Markt: steigende Balken
		block(0.04, 0.56, 0.24, 0.4)
		block(0.38, 0.32, 0.24, 0.64)
		block(0.72, 0.06, 0.24, 0.9)
	end
	return {
		frame = frame,
		setColor = function(color: Color3)
			for _, b in fills do
				b.BackgroundColor3 = color
			end
			for _, r in rings do
				r.Color = color
			end
		end,
	}
end

return Kit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">Theme</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Farben und Schriften ("Nachtlabor"): tiefe Tinte als Grund, helle Haarlinien als Struktur, die
-- Firmenfarbe als einziger Akzent (CTA, Auswahl, Live-Daten). Elemente melden sich mit bindAccent
-- (Instanz + Property) oder onAccent (Callback) an und werden beim Farbwechsel umgefärbt.

local Theme = {}

Theme.colors = {
	bg = Color3.fromRGB(15, 21, 23),
	panel = Color3.fromRGB(23, 31, 33),
	panel2 = Color3.fromRGB(30, 39, 41),
	raised = Color3.fromRGB(42, 52, 53),
	line = Color3.fromRGB(255, 255, 255), -- Haarlinien, immer mit hoher Transparenz
	text = Color3.fromRGB(238, 239, 231),
	muted = Color3.fromRGB(158, 173, 168),
	dim = Color3.fromRGB(117, 136, 132),
	good = Color3.fromRGB(129, 204, 162),
	bad = Color3.fromRGB(224, 137, 127),
	warn = Color3.fromRGB(224, 189, 122),
	black = Color3.fromRGB(0, 0, 0),
	white = Color3.fromRGB(255, 255, 255),
}

Theme.font = {
	regular = Enum.Font.BuilderSans,
	medium = Enum.Font.BuilderSansMedium,
	bold = Enum.Font.BuilderSansBold,
	black = Enum.Font.BuilderSansExtraBold,
	display = Enum.Font.BuilderSansExtraBold,
	mono = Enum.Font.RobotoMono, -- nur im Trainings-Log
}

Theme.DEFAULT_ACCENT = Color3.fromRGB(120, 200, 174)
Theme.accent = Theme.DEFAULT_ACCENT

type Binding = { inst: Instance, prop: string, mix: ((Color3) -&gt; Color3)? }

local bindings: { Binding } = {}
local listeners: { (Color3) -&gt; () } = {}

local function valueFor(binding: Binding): Color3
	return if binding.mix then binding.mix(Theme.accent) else Theme.accent
end

-- Instanz zuerst parenten, dann binden (unparented Instanzen werden beim nächsten Wechsel entfernt)
function Theme.bindAccent(inst: Instance, prop: string, mix: ((Color3) -&gt; Color3)?)
	local binding: Binding = { inst = inst, prop = prop, mix = mix }
	table.insert(bindings, binding)
	local target: any = inst
	target[prop] = valueFor(binding)
	-- Rebuilt app cards must release their bindings immediately, even if the
	-- company's accent never changes again during this session.
	inst.Destroying:Once(function()
		local index = table.find(bindings, binding)
		if index then table.remove(bindings, index) end
	end)
end

function Theme.onAccent(callback: (Color3) -&gt; ())
	table.insert(listeners, callback)
end

function Theme.setAccent(color: Color3)
	if color == Theme.accent then
		return
	end
	Theme.accent = color
	local kept: { Binding } = {}
	for _, binding in bindings do
		if binding.inst.Parent ~= nil then
			local target: any = binding.inst
			target[binding.prop] = valueFor(binding)
			table.insert(kept, binding)
		end
	end
	bindings = kept
	for _, callback in listeners do
		task.spawn(callback, color)
	end
end

-- Mischungen für bindAccent
function Theme.darker(amount: number): (Color3) -&gt; Color3
	return function(color: Color3): Color3
		return color:Lerp(Theme.colors.black, amount)
	end
end

function Theme.lighter(amount: number): (Color3) -&gt; Color3
	return function(color: Color3): Color3
		return color:Lerp(Theme.colors.white, amount)
	end
end

-- Akzent als dunkle Tönung einer Fläche (Hero-Flächen: Schätzung, Loss-Graph, Ergebnis)
function Theme.tint(amount: number): (Color3) -&gt; Color3
	return function(color: Color3): Color3
		return color:Lerp(Theme.colors.panel, amount)
	end
end

function Theme.rgb(values: { number }): Color3
	return Color3.fromRGB(values[1] or 255, values[2] or 255, values[3] or 255)
end

return Theme
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">Toast</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Kurze Meldungen oben mittig. Immer nur eine: neue ersetzt alte. Bei offenem Computer liegt sie
-- in der leeren Mitte der Kopfzeile und verdeckt keinen Inhalt. Gleicher Text verlängert nur.

local Theme = require(script.Parent.Theme)
local Kit = require(script.Parent.Kit)

local C = Theme.colors
local F = Theme.font

export type Kind = "info" | "success" | "error" | "warn"

local Toast = {}

local MAX_VISIBLE = 1
local container: Frame? = nil
local active: { { text: string, frame: Frame, expires: number } } = {}
local counter = 0

local function colorOf(kind: Kind): Color3
	if kind == "success" then
		return C.good
	elseif kind == "error" then
		return C.bad
	elseif kind == "warn" then
		return C.warn
	end
	return Theme.accent
end

function Toast.mount(parent: Instance)
	local holder = Kit.frame(parent, UDim2.fromOffset(440, 0), UDim2.new(0.5, 0, 0, 16))
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.Name = "Toasts"
	holder.ZIndex = 50
	local layout = Kit.list(holder, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	container = holder
end

local function dismiss(entry: { text: string, frame: Frame, expires: number })
	local index = table.find(active, entry)
	if index then
		table.remove(active, index)
	end
	local frame = entry.frame
	Kit.tween(frame, 0.25, { BackgroundTransparency = 1 })
	for _, child in frame:GetDescendants() do
		if child:IsA("TextLabel") then
			Kit.tween(child, 0.25, { TextTransparency = 1 })
		elseif child:IsA("Frame") then
			Kit.tween(child, 0.25, { BackgroundTransparency = 1 })
		elseif child:IsA("UIStroke") then
			Kit.tween(child, 0.25, { Transparency = 1 })
		end
	end
	task.delay(0.3, function()
		frame:Destroy()
	end)
end

function Toast.show(kind: Kind, text: string, seconds: number?)
	local holder = container
	if not holder then
		return
	end
	local duration = seconds or 3
	for _, entry in active do
		if entry.text == text then
			entry.expires = os.clock() + duration
			return
		end
	end
	if #active &gt;= MAX_VISIBLE then
		dismiss(active[1])
	end

	counter += 1
	local color = colorOf(kind)
	local frame = Kit.frame(holder, UDim2.fromScale(1, 0))
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.LayoutOrder = counter
	frame.BackgroundTransparency = 0.04
	frame.BackgroundColor3 = C.bg
	frame.ZIndex = 50
	Kit.corner(frame, 12)
	Kit.stroke(frame, 0.6, color)
	Kit.padding(frame, 11, 16, 11, 16)
	Kit.list(frame, 10, true)

	local dot = Kit.dot(frame, color, 8) -- Statusfarbe: Erfolg, Fehler, Warnung, Info
	dot.LayoutOrder = 1
	dot.ZIndex = 51
	local label = Kit.text(frame, text, 15, F.medium, C.text)
	label.LayoutOrder = 2
	label.ZIndex = 51
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Size = UDim2.new(1, -18, 0, 0)
	label.TextWrapped = true

	local scale = Instance.new("UIScale")
	scale.Scale = 0.92
	scale.Parent = frame
	Kit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

	local entry = { text = text, frame = frame, expires = os.clock() + duration }
	table.insert(active, entry)
	task.spawn(function()
		while table.find(active, entry) do
			if os.clock() &gt;= entry.expires then
				dismiss(entry)
				return
			end
			task.wait(0.2)
		end
	end)
end

return Toast
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000055"><Properties><string name="Name">UIRoot</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Fünf ScreenGuis übereinander: HUD, Dim, Overlay (Computer), Intro (randlos), Top (Toasts, Debug).
-- Jede hat einen Root-Frame mit UIScale: das UI wird für 1280x720 entworfen und passend skaliert,
-- damit es auf Handy und großem Monitor gleich aussieht. CoreUISafeInsets hält es aus der Roblox-
-- Topbar und aus Notches heraus.

local Players = game:GetService("Players")

local UIRoot = {}

local DESIGN = Vector2.new(1280, 720)
local MIN_SCALE = 0.3
local MAX_SCALE = 1.25

type Layer = { gui: ScreenGui, root: Frame, scale: UIScale }

local function scaleFor(size: Vector2): number
	if size.X &lt;= 0 or size.Y &lt;= 0 then
		return 1
	end
	return math.clamp(math.min(size.X / DESIGN.X, size.Y / DESIGN.Y), MIN_SCALE, MAX_SCALE)
end

local function applyScale(layer: Layer)
	local s = scaleFor(layer.gui.AbsoluteSize)
	layer.scale.Scale = s
	layer.root.Size = UDim2.fromScale(1 / s, 1 / s)
end

local function makeLayer(playerGui: Instance, name: string, order: number, insets: Enum.ScreenInsets?): Frame
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = insets or Enum.ScreenInsets.CoreUISafeInsets
	gui.DisplayOrder = order
	gui.Parent = playerGui

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local layer: Layer = { gui = gui, root = root, scale = scale }
	applyScale(layer)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		applyScale(layer)
	end)
	return root
end

-- Rückgabe: hud, dim (randlos: Abdunkeln hinter dem Computer, auch unter der Topbar),
-- overlay (Computer), intro (randlos), top (Toasts, Debug)
function UIRoot.init(): (Frame, Frame, Frame, Frame, Frame)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local hud = makeLayer(playerGui, "AIEmpire_HUD", 10)
	local dim = makeLayer(playerGui, "AIEmpire_Dim", 19, Enum.ScreenInsets.None)
	local overlay = makeLayer(playerGui, "AIEmpire_Overlay", 20)
	local intro = makeLayer(playerGui, "AIEmpire_Intro", 25, Enum.ScreenInsets.None)
	local top = makeLayer(playerGui, "AIEmpire_Top", 30)
	return hud, dim, overlay, intro, top
end

return UIRoot
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000020"><Properties><string name="Name">AdminPanel</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The launcher appears only after a server-authorized snapshot, including before company creation.
local State=require(script.Parent.Parent.Controllers.StateController)
local Action=require(script.Parent.Parent.Controllers.ActionController)
local Theme=require(script.Parent.Theme)
local Kit=require(script.Parent.Kit)
local Toast=require(script.Parent.Toast)
local Panel={}
local frame: Frame?=nil
local authorized=false
local actions={
	{cmd="campus",title="Größten Campus freischalten",body="Sieben Etagen, alle Räume und Stores. Dein Spielstand bleibt erhalten."},
	{cmd="setup",title="Kompletten Firmenstart geben",body="Campus, 240 Mitarbeiter, Forschung, GPUs, Autos, Daten und $1 Mio."},
	{cmd="money",title="+$1.000.000 Spielgeld",body="Auf das eigene Firmenkonto einzahlen."},
	{cmd="staff",title="Team auf 240 auffüllen",body="Vier Rollen ausgewogen ergänzen. Die laufenden Gehälter gelten weiter."},
	{cmd="hardware",title="Compute ausbauen",body="Bis zu zwei Compute-Pods ergänzen und Kühlung auf Stufe 8 setzen."},
	{cmd="research",title="Alle Forschung freischalten",body="Acht Forschungsprojekte abschließen und 10.000 Punkte bereitstellen."},
	{cmd="fleet",title="Alle Firmenautos freischalten",body="Hatch, Cargo, Executive und Circuit GT im Fleet-Tab abholen."},
	{cmd="data",title="Trainingsdaten ergänzen",body="10 Milliarden hochwertige Tokens pro Datenart."},
	{cmd="finish",title="Laufendes Training abschließen",body="Den bestehenden Trainingslauf mit seinen normalen Modellwerten beenden."},
}
function Panel.toggle()
	if frame then frame.Visible=authorized and not frame.Visible end
end
function Panel.mount(parent: Frame)
	local launch=Kit.button(parent,"ADMIN","secondary",UDim2.fromOffset(134,38))
	launch.Name="AdminLauncher";launch.Position=UDim2.new(0,16,1,-16);launch.AnchorPoint=Vector2.new(0,1);launch.Visible=false
	Kit.onClick(launch,Panel.toggle)
	local box=Kit.panel(parent,UDim2.fromOffset(610,610),UDim2.fromScale(.5,.5))
	box.Name="AdminPanel";box.AnchorPoint=Vector2.new(.5,.5);box.Visible=false;frame=box
	local scale=Instance.new("UIScale");scale.Parent=box
	local function resize()
		local camera=workspace.CurrentCamera
		if camera then scale.Scale=math.max(.3,math.min(1,(camera.ViewportSize.X-24)/610,(camera.ViewportSize.Y-40)/610)) end
	end
	resize();if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
	Kit.padding(box,22,22,20,22)
	Kit.text(box,"Campus-Kontrolle",25,Theme.font.bold,Theme.colors.text)
	local caption=Kit.text(box,"Nonortrttrt  /  Administrator",13,Theme.font.medium,Theme.colors.muted);caption.Position=UDim2.fromOffset(0,38)
	local close=Kit.button(box,"Schließen","ghost",UDim2.fromOffset(90,30));close.Position=UDim2.new(1,-90,0,2);Kit.onClick(close,Panel.toggle)
	local scroller=Kit.scroll(box,UDim2.new(1,0,1,-80),UDim2.fromOffset(0,78))
	Kit.list(scroller,9);Kit.padding(scroller,0,8,8,0)
	-- Read-only diagnostics of the admin's own headquarters, shown in a scrollable, selectable box.
	local diag=Kit.card(scroller,0)
	local run=Kit.button(diag,"HQ-Diagnose ausführen","secondary",UDim2.new(1,0,0,36));run.LayoutOrder=1
	Kit.para(diag,"Nur lesen: Räume je Etage, Arbeitsplätze, Mitarbeiter mit Wegproblemen oder Lift-Tickets, Aufzug, offene oder gesperrte Türen und Kameras deines eigenen Hauptquartiers.",13,Theme.colors.muted,2)
	local area=Kit.scroll(diag,UDim2.new(1,0,0,230));area.LayoutOrder=3;area.BackgroundTransparency=.4;area.BackgroundColor3=Theme.colors.bg;Kit.corner(area,8)
	Kit.padding(area,8,8,8,8)
	local report=Instance.new("TextBox");report.Name="DiagnosticsReport";report.BackgroundTransparency=1;report.BorderSizePixel=0
	report.Size=UDim2.fromScale(1,0);report.AutomaticSize=Enum.AutomaticSize.Y;report.TextWrapped=true;report.MultiLine=true
	report.TextEditable=false;report.ClearTextOnFocus=false;report.Font=Theme.font.mono;report.TextSize=12;report.TextColor3=Theme.colors.text
	report.TextXAlignment=Enum.TextXAlignment.Left;report.TextYAlignment=Enum.TextYAlignment.Top;report.Text="Noch kein Bericht.";report.Parent=area
	Kit.onClick(run,function()
		if not authorized then return end
		task.spawn(function()
			Kit.setDisabled(run,true)
			local ok,result=Action.call("AdminAction",{cmd="diag"})
			Kit.setDisabled(run,false)
			if ok and typeof(result.report)=="string" then report.Text=result.report;area.CanvasPosition=Vector2.zero end
		end)
	end)
	-- Tier switch for testing upgrades and downgrades. It changes the admin's OWN save.
	local tiers=Kit.card(scroller,1)
	Kit.para(tiers,"Bürostufe testen: setzt die Stufe DEINES Spielstands und baut dein Hauptquartier neu. Mitarbeiter über der Schreibtischzahl werden wie beim Laden gekürzt. Ändert deinen Spielstand.",13,Theme.colors.muted,1)
	local tierRow=Kit.row(tiers,36,8,2)
	for tier=1,4 do
		local b=Kit.button(tierRow,"Stufe "..tier,"secondary",UDim2.new(.25,-6,1,0));b.LayoutOrder=tier
		Kit.onClick(b,function()
			if not authorized then return end
			task.spawn(function()
				Kit.setDisabled(b,true)
				local ok=Action.call("AdminAction",{cmd="tier"..tier})
				Kit.setDisabled(b,false)
				if ok then Toast.show("success","Bürostufe "..tier.." · Hauptquartier neu gebaut",4) end
			end)
		end)
	end
	for i,def in actions do
		local row=Kit.card(scroller,i+1)
		local b=Kit.button(row,def.title,if i==1 then "primary" else "secondary",UDim2.new(1,0,0,36));b.LayoutOrder=1
		Kit.para(row,def.body,13,Theme.colors.muted,2)
		Kit.onClick(b,function()
			if not authorized then return end
			task.spawn(function()
				Kit.setDisabled(b,true)
				local ok=Action.call("AdminAction",{cmd=def.cmd})
				Kit.setDisabled(b,false)
				if ok then Toast.show("success",def.title.." · erledigt",4) end
			end)
		end)
	end
	State.onChange(function(snapshot)
		authorized=snapshot.live.admin==true;launch.Visible=authorized
		if not authorized then box.Visible=false end
	end)
end
return Panel
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXHQP00000052"><Properties><string name="Name">Phone</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBXHQP00000053"><Properties><string name="Name">PhoneKit</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- PhoneKit (package "phone"): the small building blocks of the company phone UI. Typed Instance.new + direct
-- property writes like UI/Kit (luau-lsp checks the property names). Icons are drawn from Frames (no emoji, no
-- asset ids, no Rotation so they look the same everywhere). Sizes are design pixels inside the phone frame,
-- which has its own UIScale (Screens/Phone).
local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)

local C = Theme.colors
local F = Theme.font

local PhoneKit = {}

PhoneKit.colors = {
	screen = Color3.fromRGB(10, 14, 16),
	card = Color3.fromRGB(26, 34, 37),
	card2 = Color3.fromRGB(34, 44, 47),
	bezel = Color3.fromRGB(6, 7, 8),
	messages = Color3.fromRGB(52, 186, 96),
	calls = Color3.fromRGB(38, 166, 132),
	calendar = Color3.fromRGB(226, 92, 84),
	contacts = Color3.fromRGB(104, 126, 168),
	settings = Color3.fromRGB(104, 114, 122),
	accept = Color3.fromRGB(52, 186, 96),
	decline = Color3.fromRGB(226, 84, 76),
	badge = Color3.fromRGB(236, 72, 64),
}
local P = PhoneKit.colors

export type Badge = { frame: Frame, set: (n: number) -&gt; () }
export type Tile = { button: TextButton, badge: Badge }
export type Toggle = { frame: TextButton, set: (on: boolean) -&gt; (), get: () -&gt; boolean }

-- a TextButton without the default look (the phone's tap targets)
function PhoneKit.tap(parent: Instance?, size: UDim2?, position: UDim2?): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.BackgroundTransparency = 1
	b.Text = ""
	b.Size = size or UDim2.fromScale(1, 1)
	b.Position = position or UDim2.new()
	b.Parent = parent
	return b
end

-- Line icon of `kind` in a square of `size` design px (white unless color is given)
function PhoneKit.glyph(parent: Instance, kind: string, size: number, color: Color3?): Frame
	local frame = Kit.frame(parent, UDim2.fromOffset(size, size))
	frame.Name = "Glyph_" .. kind
	local col = color or C.white
	local function block(x: number, y: number, w: number, h: number, radius: number?)
		local b = Kit.frame(frame, UDim2.fromScale(w, h), UDim2.fromScale(x, y))
		b.BackgroundTransparency = 0
		b.BackgroundColor3 = col
		Kit.corner(b, radius or 2)
	end
	local function ring(x: number, y: number, w: number, h: number, radius: number, thick: number?)
		local r = Kit.frame(frame, UDim2.fromScale(w, h), UDim2.fromScale(x, y))
		Kit.corner(r, radius)
		Kit.stroke(r, 0, col, thick or math.max(1.5, size / 14))
	end
	if kind == "messages" then
		block(0.08, 0.14, 0.84, 0.58, math.floor(size * 0.22))
		block(0.2, 0.62, 0.2, 0.22, 2)
		local dots = { 0.27, 0.45, 0.63 }
		for _, x in dots do
			local d = Kit.frame(frame, UDim2.fromScale(0.1, 0.1), UDim2.fromScale(x, 0.38))
			d.BackgroundTransparency = 0.15
			d.BackgroundColor3 = P.messages:Lerp(C.black, 0.25)
			Kit.corner(d, size)
		end
	elseif kind == "calls" then -- desk telephone: handset bar, body, dial
		block(0.06, 0.18, 0.88, 0.17, math.floor(size * 0.1))
		block(0.06, 0.18, 0.2, 0.3, 3)
		block(0.74, 0.18, 0.2, 0.3, 3)
		block(0.18, 0.46, 0.64, 0.42, math.floor(size * 0.12))
		local dial = Kit.frame(frame, UDim2.fromScale(0.28, 0.28), UDim2.fromScale(0.36, 0.53))
		dial.BackgroundTransparency = 0
		dial.BackgroundColor3 = P.calls
		Kit.corner(dial, size)
	elseif kind == "calendar" then
		ring(0.1, 0.18, 0.8, 0.72, math.floor(size * 0.14))
		block(0.1, 0.18, 0.8, 0.2, math.floor(size * 0.1))
		block(0.28, 0.06, 0.1, 0.2, 2)
		block(0.62, 0.06, 0.1, 0.2, 2)
		for row = 0, 1 do
			for col2 = 0, 2 do block(0.24 + col2 * 0.2, 0.5 + row * 0.18, 0.12, 0.1, 1) end
		end
	elseif kind == "contacts" then
		local head = Kit.frame(frame, UDim2.fromScale(0.36, 0.36), UDim2.fromScale(0.32, 0.08))
		head.BackgroundTransparency = 0
		head.BackgroundColor3 = col
		Kit.corner(head, size)
		block(0.14, 0.52, 0.72, 0.4, math.floor(size * 0.22))
	elseif kind == "chat" then -- bubble with "AI"
		block(0.06, 0.12, 0.88, 0.62, math.floor(size * 0.2))
		block(0.62, 0.62, 0.2, 0.22, 2)
		local label = Kit.text(frame, "AI", math.floor(size * 0.36), F.black, Color3.fromRGB(20, 26, 28))
		label.AutomaticSize = Enum.AutomaticSize.None
		label.Size = UDim2.fromScale(0.88, 0.62)
		label.Position = UDim2.fromScale(0.06, 0.12)
		label.TextXAlignment = Enum.TextXAlignment.Center
	elseif kind == "settings" then -- gear: ring with four teeth and a hub
		block(0.42, 0.02, 0.16, 0.2, 2)
		block(0.42, 0.78, 0.16, 0.2, 2)
		block(0.02, 0.42, 0.2, 0.16, 2)
		block(0.78, 0.42, 0.2, 0.16, 2)
		ring(0.18, 0.18, 0.64, 0.64, size, math.max(2, size / 9))
		local hub = Kit.frame(frame, UDim2.fromScale(0.24, 0.24), UDim2.fromScale(0.38, 0.38))
		hub.BackgroundTransparency = 0
		hub.BackgroundColor3 = col
		Kit.corner(hub, size)
	elseif kind == "signal" then
		for i = 0, 3 do block(0.04 + i * 0.25, 0.7 - i * 0.2, 0.17, 0.3 + i * 0.2, 1) end
	elseif kind == "battery" then
		ring(0.02, 0.22, 0.82, 0.56, 3, 1.2)
		block(0.1, 0.32, 0.6, 0.36, 1)
		block(0.86, 0.38, 0.1, 0.24, 1)
	elseif kind == "driver" then -- car: body, roof, wheels
		block(0.06, 0.44, 0.88, 0.3, math.floor(size * 0.12))
		block(0.24, 0.22, 0.52, 0.3, math.floor(size * 0.12))
		local w1 = Kit.frame(frame, UDim2.fromScale(0.22, 0.22), UDim2.fromScale(0.16, 0.66))
		w1.BackgroundTransparency = 0
		w1.BackgroundColor3 = Color3.fromRGB(20, 26, 28)
		Kit.corner(w1, size)
		Kit.stroke(w1, 0, col, 1.5)
		local w2 = w1:Clone()
		w2.Position = UDim2.fromScale(0.62, 0.66)
		w2.Parent = frame
	elseif kind == "desk" then -- reception desk with a bell
		block(0.06, 0.56, 0.88, 0.3, 3)
		block(0.36, 0.28, 0.28, 0.22, math.floor(size * 0.14))
		block(0.46, 0.18, 0.08, 0.1, 1)
	elseif kind == "server" then -- rack with blades
		ring(0.16, 0.06, 0.68, 0.88, 3)
		for i = 0, 2 do block(0.26, 0.18 + i * 0.25, 0.48, 0.12, 1) end
	elseif kind == "assistant" then
		local head = Kit.frame(frame, UDim2.fromScale(0.34, 0.34), UDim2.fromScale(0.33, 0.1))
		head.BackgroundTransparency = 0
		head.BackgroundColor3 = col
		Kit.corner(head, size)
		block(0.18, 0.52, 0.64, 0.38, math.floor(size * 0.2))
		block(0.47, 0.52, 0.06, 0.2, 1)
	end
	return frame
end

-- red count bubble at the top-right corner of `parent`
function PhoneKit.badge(parent: Instance, size: number?): Badge
	local s = size or 20
	local frame = Kit.frame(parent, UDim2.fromOffset(s, s), UDim2.new(1, s * 0.25, 0, -s * 0.35))
	frame.Name = "Badge"
	frame.AnchorPoint = Vector2.new(1, 0)
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = P.badge
	frame.AutomaticSize = Enum.AutomaticSize.X
	frame.ZIndex = 5
	frame.Visible = false
	Kit.corner(frame, s)
	Kit.stroke(frame, 0.2, P.screen, 2)
	local label = Kit.text(frame, "", math.floor(s * 0.66), F.bold, C.white)
	label.Name = "Count"
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.new(0, s, 1, 0)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.ZIndex = 6
	Kit.padding(label, 0, math.floor(s * 0.25), 0, math.floor(s * 0.25))
	return {
		frame = frame,
		set = function(n: number)
			frame.Visible = n &gt; 0
			label.Text = if n &gt; 99 then "99+" else tostring(n)
		end,
	}
end

-- home-screen app: rounded colour square with a glyph, label underneath, badge
function PhoneKit.tile(parent: Instance, kind: string, label: string, color: Color3?, order: number, iconSize: number?): Tile
	local s = iconSize or 58
	local button = PhoneKit.tap(parent, UDim2.fromOffset(s + 20, s + 26))
	button.Name = "App_" .. kind
	button.LayoutOrder = order
	button.Selectable = true
	local icon = Kit.frame(button, UDim2.fromOffset(s, s), UDim2.new(0.5, 0, 0, 0))
	icon.AnchorPoint = Vector2.new(0.5, 0)
	icon.BackgroundTransparency = 0
	if color then icon.BackgroundColor3 = color else Theme.bindAccent(icon, "BackgroundColor3") end
	Kit.corner(icon, math.floor(s * 0.26))
	Kit.gradient(icon, C.white, Color3.fromRGB(190, 196, 200), 90)
	local g = PhoneKit.glyph(icon, kind, math.floor(s * 0.56))
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	g.Position = UDim2.fromScale(0.5, 0.5)
	local text = Kit.text(button, label, 13, F.medium, C.text)
	text.AutomaticSize = Enum.AutomaticSize.None
	text.Size = UDim2.new(1, 0, 0, 18)
	text.Position = UDim2.fromOffset(0, s + 5)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextTruncate = Enum.TextTruncate.AtEnd
	local badge = PhoneKit.badge(icon, 22)
	return { button = button, badge = badge }
end

-- round avatar with initials
function PhoneKit.avatar(parent: Instance, text: string, color: Color3, size: number): Frame
	local frame = Kit.frame(parent, UDim2.fromOffset(size, size))
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = color
	Kit.corner(frame, size)
	Kit.gradient(frame, C.white, Color3.fromRGB(170, 176, 182), 90)
	local label = Kit.text(frame, text, math.floor(size * 0.42), F.bold, C.white)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	return frame
end

-- colour of a sender / tone
local SENDER: { [string]: Color3 } = {
	Sales = Color3.fromRGB(64, 156, 236),
	HR = Color3.fromRGB(176, 120, 222),
	["Travel desk"] = Color3.fromRGB(236, 160, 64),
	["Guest house"] = Color3.fromRGB(204, 140, 96),
	["IT desk"] = Color3.fromRGB(96, 170, 200),
	Finance = Color3.fromRGB(208, 186, 80),
	Product = Color3.fromRGB(80, 196, 150),
	Pricing = Color3.fromRGB(120, 180, 120),
	Lab = Color3.fromRGB(150, 140, 230),
	Assistant = Color3.fromRGB(226, 120, 160),
	Company = Color3.fromRGB(120, 134, 150),
}
function PhoneKit.senderColor(from: string): Color3
	return SENDER[from] or SENDER.Company
end
function PhoneKit.toneColor(tone: string): Color3
	return if tone == "good" then C.good elseif tone == "bad" then C.bad elseif tone == "warn" then C.warn else C.muted
end

-- app header: back chevron + title (+ optional right-hand action)
function PhoneKit.header(parent: Instance, title: string, onBack: (() -&gt; ())?, right: string?, onRight: (() -&gt; ())?): (Frame, TextButton?)
	local bar = Kit.frame(parent, UDim2.new(1, 0, 0, 40))
	bar.Name = "Header"
	bar.LayoutOrder = 0
	local x = 14
	if onBack then
		local back = PhoneKit.tap(bar, UDim2.fromOffset(44, 40), UDim2.fromOffset(4, 0))
		back.Name = "Back"
		back.Selectable = true
		local chev = Kit.text(back, "‹", 30, F.bold, Theme.accent)
		Theme.bindAccent(chev, "TextColor3")
		chev.AutomaticSize = Enum.AutomaticSize.None
		chev.Size = UDim2.fromScale(1, 1)
		chev.TextXAlignment = Enum.TextXAlignment.Center
		chev.TextYAlignment = Enum.TextYAlignment.Center
		Kit.onClick(back, onBack)
		x = 46
	end
	local label = Kit.text(bar, title, 20, F.display, C.text)
	label.Name = "Title"
	label.AutomaticSize = Enum.AutomaticSize.None
	label.Size = UDim2.new(1, -x - (if right then 84 else 12), 1, 0)
	label.Position = UDim2.fromOffset(x, 0)
	label.TextTruncate = Enum.TextTruncate.AtEnd
	local action: TextButton? = nil
	if right and onRight then
		local b = PhoneKit.tap(bar, UDim2.fromOffset(76, 30), UDim2.new(1, -10, 0.5, 0))
		b.Name = "HeaderAction"
		b.AnchorPoint = Vector2.new(1, 0.5)
		b.BackgroundTransparency = 0
		b.BackgroundColor3 = P.card2
		b.Text = right
		b.Font = F.bold
		b.TextSize = 13
		b.TextColor3 = C.text
		b.Selectable = true
		Kit.corner(b, 15)
		Kit.onClick(b, onRight)
		action = b
	end
	return bar, action
end

-- on / off switch
function PhoneKit.toggle(parent: Instance, on: boolean, onChange: (on: boolean) -&gt; ()): Toggle
	local b = PhoneKit.tap(parent, UDim2.fromOffset(52, 30))
	b.Name = "Toggle"
	b.BackgroundTransparency = 0
	b.Selectable = true
	Kit.corner(b, 15)
	local knob = Kit.frame(b, UDim2.fromOffset(24, 24), UDim2.new(0, 3, 0.5, 0))
	knob.AnchorPoint = Vector2.new(0, 0.5)
	knob.BackgroundTransparency = 0
	knob.BackgroundColor3 = C.white
	Kit.corner(knob, 12)
	local state = on
	local function paint()
		b.BackgroundColor3 = if state then P.accept else C.raised
		knob.Position = if state then UDim2.new(1, -27, 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
	end
	paint()
	Kit.onClick(b, function()
		state = not state
		paint()
		onChange(state)
	end)
	return {
		frame = b,
		set = function(v: boolean)
			state = v
			paint()
		end,
		get = function(): boolean return state end,
	}
end

-- round call button (accept / decline) with a caption under it
function PhoneKit.callButton(parent: Instance, text: string, color: Color3, order: number, cross: boolean?): TextButton
	local holder = Kit.frame(parent, UDim2.fromOffset(110, 92))
	holder.LayoutOrder = order
	local b = PhoneKit.tap(holder, UDim2.fromOffset(64, 64), UDim2.new(0.5, 0, 0, 0))
	b.Name = "CallButton"
	b.AnchorPoint = Vector2.new(0.5, 0)
	b.BackgroundTransparency = 0
	b.BackgroundColor3 = color
	b.Selectable = true
	Kit.corner(b, 32)
	if cross then
		local x = Kit.text(b, "×", 40, F.bold, C.white)
		x.AutomaticSize = Enum.AutomaticSize.None
		x.Size = UDim2.fromScale(1, 1)
		x.TextXAlignment = Enum.TextXAlignment.Center
	else
		local g = PhoneKit.glyph(b, "calls", 34)
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
	end
	local label = Kit.text(holder, text, 13, F.medium, C.text)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.Size = UDim2.new(1, 0, 0, 22)
	label.Position = UDim2.fromOffset(0, 68)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	return b
end

-- scrolling list body under a header (fills the rest of the screen)
function PhoneKit.body(parent: Instance, top: number?): (ScrollingFrame, Frame)
	local scroll = Kit.scroll(parent, UDim2.new(1, 0, 1, -(top or 40)), UDim2.fromOffset(0, top or 40))
	scroll.Name = "Body"
	scroll.ScrollBarThickness = 3
	scroll.Selectable = false
	local list = Kit.frame(scroll, UDim2.fromScale(1, 0))
	list.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(list, 6)
	Kit.padding(list, 4, 12, 12, 12)
	return scroll, list
end

-- empty-state text in the middle of a list
function PhoneKit.empty(parent: Instance, title: string, text: string, order: number?): Frame
	local box = Kit.frame(parent, UDim2.fromScale(1, 0))
	box.Name = "Empty"
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.LayoutOrder = order or 100
	Kit.list(box, 6).HorizontalAlignment = Enum.HorizontalAlignment.Center
	Kit.padding(box, 24, 10, 10, 10)
	local t = Kit.para(box, title, 16, C.text, 1)
	t.Font = F.bold
	t.TextXAlignment = Enum.TextXAlignment.Center
	local p = Kit.para(box, text, 14, C.muted, 2)
	p.TextXAlignment = Enum.TextXAlignment.Center
	return box
end

return PhoneKit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000054"><Properties><string name="Name">PhoneScreens</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- PhoneScreens (package "phone"): the app screens of the company phone, built into the phone's content area
-- (Screens/Phone owns the frame, status bar, navigation and call banner). Every screen reads only the view
-- model the PhoneController builds from real state (snapshot + PhoneService answers) and returns
--   { sig = view -&gt; string, update = (view -&gt; ())? }
-- Screens/Phone rebuilds a screen when its signature changes, or calls update (chat thread: new bubbles without
-- losing the typed text). Works in both phone shapes: portrait (desktop, consoles) and landscape (phones held
-- sideways, where a portrait phone would be too small to read).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PhoneMath = require(ReplicatedStorage.Shared.PhoneMath)
local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local PhoneKit = require(script.Parent.PhoneKit)

local C = Theme.colors
local F = Theme.font
local P = PhoneKit.colors

local Screens = {}

export type View = {
	company: string,
	status: string,
	dayText: string,
	today: number,
	dayLine: string,
	todayLine: string?,
	goal: { text: string, progress: string, fraction: number }?,
	messages: { any },
	read: { [string]: boolean },
	unread: number,
	calls: { any },
	missed: number,
	results: { [string]: any },
	dial: { [string]: any },
	calendar: { any },
	models: { any },
	chats: { [string]: any },
	settings: { autoTrips: boolean, popups: boolean, saved: boolean },
	phones: number,
	phoneCost: string,
	stage: number,
	hooks: { itinerary: boolean, driver: boolean },
}
export type Deps = {
	markRead: (keys: { string }) -&gt; (),
	readCalls: () -&gt; (),
	answer: (id: string, how: string) -&gt; (),
	dial: (contact: string) -&gt; (),
	setSetting: (key: string, value: boolean) -&gt; (),
	sendChat: (modelId: string, text: string) -&gt; (),
	resetChat: (modelId: string) -&gt; (),
	openComputer: (app: string, section: string?) -&gt; (),
	close: () -&gt; (),
	refresh: () -&gt; (), -- rebuild the full view (calendar, chat models) right before the phone opens
}
export type Ctx = {
	view: View,
	deps: Deps,
	go: (name: string, arg: any?) -&gt; (),
	back: () -&gt; (),
	content: Frame,
	landscape: boolean,
}
-- sig: rebuild when it changes; update: used instead of a rebuild when the sig changes (chat thread);
-- live: called on every new view while the sig is unchanged (clock texts)
export type Built = { sig: (View) -&gt; string, update: ((View) -&gt; ())?, live: ((View) -&gt; ())? }

local CONTACTS = {
	{ id = "assistant", name = "Assistant", glyph = "assistant", color = PhoneKit.senderColor("Assistant"), sub = "Briefing and recommendations" },
	{ id = "driver", name = "Driver", glyph = "driver", color = Color3.fromRGB(236, 160, 64), sub = "Rides to the airport and to clients" },
	{ id = "reception", name = "Reception", glyph = "desk", color = Color3.fromRGB(104, 126, 168), sub = "Visitors, applicants, guest house" },
	{ id = "it", name = "IT desk", glyph = "server", color = Color3.fromRGB(96, 170, 200), sub = "Servers and rack faults" },
}
Screens.CONTACTS = CONTACTS
local function contactDef(id: string): any
	for _, c in CONTACTS do if c.id == id then return c end end
	return CONTACTS[1]
end

local function select(obj: GuiObject?)
	if obj and UserInputService.GamepadEnabled then GuiService.SelectedObject = obj end
end

local function timeText(m: any, today: number): string
	if m.day == today then return PhoneMath.clock(m.hour) end
	if m.day &lt;= 0 then return "" end
	return "Day " .. tostring(m.day)
end

local function card(parent: Instance, order: number, gap: number?): Frame
	local f = Kit.frame(parent, UDim2.fromScale(1, 0))
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.LayoutOrder = order
	f.BackgroundTransparency = 0.05
	f.BackgroundColor3 = P.card
	Kit.corner(f, 14)
	Kit.padding(f, 10, 12, 11, 12)
	Kit.list(f, gap or 4)
	return f
end

------------------------------------------------------------------------------------------------ home
local APPS: { { id: string, label: string, color: Color3? } } = {
	{ id = "messages", label = "Messages", color = P.messages },
	{ id = "calls", label = "Calls", color = P.calls },
	{ id = "calendar", label = "Calendar", color = P.calendar },
	{ id = "contacts", label = "Contacts", color = P.contacts },
	{ id = "chat", label = "AI Chat", color = nil },
	{ id = "settings", label = "Settings", color = P.settings },
}
Screens.APPS = APPS

local function goalCard(parent: Instance, view: View, order: number)
	local g = view.goal
	local box = card(parent, order, 5)
	box.Name = "GoalCard"
	local cap = Kit.text(box, if g then "Next goal" else "Goals", 13, F.bold, Theme.accent)
	Theme.bindAccent(cap, "TextColor3")
	cap.LayoutOrder = 1
	local title = Kit.para(box, if g then g.text else "Every goal is done. Keep growing!", 16, C.text, 2)
	title.Font = F.bold
	if g then
		local bar = Kit.bar(box, 6, 3)
		bar.set(g.fraction)
		Kit.text(box, g.progress, 13, F.medium, C.muted).LayoutOrder = 4
	end
	if view.todayLine then
		local t = Kit.para(box, view.todayLine :: string, 13, C.dim, 5)
		t.TextWrapped = true
	end
end

function Screens.home(ctx: Ctx): Built
	local view = ctx.view
	local root = ctx.content
	local first: GuiObject? = nil
	local function grid(parent: Instance, cell: Vector2, iconSize: number)
		local holder = Kit.frame(parent, UDim2.fromScale(1, 0))
		holder.Name = "Apps"
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.LayoutOrder = 10
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.fromOffset(cell.X, cell.Y)
		layout.CellPadding = UDim2.fromOffset(4, 6)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = holder
		for i, app in APPS do
			local tile = PhoneKit.tile(holder, app.id, app.label, app.color, i, iconSize)
			tile.button.Size = UDim2.fromOffset(cell.X, cell.Y)
			if app.id == "messages" then tile.badge.set(view.unread) elseif app.id == "calls" then tile.badge.set(view.missed) end
			Kit.onClick(tile.button, function() ctx.go(app.id) end)
			if i == 1 then first = tile.button end
		end
	end
	if ctx.landscape then
		local left = Kit.frame(root, UDim2.new(0.44, -6, 1, -8), UDim2.fromOffset(12, 4))
		left.Name = "Left"
		Kit.list(left, 4)
		local clock = Kit.text(left, view.status, 40, F.display, C.text)
		clock.Name = "Clock"
		clock.LayoutOrder = 1
		local date = Kit.text(left, view.dayText .. " · " .. view.company, 13, F.medium, C.muted)
		date.LayoutOrder = 2
		date.AutomaticSize = Enum.AutomaticSize.None
		date.Size = UDim2.new(1, 0, 0, 18)
		date.TextTruncate = Enum.TextTruncate.AtEnd
		local spacer = Kit.frame(left, UDim2.new(1, 0, 0, 4))
		spacer.LayoutOrder = 3
		goalCard(left, view, 4)
		local right = Kit.frame(root, UDim2.new(0.56, -12, 1, -8), UDim2.new(0.44, 6, 0, 4))
		right.Name = "Right"
		Kit.list(right, 0).VerticalAlignment = Enum.VerticalAlignment.Center
		grid(right, Vector2.new(84, 96), 56)
	else
		local stack = Kit.frame(root, UDim2.new(1, -24, 1, -8), UDim2.fromOffset(12, 4))
		stack.Name = "Stack"
		local layout = Kit.list(stack, 6)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		local clock = Kit.text(stack, view.status, 54, F.display, C.text)
		clock.Name = "Clock"
		clock.LayoutOrder = 1
		local date = Kit.text(stack, view.dayText .. " · " .. view.company, 14, F.medium, C.muted)
		date.LayoutOrder = 2
		date.AutomaticSize = Enum.AutomaticSize.None
		date.Size = UDim2.new(1, 0, 0, 18)
		date.TextXAlignment = Enum.TextXAlignment.Center
		date.TextTruncate = Enum.TextTruncate.AtEnd
		local spacer = Kit.frame(stack, UDim2.new(1, 0, 0, 8))
		spacer.LayoutOrder = 3
		goalCard(stack, view, 4)
		local spacer2 = Kit.frame(stack, UDim2.new(1, 0, 0, 6))
		spacer2.LayoutOrder = 5
		grid(stack, Vector2.new(90, 96), 60)
		-- the newest message and the next calendar entry (tap opens them)
		local latest = view.messages[1]
		local nextItem = view.calendar[1]
		local function peek(order: number, name: string, caption: string, title: string, sub: string, color: Color3, onTap: () -&gt; ())
			local row = PhoneKit.tap(stack, UDim2.new(1, 0, 0, 52))
			row.Name = name
			row.LayoutOrder = order
			row.BackgroundTransparency = 0.05
			row.BackgroundColor3 = P.card
			row.Selectable = true
			Kit.corner(row, 14)
			local bar = Kit.frame(row, UDim2.new(0, 4, 1, -18), UDim2.fromOffset(10, 9))
			bar.BackgroundTransparency = 0
			bar.BackgroundColor3 = color
			Kit.corner(bar, 2)
			local cap = Kit.text(row, caption, 12, F.bold, C.dim)
			cap.Position = UDim2.fromOffset(24, 7)
			local t = Kit.text(row, title, 14, F.bold, C.text)
			t.AutomaticSize = Enum.AutomaticSize.None
			t.Size = UDim2.new(1, -36, 0, 18)
			t.Position = UDim2.fromOffset(24, 25)
			t.TextTruncate = Enum.TextTruncate.AtEnd
			local w = Kit.text(row, sub, 12, F.medium, C.dim)
			w.AnchorPoint = Vector2.new(1, 0)
			w.Position = UDim2.new(1, -12, 0, 7)
			Kit.onClick(row, onTap)
		end
		if latest then
			peek(20, "Latest", "Latest · " .. latest.from, latest.title, timeText(latest, view.today), PhoneKit.senderColor(latest.from), function() ctx.go("message", latest.key) end)
		end
		if nextItem then
			peek(21, "NextItem", if nextItem.now then "Under way" else "Next in your calendar", nextItem.title,
				if nextItem.day == view.today or nextItem.now then PhoneMath.clock(nextItem.hour) else "Day " .. nextItem.day, P.calendar, function() ctx.go("calendar") end)
		end
	end
	select(first)
	return {
		sig = function(v: View): string
			local g = v.goal
			local m, n = v.messages[1], v.calendar[1]
			return table.concat({ v.dayText, tostring(v.unread), tostring(v.missed), if g then g.text .. g.progress else "-", v.todayLine or "", v.company,
				if m then m.key else "-", if n then n.key .. n.title else "-" }, "|")
		end,
		live = function(v: View)
			local clock = root:FindFirstChild("Clock", true)
			if clock and clock:IsA("TextLabel") then clock.Text = v.status end
		end,
	}
end

------------------------------------------------------------------------------------------------ messages
function Screens.messages(ctx: Ctx): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "Messages", ctx.back)
	local scroll, list = PhoneKit.body(ctx.content)
	local first: GuiObject? = nil
	local keys = {}
	for i, m in view.messages do
		table.insert(keys, m.key)
		local row = PhoneKit.tap(list, UDim2.new(1, 0, 0, 60))
		row.Name = "Message"
		row.LayoutOrder = i
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = P.card
		row.Selectable = true
		Kit.corner(row, 12)
		local av = PhoneKit.avatar(row, string.sub(m.from, 1, 1), PhoneKit.senderColor(m.from), 38)
		av.Position = UDim2.new(0, 10, 0.5, -19)
		local unread = not view.read[m.key]
		local title = Kit.text(row, m.title, 15, if unread then F.bold else F.medium, C.text)
		title.Name = "Title"
		title.AutomaticSize = Enum.AutomaticSize.None
		title.Size = UDim2.new(1, -118, 0, 20)
		title.Position = UDim2.fromOffset(58, 9)
		title.TextTruncate = Enum.TextTruncate.AtEnd
		local preview = Kit.text(row, m.from .. ": " .. m.body, 13, F.regular, C.muted)
		preview.AutomaticSize = Enum.AutomaticSize.None
		preview.Size = UDim2.new(1, -92, 0, 18)
		preview.Position = UDim2.fromOffset(58, 31)
		preview.TextTruncate = Enum.TextTruncate.AtEnd
		local when = Kit.text(row, timeText(m, view.today), 12, F.medium, C.dim)
		when.AnchorPoint = Vector2.new(1, 0)
		when.Position = UDim2.new(1, -12, 0, 11)
		if unread then
			local dot = Kit.dot(row, Theme.accent, 9)
			Theme.bindAccent(dot, "BackgroundColor3")
			dot.AnchorPoint = Vector2.new(1, 0)
			dot.Position = UDim2.new(1, -14, 0, 35)
		end
		local stripe = Kit.frame(row, UDim2.new(0, 3, 0, 26), UDim2.new(0, 0, 0.5, -13))
		stripe.BackgroundTransparency = if m.tone == "info" then 1 else 0.2
		stripe.BackgroundColor3 = PhoneKit.toneColor(m.tone)
		Kit.corner(stripe, 2)
		Kit.onClick(row, function() ctx.go("message", m.key) end)
		if i == 1 then first = row end
	end
	if #view.messages == 0 then
		PhoneKit.empty(list, "No messages yet", "Your company writes here: new clients, trips, hires, sick days, server faults and goals.")
	end
	select(first)
	local _ = scroll
	ctx.deps.markRead(keys) -- opening the inbox reads it (the list still shows which ones were new)
	return {
		sig = function(v: View): string
			local parts = {}
			for _, m in v.messages do table.insert(parts, m.key) end
			return table.concat(parts, "\n") .. "|" .. tostring(v.today)
		end,
	}
end

function Screens.message(ctx: Ctx, key: any): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "Messages", ctx.back)
	local _, list = PhoneKit.body(ctx.content)
	local m: any = nil
	for _, x in view.messages do if x.key == key then m = x end end
	if not m then
		PhoneKit.empty(list, "Message gone", "Older messages leave the phone after 40 entries.")
	else
		local box = card(list, 1, 8)
		local head = Kit.frame(box, UDim2.new(1, 0, 0, 44))
		head.LayoutOrder = 1
		PhoneKit.avatar(head, string.sub(m.from, 1, 1), PhoneKit.senderColor(m.from), 40)
		local from = Kit.text(head, m.from, 15, F.bold, C.text)
		from.Position = UDim2.fromOffset(50, 2)
		local when = Kit.text(head, if m.day &gt; 0 then "Day " .. m.day .. " · " .. PhoneMath.clock(m.hour) else "", 13, F.medium, C.dim)
		when.Position = UDim2.fromOffset(50, 23)
		local title = Kit.para(box, m.title, 18, C.text, 2)
		title.Name = "Title"
		title.Font = F.bold
		local text = Kit.para(box, m.body, 15, C.text, 3)
		text.Name = "Body"
		if m.tone ~= "info" then
			local tag = Kit.tag(box, if m.tone == "good" then "good news" elseif m.tone == "bad" then "problem" else "heads-up", PhoneKit.toneColor(m.tone), 4)
			tag.Name = "Tone"
		end
		ctx.deps.markRead({ m.key })
	end
	select(ctx.content:FindFirstChild("Back", true) :: GuiObject?)
	return { sig = function(v: View): string
		for _, x in v.messages do if x.key == key then return x.key end end
		return "gone"
	end }
end

------------------------------------------------------------------------------------------------ calls
local function callState(c: any): (string, Color3)
	if c.state == "ringing" then return "Incoming", P.accept end
	if c.state == "missed" then return "Missed", P.decline end
	if c.state == "accepted" then return "Answered", C.muted end
	return "Declined", C.dim
end

function Screens.calls(ctx: Ctx): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "Calls", ctx.back)
	local _, list = PhoneKit.body(ctx.content)
	local first: GuiObject? = nil
	for i, c in view.calls do
		local row = PhoneKit.tap(list, UDim2.new(1, 0, 0, 58))
		row.Name = "Call"
		row.LayoutOrder = i
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = P.card
		row.Selectable = true
		Kit.corner(row, 12)
		local stateText, color = callState(c)
		local icon = Kit.frame(row, UDim2.fromOffset(36, 36), UDim2.new(0, 10, 0.5, -18))
		icon.BackgroundTransparency = 0.75
		icon.BackgroundColor3 = color
		Kit.corner(icon, 18)
		local g = PhoneKit.glyph(icon, "calls", 22, color)
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		local title = Kit.text(row, c.title, 15, F.bold, if c.state == "missed" then C.bad else C.text)
		title.AutomaticSize = Enum.AutomaticSize.None
		title.Size = UDim2.new(1, -120, 0, 20)
		title.Position = UDim2.fromOffset(56, 9)
		title.TextTruncate = Enum.TextTruncate.AtEnd
		local sub = Kit.text(row, tostring(c.from) .. " · " .. stateText, 13, F.medium, C.muted)
		sub.Position = UDim2.fromOffset(56, 31)
		local when = Kit.text(row, timeText(c, view.today), 12, F.medium, C.dim)
		when.AnchorPoint = Vector2.new(1, 0)
		when.Position = UDim2.new(1, -12, 0, 11)
		Kit.onClick(row, function() ctx.go("call", c.id) end)
		if i == 1 then first = row end
	end
	if #view.calls == 0 then
		PhoneKit.empty(list, "No calls yet", "Your assistant calls when something important happens: your first client, a trip abroad, a new office you can afford.")
	end
	ctx.deps.readCalls()
	select(first)
	return { sig = function(v: View): string
		local parts = {}
		for _, c in v.calls do table.insert(parts, c.id .. c.state) end
		return table.concat(parts, ",") .. "|" .. tostring(v.today)
	end }
end

-- one call (incoming, missed or done): who, what, and the decision buttons
function Screens.call(ctx: Ctx, id: any): Built
	local view = ctx.view
	local c: any = nil
	for _, x in view.calls do if x.id == id then c = x end end
	local root = ctx.content
	local result = view.results[tostring(id)]
	if not c then
		PhoneKit.header(root, "Calls", ctx.back)
		local _, list = PhoneKit.body(root)
		PhoneKit.empty(list, "Call ended", "This call is no longer in the call log.")
		return { sig = function(v: View): string return "none" end }
	end
	local stateText = if c.state == "ringing" then "Incoming call" elseif c.state == "missed" then "Missed call · " .. timeText(c, view.today)
		elseif c.state == "accepted" then "Call ended" else "Declined"
	local function who(parent: Instance, order: number)
		local box = Kit.frame(parent, UDim2.fromScale(1, 0))
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.LayoutOrder = order
		Kit.list(box, 4).HorizontalAlignment = Enum.HorizontalAlignment.Center
		local av = PhoneKit.avatar(box, string.sub(tostring(c.from), 1, 1), PhoneKit.senderColor(tostring(c.from)), if ctx.landscape then 64 else 84)
		av.LayoutOrder = 1
		local name = Kit.text(box, tostring(c.from), 22, F.display, C.text)
		name.LayoutOrder = 2
		local st = Kit.text(box, stateText, 14, F.medium, if c.state == "missed" then C.bad else C.muted)
		st.Name = "State"
		st.LayoutOrder = 3
	end
	local function talk(parent: Instance, order: number)
		local box = card(parent, order, 6)
		box.Name = "CallText"
		local title = Kit.para(box, tostring(c.title), 16, C.text, 1)
		title.Font = F.bold
		local text = Kit.para(box, tostring(c.text), 15, C.text, 2)
		text.Name = "Text"
		if result then
			local r = card(parent, order + 1, 4)
			r.Name = "Result"
			r.BackgroundColor3 = P.card2
			Kit.para(r, if typeof(result.text) == "string" then result.text elseif result.pending then "Connecting..." else "Done.", 14, C.text, 1)
		end
	end
	local first: GuiObject? = nil
	local function buttons(parent: Instance, order: number)
		local row = Kit.frame(parent, UDim2.new(1, 0, 0, 96))
		row.Name = "Buttons"
		row.LayoutOrder = order
		local layout = Kit.list(row, 18, true)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		if (c.state == "ringing" or c.state == "missed") and not result then
			local no = PhoneKit.callButton(row, tostring(c.decline), P.decline, 1, true)
			no.Name = "Decline"
			local yes = PhoneKit.callButton(row, tostring(c.accept), P.accept, 2)
			yes.Name = "Accept"
			Kit.onClick(no, function() ctx.deps.answer(c.id, "decline") end)
			Kit.onClick(yes, function() ctx.deps.answer(c.id, "accept") end)
			first = yes
		else
			local done = Kit.button(row, "Done", "secondary", UDim2.fromOffset(150, 42))
			done.Name = "Done"
			Kit.onClick(done, function() ctx.go("home") end)
			first = done
		end
	end
	if ctx.landscape then
		local left = Kit.frame(root, UDim2.new(0.34, 0, 1, -8), UDim2.fromOffset(8, 8))
		local ll = Kit.list(left, 8)
		ll.HorizontalAlignment = Enum.HorizontalAlignment.Center
		who(left, 1)
		local right = Kit.scroll(root, UDim2.new(0.66, -16, 1, -8), UDim2.new(0.34, 8, 0, 4))
		right.Name = "Body"
		local col = Kit.frame(right, UDim2.new(1, -6, 0, 0))
		col.AutomaticSize = Enum.AutomaticSize.Y
		Kit.list(col, 6)
		talk(col, 1)
		-- decisions under the text; once answered, "Done" sits under the caller (always visible)
		buttons(if (c.state == "ringing" or c.state == "missed") and not result then col else left, 5)
	else
		local scroll = Kit.scroll(root, UDim2.new(1, 0, 1, -4), UDim2.fromOffset(0, 4))
		scroll.Name = "Body"
		local col = Kit.frame(scroll, UDim2.fromScale(1, 0))
		col.AutomaticSize = Enum.AutomaticSize.Y
		Kit.list(col, 10)
		Kit.padding(col, 14, 12, 12, 12)
		who(col, 1)
		talk(col, 2)
		buttons(col, 5)
	end
	select(first)
	return { sig = function(v: View): string
		local s = "none"
		for _, x in v.calls do if x.id == id then s = x.state end end
		local r = v.results[tostring(id)]
		return s .. "|" .. (if r then tostring(r.text) .. tostring(r.pending) else "-")
	end }
end

------------------------------------------------------------------------------------------------ calendar
function Screens.calendar(ctx: Ctx): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "Calendar", ctx.back)
	local _, list = PhoneKit.body(ctx.content)
	local today = card(list, 1, 3)
	today.Name = "Today"
	local t = Kit.text(today, view.dayText .. " · " .. view.status, 17, F.bold, C.text)
	t.Name = "Now"
	t.LayoutOrder = 1
	Kit.para(today, view.dayLine, 13, C.muted, 2)
	local order = 10
	local lastSection = ""
	for _, item in view.calendar do
		local section = if item.now then "Under way" elseif item.day == view.today then "Today" else "Coming up"
		if section ~= lastSection then
			lastSection = section
			order += 1
			local cap = Kit.caption(list, section, order)
			cap.Name = "Section"
			Kit.padding(cap, 6, 0, 0, 4)
		end
		order += 1
		local row = Kit.frame(list, UDim2.fromScale(1, 0))
		row.Name = "Item"
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.LayoutOrder = order
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = P.card
		Kit.corner(row, 12)
		Kit.padding(row, 9, 10, 10, 10)
		local timeCol = Kit.frame(row, UDim2.new(0, 56, 0, 0))
		timeCol.AutomaticSize = Enum.AutomaticSize.Y
		Kit.list(timeCol, 0)
		local stripeColor = if item.kind == "flight" then Color3.fromRGB(64, 156, 236) elseif item.kind == "renewal" then C.warn elseif item.kind == "trip" then P.calls else Theme.accent
		if item.now and typeof(item.tag) == "string" then Kit.text(timeCol, item.tag, 12, F.medium, C.dim).LayoutOrder = 0 end
		local hh = Kit.text(timeCol, if item.day == view.today then PhoneMath.clock(item.hour) else "Day " .. item.day, 14, F.bold, stripeColor)
		hh.Name = "When"
		hh.LayoutOrder = 1
		if item.day ~= view.today then Kit.text(timeCol, PhoneMath.clock(item.hour), 12, F.medium, C.dim).LayoutOrder = 2 end
		local textCol = Kit.frame(row, UDim2.new(1, -62, 0, 0), UDim2.fromOffset(62, 0))
		textCol.AutomaticSize = Enum.AutomaticSize.Y
		Kit.list(textCol, 2)
		local title = Kit.para(textCol, item.title, 14, C.text, 1)
		title.Font = F.bold
		Kit.para(textCol, item.detail, 13, C.muted, 2)
	end
	if #view.calendar == 0 then
		PhoneKit.empty(list, "Nothing planned", "Client visits, trips abroad, contract check-ins and flights show up here as your company grows.", 50)
	end
	select(ctx.content:FindFirstChild("Back", true) :: GuiObject?)
	return {
		sig = function(v: View): string
			local parts = { v.dayText, v.dayLine }
			for _, item in v.calendar do table.insert(parts, item.key .. item.detail) end
			return table.concat(parts, "\n")
		end,
		live = function(v: View) t.Text = v.dayText .. " · " .. v.status end,
	}
end

------------------------------------------------------------------------------------------------ contacts
function Screens.contacts(ctx: Ctx): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "Contacts", ctx.back)
	local _, list = PhoneKit.body(ctx.content)
	local first: GuiObject? = nil
	for i, def in CONTACTS do
		local row = PhoneKit.tap(list, UDim2.new(1, 0, 0, 60))
		row.Name = "Contact_" .. def.id
		row.LayoutOrder = i
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = P.card
		row.Selectable = true
		Kit.corner(row, 12)
		local icon = Kit.frame(row, UDim2.fromOffset(40, 40), UDim2.new(0, 10, 0.5, -20))
		icon.BackgroundTransparency = 0
		icon.BackgroundColor3 = def.color
		Kit.corner(icon, 12)
		local g = PhoneKit.glyph(icon, def.glyph, 24)
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		local name = Kit.text(row, def.name, 15, F.bold, C.text)
		name.Position = UDim2.fromOffset(60, 10)
		local subText = def.sub
		if def.id == "driver" and view.stage &lt; 2 then subText = "Starts at the Founder Headquarters"
		elseif def.id == "driver" and not view.hooks.driver then subText = "Ride service coming soon"
		elseif def.id == "reception" and view.stage &lt; 2 then subText = "Opens at the Founder Headquarters" end
		local sub = Kit.text(row, subText, 13, F.regular, C.muted)
		sub.AutomaticSize = Enum.AutomaticSize.None
		sub.Size = UDim2.new(1, -130, 0, 18)
		sub.Position = UDim2.fromOffset(60, 32)
		sub.TextTruncate = Enum.TextTruncate.AtEnd
		local pill = Kit.frame(row, UDim2.fromOffset(56, 28), UDim2.new(1, -10, 0.5, 0))
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.BackgroundTransparency = 0
		pill.BackgroundColor3 = P.accept
		Kit.corner(pill, 14)
		local pg = PhoneKit.glyph(pill, "calls", 18)
		pg.AnchorPoint = Vector2.new(0.5, 0.5)
		pg.Position = UDim2.fromScale(0.5, 0.5)
		Kit.onClick(row, function()
			if def.id == "assistant" then
				ctx.deps.dial("assistant")
			else
				ctx.go("dial", def.id)
				ctx.deps.dial(def.id)
			end
		end)
		if i == 1 then first = row end
	end
	local note = Kit.para(list, "Your assistant opens her briefing. Reception and IT answer with live company data.", 12, C.dim, 20)
	note.TextXAlignment = Enum.TextXAlignment.Center
	select(first)
	return { sig = function(v: View): string return tostring(v.stage) .. tostring(v.hooks.driver) end }
end

function Screens.dial(ctx: Ctx, contact: any): Built
	local view = ctx.view
	local def = contactDef(tostring(contact))
	local root = ctx.content
	local r = view.dial[def.id]
	local function who(parent: Instance, order: number, big: number)
		local box = Kit.frame(parent, UDim2.fromScale(1, 0))
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.LayoutOrder = order
		Kit.list(box, 6).HorizontalAlignment = Enum.HorizontalAlignment.Center
		local icon = Kit.frame(box, UDim2.fromOffset(big, big))
		icon.LayoutOrder = 1
		icon.BackgroundTransparency = 0
		icon.BackgroundColor3 = def.color
		Kit.corner(icon, big)
		local g = PhoneKit.glyph(icon, def.glyph, math.floor(big * 0.58))
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		local name = Kit.text(box, def.name, 22, F.display, C.text)
		name.LayoutOrder = 2
		local st = Kit.text(box, if r == nil or r.pending then "Calling..." else "Connected", 14, F.medium, C.muted)
		st.Name = "State"
		st.LayoutOrder = 3
	end
	local function reply(parent: Instance, order: number)
		if r and not r.pending then
			local box = card(parent, order, 4)
			box.Name = "Reply"
			Kit.para(box, if typeof(r.text) == "string" and r.text ~= "" then r.text else "Nobody answered.", 15, C.text, 1).Name = "Text"
			if r.soon then
				local tag = Kit.tag(box, "coming soon", C.warn, 2)
				tag.Name = "Soon"
			end
		end
	end
	local function hangUp(parent: Instance, order: number): TextButton
		local hang = PhoneKit.tap(parent, UDim2.fromOffset(64, 64))
		hang.Name = "HangUp"
		hang.LayoutOrder = order
		hang.BackgroundTransparency = 0
		hang.BackgroundColor3 = P.decline
		hang.Selectable = true
		Kit.corner(hang, 32)
		local x = Kit.text(hang, "×", 40, F.bold, C.white)
		x.AutomaticSize = Enum.AutomaticSize.None
		x.Size = UDim2.fromScale(1, 1)
		x.TextXAlignment = Enum.TextXAlignment.Center
		Kit.onClick(hang, ctx.back)
		return hang
	end
	local hang
	if ctx.landscape then
		local left = Kit.frame(root, UDim2.new(0.34, 0, 1, -8), UDim2.fromOffset(8, 8))
		Kit.list(left, 10).HorizontalAlignment = Enum.HorizontalAlignment.Center
		who(left, 1, 56)
		hang = hangUp(left, 2)
		local right = Kit.scroll(root, UDim2.new(0.66, -16, 1, -8), UDim2.new(0.34, 8, 0, 8))
		right.Name = "Body"
		local col = Kit.frame(right, UDim2.new(1, -6, 0, 0))
		col.AutomaticSize = Enum.AutomaticSize.Y
		Kit.list(col, 6)
		reply(col, 1)
	else
		local scroll = Kit.scroll(root, UDim2.new(1, 0, 1, -4), UDim2.fromOffset(0, 4))
		scroll.Name = "Body"
		local col = Kit.frame(scroll, UDim2.fromScale(1, 0))
		col.AutomaticSize = Enum.AutomaticSize.Y
		Kit.list(col, 10).HorizontalAlignment = Enum.HorizontalAlignment.Center
		Kit.padding(col, 18, 12, 12, 12)
		who(col, 1, 76)
		reply(col, 4)
		hang = hangUp(col, 6)
	end
	select(hang)
	return { sig = function(v: View): string
		local x = v.dial[def.id]
		return if x == nil then "nil" else tostring(x.pending) .. tostring(x.text)
	end }
end

------------------------------------------------------------------------------------------------ AI chat
function Screens.chat(ctx: Ctx): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "AI Chat", ctx.back)
	local _, list = PhoneKit.body(ctx.content)
	local first: GuiObject? = nil
	for i, m in view.models do
		local row = PhoneKit.tap(list, UDim2.new(1, 0, 0, 62))
		row.Name = "Model"
		row.LayoutOrder = i
		row.BackgroundTransparency = 0.05
		row.BackgroundColor3 = P.card
		row.Selectable = true
		Kit.corner(row, 12)
		local icon = Kit.frame(row, UDim2.fromOffset(40, 40), UDim2.new(0, 10, 0.5, -20))
		icon.BackgroundTransparency = if m.live then 0 else 0.5
		Theme.bindAccent(icon, "BackgroundColor3")
		Kit.corner(icon, 12)
		local g = PhoneKit.glyph(icon, "chat", 26)
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		local title = Kit.text(row, m.title, 15, F.bold, C.text)
		title.Position = UDim2.fromOffset(60, 9)
		local tag = Kit.text(row, if m.live then "LIVE" else "RETIRED", 11, F.bold, if m.live then C.good else C.dim)
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.new(1, -12, 0, 11)
		local score = Kit.text(row, string.format("%.0f", m.overall), 15, F.bold, C.text)
		score.Name = "Overall"
		score.AnchorPoint = Vector2.new(1, 0)
		score.Position = UDim2.new(1, -12, 0, 31)
		local line = Kit.text(row, tostring(m.sub), 13, F.regular, C.muted)
		line.AutomaticSize = Enum.AutomaticSize.None
		line.Size = UDim2.new(1, -104, 0, 18)
		line.Position = UDim2.fromOffset(60, 33)
		line.TextTruncate = Enum.TextTruncate.AtEnd
		Kit.onClick(row, function() ctx.go("thread", m.id) end)
		if i == 1 then first = row end
	end
	if #view.models == 0 then
		PhoneKit.empty(list, "No released model yet", "Train a model in the Lab and release it. Then you can chat with it here.", 50)
		local open = Kit.button(list, "Open the Lab", "primary", UDim2.fromOffset(170, 40))
		open.Name = "OpenLab"
		open.LayoutOrder = 51
		Kit.onClick(open, function() ctx.deps.openComputer("lab") end)
		local holder = list:FindFirstChildOfClass("UIListLayout")
		if holder then holder.HorizontalAlignment = Enum.HorizontalAlignment.Center end
		first = open
	else
		local note = Kit.para(list, "Chat with your released models. Replies come from Roblox's text generator when it is available; otherwise you get clearly labelled demo replies.", 12, C.dim, 90)
		note.TextXAlignment = Enum.TextXAlignment.Center
	end
	select(first)
	return { sig = function(v: View): string
		local parts = {}
		for _, m in v.models do table.insert(parts, m.id .. m.line .. tostring(m.live) .. tostring(m.overall)) end
		return table.concat(parts, ",")
	end }
end

local function bubble(list: Instance, turn: any, order: number)
	local holder = Kit.frame(list, UDim2.fromScale(1, 0))
	holder.Name = "Turn"
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.LayoutOrder = order
	if turn.who == "system" then
		local t = Kit.para(holder, tostring(turn.text), 12, C.dim, 1)
		t.Name = "System"
		t.TextXAlignment = Enum.TextXAlignment.Center
		return
	end
	local mine = turn.who == "you"
	local b = Kit.frame(holder, UDim2.new(0.82, 0, 0, 0))
	b.Name = if mine then "You" else "Model"
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.BackgroundTransparency = 0
	if mine then
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.fromScale(1, 0)
		Theme.bindAccent(b, "BackgroundColor3", Theme.tint(0.55))
	else
		b.BackgroundColor3 = P.card2
	end
	Kit.corner(b, 14)
	Kit.padding(b, 7, 11, 8, 11)
	Kit.list(b, 2)
	if not mine and typeof(turn.label) == "string" then
		local demo = turn.source ~= "ai"
		local label = Kit.text(b, turn.label, 11, F.bold, if demo then C.warn else Theme.accent)
		label.Name = "Label"
		label.LayoutOrder = 0
		if not demo then Theme.bindAccent(label, "TextColor3") end
	end
	local text = Kit.para(b, tostring(turn.text), 15, if turn.pending then C.muted else C.text, 1)
	text.Name = "Text"
	if turn.failed then
		local f = Kit.text(b, "not sent", 11, F.medium, C.bad)
		f.LayoutOrder = 2
	end
end

function Screens.thread(ctx: Ctx, modelId: any): Built
	local view = ctx.view
	local id = tostring(modelId)
	local model: any = nil
	for _, m in view.models do if m.id == id then model = m end end
	local root = ctx.content
	local bar = PhoneKit.header(root, if model then model.title else "AI Chat", ctx.back, "Clear", function() ctx.deps.resetChat(id) end)
	local _ = bar
	if not model then
		local _, list = PhoneKit.body(root)
		PhoneKit.empty(list, "Model not available", "Only released models can chat.")
		return { sig = function(v: View): string return "none" end }
	end
	local inputH = if ctx.landscape then 46 else 50
	local top = 40
	if not ctx.landscape then -- landscape keeps the room for the conversation
		local sub = Kit.text(root, tostring(model.sub) .. " · " .. string.format("%.0f", model.overall) .. " overall" .. (if model.live then "" else " · retired"), 12, F.medium, C.dim)
		sub.Name = "ModelLine"
		sub.AutomaticSize = Enum.AutomaticSize.None
		sub.Size = UDim2.new(1, -24, 0, 16)
		sub.Position = UDim2.fromOffset(14, 38)
		sub.TextTruncate = Enum.TextTruncate.AtEnd
		top = 56
	end
	local scroll = Kit.scroll(root, UDim2.new(1, 0, 1, -(top + inputH)), UDim2.fromOffset(0, top))
	scroll.Name = "Thread"
	scroll.ScrollBarThickness = 3
	local list = Kit.frame(scroll, UDim2.fromScale(1, 0))
	list.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(list, 6)
	Kit.padding(list, 4, 12, 8, 12)
	bubble(list, { who = "system", text = "Chat with " .. model.title .. ". Nothing you write here changes your company." }, 0)
	local shown = 0
	local typing: Frame? = nil
	local function toBottom()
		task.defer(function()
			if scroll.Parent then scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y)) end
		end)
	end
	local function sync(v: View)
		local chat = v.chats[id]
		local turns = if chat then chat.turns else {}
		if #turns &lt; shown then
			for _, child in list:GetChildren() do if child.Name == "Turn" and child:IsA("GuiObject") and child.LayoutOrder &gt; 0 then child:Destroy() end end
			shown = 0
		end
		-- a pending line of the player may have been replaced by its filtered text: redraw from the first change
		for i = shown + 1, #turns do bubble(list, turns[i], i) end
		for _, child in list:GetChildren() do
			if child.Name == "Turn" and child:IsA("GuiObject") and child.LayoutOrder &gt; 0 and child.LayoutOrder &lt;= #turns then
				local turn = turns[child.LayoutOrder]
				local textLabel = child:FindFirstChild("Text", true)
				if textLabel and textLabel:IsA("TextLabel") and textLabel.Text ~= tostring(turn.text) then textLabel.Text = tostring(turn.text) end
				if textLabel and textLabel:IsA("TextLabel") then textLabel.TextColor3 = if turn.pending then C.muted else C.text end
			end
		end
		shown = #turns
		local waiting = chat ~= nil and chat.waiting == true
		if waiting and not typing then
			local holder = Kit.frame(list, UDim2.fromScale(1, 0))
			holder.Name = "Typing"
			holder.AutomaticSize = Enum.AutomaticSize.Y
			holder.LayoutOrder = 100000
			local b = Kit.frame(holder, UDim2.fromOffset(64, 30))
			b.BackgroundTransparency = 0
			b.BackgroundColor3 = P.card2
			Kit.corner(b, 14)
			local dots = Kit.text(b, "...", 18, F.bold, C.muted)
			dots.AutomaticSize = Enum.AutomaticSize.None
			dots.Size = UDim2.fromScale(1, 1)
			dots.TextXAlignment = Enum.TextXAlignment.Center
			typing = holder
		elseif not waiting and typing then
			(typing :: Frame):Destroy()
			typing = nil
		end
		toBottom()
	end
	-- input row
	local inputRow = Kit.frame(root, UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 1, -(inputH - 4)))
	inputRow.Name = "InputRow"
	local box = Kit.input(inputRow, "Message " .. model.title, UDim2.new(1, -50, 1, 0))
	box.Name = "ChatInput"
	box.TextSize = 15
	box.BackgroundColor3 = P.card2
	box.BackgroundTransparency = 0
	local send = PhoneKit.tap(inputRow, UDim2.fromOffset(40, 40), UDim2.new(1, 0, 0, 0))
	send.Name = "Send"
	send.AnchorPoint = Vector2.new(1, 0)
	send.BackgroundTransparency = 0
	send.Selectable = true
	Theme.bindAccent(send, "BackgroundColor3")
	Kit.corner(send, 20)
	local arrow = Kit.text(send, "›", 28, F.bold, C.bg)
	arrow.AutomaticSize = Enum.AutomaticSize.None
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	local function submit()
		local text = box.Text
		if not string.match(text, "%S") then return end
		local chat = ctx.view.chats[id]
		if chat and chat.waiting then return end
		box.Text = ""
		ctx.deps.sendChat(id, text)
	end
	Kit.onClick(send, submit)
	box.FocusLost:Connect(function(enter: boolean) if enter then submit() end end)
	-- limit the typed text to the server's length (characters)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local n = utf8.len(box.Text)
		if n and n &gt; PhoneMath.CHAT_MAX_CHARS then
			local cut = utf8.offset(box.Text, PhoneMath.CHAT_MAX_CHARS + 1)
			if cut then box.Text = string.sub(box.Text, 1, cut - 1) end
		end
	end)
	sync(view)
	select(send)
	local _ = Players
	return {
		sig = function(v: View): string
			local chat = v.chats[id]
			if not chat then return "0" end
			local last = chat.turns[#chat.turns]
			return tostring(#chat.turns) .. tostring(chat.waiting) .. (if last then tostring(last.text) .. tostring(last.pending) else "")
		end,
		update = sync,
	}
end

------------------------------------------------------------------------------------------------ settings
function Screens.settings(ctx: Ctx): Built
	local view = ctx.view
	PhoneKit.header(ctx.content, "Settings", ctx.back)
	local _, list = PhoneKit.body(ctx.content)
	local function toggleRow(order: number, title: string, desc: string, on: boolean, key: string): Frame
		local box = card(list, order, 6)
		box.Name = "Setting_" .. key
		local top = Kit.frame(box, UDim2.new(1, 0, 0, 32))
		top.LayoutOrder = 1
		local t = Kit.text(top, title, 15, F.bold, C.text)
		t.AutomaticSize = Enum.AutomaticSize.None
		t.Size = UDim2.new(1, -64, 1, 0)
		t.TextWrapped = true
		local tg = PhoneKit.toggle(top, on, function(v: boolean) ctx.deps.setSetting(key, v) end)
		tg.frame.AnchorPoint = Vector2.new(1, 0.5)
		tg.frame.Position = UDim2.new(1, 0, 0.5, 0)
		Kit.para(box, desc, 13, C.muted, 2)
		return box
	end
	local trips = toggleRow(1, "Join business trips automatically",
		"When a client meeting needs you, the trip starts by itself after a short countdown you can cancel. Off: your assistant asks first.", view.settings.autoTrips, "autoTrips")
	local status = Kit.para(trips, (if view.settings.saved then "Saved with your company." else "Kept for this session.")
		.. (if view.hooks.itinerary then "" else " The travel desk that uses it is coming soon."), 12, C.dim, 3)
	status.Name = "SaveState"
	toggleRow(2, "Call pop-ups", "Show a banner when someone calls. Off: calls go straight to Calls.", view.settings.popups, "popups")
	local info = card(list, 3, 4)
	info.Name = "PhoneInfo"
	local t = Kit.text(info, "Company phones", 15, F.bold, C.text)
	t.LayoutOrder = 1
	Kit.para(info, view.phoneCost, 13, C.muted, 2).Name = "Cost"
	Kit.para(info, if UserInputService.KeyboardEnabled then "Shortcut: P opens and closes the phone." else "Tip: the phone button sits in the bottom-right corner.", 12, C.dim, 3)
	select(ctx.content:FindFirstChild("Toggle", true) :: GuiObject?)
	return { sig = function(v: View): string
		return tostring(v.settings.autoTrips) .. tostring(v.settings.popups) .. tostring(v.settings.saved) .. v.phoneCost .. tostring(v.hooks.itinerary)
	end }
end

return Screens
</ProtectedString></Properties></Item></Item></Item><Item class="LocalScript" referent="RBX00000057"><Properties><string name="Name">Main</string><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">--!strict
-- Client-Einstieg: UI aufbauen, Welt verbinden, Zustand vom Server abholen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end
ReplicatedStorage:WaitForChild("Shared")

local Client = script.Parent
local CompanyConfig = require(ReplicatedStorage.Shared.Config.CompanyConfig)
local StateController = require(Client.Controllers.StateController)
local WorldController = require(Client.Controllers.WorldController)
local CampusController=require(Client.Controllers.CampusController)
local SecurityController=require(Client.Controllers.SecurityController)
local EmployeeController=require(Client.Controllers.EmployeeController)
local JourneyController=require(Client.Controllers.JourneyController)
local BuildingEffectsController=require(Client.Controllers.BuildingEffectsController)
local PeopleController=require(Client.Controllers.PeopleController)
local PropFxController=require(Client.Controllers.PropFxController)
local TalkController=require(Client.Controllers.TalkController)
local TravelController=require(Client.Controllers.TravelController)
local CityLifeController=require(Client.Controllers.CityLifeController)
local PhoneController=require(Client.Controllers.PhoneController)
local Theme = require(Client.UI.Theme)
local UIRoot = require(Client.UI.UIRoot)
local Toast = require(Client.UI.Toast)
local HUD = require(Client.UI.Screens.HUD)
local Computer = require(Client.UI.Screens.Computer)
local Intro = require(Client.UI.Screens.Intro)
local DebugPanel = require(Client.UI.DebugPanel)
local AdminPanel=require(Client.UI.AdminPanel)

-- Platz für das eigene HUD oben rechts: Spielerliste und Rucksack braucht das Spiel nicht
for _, coreType in { Enum.CoreGuiType.PlayerList } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreType, false)
	end)
end

local hud, dimLayer, overlay, introLayer, top = UIRoot.init()
Toast.mount(top)
AdminPanel.mount(top)

local devAllowed = DebugPanel.allowed()
HUD.mount(hud, devAllowed, DebugPanel.toggle)
HUD.setHidden(true)
Computer.mount(overlay, dimLayer)
Intro.mount(introLayer, {
	onFinish = function()
		HUD.setHidden(false)
	end,
	onReopen = function()
		Computer.close()
		HUD.setHidden(true)
	end,
})
if devAllowed then
	DebugPanel.mount(top)
end

-- Firmenfarbe = Akzentfarbe der gesamten UI
StateController.onChange(function(snapshot)
	local company = snapshot.data.company
	if company then
		local def = CompanyConfig.getColor(company.color)
		if def then
			Theme.setAccent(Theme.rgb(def.rgb))
		end
	end
end)

WorldController.init(function(appId,section)
	Computer.open(appId,section)
end)
CampusController.init()
SecurityController.init()
EmployeeController.init()
JourneyController.init()
BuildingEffectsController.init()
PropFxController.init()
TalkController.init()
TravelController.init()
CityLifeController.init()
PhoneController.init()
-- Bewerbungsgespräche + Assistentin der Gründerin (öffnet bei Bedarf den Firmen-Computer)
PeopleController.init(function(appId,section)
	Computer.open(appId,section)
end)
StateController.init()
