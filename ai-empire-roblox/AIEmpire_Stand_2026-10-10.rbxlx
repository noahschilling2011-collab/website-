local function quietZone(inside: Instance)
	local m=folder(inside,"QuietZone")
	for i,x in {48,58,68,78,124,134,144,154} do
		local f=CFrame.lookAt(Vector3.new(x,F,2522),Vector3.new(x,F,2530))
		lbox(f,m,"LoungerBase",-1.3,1.3,0,1.2,-2.6,2.6,C.metal,M.Metal)
		local back=wedge(m,"LoungerBack",Vector3.new(2.6,2.6,2.2),f*CFrame.new(0,2.5,1.5),pick({C.fabricSand,C.sage},i),M.Fabric,true)
		local _=back
		lbox(f,m,"LoungerPad",-1.3,1.3,1.2,1.6,-2.6,1,pick({C.fabricSand,C.sage},i),M.Fabric,true)
	end
	for _,x in {90,112} do
		post(m,"ChargingTotem",x,2512,F,F+4.4,1.2,C.white,SM)
		screen(m,"ChargingScreen",Vector3.new(x,F+5.2,2511.3),Vector3.new(0,0,-1),1.6,1,"USB · POWER",rgb(140,220,230))
	end
	box(m,"KidsMat",92,110,F,F+.15,2516,2528,rgb(90,150,190),M.Rubber,true)
	for i=0,3 do
		local x=94+i*4
		box(m,"PlayBlock",x,x+2.4,F+.15,F+2.2+(i%2),2519,2521.4,pick({rgb(230,90,70),rgb(250,200,60),rgb(90,180,110),rgb(240,140,60)},i),SM)
	end
	wedge(m,"KidsSlide",Vector3.new(2.4,3,6),CFrame.new(106,F+1.65,2524),rgb(240,140,60),SM)
	panel(m,"KidsSign",Vector3.new(101,F+7,2515.8),Vector3.new(0,0,-1),8,1.6,rgb(90,150,190),"KIDS CORNER",{ink=INK})
	box(m,"WorkCounter",118,156,F,F+3.6,2508.5,2510.5,C.oak,M.Wood)
	for x=120,154,4.2 do stool(m,x,2511.8,3.2,C.fabricCharcoal) end
	for i,x in {44,86,116} do planter(m,x,2526,3,3,true,i) end
	hangingSign(m,100,2507,G+13,20,"QUIET ZONE  ·  RELAX &amp; RECHARGE",nil,roofY(2507)-.2)
	local l=post(m,"QuietLight",100,2518,G+18,G+18.6,4,C.lightWarm,M.Neon,true)
	box(m,"PendantRod",99.94,100.06,G+18.6,roofY(2518)-.2,2517.94,2518.06,C.metal,M.Metal,true)
	kit.light(l,56,.9,C.lightWarm)
end

-- Gate lounge i (gate centre gx, jet-bridge door at bx in the back facade).
local function gateLounge(inside: Instance,i: number,gx: number,bx: number)
	local m=folder(inside,"GateA"..i)
	local code="A"..i
	box(m,"GateCarpet",gx-35,gx+35,F,F+.04,2508.5,BACK-1,rgb(66,80,100),M.Carpet,true)
	box(m,"GateCarpetEdge",gx-35,gx+35,F,F+.05,2508.2,2508.5,C.brass,M.Metal,true)
	-- only the shuttle gate has a flight (FlightPlan: one aircraft); the other gates are closed
	local shuttle=i==A.shuttleStand
	local signText=if shuttle then code.."   "..OUT_NO.."  PORT MERIDIAN\nSHUTTLE GATE" else code.."\nGATE CLOSED"
	-- desk to the east of the bridge door, boarding lane between belts
	box(m,"GateDesk",bx+5,bx+14,F,F+3.6,2519.5,2523,C.white,M.Marble)
	box(m,"GateDeskFront",bx+5,bx+14,F+.4,F+3.2,2519.3,2519.5,BRAND,SM,true)
	for _,dx in {7,11.5} do box(m,"GateMonitor",bx+dx-.9,bx+dx+.9,F+3.6,F+4.9,2521.6,2521.8,C.screen,SM,true) end
	for _,s in {-1,1} do
		local x=bx+s*4
		box(m,"BoardingBelt",x-.05,x+.05,F+2.6,F+2.85,2514,2528,NAVY,M.Fabric,true)
		for _,z in {2514,2521,2528} do post(m,"QueuePost",x,z,F,F+3,.32,C.metalSoft,M.Metal,true) end
	end
	local door=panel(m,"GateDoorSign",Vector3.new(bx,F+10.6,BACK-1.1),Vector3.new(0,0,-1),7,1.5,NAVY,if shuttle then code.."  ·  "..OUT_NO else code.."  ·  CLOSED",{ink=INK})
	if shuttle then flightInfo(door,"gatedoor",code) end
	-- hanging gate sign (double-sided) and a number totem on the concourse
	local sign=panel(m,"GateSign",Vector3.new(bx+9.5,G+14.5,2516),Vector3.new(0,0,-1),16,4,NAVY,signText,{ink=INK},signText)
	if shuttle then flightInfo(sign,"gate",code) end
	for _,s in {-1,1} do box(m,"SignRod",sign.Position.X+s*7-.08,sign.Position.X+s*7+.08,G+16.5,roofY(2516)-.2,2515.92,2516.08,C.metal,M.Metal,true) end
	box(m,"GateTotem",gx+33,gx+35,F,F+10,2506.6,2508,NAVY,SM)
	panel(m,"GateTotemNumber",Vector3.new(gx+34,F+8.2,2506.4),Vector3.new(0,0,-1),2,3,BRAND,code,{ink=INK})
	-- seats: back-to-back rows east and west of the desk, facing the windows and the desk
	planSeats(m,code) -- CityPlan rows: west of bx-6, east of bx+17 (tests/airport checks the desk lane stays free)
	if shuttle then
		-- passengers' cabin bags in the aisles of the shuttle gate
		for k=0,3 do
			local h=hash(code.."bag"..k)
			local x=if k&lt;2 then gx-31+(h%(bx-gx+21)) else bx+19+(h%12)
			suitcase(m,x,if k==1 then 2521.6 else 2515.2,h)
		end
		loadedTrolley(m,CFrame.new(gx-20,F,2518)*CFrame.Angles(0,math.rad(-90),0),hash(code))
	end
	post(m,"ChargingTotem",bx+16,2511.5,F,F+4.4,1.2,C.white,SM)
	airportPost(m,"gate",Vector3.new(bx+9.5,F+3,2525),Vector3.new(0,0,-1),code)
	local l=post(m,"GateLight",gx,2517,G+18,G+18.6,4,C.lightNeutral,M.Neon,true)
	box(m,"PendantRod",gx-.06,gx+.06,G+18.6,roofY(2517)-.2,2516.94,2517.06,C.metal,M.Metal,true)
	kit.light(l,58,1,C.lightNeutral)
end

local function airsideSigns(inside: Instance)
	local m=folder(inside,"Wayfinding")
	hangingSign(m,-120,2503,G+13.5,24,"←  GATE A1  ·  BUSINESS LOUNGE","GATES A2 – A3  ·  FOOD COURT  →",roofY(2503)-.2)
	hangingSign(m,0,2503,G+13.5,30,"←  A1  ·  LOUNGE      A2  ↓      A3  ·  FOOD  →",nil,roofY(2503)-.2)
	hangingSign(m,110,2503,G+13.5,24,"←  GATES A1 – A2  ·  LOUNGE","GATE A3  ·  FOOD COURT  →",roofY(2503)-.2)
	hangingSign(m,200,2503,G+13.5,20,"↑  RESTROOMS  ·  FOOD COURT  →","←  GATES A1 – A2",roofY(2503)-.2)
	for _,x in {-30,30} do
		post(m,"MonitorPost",x,2501,F,F+7.5,.4,C.metal,M.Metal)
		flightInfo(screen(m,"DepartureMonitor",Vector3.new(x,F+8.6,2500.75),Vector3.new(0,0,-1),3.6,2.2,MONITOR),"monitor")
		flightInfo(screen(m,"DepartureMonitor",Vector3.new(x,F+8.6,2501.25),Vector3.new(0,0,1),3.6,2.2,MONITOR),"monitor")
	end
	local c=post(m,"AirsideLight",0,2504,G+18,G+18.6,4,C.lightNeutral,M.Neon,true)
	box(m,"PendantRod",-.06,.06,G+18.6,roofY(2504)-.2,2503.94,2504.06,C.metal,M.Metal,true)
	kit.light(c,58,1,C.lightNeutral)
end

------------------------------------------------------------------------------------------------ vehicles
-- Built in frame f: origin on the ground under the vehicle centre, -Z (LookVector) = forward. Decor only.
-- One cylinder per axle (both wheels; the body hides the middle) - half the parts of two wheels.
local function wheels(f: CFrame,parent: Instance,hx: number,zs: {number},r: number,w: number)
	for _,z in zs do
		local p=mk(parent,"Wheels",Vector3.new(2*hx+w,2*r,2*r),f*CFrame.new(0,r,z),rgb(28,30,32),M.Rubber,true)
		p.Shape=Enum.PartType.Cylinder
	end
end
-- stowed: a parked catering truck has its box lowered onto the chassis (scissors folded away); a parked car has
-- its lights off
local function vehicle(parent: Instance,f: CFrame,kind: string,color: Color3?,stowed: boolean?)
	local m=folder(parent,kind)
	local dark=rgb(40,46,52)
	if kind=="Car" or kind=="Taxi" then
		local col=color or (if kind=="Taxi" then rgb(232,190,60) else rgb(176,178,174))
		lbox(f,m,"Body",-3,3,.8,2.6,-6.3,6.3,col,SM,true)
		glass(lbox(f,m,"Cabin",-2.75,2.75,2.6,4.1,-2.9,3.3,rgb(70,86,100),nil,true),.25)
		lbox(f,m,"Roof",-2.6,2.6,4.1,4.45,-2.1,2.8,col,SM,true)
		if not stowed then -- a parked (stowed) car has its lights off: no glowing lamp parts
			lbox(f,m,"Lights",-2.6,2.6,1.7,2.2,-6.35,-6.25,rgb(255,246,220),M.Neon,true)
			lbox(f,m,"Lights",-2.6,2.6,1.7,2.1,6.25,6.35,rgb(200,40,36),M.Neon,true)
		end
		if kind=="Taxi" then lbox(f,m,"TaxiSign",-1,1,4.45,5.1,-.4,.6,rgb(250,240,200),M.Neon,true) end
		wheels(f,m,2.8,{-4,4},1,1)
	elseif kind=="Bus" then
		local col=color or rgb(236,236,230)
		lbox(f,m,"Body",-4,4,.9,9,-17,17,col,SM,true)
		glass(lbox(f,m,"Windows",-4.05,4.05,4.6,8,-15,16,dark,nil,true),.15)
		glass(lbox(f,m,"Windscreen",-3.6,3.6,3,8.4,-17.05,-16.9,dark,nil,true),.15)
		lbox(f,m,"Stripe",-4.06,4.06,2.6,3.4,-17,17,BRAND,SM,true)
		local ds=lbox(f,m,"Destination",-3,3,8.4,9,-17.1,-17,rgb(20,20,20),SM,true)
		label(ds,if color==PAINT then "APRON  ·  REMOTE STAND R1" else "AIRPORT  ·  CITY CENTRE",Enum.NormalId.Front,{ink=SCREEN_INK,screen=true})
		wheels(f,m,3.6,{-11,10},1.4,1.2)
	elseif kind=="Pushback" then
		lbox(f,m,"Body",-3.6,3.6,.6,2.6,-5,5,YELLOW,SM,true)
		lbox(f,m,"Cab",-3.4,-.4,2.6,4.4,1,4,dark,M.Glass,true)
		lbox(f,m,"TowBar",-.3,.3,.9,1.3,-12,-5,rgb(60,60,60),M.Metal,true)
		wheels(f,m,3.2,{-3.2,3.2},1,1)
	elseif kind=="Tug" then
		lbox(f,m,"Body",-2,2,.5,2.2,-3,3,YELLOW,SM,true)
		lbox(f,m,"Roof",-2,2,4,4.3,-1,3,dark,SM,true)
		for _,x in {-1.8,1.8} do lbox(f,m,"RoofPost",x-.1,x+.1,2.2,4,2.6,2.8,dark,SM,true) end
		wheels(f,m,1.8,{-2,2},.7,.7)
	elseif kind=="Cart" then
		lbox(f,m,"CartBase",-2.2,2.2,.6,1.2,-3,3,rgb(110,116,122),M.Metal,true)
		lbox(f,m,"Bags",-1.9,1.9,1.2,2.6,-2.6,2.6,pick(GOODS,hash(tostring(f.Position.X))),SM,true)
		wheels(f,m,2,{-2,2},.5,.5)
	elseif kind=="FuelTruck" then
		lbox(f,m,"Chassis",-3,3,.8,1.6,-11,9,dark,SM,true)
		lbox(f,m,"Cab",-3,3,1.6,6,-11,-6.5,rgb(230,230,226),SM,true)
		glass(lbox(f,m,"Windscreen",-2.7,2.7,3.8,5.6,-11.05,-10.9,dark,nil,true),.2)
		cylinder(m,"Tank",f*CFrame.new(0,4.4,1.5)*CFrame.Angles(0,math.pi/2,0),14,5.6,rgb(236,236,232),M.Metal,true)
		lbox(f,m,"TankStripe",-2.85,2.85,3.4,3.9,-5.6,8.6,RED,SM,true)
		wheels(f,m,2.8,{-8,3,6.5},1.2,1)
	elseif kind=="BeltLoader" then
		lbox(f,m,"Chassis",-2.4,2.4,.6,1.8,-6,6,YELLOW,SM,true)
		lbox(f,m,"Cab",-2.4,-.2,1.8,4.2,2,5,dark,M.Glass,true)
		local belt=mk(m,"Conveyor",Vector3.new(2.2,.5,15),f*CFrame.new(.8,5.2,-3)*CFrame.Angles(math.rad(28),0,0),rgb(40,42,44),M.Rubber,true)
		local _=belt
		wheels(f,m,2.2,{-4,4},.8,.8)
	elseif kind=="Catering" then
		lbox(f,m,"Chassis",-3,3,.8,1.8,-9,8,dark,SM,true)
		lbox(f,m,"Cab",-3,3,1.8,6,-9,-5,rgb(230,230,226),SM,true)
		local lift=if stowed then 0 else 6.2
		lbox(f,m,"CateringBox",-3.4,3.4,1.8+lift,8.8+lift,-4.4,8,rgb(236,236,232),SM,true)
		if not stowed then
			for _,s in {-1,1} do mk(m,"Scissor",Vector3.new(.4,.4,13),f*CFrame.new(s*2.6,4.9,1.8)*CFrame.Angles(s*math.rad(24),0,0),rgb(200,200,196),M.Metal,true) end
		end
		lbox(f,m,"BoxStripe",-3.45,3.45,7+lift,7.8+lift,-4.4,8,BRAND,SM,true)
		wheels(f,m,2.8,{-6.5,5.5},1.1,1)
	elseif kind=="Stairs" then
		lbox(f,m,"Chassis",-3,3,.8,1.8,-8,8,rgb(230,230,226),SM,true)
		lbox(f,m,"Cab",-3,3,1.8,5,-8,-4.5,rgb(230,230,226),SM,true)
		local st=wedge(m,"Stairway",Vector3.new(3.6,11,14),f*CFrame.new(0,7.3,2),rgb(150,154,158),M.DiamondPlate,true)
		local _=st
		lbox(f,m,"Platform",-1.8,1.8,12.8,13.2,9,12,rgb(150,154,158),M.DiamondPlate,true)
		for _,s in {-1,1} do mk(m,"Handrail",Vector3.new(.2,.2,17.6),f*CFrame.new(s*1.9,10.6,2.4)*CFrame.Angles(math.rad(-38),0,0),rgb(230,230,226),M.Metal,true) end
		wheels(f,m,2.8,{-5.5,5.5},1.1,1)
	elseif kind=="ULD" or kind=="Dolly" then
		-- LD3-style container (contoured overhang on one side), on the ground or on a dolly
		local y0=0
		if kind=="Dolly" then
			lbox(f,m,"DollyBed",-1.9,1.9,.6,1,-2.3,2.3,rgb(70,74,80),M.Metal,true)
			wheels(f,m,1.5,{-1.6,1.6},.4,.4)
			y0=1
		end
		local uld=color or rgb(186,190,194)
		lbox(f,m,"ULD",-1.5,1.5,y0,y0+2.6,-1.4,1.1,uld,M.Metal,true)
		wedge(m,"ULDContour",Vector3.new(3,1.4,1),f*CFrame.new(0,y0+1.9,-1.9)*CFrame.Angles(0,0,math.pi),uld,M.Metal,true)
	elseif kind=="GPU" then
		lbox(f,m,"Unit",-2,2,.6,4,-3,3,rgb(230,230,226),SM,true)
		lbox(f,m,"UnitStripe",-2.05,2.05,3,3.4,-3,3,YELLOW,SM,true)
		wheels(f,m,1.8,{-2,2},.6,.6)
	end
end
local function cone(parent: Instance,x: number,z: number)
	post(parent,"Cone",x,z,A.apronTop,A.apronTop+1.4,.7,rgb(240,110,40),SM,true)
	post(parent,"ConeBand",x,z,A.apronTop+.7,A.apronTop+1,.74,PAINT,SM,true)
end

------------------------------------------------------------------------------------------------ jet bridges
-- Front left boarding door of a built aircraft. AircraftModel contract: the PrimaryPart "AircraftRoot" carries an
-- Attachment "DoorL1" at the door centre (LookVector out of the fuselage) with the attribute DoorHalf = half
-- the door height (an attachment without DoorHalf is taken as the sill itself) - so the bridge follows
-- whatever AircraftModel builds (part model or imported mesh). Fallback: AircraftModel.points.
-- Returns the sill point (world) and the outward normal.
local function boardingDoor(plane: Model,pivot: CFrame,scale: number): (Vector3,Vector3)
	local root=plane.PrimaryPart
	local a=if root then root:FindFirstChild("DoorL1") else nil
	local door: CFrame
	local half=0
	if root and a and a:IsA("Attachment") then
		door=root.CFrame*a.CFrame
		local h=a:GetAttribute("DoorHalf")
		if typeof(h)=="number" then half=h end
	else
		local pts=Aircraft.points("320",scale)
		door=pivot*pts.doorL1
		half=(pts :: any).doorHalf or 0
	end
	local n=Vector3.new(door.LookVector.X,0,door.LookVector.Z)
	if n.Magnitude&lt;.5 then n=-pivot.RightVector end
	return door.Position-Vector3.new(0,half,0),n.Unit
end
-- Nose-gear z of a built aircraft (frontmost part flagged Gear), for the stop bar; fallback for old models.
local function noseGearZ(plane: Model,pivot: CFrame,scale: number): number
	local best=math.huge
	for _,d in plane:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Gear")==true then
			local l=pivot:PointToObjectSpace(d.Position)
			if math.abs(l.X)&lt;2*scale and l.Z&lt;best then best=l.Z end
		end
	end
	if best==math.huge then best=-22*scale end
	return (pivot*CFrame.new(0,0,best)).Position.Z
end
type Bridge={door: Vector3,cab: CFrame,bx: number,sill: number}
-- Cab position for one stand: cab floor at the door sill, its open side 0.6 studs off the fuselage.
local function bridgePlan(door: Vector3,normal: Vector3): Bridge
	local sill=door.Y
	local c=door+normal*(0.6+4.5)
	return {door=door,cab=CFrame.lookAt(Vector3.new(c.X,sill,c.Z),Vector3.new(door.X,sill,door.Z)),bx=c.X,sill=sill}
end
local function jetBridge(parent: Instance,i: number,b: Bridge)
	local m=folder(parent,"JetBridge_A"..i)
	m:SetAttribute("Gate","A"..i);m:SetAttribute("Stand",i)
	local x=b.bx
	local z0=BACK+.05
	local cabZ1=b.cab.Position.Z-4.5
	local top=b.sill
	local tunnel=Vector3.new(x,F,z0)
	local endp=Vector3.new(x,top,cabZ1)
	local dir=(endp-tunnel)
	local len=dir.Magnitude
	local f=CFrame.lookAt(tunnel,endp) -- local -Z along the bridge, floor at y=0 of this frame
	local metal=rgb(196,200,202)
	local function section(z1: number,z2: number,w: number,h: number,name: string)
		lbox(f,m,name.."Floor",-w/2,w/2,-.6,0,-z2,-z1,rgb(120,124,128),M.DiamondPlate)
		for _,s in {-1,1} do
			lbox(f,m,name.."Wall",s*w/2-(if s&gt;0 then .4 else 0),s*w/2+(if s&lt;0 then .4 else 0),0,2.6,-z2,-z1,metal,M.Metal)
			glass(lbox(f,m,name.."Window",s*w/2-(if s&gt;0 then .3 else 0),s*w/2+(if s&lt;0 then .3 else 0),2.6,5.8,-z2,-z1,rgb(60,70,80)),.35)
			lbox(f,m,name.."Wall",s*w/2-(if s&gt;0 then .4 else 0),s*w/2+(if s&lt;0 then .4 else 0),5.8,h,-z2,-z1,metal,M.Metal)
		end
		lbox(f,m,name.."Roof",-w/2-.2,w/2+.2,h,h+.5,-z2,-z1,metal,M.Metal)
	end
	local split=len*.5
	section(0,split+1,7.6,8.6,"BridgeOuter")
	section(split,len,7,8,"BridgeInner")
	-- drive unit under the inner section (legs + bogie), service stairs, cab and canopy bellows
	local dp=f*CFrame.new(0,0,-(len-6))
	local groundY=A.apronTop
	for _,s in {-1,1} do
		local legTop=dp*CFrame.new(s*2.4,-.6,0)
		box(m,"DriveLeg",legTop.X-.4,legTop.X+.4,groundY+1.2,legTop.Y,legTop.Z-.4,legTop.Z+.4,rgb(90,94,98),M.Metal)
	end
	box(m,"DriveBogie",dp.X-3.2,dp.X+3.2,groundY+.6,groundY+1.4,dp.Z-1,dp.Z+1,rgb(60,64,68),M.Metal,true)
	for _,s in {-1,1} do
		local w=mk(m,"Wheel",Vector3.new(.9,1.6,1.6),CFrame.new(dp.X+s*3.4,groundY+.8,dp.Z),rgb(28,30,32),M.Rubber,true);w.Shape=Enum.PartType.Cylinder
	end
	local cab=b.cab -- LookVector towards the aircraft door
	lbox(cab,m,"CabFloor",-4.5,4.5,-.6,0,-4.5,4.5,rgb(120,124,128),M.DiamondPlate)
	lbox(cab,m,"CabRoof",-4.7,4.7,8,8.6,-4.7,4.7,metal,M.Metal)
	lbox(cab,m,"CabWall",-4.5,4.5,0,8,4.1,4.5,metal,M.Metal) -- side away from the aircraft
	-- local +X = the tail side (south for a nose-north aircraft); the tunnel enters through the open north side
	glass(lbox(cab,m,"CabWindow",4.1,4.5,2.6,5.8,-4.5,4.1,rgb(60,70,80)),.35)
	lbox(cab,m,"CabWall",4.1,4.5,0,2.6,-4.5,4.1,metal,M.Metal)
	lbox(cab,m,"CabWall",4.1,4.5,5.8,8,-4.5,4.1,metal,M.Metal)
	-- bellows frame around the aircraft side opening
	lbox(cab,m,"Bellows",-4.7,4.7,7.2,8.4,-5.1,-4.5,rgb(40,42,44),M.Fabric,true)
	for _,s in {-1,1} do lbox(cab,m,"Bellows",s*4.4-.3,s*4.4+.3,0,8.4,-5.1,-4.5,rgb(40,42,44),M.Fabric,true) end
	box(m,"CabColumn",cab.X-.5,cab.X+.5,groundY,b.sill-.6,cab.Z-.5,cab.Z+.5,rgb(90,94,98),M.Metal)
	local bp=invisible(mk(m,"BoardingPoint",Vector3.new(1,1,1),cab*CFrame.new(0,3,-3),C.white,SM,true))
	bp:SetAttribute("Gate","A"..i);bp:SetAttribute("Stand",i);bp:SetAttribute("AircraftDoor",b.door)
	m:SetAttribute("TerminalDoor",Vector3.new(x,F+3,BACK))
	m:SetAttribute("AircraftDoor",b.door)
	-- docking guidance display on the facade above the stand centre line
end

------------------------------------------------------------------------------------------------ apron
local function standMarkings(parent: Instance,i: number,gx: number,noseGearZ: number)
	local y=A.apronTop
	local function paint(name: string,x1: number,x2: number,z1: number,z2: number,color: Color3)
		box(parent,name,x1,x2,y,y+.05,z1,z2,color,SM,true)
	end
	paint("LeadInLine",gx-.25,gx+.25,noseGearZ-1,A.taxilane,YELLOW)
	paint("StopBar",gx-4,gx+4,noseGearZ-.6,noseGearZ,YELLOW)
	-- equipment restraint area (red) around the nose and the jet bridge
	for _,s in {{gx-38,gx+38,2537,2538},{gx-38,gx+38,2700,2701},{gx-38,gx-37,2537,2701},{gx+37,gx+38,2537,2701}} do paint("RestraintLine",s[1],s[2],s[3],s[4],RED) end
	-- equipment staging box (white outline) beside the stand
	for _,s in {{gx+44,gx+64,2560,2561},{gx+44,gx+64,2600,2601},{gx+44,gx+45,2560,2601},{gx+63,gx+64,2560,2601}} do paint("StagingLine",s[1],s[2],s[3],s[4],PAINT) end
	local num=box(parent,"StandNumber",gx-6,gx+6,y,y+.05,A.taxilane-30,A.taxilane-20,rgb(60,62,64),SM,true)
	label(num,"A"..i,Enum.NormalId.Top,{ink=YELLOW,far=true})
	-- docking guidance display on the terminal facade above the lead-in line
	local vd=panel(parent,"DockingDisplay",Vector3.new(gx,G+20,BACK+.6),Vector3.new(0,0,1),5,3,C.screen,"A"..i.."\nSTOP",{ink=SCREEN_INK,screen=true,far=true})
	local _=vd
end

local function apron(m: Instance)
	local ap=A.apron
	local apronF=folder(m,"Apron")
	box(apronF,"Apron",ap.x1,ap.x2,G+.02,A.apronTop,ap.z1,ap.z2,C.concrete,M.Concrete)
	-- expansion joints (subtle grid) and the taxilane with lead-out lines
	for x=ap.x1+100,ap.x2-100,100 do box(apronF,"ApronJoint",x-.1,x+.1,A.apronTop,A.apronTop+.04,ap.z1+2,ap.z2-2,rgb(150,150,146),SM,true) end
	box(apronF,"TaxilaneLine",ap.x1+40,ap.x2-40,A.apronTop,A.apronTop+.05,A.taxilane-.25,A.taxilane+.25,YELLOW,SM,true)
	local tz=(A.taxiway.z1+A.taxiway.z2)/2
	for _,x in A.exits do box(apronF,"LeadOutLine",x-.25,x+.25,A.apronTop,A.apronTop+.05,A.taxilane,tz,YELLOW,SM,true) end
	-- stands: aircraft, jet bridge to its boarding door, markings, ground vehicles
	local liveries={Color3.fromRGB(94,136,162),Color3.fromRGB(170,110,84),Color3.fromRGB(104,126,111)}
	local bridges: {Bridge}={}
	local planes: {Model}={}
	for i,cf in A.standCFrames do
		local plane=Aircraft.build(apronF,cf,{scale=A.standScale,livery=liveries[i],collide=true,name="ParkedAircraft"})
		plane:SetAttribute("Stand",i);plane:SetAttribute("Gate","A"..i)
		planes[i]=plane
		local door,normal=boardingDoor(plane,cf,A.standScale)
		bridges[i]=bridgePlan(door,normal)
		plane:SetAttribute("NoseGearZ",noseGearZ(plane,cf,A.standScale))
	end
	local jb=folder(apronF,"JetBridges")
	for i,b in bridges do jetBridge(jb,i,b) end
	local gse=folder(apronF,"GroundVehicles")
	for i,cf in A.standCFrames do
		local gx=cf.Position.X
		local s=A.standScale
		local ngz=planes[i]:GetAttribute("NoseGearZ") :: number
		standMarkings(apronF,i,gx,ngz)
		local y=A.apronTop
		local function at(x: number,z: number,yaw: number): CFrame return CFrame.new(x,y,z)*CFrame.Angles(0,math.rad(yaw),0) end
		vehicle(gse,at(gx,ngz-9,180),"Pushback")
		vehicle(gse,at(gx+54,2575,0),"Tug")
		for j=1,3 do vehicle(gse,at(gx+54,2575+j*7.2,0),"Cart") end
		vehicle(gse,at(gx+16,ngz+2,0),"GPU")
		if i==A.shuttleStand then
			-- the client-animated shuttle pushes back from / taxis in on this stand: nothing under its wings or
			-- engines (|x - gx| &lt;= 62 behind the nose); the turnaround vehicles wait in the staging box
			vehicle(gse,at(gx+48,2565,0),"BeltLoader")
			vehicle(gse,at(gx+60,2563,0),"Catering",nil,true) -- waiting: box lowered
			for _,o in {{-4,-24},{4,-24}} do cone(gse,gx+o[1],ngz+o[2]) end
		else
			vehicle(gse,at(gx+14.5,cf.Position.Z-12*s,90),"BeltLoader")
			vehicle(gse,at(gx+16,cf.Position.Z+16*s,-90),"Catering")
			if i~=2 then vehicle(gse,at(gx-30*s,cf.Position.Z+6*s,180),"FuelTruck") end
			vehicle(gse,at(gx-19,cf.Position.Z+18*s,90),"Stairs")
			for _,o in {{-17,-2},{17,-2},{-17*s,7*s},{17*s,7*s}} do cone(gse,gx+o[1],cf.Position.Z+o[2]) end
		end
	end
	-- remote stand R1 on the east apron: a second aircraft served by mobile stairs and an apron bus
	local rcf=CFrame.new(470,A.apronTop,2640)
	local remote=Aircraft.build(apronF,rcf,{scale=A.standScale,livery=rgb(150,62,72),collide=true,name="RemoteAircraft"})
	remote:SetAttribute("Stand","R1")
	local rngz=noseGearZ(remote,rcf,A.standScale)
	local rdoor=boardingDoor(remote,rcf,A.standScale)
	local y=A.apronTop
	local function rat(x: number,z: number,yaw: number): CFrame return CFrame.new(x,y,z)*CFrame.Angles(0,math.rad(yaw),0) end
	box(apronF,"LeadInLine",469.75,470.25,y,y+.05,rngz-1,A.taxilane,YELLOW,SM,true)
	box(apronF,"StopBar",466,474,y,y+.05,rngz-.6,rngz,YELLOW,SM,true)
	local rnum=box(apronF,"StandNumber",464,476,y,y+.05,A.taxilane-30,A.taxilane-20,rgb(60,62,64),SM,true)
	label(rnum,"R1",Enum.NormalId.Top,{ink=YELLOW,far=true})
	local rg=folder(gse,"RemoteStand")
	vehicle(rg,rat(rdoor.X-13,rdoor.Z,90),"Stairs")
	vehicle(rg,rat(rdoor.X-13,rcf.Position.Z+27.3*A.standScale/1.8,90),"Stairs")
	vehicle(rg,rat(rdoor.X-22,rdoor.Z-26,0),"Bus",PAINT)
	vehicle(rg,rat(484.5,rcf.Position.Z-21.6,90),"BeltLoader")
	vehicle(rg,rat(524,rcf.Position.Z+10.8,180),"FuelTruck")
	for _,o in {{-17,-2},{17,-2}} do cone(rg,470+o[1],rcf.Position.Z+o[2]) end
	-- equipment roads: head-of-stand road along the facade (interrupted by the stands' restraint areas) and the
	-- service road behind the stands; white lines
	local y0=A.apronTop
	local rs: {{number}}={}
	local x0=ap.x1+10
	for _,cf in A.standCFrames do table.insert(rs,{x0,cf.Position.X-39});x0=cf.Position.X+39 end
	table.insert(rs,{x0,ap.x2-10})
	for _,r in rs do
		for _,z in {2541,2553} do box(apronF,"RoadLine",r[1],r[2],y0,y0+.05,z-.25,z+.25,PAINT,SM,true) end
	end
	for _,z in {2712,2724} do box(apronF,"RoadLine",ap.x1+10,ap.x2-10,y0,y0+.05,z-.25,z+.25,PAINT,SM,true) end
	-- GSE parking on the west apron (between the two roads, clear of stand A1's wing sweep and of the hangar
	-- apron corridor x &lt; -560): baggage carts, ULD dollies, containers, spare tugs, belt loaders, stairs, a
	-- stowed catering truck, a fuel truck and an apron bus; a coned holding box by the facade
	local park=folder(gse,"GSEParking")
	for _,s in {{-560,-356,2569.75,2570.25},{-560,-356,2675.75,2676.25},{-560.5,-559.5,2570,2676},{-356.5,-355.5,2570,2676}} do
		box(apronF,"ParkingLine",s[1],s[2],y0,y0+.05,s[3],s[4],PAINT,SM,true)
	end
	local plate=box(apronF,"ParkingLabel",-430,-390,y0,y0+.05,2574,2582,rgb(60,62,64),SM,true)
	label(plate,"GSE PARKING",Enum.NormalId.Top,{ink=PAINT,far=true})
	local function pat(x: number,z: number,yaw: number): CFrame return CFrame.new(x,y0,z)*CFrame.Angles(0,math.rad(yaw),0) end
	for i=0,5 do vehicle(park,pat(-544+i*5.6,2592,0),"Cart") end
	for i=0,2 do vehicle(park,pat(-504+i*7,2591,0),"Tug") end
	for i=0,5 do vehicle(park,pat(-544+i*6,2616,0),"Dolly") end
	for i=0,7 do vehicle(park,pat(-546+i*4,2640,0),"ULD",if i%3==2 then rgb(150,156,162) else nil) end
	for i=0,3 do vehicle(park,pat(-506+i*6,2643,0),"Dolly") end
	-- a baggage train waiting along the back of the box (tug + four carts, heading east)
	vehicle(park,pat(-505,2662,-90),"Tug")
	for i=1,4 do vehicle(park,pat(-505-i*7.4,2662,-90),"Cart") end
	for i=0,1 do vehicle(park,pat(-496+i*9,2624,0),"BeltLoader") end
	vehicle(park,pat(-468,2626,0),"Stairs")
	vehicle(park,pat(-430,2618,0),"Catering",nil,true)
	vehicle(park,pat(-410,2620,0),"FuelTruck")
	vehicle(park,pat(-370,2625,0),"Bus",PAINT)
	local hold=folder(gse,"HoldingBox")
	for _,s in {{-662,-628,2559.75,2560.25},{-662,-628,2585.75,2586.25},{-662.25,-661.75,2560,2586},{-628.25,-627.75,2560,2586}} do
		box(apronF,"HoldingLine",s[1],s[2],y0,y0+.05,s[3],s[4],YELLOW,SM,true)
	end
	for _,c in {{-662,2560},{-628,2560},{-662,2586},{-628,2586}} do cone(hold,c[1],c[2]) end
	-- apron flood masts (four real lights)
	for _,x in {-650,-260,260,650} do
		box(apronF,"FloodMast",x-.6,x+.6,A.apronTop,G+32,2836,2837.2,C.metal,M.Metal)
		box(apronF,"FloodFrame",x-5,x+5,G+32,G+33,2835.6,2837.6,C.metal,M.Metal,true)
		local head=box(apronF,"FloodHead",x-4.6,x+4.6,G+33,G+35,2834.2,2836,GLOW,M.Neon,true)
		head.CFrame=head.CFrame*CFrame.Angles(math.rad(25),0,0)
		kit.light(head,60,.8)
	end
	return planes,bridges
end

------------------------------------------------------------------------------------------------ runway
-- Painted 7-segment-like digit (bars) for the runway designators. f: origin = digit centre on the surface,
-- local -Z = the top of the digit (towards the far end of the runway).
local DIGITS: {[string]: {string}}={["0"]={"a","b","c","d","e","f"},["9"]={"a","b","c","d","f","g"},["2"]={"a","b","g","e","d"},["7"]={"a","b","c"}}
local function digit(parent: Instance,f: CFrame,ch: string,h: number,w: number)
	local t=1.6
	local segs: {[string]: {number}}={a={-w/2,w/2,-h/2,-h/2+t},g={-w/2,w/2,-t/2,t/2},d={-w/2,w/2,h/2-t,h/2},
		f={-w/2,-w/2+t,-h/2,0},b={w/2-t,w/2,-h/2,0},e={-w/2,-w/2+t,0,h/2},c={w/2-t,w/2,0,h/2}}
	local list=DIGITS[ch]
	if not list then return end
	for _,s in list do
		local r=segs[s]
		lbox(f,parent,"RunwayNumber",r[1],r[2],0,.05,r[3],r[4],PAINT,SM,true)
	end
end
local function runway(m: Instance)
	local tw=A.taxiway;local rw=A.runway
	local apronF=m:FindFirstChild("Apron") or m
	local top=City.ROAD_TOP
	box(apronF,"Taxiway",tw.x1,tw.x2,G+.02,top,tw.z1,tw.z2,C.asphalt,M.Asphalt)
	local tz=(tw.z1+tw.z2)/2
	box(apronF,"TaxiLine",tw.x1,tw.x2,top,top+.05,tz-.25,tz+.25,YELLOW,SM,true)
	for _,z in {tw.z1+1.2,tw.z2-1.2} do box(apronF,"TaxiEdgeLine",tw.x1,tw.x2,top,top+.05,z-.2,z+.2,YELLOW,SM,true) end
	for _,x in A.connectors do
		box(apronF,"TaxiConnector",x-20,x+20,G+.02,top,tw.z2,rw.z1,C.asphalt,M.Asphalt)
		box(apronF,"TaxiLine",x-.25,x+.25,top,top+.05,tz,rw.z1+20,YELLOW,SM,true)
		-- hold-short marking: two solid + two dashed lines, and the red runway sign
		for k,dz in {-1.5,-.5} do box(apronF,"HoldShortLine",x-19,x+19,top,top+.05,A.holdShortZ+dz*1.6-.2,A.holdShortZ+dz*1.6+.2,YELLOW,SM,true);local _=k end
		for dx=-18,14,4 do for _,dz in {.6,1.6} do box(apronF,"HoldShortDash",x+dx,x+dx+2.4,top,top+.05,A.holdShortZ+dz*1.6-.2,A.holdShortZ+dz*1.6+.2,YELLOW,SM,true) end end
		box(apronF,"HoldSignPost",x+23.5,x+24,G,G+4,A.holdShortZ-.25,A.holdShortZ+.25,C.metal,M.Metal,true)
		panel(apronF,"HoldSign",Vector3.new(x+23.75,G+4.6,A.holdShortZ-.4),Vector3.new(0,0,-1),6,1.6,rgb(190,40,36),"09 – 27",{ink=INK,far=true})
		for z=tw.z2+10,rw.z1-10,20 do for _,s in {-1,1} do post(apronF,"TaxiEdgeLight",x+s*20.5,z,G,G+.9,.5,rgb(70,120,255),M.Neon,true) end end
	end
	-- blue taxiway edge lights (neon) along both edges
	for x=tw.x1+10,tw.x2-10,50 do
		for _,z in {tw.z1-.8,tw.z2+.8} do
			local skip=z&lt;tz and math.abs(x)&lt;=A.apron.x2+5
			for _,cx in A.connectors do if z&gt;tz and math.abs(x-cx)&lt;22 then skip=true end end
			if not skip then post(apronF,"TaxiEdgeLight",x,z,G,G+.9,.5,rgb(70,120,255),M.Neon,true) end
		end
	end
	local runwayF=folder(m,"Runway")
	local rtop=top
	for _,s in {{rw.x1,0},{0,rw.x2}} do
		box(runwayF,"Runway",s[1],s[2],G+.02,rtop,rw.z1,rw.z2,Color3.fromRGB(50,53,56),M.Asphalt)
		for _,z in {rw.z1+3,rw.z2-3} do box(runwayF,"RunwayEdge",s[1]+8,s[2]-8,rtop,rtop+.05,z-.6,z+.6,PAINT,SM,true) end
	end
	local cz=(rw.z1+rw.z2)/2
	for x=rw.x1+200,rw.x2-240,80 do box(runwayF,"RunwayDash",x,x+40,rtop,rtop+.05,cz-.6,cz+.6,PAINT,SM,true) end
	for _,e in {{rw.x1,1},{rw.x2,-1}} do
		local ex,dir=e[1] :: number,e[2] :: number
		-- threshold piano keys (4 each side of the centre line)
		for _,o in {-52,-42,-32,-22,16,26,36,46} do
			local x1=ex+dir*12;local x2=ex+dir*62
			box(runwayF,"Threshold",math.min(x1,x2),math.max(x1,x2),rtop,rtop+.05,cz+o,cz+o+6,PAINT,SM,true)
		end
		-- designator: 09 at the west end (read when landing towards +X), 27 at the east end
		local text=if dir&gt;0 then "09" else "27"
		local nx=ex+dir*110
		local f=CFrame.lookAt(Vector3.new(nx,rtop,cz),Vector3.new(nx+dir,rtop,cz)) -- local -Z = towards the far end
		local r1,r2=string.sub(text,1,1),string.sub(text,2,2)
		digit(runwayF,f*CFrame.new(-9,0,0),r1,30,14)
		digit(runwayF,f*CFrame.new(9,0,0),r2,30,14)
		-- aiming point + touchdown zone bars
		for _,d in {{400,10,50},{250,6,30},{550,6,30}} do
			local ax=ex+dir*d[1]
			for _,s in {-1,1} do box(runwayF,"AimingPoint",ax-d[3]/2,ax+d[3]/2,rtop,rtop+.05,cz+s*22-d[2]/2,cz+s*22+d[2]/2,PAINT,SM,true) end
		end
		-- threshold (green) and runway end (red) light bars
		local lx=ex+dir*3
		box(runwayF,"ThresholdLights",lx-.6,lx+.6,G,G+.8,rw.z1+4,rw.z2-4,rgb(80,230,120),M.Neon,true)
		local rx=ex+dir*1
		box(runwayF,"RunwayEndLights",rx-.4,rx+.4,G,G+.7,rw.z1+4,rw.z2-4,rgb(240,70,60),M.Neon,true)
		-- approach lights: cross bars on posts out to the boundary and beyond (horizon land)
		for k=1,8 do
			local ax=ex-dir*(k*28)
			post(runwayF,"ApproachPost",ax,cz,G-6,G+2.2+k*.2,.5,C.metal,M.Metal,true)
			box(runwayF,"ApproachBar",ax-.4,ax+.4,G+2.2+k*.2,G+2.8+k*.2,cz-10+(k%2)*2,cz+10-(k%2)*2,PAINT,M.Neon,true)
		end
	end
	for x=rw.x1+10,rw.x2-10,100 do
		for _,z in {rw.z1-1.5,rw.z2+1.5} do post(runwayF,"EdgeLight",x,z,G,G+.9,.6,Color3.fromRGB(255,236,180),M.Neon,true) end
	end
	-- wind sock
	post(runwayF,"WindsockPole",620,rw.z1-40,G,G+12,.4,C.metal,M.Metal,true)
	local sock=mk(runwayF,"Windsock",Vector3.new(6,1.6,1.6),CFrame.new(623,G+11.4,rw.z1-40)*CFrame.Angles(0,0,math.rad(-8)),rgb(240,110,40),M.Fabric,true)
	sock.Shape=Enum.PartType.Cylinder
end

------------------------------------------------------------------------------------------------ forecourt
local function forecourt(m: Instance)
	local f=folder(m,"Forecourt")
	local x1,x2=T.x1-30,T.x2+30
	box(f,"DropOffLane",x1,x2,G+.02,City.ROAD_TOP,2400,2418,C.asphalt,M.Asphalt)
	box(f,"Forecourt",x1,x2,G-.175,City.WALK_TOP,2418,FRONT,rgb(196,194,184),M.Concrete)
	box(f,"Curb",x1,x2,City.WALK_TOP-.05,City.WALK_TOP+.02,2418,2418.6,C.stoneDeep,M.Limestone,true)
	local top=City.ROAD_TOP
	-- lane markings: dashed edge line, "DROP-OFF ONLY", crossings at the three departure doors and the
	-- arrivals exit, two zebra crossings over Airport Road to the city side
	for x=x1+4,x2-8,10 do box(f,"LaneDash",x,x+5,top,top+.05,2409.2,2409.6,PAINT,SM,true) end
	for _,x in {-225,-75,75,225} do
		local t=box(f,"LaneText",x-10,x+10,top,top+.05,2410.5,2416.5,C.asphalt,SM,true)
		label(t,"DROP-OFF ONLY",Enum.NormalId.Top,{ink=PAINT,far=true})
	end
	for _,x in DOORS do
		for k=-2,2 do box(f,"Zebra",x+k*2.4-.8,x+k*2.4+.8,top,top+.05,2408.4,2417.6,PAINT,SM,true) end
	end
	for _,x in {-150,150} do
		for k=-2,2 do box(f,"Zebra",x+k*2.4-.8,x+k*2.4+.8,top,top+.05,2361,2399,PAINT,SM,true) end
	end
	-- vehicles: taxi rank (west), private cars, two airport buses at the bus stop (east)
	local function at(x: number,yaw: number): CFrame return CFrame.new(x,top,2413.5)*CFrame.Angles(0,math.rad(yaw),0) end
	for i=0,3 do vehicle(f,at(-280+i*15,-90),"Taxi") end
	vehicle(f,at(-110,-90),"Car",rgb(120,44,40))
	vehicle(f,at(-34,-90),"Car",rgb(42,64,96))
	vehicle(f,at(30,-90),"Car",rgb(210,210,206))
	vehicle(f,at(110,-90),"Taxi")
	vehicle(f,at(196,-90),"Bus")
	vehicle(f,at(240,-90),"Bus",rgb(220,226,230))
	-- taxi and bus signs, bus shelter, bollards, planters, info totems
	post(f,"TaxiSignPost",-292,2420,City.WALK_TOP,City.WALK_TOP+9,.4,C.metal,M.Metal,true)
	panel(f,"TaxiSign",Vector3.new(-292,City.WALK_TOP+9.8,2420),Vector3.new(0,0,-1),5,1.8,rgb(232,190,60),"TAXI",{ink=rgb(30,30,30),far=true},"TAXI")
	box(f,"BusShelterRoof",236,262,City.WALK_TOP+8,City.WALK_TOP+8.6,2419,2425,C.metal,M.Metal,true)
	glass(box(f,"BusShelterGlass",236,262,City.WALK_TOP,City.WALK_TOP+8,2424.6,2425,C.glass,nil,true),.5)
	for _,x in {236.3,261.7} do box(f,"BusShelterPost",x-.3,x+.3,City.WALK_TOP,City.WALK_TOP+8,2424,2424.6,C.metal,M.Metal,true) end
	box(f,"BusShelterBench",239,259,City.WALK_TOP,City.WALK_TOP+1.6,2422.6,2424.2,C.oak,M.Wood)
	panel(f,"BusSign",Vector3.new(249,City.WALK_TOP+9.6,2419.2),Vector3.new(0,0,-1),12,1.4,rgb(58,88,140),"BUS  ·  CITY CENTRE  ·  BUSINESS CITY",{ink=INK,far=true})
	for x=x1+6,x2-6,15 do
		local free=true
		for _,dx in DOORS do if math.abs(x-dx)&lt;9 then free=false end end
		for _,c in {-225,-75,75,225} do if math.abs(x-c)&lt;3 then free=false end end
		if x&gt;233 and x&lt;265 then free=false end
		if free then post(f,"Bollard",x,2419.4,City.WALK_TOP,City.WALK_TOP+2.4,.7,C.metalSoft,M.Metal) end
	end
	for i,x in {-112,-38,38,112} do
		box(f,"CurbPlanter",x-6,x+6,City.WALK_TOP,City.WALK_TOP+2,2424,2428,rgb(70,74,78),M.Slate)
		ball(f,"CurbShrub",Vector3.new(x-3,City.WALK_TOP+2.8,2426),3.6,C.foliage,M.LeafyGrass,true)
		ball(f,"CurbShrub",Vector3.new(x+3,City.WALK_TOP+2.8,2426),3.6,C.foliageLight,M.LeafyGrass,true)
		local _=i
	end
	for _,x in {T.x1-22,T.x2+22} do
		box(f,"InfoTotem",x-1.5,x+1.5,City.WALK_TOP,City.WALK_TOP+12,2421,2422.4,NAVY,SM)
		panel(f,"InfoTotemFace",Vector3.new(x,City.WALK_TOP+8,2420.85),Vector3.new(0,0,-1),2.8,7,NAVY,"CITY\nAIRPORT\n\n← P\n✈ DEP\nARR →",{ink=INK,far=true})
	end
	-- canopy lights under the soffit (four real lights)
	for _,x in {-225,-75,75,225} do
		local l=box(f,"CanopyLight",x-6,x+6,roofY(2412)-.6,roofY(2412)-.2,2410,2414,C.lightWarm,M.Neon,true)
		kit.light(l,48,.9,C.lightWarm)
	end
	-- covered walkway from the car park to the terminal (west)
	box(f,"WalkwayCanopy",-342,T.x1,G+11,G+11.8,2419,2429,C.white,M.Metal,true)
	for _,x in {-338,-318} do for _,z in {2419.6,2428.4} do post(f,"WalkwayPost",x,z,City.WALK_TOP,G+11,.6,C.metal,M.Metal,true) end end
	box(f,"Walkway",-342,x1,G-.175,City.WALK_TOP,2418,FRONT,rgb(196,194,184),M.Concrete)
end

------------------------------------------------------------------------------------------------ car park
local function carPark(m: Instance)
	local lot=A.carParkLot
	local park=folder(m,"CarPark")
	box(park,"CarParkSurface",lot.x1,lot.x2,G+.02,G+.3,lot.z1,lot.z2,C.asphalt,M.Asphalt)
	for i=0,20 do
		local x=-350-i*10
		box(park,"BayLine",x-.15,x+.15,G+.3,G+.35,2412,2430,PAINT,SM,true)
		box(park,"BayLine",x-.15,x+.15,G+.3,G+.35,2500,2518,PAINT,SM,true)
	end
	-- parked cars (decor) in row B and the far part of row A; the bays nearest the terminal stay free
	local tones={rgb(64,72,80),rgb(176,178,174),rgb(120,44,40),rgb(42,64,96),rgb(210,210,206),rgb(30,32,34),rgb(150,140,120)}
	for i=0,20 do
		local x=-355-i*10
		local h=hash("bay"..i)
		if h%4~=0 then vehicle(park,CFrame.new(x,G+.3,2509)*CFrame.Angles(0,if h%2==0 then 0 else math.pi,0),"Car",pick(tones,h),true) end
		if i&gt;=12 and h%3~=0 then vehicle(park,CFrame.new(x,G+.3,2421)*CFrame.Angles(0,math.pi,0),"Car",pick(tones,h+3),true) end
	end
	box(park,"ParkingSignPost",-338,-337,G,G+12,2402,2403,C.metal,M.Metal)
	panel(park,"ParkingSign",Vector3.new(-337.5,G+10,2401.6),Vector3.new(0,0,-1),13,4,rgb(58,88,140),"P  AIRPORT PARKING",{ink=INK,far=true})
	box(park,"PayStation",-344,-342,G+.3,G+5.5,2440,2442,rgb(60,66,74),SM)
	for i,x in {-420,-560,-700,-800} do kit.lamp(park,x,2470,i&lt;=2,G+.3) end
end

------------------------------------------------------------------------------------------------ tower, hangar
local function towerAndHangar(m: Instance)
	local tp=A.tower
	local tower=folder(m,"ControlTower",Enum.ModelStreamingMode.Persistent)
	box(tower,"TowerBase",tp.X-15,tp.X+15,G,G+10,tp.Z-15,tp.Z+15,C.stone,M.Limestone)
	box(tower,"TowerShaft",tp.X-6,tp.X+6,G+10,G+80,tp.Z-6,tp.Z+6,C.stone,M.Limestone)
	glass(box(tower,"TowerCab",tp.X-12,tp.X+12,G+80,G+90,tp.Z-12,tp.Z+12,C.glassDeep),.25)
	box(tower,"TowerRoof",tp.X-14,tp.X+14,G+90,G+91.5,tp.Z-14,tp.Z+14,C.metal,M.Metal)
	box(tower,"TowerAntenna",tp.X-.3,tp.X+.3,G+91.5,G+104,tp.Z-.3,tp.Z+.3,C.metal,M.Metal,true)
	local beacon=box(tower,"TowerBeacon",tp.X-.8,tp.X+.8,G+104,G+105.6,tp.Z-.8,tp.Z+.8,Color3.fromRGB(230,80,60),M.Neon,true)
	kit.light(beacon,24,.6,Color3.fromRGB(230,80,60))
	-- FxFar / FxVertical: per-prop activation range (requested from PropFxController's owner, airport.md #7;
	-- the default 120 / 24 studs never reaches a tower top 100 studs up and 500+ studs from the terminal)
	fx(beacon,"blink",{FxRate=1,FxColor=rgb(70,20,16),FxIdle="on",FxFar=900,FxVertical=200})
	local radar=folder(tower,"Radar")
	box(radar,"RadarMount",tp.X+7,tp.X+9,G+91.5,G+94,tp.Z+7,tp.Z+9,C.metal,M.Metal,true)
	local dish=box(radar,"RadarAntenna",tp.X+3,tp.X+13,G+94,G+96.4,tp.Z+7.6,tp.Z+8.4,rgb(220,222,224),M.Metal,true)
	local _=dish
	radar.WorldPivot=CFrame.new(tp.X+8,G+95,tp.Z+8)
	fx(radar,"spin",{FxAxis="y",FxRate=1.6,FxIdle="on",FxFar=900,FxVertical=200})
	local hg=A.hangar;local ap=A.apron
	local hangar=folder(m,"Hangar")
	box(hangar,"HangarApron",hg.x2,ap.x1,G+.02,A.apronTop,hg.z1+20,hg.z2-20,C.concrete,M.Concrete)
	box(hangar,"HangarFloor",hg.x1,hg.x2,G+.02,A.apronTop,hg.z1,hg.z2,C.concrete,M.Concrete)
	box(hangar,"HangarWall",hg.x1,hg.x1+4,G,G+46,hg.z1,hg.z2,C.metalSoft,M.CorrodedMetal)
	box(hangar,"HangarWall",hg.x1+4,hg.x2,G,G+46,hg.z1,hg.z1+4,C.metalSoft,M.CorrodedMetal)
	box(hangar,"HangarWall",hg.x1+4,hg.x2,G,G+46,hg.z2-4,hg.z2,C.metalSoft,M.CorrodedMetal)
	box(hangar,"HangarHeader",hg.x2-4,hg.x2,G+36,G+46,hg.z1+4,hg.z2-4,C.metalSoft,M.CorrodedMetal)
	box(hangar,"HangarRoof",hg.x1-4,hg.x2+4,G+46,G+48,hg.z1-4,hg.z2+4,C.metal,M.Metal)
	-- folded door panels at both ends of the opening
	for _,z in {hg.z1+4,hg.z2-12} do box(hangar,"HangarDoor",hg.x2-3,hg.x2-1,A.apronTop,G+36,z,z+8,rgb(200,204,206),M.Metal) end
	local cz=(hg.z1+hg.z2)/2
	local hs=mk(hangar,"HangarSign",Vector3.new(60,6,.4),CFrame.lookAt(Vector3.new(hg.x2+.3,G+41,cz),Vector3.new(hg.x2+5,G+41,cz)),C.metal,M.Metal,true)
	label(hs,"HANGAR 1  ·  BUSINESS AVIATION",Enum.NormalId.Front,{ink=INK,far=true})
	Aircraft.build(hangar,CFrame.lookAt(Vector3.new(hg.x1+70,A.apronTop,cz),Vector3.new(hg.x2+100,A.apronTop,cz)),{scale=.9,livery=C.brass,collide=true,name="PrivateJet"})
	kit.light(box(hangar,"HangarLight",hg.x1+20,hg.x2-20,G+45,G+45.5,cz-4,cz+4,C.lightNeutral,M.Neon,true),60,.8)
	-- company-jet stand on the hangar apron: painted box, lead-in line, marker part for the flight package
	local js=A.companyJetStand
	local jf=folder(hangar,"CompanyJetStandArea")
	local y=A.apronTop
	for _,s in {{-26,26,-34,-33},{-26,26,33,34},{-26,-25,-34,34},{25,26,-34,34}} do lbox(js,jf,"StandBox",s[1],s[2],0,.05,s[3],s[4],YELLOW,SM,true) end
	lbox(js,jf,"LeadInLine",-.25,.25,0,.05,-60,20,YELLOW,SM,true)
	local plate=lbox(js,jf,"StandLabel",-10,10,0,.05,10,22,rgb(60,62,64),SM,true)
	label(plate,"COMPANY JET",Enum.NormalId.Top,{ink=YELLOW,far=true})
	local marker=invisible(mk(jf,"CompanyJetStand",Vector3.new(46,.2,60),js,C.white,SM,true))
	marker:SetAttribute("Purpose","CompanyJet");marker:SetAttribute("Scale",.9)
	local _=y
	-- fuel farm east of the tower
	for _,z in {2600,2660} do
		local tank=mk(m,"FuelTank",Vector3.new(16,24,24),CFrame.new(980,G+8,z)*CFrame.Angles(0,0,math.pi/2),C.white,M.Metal)
		tank.Shape=Enum.PartType.Cylinder
	end
end

------------------------------------------------------------------------------------------------ perimeter, horizon
local function perimeter(m: Instance)
	local p=folder(m,"Perimeter")
	local z=3120
	for _,s in {{-1150,0},{0,1150}} do
		local fence=box(p,"PerimeterFence",s[1],s[2],G,G+9,z-.1,z+.1,rgb(150,156,160),M.DiamondPlate)
		fence.Transparency=.55
		box(p,"FenceRail",s[1],s[2],G+9,G+9.4,z-.2,z+.2,C.metal,M.Metal,true)
		box(p,"FenceWire",s[1],s[2],G+10.4,G+10.6,z-.15,z+.15,C.metal,M.Metal,true)
	end
	for x=-1150,1150,100 do box(p,"FencePost",x-.25,x+.25,G,G+10.8,z-.25,z+.25,C.metal,M.Metal,true) end
	-- service road inside the fence, trees and shrubs between the fence and the quay
	for _,s in {{-1140,0},{0,1140}} do box(p,"ServiceRoad",s[1],s[2],G+.02,G+.2,3090,3100,rgb(80,82,84),M.Asphalt) end
	local k=500
	for x=-1100,1100,90 do
		k+=1
		local h=hash("perim"..x)
		kit.tree(p,x+(h%30)-15,3150+(h%20),k,G+.1)
		if h%3==0 then ball(p,"Shrub",Vector3.new(x+30,G+2,3180),7,C.foliageLight,M.LeafyGrass,true) end
	end
end
-- Persistent backdrop: sea from the quay to Port Meridian, coastline land with low hills east and west,
-- islands in the bay. Few big parts (shown from the terminal and from the air beyond the streaming radius).
local function horizon(m: Instance)
	local hz=folder(m,"Horizon",Enum.ModelStreamingMode.Persistent)
	-- same water level as CityBuilder's harbour Sea (top G-3) so the two meet without a step; every strip that
	-- borders the city starts exactly at |x| = 1150 / z = 3800 (the edge of CityGround, DistrictFoundation and
	-- the harbour Sea), so no slit opens between the city and the backdrop
	local seaY1,seaY2=G-3.2,G-3
	local EDGE=City.HARBOUR.x2 -- 1150
	local water=C.water
	local function sea(x1: number,x2: number,z1: number,z2: number)
		glass(box(hz,"OpenSea",x1,x2,seaY1,seaY2,z1,z2,water,nil,true),.15)
	end
	sea(-2600,-EDGE,3206,5200);sea(EDGE,2600,3206,5200)
	sea(-EDGE,0,3800,5800);sea(0,EDGE,3800,5800);sea(-2600,-EDGE,5200,7240);sea(EDGE,2600,5200,7240)
	sea(-EDGE,0,5800,7500);sea(0,EDGE,5800,7500)
	-- coast land west and east of the city (top G-0.2: just under the city ground top G, no z-fight)
	local landC=rgb(112,138,96)
	local sand=rgb(214,200,160)
	for _,s in {{-2600,-EDGE},{EDGE,2600}} do
		box(hz,"CoastLand",s[1],s[2],G-4,G-.2,800,2800,landC,M.Grass,true)
		box(hz,"CoastLand",s[1],s[2],G-4,G-.2,2800,3206,landC,M.Grass,true)
		box(hz,"CoastLand",s[1],s[2],G-4,G-.2,-800,800,landC,M.Grass,true)
		-- beach strip in front of the coast land
		box(hz,"CoastBeach",s[1],s[2],G-4,G-1.6,3206,3220,sand,M.Sand,true)
	end
	-- a ragged shore: angled headlands with a sandy rim break the straight line the quay continues at z = 3206
	for _,side in {-1,1} do
		for _,h in {{1420,3232,300,64,-8},{1910,3268,440,150,13},{2380,3226,300,70,-5}} do
			local cf=CFrame.new(side*h[1],0,h[2])*CFrame.Angles(0,math.rad(side*h[5]),0)
			-- tops a little below the strips they overlap (beach G-1.6, land G-0.2): no coplanar faces
			mk(hz,"CoastSand",Vector3.new(h[3]+26,2.1,h[4]+26),cf+Vector3.new(0,G-2.95,0),sand,M.Sand,true)
			mk(hz,"CoastLand",Vector3.new(h[3],3.55,h[4]),cf+Vector3.new(0,G-2.225,0),landC,M.Grass,true)
		end
	end
	-- low hill lines (sunk spheres) on both coasts and two headlands
	local hills={{-1700,2350,520,40},{-2100,2900,700,58},{-1500,3050,380,34},{-2300,1700,800,70},{-1800,1200,600,48},
		{1700,2450,560,44},{2150,2950,760,62},{1520,3000,360,30},{2300,1800,820,72},{1850,1250,580,46},
		{-2300,3900,900,64},{2350,4050,960,70}}
	for i,h in hills do
		local d,v=h[3],h[4]
		ball(hz,"Hill",Vector3.new(h[1],G-d/2+v,h[2]),d,if i%3==0 then rgb(98,124,84) else rgb(108,134,92),M.Grass,true)
	end
	-- islands in the bay (sunk spheres with a sandy rim)
	for _,s in {{-650,4300,360,26},{520,4750,300,22},{1320,4150,240,18}} do
		local d,v=s[3],s[4]
		local r=math.sqrt(math.max(0,(d/2)^2-(d/2-v-3.2)^2)) -- radius of the hill at sea level
		post(hz,"IslandBeach",s[1],s[2],G-4,G-2.6,2*r+24,sand,M.Sand,true)
		ball(hz,"Island",Vector3.new(s[1],G-d/2+v,s[2]),d,rgb(96,124,82),M.Grass,true)
	end
end

------------------------------------------------------------------------------------------------ entry
-- Builds the airport under root/Airport. ticketText: ObjectText of the four home check-in prompts.
function Airport.build(root: Instance,k: Kit,ticketText: string): Model
	kit=k
	local m=folder(root,"Airport")
	-- apron first: the jet-bridge doors in the facade follow the parked aircraft
	local planes,bridges=apron(m)
	local _=planes
	local doorsBack: {number}={}
	for _,b in bridges do table.insert(doorsBack,b.bx) end
	local terminal=folder(m,"Terminal")
	shell(terminal,doorsBack)
	structure(terminal)
	local inside=folder(terminal,"TerminalInterior",Enum.ModelStreamingMode.Atomic)
	landside(inside,ticketText)
	arrivals(inside)
	security(inside)
	lounge(inside)
	crewRoom(inside)
	shops(inside)
	foodCourt(inside)
	restaurant(inside)
	quietZone(inside)
	for i,gx in A.stands do gateLounge(inside,i,gx,(bridges[i] and bridges[i].bx) or gx-11.4) end
	airsideSigns(inside)
	forecourt(m)
	carPark(m)
	runway(m)
	towerAndHangar(m)
	perimeter(m)
	horizon(m)
	return m
end
return Airport
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000015"><Properties><string name="Name">ArchKit</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- ArchKit: the shared architecture + furniture library of the headquarters generators.
-- Full reference: docs/ArchKit.md. Conventions in short:
--   * Every builder takes (parent, cf, ...): cf = building (plot) CFrame; positions are
--     building-local CFrames `at` (world = cf * at). `at` sits at FLOOR level: pass the top of the
--     floor finish (level Y + Kit.FINISH when Kit.floor was used).
--   * Front = local -Z of `at`. A seat's sitter looks along -Z; cabinets, shelves, screens and boards
--     show their face towards -Z. Desks: the user sits on the -Z side and looks towards +Z.
--   * Anchor: free-standing furniture is centred on `at`; wall units and wall-mounted items take `at`
--     on the wall SURFACE (back at local z = 0, the body extends towards -Z).
--   * Only ArchPalette colours/materials. Everything Anchored. Small decorative parts never collide,
--     touch, query or cast shadows. All variation is deterministic (Kit.hash / Kit.rand / Kit.pick).
local Collection = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local A = require(ReplicatedStorage.Shared.Config.ArchPalette)
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout = require(ReplicatedStorage.Shared.BuildingLayout)

type DoorDef = Layout.DoorDef
type Wall = Layout.Wall
type Room = Plan.Room

local Kit = {}
Kit.A = A
Kit.C = A.color
Kit.M = A.material
Kit.FINISH = 0.1 -- thickness of Kit.floor finishes (finished floor = level Y + 0.1)
Kit.CEILING = 13 -- suspended ceiling underside above level Y
Kit.PANEL_PITCH = 4 -- batten grid of "panel" walls and flush doors (building-local multiples)
-- Budget switch: when true, doors drop hinges/kick plates/vision strips, glass walls drop mullions and
-- panel walls drop battens (flush doors keep theirs). Set once before building (default false).
Kit.LEAN = false
Kit.stats = { parts = 0, lights = 0 }

local C = A.color
local M = A.material
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local PI = math.pi

export type Opts = {
	detail: boolean?, -- non-colliding, non-touch, non-query, no shadow
	transparency: number?,
	shape: Enum.PartType?,
	castShadow: boolean?,
	canCollide: boolean?,
	canTouch: boolean?,
	canQuery: boolean?,
	reflectance: number?,
}
export type Rect = { x1: number, x2: number, z1: number, z2: number }

local DETAIL: Opts = { detail = true }
local GLASS: Opts = { transparency = A.glassTransparency, castShadow = false }
local GLASS_DOOR: Opts = { transparency = A.glassTransparencyDoor, castShadow = false }

---------------------------------------------------------------------------------------------
-- Determinism
---------------------------------------------------------------------------------------------
local TWO32 = 4294967296
local function mul32(a: number, b: number): number
	local ah, al = a // 65536, a % 65536
	return ((ah * b) % 65536 * 65536 + al * b) % TWO32
end
local function norm(seed: number): number
	return math.floor(seed) % TWO32
end

-- FNV-1a 32 bit: same string -&gt; same number on every server.
function Kit.hash(s: string): number
	local h = 2166136261
	for i = 1, #s do
		h = mul32(bit32.bxor(h, string.byte(s, i)), 16777619)
	end
	return h
end

-- Deterministic float in [0, 1) for (seed, i).
function Kit.rand(seed: number, i: number): number
	local h = bit32.bxor(norm(seed), mul32(norm(i) + 1, 0x9E3779B1))
	h = mul32(bit32.bxor(h, bit32.rshift(h, 15)), 0x85EBCA6B)
	h = mul32(bit32.bxor(h, bit32.rshift(h, 13)), 0xC2B2AE35)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h / TWO32
end

function Kit.range(seed: number, i: number, lo: number, hi: number): number
	return lo + (hi - lo) * Kit.rand(seed, i)
end

function Kit.pick&lt;T&gt;(list: { T }, seed: number): T
	return list[norm(seed) % #list + 1]
end

---------------------------------------------------------------------------------------------
-- Placement helpers
---------------------------------------------------------------------------------------------
local FRONT_YAW: { [string]: number } = { S = 0, N = PI, E = -PI / 2, W = PI / 2 }

-- CFrame at (x, y, z) whose front (-Z) faces "N" (+Z), "S" (-Z), "E" (+X), "W" (-X) or a yaw in degrees.
function Kit.place(x: number, y: number, z: number, front: (string | number)?): CFrame
	local yaw = 0
	if type(front) == "string" then
		yaw = FRONT_YAW[front] or 0
	elseif type(front) == "number" then
		yaw = math.rad(front)
	end
	return CF(x, y, z) * ANG(0, yaw, 0)
end

-- CFrame at pos whose front (-Z) looks horizontally towards `toward` (both building-local).
function Kit.facing(pos: Vector3, toward: Vector3): CFrame
	local target = V3(toward.X, pos.Y, toward.Z)
	if (target - pos).Magnitude &lt; 1e-3 then
		return CF(pos)
	end
	return CFrame.lookAt(pos, target)
end

function Kit.levelY(level: number): number
	return Plan.levelY(level)
end

function Kit.model(parent: Instance, name: string, atomic: boolean?): Model
	local m = Instance.new("Model")
	m.Name = name
	if atomic then
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end
	m.Parent = parent
	return m
end

function Kit.resetStats()
	Kit.stats.parts = 0
	Kit.stats.lights = 0
end

---------------------------------------------------------------------------------------------
-- Primitives
---------------------------------------------------------------------------------------------
local function setup(p: BasePart, parent: Instance, cf: CFrame, name: string, size: Vector3, at: CFrame, color: Color3, material: Enum.Material?, opts: Opts?)
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf * at
	p.Color = color
	p.Material = material or M.smooth
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.detail then
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.CastShadow = false
		end
		if opts.canCollide ~= nil then
			p.CanCollide = opts.canCollide
		end
		if opts.canTouch ~= nil then
			p.CanTouch = opts.canTouch
		end
		if opts.canQuery ~= nil then
			p.CanQuery = opts.canQuery
		end
		if opts.castShadow ~= nil then
			p.CastShadow = opts.castShadow
		end
		if opts.transparency then
			p.Transparency = opts.transparency
		end
		if opts.reflectance then
			p.Reflectance = opts.reflectance
		end
	end
	Kit.stats.parts += 1
	p.Parent = parent
end

-- Box (or opts.shape) part at cf * at.
function Kit.part(parent: Instance, cf: CFrame, name: string, size: Vector3, at: CFrame, color: Color3, material: Enum.Material?, opts: Opts?): Part
	local p = Instance.new("Part")
	if opts and opts.shape then
		p.Shape = opts.shape
	end
	setup(p, parent, cf, name, size, at, color, material, opts)
	return p
end

local AXIS_ROT: { [string]: CFrame } = {
	x = CFrame.identity,
	y = ANG(0, 0, PI / 2),
	z = ANG(0, PI / 2, 0),
}
-- Cylinder whose length runs along the local axis ("x" | "y" | "z") of `at`.
function Kit.cylinder(parent: Instance, cf: CFrame, name: string, axis: string, length: number, diameter: number, at: CFrame, color: Color3, material: Enum.Material?, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	setup(p, parent, cf, name, V3(length, diameter, diameter), at * (AXIS_ROT[axis] or CFrame.identity), color, material, opts)
	return p
end

function Kit.ball(parent: Instance, cf: CFrame, name: string, diameter: number, at: CFrame, color: Color3, material: Enum.Material?, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	setup(p, parent, cf, name, V3(diameter, diameter, diameter), at, color, material, opts)
	return p
end

-- WedgePart: full bottom face, vertical face at +Z, slope falling towards -Z.
function Kit.wedge(parent: Instance, cf: CFrame, name: string, size: Vector3, at: CFrame, color: Color3, material: Enum.Material?, opts: Opts?): WedgePart
	local p = Instance.new("WedgePart")
	setup(p, parent, cf, name, size, at, color, material, opts)
	return p
end

-- Seat part (CanTouch stays true unless opts.canTouch == false).
function Kit.seat(parent: Instance, cf: CFrame, name: string, size: Vector3, at: CFrame, color: Color3, material: Enum.Material?, opts: Opts?): Seat
	local p = Instance.new("Seat")
	if opts and opts.shape then
		p.Shape = opts.shape
	end
	setup(p, parent, cf, name, size, at, color, material, opts)
	return p
end

export type TextOpts = {
	face: Enum.NormalId?,
	color: Color3?,
	font: Enum.Font?,
	light: number?, -- LightInfluence (default 0.25)
	maxDistance: number?, -- default 80
	align: string?, -- "left" | "center" | "right"
	valign: string?, -- "top" | "center" | "bottom"
	size: number?, -- TextSize in px (default: TextScaled)
	name: string?, -- TextLabel name (default "Label")
	guiName: string?, -- SurfaceGui name (default "SurfaceGui")
	pps: number?, -- PixelsPerStud (default 50)
	pad: number?, -- padding as a fraction of the face (default 0.06)
	wrap: boolean?,
}
-- SurfaceGui (PixelsPerStud sizing) with one TextLabel covering the face.
function Kit.text(part: BasePart, text: string, opts: TextOpts?): TextLabel
	local o: TextOpts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = o.guiName or "SurfaceGui"
	gui.Face = o.face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.pps or 50
	gui.LightInfluence = o.light or 0.25
	gui.MaxDistance = o.maxDistance or 80
	gui.Parent = part
	local pad = o.pad or 0.06
	local label = Instance.new("TextLabel")
	label.Name = o.name or "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(pad, pad)
	label.Size = UDim2.fromScale(1 - 2 * pad, 1 - 2 * pad)
	label.Text = text
	label.TextColor3 = o.color or C.white
	label.Font = o.font or Enum.Font.BuilderSansBold
	label.TextWrapped = o.wrap ~= false
	if o.size then
		label.TextSize = o.size
	else
		label.TextScaled = true
	end
	label.TextXAlignment = if o.align == "left" then Enum.TextXAlignment.Left elseif o.align == "right" then Enum.TextXAlignment.Right else Enum.TextXAlignment.Center
	label.TextYAlignment = if o.valign == "top" then Enum.TextYAlignment.Top elseif o.valign == "bottom" then Enum.TextYAlignment.Bottom else Enum.TextYAlignment.Center
	label.Parent = gui
	return label
end

-- Light object on a part. `mood` = ArchPalette.mood key (colour/range/brightness) or a Color3.
function Kit.light(part: BasePart, kind: string, mood: (string | Color3)?, range: number?, brightness: number?, face: Enum.NormalId?): Light
	local color, r, b = C.lightNeutral, 16, 0.7
	if typeof(mood) == "Color3" then
		color = mood
	elseif type(mood) == "string" then
		local m = (A.mood :: any)[mood]
		if m then
			color, r, b = m.color, m.range, m.brightness
		end
	end
	local light: Light
	if kind == "surface" then
		local s = Instance.new("SurfaceLight")
		s.Face = face or Enum.NormalId.Bottom
		s.Angle = 110
		s.Range = range or r
		light = s
	elseif kind == "spot" then
		local s = Instance.new("SpotLight")
		s.Face = face or Enum.NormalId.Bottom
		s.Angle = 70
		s.Range = range or r
		light = s
	else
		local s = Instance.new("PointLight")
		s.Range = range or r
		light = s
	end
	light.Color = color
	light.Brightness = brightness or b
	light.Shadows = false
	light.Parent = part
	Kit.stats.lights += 1
	return light
end

---------------------------------------------------------------------------------------------
-- PropFx (design/PROPFX_CONTRACT.md): animated props are tagged at build time; the client
-- (PropFxController) animates them locally, the server only writes FxState / FxUntil.
---------------------------------------------------------------------------------------------
Kit.FX_TAG = "PropFx"
-- Tags `inst` as a PropFx root: `kinds` = comma-separated Fx kinds ("steam,blink"), `attrs` = static
-- contract attributes (FxAxis, FxRate, FxTravel, FxHinge, FxIdle, FxStation, FxGate, PropId, ...).
function Kit.fx(inst: Instance, kinds: string, attrs: { [string]: any }?): Instance
	inst:SetAttribute("Fx", kinds)
	if attrs then
		for k, v in attrs do
			inst:SetAttribute(k, v)
		end
	end
	Collection:AddTag(inst, Kit.FX_TAG)
	return inst
end

-- Atomic prop model whose pivot is `cf * at` (motion kinds of a Model root use the pivot frame).
function Kit.propModel(parent: Instance, cf: CFrame, name: string, at: CFrame): Model
	local m = Instance.new("Model")
	m.Name = name
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	m.WorldPivot = cf * at
	m.Parent = parent
	return m
end

-- Disabled steam emitter (the client toggles it while the prop works).
function Kit.steamEmitter(part: BasePart, name: string?, rate: number?, size: number?): ParticleEmitter
	local steam = Instance.new("ParticleEmitter")
	steam.Name = name or "Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Rate = rate or 4
	steam.Lifetime = NumberRange.new(0.8, 1.6)
	steam.Speed = NumberRange.new(0.8, 1.5)
	steam.SpreadAngle = Vector2.new(10, 10)
	steam.EmissionDirection = Enum.NormalId.Top
	local s = size or 0.4
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s * 0.5), NumberSequenceKeypoint.new(1, s * 2) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	steam.Color = ColorSequence.new(C.white)
	steam.LightEmission = 0.1
	steam.Enabled = false
	steam.Parent = part
	return steam
end

-- Disabled flame on a burner part (Roblox clamps Fire.Size to 2..30).
function Kit.flame(part: BasePart, size: number?): Fire
	local fire = Instance.new("Fire")
	fire.Size = math.max(size or 2, 2)
	fire.Heat = 1
	fire.Color = Color3.fromRGB(70, 120, 255)
	fire.SecondaryColor = Color3.fromRGB(255, 160, 60)
	fire.Enabled = false
	fire.Parent = part
	return fire
end

---------------------------------------------------------------------------------------------
-- OfficeKit-compatible contracts: screen, prompt, action, station, activity, node
---------------------------------------------------------------------------------------------
-- Live screen part (front face = -Z of `at`); SurfaceGui "Desktop" with Header/Body/Footer + ProgressTrack/Fill.
function Kit.screen(parent: Instance, cf: CFrame, name: string, size: Vector3, at: CFrame, kind: string, accent: Color3): Part
	local screen = Kit.part(parent, cf, name, size, at, C.screen, M.smooth, { canCollide = false, canTouch = false, castShadow = false })
	screen:SetAttribute("LiveScreen", kind)
	Collection:AddTag(screen, "CompanyScreen")
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Desktop"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(800, 480)
	gui.LightInfluence = 0.15
	gui.MaxDistance = 120
	gui.Parent = screen
	local function text(n: string, x: number, y: number, w: number, h: number, ts: number, color: Color3): TextLabel
		local t = Instance.new("TextLabel")
		t.Name = n
		t.Position = UDim2.fromOffset(x, y)
		t.Size = UDim2.fromOffset(w, h)
		t.BackgroundTransparency = 1
		t.Text = ""
		t.TextSize = ts
		t.TextColor3 = color
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextYAlignment = Enum.TextYAlignment.Top
		t.Font = Enum.Font.BuilderSans
		t.TextWrapped = true
		t.Parent = gui
		return t
	end
	text("Header", 40, 30, 720, 50, 32, accent).Font = Enum.Font.BuilderSansBold
	text("Body", 40, 105, 720, 280, 27, C.white)
	text("Footer", 40, 416, 720, 40, 20, C.sageLight)
	local bar = Instance.new("Frame")
	bar.Name = "ProgressTrack"
	bar.Position = UDim2.fromOffset(40, 390)
	bar.Size = UDim2.fromOffset(720, 8)
	bar.BackgroundColor3 = C.metalSoft
	bar.BorderSizePixel = 0
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = accent
	fill.BorderSizePixel = 0
	fill.Parent = bar
	return screen
end

-- Owner prompt: opens the Computer app (App/Section) for the founder only.
function Kit.prompt(part: Instance, objectText: string, owner: number, app: string?, section: string?): ProximityPrompt
	local q = Instance.new("ProximityPrompt")
	q.ObjectText = objectText
	q.ActionText = "Open"
	q.MaxActivationDistance = 10
	q.RequiresLineOfSight = true
	q.HoldDuration = 0
	q:SetAttribute("OwnerUserId", owner)
	if app then
		q:SetAttribute("App", app)
	end
	if section then
		q:SetAttribute("Section", section)
	end
	q.Parent = part
	return q
end

export type ActionOpts = {
	ownerOnly: boolean?, -- attribute OwnerOnly=true (server checks the owner)
	actionText: string?, -- default "Use"
	maxDistance: number?, -- default 8
	holdDuration: number?, -- default 0
	requiresLineOfSight: boolean?, -- default false
	ownerUserId: number?, -- hidden prompt: OwnerUserId=&lt;id&gt; INSTEAD of Public=true
	attributes: { [string]: any }?,
	name: string?,
}
-- Public facility prompt (CampusAction / Value / Public=true).
function Kit.action(part: Instance, actionId: string, objectText: string, value: any?, opts: ActionOpts?): ProximityPrompt
	local o: ActionOpts = opts or {}
	local q = Instance.new("ProximityPrompt")
	if o.name then
		q.Name = o.name
	end
	q.ActionText = o.actionText or "Use"
	q.ObjectText = objectText
	q.MaxActivationDistance = o.maxDistance or 8
	q.HoldDuration = o.holdDuration or 0
	q.RequiresLineOfSight = o.requiresLineOfSight == true
	q:SetAttribute("CampusAction", actionId)
	if value ~= nil then
		q:SetAttribute("Value", value)
	end
	if o.ownerUserId then
		q:SetAttribute("OwnerUserId", o.ownerUserId)
	else
		q:SetAttribute("Public", true)
	end
	if o.ownerOnly then
		q:SetAttribute("OwnerOnly", true)
	end
	if o.attributes then
		for k, v in o.attributes do
			q:SetAttribute(k, v)
		end
	end
	q.Parent = part
	return q
end

---------------------------------------------------------------------------------------------
-- Seating
---------------------------------------------------------------------------------------------
export type ChairOpts = {
	lite: boolean?, -- no casters (5 parts)
	arms: boolean?, -- add two armrests
	color: Color3?,
	name: string?, -- Seat name (default "Seat")
	canTouch: boolean?, -- default true; workstation chairs pass false
	seatY: number?, -- seat cushion centre height (default 2.0)
}
-- Office swivel chair, footprint 2.4 x 2.4, sitter faces -Z. Returns the Seat.
function Kit.officeChair(parent: Instance, cf: CFrame, at: CFrame, seed: number?, opts: ChairOpts?): Seat
	local o: ChairOpts = opts or {}
	local s = seed or 0
	local fabric = o.color or Kit.pick({ C.fabricCharcoal, C.fabric, C.fabricBlue, C.fabricSand }, s)
	local sy = o.seatY or 2.0
	local seat = Kit.seat(parent, cf, o.name or "Seat", V3(2.3, 0.45, 2.2), at * CF(0, sy, -0.05), fabric, M.fabric, if o.canTouch == false then { canTouch = false } else nil)
	Kit.part(parent, cf, "ChairBack", V3(2.2, 2.3, 0.3), at * CF(0, sy + 1.33, 1.12) * ANG(math.rad(8), 0, 0), fabric, M.fabric)
	local stemLen = sy - 0.225 - 0.3
	Kit.cylinder(parent, cf, "ChairStem", "y", stemLen, 0.28, at * CF(0, 0.3 + stemLen / 2, 0), C.metal, M.metal, DETAIL)
	for _, yaw in { math.rad(36), math.rad(-36) } do
		Kit.part(parent, cf, "ChairBase", V3(2.3, 0.16, 0.28), at * CF(0, 0.3, 0) * ANG(0, yaw, 0), C.metal, M.metal, DETAIL)
		if not o.lite then
			for _, e in { -1.05, 1.05 } do
				Kit.ball(parent, cf, "Caster", 0.32, at * CF(e * math.cos(yaw), 0.16, -e * math.sin(yaw)), C.metalSoft, M.rubber, DETAIL)
			end
		end
	end
	if o.arms then
		for _, x in { -1.25, 1.25 } do
			Kit.part(parent, cf, "ArmRest", V3(0.22, 0.95, 1.2), at * CF(x, sy + 0.6, 0.15), C.metal, M.metal, DETAIL)
		end
	end
	return seat
end

-- Meeting/visitor chair on four legs, footprint 2.1 x 2.0, sitter faces -Z. Returns the Seat.
function Kit.meetingChair(parent: Instance, cf: CFrame, at: CFrame, seed: number?, opts: ChairOpts?): Seat
	local o: ChairOpts = opts or {}
	local s = seed or 0
	local cover = o.color or Kit.pick({ C.leather, C.fabric, C.fabricSand, C.fabricCharcoal, C.fabricBlue }, s)
	local wood = Kit.rand(s, 3) &lt; 0.5
	local seat = Kit.seat(parent, cf, o.name or "Seat", V3(2.1, 0.35, 2.0), at * CF(0, 1.85, 0), cover, if cover == C.leather then M.leather else M.fabric, if o.canTouch == false then { canTouch = false } else nil)
	Kit.part(parent, cf, "ChairBack", V3(2.0, 1.8, 0.22), at * CF(0, 2.95, 0.92) * ANG(math.rad(6), 0, 0), cover, if cover == C.leather then M.leather else M.fabric)
	for _, x in { -0.85, 0.85 } do
		for _, z in { -0.8, 0.8 } do
			Kit.part(parent, cf, "ChairLeg", V3(0.16, 1.68, 0.16), at * CF(x, 0.84, z), if wood then C.oakDark else C.metal, if wood then M.wood else M.metal, DETAIL)
		end
	end
	return seat
end

-- Upholstered lounge armchair, footprint 3.0 x 2.9, sitter faces -Z. Returns the Seat.
function Kit.loungeChair(parent: Instance, cf: CFrame, at: CFrame, seed: number?, opts: ChairOpts?): Seat
	local o: ChairOpts = opts or {}
	local s = seed or 0
	local cover = o.color or Kit.pick({ C.fabricSand, C.sage, C.fabricBlue, C.leather, C.fabricCharcoal }, s)
	local mat = if cover == C.leather then M.leather else M.fabric
	Kit.part(parent, cf, "ChairBase", V3(3.0, 1.0, 2.9), at * CF(0, 0.7, 0), cover, mat)
	local seat = Kit.seat(parent, cf, o.name or "Seat", V3(2.2, 0.45, 2.3), at * CF(0, 1.42, -0.3), cover, mat, if o.canTouch == false then { canTouch = false } else nil)
	Kit.part(parent, cf, "ChairBack", V3(3.0, 1.9, 0.6), at * CF(0, 2.15, 1.15), cover, mat)
	for _, x in { -1.3, 1.3 } do
		Kit.part(parent, cf, "ArmRest", V3(0.4, 1.0, 2.3), at * CF(x, 1.7, -0.3), cover, mat)
	end
	local legColor = if Kit.rand(s, 5) &lt; 0.5 then C.oakDark else C.metal
	for _, z in { -1.1, 1.1 } do
		Kit.part(parent, cf, "ChairLeg", V3(2.6, 0.2, 0.2), at * CF(0, 0.1, z), legColor, if legColor == C.metal then M.metal else M.wood, DETAIL)
	end
	return seat
end

-- Sofa of `length` (default 7), depth 3.0, sitter faces -Z. One Seat per ~3 studs; returns the Seats.
function Kit.sofa(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?, opts: ChairOpts?): { Seat }
	local o: ChairOpts = opts or {}
	local L = math.max(length or 7, 4)
	local s = seed or 0
	local cover = o.color or Kit.pick({ C.fabricSand, C.sage, C.fabricBlue, C.fabricCharcoal, C.leather }, s)
	local mat = if cover == C.leather then M.leather else M.fabric
	Kit.part(parent, cf, "SofaBase", V3(L, 1.0, 3.0), at * CF(0, 0.7, 0), cover, mat)
	Kit.part(parent, cf, "SofaBack", V3(L, 1.9, 0.65), at * CF(0, 2.15, 1.175), cover, mat)
	for _, x in { -1, 1 } do
		Kit.part(parent, cf, "SofaArm", V3(0.5, 1.0, 2.35), at * CF(x * (L / 2 - 0.25), 1.7, -0.325), cover, mat)
	end
	local inner = L - 1.0
	local n = math.max(1, math.floor(inner / 3 + 0.5))
	local w = inner / n
	local seats: { Seat } = {}
	for i = 1, n do
		local x = -inner / 2 + (i - 0.5) * w
		table.insert(seats, Kit.seat(parent, cf, o.name or "Seat", V3(w - 0.06, 0.45, 2.35), at * CF(x, 1.425, -0.325), cover, mat, if o.canTouch == false then { canTouch = false } else nil))
	end
	local legColor = if Kit.rand(s, 7) &lt; 0.5 then C.oakDark else C.metal
	for _, z in { -1.2, 1.2 } do
		Kit.part(parent, cf, "SofaLeg", V3(L - 0.6, 0.2, 0.2), at * CF(0, 0.1, z), legColor, if legColor == C.metal then M.metal else M.wood, DETAIL)
	end
	return seats
end

-- Round stool; seat top at `height` (default 3.0 = bar stool, 2.2 = low). Sitter faces -Z.
function Kit.stool(parent: Instance, cf: CFrame, at: CFrame, seed: number?, height: number?, opts: ChairOpts?): Seat
	local o: ChairOpts = opts or {}
	local s = seed or 0
	local h = height or 3.0
	local top = o.color or Kit.pick({ C.oak, C.leather, C.fabricCharcoal, C.oakLight }, s)
	local sopts: Opts = { shape = Enum.PartType.Cylinder }
	if o.canTouch == false then
		sopts.canTouch = false
	end
	local seat = Kit.seat(parent, cf, o.name or "Seat", V3(0.3, 1.5, 1.5), at * CF(0, h - 0.15, 0) * ANG(0, 0, PI / 2), top, if top == C.leather then M.leather else M.wood, sopts)
	Kit.cylinder(parent, cf, "StoolPost", "y", h - 0.4, 0.22, at * CF(0, 0.1 + (h - 0.4) / 2, 0), C.metal, M.metal, DETAIL)
	Kit.cylinder(parent, cf, "StoolBase", "y", 0.1, 1.3, at * CF(0, 0.05, 0), C.metal, M.metal)
	return seat
end

-- Bench of `length` (default 6), depth 1.6, seat top 1.75. One Seat per ~3 studs; returns the Seats.
function Kit.bench(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?, opts: ChairOpts?): { Seat }
	local o: ChairOpts = opts or {}
	local L = math.max(length or 6, 2)
	local s = seed or 0
	local top = o.color or Kit.pick({ C.oak, C.oakLight, C.oakDark }, s)
	local n = math.max(1, math.floor(L / 3))
	local w = L / n
	local seats: { Seat } = {}
	for i = 1, n do
		table.insert(seats, Kit.seat(parent, cf, o.name or "Seat", V3(w - 0.05, 0.3, 1.6), at * CF(-L / 2 + (i - 0.5) * w, 1.6, 0), top, M.wood, if o.canTouch == false then { canTouch = false } else nil))
	end
	for _, x in { -1, 1 } do
		Kit.part(parent, cf, "BenchLeg", V3(0.3, 1.45, 1.4), at * CF(x * (L / 2 - 0.5), 0.725, 0), C.metal, M.metal)
	end
	return seats
end

---------------------------------------------------------------------------------------------
-- Desks and tables
---------------------------------------------------------------------------------------------
-- Desk variants: user side at -Z. Returns (top part, top surface height above `at`).
local DESK_TOP: { [string]: number } = { bench = 3.15, ldesk = 3.15, standing = 4.15, dual = 3.15, trading = 3.15, lab = 3.2 }
Kit.DESK_VARIANTS = { "bench", "ldesk", "standing", "dual", "trading", "lab" }

local function woodOrPaint(color: Color3): Enum.Material
	return if color == C.white or color == C.plasterShade then M.smooth else M.wood
end

function Kit.desk(parent: Instance, cf: CFrame, at: CFrame, variant: string?, seed: number?, tint: Color3?): (Part, number)
	local v = variant or "bench"
	local s = seed or 0
	local top: Part
	if v == "ldesk" then
		local c = Kit.pick({ C.oak, C.oakLight, C.white }, s)
		top = Kit.part(parent, cf, "DeskTop", V3(7, 0.3, 3.4), at * CF(0, 3.0, 0), c, woodOrPaint(c))
		Kit.part(parent, cf, "DeskReturn", V3(1.6, 0.3, 2.8), at * CF(2.7, 3.0, -3.1), c, woodOrPaint(c))
		for _, x in { -3.2, 3.2 } do
			Kit.part(parent, cf, "DeskLeg", V3(0.25, 2.85, 3.0), at * CF(x, 1.425, 0), C.metal, M.metal)
		end
		Kit.part(parent, cf, "DeskPedestal", V3(1.5, 2.85, 2.6), at * CF(2.7, 1.425, -3.1), tint or C.plasterShade, M.smooth)
	elseif v == "standing" then
		local c = Kit.pick({ C.oakLight, C.white, C.oak }, s)
		top = Kit.part(parent, cf, "DeskTop", V3(6, 0.25, 3.0), at * CF(0, 4.025, 0), c, woodOrPaint(c))
		for _, x in { -2.4, 2.4 } do
			Kit.part(parent, cf, "DeskColumn", V3(0.4, 3.7, 0.5), at * CF(x, 2.05, 0), C.metal, M.metal)
			Kit.part(parent, cf, "DeskFoot", V3(0.45, 0.2, 2.8), at * CF(x, 0.1, 0), C.metal, M.metal)
		end
	elseif v == "dual" then
		local c = Kit.pick({ C.oakDark, C.oak, C.metalSoft }, s)
		top = Kit.part(parent, cf, "DeskTop", V3(8, 0.3, 3.6), at * CF(0, 3.0, 0), c, if c == C.metalSoft then M.smooth else M.wood)
		for _, x in { -3.7, 3.7 } do
			Kit.part(parent, cf, "DeskLeg", V3(0.25, 2.85, 3.2), at * CF(x, 1.425, 0), C.metal, M.metal)
		end
		Kit.part(parent, cf, "ModestyPanel", V3(7.15, 1.2, 0.1), at * CF(0, 2.25, 1.55), tint or C.metalSoft, M.smooth, DETAIL)
		Kit.part(parent, cf, "PCTower", V3(1.0, 2.1, 2.2), at * CF(2.7, 1.05, 0.3), C.metal, M.metal)
	elseif v == "trading" then
		local c = Kit.pick({ C.oakDark, C.metalSoft }, s)
		local mat = if c == C.metalSoft then M.smooth else M.wood
		top = Kit.part(parent, cf, "DeskTop", V3(5, 0.3, 3.2), at * CF(0, 3.0, 0), c, mat)
		Kit.part(parent, cf, "DeskFascia", V3(5, 2.85, 0.15), at * CF(0, 1.425, 1.5), tint or C.metal, M.metal)
		local phi = 0.42
		for _, sgn in { -1, 1 } do
			local wing = at * CF(sgn * (2.5 + 1.8 * math.cos(phi)), 0, -1.8 * math.sin(phi)) * ANG(0, sgn * phi, 0)
			Kit.part(parent, cf, "DeskWing", V3(3.6, 0.3, 3.2), wing * CF(0, 2.99, 0), c, mat)
			Kit.part(parent, cf, "DeskFascia", V3(3.6, 2.85, 0.15), wing * CF(0, 1.415, 1.5), tint or C.metal, M.metal)
		end
	elseif v == "lab" then
		for _, x in { -2.4, 2.4 } do
			Kit.part(parent, cf, "LabCabinet", V3(2.0, 2.95, 3.0), at * CF(x, 1.475, 0.1), C.white, M.smooth)
		end
		top = Kit.part(parent, cf, "DeskTop", V3(7, 0.25, 3.4), at * CF(0, 3.075, 0), C.metalSoft, M.slate)
		for _, x in { -3.2, 3.2 } do
			Kit.part(parent, cf, "ShelfPost", V3(0.15, 3.0, 0.15), at * CF(x, 4.7, 1.6), C.metal, M.metal, DETAIL)
		end
		Kit.part(parent, cf, "ReagentShelf", V3(6.6, 0.12, 0.7), at * CF(0, 5.9, 1.35), C.white, M.smooth)
	else
		v = "bench"
		local c = Kit.pick({ C.oakLight, C.white, C.oak }, s)
		top = Kit.part(parent, cf, "DeskTop", V3(7, 0.3, 3.4), at * CF(0, 3.0, 0), c, woodOrPaint(c))
		for _, x in { -3.2, 3.2 } do
			Kit.part(parent, cf, "DeskLeg", V3(0.25, 2.85, 3.0), at * CF(x, 1.425, 0), C.metal, M.metal)
		end
		Kit.part(parent, cf, "ModestyPanel", V3(6.15, 1.2, 0.1), at * CF(0, 2.25, 1.45), C.metalSoft, M.smooth, DETAIL)
		Kit.part(parent, cf, "PrivacyScreen", V3(7, 1.2, 0.15), at * CF(0, 3.75, 1.62), tint or C.fabric, M.fabric)
	end
	return top, DESK_TOP[v] or 3.15
end

-- Meeting table: shape "rect" | "round" | "boat"; top surface 3.15. Returns the top.
function Kit.meetingTable(parent: Instance, cf: CFrame, at: CFrame, shape: string?, length: number?, width: number?, seed: number?): Part
	local s = seed or 0
	local L = length or 10
	local W = width or 4.5
	local c = Kit.pick({ C.oak, C.oakLight, C.white, C.oakDark }, s)
	local mat = woodOrPaint(c)
	if shape == "round" then
		local top = Kit.cylinder(parent, cf, "TableTop", "y", 0.25, L, at * CF(0, 3.025, 0), c, mat)
		Kit.cylinder(parent, cf, "TableColumn", "y", 2.7, 0.8, at * CF(0, 1.55, 0), C.metal, M.metal)
		Kit.cylinder(parent, cf, "TableFoot", "y", 0.2, math.max(1.6, L * 0.45), at * CF(0, 0.1, 0), C.metal, M.metal)
		return top
	end
	local core = if shape == "boat" then math.max(L - W, 1) else L
	local top = Kit.part(parent, cf, "TableTop", V3(core, 0.25, W), at * CF(0, 3.025, 0), c, mat)
	if shape == "boat" then
		for _, x in { -1, 1 } do
			Kit.cylinder(parent, cf, "TableEnd", "y", 0.25, W, at * CF(x * core / 2, 3.015, 0), c, mat)
		end
	end
	local pedestals: { number } = if L &gt; 16 then { -1, 0, 1 } else { -1, 1 }
	for _, k in pedestals do
		Kit.part(parent, cf, "TablePedestal", V3(0.4, 2.88, W * 0.6), at * CF(k * (L / 2 - 1.6), 1.44, 0), C.metal, M.metal)
	end
	Kit.part(parent, cf, "PowerHub", V3(1.2, 0.04, 0.6), at * CF(0, 3.17, 0), C.metal, M.metal, DETAIL)
	return top
end

-- Coffee table (round or rectangular by seed), top 1.4. Returns the top.
function Kit.coffeeTable(parent: Instance, cf: CFrame, at: CFrame, seed: number?, w: number?, d: number?): Part
	local s = seed or 0
	local W, D = w or 4, d or 2.4
	local c = Kit.pick({ C.oak, C.stone, C.oakDark, C.white }, s)
	local mat = if c == C.stone then M.marble elseif c == C.white then M.smooth else M.wood
	if Kit.rand(s, 11) &lt; 0.4 then
		local top = Kit.cylinder(parent, cf, "TableTop", "y", 0.2, math.max(W, D), at * CF(0, 1.3, 0), c, mat)
		Kit.cylinder(parent, cf, "TableBase", "y", 1.2, 0.8, at * CF(0, 0.6, 0), C.metal, M.metal)
		return top
	end
	local top = Kit.part(parent, cf, "TableTop", V3(W, 0.2, D), at * CF(0, 1.3, 0), c, mat)
	for _, x in { -1, 1 } do
		Kit.part(parent, cf, "TableLeg", V3(0.15, 1.2, D - 0.3), at * CF(x * (W / 2 - 0.3), 0.6, 0), C.metal, M.metal)
	end
	return top
end

---------------------------------------------------------------------------------------------
-- Storage (wall units: `at` on the wall surface, body towards -Z)
---------------------------------------------------------------------------------------------
-- Low sideboard, depth 1.6, height 2.82.
function Kit.sideboard(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?): Part
	local s = seed or 0
	local L = length or 6
	local body = Kit.pick({ C.oak, C.oakDark, C.white, C.sage }, s)
	local b = Kit.part(parent, cf, "Sideboard", V3(L, 2.4, 1.6), at * CF(0, 1.5, -0.8), body, woodOrPaint(body))
	Kit.part(parent, cf, "Plinth", V3(L - 0.3, 0.3, 1.3), at * CF(0, 0.15, -0.75), C.metal, M.metal)
	Kit.part(parent, cf, "SideboardTop", V3(L + 0.1, 0.12, 1.7), at * CF(0, 2.76, -0.85), C.stone, M.marble)
	local doors = math.max(2, math.floor(L / 2))
	for i = 1, doors - 1 do
		Kit.part(parent, cf, "Groove", V3(0.04, 2.2, 0.02), at * CF(-L / 2 + i * L / doors, 1.5, -1.61), C.metal, M.smooth, DETAIL)
	end
	if Kit.rand(s, 2) &lt; 0.6 then
		Kit.cylinder(parent, cf, "Vase", "y", 1.2, 0.6, at * CF(L * 0.25, 3.42, -0.8), Kit.pick({ C.terracotta, C.white, C.sageLight }, s), M.smooth, DETAIL)
	end
	if Kit.rand(s, 3) &lt; 0.6 then
		Kit.part(parent, cf, "Books", V3(1.2, 0.35, 0.9), at * CF(-L * 0.25, 2.995, -0.8), Kit.pick({ C.oakDark, C.blue, C.fabricSand }, s + 1), M.smooth, DETAIL)
	end
	return b
end

-- Cabinet w x h, depth 1.6, two doors with handles.
function Kit.cabinet(parent: Instance, cf: CFrame, at: CFrame, w: number?, h: number?, seed: number?): Part
	local s = seed or 0
	local W, H = w or 3, h or 6.5
	local c = Kit.pick({ C.white, C.oakLight, C.plasterShade, C.oak }, s)
	local body = Kit.part(parent, cf, "Cabinet", V3(W, H - 0.25, 1.6), at * CF(0, 0.25 + (H - 0.25) / 2, -0.8), c, woodOrPaint(c))
	Kit.part(parent, cf, "Plinth", V3(W - 0.2, 0.25, 1.4), at * CF(0, 0.125, -0.75), C.metal, M.metal)
	local hy = math.min(H - 0.6, 3.6)
	if W &gt;= 2 then
		Kit.part(parent, cf, "Groove", V3(0.04, H - 0.5, 0.02), at * CF(0, 0.25 + (H - 0.25) / 2, -1.61), C.metal, M.smooth, DETAIL)
		for _, x in { -0.25, 0.25 } do
			Kit.part(parent, cf, "Handle", V3(0.08, 0.8, 0.1), at * CF(x, hy, -1.65), C.metalSoft, M.metal, DETAIL)
		end
	else
		Kit.part(parent, cf, "Handle", V3(0.08, 0.8, 0.1), at * CF(W / 2 - 0.25, hy, -1.65), C.metalSoft, M.metal, DETAIL)
	end
	return body
end

export type LockerOpts = { propId: string?, prompt: string?, door: number? }
-- Bank of n lockers (1.5 wide each, 6.5 high, depth 1.6) in an Atomic "LockerBank" model whose pivot is
-- `at`. PropFx hinge: one door (opts.door, default by seed) swings open while the prop works (a player
-- prompt "prop" when opts.prompt is given, or an NPC job through opts.propId). Returns the door parts.
function Kit.lockers(parent: Instance, cf: CFrame, at: CFrame, n: number?, seed: number?, opts: LockerOpts?): { Part }
	local o: LockerOpts = opts or {}
	local s = seed or 0
	local count = math.max(1, n or 6)
	local W = count * 1.5
	local bank = Kit.propModel(parent, cf, "LockerBank", at)
	Kit.part(bank, cf, "LockerBody", V3(W, 6.2, 1.6), at * CF(0, 3.4, -0.8), C.plasterShade, M.metal)
	Kit.part(bank, cf, "Plinth", V3(W - 0.2, 0.3, 1.4), at * CF(0, 0.15, -0.75), C.metal, M.metal)
	local front = Kit.pick({ C.sage, C.blueSoft, C.oakLight, C.white }, s)
	local doors: { Part } = {}
	local open = math.clamp(o.door or (norm(s) % count + 1), 1, count)
	local openX = 0
	for i = 1, count do
		local x = -W / 2 + (i - 0.5) * 1.5
		local door = Kit.part(bank, cf, "LockerDoor", V3(1.42, 6.0, 0.06), at * CF(x, 3.4, -1.63), front, if front == C.oakLight then M.wood else M.metal, DETAIL)
		local handle = Kit.part(bank, cf, "LockerHandle", V3(0.1, 0.6, 0.08), at * CF(x + 0.5, 3.6, -1.7), C.metal, M.metal, DETAIL)
		table.insert(doors, door)
		if i == open then
			door:SetAttribute("FxMove", true)
			handle:SetAttribute("FxMove", true)
			openX = x
		end
	end
	-- hinge on the door's left edge (pivot space); a positive angle swings the free edge out (-Z)
	Kit.fx(bank, "hinge", { FxAxis = "y", FxTravel = 1.9, FxHinge = V3(openX - 0.71, 3.4, -1.63), FxSeconds = 4, PropId = o.propId })
	if o.prompt then
		Kit.action(doors[open], "prop", o.prompt, o.propId, { actionText = "Open", maxDistance = 6 })
	end
	return doors
end

local BOOK_COLORS = { C.leather, C.oakDark, C.sage, C.blue, C.terracotta, C.fabricSand, C.fabricCharcoal, C.white, C.brass, C.fabricBlue, C.sageLight }

-- Fill one shelf row [x1, x2] at floor height y (clear height rowH) with books in one or two
-- clusters (spines face -Z of `at`, backs near the wall at zFront); an optional lying stack sits in
-- the gap. Returns the number of parts made.
local function bookRow(parent: Instance, cf: CFrame, at: CFrame, x1: number, x2: number, y: number, rowH: number, zFront: number, seed: number, maxBooks: number): number
	local avail = x2 - x1
	local widths: { number } = {}
	local total = 0
	for i = 1, maxBooks do
		local w = Kit.range(seed, i, 0.3, 0.55)
		if total + w &gt; avail * 0.8 then
			break
		end
		table.insert(widths, w)
		total += w + 0.02
	end
	local n = #widths
	local free = avail - total
	local split = if free &gt; 1.6 and n &gt;= 4 then math.floor(n / 2 + Kit.range(seed, 40, -1, 1) + 0.5) else n
	local made = 0
	local function book(x: number, w: number, i: number, lean: number)
		local h = math.min(rowH - 0.12, Kit.range(seed, i + 50, 0.85, 1.35))
		Kit.part(parent, cf, "Book", V3(w, h, Kit.range(seed, i + 30, 0.8, 0.98)), at * CF(x + w / 2, y + h / 2, zFront - 0.48) * ANG(0, 0, lean), Kit.pick(BOOK_COLORS, seed + i * 7), M.smooth, DETAIL)
		made += 1
	end
	local x = x1 + Kit.range(seed, 41, 0.05, math.min(0.6, free * 0.2))
	for i = 1, split do
		book(x, widths[i], i, 0)
		x += widths[i] + 0.02
	end
	local gapStart = x
	if split &lt; n then
		local rest = 0
		for i = split + 1, n do
			rest += widths[i] + 0.02
		end
		x = x2 - Kit.range(seed, 42, 0.05, math.min(0.6, free * 0.2)) - rest
		local gapEnd = x
		if gapEnd - gapStart &gt; 1.3 and Kit.rand(seed, 43) &lt; 0.6 then
			local w = math.min(1.0, gapEnd - gapStart - 0.3)
			Kit.part(parent, cf, "Books", V3(w, 0.42, 0.85), at * CF((gapStart + gapEnd) / 2, y + 0.21, zFront - 0.5), Kit.pick(BOOK_COLORS, seed + 3), M.smooth, DETAIL)
			made += 1
		end
		for i = split + 1, n do
			book(x, widths[i], i, if i == split + 1 and Kit.rand(seed, 44) &lt; 0.4 then 0.16 else 0)
			x += widths[i] + 0.02
		end
	end
	return made
end

export type ShelfOpts = { books: number?, color: Color3? }
-- Bookshelf w x h (default 6 x 8), depth 1.3, filled with books (opts.books = max books per row, default 8).
function Kit.bookshelf(parent: Instance, cf: CFrame, at: CFrame, w: number?, h: number?, seed: number?, opts: ShelfOpts?): Part
	local o: ShelfOpts = opts or {}
	local s = seed or 0
	local W, H = w or 6, h or 8
	local c = o.color or Kit.pick({ C.oakDark, C.oak, C.white, C.metal }, s)
	local mat = if c == C.white then M.smooth elseif c == C.metal then M.metal else M.wood
	local back = Kit.part(parent, cf, "ShelfBack", V3(W, H, 0.1), at * CF(0, H / 2, -0.05), c, mat)
	for _, x in { -1, 1 } do
		Kit.part(parent, cf, "ShelfSide", V3(0.15, H, 1.2), at * CF(x * (W / 2 - 0.075), H / 2, -0.7), c, mat)
	end
	Kit.part(parent, cf, "ShelfTop", V3(W - 0.3, 0.15, 1.2), at * CF(0, H - 0.075, -0.7), c, mat)
	Kit.part(parent, cf, "ShelfPlinth", V3(W - 0.3, 0.35, 1.2), at * CF(0, 0.175, -0.7), c, mat)
	local rows = math.max(1, math.floor((H - 0.5) / 1.6))
	local rowH = (H - 0.5 - (rows - 1) * 0.1) / rows
	for r = 1, rows do
		local y = 0.35 + (r - 1) * (rowH + 0.1)
		if r &gt; 1 then
			Kit.part(parent, cf, "Shelf", V3(W - 0.3, 0.1, 1.15), at * CF(0, y - 0.05, -0.68), c, mat)
		end
		bookRow(parent, cf, at, -W / 2 + 0.15, W / 2 - 0.15, y, rowH, -0.1, s + r * 101, o.books or 8)
	end
	return back
end

-- Heavy warehouse pallet rack (free-standing, centred), length L x depth 3 x height 9, with boxes.
function Kit.shelfRack(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?): Part
	local s = seed or 0
	local L = length or 8
	local beam = Kit.pick({ C.blue, C.terracotta }, s)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.part(parent, cf, "RackPost", V3(0.25, 9, 0.25), at * CF(x * (L / 2 - 0.125), 4.5, z * 1.375), C.blue, M.metal)
		end
	end
	local first: Part? = nil
	for k, y in { 0.5, 3.5, 6.5 } do
		local deck = Kit.part(parent, cf, "RackDeck", V3(L - 0.5, 0.25, 3), at * CF(0, y, 0), beam, M.metal)
		first = first or deck
		local x = -L / 2 + 0.4
		local i = 0
		while x &lt; L / 2 - 1.8 and i &lt; 3 do
			local bw = Kit.range(s, k * 10 + i, 1.4, 2.4)
			local bh = Kit.range(s, k * 10 + i + 5, 1.0, 2.2)
			if x + bw &gt; L / 2 - 0.4 then
				break
			end
			Kit.part(parent, cf, "Box", V3(bw, bh, Kit.range(s, k * 10 + i + 7, 1.6, 2.6)), at * CF(x + bw / 2, y + 0.125 + bh / 2, 0), Kit.pick({ C.fabricSand, C.oakLight, C.white }, s + k + i), M.smooth)
			x += bw + Kit.range(s, k * 10 + i + 9, 0.2, 0.8)
			i += 1
		end
	end
	return first :: Part
end

-- Light metal wire shelving (wall unit), w x 7 x depth 1.6 with bins.
function Kit.rackShelf(parent: Instance, cf: CFrame, at: CFrame, w: number?, seed: number?): Part
	local s = seed or 0
	local W = w or 4
	for _, x in { -1, 1 } do
		for _, z in { -0.1, -1.5 } do
			Kit.part(parent, cf, "ShelfPost", V3(0.12, 7, 0.12), at * CF(x * (W / 2 - 0.06), 3.5, z), C.metalSoft, M.metal)
		end
	end
	local first: Part? = nil
	for k, y in { 0.5, 2.6, 4.7, 6.8 } do
		local shelf = Kit.part(parent, cf, "WireShelf", V3(W - 0.24, 0.08, 1.5), at * CF(0, y, -0.8), C.metalSoft, M.metal)
		first = first or shelf
		if k &lt; 4 and Kit.rand(s, k) &lt; 0.75 then
			local bw = Kit.range(s, k + 10, 1.0, math.min(2.2, W - 0.6))
			Kit.part(parent, cf, "Bin", V3(bw, 1.0, 1.3), at * CF(Kit.range(s, k + 20, -0.3, 0.3), y + 0.54, -0.8), Kit.pick({ C.blue, C.fabricSand, C.metal, C.sage }, s + k), M.smooth, DETAIL)
		end
	end
	return first :: Part
end

---------------------------------------------------------------------------------------------
-- Walls items (wall-mounted: `at` on the wall surface at floor level, face towards -Z)
---------------------------------------------------------------------------------------------
export type WallItemOpts = { y: number?, name: string?, floor: boolean?, h: number? }

-- Whiteboard w x 4 (centre 5 above floor) with tray, optional marker text and sticky notes.
function Kit.whiteboard(parent: Instance, cf: CFrame, at: CFrame, w: number?, text: string?, seed: number?, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local s = seed or 0
	local W = w or 6
	local y = o.y or 5
	Kit.part(parent, cf, "BoardFrame", V3(W + 0.2, 4.2, 0.1), at * CF(0, y, -0.05), C.metalSoft, M.metal)
	local board = Kit.part(parent, cf, o.name or "Whiteboard", V3(W, 4, 0.06), at * CF(0, y, -0.13), C.white, M.smooth)
	Kit.part(parent, cf, "MarkerTray", V3(W * 0.6, 0.1, 0.3), at * CF(0, y - 2.15, -0.25), C.metalSoft, M.metal, DETAIL)
	if text and text ~= "" then
		Kit.text(board, text, { color = C.blue, font = Enum.Font.GothamMedium, align = "left", valign = "top", light = 0.6, maxDistance = 60 })
	end
	local notes = math.floor(Kit.range(s, 1, 0, 4))
	for i = 1, notes do
		Kit.part(parent, cf, "StickyNote", V3(0.5, 0.5, 0.02), at * CF(W / 2 - 0.5 - (i - 1) * 0.65, y + 1.4 - Kit.range(s, i + 4, 0, 0.5), -0.17), Kit.pick({ C.fabricSand, C.sageLight, C.terracotta, C.blueSoft }, s + i), M.smooth, DETAIL)
	end
	return board
end

-- Pinboard (cork) w x h (default 4 x 3, centre 5) with pinned notes.
function Kit.pinboard(parent: Instance, cf: CFrame, at: CFrame, w: number?, h: number?, seed: number?, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local s = seed or 0
	local W, H = w or 4, h or 3
	local y = o.y or 5
	Kit.part(parent, cf, "PinboardFrame", V3(W + 0.2, H + 0.2, 0.1), at * CF(0, y, -0.05), C.oakDark, M.wood)
	local board = Kit.part(parent, cf, o.name or "Pinboard", V3(W, H, 0.06), at * CF(0, y, -0.13), C.fabricSand, M.fabric)
	local n = 4 + math.floor(Kit.range(s, 1, 0, 3))
	for i = 1, n do
		local nx = Kit.range(s, i * 3, -W / 2 + 0.5, W / 2 - 0.5)
		local ny = Kit.range(s, i * 3 + 1, -H / 2 + 0.5, H / 2 - 0.5)
		Kit.part(parent, cf, "Note", V3(0.6, 0.8, 0.02), at * CF(nx, y + ny, -0.17 - i * 0.002) * ANG(0, 0, Kit.range(s, i * 3 + 2, -0.2, 0.2)), Kit.pick({ C.white, C.fabricSand, C.blueSoft, C.sageLight }, s + i), M.smooth, DETAIL)
	end
	return board
end

-- Wall TV / display (16:9, width w, centre 5.5) built on Kit.screen. opts.floor adds a floor stand.
function Kit.tvScreen(parent: Instance, cf: CFrame, at: CFrame, w: number?, kind: string?, accent: Color3?, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local W = w or 6
	local H = o.h or W * 9 / 16
	local y = o.y or 5.5
	Kit.part(parent, cf, "ScreenBezel", V3(W + 0.2, H + 0.2, 0.12), at * CF(0, y, -0.06), C.metal, M.metal)
	local screen = Kit.screen(parent, cf, o.name or "WallScreen", V3(W, H, 0.1), at * CF(0, y, -0.17), kind or "lobby", accent or C.blue)
	if o.floor then
		for _, x in { -1, 1 } do
			Kit.part(parent, cf, "StandPost", V3(0.25, y + H / 2, 0.25), at * CF(x * (W / 2 - 0.6), (y + H / 2) / 2, 0.125), C.metal, M.metal)
		end
		Kit.part(parent, cf, "StandBase", V3(W, 0.15, 1.6), at * CF(0, 0.075, 0.125), C.metal, M.metal)
	end
	return screen
end

local ART_COLORS = { C.sage, C.terracotta, C.blue, C.brass, C.fabricSand, C.oakLight, C.metal, C.sageLight, C.blueSoft }

-- Framed abstract composition w x h (default 4 x 3, centre 5.5).
function Kit.artwork(parent: Instance, cf: CFrame, at: CFrame, w: number?, h: number?, seed: number?, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local s = seed or 0
	local W, H = w or 4, h or 3
	local y = o.y or 5.5
	local frameColor = Kit.pick({ C.oakDark, C.metal, C.white, C.oak }, s)
	local frame = Kit.part(parent, cf, o.name or "ArtFrame", V3(W, H, 0.12), at * CF(0, y, -0.06), frameColor, if frameColor == C.metal then M.metal else M.wood)
	Kit.part(parent, cf, "Canvas", V3(W - 0.3, H - 0.3, 0.04), at * CF(0, y, -0.14), C.white, M.fabric, DETAIL)
	local n = 3 + math.floor(Kit.range(s, 1, 0, 2))
	local cw, ch = W - 0.6, H - 0.6
	for i = 1, n do
		local pw = Kit.range(s, i * 5, 0.2, 0.6) * cw
		local ph = Kit.range(s, i * 5 + 1, 0.2, 0.7) * ch
		local px = Kit.range(s, i * 5 + 2, -(cw - pw) / 2, (cw - pw) / 2)
		local py = Kit.range(s, i * 5 + 3, -(ch - ph) / 2, (ch - ph) / 2)
		local color = Kit.pick(ART_COLORS, s + i * 13)
		local z = -0.17 - i * 0.01
		if Kit.rand(s, i * 5 + 4) &lt; 0.25 then
			local d = math.min(pw, ph)
			Kit.cylinder(parent, cf, "ArtDisc", "z", 0.02, d, at * CF(px, y + py, z), color, M.smooth, DETAIL)
		else
			Kit.part(parent, cf, "ArtPanel", V3(pw, ph, 0.02), at * CF(px, y + py, z), color, M.smooth, DETAIL)
		end
	end
	return frame
end

-- Felt acoustic panels covering w x h (default 6 x 3, centre 6.5). Returns the panels.
function Kit.acousticPanels(parent: Instance, cf: CFrame, at: CFrame, w: number?, h: number?, seed: number?, opts: WallItemOpts?): { Part }
	local o: WallItemOpts = opts or {}
	local s = seed or 0
	local W, H = w or 6, h or 3
	local y = o.y or 6.5
	local cols = math.clamp(math.floor(W / 2.2 + 0.5), 1, 6)
	local rows = math.clamp(math.floor(H / 2.2 + 0.5), 1, 3)
	local pw, ph = W / cols, H / rows
	local out: { Part } = {}
	for r = 1, rows do
		for c = 1, cols do
			local d = if (r + c) % 2 == 0 then 0.3 else 0.18
			local color = Kit.pick({ C.fabric, C.fabricSand, C.fabricCharcoal, C.fabricBlue, C.sageLight }, s + r * 7 + c)
			table.insert(out, Kit.part(parent, cf, "AcousticPanel", V3(pw - 0.15, ph - 0.15, d), at * CF(-W / 2 + (c - 0.5) * pw, y - H / 2 + (r - 0.5) * ph, -d / 2), color, M.fabric, DETAIL))
		end
	end
	return out
end

-- Room nameplate 3 x 1 (dark metal, white text, centre 5.6).
function Kit.signPlate(parent: Instance, cf: CFrame, at: CFrame, text: string, subtext: string?, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local plate = Kit.part(parent, cf, o.name or "Nameplate", V3(3, 1, 0.1), at * CF(0, o.y or 5.6, -0.05), C.metal, M.metal, DETAIL)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.LightInfluence = 0.3
	gui.MaxDistance = 45
	gui.Parent = plate
	local main = Instance.new("TextLabel")
	main.Name = "Label"
	main.BackgroundTransparency = 1
	main.Position = UDim2.fromScale(0.06, if subtext then 0.1 else 0.18)
	main.Size = UDim2.fromScale(0.88, if subtext then 0.5 else 0.64)
	main.Text = text
	main.TextScaled = true
	main.TextWrapped = true
	main.TextColor3 = C.white
	main.Font = Enum.Font.BuilderSansBold
	main.TextXAlignment = Enum.TextXAlignment.Left
	main.Parent = gui
	if subtext then
		local sub = Instance.new("TextLabel")
		sub.Name = "Sub"
		sub.BackgroundTransparency = 1
		sub.Position = UDim2.fromScale(0.06, 0.62)
		sub.Size = UDim2.fromScale(0.88, 0.28)
		sub.Text = subtext
		sub.TextScaled = true
		sub.TextColor3 = C.stoneDeep
		sub.Font = Enum.Font.BuilderSans
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.Parent = gui
	end
	return plate
end

-- Wall directory: lines[1] = title, then one line per entry. Width 4 (opts.h overrides line height).
function Kit.wayfinding(parent: Instance, cf: CFrame, at: CFrame, lines: { string }, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local n = math.max(#lines, 1)
	local lh = o.h or 0.5
	local H = 0.5 + n * lh
	local y = o.y or math.max(5.5, 1.2 + H / 2)
	local plate = Kit.part(parent, cf, o.name or "Directory", V3(4, H, 0.12), at * CF(0, y, -0.06), C.metal, M.metal)
	Kit.part(parent, cf, "DirectoryAccent", V3(4, 0.08, 0.02), at * CF(0, y + H / 2 - 0.25, -0.13), C.brass, M.metal, DETAIL)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 80
	gui.LightInfluence = 0.3
	gui.MaxDistance = 50
	gui.Parent = plate
	for i, line in lines do
		local t = Instance.new("TextLabel")
		t.Name = "Line" .. i
		t.BackgroundTransparency = 1
		t.Position = UDim2.new(0.05, 0, 0, math.floor((0.3 + (i - 1) * lh) * 80))
		t.Size = UDim2.new(0.9, 0, 0, math.floor(lh * 80 * 0.86))
		t.Text = line
		t.TextScaled = true
		t.TextColor3 = if i == 1 then C.brass else C.white
		t.Font = if i == 1 then Enum.Font.BuilderSansBold else Enum.Font.BuilderSans
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Parent = gui
	end
	return plate
end

-- Pegboard tool wall (w x 3.5, centre 5) with hand tools.
function Kit.toolWall(parent: Instance, cf: CFrame, at: CFrame, w: number?, seed: number?, opts: WallItemOpts?): Part
	local o: WallItemOpts = opts or {}
	local s = seed or 0
	local W = w or 5
	local y = o.y or 5
	local board = Kit.part(parent, cf, o.name or "Pegboard", V3(W, 3.5, 0.1), at * CF(0, y, -0.05), C.oakLight, M.wood)
	local slots = math.max(2, math.floor(W / 1.1))
	for i = 1, slots do
		local x = -W / 2 + (i - 0.5) * W / slots
		local kind = math.floor(Kit.range(s, i, 0, 4))
		if kind == 0 then
			Kit.part(parent, cf, "ToolHandle", V3(0.15, 1.2, 0.12), at * CF(x, y - 0.2, -0.16), C.oakDark, M.wood, DETAIL)
			Kit.part(parent, cf, "ToolHead", V3(0.6, 0.22, 0.16), at * CF(x, y + 0.5, -0.18), C.metal, M.metal, DETAIL)
		elseif kind == 1 then
			Kit.part(parent, cf, "Wrench", V3(0.14, 1.1, 0.05), at * CF(x, y, -0.13) * ANG(0, 0, 0.15), C.metalSoft, M.metal, DETAIL)
		elseif kind == 2 then
			Kit.cylinder(parent, cf, "Screwdriver", "y", 1.0, 0.16, at * CF(x, y - 0.3, -0.18), C.terracotta, M.smooth, DETAIL)
		else
			Kit.part(parent, cf, "Pliers", V3(0.3, 0.9, 0.06), at * CF(x, y + 0.2, -0.13), C.metal, M.metal, DETAIL)
		end
	end
	return board
end

---------------------------------------------------------------------------------------------
-- Plants, rugs, lamps
---------------------------------------------------------------------------------------------
-- Potted plant: size "s" | "m" | "l" | "tree" | "xl" (atrium tree, ~16 high). Returns the pot.
function Kit.plant(parent: Instance, cf: CFrame, at: CFrame, size: string?, seed: number?): Part
	local s = seed or 0
	local sz = size or "m"
	local potColor = Kit.pick({ C.terracotta, C.stoneDeep, C.white, C.metal }, s)
	local potMat = if potColor == C.metal then M.metal elseif potColor == C.terracotta then M.smooth else M.concrete
	local leaf = if Kit.rand(s, 1) &lt; 0.5 then C.foliage else C.foliageLight
	local yaw = Kit.range(s, 2, 0, 2 * PI)
	if sz == "s" then
		local pot = Kit.cylinder(parent, cf, "Planter", "y", 1.1, 1.2, at * CF(0, 0.55, 0), potColor, potMat)
		Kit.ball(parent, cf, "Foliage", 1.6, at * CF(0, 1.8, 0), leaf, M.grass, DETAIL)
		return pot
	elseif sz == "m" then
		local pot = Kit.cylinder(parent, cf, "Planter", "y", 1.6, 1.8, at * CF(0, 0.8, 0), potColor, potMat)
		Kit.cylinder(parent, cf, "Stem", "y", 1.6, 0.2, at * CF(0, 2.3, 0), C.oakDark, M.wood, DETAIL)
		Kit.ball(parent, cf, "Foliage", 2.2, at * CF(0, 3.4, 0), leaf, M.grass, DETAIL)
		Kit.ball(parent, cf, "Foliage", 1.6, at * ANG(0, yaw, 0) * CF(0.6, 2.7, 0), C.foliageLight, M.grass, DETAIL)
		return pot
	elseif sz == "l" then
		local pot = Kit.part(parent, cf, "Planter", V3(2.4, 2.0, 2.4), at * CF(0, 1.0, 0), potColor, potMat)
		Kit.cylinder(parent, cf, "Stem", "y", 3.0, 0.3, at * CF(0, 3.5, 0), C.oakDark, M.wood, DETAIL)
		Kit.ball(parent, cf, "Foliage", 2.6, at * CF(0, 5.0, 0), leaf, M.leafy, DETAIL)
		Kit.ball(parent, cf, "Foliage", 2.0, at * ANG(0, yaw, 0) * CF(0.9, 4.3, 0), C.foliageLight, M.leafy, DETAIL)
		Kit.ball(parent, cf, "Foliage", 1.8, at * ANG(0, yaw + 2.2, 0) * CF(0.7, 5.8, 0), C.foliage, M.leafy, DETAIL)
		return pot
	end
	local big = sz == "xl"
	local k = if big then 1.6 else 1
	local planter = Kit.part(parent, cf, "Planter", V3(3.6 * k, 2.2, 3.6 * k), at * CF(0, 1.1, 0), potColor, potMat)
	Kit.part(parent, cf, "Soil", V3(3.3 * k, 0.1, 3.3 * k), at * CF(0, 2.25, 0), C.soil, M.grass, DETAIL)
	local trunk = 5 * k
	Kit.cylinder(parent, cf, "Trunk", "y", trunk, 0.6 * k, at * CF(0, 2.2 + trunk / 2, 0), C.oakDark, M.wood)
	local top = 2.2 + trunk
	Kit.ball(parent, cf, "Canopy", 4.0 * k, at * CF(0, top + 0.6 * k, 0), leaf, M.leafy, DETAIL)
	Kit.ball(parent, cf, "Canopy", 3.2 * k, at * ANG(0, yaw, 0) * CF(1.4 * k, top, 0), C.foliageLight, M.leafy, DETAIL)
	Kit.ball(parent, cf, "Canopy", 3.0 * k, at * ANG(0, yaw + 2.4, 0) * CF(1.1 * k, top + 1.6 * k, 0), C.foliage, M.leafy, DETAIL)
	return planter
end

-- Built-in planter box w x d (height 1.6) with shrubs. Returns the box.
function Kit.planter(parent: Instance, cf: CFrame, at: CFrame, w: number?, d: number?, seed: number?): Part
	local s = seed or 0
	local W, D = w or 6, d or 2.4
	local c = Kit.pick({ C.stoneDeep, C.oakDark, C.concrete }, s)
	local box = Kit.part(parent, cf, "PlanterBox", V3(W, 1.6, D), at * CF(0, 0.8, 0), c, if c == C.oakDark then M.wood else M.stone)
	Kit.part(parent, cf, "Soil", V3(W - 0.4, 0.1, D - 0.4), at * CF(0, 1.65, 0), C.soil, M.grass, DETAIL)
	local n = math.clamp(math.floor(W * D / 7), 1, 6)
	for i = 1, n do
		local x = -W / 2 + (i - 0.5) * W / n
		local dia = Kit.range(s, i, 1.3, math.min(2.2, D + 0.2))
		Kit.ball(parent, cf, "Shrub", dia, at * CF(x, 1.6 + dia * 0.35, Kit.range(s, i + 9, -0.2, 0.2)), if i % 2 == 0 then C.foliage else C.foliageLight, M.leafy, DETAIL)
	end
	return box
end

-- Rug w x d with a border (thickness 0.06, non-colliding). Returns the field.
function Kit.rug(parent: Instance, cf: CFrame, at: CFrame, w: number?, d: number?, seed: number?): Part
	local s = seed or 0
	local W, D = w or 8, d or 6
	local border = Kit.pick({ C.fabricCharcoal, C.oakDark, C.fabricBlue, C.sage }, s)
	local field = Kit.pick({ C.fabricSand, C.carpetWarm, C.sageLight, C.blueSoft }, s + 3)
	Kit.part(parent, cf, "RugBorder", V3(W, 0.04, D), at * CF(0, 0.02, 0), border, M.fabric, DETAIL)
	return Kit.part(parent, cf, "Rug", V3(W - 0.6, 0.05, D - 0.6), at * CF(0, 0.025, 0), field, M.fabric, DETAIL)
end

export type LampOpts = { light: boolean?, mood: string?, drop: number? }
-- Floor lamp (straight or arc by seed), ~6.2 high. opts.light adds a PointLight. Returns the shade.
function Kit.floorLamp(parent: Instance, cf: CFrame, at: CFrame, seed: number?, opts: LampOpts?): Part
	local o: LampOpts = opts or {}
	local s = seed or 0
	local shadeColor = Kit.pick({ C.fabricSand, C.white, C.metal, C.brass }, s)
	local shade: Part
	if Kit.rand(s, 1) &lt; 0.5 then
		Kit.cylinder(parent, cf, "LampBase", "y", 0.12, 1.2, at * CF(0, 0.06, 0), C.metal, M.metal)
		Kit.cylinder(parent, cf, "LampPole", "y", 5.0, 0.14, at * CF(0, 2.62, 0), C.metal, M.metal, DETAIL)
		shade = Kit.cylinder(parent, cf, "LampShade", "y", 1.1, 1.4, at * CF(0, 5.65, 0), shadeColor, if shadeColor == C.fabricSand then M.fabric else M.metal, DETAIL)
	else
		Kit.part(parent, cf, "LampBase", V3(1.0, 0.5, 1.0), at * CF(0, 0.25, 0.6), C.stone, M.marble)
		Kit.cylinder(parent, cf, "LampPole", "y", 6.2, 0.14, at * CF(0, 3.6, 0.6), C.metal, M.metal, DETAIL)
		Kit.part(parent, cf, "LampArm", V3(0.14, 0.14, 2.5), at * CF(0, 6.7, -0.6), C.metal, M.metal, DETAIL)
		shade = Kit.ball(parent, cf, "LampShade", 1.2, at * CF(0, 6.2, -1.7), shadeColor, M.metal, DETAIL)
	end
	if o.light then
		Kit.light(shade, "point", o.mood or "warm", 12, 0.6)
	end
	return shade
end

-- Pendant hanging from a ceiling point `at` (y = ceiling underside). Returns the diffuser part
-- (carries the light unless opts.light == false).
function Kit.pendant(parent: Instance, cf: CFrame, at: CFrame, mood: (string | Color3)?, opts: LampOpts?): Part
	local o: LampOpts = opts or {}
	local drop = o.drop or 3.5
	local glow = if typeof(mood) == "Color3" then mood elseif type(mood) == "string" and (A.mood :: any)[mood] then (A.mood :: any)[mood].color else C.lightWarm
	Kit.cylinder(parent, cf, "PendantCable", "y", drop, 0.06, at * CF(0, -drop / 2, 0), C.metal, M.metal, DETAIL)
	Kit.cylinder(parent, cf, "PendantShade", "y", 0.9, 1.6, at * CF(0, -drop - 0.45, 0), Kit.pick({ C.metal, C.brass, C.white }, math.floor(drop * 10)), M.metal, DETAIL)
	local diffuser = Kit.cylinder(parent, cf, "PendantLight", "y", 0.05, 1.3, at * CF(0, -drop - 0.925, 0), glow, M.neon, DETAIL)
	if o.light ~= false then
		Kit.light(diffuser, "surface", mood or "warm", nil, nil, Enum.NormalId.Bottom)
	end
	return diffuser
end

---------------------------------------------------------------------------------------------
-- Booths, counters, kitchen, racks, workshop
---------------------------------------------------------------------------------------------
-- Closed phone booth 5 x 5 x 9 (centred, door side -Z). Returns the Model (named id).
function Kit.phoneBooth(parent: Instance, cf: CFrame, at: CFrame, id: string, owner: number, seed: number?): Model
	local s = seed or Kit.hash(id)
	local m = Instance.new("Model")
	m.Name = id
	m:SetAttribute("PhoneBooth", true)
	m:SetAttribute("BoothId", id)
	m:SetAttribute("OwnerUserId", owner)
	local shell = Kit.pick({ C.oakLight, C.white, C.sage, C.fabricCharcoal }, s)
	local shellMat = if shell == C.oakLight then M.wood else M.smooth
	Kit.part(m, cf, "BoothFloor", V3(5, 0.15, 5), at * CF(0, 0.075, 0), C.carpet, M.carpet)
	Kit.part(m, cf, "BoothBack", V3(5, 8.7, 0.3), at * CF(0, 4.5, 2.35), shell, shellMat)
	for _, x in { -1, 1 } do
		Kit.part(m, cf, "BoothSide", V3(0.3, 8.7, 4.4), at * CF(x * 2.35, 4.5, -0.05), shell, shellMat)
	end
	Kit.part(m, cf, "BoothRoof", V3(5, 0.3, 5), at * CF(0, 9.0, 0), shell, shellMat)
	Kit.part(m, cf, "BoothHeader", V3(4.4, 0.5, 0.3), at * CF(0, 8.6, -2.35), shell, shellMat)
	Kit.part(m, cf, "BoothSidelight", V3(1.5, 8.2, 0.12), at * CF(-1.45, 4.25, -2.35), C.glass, M.glass, GLASS)
	Kit.part(m, cf, "BoothMullion", V3(0.12, 8.2, 0.2), at * CF(-0.64, 4.25, -2.35), C.metal, M.metal)
	-- Glass door leaf: fixed, walk-through (non-colliding) so players can enter and sit.
	Kit.part(m, cf, "BoothDoor", V3(2.6, 8.2, 0.12), at * CF(0.72, 4.25, -2.35), C.glass, M.glass, { transparency = A.glassTransparencyDoor, castShadow = false, canCollide = false })
	Kit.part(m, cf, "BoothHandle", V3(0.12, 1.8, 0.5), at * CF(-0.4, 4.0, -2.35), C.metalSoft, M.metal, DETAIL)
	Kit.part(m, cf, "BoothSeatBase", V3(3.6, 1.6, 1.4), at * CF(0, 0.95, 1.5), C.fabricCharcoal, M.fabric)
	local seat = Kit.seat(m, cf, "Seat", V3(3.6, 0.4, 1.5), at * CF(0, 1.95, 1.45), Kit.pick({ C.fabric, C.fabricSand, C.fabricBlue }, s + 1), M.fabric)
	seat.CanTouch = true
	Kit.part(m, cf, "BoothShelf", V3(1.4, 0.12, 1.0), at * CF(1.5, 3.2, -0.6), C.oak, M.wood)
	Kit.part(m, cf, "BoothFelt", V3(3.6, 3, 0.08), at * CF(0, 4.8, 2.16), C.fabric, M.fabric, DETAIL)
	local status = Kit.part(m, cf, "BoothStatus", V3(0.6, 0.15, 0.06), at * CF(0, 8.6, -2.53), C.statusGood, M.neon, DETAIL)
	status:SetAttribute("BoothId", id)
	m.Parent = parent
	return m
end

export type CounterOpts = { body: Color3?, top: Color3? }
-- Reception / café counter (free-standing, customers at -Z), length L x depth 2.4, top 3.65.
function Kit.counter(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?, opts: CounterOpts?): Part
	local o: CounterOpts = opts or {}
	local s = seed or 0
	local L = length or 8
	local body = o.body or Kit.pick({ C.oak, C.stone, C.white, C.oakDark }, s)
	local bodyMat = if body == C.stone then M.stone elseif body == C.white then M.smooth else M.wood
	Kit.part(parent, cf, "CounterKick", V3(L - 0.2, 0.3, 1.8), at * CF(0, 0.15, 0.15), C.metal, M.metal)
	Kit.part(parent, cf, "CounterBody", V3(L, 3.2, 2.0), at * CF(0, 1.9, 0.1), body, bodyMat)
	local top = Kit.part(parent, cf, "CounterTop", V3(L + 0.2, 0.15, 2.4), at * CF(0, 3.575, 0), o.top or C.stone, M.marble)
	Kit.part(parent, cf, "CounterBand", V3(L, 0.35, 0.06), at * CF(0, 3.0, -0.93), Kit.pick({ C.brass, C.oakDark, C.metal }, s + 1), M.metal, DETAIL)
	return top
end

-- Reception desk: high transaction ledge at -Z (3.8), lower work desk behind (3.15).
-- Returns (ledge top, front logo panel); give the panel a SurfaceGui (e.g. name it ReceptionSign).
function Kit.receptionDesk(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?): (Part, Part)
	local s = seed or 0
	local L = length or 10
	local body = Kit.pick({ C.oak, C.stone, C.white }, s)
	local bodyMat = if body == C.stone then M.stone elseif body == C.white then M.smooth else M.wood
	Kit.part(parent, cf, "ReceptionKick", V3(L - 0.2, 0.3, 0.7), at * CF(0, 0.15, -0.95), C.metal, M.metal)
	Kit.part(parent, cf, "ReceptionFront", V3(L, 3.35, 0.8), at * CF(0, 1.975, -1.0), body, bodyMat)
	local ledge = Kit.part(parent, cf, "ReceptionLedge", V3(L + 0.3, 0.15, 1.3), at * CF(0, 3.725, -1.05), C.stone, M.marble)
	Kit.part(parent, cf, "ReceptionWorktop", V3(L - 0.4, 0.25, 2.2), at * CF(0, 3.025, 0.7), C.oakLight, M.wood)
	for _, x in { -1, 1 } do
		Kit.part(parent, cf, "ReceptionLeg", V3(0.25, 2.9, 2.0), at * CF(x * (L / 2 - 0.4), 1.45, 0.75), C.metal, M.metal)
	end
	local panel = Kit.part(parent, cf, "ReceptionPanel", V3(L * 0.5, 1.6, 0.08), at * CF(0, 2.1, -1.44), Kit.pick({ C.oakDark, C.brass, C.metal }, s + 2), M.metal)
	return ledge, panel
end

export type KitchenOpts = { fridge: boolean?, coffeeName: string? }
export type Kitchenette = { counter: Part, sink: Part, tap: Part, coffee: Part, fridge: Part? }
-- Kitchenette (wall unit) of length L &gt;= 6: base cabinets, stone counter (3.15), sink + tap,
-- tiled splash, upper cabinets, coffee machine named "PantryCoffee" (opts.coffeeName) and a fridge.
function Kit.kitchenette(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?, opts: KitchenOpts?): Kitchenette
	local o: KitchenOpts = opts or {}
	local s = seed or 0
	local L = math.max(length or 10, 6)
	local withFridge = o.fridge ~= false
	local fw = if withFridge then 2.4 else 0
	local Lb = L - fw
	local cx = -L / 2 + Lb / 2
	local front = Kit.pick({ C.white, C.sage, C.oakLight, C.fabricCharcoal }, s)
	local frontMat = if front == C.oakLight then M.wood else M.smooth
	Kit.part(parent, cf, "BaseCabinets", V3(Lb, 2.75, 2.1), at * CF(cx, 1.625, -1.05), front, frontMat)
	Kit.part(parent, cf, "Kick", V3(Lb, 0.25, 1.9), at * CF(cx, 0.125, -0.95), C.metal, M.metal)
	local counter = Kit.part(parent, cf, "Counter", V3(Lb, 0.15, 2.3), at * CF(cx, 3.075, -1.15), C.stone, M.marble)
	Kit.part(parent, cf, "Splash", V3(Lb, 2.45, 0.08), at * CF(cx, 4.375, -0.04), C.white, M.tile)
	Kit.part(parent, cf, "UpperCabinets", V3(Lb, 2.0, 1.2), at * CF(cx, 6.6, -0.6), front, frontMat)
	for i = 1, math.max(1, math.floor(Lb / 2.5)) do
		Kit.part(parent, cf, "Groove", V3(0.04, 1.8, 0.02), at * CF(-L / 2 + i * Lb / (math.floor(Lb / 2.5) + 1), 6.6, -1.21), C.metal, M.smooth, DETAIL)
	end
	local sx = -L / 2 + math.min(2.2, Lb * 0.3)
	local sink = Kit.part(parent, cf, "Sink", V3(1.6, 0.04, 1.2), at * CF(sx, 3.17, -1.2), C.metalSoft, M.metal, DETAIL)
	local tap = Kit.cylinder(parent, cf, "KitchenTap", "y", 0.9, 0.18, at * CF(sx, 3.6, -0.4), C.metalSoft, M.metal, DETAIL)
	Kit.part(parent, cf, "Spout", V3(0.12, 0.12, 0.6), at * CF(sx, 4.0, -0.65), C.metalSoft, M.metal, DETAIL)
	local coffeeAt = at * CF(-L / 2 + Lb - 1.0, 3.85, -0.8)
	local coffee = Kit.part(parent, cf, o.coffeeName or "PantryCoffee", V3(1.0, 1.4, 1.0), coffeeAt, C.metal, M.metal)
	if not o.coffeeName then
		-- PropFx: steam + brew light while someone brews (players: prompt; NPCs: WorkstationService.perform)
		local light = Kit.part(coffee, cf, "BrewLight", V3(0.3, 0.08, 0.04), coffeeAt * CF(0, 0.45, -0.52), C.metalSoft, M.neon, DETAIL)
		light:SetAttribute("FxGlow", true)
		Kit.cylinder(coffee, cf, "Cup", "y", 0.3, 0.28, coffeeAt * CF(0, -0.55, -0.62), C.white, M.smooth, DETAIL)
		Kit.steamEmitter(coffee, "CoffeeSteam", 4, 0.25)
		Kit.fx(coffee, "steam,blink", { FxColor = C.statusBusy, FxRate = 2, FxSeconds = 5 })
		Kit.action(coffee, "prop", "Coffee machine", nil, { actionText = "Brew", maxDistance = 6 })
	end
	local fridge: Part? = nil
	if withFridge then
		local fx = L / 2 - 1.2
		fridge = Kit.part(parent, cf, "Fridge", V3(2.4, 6.8, 2.2), at * CF(fx, 3.4, -1.1), C.white, M.smooth)
		-- lit interior behind the door (Neon, no light object) and the door leaf as a PropFx hinge
		Kit.part(parent, cf, "FridgeInterior", V3(2.1, 6.2, 0.02), at * CF(fx, 3.4, -2.215), C.lightCool, M.neon, DETAIL)
		local doorAt = at * CF(fx, 3.4, -2.29)
		local leaf = Kit.propModel(parent, cf, "FridgeDoor", doorAt)
		local slab = Kit.part(leaf, cf, "FridgeDoorSlab", V3(2.36, 6.7, 0.12), doorAt, C.white, M.smooth, { canCollide = false, castShadow = false })
		Kit.part(leaf, cf, "FridgeDoorLine", V3(2.3, 0.04, 0.02), doorAt * CF(0, 1.2, -0.07), C.metalSoft, M.smooth, DETAIL)
		Kit.part(leaf, cf, "FridgeHandle", V3(0.1, 2.0, 0.12), doorAt * CF(-0.95, 0.2, -0.12), C.metalSoft, M.metal, DETAIL)
		Kit.fx(leaf, "hinge", { FxAxis = "y", FxTravel = -1.75, FxHinge = V3(1.18, 0, 0), FxSeconds = 4 })
		Kit.action(slab, "prop", "Fridge", nil, { actionText = "Open", maxDistance = 6 })
	end
	return { counter = counter, sink = sink, tap = tap, coffee = coffee, fridge = fridge }
end

export type RackOpts = {
	variant: string?, -- "compute" (default) | "gpu" | "network"
	index: number?, -- RackIndex attribute of the RackBlade
	accent: Color3?, -- gpu blade colour (default ArchPalette.department.compute)
	trayY: number?, -- height above `at` of an overhead cable tray: adds a cable bundle up to it
	name: string?, -- body name (default "ServerRack")
	station: string?, -- WorkstationId whose occupant opens the front door (PropFx FxStation)
}
-- Data-centre rack (free-standing, centred, front -Z): 2 wide x 4 deep x 7.5 high, &lt;= 10 parts.
-- One "RackBlade" part (attribute RackIndex) goes into `blades` (e.g. Office.Blades). Returns (body, blade).
function Kit.serverRack(parent: Instance, cf: CFrame, at: CFrame, seed: number?, blades: Instance?, opts: RackOpts?): (Part, Part)
	local o: RackOpts = opts or {}
	local s = seed or 0
	local variant = o.variant or "compute"
	local body = Kit.part(parent, cf, o.name or "ServerRack", V3(2, 7.5, 3.9), at * CF(0, 3.75, 0.05), C.screen, M.metal)
	body:SetAttribute("RackVariant", variant)
	-- equipment face behind the mesh door: blanking panels, the blade/patch block, cable managers
	Kit.part(parent, cf, "BlankingTop", V3(1.4, 1.1, 0.06), at * CF(0, 6.55, -1.88), C.metal, M.metal, DETAIL)
	Kit.part(parent, cf, "BlankingBottom", V3(1.4, 0.9, 0.06), at * CF(0, 1.05, -1.88), C.metal, M.metal, DETAIL)
	local bladeColor = if variant == "gpu" then (o.accent or A.department.compute) elseif variant == "network" then C.metal else C.metalSoft
	local blade = Kit.part(blades or parent, cf, "RackBlade", V3(1.4, 4.4, 0.08), at * CF(0, 3.8, -1.89), bladeColor, M.metal, DETAIL)
	blade:SetAttribute("RackIndex", o.index or 1)
	blade:SetAttribute("RackVariant", variant)
	if blades then
		-- lit GPU blades (PlotService sets Lit) breathe while the company trains
		Kit.fx(blade, "breathe", { FxGate = "Training" })
	end
	local bgui = Instance.new("SurfaceGui")
	bgui.Name = "Face"
	bgui.Face = Enum.NormalId.Front
	bgui.CanvasSize = Vector2.new(140, 440)
	bgui.LightInfluence = 0.4
	bgui.MaxDistance = 60
	bgui.Parent = blade
	local rows = if variant == "network" then 8 else 11
	for i = 1, rows do
		local f = Instance.new("Frame")
		f.Name = "Unit" .. i
		f.BorderSizePixel = 0
		f.Position = UDim2.fromOffset(8, 8 + (i - 1) * 39)
		f.Size = UDim2.fromOffset(124, if variant == "network" then 18 else 30)
		f.BackgroundColor3 = if variant == "network" then C.white else C.screen
		f.BackgroundTransparency = if variant == "network" then 0.55 else 0.35
		f.Parent = bgui
		if variant == "network" and i % 2 == 1 then
			local fibre = Instance.new("Frame")
			fibre.Name = "Fibre"
			fibre.BorderSizePixel = 0
			fibre.Position = UDim2.fromOffset(4, 20)
			fibre.Size = UDim2.fromOffset(116, 6)
			fibre.BackgroundColor3 = C.statusBusy
			fibre.Parent = f
		end
	end
	for _, x in { -0.86, 0.86 } do
		Kit.part(parent, cf, "CableManager", V3(0.24, 7.0, 0.2), at * CF(x, 3.75, -1.82), C.metal, M.metal, DETAIL)
	end
	-- perforated front door: dark translucent part + stripe gradient + status LED column
	local door = Kit.part(parent, cf, "RackDoor", V3(2, 7.3, 0.08), at * CF(0, 3.75, -2.07), C.metal, M.metal, { detail = true, transparency = 0.35 })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Mesh"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(200, 730)
	gui.LightInfluence = 0.5
	gui.MaxDistance = 70
	gui.Parent = door
	local mesh = Instance.new("Frame")
	mesh.Name = "Perforation"
	mesh.BorderSizePixel = 0
	mesh.Position = UDim2.fromOffset(16, 40)
	mesh.Size = UDim2.fromOffset(168, 650)
	mesh.BackgroundColor3 = C.white
	mesh.BackgroundTransparency = 0.82
	mesh.Parent = gui
	local grad = Instance.new("UIGradient")
	local keys: { ColorSequenceKeypoint } = {}
	for k = 0, 19 do
		table.insert(keys, ColorSequenceKeypoint.new(k / 19, if k % 2 == 0 then C.metalSoft else C.screen))
	end
	grad.Color = ColorSequence.new(keys)
	grad.Rotation = 90
	grad.Parent = mesh
	local leds = { C.statusGood, C.statusGood, C.statusBusy, C.statusGood, C.blueSoft, C.statusGood, C.statusGood, C.statusBusy }
	for i = 1, 8 do
		local led = Instance.new("Frame")
		led.Name = "LED" .. i
		led.BorderSizePixel = 0
		led.Position = UDim2.fromOffset(176, 120 + i * 50)
		led.Size = UDim2.fromOffset(10, 10)
		led.BackgroundColor3 = if Kit.rand(s, i) &lt; 0.15 then C.statusBusy else leds[i]
		led.Parent = gui
	end
	-- PropFx: status LEDs flicker near the camera; the mesh door swings open (hinge on its left edge)
	-- while an engineer works at the linked ServerRack activity
	Kit.fx(door, "hinge,leds", { FxAxis = "y", FxTravel = 1.7, FxHinge = V3(-1, 0, 0), FxStation = o.station })
	-- top cable entry (brush grommet), yellow fibre for network racks, optional bundle to the tray
	Kit.part(parent, cf, "CableEntry", V3(1.0, 0.2, 1.4), at * CF(0, 7.6, 0.8), C.metal, M.rubber, DETAIL)
	if variant == "network" then
		Kit.part(parent, cf, "FibreLoom", V3(0.1, 5.6, 0.1), at * CF(-0.86, 4.1, -1.97), C.statusBusy, M.smooth, DETAIL)
	end
	if o.trayY and o.trayY &gt; 7.8 then
		local h = o.trayY - 7.7
		Kit.cylinder(parent, cf, "CableBundle", "y", h, 0.5, at * CF(0, 7.7 + h / 2, 0.8), if variant == "network" then C.statusBusy else C.metal, M.rubber, DETAIL)
	end
	return body, blade
end

-- Workbench (wall unit) length L x depth 2.6, top 3.2, with pegboard and vise.
function Kit.workbench(parent: Instance, cf: CFrame, at: CFrame, length: number?, seed: number?): Part
	local s = seed or 0
	local L = length or 6
	local top = Kit.part(parent, cf, "BenchTop", V3(L, 0.3, 2.6), at * CF(0, 3.05, -1.3), C.oakLight, M.wood)
	for _, x in { -1, 1 } do
		Kit.part(parent, cf, "BenchFrame", V3(0.3, 2.9, 2.3), at * CF(x * (L / 2 - 0.3), 1.45, -1.3), C.metalSoft, M.metal)
	end
	Kit.part(parent, cf, "BenchShelf", V3(L - 0.6, 0.12, 2.2), at * CF(0, 0.8, -1.3), C.metalSoft, M.metal)
	Kit.part(parent, cf, "Pegboard", V3(L, 3.0, 0.1), at * CF(0, 4.8, -0.05), C.oakLight, M.wood)
	Kit.part(parent, cf, "Vise", V3(0.6, 0.5, 0.6), at * CF(L / 2 - 0.6, 3.45, -2.3), C.metal, M.metal, DETAIL)
	for i = 1, 3 do
		Kit.part(parent, cf, "Tool", V3(0.14, Kit.range(s, i, 0.8, 1.3), 0.08), at * CF(-L / 2 + i * L / 4, 4.8, -0.14), Kit.pick({ C.metal, C.terracotta, C.oakDark }, s + i), M.metal, DETAIL)
	end
	return top
end

---------------------------------------------------------------------------------------------
-- Animated props (PropFx). Every builder tags its root; parts that move never collide.
---------------------------------------------------------------------------------------------
export type PropOpts = { propId: string?, prompt: string?, station: string?, meeting: string? }

-- Vending machine (wall unit, 3 wide x 2.6 deep x 6.6 high). Selection light + display while dispensing.
function Kit.vending(parent: Instance, cf: CFrame, at: CFrame, seed: number?, opts: PropOpts?): Model
	local o: PropOpts = opts or {}
	local s = seed or 0
	local m = Kit.propModel(parent, cf, "VendingMachine", at)
	local body = Kit.part(m, cf, "VendingBody", V3(3, 6.6, 2.6), at * CF(0, 3.3, -1.3), Kit.pick({ C.fabricCharcoal, C.terracotta, C.blue }, s), M.smooth)
	Kit.part(m, cf, "VendingGlass", V3(1.9, 4.4, 0.06), at * CF(-0.4, 4.0, -2.63), C.glass, M.glass, { detail = true, transparency = 0.35 })
	local rows = Kit.part(m, cf, "ProductRows", V3(1.8, 4.2, 0.04), at * CF(-0.4, 4.0, -2.58), C.white, M.smooth, DETAIL)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Products"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(180, 420)
	gui.LightInfluence = 0.5
	gui.MaxDistance = 60
	gui.Parent = rows
	local palette = { C.terracotta, C.sage, C.blueSoft, C.brass, C.statusGood, C.white }
	for r = 0, 4 do
		for c = 0, 3 do
			local f = Instance.new("Frame")
			f.Name = "Item"
			f.BorderSizePixel = 0
			f.Position = UDim2.fromOffset(12 + c * 42, 14 + r * 80)
			f.Size = UDim2.fromOffset(30, 56)
			f.BackgroundColor3 = palette[(r * 4 + c + norm(s)) % #palette + 1]
			f.Parent = gui
		end
	end
	local panel = Kit.part(m, cf, "VendingPanel", V3(0.6, 4.4, 0.06), at * CF(1.05, 4.0, -2.63), C.blueSoft, M.neon, DETAIL)
	panel:SetAttribute("FxGlow", true)
	Kit.text(panel, "SNACKS\n&amp;\nDRINKS", { color = C.white, light = 0, maxDistance = 50, name = "Label" })
	Kit.part(m, cf, "VendingFlap", V3(1.9, 0.7, 0.06), at * CF(-0.4, 1.2, -2.63), C.metal, M.metal, DETAIL)
	Kit.fx(m, "blink,screen", { FxColor = C.statusGood, FxRate = 4, FxText = "ENJOY!", FxSeconds = 4, PropId = o.propId })
	Kit.action(body, "prop", o.prompt or "Vending machine", o.propId, { actionText = "Dispense", maxDistance = 7 })
	return m
end

-- Water cooler (free-standing, centred on `at`): the stream runs while someone drinks.
function Kit.waterCooler(parent: Instance, cf: CFrame, at: CFrame, opts: PropOpts?): Model
	local o: PropOpts = opts or {}
	local m = Kit.propModel(parent, cf, "WaterCooler", at)
	local base = Kit.part(m, cf, "CoolerBase", V3(1.3, 3.4, 1.3), at * CF(0, 1.7, 0), C.white, M.smooth)
	Kit.cylinder(m, cf, "CoolerBottle", "y", 1.4, 1.0, at * CF(0, 4.1, 0), C.water, M.glass, { detail = true, transparency = 0.35 })
	Kit.part(m, cf, "CoolerTap", V3(0.35, 0.25, 0.2), at * CF(0, 2.9, -0.72), C.metalSoft, M.metal, DETAIL)
	local stream = Kit.part(m, cf, "CoolerStream", V3(0.1, 0.6, 0.1), at * CF(0, 2.5, -0.74), C.water, M.glass, { detail = true, transparency = 1 })
	stream:SetAttribute("FxShow", 0.35)
	Kit.part(m, cf, "CoolerTray", V3(0.8, 0.08, 0.4), at * CF(0, 2.12, -0.78), C.metal, M.metal, DETAIL)
	Kit.fx(m, "flow", { FxSeconds = 3, PropId = o.propId })
	Kit.action(base, "prop", o.prompt or "Water cooler", o.propId, { actionText = "Drink", maxDistance = 6 })
	return m
end

-- Desktop 3D printer standing on a bench top (`at` = top surface centre, front -Z): the print head
-- sweeps back and forth and the nozzle glows while it prints.
function Kit.printer3d(parent: Instance, cf: CFrame, at: CFrame, seed: number?, opts: PropOpts?): Model
	local o: PropOpts = opts or {}
	local s = seed or 0
	local m = Kit.propModel(parent, cf, "Printer3D", at)
	local base = Kit.part(m, cf, "PrinterBase", V3(2.0, 0.3, 2.0), at * CF(0, 0.15, 0), C.screen, M.metal, { canCollide = false })
	for _, x in { -0.9, 0.9 } do
		Kit.part(m, cf, "PrinterUpright", V3(0.15, 2.3, 0.15), at * CF(x, 1.45, 0.85), C.metal, M.metal, DETAIL)
	end
	Kit.part(m, cf, "PrinterBeam", V3(2.0, 0.15, 0.15), at * CF(0, 2.55, 0.85), C.metal, M.metal, DETAIL)
	Kit.part(m, cf, "PrinterBed", V3(1.6, 0.08, 1.6), at * CF(0, 0.34, 0), C.metalSoft, M.metal, DETAIL)
	Kit.cylinder(m, cf, "PrintedPart", "y", 0.5, 0.6, at * CF(0.1, 0.63, 0), Kit.pick({ C.terracotta, C.sage, C.blueSoft }, s), M.smooth, DETAIL)
	local head = Kit.part(m, cf, "PrintHead", V3(0.35, 0.35, 0.35), at * CF(-0.5, 1.25, 0), C.white, M.smooth, DETAIL)
	head:SetAttribute("FxMove", true)
	local nozzle = Kit.part(m, cf, "PrintNozzle", V3(0.12, 0.14, 0.12), at * CF(-0.5, 1.0, 0), C.metalSoft, M.neon, DETAIL)
	nozzle:SetAttribute("FxMove", true)
	nozzle:SetAttribute("FxGlow", true)
	Kit.fx(m, "slider,blink", { FxAxis = "x", FxTravel = 1.0, FxRate = 0.5, FxColor = C.statusBusy, FxSeconds = 8, PropId = o.propId, FxStation = o.station })
	if o.prompt then
		Kit.action(base, "prop", o.prompt, o.propId, { actionText = "Print", maxDistance = 7 })
	end
	return m
end

-- Large-format plotter (free-standing, length L along local X, front -Z): carriage sweeps, sheets feed out.
function Kit.plotter(parent: Instance, cf: CFrame, at: CFrame, length: number?, opts: PropOpts?): Model
	local o: PropOpts = opts or {}
	local L = length or 5
	local m = Kit.propModel(parent, cf, "Plotter", at)
	for _, sx in { -1, 1 } do
		Kit.part(m, cf, "PlotterLeg", V3(0.25, 3.0, 1.6), at * CF(sx * (L / 2 - 0.3), 1.5, 0), C.metal, M.metal)
	end
	local body = Kit.part(m, cf, "PlotterBody", V3(L, 0.9, 1.4), at * CF(0, 3.45, 0), C.screen, M.smooth)
	body:SetAttribute("FxOut", true)
	Kit.cylinder(m, cf, "PlotterRoll", "x", L - 0.8, 0.5, at * CF(0, 2.65, 0.35), C.white, M.smooth, DETAIL)
	Kit.part(m, cf, "PlotterSheet", V3(L - 1, 0.02, 1.0), at * CF(0, 2.95, -0.95) * ANG(math.rad(-35), 0, 0), C.white, M.smooth, DETAIL)
	local carriage = Kit.part(m, cf, "PlotterCarriage", V3(0.6, 0.4, 0.5), at * CF(-L / 2 + 0.8, 4.1, -0.2), C.metalSoft, M.metal, DETAIL)
	carriage:SetAttribute("FxMove", true)
	Kit.fx(m, "slider,paper", { FxAxis = "x", FxTravel = L - 1.6, FxRate = 0.25, FxSeconds = 8, PropId = o.propId })
	Kit.action(body, "prop", o.prompt or "Plotter", o.propId, { actionText = "Plot", maxDistance = 7 })
	return m
end

-- Aquarium on a cabinet (free-standing, centred, long axis local X): fish circle, bubbles rise (always on).
function Kit.aquarium(parent: Instance, cf: CFrame, at: CFrame, seed: number?): Model
	local s = seed or 0
	local m = Kit.propModel(parent, cf, "Aquarium", at)
	Kit.part(m, cf, "AquariumCabinet", V3(4.4, 2.6, 1.8), at * CF(0, 1.3, 0), C.oakDark, M.wood)
	Kit.part(m, cf, "AquariumTank", V3(4.2, 2.6, 1.6), at * CF(0, 3.9, 0), C.glass, M.glass, { transparency = 0.6, castShadow = false })
	local water = Kit.part(m, cf, "AquariumWater", V3(4.0, 2.2, 1.4), at * CF(0, 3.8, 0), C.water, M.glass, { detail = true, transparency = 0.55 })
	Kit.steamEmitter(water, "Bubbles", 3, 0.15)
	for k, x in { -0.6, 0.6 } do
		local fish = Kit.part(m, cf, "Fish", V3(0.5, 0.28, 0.14), at * CF(x, 3.6 + k * 0.5, 0) * ANG(0, PI / 2, 0), Kit.pick({ C.terracotta, C.statusBusy, C.blueSoft }, s + k), M.smooth, DETAIL)
		fish:SetAttribute("FxMove", true)
	end
	Kit.part(m, cf, "AquariumLid", V3(4.3, 0.15, 1.7), at * CF(0, 5.27, 0), C.metal, M.metal, DETAIL)
	Kit.fx(m, "spin,steam", { FxAxis = "y", FxRate = 0.7, FxIdle = "on" })
	return m
end

-- Ceiling fan hanging from `at` (mount point on the soffit/pergola): turns during working hours.
function Kit.ceilingFan(parent: Instance, cf: CFrame, at: CFrame, dia: number?): Model
	local D = dia or 5
	local m = Kit.propModel(parent, cf, "CeilingFan", at)
	Kit.part(m, cf, "FanRod", V3(0.15, 1.2, 0.15), at * CF(0, -0.6, 0), C.metal, M.metal, DETAIL)
	local hub = Kit.cylinder(m, cf, "FanHub", "y", 0.35, 0.8, at * CF(0, -1.3, 0), C.metal, M.metal, DETAIL)
	hub:SetAttribute("FxMove", true)
	for k = 0, 2 do
		local blade = Kit.part(m, cf, "FanBlade", V3(D / 2 - 0.3, 0.06, 0.6), at * CF(0, -1.3, 0) * ANG(0, k * 2 * PI / 3, 0) * CF(D / 4 + 0.15, 0, 0), C.oak, M.wood, DETAIL)
		blade:SetAttribute("FxMove", true)
	end
	Kit.fx(m, "spin", { FxAxis = "y", FxRate = 4, FxGate = "Hour", FxIdle = "slow" })
	return m
end

-- LED news ticker band (wall/bracket item, front -Z of `at`): the client scrolls the text.
function Kit.ticker(parent: Instance, cf: CFrame, at: CFrame, w: number, text: string): Part
	local band = Kit.part(parent, cf, "NewsTicker", V3(w, 0.9, 0.12), at * CF(0, 0, -0.06), C.screen, M.smooth, DETAIL)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Ticker"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.MaxDistance = 90
	gui.ClipsDescendants = true
	gui.Parent = band
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(4, 0, 1, 0)
	label.Text = text
	label.TextColor3 = C.statusBusy
	label.Font = Enum.Font.BuilderSansBold
	label.TextSize = 26
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = gui
	Kit.fx(band, "ticker", { FxRate = 60, FxIdle = "on" })
	return band
end

-- Conference speakerphone puck (on a table top `at`): the ring glows while the room's meeting runs.
function Kit.speakerphone(parent: Instance, cf: CFrame, at: CFrame, meeting: string): Part
	local puck = Kit.cylinder(parent, cf, "Speakerphone", "y", 0.25, 1.4, at * CF(0, 0.125, 0), C.screen, M.smooth, DETAIL)
	local ring = Kit.cylinder(puck, cf, "SpeakerRing", "y", 0.04, 1.1, at * CF(0, 0.27, 0), C.metalSoft, M.neon, DETAIL)
	ring:SetAttribute("FxGlow", true)
	Kit.fx(puck, "blink", { FxColor = C.statusGood, FxRate = 0, FxGate = "Meeting", FxMeeting = meeting })
	return puck
end

-- Small office printer (on a counter/credenza top `at`, front -Z): pages come out, the light blinks.
function Kit.deskPrinter(parent: Instance, cf: CFrame, at: CFrame, opts: PropOpts?): Part
	local o: PropOpts = opts or {}
	local body = Kit.part(parent, cf, "DeskPrinter", V3(1.6, 0.8, 1.3), at * CF(0, 0.4, 0), C.white, M.smooth, DETAIL)
	Kit.part(body, cf, "PrinterTray", V3(1.1, 0.04, 0.5), at * CF(0, 0.3, -0.85), C.metalSoft, M.smooth, DETAIL)
	local led = Kit.part(body, cf, "PrinterLed", V3(0.14, 0.06, 0.04), at * CF(0.55, 0.62, -0.66), C.metalSoft, M.neon, DETAIL)
	led:SetAttribute("FxGlow", true)
	Kit.fx(body, "paper,blink", { FxColor = C.statusGood, FxRate = 3, FxSeconds = 5, PropId = o.propId })
	if o.prompt then
		Kit.action(body, "prop", o.prompt, o.propId, { actionText = "Print", maxDistance = 6 })
	end
	return body
end

---------------------------------------------------------------------------------------------
-- Workstations
---------------------------------------------------------------------------------------------
local JOURNEY: { [string]: number } = { data = 1, compute = 2, design = 3, training = 4, evaluation = 5, deployment = 6, growth = 7 }

local DEPT_VARIANTS: { [string]: { string } } = {
	data = { "bench", "bench", "ldesk", "standing" },
	engineering = { "dual", "dual", "bench", "standing" },
	design = { "ldesk", "bench", "standing", "ldesk" },
	training = { "trading", "dual", "trading", "dual" },
	research = { "lab", "ldesk", "lab", "dual" },
	evaluation = { "lab", "dual", "bench", "lab" },
	growth = { "standing", "bench", "ldesk", "bench" },
	deployment = { "bench", "standing", "dual", "bench" },
	operations = { "ldesk", "bench", "ldesk", "standing" },
	compute = { "dual", "trading", "dual", "lab" },
	executive = { "ldesk", "ldesk", "ldesk", "ldesk" },
}
local KIND_VARIANT: { [string]: string } = {
	control = "trading", platform = "trading", lab = "lab", hwlab = "lab", datalab = "lab", secret_lab = "lab",
	prototype = "lab", founder_office = "ldesk", founder_assist = "ldesk", hr = "ldesk", focus = "ldesk",
}

-- Variant name for a desk: room kind first (control rooms -&gt; trading, labs -&gt; lab), then department+style.
function Kit.deskVariant(department: string, roomKind: string?, style: number?): string
	if roomKind and KIND_VARIANT[roomKind] then
		return KIND_VARIANT[roomKind]
	end
	local list = DEPT_VARIANTS[department] or DEPT_VARIANTS.data
	return list[(math.floor(style or 1) - 1) % #list + 1]
end

type StationGeo = { chairZ: number, monitorZ: number, ip: Vector3, extras: { Vector3 } }
local STATION: { [string]: StationGeo } = {
	bench = { chairZ = -2.9, monitorZ = 0.85, ip = V3(2.5, 2.8, -3.2), extras = { V3(-2.8, 0, -0.6), V3(2.9, 0, 0.7) } },
	ldesk = { chairZ = -2.9, monitorZ = 0.85, ip = V3(-2.5, 2.8, -3.2), extras = { V3(-2.8, 0, -0.5), V3(2.7, 0, -3.3) } },
	standing = { chairZ = -2.6, monitorZ = 0.75, ip = V3(2.3, 2.8, -2.8), extras = { V3(-2.2, 0, -0.5), V3(2.2, 0, 0.6) } },
	dual = { chairZ = -3.0, monitorZ = 0.95, ip = V3(2.6, 2.8, -3.3), extras = { V3(-3.2, 0, -0.7), V3(3.3, 0, 0.9) } },
	trading = { chairZ = -2.9, monitorZ = 0.55, ip = V3(2.6, 2.8, -3.4), extras = { V3(-1.9, 0, -0.9), V3(1.9, 0, -1.0) } },
	lab = { chairZ = -2.8, monitorZ = 0.85, ip = V3(2.5, 2.8, -3.1), extras = { V3(-2.6, 0, -0.3), V3(2.4, 5.96, 1.35) } },
}

local function monitor(parent: Instance, cf: CFrame, at: CFrame, name: string, kind: string, accent: Color3, w: number, h: number, topY: number): Part
	local screen = Kit.screen(parent, cf, name, V3(w, h, 0.15), at * CF(0, topY + 0.4 + h / 2, 0), kind, accent)
	Kit.part(parent, cf, "MonitorStand", V3(0.3, 0.55, 0.45), at * CF(0, topY + 0.275, 0.25), C.metal, M.metal, DETAIL)
	return screen
end

-- One small desk accessory at desk-local point p (p.Y = 0 means "on the desk top").
local function extra(parent: Instance, cf: CFrame, at: CFrame, kind: string, p: Vector3, topY: number, seed: number, accent: Color3)
	local y = if p.Y &gt; 0 then p.Y else topY
	local base = at * CF(p.X, y, p.Z)
	if kind == "mug" then
		Kit.cylinder(parent, cf, "Mug", "y", 0.5, 0.42, base * CF(0, 0.25, 0), Kit.pick({ C.white, C.terracotta, C.sage, accent }, seed), M.smooth, DETAIL)
	elseif kind == "plant" then
		Kit.cylinder(parent, cf, "DeskPot", "y", 0.5, 0.55, base * CF(0, 0.25, 0), Kit.pick({ C.white, C.terracotta, C.stoneDeep }, seed), M.smooth, DETAIL)
		Kit.ball(parent, cf, "DeskPlant", 0.9, base * CF(0, 0.85, 0), C.foliageLight, M.grass, DETAIL)
	elseif kind == "notebook" then
		Kit.part(parent, cf, "Notebook", V3(1.2, 0.08, 1.6), base * CF(0, 0.04, 0) * ANG(0, Kit.range(seed, 1, -0.4, 0.4), 0), Kit.pick({ C.oakDark, C.blue, C.fabricSand }, seed), M.smooth, DETAIL)
	elseif kind == "lamp" then
		Kit.cylinder(parent, cf, "LampFoot", "y", 0.1, 0.6, base * CF(0, 0.05, 0), C.metal, M.metal, DETAIL)
		Kit.part(parent, cf, "LampArm", V3(0.1, 1.6, 0.1), base * CF(0, 0.85, 0.15) * ANG(math.rad(-15), 0, 0), C.metal, M.metal, DETAIL)
		local head = Kit.part(parent, cf, "LampHead", V3(0.45, 0.22, 0.75), base * CF(0, 1.62, -0.15), C.metal, M.metal, DETAIL)
		-- PropFx: the desk lamp lights up while somebody works at this desk (FxStation = the station)
		local id = parent:GetAttribute("WorkstationId")
		if typeof(id) == "string" then
			Kit.fx(head, "blink", { FxColor = C.lightWarm, FxRate = 0, FxStation = id })
		end
	elseif kind == "papers" then
		Kit.part(parent, cf, "Papers", V3(1.1, 0.12, 1.5), base * CF(0, 0.06, 0) * ANG(0, Kit.range(seed, 2, -0.3, 0.3), 0), C.white, M.smooth, DETAIL)
	elseif kind == "frame" then
		Kit.part(parent, cf, "PhotoFrame", V3(0.7, 0.55, 0.08), base * CF(0, 0.27, 0) * ANG(math.rad(-12), 0.4, 0), C.oakDark, M.wood, DETAIL)
	elseif kind == "laptop" then
		Kit.part(parent, cf, "LaptopBase", V3(2.2, 0.1, 1.5), base * CF(0, 0.05, 0), C.metalSoft, M.metal, DETAIL)
		Kit.part(parent, cf, "LaptopLid", V3(2.2, 1.4, 0.08), base * CF(0, 0.75, 0.74) * ANG(math.rad(10), 0, 0), C.metalSoft, M.metal, DETAIL)
	elseif kind == "flasks" then
		Kit.cylinder(parent, cf, "Flask", "y", 0.8, 0.45, base * CF(-0.3, 0.4, 0), C.glass, M.glass, { detail = true, transparency = 0.4 })
		Kit.cylinder(parent, cf, "Flask", "y", 0.6, 0.35, base * CF(0.35, 0.3, 0), C.glassDeep, M.glass, { detail = true, transparency = 0.4 })
	elseif kind == "instrument" then
		Kit.part(parent, cf, "Instrument", V3(1.4, 0.9, 1.1), base * CF(0, 0.45, 0), C.white, M.smooth, DETAIL)
		Kit.part(parent, cf, "InstrumentPanel", V3(0.9, 0.4, 0.04), base * CF(0, 0.5, -0.57), C.screen, M.smooth, DETAIL)
	end
end

local EXTRA_KINDS = { "mug", "plant", "notebook", "lamp", "papers", "frame", "laptop", "mug" }

-- Workstation (contract SPEC §5). Desk at `at` (user side -Z), chair at -Z facing +Z (towards the desk).
-- style: variant name ("bench"|"ldesk"|"standing"|"dual"|"trading"|"lab") or a number (picked by department).
function Kit.station(parent: Instance, cf: CFrame, id: string, department: string, role: string?, at: CFrame, level: number, style: (number | string)?, owner: number, accent: Color3, app: string?, section: string?, roomAccess: string?, homeRoom: string?): Model
	local variant = if type(style) == "string" then style else Kit.deskVariant(department, nil, if type(style) == "number" then style else 1)
	if not STATION[variant] then
		variant = "bench"
	end
	local g = STATION[variant]
	local seed = Kit.hash(id)
	local station = Instance.new("Model")
	station.Name = id
	station.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	station:SetAttribute("WorkstationId", id)
	station:SetAttribute("WorkstationType", "Computer")
	station:SetAttribute("WorkstationStyle", variant)
	station:SetAttribute("Department", department)
	station:SetAttribute("Role", "any")
	station:SetAttribute("PreferredRole", if role and role ~= "" then role else "any")
	station:SetAttribute("Capacity", 1)
	station:SetAttribute("Floor", level)
	station:SetAttribute("RoomAccess", roomAccess or "staff")
	if homeRoom then
		station:SetAttribute("HomeRoom", homeRoom)
	end
	station:SetAttribute("OwnerUserId", owner)
	local tint = (A.department :: any)[department] :: Color3?
	local top, topY = Kit.desk(station, cf, at, variant, seed, tint)
	station.PrimaryPart = top
	-- chair (or stool at the standing desk), facing the desk
	local chairAt = at * CF(0, 0, g.chairZ) * ANG(0, PI, 0)
	local seat: Seat
	if variant == "standing" then
		seat = Kit.stool(station, cf, chairAt, seed, 3.2, { name = "ChairSeat", canTouch = false })
	else
		seat = Kit.officeChair(station, cf, chairAt, seed, { lite = true, arms = variant == "ldesk" or variant == "trading", name = "ChairSeat", canTouch = false })
	end
	Kit.action(seat, "sit", "Chair", nil, { maxDistance = 4, actionText = "Sit" })
	station:SetAttribute("SeatPosition", seat.CFrame)
	station:SetAttribute("InteractionPosition", (cf * at * CF(g.ip)).Position)
	-- screens
	local screen: Part
	if variant == "dual" then
		screen = monitor(station, cf, at * CF(-1.8, 0, g.monitorZ) * ANG(0, -0.3, 0), "DisplayContent", department, accent, 3.4, 2.0, topY)
		monitor(station, cf, at * CF(1.8, 0, g.monitorZ) * ANG(0, 0.3, 0), "SecondaryDisplay", "secondary", accent, 3.4, 2.0, topY):SetAttribute("WorkstationId", id)
	elseif variant == "trading" then
		screen = monitor(station, cf, at * CF(0, 0, g.monitorZ), "DisplayContent", department, accent, 3.2, 1.9, topY)
		local phi = 0.42
		for _, sgn in { -1, 1 } do
			local wing = at * CF(sgn * (2.5 + 1.8 * math.cos(phi)), 0, -1.8 * math.sin(phi)) * ANG(0, sgn * phi, 0) * CF(0, 0, 0.75)
			monitor(station, cf, wing, "SecondaryDisplay", "secondary", accent, 3.0, 1.8, topY):SetAttribute("WorkstationId", id)
		end
	else
		screen = monitor(station, cf, at * CF(0, 0, g.monitorZ), "DisplayContent", department, accent, 3.4, 2.0, topY)
	end
	screen:SetAttribute("WorkstationId", id)
	screen:SetAttribute("JourneyStep", JOURNEY[department])
	if app then
		Kit.prompt(screen, "Workstation · " .. department, owner, app, section)
	end
	-- keyboard + mouse
	local kz = if variant == "trading" then -0.9 else -0.8
	Kit.part(station, cf, "Keyboard", V3(2.6, 0.1, 0.8), at * CF(0, topY + 0.05, kz), C.metal, M.smooth, DETAIL)
	Kit.part(station, cf, "Mouse", V3(0.35, 0.1, 0.6), at * CF(1.9, topY + 0.05, kz), C.white, M.smooth, DETAIL)
	-- deterministic accessories
	if variant == "lab" then
		extra(station, cf, at, "instrument", g.extras[1], topY, seed, accent)
		extra(station, cf, at, "flasks", g.extras[2], topY, seed, accent)
	else
		extra(station, cf, at, Kit.pick(EXTRA_KINDS, seed), g.extras[1], topY, seed, accent)
		if Kit.rand(seed, 9) &lt; 0.55 then
			extra(station, cf, at, Kit.pick({ "mug", "notebook", "papers", "plant" }, seed // 7), g.extras[2], topY, seed + 1, accent)
		end
	end
	Collection:AddTag(station, "Workstation")
	station.Parent = parent
	return station
end

export type ActivityExtra = {
	roomAccess: string?,
	homeRoom: string?,
	facing: Vector3?, -- building-local point the NPC looks at (stored as world FacingPosition)
	meetingRoom: string?,
	conversationGroup: string?,
	capacity: number?,
	attributes: { [string]: any }?,
}
-- Invisible interaction point (Whiteboard, Pipeline, LabBench, ServerRack, Meeting, Conversation,
-- Coffee, Snack, Fridge, Dining, Lounge, Service...). `at` = standing point (building-local).
function Kit.activity(parent: Instance, cf: CFrame, id: string, kind: string, department: string, role: string, at: CFrame, level: number, owner: number, seat: Seat?, extraAttrs: ActivityExtra?): Model
	local x: ActivityExtra = extraAttrs or {}
	local m = Instance.new("Model")
	m.Name = id
	m:SetAttribute("WorkstationId", id)
	m:SetAttribute("WorkstationType", kind)
	m:SetAttribute("Department", department)
	m:SetAttribute("Role", role)
	m:SetAttribute("Capacity", x.capacity or 1)
	m:SetAttribute("Floor", level)
	m:SetAttribute("OwnerUserId", owner)
	m:SetAttribute("RoomAccess", x.roomAccess or "staff")
	if x.homeRoom then
		m:SetAttribute("HomeRoom", x.homeRoom)
	end
	if x.meetingRoom then
		m:SetAttribute("MeetingRoom", x.meetingRoom)
	end
	if x.conversationGroup then
		m:SetAttribute("ConversationGroup", x.conversationGroup)
	end
	if x.facing then
		m:SetAttribute("FacingPosition", cf:PointToWorldSpace(x.facing))
	end
	if x.attributes then
		for k, v in x.attributes do
			m:SetAttribute(k, v)
		end
	end
	local anchor = Kit.part(m, cf, "InteractionPoint", V3(0.2, 0.2, 0.2), at, C.white, nil, { detail = true, transparency = 1 })
	m.PrimaryPart = anchor
	m:SetAttribute("InteractionPosition", anchor.Position)
	if seat then
		seat.Parent = m
		m:SetAttribute("SeatPosition", seat.CFrame)
	end
	m.Parent = parent
	Collection:AddTag(m, "Workstation")
	return m
end

-- Navigation node at (x, y + 2.8, z) building-local (OfficeKit contract).
function Kit.node(parent: Instance, cf: CFrame, id: string, x: number, y: number, z: number, kind: string, floor: number): Part
	local p = Kit.part(parent, cf, id, V3(0.2, 0.2, 0.2), CF(x, y + 2.8, z), C.white, nil, { detail = true, transparency = 1 })
	p:SetAttribute("NavigationNode", kind)
	p:SetAttribute("Floor", floor)
	Collection:AddTag(p, "NavigationNode")
	return p
end

---------------------------------------------------------------------------------------------
-- Doors (SPEC §3)
---------------------------------------------------------------------------------------------
-- Door-local frame D: origin = opening centre on the wall line at floor level, +X along the wall,
-- +Z = def.inward (the protected side), -Z = outside. Width w along X, height h.
type Ctx = {
	model: Model,
	frame: Model,
	base: CFrame,
	def: DoorDef,
	x: any, -- def with optional extra fields
	kind: string,
	owner: number,
	w: number,
	h: number,
	t: number, -- wall thickness
	s: number, -- swing sign: +1 opens towards +Z (inward), -1 outward
	hx: number, -- hinge side of single leaves: -1 = local -X jamb, +1 = local +X jamb
	latch: number, -- jamb side that carries readers / anchors
	jw: number, -- jamb width (0 = no jambs)
	jd: number, -- jamb depth
	fz: number, -- frame centre z
	cw: number, -- clear width between jambs
	ch: number, -- clear height under the head
	sweep: number, -- sensor half-depth
	along: number, -- +1 when local +X runs along +a (building X for axis "x", Z for axis "z")
}

-- Default wall thickness per kind when def.thickness is absent (Kit.wall always passes the real one).
local DOOR_T: { [string]: number } = { glass = 0.4, glassdouble = 0.4, autoslide = 0.4, cubicle = 0.15, gate = 0.5, speedgate = 0.3 }
local DOOR_H: { [string]: number } = { autoslide = 10, glassdouble = 10, cubicle = 7.2, fridge = 6.4, gate = 4.5, speedgate = 3.4 }
local DOOR_TEXT: { [string]: string } = {
	glass = "Glass door", glassdouble = "Glass doors", solid = "Door", secure = "Secure door", service = "Service door",
	flush = "Panel", bookcase = "Book", vault = "Vault door", autoslide = "Entrance", cubicle = "Cubicle",
	fridge = "Fridge", gate = "Gate", speedgate = "Speed gate",
}
local READER_OUT: { [string]: boolean } = { glass = true, glassdouble = true, solid = true, secure = true, service = true, autoslide = true, vault = true, gate = true }
local READER_IN: { [string]: boolean } = { secure = true, service = true, vault = true, autoslide = true }
local PRIVATE_ROOMS = { "WC", "RESTROOM", "SHOWER", "BATH", "SAUNA" }

local function dp(ctx: Ctx, parent: Instance, name: string, size: Vector3, lcf: CFrame, color: Color3, mat: Enum.Material?, opts: Opts?): Part
	return Kit.part(parent, ctx.base, name, size, lcf, color, mat, opts)
end

local function frameStd(ctx: Ctx, jw: number, hh: number, color: Color3, mat: Enum.Material, threshold: boolean)
	ctx.jw = jw
	ctx.cw = ctx.w - 2 * jw
	ctx.ch = ctx.h - hh
	dp(ctx, ctx.frame, "JambL", V3(jw, ctx.h, ctx.jd), CF(-(ctx.w - jw) / 2, ctx.h / 2, ctx.fz), color, mat)
	dp(ctx, ctx.frame, "JambR", V3(jw, ctx.h, ctx.jd), CF((ctx.w - jw) / 2, ctx.h / 2, ctx.fz), color, mat)
	dp(ctx, ctx.frame, "Head", V3(ctx.cw, hh, ctx.jd), CF(0, ctx.h - hh / 2, ctx.fz), color, mat)
	if threshold then
		dp(ctx, ctx.frame, "Threshold", V3(ctx.cw, 0.05, ctx.jd - 0.04), CF(0, 0.025, ctx.fz), C.metalSoft, M.metal, DETAIL)
	end
end

local function newLeaf(ctx: Ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.model
	return m
end

local function markSlab(ctx: Ctx, part: BasePart)
	local mod = Instance.new("PathfindingModifier")
	mod.PassThrough = true
	mod.Label = ctx.def.access
	mod.Parent = part
end

-- Swing leaf: hinge axis at local (hx * cw/2, 0, hingeZ); opens by `angle` towards s*Z.
local function swingPivot(ctx: Ctx, leaf: Model, hx: number, hingeZ: number, angle: number)
	local closed = ctx.base * CF(hx * ctx.cw / 2, 0, hingeZ)
	leaf.WorldPivot = closed
	leaf:SetAttribute("ClosedPivot", closed)
	leaf:SetAttribute("OpenPivot", closed * ANG(0, ctx.s * hx * angle, 0))
	leaf:SetAttribute("Motion", "swing")
end

local function slidePivot(ctx: Ctx, leaf: Model, lcf: CFrame, offset: Vector3)
	local closed = ctx.base * lcf
	leaf.WorldPivot = closed
	leaf:SetAttribute("ClosedPivot", closed)
	leaf:SetAttribute("OpenPivot", closed * CF(offset))
	leaf:SetAttribute("Motion", "slide")
end

-- Part of a swing leaf; u = distance from the hinge jamb face along the leaf, v = offset from the leaf plane zc.
local function lp(ctx: Ctx, leaf: Model, hx: number, zc: number, name: string, size: Vector3, u: number, y: number, v: number, color: Color3, mat: Enum.Material?, opts: Opts?): Part
	return dp(ctx, leaf, name, size, CF(hx * (ctx.cw / 2 - u), y, zc + v), color, mat, opts)
end

local function hinges(ctx: Ctx, leaf: Model, hx: number, hingeZ: number, ys: { number }, d: number, len: number)
	for _, y in ys do
		Kit.cylinder(leaf, ctx.base, "Hinge", "y", len, d, CF(hx * ctx.cw / 2, y, hingeZ), C.metalSoft, M.metal, DETAIL)
	end
end

-- Frameless glass leaf with patch rails and a through pull handle.
local function glassLeaf(ctx: Ctx, name: string, hx: number, lw: number): Model
	local leaf = newLeaf(ctx, name)
	local rd = 0.22
	local zc = ctx.s * (ctx.t / 2 - rd / 2)
	local g = 0.04
	local lh = ctx.ch - 0.1
	local uc = g + lw / 2
	lp(ctx, leaf, hx, zc, "BottomRail", V3(lw, 0.42, rd), uc, 0.06 + 0.21, 0, C.metal, M.metal)
	local gh = lh - 0.44
	local glass = lp(ctx, leaf, hx, zc, "Slab", V3(lw - 0.02, gh, 0.12), uc, 0.48 + gh / 2, 0, C.glass, M.glass, GLASS_DOOR)
	markSlab(ctx, glass)
	lp(ctx, leaf, hx, zc, "Pull", V3(0.12, 2.8, 0.62), g + lw - 0.4, 4.0, 0, C.metalSoft, M.metal, DETAIL)
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, PI / 2)
	ctx.sweep = math.max(ctx.sweep, lw + 0.5)
	return leaf
end

-- Timber leaf with optional vision panel (slab split around the glass), kick plate, levers, hinges.
local function timberLeaf(ctx: Ctx, name: string, hx: number, lw: number, lt: number, color: Color3, mat: Enum.Material, vision: boolean): Model
	local leaf = newLeaf(ctx, name)
	local zc = ctx.s * (ctx.t / 2 - lt / 2)
	local g, y0 = 0.04, 0.06
	local lh = ctx.ch - 0.1
	local slab: Part
	if vision and lw &gt; 2.4 and not Kit.LEAN then
		-- full-height glazed vision strip towards the latch side
		local p1 = g + lw - 1.25
		local p2 = p1 + 0.45
		slab = lp(ctx, leaf, hx, zc, "Slab", V3(p1 - g, lh, lt), (g + p1) / 2, y0 + lh / 2, 0, color, mat)
		lp(ctx, leaf, hx, zc, "SlabLatch", V3(g + lw - p2, lh, lt), (p2 + g + lw) / 2, y0 + lh / 2, 0, color, mat)
		lp(ctx, leaf, hx, zc, "VisionPanel", V3(0.45, lh, 0.06), (p1 + p2) / 2, y0 + lh / 2, 0, C.glass, M.glass, GLASS_DOOR)
	else
		slab = lp(ctx, leaf, hx, zc, "Slab", V3(lw, lh, lt), g + lw / 2, y0 + lh / 2, 0, color, mat)
	end
	markSlab(ctx, slab)
	if not Kit.LEAN then
		lp(ctx, leaf, hx, zc, "KickPlate", V3(lw - 0.3, 0.7, lt + 0.04), g + lw / 2, y0 + 0.35, 0, C.metalSoft, M.metal, DETAIL)
		hinges(ctx, leaf, hx, ctx.s * ctx.t / 2, { 1.2, ctx.ch - 1.4 }, 0.13, 0.5)
	end
	-- one through part reads as a lever on each face
	lp(ctx, leaf, hx, zc, "Lever", V3(0.65, 0.1, lt + 0.24), g + lw - 0.55, 3.4, 0, C.metalSoft, M.metal, DETAIL)
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, PI / 2)
	ctx.sweep = math.max(ctx.sweep, lw + 0.5)
	return leaf
end

-- Painted metal leaf: push bar on the push side, lever on the pull side, kick plate, three hinges.
local function serviceLeaf(ctx: Ctx, name: string, hx: number, lw: number): Model
	local leaf = newLeaf(ctx, name)
	local lt = 0.2
	local zc = ctx.s * (ctx.t / 2 - lt / 2)
	local g, y0 = 0.04, 0.06
	local lh = ctx.ch - 0.1
	local slab = lp(ctx, leaf, hx, zc, "Slab", V3(lw, lh, lt), g + lw / 2, y0 + lh / 2, 0, C.metalSoft, M.metal)
	markSlab(ctx, slab)
	if not Kit.LEAN then
		lp(ctx, leaf, hx, zc, "KickPlate", V3(lw - 0.2, 0.8, lt + 0.04), g + lw / 2, y0 + 0.4, 0, C.metal, M.metal, DETAIL)
	end
	lp(ctx, leaf, hx, zc, "PushBar", V3(math.max(lw - 0.8, 0.6), 0.22, 0.25), g + lw / 2 + 0.2, 3.5, -ctx.s * (lt / 2 + 0.125), C.metal, M.metal, DETAIL)
	lp(ctx, leaf, hx, zc, "Lever", V3(0.65, 0.1, 0.12), g + lw - 0.55, 3.4, ctx.s * (lt / 2 + 0.06), C.metal, M.metal, DETAIL)
	if not Kit.LEAN then
		lp(ctx, leaf, hx, zc, "VentGrille", V3(math.min(1.6, lw - 0.6), 0.8, lt + 0.02), g + lw / 2, 1.6, 0, C.metal, M.metal, DETAIL)
		hinges(ctx, leaf, hx, ctx.s * ctx.t / 2, { 1.2, ctx.ch - 1.4 }, 0.14, 0.5)
	end
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, PI / 2)
	ctx.sweep = math.max(ctx.sweep, lw + 0.5)
	return leaf
end

local function gateLeaf(ctx: Ctx, name: string, hx: number, lw: number): Model
	local leaf = newLeaf(ctx, name)
	local lt = 0.15
	local zc = ctx.s * (ctx.t / 2 - lt / 2)
	local g = 0.04
	local lh = ctx.ch - 0.3
	local slab = lp(ctx, leaf, hx, zc, "Slab", V3(lw, 0.2, lt), g + lw / 2, 0.35, 0, C.metal, M.metal)
	markSlab(ctx, slab)
	lp(ctx, leaf, hx, zc, "TopRail", V3(lw, 0.2, lt), g + lw / 2, 0.25 + lh - 0.1, 0, C.metal, M.metal)
	lp(ctx, leaf, hx, zc, "HingeStile", V3(0.15, lh - 0.4, lt), g + 0.075, 0.25 + lh / 2, 0, C.metal, M.metal)
	lp(ctx, leaf, hx, zc, "LatchStile", V3(0.15, lh - 0.4, lt), g + lw - 0.075, 0.25 + lh / 2, 0, C.metal, M.metal)
	local slats = math.max(1, math.floor((lh - 0.6) / 0.6))
	for i = 1, slats do
		local y = 0.45 + (i - 0.5) * (lh - 0.4) / slats
		dp(ctx, leaf, "Louvre", V3(lw - 0.3, 0.4, 0.05), CF(hx * (ctx.cw / 2 - g - lw / 2), y, zc) * ANG(math.rad(35), 0, 0), C.metalSoft, M.metal, DETAIL)
	end
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, PI / 2)
	ctx.sweep = math.max(ctx.sweep, lw + 0.5)
	return leaf
end

type Builder = (Ctx) -&gt; (BasePart?, BasePart?)
local BUILD: { [string]: Builder } = {}

local function isDouble(ctx: Ctx): boolean
	return ctx.cw &gt; 6.5
end

BUILD.glass = function(ctx: Ctx)
	ctx.jd = ctx.t
	frameStd(ctx, 0.25, 0.3, C.metal, M.metal, false)
	if isDouble(ctx) then
		glassLeaf(ctx, "Leaf1", -1, ctx.cw / 2 - 0.06)
		glassLeaf(ctx, "Leaf2", 1, ctx.cw / 2 - 0.06)
		ctx.latch = 1
	else
		glassLeaf(ctx, "Leaf1", ctx.hx, ctx.cw - 0.08)
	end
	return nil, nil
end

BUILD.glassdouble = function(ctx: Ctx)
	ctx.jd = ctx.t
	frameStd(ctx, 0.25, 0.3, C.metal, M.metal, false)
	glassLeaf(ctx, "Leaf1", -1, ctx.cw / 2 - 0.06)
	glassLeaf(ctx, "Leaf2", 1, ctx.cw / 2 - 0.06)
	ctx.latch = 1
	return nil, nil
end

local function timberDoor(ctx: Ctx, color: Color3, lt: number, vision: boolean)
	if isDouble(ctx) then
		timberLeaf(ctx, "Leaf1", -1, ctx.cw / 2 - 0.06, lt, color, M.wood, vision)
		timberLeaf(ctx, "Leaf2", 1, ctx.cw / 2 - 0.06, lt, color, M.wood, vision)
		ctx.latch = 1
	else
		timberLeaf(ctx, "Leaf1", ctx.hx, ctx.cw - 0.08, lt, color, M.wood, vision)
	end
end

BUILD.solid = function(ctx: Ctx)
	ctx.jd = ctx.t
	frameStd(ctx, 0.3, 0.35, C.white, M.smooth, false)
	local vision = if ctx.x.vision ~= nil then ctx.x.vision == true else true
	if ctx.x.vision == nil then
		local room = string.upper(ctx.def.room)
		for _, key in PRIVATE_ROOMS do
			if string.find(room, key, 1, true) then
				vision = false
			end
		end
	end
	timberDoor(ctx, C.oak, 0.2, vision)
	return nil, nil
end

BUILD.secure = function(ctx: Ctx)
	ctx.jd = ctx.t
	frameStd(ctx, 0.35, 0.4, C.metal, M.metal, true)
	timberDoor(ctx, C.oakDark, 0.25, ctx.x.vision ~= false)
	return nil, nil
end

BUILD.service = function(ctx: Ctx)
	ctx.jd = ctx.t
	frameStd(ctx, 0.3, 0.35, C.metal, M.metal, true)
	if isDouble(ctx) then
		serviceLeaf(ctx, "Leaf1", -1, ctx.cw / 2 - 0.06)
		serviceLeaf(ctx, "Leaf2", 1, ctx.cw / 2 - 0.06)
		ctx.latch = 1
	else
		serviceLeaf(ctx, "Leaf1", ctx.hx, ctx.cw - 0.08)
	end
	return nil, nil
end

-- Flush door: a timber panel as thick as the wall, battens on the Kit.PANEL_PITCH grid, no frame.
BUILD.flush = function(ctx: Ctx)
	ctx.jw, ctx.jd, ctx.cw, ctx.ch = 0, ctx.t, ctx.w, ctx.h
	dp(ctx, ctx.frame, "Stop", V3(ctx.w, 0.05, ctx.t * 0.5), CF(0, ctx.h - 0.025, 0), C.oakDark, M.wood, DETAIL)
	local leaf = newLeaf(ctx, "Leaf1")
	local hx = ctx.hx
	local g = 0.05
	local lw = ctx.w - 0.1
	local lh = ctx.h - 0.1
	local slab = lp(ctx, leaf, hx, 0, "Slab", V3(lw, lh, ctx.t), g + lw / 2, 0.02 + lh / 2, 0, C.oakLight, M.wood)
	markSlab(ctx, slab)
	local da = if ctx.def.axis == "x" then ctx.def.x else ctx.def.z
	local P = Kit.PANEL_PITCH
	local top = math.min(Kit.CEILING, ctx.h - 0.1)
	for k = math.ceil((da - ctx.w / 2 + 0.3) / P), math.floor((da + ctx.w / 2 - 0.3) / P) do
		local xl = ctx.along * (k * P - da)
		for _, side in { -1, 1 } do
			dp(ctx, leaf, "Batten", V3(0.2, top - 0.45, 0.06), CF(xl, 0.45 + (top - 0.45) / 2, side * (ctx.t / 2 + 0.03)), C.oakDark, M.wood, DETAIL)
		end
	end
	for _, side in { -1, 1 } do
		lp(ctx, leaf, hx, 0, "Skirting", V3(lw, 0.45, 0.06), g + lw / 2, 0.225, side * (ctx.t / 2 + 0.03), C.oakDark, M.wood, DETAIL)
	end
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, PI / 2)
	ctx.sweep = lw + 0.5
	local outP = dp(ctx, ctx.model, "PromptOut", V3(0.3, 0.3, 0.3), CF(ctx.latch * (ctx.w / 2 - 0.6), 3.6, -(ctx.t / 2 + 0.3)), C.white, nil, { detail = true, transparency = 1 })
	local inP = dp(ctx, ctx.model, "PromptIn", V3(0.35, 0.6, 0.05), CF(ctx.latch * (ctx.w / 2 + 0.4), 3.6, ctx.t / 2 + 0.085), C.metalSoft, M.metal, DETAIL)
	return outP, inP
end

-- Bookcase: shelving unit filling the opening. The books face the OUTSIDE (-Z, the unprotected room
-- such as the archive) so it reads as ordinary shelving; its back panel faces the protected side.
-- Slides by its own width along the wall (default towards local +X; def.slide = -1 reverses).
BUILD.bookcase = function(ctx: Ctx)
	ctx.jw, ctx.cw, ctx.ch = 0, ctx.w, ctx.h
	ctx.jd = ctx.t
	local w, h = ctx.w, ctx.h
	dp(ctx, ctx.frame, "Cornice", V3(w, 0.4, ctx.t), CF(0, h - 0.2, 0), C.oakDark, M.wood)
	local leaf = newLeaf(ctx, "Leaf1")
	local depth = 1.4
	local front = -(ctx.t / 2 - 0.02) -- book face, outside
	local zc = front + depth / 2
	local hb = h - 0.45
	local wood = C.oakDark
	local back = dp(ctx, leaf, "Slab", V3(w - 0.3, hb, 0.1), CF(0, 0.03 + hb / 2, front + depth - 0.05), wood, M.wood)
	markSlab(ctx, back)
	for _, x in { -1, 1 } do
		dp(ctx, leaf, "Side", V3(0.15, hb, depth), CF(x * (w / 2 - 0.075), 0.03 + hb / 2, zc), wood, M.wood)
	end
	dp(ctx, leaf, "Top", V3(w - 0.3, 0.15, depth), CF(0, 0.03 + hb - 0.075, zc), wood, M.wood)
	dp(ctx, leaf, "Plinth", V3(w - 0.3, 0.4, depth), CF(0, 0.23, zc), wood, M.wood)
	local rows = 5
	local y1, y2 = 0.43, 0.03 + hb - 0.15
	local rowH = (y2 - y1 - (rows - 1) * 0.1) / rows
	local seed = Kit.hash(ctx.def.id)
	-- unrotated shelf frame at the back panel: spines face -Z (outside)
	local shelfAt = CF(0, 0, front + depth - 0.1)
	local specialY = 0
	for r = 1, rows do
		local y = y1 + (r - 1) * (rowH + 0.1)
		if r &gt; 1 then
			dp(ctx, leaf, "Shelf", V3(w - 0.3, 0.1, depth - 0.15), CF(0, y - 0.05, zc + 0.05), wood, M.wood)
		end
		if r == 3 then
			specialY = y
			bookRow(leaf, ctx.base, shelfAt, -w / 2 + 0.15, w / 2 - 1.2, y, rowH, -0.1, seed + r * 31, 9)
		else
			bookRow(leaf, ctx.base, shelfAt, -w / 2 + 0.15, w / 2 - 0.15, y, rowH, -0.1, seed + r * 31, 11)
		end
	end
	-- the tell: a red leather spine pulled out a little in the free slot of the middle shelf
	local sx = w / 2 - 0.7
	dp(ctx, leaf, "SpecialBook", V3(0.4, rowH - 0.2, 0.95), CF(sx, specialY + (rowH - 0.2) / 2, front + 0.45), C.terracotta, M.leather, DETAIL)
	local dir = if ctx.x.slide == -1 then -1 else 1
	slidePivot(ctx, leaf, CF(0, 0, zc), V3(dir * w, 0, 0))
	ctx.sweep = 2
	local outP = dp(ctx, ctx.model, "PromptOut", V3(0.3, 0.3, 0.3), CF(sx, specialY + 0.6, front - 0.3), C.white, nil, { detail = true, transparency = 1 })
	local inP = dp(ctx, ctx.model, "PromptIn", V3(0.3, 0.3, 0.3), CF(-sx, 3.6, front + depth + 0.3), C.white, nil, { detail = true, transparency = 1 })
	return outP, inP
end

-- Vault: thick steel leaf with spoked locking wheel, heavy hinges, swings 100 degrees.
BUILD.vault = function(ctx: Ctx)
	local lt = math.min(1.0, ctx.t)
	local zc = ctx.s * (ctx.t / 2 - lt / 2)
	ctx.jd = ctx.t
	frameStd(ctx, 0.55, 0.6, C.metal, M.metal, true)
	local leaf = newLeaf(ctx, "Leaf1")
	local hx = ctx.hx
	local g = 0.04
	local lw = ctx.cw - 0.08
	local lh = ctx.ch - 0.1
	local uc = g + lw / 2
	local slab = lp(ctx, leaf, hx, zc, "Slab", V3(lw, lh, lt), uc, 0.06 + lh / 2, 0, C.metalSoft, M.metal)
	markSlab(ctx, slab)
	local out = -ctx.s
	lp(ctx, leaf, hx, zc, "FacePlate", V3(lw - 0.9, lh - 1.2, 0.08), uc, 0.06 + lh / 2, out * (lt / 2 + 0.04), C.metal, M.metal, DETAIL)
	local wy = 0.06 + lh / 2
	local wheelZ = zc + out * (lt / 2 + 0.08 + 0.2)
	local wx = hx * (ctx.cw / 2 - uc)
	Kit.cylinder(leaf, ctx.base, "WheelHub", "z", 0.4, 0.7, CF(wx, wy, wheelZ), C.stoneDeep, M.metal, DETAIL)
	for k = 0, 2 do
		dp(ctx, leaf, "WheelSpoke", V3(2.8, 0.18, 0.18), CF(wx, wy, wheelZ) * ANG(0, 0, k * PI / 3), C.stoneDeep, M.metal, DETAIL)
	end
	lp(ctx, leaf, hx, zc, "ReleaseBar", V3(0.15, 1.6, 0.25), g + lw - 0.6, 4.0, ctx.s * (lt / 2 + 0.125), C.metal, M.metal, DETAIL)
	hinges(ctx, leaf, hx, ctx.s * ctx.t / 2, { 1.8, ctx.ch - 2.0 }, 0.5, 1.6)
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, math.rad(100))
	ctx.sweep = lw + 1
	return nil, nil
end

-- Automatic sliding door: two glass leaves sliding into side pockets, operator header.
BUILD.autoslide = function(ctx: Ctx)
	local w, h = ctx.w, ctx.h
	ctx.jw, ctx.jd = 0.3, ctx.t
	ctx.cw, ctx.ch = w - 0.6, h - 0.9
	dp(ctx, ctx.frame, "JambL", V3(0.3, h, ctx.jd), CF(-(w - 0.3) / 2, h / 2, 0), C.metal, M.metal)
	dp(ctx, ctx.frame, "JambR", V3(0.3, h, ctx.jd), CF((w - 0.3) / 2, h / 2, 0), C.metal, M.metal)
	dp(ctx, ctx.frame, "Operator", V3(ctx.cw, 0.9, ctx.t), CF(0, h - 0.45, 0), C.metal, M.metal)
	dp(ctx, ctx.frame, "FloorTrack", V3(ctx.cw, 0.04, math.min(0.4, ctx.t)), CF(0, 0.02, 0), C.metalSoft, M.metal, DETAIL)
	local lw = ctx.cw / 2 - 0.02
	local lh = ctx.ch - 0.1
	for i, hx in { -1, 1 } do
		local leaf = newLeaf(ctx, "Leaf" .. i)
		local cx = hx * (ctx.cw / 2 - lw / 2)
		local inner = cx - hx * (lw / 2 - 0.075) -- meeting stile at the door centre
		local outer = cx + hx * (lw / 2 - 0.06)
		local glass = dp(ctx, leaf, "Slab", V3(lw - 0.27, lh - 0.6, 0.1), CF(cx - hx * 0.015, 0.31 + (lh - 0.6) / 2, 0), C.glass, M.glass, GLASS_DOOR)
		markSlab(ctx, glass)
		dp(ctx, leaf, "TopRail", V3(lw, 0.35, 0.2), CF(cx, 0.06 + lh - 0.175, 0), C.metal, M.metal)
		dp(ctx, leaf, "BottomRail", V3(lw, 0.25, 0.2), CF(cx, 0.185, 0), C.metal, M.metal)
		dp(ctx, leaf, "MeetStile", V3(0.15, lh - 0.6, 0.2), CF(inner, 0.31 + (lh - 0.6) / 2, 0), C.metal, M.metal, DETAIL)
		dp(ctx, leaf, "EdgeStile", V3(0.12, lh - 0.6, 0.2), CF(outer, 0.31 + (lh - 0.6) / 2, 0), C.metal, M.metal, DETAIL)
		slidePivot(ctx, leaf, CF(cx, 0, 0), V3(hx * (lw + 0.1), 0, 0))
	end
	ctx.latch = 1
	ctx.sweep = 4
	return nil, nil
end

-- WC cubicle door (light laminate, raised off the floor, headrail; no reader).
BUILD.cubicle = function(ctx: Ctx)
	ctx.jw, ctx.cw, ctx.ch = 0, ctx.w, ctx.h
	ctx.jd = 0.3
	dp(ctx, ctx.frame, "Headrail", V3(ctx.w, 0.12, 0.3), CF(0, ctx.h - 0.06, 0), C.metalSoft, M.metal)
	local leaf = newLeaf(ctx, "Leaf1")
	local hx = ctx.hx
	local lt = 0.12
	local zc = ctx.s * (ctx.t / 2 - lt / 2)
	local lw = ctx.w - 0.1
	local lh = ctx.h - 0.7
	local color = Kit.pick({ C.sageLight, C.white, C.oakLight, C.blueSoft }, Kit.hash(ctx.def.room))
	local slab = lp(ctx, leaf, hx, zc, "Slab", V3(lw, lh, lt), 0.05 + lw / 2, 0.55 + lh / 2, 0, color, if color == C.oakLight then M.wood else M.smooth)
	markSlab(ctx, slab)
	lp(ctx, leaf, hx, zc, "Indicator", V3(0.3, 0.15, 0.05), 0.05 + lw - 0.35, 3.6, -ctx.s * (lt / 2 + 0.025), C.metal, M.metal, DETAIL)
	lp(ctx, leaf, hx, zc, "Knob", V3(0.12, 0.12, lt + 0.3), 0.05 + lw - 0.35, 3.3, 0, C.metalSoft, M.metal, DETAIL)
	hinges(ctx, leaf, hx, ctx.s * ctx.t / 2, { 1.4, ctx.h - 1.2 }, 0.1, 0.4)
	swingPivot(ctx, leaf, hx, ctx.s * ctx.t / 2, PI / 2)
	ctx.sweep = lw + 0.5
	return nil, nil
end

-- Fridge appliance: carcass behind the front plane (towards +Z = inward), door swings out (-Z).
BUILD.fridge = function(ctx: Ctx)
	local w, h = ctx.w, ctx.h
	local depth = if type(ctx.x.depth) == "number" then ctx.x.depth else 2.4
	ctx.jw, ctx.cw, ctx.ch, ctx.jd = 0, w, h, depth
	ctx.s = -1
	local body = C.white
	dp(ctx, ctx.frame, "SideL", V3(0.12, h, depth), CF(-(w / 2 - 0.06), h / 2, depth / 2), body, M.smooth)
	dp(ctx, ctx.frame, "SideR", V3(0.12, h, depth), CF(w / 2 - 0.06, h / 2, depth / 2), body, M.smooth)
	dp(ctx, ctx.frame, "Top", V3(w - 0.24, 0.12, depth), CF(0, h - 0.06, depth / 2), body, M.smooth)
	dp(ctx, ctx.frame, "Bottom", V3(w - 0.24, 0.4, depth), CF(0, 0.2, depth / 2), body, M.smooth)
	dp(ctx, ctx.frame, "Back", V3(w - 0.24, h - 0.52, 0.12), CF(0, 0.4 + (h - 0.52) / 2, depth - 0.06), body, M.smooth)
	for _, y in { h * 0.38, h * 0.62 } do
		dp(ctx, ctx.frame, "FridgeShelf", V3(w - 0.24, 0.05, depth - 0.3), CF(0, y, depth / 2 + 0.1), C.glass, M.glass, { detail = true, transparency = 0.4 })
	end
	local seed = Kit.hash(ctx.def.id)
	for i = 1, 3 do
		local bx = Kit.range(seed, i, -w / 2 + 0.4, w / 2 - 0.4)
		Kit.cylinder(ctx.frame, ctx.base, "Bottle", "y", 0.9, 0.3, CF(bx, h * 0.38 + 0.47, depth * 0.55), Kit.pick({ C.sage, C.glassDeep, C.terracotta, C.white }, seed + i), M.smooth, DETAIL)
	end
	local leaf = newLeaf(ctx, "Leaf1")
	local hx = ctx.hx
	local lt = 0.25
	local slab = lp(ctx, leaf, hx, -lt / 2, "Slab", V3(w, h, lt), w / 2, h / 2, 0, body, M.smooth)
	markSlab(ctx, slab)
	lp(ctx, leaf, hx, -lt / 2, "Handle", V3(0.12, 2.2, 0.15), w - 0.25, h * 0.55, -(lt / 2 + 0.075), C.metalSoft, M.metal, DETAIL)
	lp(ctx, leaf, hx, -lt / 2, "FreezerLine", V3(w, 0.04, 0.02), w / 2, h * 0.68, -(lt / 2 + 0.01), C.metalSoft, M.smooth, DETAIL)
	swingPivot(ctx, leaf, hx, -lt, math.rad(100))
	ctx.sweep = w + 0.5
	local outP = dp(ctx, ctx.model, "PromptOut", V3(0.3, 0.3, 0.3), CF(-hx * (w / 2 - 0.25), h * 0.55, -(lt + 0.5)), C.white, nil, { detail = true, transparency = 1 })
	local inP = dp(ctx, ctx.model, "PromptIn", V3(0.3, 0.3, 0.3), CF(0, h * 0.5, depth / 2), C.white, nil, { detail = true, transparency = 1 })
	return outP, inP
end

-- Fence gate (louvred, swings inward) or, with def.variant == "barrier", a lifting barrier arm.
BUILD.gate = function(ctx: Ctx)
	if ctx.x.variant == "barrier" then
		local w = ctx.w
		local hxp = -(w / 2 - 0.45)
		ctx.h = 3.4
		ctx.jw, ctx.jd, ctx.cw, ctx.ch = 0.9, 0.9, w, ctx.h
		ctx.latch = -1
		dp(ctx, ctx.frame, "BarrierHousing", V3(0.9, 3.4, 0.9), CF(hxp, 1.7, 0), C.metal, M.metal)
		dp(ctx, ctx.frame, "BarrierRest", V3(0.3, 2.8, 0.3), CF(w / 2 - 0.15, 1.4, 0), C.metal, M.metal)
		local leaf = newLeaf(ctx, "Leaf1")
		local len = w - 1.3
		local boom = dp(ctx, leaf, "Slab", V3(len, 0.22, 0.22), CF(hxp + 0.45 + len / 2, 3.0, 0), C.white, M.smooth)
		markSlab(ctx, boom)
		for k = 1, 3 do
			dp(ctx, leaf, "Stripe", V3(0.6, 0.24, 0.24), CF(hxp + 0.45 + k * len / 4, 3.0, 0), C.terracotta, M.smooth, DETAIL)
		end
		local closed = ctx.base * CF(hxp, 3.0, 0)
		leaf.WorldPivot = closed
		leaf:SetAttribute("ClosedPivot", closed)
		leaf:SetAttribute("OpenPivot", closed * ANG(0, 0, math.rad(85)))
		leaf:SetAttribute("Motion", "lift")
		ctx.sweep = 2
		return nil, nil
	end
	ctx.jd = 0.3
	ctx.t = 0.3
	ctx.jw, ctx.cw, ctx.ch = 0.3, ctx.w - 0.6, ctx.h
	dp(ctx, ctx.frame, "JambL", V3(0.3, ctx.h, 0.3), CF(-(ctx.w - 0.3) / 2, ctx.h / 2, 0), C.metal, M.metal)
	dp(ctx, ctx.frame, "JambR", V3(0.3, ctx.h, 0.3), CF((ctx.w - 0.3) / 2, ctx.h / 2, 0), C.metal, M.metal)
	if isDouble(ctx) then
		gateLeaf(ctx, "Leaf1", -1, ctx.cw / 2 - 0.06)
		gateLeaf(ctx, "Leaf2", 1, ctx.cw / 2 - 0.06)
		ctx.latch = 1
	else
		gateLeaf(ctx, "Leaf1", ctx.hx, ctx.cw - 0.08)
	end
	return nil, nil
end

-- Badge speed gate lane: stainless cabinets on both sides, glass flaps swinging to the staff side.
BUILD.speedgate = function(ctx: Ctx)
	local w = ctx.w
	local cabW, cabH, cabD = 1.5, 3.4, 4
	ctx.jw, ctx.cw, ctx.ch, ctx.jd = 0, w, cabH, cabD
	ctx.s = 1
	-- Kit.wall tells each lane which cabinet a neighbouring lane already builds (shared pedestal)
	local widths = { [-1] = tonumber(ctx.x.cabMinus) or cabW, [1] = tonumber(ctx.x.cabPlus) or cabW }
	local skip = { [-1] = ctx.x.skipMinus == true, [1] = ctx.x.skipPlus == true }
	for _, sgn in { -1, 1 } do
		local cw = widths[sgn]
		local x = sgn * (w / 2 + cw / 2)
		if not skip[sgn] then
			dp(ctx, ctx.frame, "GateCabinet", V3(cw, cabH - 0.1, cabD), CF(x, (cabH - 0.1) / 2, 0), C.concrete, M.metal, { reflectance = 0.05 })
			dp(ctx, ctx.frame, "GateCabinetTop", V3(cw, 0.1, cabD), CF(x, cabH - 0.05, 0), C.metal, M.glass)
		end
		dp(ctx, ctx.frame, "LaneLight", V3(0.5, 0.12, 0.04), CF(sgn * (w / 2 + 0.35), cabH - 0.4, -cabD / 2 - 0.02), C.statusGood, M.neon, DETAIL)
	end
	ctx.cw = w - 0.14 -- flap hinges sit just inside the lane so open flaps rest against the cabinets
	local lw = ctx.cw / 2 - 0.04
	for i, hx in { -1, 1 } do
		local leaf = newLeaf(ctx, "Leaf" .. i)
		local flap = lp(ctx, leaf, hx, 0, "Slab", V3(lw, 2.4, 0.1), 0.04 + lw / 2, 2.1, 0, C.glass, M.glass, GLASS_DOOR)
		markSlab(ctx, flap)
		lp(ctx, leaf, hx, 0, "FlapEdge", V3(0.06, 2.4, 0.14), 0.04 + lw - 0.03, 2.1, 0, C.metalSoft, M.metal, DETAIL)
		swingPivot(ctx, leaf, hx, 0, PI / 2)
	end
	ctx.sweep = cabD / 2 + 1
	ctx.cw = w
	local rx = w / 2 + math.min(widths[1], cabW) / 2
	local function pad(name: string, z: number): Part
		local p = dp(ctx, ctx.model, name, V3(0.8, 0.1, 0.6), CF(rx, cabH + 0.05, z), C.metal, M.metal, DETAIL)
		Kit.part(p, p.CFrame, "ReaderLight", V3(0.5, 0.04, 0.1), CF(0, 0.07, if z &gt; 0 then 0.2 else -0.2), C.statusBad, M.neon, DETAIL)
		return p
	end
	return pad("PromptOut", -cabD / 2 + 0.6), pad("PromptIn", cabD / 2 - 0.6)
end

local function reader(ctx: Ctx, side: string): Part
	local sz = if side == "out" then -1 else 1
	local width = math.clamp(ctx.jw - 0.04, 0.18, 0.3)
	local x = ctx.latch * (ctx.w - ctx.jw) / 2
	local lcf = CF(x, math.min(4.3, ctx.h - 0.8), ctx.fz + sz * (ctx.jd / 2 + 0.05)) * (if sz &gt; 0 then ANG(0, PI, 0) else CFrame.identity)
	local r = dp(ctx, ctx.model, if side == "out" then "PromptOut" else "PromptIn", V3(width, 0.62, 0.1), lcf, C.metal, M.metal, DETAIL)
	Kit.part(r, r.CFrame, "ReaderLight", V3(width * 0.6, 0.06, 0.04), CF(0, 0.2, -0.06), C.statusBad, M.neon, DETAIL)
	return r
end

local function anchorPart(ctx: Ctx, side: string): Part
	local sz = if side == "out" then -1 else 1
	local x = ctx.latch * math.max(ctx.cw / 2 - 0.6, 0)
	return dp(ctx, ctx.model, if side == "out" then "PromptOut" else "PromptIn", V3(0.3, 0.3, 0.3), CF(x, 3.6, ctx.fz + sz * (ctx.jd / 2 + 0.35)), C.white, nil, { detail = true, transparency = 1 })
end

local function doorPrompt(ctx: Ctx, part: BasePart, side: string)
	local hidden = ctx.kind == "flush" or ctx.kind == "bookcase"
	Kit.action(part, "door", DOOR_TEXT[ctx.kind] or "Door", ctx.def.id, {
		actionText = "Open",
		maxDistance = if hidden then 6 elseif ctx.kind == "autoslide" or ctx.kind == "speedgate" then 9 else 8,
		ownerUserId = if hidden and side == "out" then ctx.owner else nil,
		attributes = { Side = side },
	})
end

-- Door model per SPEC §3. Returns nil for kind "opening". Optional extra def fields:
-- y (floor height, default Plan.levelY(level)), thickness (wall, default 0.5), hinge ("right" = +X jamb),
-- swing ("in"|"out"), vision (bool), slide (bookcase: 1 = towards local +X, default -1), depth (fridge),
-- variant ("barrier" for gate), holdOpen (seconds).
function Kit.door(parent: Instance, cf: CFrame, def: DoorDef, owner: number): Model?
	local kind = def.kind
	if kind == "opening" then
		return nil
	end
	local build = BUILD[kind]
	if not build then
		kind = "solid"
		build = BUILD.solid
	end
	local x = def :: any
	local inward = def.inward.Unit
	local up = V3(0, 1, 0)
	local right = up:Cross(inward)
	local y0 = if type(x.y) == "number" then x.y else Plan.levelY(def.level)
	local D = CFrame.fromMatrix(V3(def.x, y0, def.z), right, up, inward)
	local alongVec = if def.axis == "x" then V3(1, 0, 0) else V3(0, 0, 1)
	local model = Instance.new("Model")
	model.Name = "Door_" .. def.id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local frame = Instance.new("Model")
	frame.Name = "Frame"
	frame.Parent = model
	local hx = if x.hinge == "right" then 1 else -1
	local h = if def.h and def.h &gt; 0 then def.h else (DOOR_H[kind] or 9)
	if kind == "speedgate" then
		h = DOOR_H.speedgate
	end
	local ctx: Ctx = {
		model = model,
		frame = frame,
		base = cf * D,
		def = def,
		x = x,
		kind = kind,
		owner = owner,
		w = def.w,
		h = h,
		t = if type(x.thickness) == "number" then x.thickness else (DOOR_T[kind] or 1.0),
		s = if x.swing == "out" or (x.swing == nil and def.exterior) then -1 else 1,
		hx = hx,
		latch = -hx,
		jw = 0,
		jd = 0.6,
		fz = 0,
		cw = def.w,
		ch = h,
		sweep = 1,
		along = if right:Dot(alongVec) &gt;= 0 then 1 else -1,
	}
	local outP, inP = build(ctx)
	if not outP then
		local readerOut = READER_OUT[kind] == true and def.access ~= "public" and ctx.jw &gt; 0
		outP = if readerOut then reader(ctx, "out") else anchorPart(ctx, "out")
	end
	if not inP then
		inP = if READER_IN[kind] == true and ctx.jw &gt; 0 then reader(ctx, "in") else anchorPart(ctx, "in")
	end
	doorPrompt(ctx, outP :: BasePart, "out")
	doorPrompt(ctx, inP :: BasePart, "in")
	local depth = ctx.t + 2 * ctx.sweep
	dp(ctx, model, "Sensor", V3(ctx.w, math.max(ctx.h, 6), depth), CF(0, math.max(ctx.h, 6) / 2, ctx.fz), C.white, nil, { detail = true, transparency = 1 })
	model:SetAttribute("DoorId", def.id)
	model:SetAttribute("DoorKind", kind)
	model:SetAttribute("AccessClass", def.access)
	model:SetAttribute("RoomId", def.room)
	model:SetAttribute("DoorOwner", owner)
	model:SetAttribute("SecureNormal", cf:VectorToWorldSpace(inward))
	model:SetAttribute("AutoOpen", kind == "autoslide" or kind == "speedgate")
	model:SetAttribute("HoldOpen", if type(x.holdOpen) == "number" then x.holdOpen else 5)
	model:SetAttribute("Hidden", def.hidden == true or kind == "flush" or kind == "bookcase")
	model:SetAttribute("Exterior", def.exterior == true)
	model:SetAttribute("DoorState", "closed")
	Collection:AddTag(model, "CampusDoor")
	model.Parent = parent
	return model
end

---------------------------------------------------------------------------------------------
-- Walls (BuildingLayout.Wall segments)
---------------------------------------------------------------------------------------------
-- Wall thickness per finish (centred on the wall line).
Kit.WALL_T = { solid = 1.0, panel = 1.0, glass = 0.4, barrier = 0.3, fence = 0.5 } :: { [string]: number }

-- Corner closing: for a level's segments (Layout.walls), returns { [Wall] = {e1, e2} } extensions
-- for Kit.wall opts.extend1/extend2. Where two perpendicular segments END at the same point
-- (an L corner), the axis-"x" segment is extended by half the other wall's thickness so the outer
-- corner is closed. T-junctions and free ends get 0.
function Kit.wallExtents(walls: { Wall }): { [Wall]: { number } }
	local out: { [Wall]: { number } } = {}
	local EPS = 0.01
	for _, w in walls do
		out[w] = { 0, 0 }
	end
	for _, w in walls do
		if w.axis ~= "x" then
			continue
		end
		for k, a in { w.a1, w.a2 } do
			-- corner point (a, w.c) in (x, z)
			for _, o in walls do
				if o.axis == "z" and math.abs(o.c - a) &lt; EPS then
					local endsHere = math.abs(o.a1 - w.c) &lt; EPS or math.abs(o.a2 - w.c) &lt; EPS
					local passes = o.a1 &lt; w.c - EPS and o.a2 &gt; w.c + EPS
					if endsHere and not passes then
						-- is there another x segment continuing on the far side? then it is a T, not an L
						local continued = false
						for _, q in walls do
							if q ~= w and q.axis == "x" and math.abs(q.c - w.c) &lt; EPS and ((k == 1 and math.abs(q.a2 - a) &lt; EPS) or (k == 2 and math.abs(q.a1 - a) &lt; EPS)) then
								continued = true
							end
						end
						if not continued then
							out[w][k] = (Kit.WALL_T[o.finish] or 1.0) / 2
						end
					end
				end
			end
		end
	end
	return out
end

export type WallOpts = {
	skirting: string?, -- "oak" (default) | "stone" | "none"
	bay: number?, -- max glass bay width (default 6)
	extend1: number?, -- extend the segment beyond a1 / a2 (corner closing)
	extend2: number?,
}

-- One wall segment from levelY to levelY + seg.height. Openings stay clear; doors are built into
-- doorsParent (once per door id). Returns the segment Model.
function Kit.wall(parent: Instance, cf: CFrame, seg: Wall, levelY: number, owner: number, doorsParent: Instance?, opts: WallOpts?): Model
	local o: WallOpts = opts or {}
	local model = Instance.new("Model")
	model.Name = string.format("Wall_%s%g_%g", seg.axis, seg.c, seg.a1)
	model:SetAttribute("Finish", seg.finish)
	local finish = seg.finish
	local H = seg.height
	local a1 = seg.a1 - (o.extend1 or 0)
	local a2 = seg.a2 + (o.extend2 or 0)
	local t = Kit.WALL_T[finish] or 1.0

	local function box(name: string, b1: number, b2: number, y1: number, y2: number, n1: number, n2: number, color: Color3, mat: Enum.Material?, popts: Opts?, rot: number?): Part?
		if b2 - b1 &lt; 0.01 or y2 - y1 &lt; 0.01 then
			return nil
		end
		local ca, cy, cn = (b1 + b2) / 2, levelY + (y1 + y2) / 2, seg.c + (n1 + n2) / 2
		local size, pos
		if seg.axis == "x" then
			size, pos = V3(b2 - b1, y2 - y1, n2 - n1), CF(ca, cy, cn)
			if rot then
				pos *= ANG(rot, 0, 0)
			end
		else
			size, pos = V3(n2 - n1, y2 - y1, b2 - b1), CF(cn, cy, ca)
			if rot then
				pos *= ANG(0, 0, rot)
			end
		end
		return Kit.part(model, cf, name, size, pos, color, mat, popts)
	end

	-- runs between openings: { b1, b2, leftKind, rightKind } ("" = segment end)
	type Run = { b1: number, b2: number, left: string, right: string }
	local runs: { Run } = {}
	local cursor, leftKind = a1, ""
	for _, op in seg.openings do
		local kind = if op.door then op.door.kind else "opening"
		if op.a1 &gt; cursor + 0.01 then
			table.insert(runs, { b1 = cursor, b2 = op.a1, left = leftKind, right = kind })
		end
		cursor = math.max(cursor, op.a2)
		leftKind = kind
	end
	if a2 &gt; cursor + 0.01 then
		table.insert(runs, { b1 = cursor, b2 = a2, left = leftKind, right = "" })
	end

	local skirtColor = if o.skirting == "stone" then C.stoneDeep elseif finish == "panel" then C.oakDark else C.oak
	local skirtMat = if o.skirting == "stone" then M.stone else M.wood
	local function skirting(b1: number, b2: number)
		if o.skirting == "none" then
			return
		end
		box("Skirting", b1, b2, 0, 0.45, t / 2, t / 2 + 0.06, skirtColor, skirtMat, DETAIL)
		box("Skirting", b1, b2, 0, 0.45, -t / 2 - 0.06, -t / 2, skirtColor, skirtMat, DETAIL)
	end
	local function battens(b1: number, b2: number, y1: number, y2: number)
		local P = Kit.PANEL_PITCH
		for k = math.ceil((b1 + 0.3) / P), math.floor((b2 - 0.3) / P) do
			local a = k * P
			box("Batten", a - 0.1, a + 0.1, y1, y2, t / 2, t / 2 + 0.06, C.oakDark, M.wood, DETAIL)
			box("Batten", a - 0.1, a + 0.1, y1, y2, -t / 2 - 0.06, -t / 2, C.oakDark, M.wood, DETAIL)
		end
	end
	local function portal(op: Layout.Opening, dh: number, color: Color3, mat: Enum.Material)
		box("Reveal", op.a1, op.a1 + 0.08, 0, dh, -t / 2 - 0.05, t / 2 + 0.05, color, mat)
		box("Reveal", op.a2 - 0.08, op.a2, 0, dh, -t / 2 - 0.05, t / 2 + 0.05, color, mat)
		box("Reveal", op.a1 + 0.08, op.a2 - 0.08, dh - 0.08, dh, -t / 2 - 0.05, t / 2 + 0.05, color, mat)
	end
	local function doorFor(op: Layout.Opening): DoorDef?
		local d = op.door
		if d and d.kind ~= "opening" then
			return d :: DoorDef
		end
		return nil
	end
	local function buildDoor(def: DoorDef)
		local target = doorsParent or parent
		if not target:FindFirstChild("Door_" .. def.id) then
			local d = def :: any
			if d.thickness == nil then
				d = table.clone(d)
				d.thickness = t -- frame depth = the thickness of the wall it sits in
			end
			Kit.door(target, cf, d :: DoorDef, owner)
		end
	end

	if finish == "glass" then
		-- one pane per run (mullions overlap it), sill per run, one metal header from the glazing top
		-- to the wall top (only its lower 0.2 shows under the ceiling), glass transoms over openings
		local gt = math.min(12.8, H - 0.2)
		local bayMax = o.bay or 6
		local function post(kind: string): number
			return if kind == "opening" then 0.2 else 0 -- door jambs frame doors; bare openings get a post
		end
		for _, r in runs do
			local len = r.b2 - r.b1
			if len &lt;= 0.7 then
				box("Post", r.b1, r.b2, 0, gt, -0.2, 0.2, C.metal, M.metal)
				continue
			end
			local p1, p2 = post(r.left), post(r.right)
			if p1 &gt; 0 then
				box("Post", r.b1, r.b1 + p1, 0, gt, -0.2, 0.2, C.metal, M.metal)
			end
			if p2 &gt; 0 then
				box("Post", r.b2 - p2, r.b2, 0, gt, -0.2, 0.2, C.metal, M.metal)
			end
			local g1, g2 = r.b1 + p1, r.b2 - p2
			box("SillRail", g1, g2, 0, 0.35, -0.2, 0.2, C.metal, M.metal)
			box("Glass", g1, g2, 0.35, gt, -0.06, 0.06, C.glass, M.glass, GLASS)
			if not Kit.LEAN then
				local bays = math.max(1, math.ceil((g2 - g1) / bayMax))
				for i = 1, bays - 1 do
					local m = g1 + i * (g2 - g1) / bays
					box("Mullion", m - 0.075, m + 0.075, 0.35, gt, -0.2, 0.2, C.metal, M.metal)
				end
			end
		end
		box("Header", a1, a2, gt, H, -0.2, 0.2, C.metal, M.metal)
		for _, op in seg.openings do
			local def = doorFor(op)
			local dh = if op.door and op.door.h then op.door.h else 9
			if dh + 0.4 &lt; gt then
				box("TransomRail", op.a1, op.a2, dh, dh + 0.2, -0.2, 0.2, C.metal, M.metal)
				box("Transom", op.a1, op.a2, dh + 0.2, gt, -0.06, 0.06, C.glass, M.glass, GLASS)
			end
			if def then
				buildDoor(def)
			end
		end
	elseif finish == "fence" then
		for _, r in runs do
			local posts = math.max(1, math.ceil((r.b2 - r.b1) / 6))
			for i = 0, posts do
				local a = r.b1 + 0.15 + i * (r.b2 - r.b1 - 0.3) / posts
				box("Post", a - 0.15, a + 0.15, 0, H - 0.15, 0.05, 0.25, C.metal, M.metal)
			end
			box("BottomRail", r.b1, r.b2, 0, 0.25, -0.22, 0.02, C.metal, M.metal)
			box("Cap", r.b1, r.b2, H - 0.15, H, -0.25, 0.25, C.metal, M.metal)
			local slats = math.max(1, math.floor((H - 0.55) / 0.55))
			local pitch = (H - 0.55) / slats
			for i = 1, slats do
				local y = 0.3 + (i - 0.5) * pitch
				box("Louvre", r.b1, r.b2, y - 0.225, y + 0.225, -0.13, -0.07, C.metalSoft, M.metal, nil, math.rad(35))
			end
		end
		for _, op in seg.openings do
			local def = doorFor(op)
			if def then
				local g = table.clone(def) :: any
				g.kind = "gate"
				g.h = H
				buildDoor(g :: DoorDef)
			end
		end
	elseif finish == "barrier" then
		-- 3.6-high glass badge line; speed-gate cabinets occupy 1.5 studs beside each lane
		local function trim(kind: string): number
			return if kind == "speedgate" then 1.5 else 0
		end
		local top = H - 0.2
		for _, r in runs do
			local b1, b2 = r.b1 + trim(r.left), r.b2 - trim(r.right)
			if b2 - b1 &lt; 0.05 then
				continue
			end
			if b2 - b1 &lt;= 0.6 then
				box("Post", b1, b2, 0, top, -0.15, 0.15, C.metal, M.metal)
			else
				local bays = math.max(1, math.ceil((b2 - b1 - 0.2) / 4.5))
				local bl = (b2 - b1 - 0.2 * (bays + 1)) / bays
				for i = 0, bays do
					local p = b1 + i * (bl + 0.2)
					box("Post", p, p + 0.2, 0, top, -0.15, 0.15, C.metal, M.metal)
					if i &lt; bays then
						box("BarrierShoe", p + 0.2, p + 0.2 + bl, 0, 0.15, -0.1, 0.1, C.metal, M.metal)
						box("BarrierGlass", p + 0.2, p + 0.2 + bl, 0.15, top, -0.06, 0.06, C.glass, M.glass, GLASS)
					end
				end
			end
			box("TopRail", b1, b2, top, H, -0.15, 0.15, C.oak, M.wood)
		end
		local list = seg.openings
		for i, op in list do
			local def = doorFor(op)
			if def and def.kind == "speedgate" then
				-- neighbouring lanes closer than two cabinets share ONE pedestal (built by the lower-a lane)
				local d = table.clone(def :: any)
				local prv, nxt = list[i - 1], list[i + 1]
				local w1, w2, skip1 = 1.5, 1.5, false
				if prv and prv.door and prv.door.kind == "speedgate" and op.a1 - prv.a2 &lt; 2.99 then
					w1, skip1 = math.max(op.a1 - prv.a2, 0.3), true
				end
				if nxt and nxt.door and nxt.door.kind == "speedgate" and nxt.a1 - op.a2 &lt; 2.99 then
					w2 = math.max(nxt.a1 - op.a2, 0.3)
				end
				local alongVec = if seg.axis == "x" then V3(1, 0, 0) else V3(0, 0, 1)
				local plusIsA2 = V3(0, 1, 0):Cross(def.inward.Unit):Dot(alongVec) &gt;= 0
				d.cabPlus, d.skipPlus = if plusIsA2 then w2 else w1, if plusIsA2 then false else skip1
				d.cabMinus, d.skipMinus = if plusIsA2 then w1 else w2, if plusIsA2 then skip1 else false
				buildDoor(d :: DoorDef)
			elseif def then
				buildDoor(def)
			end
		end
	else
		-- solid (plaster) or panel (timber panelling) walls
		local panel = finish == "panel"
		local core = if panel then C.oakLight else C.interior
		local coreMat = if panel then M.wood else M.plaster
		local battenTop = math.min(Kit.CEILING, H)
		for _, r in runs do
			box("Wall", r.b1, r.b2, 0, H, -t / 2, t / 2, core, coreMat)
			skirting(r.b1, r.b2)
			if panel and not Kit.LEAN then
				battens(r.b1, r.b2, 0.45, battenTop)
			end
		end
		for _, op in seg.openings do
			local def = doorFor(op)
			local dh = if op.door and op.door.h then op.door.h else 9
			if dh &lt; H then
				box("Lintel", op.a1, op.a2, dh, H, -t / 2, t / 2, core, coreMat)
				if panel and dh &lt; battenTop and not Kit.LEAN then
					battens(op.a1, op.a2, dh, battenTop)
				end
			end
			if def then
				buildDoor(def)
			else
				portal(op, math.min(dh, H), if panel then C.oakDark else C.oak, M.wood)
			end
		end
	end
	model.Parent = parent
	return model
end

-- Skirting strip on one face of a wall line: side = +1 on the +c face, -1 on the -c face.
-- thickness = the wall's thickness (default 1.0, solid interior wall).
function Kit.skirting(parent: Instance, cf: CFrame, axis: string, c: number, a1: number, a2: number, side: number, levelY: number, color: Color3?, thickness: number?): Part
	local n = c + side * ((thickness or 1.0) / 2 + 0.03)
	local col = color or C.oak
	if axis == "x" then
		return Kit.part(parent, cf, "Skirting", V3(a2 - a1, 0.45, 0.06), CF((a1 + a2) / 2, levelY + 0.225, n), col, M.wood, DETAIL)
	end
	return Kit.part(parent, cf, "Skirting", V3(0.06, 0.45, a2 - a1), CF(n, levelY + 0.225, (a1 + a2) / 2), col, M.wood, DETAIL)
end

---------------------------------------------------------------------------------------------
-- Floors and ceilings
---------------------------------------------------------------------------------------------
local FINISHES: { [string]: { color: Color3, mat: Enum.Material } } = {
	oak = { color = C.oak, mat = M.planks },
	oakLight = { color = C.oakLight, mat = M.planks },
	oakDark = { color = C.oakDark, mat = M.planks },
	deck = { color = C.oakDark, mat = M.planks },
	carpet = { color = C.carpet, mat = M.carpet },
	carpetWarm = { color = C.carpetWarm, mat = M.carpet },
	carpetBlue = { color = C.fabricBlue, mat = M.carpet },
	stone = { color = C.stone, mat = M.stone },
	tile = { color = C.white, mat = M.tile },
	rubber = { color = C.fabricCharcoal, mat = M.rubber },
	concrete = { color = C.concrete, mat = M.concrete },
	terrazzo = { color = C.plasterShade, mat = M.marble },
	marble = { color = C.stone, mat = M.marble },
	slate = { color = C.metalSoft, mat = M.slate },
}
Kit.FLOOR_FINISHES = FINISHES

export type SurfaceOpts = {
	inset: number?, -- shrink the rect on every side (default 0: finishes run to the wall lines, hidden inside walls)
	maxLights: number?, -- ceiling: max SurfaceLights (default 1; at most one per 400 sq studs; 0 = none)
	height: number?, -- ceiling: underside above levelY (default 13)
	name: string?,
}

-- Floor finish layer 0.1 thick on the slab (top at levelY + 0.1). Returns the part.
function Kit.floor(parent: Instance, cf: CFrame, rect: Rect, levelY: number, finish: string?, opts: SurfaceOpts?): Part?
	local o: SurfaceOpts = opts or {}
	local inset = o.inset or 0
	local x1, x2, z1, z2 = rect.x1 + inset, rect.x2 - inset, rect.z1 + inset, rect.z2 - inset
	if x2 - x1 &lt; 0.1 or z2 - z1 &lt; 0.1 then
		return nil
	end
	local f = FINISHES[finish or "oak"] or FINISHES.oak
	return Kit.part(parent, cf, o.name or "Floor", V3(x2 - x1, Kit.FINISH, z2 - z1), CF((x1 + x2) / 2, levelY + Kit.FINISH / 2, (z1 + z2) / 2), f.color, f.mat)
end

-- Suspended ceiling (underside levelY + 13, 0.3 thick): "acoustic" | "timber" | "plaster", with
-- integrated Neon light strips. Returns (parts carrying a SurfaceLight, all strip parts).
function Kit.ceiling(parent: Instance, cf: CFrame, rect: Rect, levelY: number, style: string?, mood: (string | Color3)?, opts: SurfaceOpts?): ({ Part }, { Part })
	local o: SurfaceOpts = opts or {}
	local inset = o.inset or 0
	local x1, x2, z1, z2 = rect.x1 + inset, rect.x2 - inset, rect.z1 + inset, rect.z2 - inset
	local W, D = x2 - x1, z2 - z1
	if W &lt; 1 or D &lt; 1 then
		return {}, {}
	end
	local yb = levelY + (o.height or Kit.CEILING)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	local alongX = W &gt;= D
	local L, S = if alongX then W else D, if alongX then D else W
	-- helper: building-local CFrame from (long, short) offsets relative to the centre
	local function at(l: number, s: number, y: number): CFrame
		return if alongX then CF(cx + l, y, cz + s) else CF(cx + s, y, cz + l)
	end
	local function size(l: number, y: number, s: number): Vector3
		return if alongX then V3(l, y, s) else V3(s, y, l)
	end
	local st = style or "acoustic"
	local slatPitch = 1.5
	if st == "timber" then
		Kit.part(parent, cf, "CeilingBacking", size(L, 0.05, S), at(0, 0, yb + 0.275), C.fabricCharcoal, M.fabric)
		local n = math.max(1, math.floor(S / slatPitch))
		for i = 0, n - 1 do
			local s = -S / 2 + (i + 0.5) * (S / n)
			Kit.part(parent, cf, "CeilingSlat", size(L, 0.25, math.min(0.9, S / n - 0.3)), at(0, s, yb + 0.125), C.oakLight, M.wood)
		end
		slatPitch = S / n
	elseif st == "plaster" then
		Kit.part(parent, cf, o.name or "Ceiling", size(L, 0.3, S), at(0, 0, yb + 0.15), C.white, M.plaster)
	else
		local nl = math.max(1, math.ceil(L / 16))
		local ns = math.max(1, math.ceil(S / 16))
		local j = 0.12
		local pl, ps = (L - (nl - 1) * j) / nl, (S - (ns - 1) * j) / ns
		for i = 0, nl - 1 do
			for k = 0, ns - 1 do
				Kit.part(parent, cf, "CeilingPanel", size(pl, 0.3, ps), at(-L / 2 + pl / 2 + i * (pl + j), -S / 2 + ps / 2 + k * (ps + j), yb + 0.15), C.white, M.plaster)
			end
		end
	end
	-- light strips along the long axis
	local glow = if typeof(mood) == "Color3" then mood elseif type(mood) == "string" and (A.mood :: any)[mood] then (A.mood :: any)[mood].color else C.lightNeutral
	local rows = math.clamp(math.floor(S / 10 + 0.5), 1, 4)
	local stripLen = math.max(L - 3, 1)
	local segs = 1
	local segLen = stripLen
	local strips: { Part } = {}
	for r = 1, rows do
		local s = -S / 2 + (r - 0.5) * S / rows
		local y = yb - 0.03
		if st == "timber" then
			-- sit in the nearest gap between two slats, flush with the slat underside
			local gi = math.clamp(math.floor((s + S / 2) / slatPitch + 0.5), 1, math.max(1, math.floor(S / slatPitch) - 1))
			s = -S / 2 + gi * slatPitch
			y = yb + 0.03
		end
		for k = 0, segs - 1 do
			local l = -stripLen / 2 + segLen / 2 + k * (segLen + 1)
			table.insert(strips, Kit.part(parent, cf, "LightStrip", size(segLen, 0.06, 0.25), at(l, s, y), glow, M.neon, DETAIL))
		end
	end
	local maxL = o.maxLights or 1
	local count = if maxL &lt;= 0 then 0 else math.min(math.clamp(math.floor(W * D / 400), 1, maxL), #strips)
	local lit: { Part } = {}
	for i = 1, count do
		local idx = math.clamp(math.floor((i - 0.5) * #strips / count) + 1, 1, #strips)
		local p = strips[idx]
		Kit.light(p, "surface", mood or "neutral", nil, nil, Enum.NormalId.Bottom)
		table.insert(lit, p)
	end
	return lit, strips
end

---------------------------------------------------------------------------------------------
-- Cameras and access volumes (SPEC §6)
---------------------------------------------------------------------------------------------
-- Security camera at building-local `position` aiming at `target`; bracket rises 1 stud to the
-- ceiling/wall mount. ViewCFrame = the body CFrame pushed 1 stud forward (world space).
function Kit.camera(parent: Instance, cf: CFrame, id: string, name: string, position: Vector3, target: Vector3, level: number, roomId: string, private: boolean): Part
	local dir = target - position
	local up = if dir.Magnitude &gt; 1e-3 and math.abs(dir.Unit.Y) &gt; 0.98 then V3(0, 0, 1) else V3(0, 1, 0)
	local look = if dir.Magnitude &gt; 1e-3 then CFrame.lookAt(position, target, up) else CF(position)
	local body = Kit.part(parent, cf, "CampusCamera_" .. id, V3(0.6, 0.6, 1.2), look, C.white, M.smooth, DETAIL)
	Kit.cylinder(body, cf, "Lens", "z", 0.25, 0.42, look * CF(0, 0, -0.68), C.screen, M.glass, DETAIL)
	Kit.part(body, cf, "Bracket", V3(0.16, 0.75, 0.16), CF(position) * CF(0, 0.6, 0), C.metalSoft, M.metal, DETAIL)
	Kit.part(body, cf, "Mount", V3(0.6, 0.08, 0.6), CF(position) * CF(0, 0.96, 0), C.metalSoft, M.metal, DETAIL)
	body:SetAttribute("CameraId", id)
	body:SetAttribute("CameraName", name)
	body:SetAttribute("ViewCFrame", cf * look * CF(0, 0, -1))
	body:SetAttribute("Level", level)
	body:SetAttribute("RoomId", roomId)
	body:SetAttribute("Private", private)
	return body
end

-- Invisible PathfindingModifier volume over a restricted room (nil for public/staff rooms).
function Kit.accessVolume(parent: Instance, cf: CFrame, room: Room): Part?
	if room.access == "public" or room.access == "staff" then
		return nil
	end
	local y = Plan.levelY(room.level)
	local p = Kit.part(parent, cf, "Access_" .. room.id, V3(room.x2 - room.x1, 14, room.z2 - room.z1), CF((room.x1 + room.x2) / 2, y + 7, (room.z1 + room.z2) / 2), C.white, nil, { detail = true, transparency = 1 })
	-- Pathfinding ignores modifier parts whose CanQuery AND CanTouch are both false (reported engine
	-- behaviour, devforum 3504949). Keep CanQuery off (no raycast/prompt interference), CanTouch on.
	p.CanTouch = true
	local mod = Instance.new("PathfindingModifier")
	mod.Label = room.access
	mod.Parent = p
	p:SetAttribute("AccessClass", room.access)
	p:SetAttribute("RoomId", room.id)
	return p
end

return Kit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000016"><Properties><string name="Name">AssistantService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The founder's personal assistant: one Executive Assistant NPC per headquarters (folder Office.Assistant).
-- Identity: feminine first name and appearance seed derived from the owner id (stable across visits),
-- built with EmployeeRigDesign; role "assistant" (BuildingPlan clearance public + staff + founder).
-- Home post: the desk station of the founder reception F_ASSIST (fallback: the planned room centre); in
-- the garage stage (plan tier 0) her small desk by the side door (BuildingPlan.postRoom).
-- She walks with EmployeeNavigation on the shared queue and campus clock (StaffService.now), uses
-- doors via DoorService.requestNPC and the lift via LiftService tickets exactly like employees.
--
-- Talk (owner-only prompt) → Notify ASSISTANT_OPEN with a briefing built ONLY from the owner's session
-- data (finances, training, models, data &amp; hardware, research, team, 1-3 rule-based recommendations).
-- She is an authored helper, not a language model: every sentence is a template over real numbers.
-- Coffee (AssistantAction "coffee", 120 s cooldown): the company pays the menu price of the café's
-- "coffee" at once; she walks to the nearest Coffee activity / coffee machine (founder-floor tea kitchen
-- first), brews for BREW_SECONDS, carries a cup and walks to the founder while they are inside the
-- building (re-targeting every RETARGET s, giving up after GIVE_UP s); within HANDOVER studs she hands it
-- over with FacilityService.deliverSnack and a one-line insight. Founder outside: she waits at her desk
-- with the cup and hands it over when the founder talks to her.
-- Proactive, never chatty: one greeting per session when the founder first comes within GREET_RANGE on
-- the founder floor; a pending training decision is mentioned at most every REMIND_EVERY s when near.
-- Self-healing like LiftService: tick attaches her to every claimed office that has none and drops
-- records of destroyed offices.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Prompts=game:GetService("ProximityPromptService")
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local EmployeeConfig=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local ModelConfig=require(ReplicatedStorage.Shared.Config.ModelConfig)
local MarketConfig=require(ReplicatedStorage.Shared.Config.MarketConfig)
local HardwareConfig=require(ReplicatedStorage.Shared.Config.HardwareConfig)
local Ops=require(ReplicatedStorage.Shared.CompanyOps)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local EmpireMath=require(ReplicatedStorage.Shared.EmpireMath)
local ModelMath=require(ReplicatedStorage.Shared.ModelMath)
local JourneyMath=require(ReplicatedStorage.Shared.JourneyMath)
local Format=require(ReplicatedStorage.Shared.Format)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Rig=require(script.Parent.EmployeeRigDesign)
local Nav=require(script.Parent.EmployeeNavigation)
local Workstations=require(script.Parent.WorkstationService)
local Staff=require(script.Parent.StaffService)
local Facility=require(script.Parent.FacilityService)
local Sound=require(script.Parent.CampusSoundService)
local Recruiting=require(script.Parent.RecruitingService)
local NPC=Recruiting.npc
local Assistant={}
Assistant.TITLE="Executive Assistant"
Assistant.COFFEE_COOLDOWN=120
Assistant.BREW_SECONDS=4
Assistant.HANDOVER=6
Assistant.RETARGET=3
Assistant.GIVE_UP=120
Assistant.GREET_RANGE=25
Assistant.REMIND_EVERY=180
local INDEX=400 -- StaffIndex of her rig (employees 1..240, operations 301..312, visitors 501..)
local records: {[Instance]:any}={}
local orders: {[any]:number}=setmetatable({},{__mode="k"}) :: any
local greeted: {[any]:boolean}=setmetatable({},{__mode="k"}) :: any
local reminded: {[any]:number}=setmetatable({},{__mode="k"}) :: any
local scanClock=1
local failed: {[Instance]:number}=setmetatable({},{__mode="k"}) :: any -- office → retry time after an error
-- Movement and clock seams (headless tests replace them with a fake walker).
local mover: any={
 go=function(e: any,target: Vector3,time: number,cb: (boolean)-&gt;()) Nav.go(e,target,time,cb) end,
 cancel=function(e: any) Nav.cancel(e) end,
 tick=function(e: any,time: number) Nav.tick(e,time) end,
}
local clock: ()-&gt;number=function() return Staff.now() end
function Assistant._seams(fakeMover: any?,fakeClock: (()-&gt;number)?)
 if fakeMover then mover=fakeMover end
 if fakeClock then clock=fakeClock end
end

function Assistant.identity(owner: number): (string,number)
 local seed=EmployeeConfig.hash((math.floor(math.abs(owner))*13+4242)%4294967296)%2147483647
 return CampusMath.nameForSeed(seed,true),seed
end
local function notify(s: any,text: string)
 Remote.fire(s.player,"Notify","ASSISTANT_NOTICE",{text=text})
end
local function founderRoot(rec: any): BasePart?
 local character=rec.session.player.Character
 local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
 return if root and root:IsA("BasePart") then root else nil
end
local function inside(rec: any,p: Vector3): boolean return Plan.inside(rec.tier,rec.cf:PointToObjectSpace(p)) end
local function lowerFirst(text: string): string
 if string.match(text,"^%u%l") then return string.lower(string.sub(text,1,1))..string.sub(text,2) end
 return text
end

-- Briefing (pure: session data + live values only) ----------------------------------------------
local function row(label: string,value: string): {string} return {label,value} end
local function nextSize(data: any): any
 local best=0
 for _,m in data.models do
  for i,size in ModelConfig.SIZES do if size.id==m.sizeId then best=math.max(best,i) end end
 end
 return ModelConfig.SIZES[math.min(best+1,#ModelConfig.SIZES)]
end
local function trend(history: {any}): (number?,number?)
 if #history&lt;2 then return nil,nil end
 local function avg(from: number,to: number): number
  local sum,n=0,0
  for i=math.max(1,from),to do sum+=history[i].profit;n+=1 end
  return if n&gt;0 then sum/n else 0
 end
 local last=#history;local window=math.min(6,math.floor(last/2))
 local recent=avg(last-window+1,last);local before=avg(last-2*window+1,last-window)
 return recent,recent-before
end
-- Briefing (CORE_SPEC 8.2): sections Today, Customers, Money and Models first (company day and who is away, the B2B
-- pipeline, today's P&amp;L from the ledger, live lines and servers), then Training, Research and Team. The first
-- recommendation is the "Next goal" of EmpireMath.nextGoal (only a pending training decision comes before it).
local MOVE_NOTE_SECONDS=900 -- "New HQ: profit dips for ~15 minutes while new people start" (CORE_SPEC 9.5)
local movedAt: {[any]:number}=setmetatable({},{__mode="k"}) :: any
local seenOffice: {[any]:number}=setmetatable({},{__mode="k"}) :: any
local LEDGER_NAMES: {[string]:string}={market="AI products",b2b="retainers",pilot="pilot fees",studio="studio",guest="guest house",retail="stores",
 quest="milestones",daily="daily grant",wages="wages",ops="operations staff",upkeep="rent &amp; utilities",food="lunch",fleet="fleet",trips="trips",
 b2bserve="client serving",jet="jet",jetbuy="jet purchase",hire="hiring fees",research="research",lab="Lab levels",office="office move",gpu="GPUs",
 data="data",training="training",refine="refinement",marketing="marketing",campus="campus",shop="shop",other="other"}
local function dollars(n: number): string return Ops.money(n) end
-- top n categories of one ledger side: "wages $31,600 · research $12,000"
local function topLines(map: any,n: number): (string,number)
 local list,total={},0
 if typeof(map)=="table" then for cat,v in map do local x=tonumber(v) or 0;if x&gt;0 then table.insert(list,{cat=tostring(cat),v=x});total+=x end end end
 table.sort(list,function(a,b) if a.v~=b.v then return a.v&gt;b.v end;return a.cat&lt;b.cat end)
 local parts={}
 for i=1,math.min(n,#list) do table.insert(parts,(LEDGER_NAMES[list[i].cat] or list[i].cat).." "..dollars(list[i].v)) end
 return table.concat(parts," · "),total
end
-- when a trip that is back at play second `back` returns, on the visible clock: "14:20", "tomorrow 08:10", "day 12 09:00"
local function backText(e: any,back: number,clock: number): string
 local at=clock+math.max(0,back-(tonumber(e.seconds) or 0))
 local h=Ops.hour(at);local days=math.floor(at/Ops.DAY)-math.floor(clock/Ops.DAY)
 local hm=string.format("%02d:%02d",math.floor(h),math.floor((h%1)*60))
 -- a game day runs 08:00 -&gt; 08:00: hours before 08:00 are that day's night
 local night=h&lt;8
 if days&lt;=0 then return if night then "tonight "..hm else hm end
 if days==1 then return if night then "tomorrow night "..hm else "tomorrow "..hm end
 return "day "..(Ops.day(e)+days).." "..hm
end
local function tripLine(e: any,t: any,clock: number): string
 local c=Ops.client(t.client);local name=if c then c.name else tostring(t.client)
 local tier=t.tier or (if c then c.trip else "city")
 local who=if t.hosted then name.." team at the guest house" elseif t.founder then "you at "..name elseif (tonumber(t.crew) or 1)&gt;=2 then "rep + engineer at "..name else "rep at "..name
 local stay=""
 if not t.hosted then
  local T=Ops.TRIPS[tier]
  if tier=="abroad" then stay=if e.jet==true then ", company jet" else ", Meridian Grand $"..(T and T.hotel or 0)
  elseif tier=="region" then stay=", City Hotel $"..(T and T.hotel or 0) end
 end
 return string.format("%s (%s, back %s%s)",who,if t.kind=="renew" then "check-in" else "pilot",backText(e,tonumber(t.back) or 0,clock),stay)
end
local function lineName(target: string?): string
 for _,def in ModelConfig.LINES do if def.target==(target or "general") then return def.label end end
 return "Consumer Chat"
end
-- the goal of the HUD bar as a recommendation with its concrete next step
local function goalRecommendation(s: any,goal: any,stock: any,journey: any,unreleased: any): (string,string?,string?)
 local data=s.data;local e=data.empire
 local id=goal.id
 if id=="train" then
  if data.training then return goal.text..": the first training run is under way in the Lab.","lab",nil end
  if stock.total&lt;ModelConfig.TRAINING.minTokens then return goal.text..": collect at least "..Format.tokens(ModelConfig.TRAINING.minTokens).." tokens in Data first.","data",nil end
  if journey.missingVram&gt;0 then return goal.text..": buy GPUs in Hardware or pick a smaller size ("..journey.hint..").","compute",nil end
  return goal.text..": design and train it in the Lab.","lab",nil
 elseif id=="release" then
  return if unreleased then "Release "..unreleased.name.." in Deployment: it isn't earning anything yet." else goal.text..": release your trained model in Deployment.","lab","release"
 elseif id=="client" then
  local c=Ops.CLIENTS[1];local best=Ops.liveBest(data,c.stat)
  local trip=nil
  for _,t in (if typeof(e.deals)=="table" and typeof(e.deals.tripList)=="table" then e.deals.tripList else {}) do if t.client==c.id then trip=t end end
  if trip then return goal.text..": you are on the way for the pilot visit.","empire","clients" end
  if best&lt;c.minimum then return string.format("%s: %s needs %s %d (your best live model: %d).",goal.text,c.name,c.stat,c.minimum,math.floor(best)),"lab",nil end
  return goal.text..": the pilot visit starts by itself as soon as cash covers the trip.","empire","clients"
 elseif goal.etaMinutes~=nil or string.match(id,"^office") or id=="jet" then
  local eta=goal.etaMinutes
  local when=if (tonumber(goal.have) or 0)&gt;=(tonumber(goal.need) or 1) then "ready to buy" elseif eta==nil then "no profit yet" elseif eta&lt;1 then "under a minute away" elseif eta&lt;120 then string.format("about %d min away",math.ceil(eta)) else string.format("about %d h away",math.ceil(eta/60))
  return string.format("%s: %s of %s saved, %s.",goal.text,dollars(tonumber(goal.have) or 0),dollars(tonumber(goal.need) or 0),when),"empire",if id=="jet" then "settings" else "office"
 elseif id=="lines2" then return goal.text..": release a model into another product line.","lab",if unreleased then "release" else nil
 elseif id=="region" then return goal.text..": Growth &amp; Sales field reps visit region clients (City Hotel night).","empire","clients"
 elseif id=="frontier" then return goal.text..": research Frontier Architecture.","empire","research"
 end
 return string.format("%s (%d / %d).",goal.text,math.floor(tonumber(goal.have) or 0),math.floor(tonumber(goal.need) or 0)),"lab",nil
end
function Assistant.briefing(s: any,name: string?): any
 local data=s.data;local live=s.live;local e=data.empire
 local sections={};local recs={}
 local function recommend(text: string,app: string?,section: string?)
  if #recs&lt;3 then table.insert(recs,{text=text,app=app,section=section}) end
 end
 local clock=workspace:GetServerTimeNow()
 local ops=if typeof(live.ops)=="table" then live.ops else {}
 local deals=if typeof(e.deals)=="table" then e.deals else Ops.newDeals()
 local trips=if typeof(ops.trips)=="table" then ops.trips elseif typeof(deals.tripList)=="table" then deals.tripList else {}
 -- Today: company day, who is at work / away, trips
 local present,vacation,sick,away,leave,total=0,0,0,0,0,0
 for _,role in EmpireConfig.ROLES do
  for _,state in Ops.presence(e,role.id) do
   total+=1
   if state=="present" then present+=1 elseif state=="vacation" then vacation+=1 elseif state=="sick" then sick+=1 elseif state=="trip" then away+=1 else leave+=1 end
  end
 end
 local repsAway=0 -- field reps on trips (the travelling engineers are already "trip" in Ops.presence)
 for _,t in trips do if not t.hosted and not t.founder then repsAway+=1 end end
 away+=repsAway
 local todayRows={row("Company day",Format.dayClock(Ops.day(e),Ops.hour(clock)))}
 if total==0 then table.insert(todayRows,row("Team","Nobody hired yet: you run the company alone."))
 else
  local parts={}
  if vacation&gt;0 then table.insert(parts,vacation.." on vacation") end
  if sick&gt;0 then table.insert(parts,sick.." sick") end
  if away&gt;0 then table.insert(parts,away.." travelling") end
  if leave&gt;0 then table.insert(parts,leave.." on unpaid leave") end
  local base=if Ops.inOffice(clock) then string.format("%d of %d at work",math.max(0,present-repsAway),total) else string.format("night: off duty until 08:00 (%d of %d)",total-vacation-sick-leave,total)
  table.insert(todayRows,row("Team",base..(if #parts&gt;0 then " · "..table.concat(parts,", ") else "")))
 end
 local stage=Ops.stageIndex(e)
 if Ops.opsPosts(e)&gt;0 then
  local drivers=if stage&gt;=Ops.DRIVER.more then 2 elseif stage&gt;=Ops.DRIVER.from then 1 else 0
  table.insert(todayRows,row("Operations",string.format("%d operations staff%s · lunch for the team from the chef",Ops.opsPosts(e),if drivers&gt;0 then string.format(" · %d driver%s",drivers,if drivers==1 then "" else "s") else "")))
 end
 if #trips&gt;0 then
  local lines={}
  for i=1,math.min(3,#trips) do table.insert(lines,tripLine(e,trips[i],clock)) end
  table.insert(todayRows,row("Trips",table.concat(lines,"; ")..(if #trips&gt;3 then string.format(" and %d more",#trips-3) else "")))
 else table.insert(todayRows,row("Trips","Nobody is travelling right now.")) end
 local moved=movedAt[s]
 if moved and (tonumber(e.seconds) or 0)-moved&lt;MOVE_NOTE_SECONDS then
  table.insert(todayRows,row("New HQ","Profit dips for about 15 minutes while new people start."))
 end
 table.insert(sections,{title="Today",rows=todayRows})
 -- Customers: the B2B pipeline
 local custRows={}
 local accounts,retainer=0,0
 local renew: {string}={}
 for id,acc in (if typeof(deals.accounts)=="table" then deals.accounts else {}) do
  local c=Ops.client(id)
  accounts+=1
  if c then
   retainer+=c.retainer
   local left=((tonumber(acc.expires) or 0)-(tonumber(e.seconds) or 0))/Ops.DAY
   if acc.renewing then table.insert(renew,c.name.." (check-in under way)")
   elseif left&lt;Ops.TRIPS[c.trip].days+Ops.RENEW_LEAD_DAYS+0.5 then table.insert(renew,string.format("%s in %.1f days",c.name,math.max(0,left))) end
  end
 end
 local limit=Ops.accountLimit(e)
 table.insert(custRows,row("Accounts",if accounts==0 then "No business client yet." else string.format("%d of %d slots · %s/day in retainers",accounts,limit,dollars(retainer))))
 local leads,bestLead,bestTrust,needs=0,nil,-1,nil
 for _,c in Ops.CLIENTS do
  local acc=typeof(deals.accounts)=="table" and deals.accounts[c.id]
  if not acc and stage&gt;=c.stage then
   local best=Ops.liveBest(data,c.stat)
   if best&gt;=c.minimum then
    leads+=1
    local t=tonumber(typeof(deals.trust)=="table" and deals.trust[c.id]) or 0
    if t&gt;bestTrust then bestTrust=t;bestLead=c end
   elseif not needs then
    needs=if best&lt;=0 then string.format("%s needs %s %d: release a model first.",c.name,c.stat,c.minimum) else string.format("%s needs %s %d (your best: %d).",c.name,c.stat,c.minimum,math.floor(best))
   end
  end
 end
 table.insert(custRows,row("Pipeline",if leads==0 then "No open lead right now." else string.format("%d lead%s%s · %d on the road",leads,if leads==1 then "" else "s",if bestLead then string.format(" · %s trust %d %%",bestLead.name,math.floor(math.min(1,bestTrust)*100)) else "",#trips)))
 if #renew&gt;0 then table.insert(custRows,row("Renewals",table.concat(renew,", "))) end
 if needs then table.insert(custRows,row("Needs",needs)) end
 table.insert(sections,{title="Customers",rows=custRows})
 -- Money: today's P&amp;L by category from the ledger, the running rate and the trend
 local entry=if typeof(e.ledger)=="table" then e.ledger[tostring(Ops.day(e))] else nil
 local incomeText,income=topLines(entry and entry.i,3)
 local costText,costs=topLines(entry and entry.o,3)
 local recent,delta=trend(e.history)
 local trendText="Not enough data yet (one sample every 10 s)."
 if recent and delta then
  local steady=math.abs(delta)&lt;math.max(5,math.abs(recent)*.05)
  trendText=if steady then "Steady at "..Format.money(recent*20).."/day"
   elseif delta&gt;0 then "Rising: "..Format.money(recent*20).."/day"
   else "Falling: "..Format.money(recent*20).."/day"
 end
 table.insert(sections,{title="Money",rows={row("Cash",Format.money(data.money)),
  row("Today",if income+costs==0 then "Nothing booked yet today." else string.format("income %s · costs %s · net %s",dollars(income),dollars(costs),dollars(income-costs))),
  row("Income",if incomeText~="" then incomeText else "none yet"),row("Costs",if costText~="" then costText else "none yet"),
  row("Running now",Format.perDay(live.revenue-live.cost).." net"),row("Profit trend",trendText)}})
 -- Models: live lines, servers, ageing, growth
 local best: any,liveCount,unreleased: any=nil,0,nil
 for _,id in data.modelOrder do
  local m=data.models[id]
  if m and m.status~="training" then
   if not best or m.overall&gt;best.overall then best=m end
   if m.status=="live" then liveCount+=1 elseif m.status=="trained" and not unreleased then unreleased=m end
  end
 end
 local lines,nLines=ModelMath.liveLines(data)
 local lineParts,oldest,oldestAge={},nil,0
 for _,def in ModelConfig.LINES do
  local list=lines[def.segment]
  if list then
   local top=list[1];for _,m in list do if (m.overall or 0)&gt;(top.overall or 0) then top=m end end
   table.insert(lineParts,string.format("%s %s v%d (%.1f)",def.label,top.name,top.version or 1,top.overall or 0))
   local age=ModelMath.versionAge(top)
   if age&gt;oldestAge then oldestAge=age;oldest={def=def,model=top} end
  end
 end
 local modelRows={row("Live lines",if nLines==0 then "No model is live yet." else string.format("%d of %d: %s",nLines,ModelMath.productSlots(stage),table.concat(lineParts," · "))),
  row("Users",Format.compact(live.users))}
 local capacity=tonumber(live.capacity) or 0;local load=tonumber(live.load) or 0;local waiting=tonumber(live.waitlist) or 0
 if liveCount&gt;0 and capacity&gt;0 then
  local extra,gpuName=0,nil
  for _,gpu in HardwareConfig.GPUS do
   if not gpu.starter and gpu.price&lt;=math.max(data.money,2500) then
    local g=table.clone(data.gpus);g[gpu.id]=(g[gpu.id] or 0)+1
    local copy=table.clone(data);copy.gpus=g
    local add=Ops.capacity(copy)-Ops.capacity(data)
    if add&gt;extra then extra=add;gpuName=gpu.label end
   end
  end
  local text=string.format("%d %% full",math.floor(load/capacity*100+0.5))
  if waiting&gt;0 then text..=string.format(", %s waiting",Format.int(waiting))..(if gpuName and extra&gt;=1 then string.format(" — a %s serves %s more.",gpuName,Format.int(extra)) else " — upgrade cooling first.") end
  table.insert(modelRows,row("Servers",text))
 end
 if oldest then
  local fit=ModelMath.ageFit(oldestAge)
  if fit&gt;=1 then table.insert(modelRows,row("Oldest line",string.format("Your %s line is %d min old (-%d fit). A new version resets it.",oldest.def.label,math.floor(oldestAge/60),math.floor(fit+0.5)))) end
 end
 local marketers=tonumber(e.employees and e.employees.marketer) or 0
 if marketers&gt;0 then
  local stageMax=(MarketConfig.STAGE_REACH or {})[stage] or 0.9
  local office=marketers-Ops.fieldReps(e)
  local cap=Ops.reachCap(data,stageMax)
  table.insert(modelRows,row("Growth",if cap&gt;=stageMax-1e-6 then string.format("Growth team at full effect (%d in the office).",office) else string.format("%d in the office reach %d %% of the %d %% this office allows.",office,math.floor(cap*100+0.5),math.floor(stageMax*100+0.5))))
 end
 table.insert(modelRows,row("Best model",if best then best.name.." · "..string.format("%.1f",best.overall).." overall" else "No trained model yet"))
 table.insert(sections,{title="Models",rows=modelRows})
 -- Training
 local training=data.training;local pending=nil
 if training then
  local model=data.models[training.modelId]
  local rate=EmpireMath.trainingRate(data.gpus,training.workTotal,e)
  local progress=if training.workTotal&gt;0 then training.workDone/training.workTotal else 0
  local rows={row("Model",if model then model.name else "Unnamed run"),row("Progress",Format.percent(progress,0)),
   row("Time left",if rate&gt;0 then Format.duration((training.workTotal-training.workDone)/rate) else "Waiting for compute")}
  local event=training.event
  if event and event.pending then
   local def=ModelConfig.getEvent(event.id)
   if def then
    local choices={}
    local list: {any}=def.choices or {}
    for _,c in list do table.insert(choices,c.label.." ("..c.desc..")") end
    pending=def
    table.insert(rows,row("Decision needed",def.title.." · "..table.concat(choices," or ")))
   end
  end
  table.insert(sections,{title="Training",rows=rows})
 else
  local last=JourneyMath.latest(data)
  table.insert(sections,{title="Training",rows={row("Status","No training running"),row("Last model",if last then last.name.." · "..string.format("%.1f",last.overall).." overall" else "None yet")}})
 end
 -- Data &amp; hardware (until the first release: the journey's next step)
 local stock=ModelMath.dataSummary(data.data);local fleet=ModelMath.fleet(data.gpus)
 local size=nextSize(data);local journey=JourneyMath.progress(data,{sizeId=size.id})
 if (data.stats.modelsReleased or 0)==0 then
  table.insert(sections,{title="Data &amp; hardware",rows={row("Training data",Format.tokens(stock.total).." tokens · "..Format.percent(stock.quality,0).." quality"),
   row("VRAM",tostring(fleet.vram).." GB · next size "..size.label.." needs "..tostring(size.vram).." GB"),row("Next step",journey.hint)}})
 end
 -- Research
 local job=e.researchJob;local ready,nextDef=nil,nil
 for _,def in EmpireConfig.RESEARCH do
  if not e.research[def.id] and (not def.prereq or e.research[def.prereq]) then
   if not nextDef then nextDef=def end
   if not ready and e.points&gt;=def.points and data.money&gt;=def.cost then ready=def end
  end
 end
 local researchRows={}
 if job then
  local def=EmpireConfig.find(EmpireConfig.RESEARCH,job.id)
  table.insert(researchRows,row("Active",(if def then def.name else job.id).." · "..Format.percent(job.elapsed/math.max(1,job.seconds),0).." · "..tostring(math.ceil(job.seconds-job.elapsed)).." s left"))
 else table.insert(researchRows,row("Active","Nothing is being researched")) end
 if ready then table.insert(researchRows,row("Affordable now",ready.name.." · "..Format.money(ready.cost).." · "..tostring(ready.points).." RP"))
 elseif nextDef then
  local missing={}
  if e.points&lt;nextDef.points then table.insert(missing,tostring(math.ceil(nextDef.points-e.points)).." RP") end
  if data.money&lt;nextDef.cost then table.insert(missing,Format.money(nextDef.cost-data.money)) end
  table.insert(researchRows,row("Next project",nextDef.name.." · needs "..table.concat(missing," and ").." more"))
 else
  local level=math.floor(tonumber(e.labLevel) or 0)
  table.insert(researchRows,row("Next project",if level&lt;Ops.LAB_MAX then string.format("Every project is complete · Lab level %d / %d in Models",level,Ops.LAB_MAX) else "Every project and Lab level is complete"))
 end
 table.insert(sections,{title="Research",rows=researchRows})
 -- Team
 local staff=EmpireMath.staff(e);local cap=EmpireConfig.OFFICES[stage].staff
 local counts=Recruiting.counts(s)
 local teamRows={row("Team",string.format("%d / %d desks filled",staff,cap))}
 local wf=live.workforce
 if typeof(wf)=="table" and typeof(wf.states)=="table" then
  local working,breaks,meetings,off=0,0,0,0
  for state,n in wf.states do
   if EmployeeConfig.productive(state)&gt;=1 then working+=n
   elseif state=="COFFEE_BREAK" or state=="LUNCH" then breaks+=n
   elseif state=="MEETING" or state=="TALKING" then meetings+=n
   elseif state=="OFF_DUTY" or state=="LEAVING" or state=="ARRIVING" then off+=n end
  end
  table.insert(teamRows,row("In the building now",string.format("%d working · %d on a break · %d in meetings · %d off duty",working,breaks,meetings,off)))
 else table.insert(teamRows,row("In the building now","Activity appears once your headquarters is open")) end
 table.insert(teamRows,row("Applications",string.format("%d open · %d candidate%s in the visitor lounge",counts.open,counts.waiting,if counts.waiting==1 then "" else "s")))
 local hrAuto=Ops.hrSettings(e)
 table.insert(teamRows,row("HR",if hrAuto then "Automatic hiring is on (Company → Settings)" else "Automatic hiring is off: hire in Company → Team"))
 table.insert(sections,{title="Team",rows=teamRows})
 -- Recommendations: a pending training decision, then the Next goal, then simple rules over the same numbers.
 if pending then recommend("Decide the training event in the Lab: "..pending.title..".","lab") end
 local goal=EmpireMath.nextGoal(data,live)
 if goal then
  local text,app,section=goalRecommendation(s,goal,stock,journey,unreleased)
  recommend(text,app,section)
 end
 if unreleased and not (goal and goal.id=="release") then recommend("Release "..unreleased.name.." in Deployment. It isn't earning anything yet.","lab","release") end
 if recent and delta and recent&lt;0 and delta&lt;=0 then recommend("Profit is negative and not improving. Reduce staff or raise prices.","market") end
 if waiting&gt;0 then
  local cooled=HardwareConfig.thermal(e,ModelMath.fleet(data.gpus).throughput)&gt;=1
  recommend(string.format("%s users are waiting for server capacity: %s in Hardware.",Format.int(waiting),if cooled then "buy GPUs" else "upgrade cooling first, more GPUs would only run hotter"),"compute")
 end
 if not training and journey.missingVram&gt;0 and (data.stats.modelsReleased or 0)==0 then recommend("Buy GPUs in Hardware or pick a smaller size: "..journey.hint..".","compute") end
 if counts.waiting&gt;0 then recommend(string.format("%d candidate%s waiting in the visitor lounge.",counts.waiting,if counts.waiting==1 then " is" else "s are"),"empire","team") end
 if not job and ready and live.ops and live.ops.saveMode~=true then recommend("Start research: "..ready.name..".","empire","research") end
 if counts.open&gt;0 then recommend(string.format("%d new application%s. Invite promising people for an interview.",counts.open,if counts.open==1 then "" else "s"),"empire","team") end
 if not hrAuto and staff&lt;cap*.25 and data.money&gt;=10000 then recommend(string.format("Hire more specialists: %d desks are empty.",cap-staff),"empire","team") end
 if #recs==0 then
  table.insert(recs,{text=if recent then "Everything is on track: profit is "..Format.money(recent*20).."/day. Keep training bigger models." else "Everything is on track. Keep training bigger models."})
 end
 local assistantName=name or Assistant.identity(s.userId)
 return {name=assistantName,role=Assistant.TITLE,sections=sections,recommendations=recs,company=if data.company then data.company.name else nil}
end
-- One-line insight for notices (the most urgent recommendation).
function Assistant.insight(s: any): string
 return Assistant.briefing(s).recommendations[1].text
end

-- NPC ----------------------------------------------------------------------------------------------
local function homeOf(rec: any): (Vector3,any)
 local post=Plan.postRoom(rec.tier,"assistant") or "F_ASSIST"
 for _,w in Workstations.scan(rec.office).all do
  if w.room==post and w.kind=="Computer" and w.model.Parent then return w.position,w end
 end
 local r=Plan.room(rec.tier,post)
 local level=Plan.founderLevel(rec.tier)
 if r then return rec.cf*Vector3.new((r.x1+r.x2)/2,Plan.levelY(r.level)+3,(r.z1+r.z2)/2),nil end
 return rec.cf*Vector3.new(32,Plan.levelY(level)+3,-5),nil
end
local function settle(rec: any)
 local e=rec.e
 local _,desk=homeOf(rec)
 if desk and Workstations.reserve(desk,e) then
  e.task={id="Assistant",state="WORKING"}
  if Workstations.perform(e,clock()) then e.model:SetAttribute("Activity","WORKING");return end
 end
 -- standing post: face the reception door (building west)
 NPC.face(e,e.root.Position-rec.cf:VectorToWorldSpace(Vector3.xAxis));e.root.Anchored=true
 e.model:SetAttribute("Activity","WORKING")
end
local function dropCup(rec: any)
 local cup=rec.model:FindFirstChild("EmployeeCup");if cup then cup:Destroy() end
 rec.model:SetAttribute("HoldingCup",false);rec.cup=false;rec.e.carryCupUntil=nil
end
local function makeCup(rec: any)
 local arm=rec.model:FindFirstChild("Right Arm")
 if not rec.model:FindFirstChild("EmployeeCup") and arm and arm:IsA("BasePart") then
  local p=Instance.new("Part");p.Name="EmployeeCup";p.Size=Vector3.new(.5,.7,.5);p.Color=Color3.fromRGB(230,225,210);p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
  p.CFrame=arm.CFrame*CFrame.new(0,-.8,-.55);p.Parent=rec.model
  local weld=Instance.new("WeldConstraint");weld.Part0=arm;weld.Part1=p;weld.Parent=p
 end
 rec.model:SetAttribute("HoldingCup",true);rec.cup=true
 rec.e.carryCupUntil=math.huge -- WorkstationService.release must not take the cup away
end
local goHome: (rec: any)-&gt;()
local function leavePost(rec: any)
 Workstations.release(rec.e);rec.e.model:SetAttribute("Activity","WALKING")
end
goHome=function(rec: any)
 local home=homeOf(rec)
 leavePost(rec);rec.state="toPost"
 mover.go(rec.e,home,clock(),function(ok: boolean)
  if records[rec.office]~=rec or rec.state~="toPost" then return end
  if ok then settle(rec);rec.state=if rec.cup then "waitCup" else "post"
  else rec.state="retryHome";rec.retryAt=clock()+5 end
 end)
end
-- Coffee point: nearest free Coffee activity (her floor first: other floors count 80 studs per level),
-- else the nearest machine part, else the planned tea kitchen of the founder floor.
local function coffeeSpot(rec: any): (Vector3,any,BasePart?)
 local reg=Workstations.scan(rec.office);local level=Plan.founderLevel(rec.tier);local here=rec.e.root.Position
 local best,score=nil,math.huge
 for _,w in reg.byKind.Coffee or {} do
  if w.model.Parent and Workstations.available(w,rec.e) then
   local d=NPC.flat(w.position,here)+math.abs((w.floor or 0)-level)*80
   if d&lt;score then best=w;score=d end
  end
 end
 if best then return best.position,best,Workstations.machineFor(rec.office,best) end
 local machine: BasePart?=nil;score=math.huge
 for _,m in reg.machines do
  if m.Parent then
   local l=rec.cf:PointToObjectSpace(m.Position)
   local d=NPC.flat(m.Position,here)+math.abs((Plan.levelAt(rec.tier,l.Y) or 0)-level)*80
   if d&lt;score then machine=m;score=d end
  end
 end
 if machine then
  local l=rec.cf:PointToObjectSpace(machine.Position);local toward=rec.cf:PointToObjectSpace(here)-l
  local offset=Vector3.new(toward.X,0,toward.Z);offset=if offset.Magnitude&gt;.1 then offset.Unit*2.5 else Vector3.new(0,0,2.5)
  local floorY=Plan.levelY(Plan.levelAt(rec.tier,l.Y) or level)
  return rec.cf*Vector3.new(l.X+offset.X,floorY+3,l.Z+offset.Z),nil,machine
 end
 local r=Plan.room(rec.tier,Plan.postRoom(rec.tier,"pantry") or "F_PANTRY")
 if r then return rec.cf*Vector3.new((r.x1+r.x2)/2,Plan.levelY(r.level)+3,(r.z1+r.z2)/2),nil,nil end
 return here,nil,nil
end
local function steam(machine: BasePart?)
 if not machine then return end
 for _,d in machine:GetDescendants() do if d:IsA("ParticleEmitter") then d:Emit(5) end end
end
local function brew(rec: any)
 local e=rec.e;rec.state="brewing";rec.brewUntil=clock()+Assistant.BREW_SECONDS
 local w=rec.coffeeStation
 if w and Workstations.reserve(w,e) then e.task={id="Coffee",state="COFFEE_BREAK"};Workstations.perform(e,clock())
 elseif rec.machine then Sound.play(rec.machine,"coffee") end
 e.model:SetAttribute("Activity","COFFEE_BREAK")
 steam(rec.machine)
end
local function refund(rec: any,text: string)
 if rec.paid then Economy.grant(rec.session,rec.paid,"campus");rec.paid=nil end
 notify(rec.session,rec.name..": "..text)
end
local function fetchCoffee(rec: any,usePlan: boolean)
 local target,w,machine=coffeeSpot(rec)
 if usePlan then
  local r=Plan.room(rec.tier,Plan.postRoom(rec.tier,"pantry") or "F_PANTRY")
  if r then target=rec.cf*Vector3.new((r.x1+r.x2)/2,Plan.levelY(r.level)+3,(r.z1+r.z2)/2);w=nil end
 end
 rec.coffeeStation=w;rec.machine=machine;rec.state="toCoffee"
 mover.go(rec.e,target,clock(),function(ok: boolean)
  if records[rec.office]~=rec or rec.state~="toCoffee" then return end
  if ok then brew(rec)
  elseif not usePlan then fetchCoffee(rec,true)
  else refund(rec,"Sorry, I can't get to a coffee machine right now. I've cancelled the order.");goHome(rec) end
 end)
end
local function handover(rec: any)
 local s=rec.session
 local ok=Facility.deliverSnack(s,"coffee",true)
 dropCup(rec)
 if ok then rec.paid=nil;notify(s,rec.name..": Here's your coffee — "..lowerFirst(Assistant.insight(s)))
 else refund(rec,"Your snack bag is full, so I took the coffee back. No charge.") end
 goHome(rec)
end
local function finishBrew(rec: any)
 Workstations.release(rec.e);makeCup(rec)
 local root=founderRoot(rec)
 if root and inside(rec,root.Position) then
  rec.state="toFounder";rec.chaseStart=clock();rec.retargetAt=0;rec.lastTarget=nil;rec.e.model:SetAttribute("Activity","WALKING")
 else goHome(rec) end
end
local function chase(rec: any,now: number)
 local root=founderRoot(rec);local e=rec.e
 if not root or not inside(rec,root.Position) or now-rec.chaseStart&gt;Assistant.GIVE_UP then goHome(rec);return end
 if NPC.flat(root.Position,e.root.Position)&lt;=Assistant.HANDOVER and math.abs(root.Position.Y-e.root.Position.Y)&lt;6 then handover(rec);return end
 local target=root.Position
 if now&gt;=rec.retargetAt and (rec.lastTarget==nil or (rec.lastTarget-target).Magnitude&gt;3) then
  rec.retargetAt=now+Assistant.RETARGET
  if Plan.employeeAllowed(e.role,rec.tier,rec.cf:PointToObjectSpace(target)) then
   rec.lastTarget=target
   mover.go(e,target,now,function(_ok: boolean) if rec.state=="toFounder" then rec.lastTarget=nil end end)
  else
   -- the founder is somewhere she may not enter: wait here and try again shortly
   mover.cancel(e);rec.lastTarget=nil
  end
 end
end
local function proactive(rec: any,now: number)
 local s=rec.session;local root=founderRoot(rec);if not root then return end
 local near=(root.Position-rec.e.root.Position).Magnitude&lt;=Assistant.GREET_RANGE
 if not near then return end
 local level=Plan.levelAt(rec.tier,rec.cf:PointToObjectSpace(root.Position).Y)
 if not greeted[s] and level==Plan.founderLevel(rec.tier) then
  greeted[s]=true
  local hour=EmployeeConfig.hour(now)
  local hello=if hour&gt;=5 and hour&lt;12 then "Good morning" elseif hour&gt;=12 and hour&lt;18 then "Good afternoon" else "Good evening"
  notify(s,rec.name..": "..hello..", "..s.player.DisplayName.."! "..Assistant.insight(s).." Talk to me any time for a briefing or a coffee.")
  reminded[s]=now
  return
 end
 local training=s.data.training
 if training and training.event and training.event.pending and now-(reminded[s] or -math.huge)&gt;=Assistant.REMIND_EVERY then
  reminded[s]=now
  local def=ModelConfig.getEvent(training.event.id)
  notify(s,rec.name..": The training run needs your decision"..(if def then " ("..def.title..")" else "")..". Open the Lab to choose.")
 end
end
local function attach(p: any,s: any): any
 local office: Model=p.office;local cf: CFrame=p.cframe
 local tierAttr=office:GetAttribute("OfficeTier");local tier: number=if typeof(tierAttr)=="number" then tierAttr else Plan.tierForOffice(s.data.empire.office)
 local folder: Instance?=office:FindFirstChild("Assistant")
 if folder then folder:ClearAllChildren() else local created=Instance.new("Folder");created.Name="Assistant";created.Parent=office;folder=created end
 local name,seed=Assistant.identity(s.userId)
 -- a bigger office than last time this session: the briefing warns about the short profit dip (CORE_SPEC 9.5)
 local officeIndex=math.floor(tonumber(s.data.empire.office) or 1)
 local before=seenOffice[s]
 if before and officeIndex&gt;before then
  movedAt[s]=tonumber(s.data.empire.seconds) or 0
  notify(s,name..": Welcome to the new HQ! Profit dips for about 15 minutes while the new people start.")
 end
 seenOffice[s]=officeIndex
 local rec: any={office=office,cf=cf,tier=tier,session=s,plot=p,name=name,seed=seed,state="post",cup=false}
 local home=homeOf(rec)
 local model=Rig.build(folder::Instance,s.userId,INDEX,"marketer",CFrame.new(home),{n=name,s=seed})
 NPC.dress(model,"assistant",Assistant.TITLE,"Talk","assistant",{},Color3.fromRGB(176,140,96))
 rec.model=model;rec.e=NPC.record(model,"assistant",INDEX,tier,cf,office,seed)
 records[office]=rec
 settle(rec)
 return rec
end
local function drop(rec: any)
 mover.cancel(rec.e)
 if rec.paid then Economy.grant(rec.session,rec.paid,"campus");rec.paid=nil end
 if rec.model.Parent then rec.model:Destroy() end
 if records[rec.office]==rec then records[rec.office]=nil end
end
function Assistant.recordFor(s: any): any
 for _,rec in records do if rec.session==s then return rec end end
 return nil
end

-- Actions -------------------------------------------------------------------------------------------
function Assistant.payload(s: any): any
 local rec=Assistant.recordFor(s)
 local brief=Assistant.briefing(s,if rec then rec.name else nil)
 local def=CampusConfig.find(CampusConfig.SNACKS,"coffee")
 local cooldown=math.max(0,(orders[s] or -math.huge)+Assistant.COFFEE_COOLDOWN-clock())
 brief.coffee={price=def.price,cooldown=math.ceil(cooldown),state=if rec then rec.state else "absent",carrying=rec~=nil and rec.cup==true}
 brief.seed=if rec then rec.seed else select(2,Assistant.identity(s.userId))
 return brief
end
-- (ok, error code)
function Assistant.order(s: any): (boolean,string?)
 local rec=Assistant.recordFor(s)
 if not rec then return false,"NO_ASSISTANT" end
 if rec.cup or not (rec.state=="post" or rec.state=="toPost" or rec.state=="retryHome") then return false,"ASSISTANT_BUSY" end
 if (orders[s] or -math.huge)+Assistant.COFFEE_COOLDOWN&gt;clock() then return false,"COFFEE_COOLDOWN" end
 local def=CampusConfig.find(CampusConfig.SNACKS,"coffee")
 local total=0;for _,n in s.data.empire.campus.snacks do total+=n end
 if total&gt;=16 then return false,"SNACK_FULL" end
 if not Economy.spend(s,def.price,"campus") then notify(s,rec.name..": The company account can't cover a coffee right now.");return false,"NO_MONEY" end
 orders[s]=clock();rec.paid=def.price
 leavePost(rec)
 fetchCoffee(rec,false)
 return true,nil
end
local function act(s: any,p: any): any
 if p.action=="coffee" then
  local ok,err=Assistant.order(s)
  return {ok=ok,err=err,assistant=Assistant.payload(s)}
 elseif p.action=="brief" then
  return {ok=true,assistant=Assistant.payload(s)}
 end
 return {ok=false,err="BAD_INPUT"}
end
Assistant._act=act -- tests
local function onPrompt(q: ProximityPrompt,player: Player)
 if q:GetAttribute("PeopleAction")~="assistant" or q:GetAttribute("OwnerUserId")~=player.UserId then return end
 local s=Session.get(player);if not s or s.closed then return end
 local rec=Assistant.recordFor(s);local root=founderRoot(rec or {session=s})
 if not rec or not root or (root.Position-rec.e.root.Position).Magnitude&gt;12 then return end
 if rec.cup and (rec.state=="waitCup" or rec.state=="post" or rec.state=="toPost" or rec.state=="toFounder") then handover(rec) end
 Remote.fire(player,"Notify","ASSISTANT_OPEN",Assistant.payload(s))
end
Assistant._prompt=onPrompt -- tests

-- Ticks ---------------------------------------------------------------------------------------------
local function step(rec: any,now: number)
 local e=rec.e
 e.now=now
 mover.tick(e,now)
 NPC.holdDoors(e,now)
 if rec.state=="brewing" then
  if now&gt;=rec.brewUntil then finishBrew(rec) end
 elseif rec.state=="toFounder" then chase(rec,now)
 elseif rec.state=="retryHome" and now&gt;=(rec.retryAt or 0) then goHome(rec) end
 proactive(rec,now)
end
function Assistant.tick(dt: number)
 local now=clock()
 scanClock+=dt
 if scanClock&gt;=1 then
  scanClock=0
  for office,rec in records do
   if not office.Parent or rec.session.closed or not rec.model.Parent or not rec.e.root.Parent then drop(rec) end
  end
  for _,p in Plot.all() do
   if p.office and p.owner then
    local s=Session.get(p.owner)
    if s and not s.closed and not records[p.office] and now&gt;=(failed[p.office] or -math.huge) then
     local ok,err=pcall(attach,p,s)
     if not ok then failed[p.office]=now+30;warn("[Assistant] could not place the assistant: "..tostring(err)) end
    end
   end
  end
 end
 for _,rec in records do step(rec,now) end
end
function Assistant.init()
 Remote.bind("AssistantAction",{burst=3,perSecond=1,company=true},act)
 Prompts.PromptTriggered:Connect(onPrompt)
 Session.onClosing(function(s)
  for _,rec in records do if rec.session==s then drop(rec) end end
 end)
end
return Assistant
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000017"><Properties><string name="Name">CityBuilder</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Builds the shared world described by CityPlan ONCE per server (CityService.init): the ring-road
-- extensions and Central Avenue, Business City (streets, 14 client offices, City Hotel, convention centre,
-- City Plaza, park, background blocks), City Airport (AirportBuilder: terminal inside and out, forecourt, car
-- park, apron with three parked aircraft and jet bridges, taxiway, runway, tower, hangar, perimeter and
-- horizon), the harbour, and Port Meridian far to the south (MetroBuilder).
-- Budgets per zone (tests/world): downtown &lt;= 3,000 parts, airport &lt;= 7,000 (terminal interior &lt;= 3,500),
-- Port Meridian &lt;= 20,000; real PointLights &lt;= 40 per zone (buildings first, then the airport, then street
-- lamps; further lamps keep a neon head only). Decorative parts never collide, touch or take spatial queries;
-- every walkable top is supported by the zone ground (no holes).
-- Streaming (Workspace streaming properties are NotScriptable; pack.py sets StreamingEnabled, MinRadius 128,
-- TargetRadius 512, ModelStreamingBehavior Improved, StreamOutBehavior Opportunistic, StreamingIntegrityMode
-- MinimumRadiusPause):
--   * every building interior is an Atomic model - it streams in and out as one piece, never half a room;
--   * the shells of the tall downtown towers, the City Hotel and the control tower are Persistent so the
--     skyline shows from the campus beyond the 512-stud radius (~7 models, ~300 parts on every client -
--     negligible next to one plot's 13-25k parts); everything else streams normally.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local City=require(ReplicatedStorage.Shared.Config.CityPlan)
local P=require(ReplicatedStorage.Shared.Config.ArchPalette)
local Metro=require(script.Parent.MetroBuilder)
local Airport=require(script.Parent.AirportBuilder)
local Builder={}
local G=City.GROUND
local LIGHT_BUDGET=40 -- real lights per zone
local lights: {[string]: number}={}
Builder.lights=lights
local C=P.color
local LAWN=Color3.fromRGB(104,134,94)
local BASE_STONE=Color3.fromRGB(186,188,169)
local WHITE=Color3.fromRGB(229,223,199)
local YELLOW=Color3.fromRGB(222,184,82)
local GLOW=Color3.fromRGB(238,220,184)

------------------------------------------------------------------------------------------------ helpers
local function mk(parent: Instance,name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?,decor: boolean?): Part
	local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
	p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	if decor then p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false end
	p.Parent=parent;return p
end
-- world axis-aligned box from its extents
local function box(parent: Instance,name: string,x1: number,x2: number,y1: number,y2: number,z1: number,z2: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	return mk(parent,name,Vector3.new(x2-x1,y2-y1,z2-z1),CFrame.new((x1+x2)/2,(y1+y2)/2,(z1+z2)/2),color,material,decor)
end
-- box in a building frame (local extents)
local function lbox(f: CFrame,parent: Instance,name: string,x1: number,x2: number,y1: number,y2: number,z1: number,z2: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	return mk(parent,name,Vector3.new(x2-x1,y2-y1,z2-z1),f*CFrame.new((x1+x2)/2,(y1+y2)/2,(z1+z2)/2),color,material,decor)
end
local function glass(p: Part,t: number?): Part p.Material=Enum.Material.Glass;p.Transparency=t or .45;return p end
local function invisible(p: Part): Part p.Transparency=1;p.CastShadow=false;return p end
local function folder(parent: Instance,name: string,mode: Enum.ModelStreamingMode?): Model
	local m=Instance.new("Model");m.Name=name
	if mode then m.ModelStreamingMode=mode end
	m.Parent=parent;return m
end
-- A real PointLight while the zone has budget left; the part stays a neon head either way.
local function light(p: BasePart,range: number,brightness: number,color: Color3?): boolean
	local zone=City.zoneAt(p.Position) or "none"
	if zone=="district" or (lights[zone] or 0)&gt;=LIGHT_BUDGET then return false end
	lights[zone]=(lights[zone] or 0)+1
	local l=Instance.new("PointLight");l.Range=range;l.Brightness=brightness;l.Color=color or GLOW;l.Shadows=false;l.Parent=p
	return true
end
local function sign(p: BasePart,text: string,face: Enum.NormalId?,ink: Color3?,size: Vector2?): TextLabel
	local g=Instance.new("SurfaceGui");g.Face=face or Enum.NormalId.Front;g.LightInfluence=.3
	-- uniform pixels per stud of the face (long signs were squashed); TextScaled caps at 100 px, so big signs
	-- get fewer pixels per stud and the text can fill them
	local f=face or Enum.NormalId.Front
	local w,h=p.Size.X,p.Size.Y
	if f==Enum.NormalId.Left or f==Enum.NormalId.Right then w=p.Size.Z elseif f==Enum.NormalId.Top or f==Enum.NormalId.Bottom then h=p.Size.Z end
	local lines=#string.split(text,"\n")
	local pps=math.max(4,math.min(40,1600/w,900/h,100/math.max(.1,h/lines)))
	g.CanvasSize=size or Vector2.new(w*pps,h*pps);g.Parent=p
	local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1);t.Text=text;t.TextScaled=true;t.TextWrapped=true
	t.Font=Enum.Font.BuilderSansBold;t.TextColor3=ink or Color3.fromRGB(240,238,228);t.Parent=g
	return t
end
local function prompt(p: BasePart,action: string,object: string,distance: number,hold: number): ProximityPrompt
	local q=Instance.new("ProximityPrompt");q.ActionText=action;q.ObjectText=object;q.MaxActivationDistance=distance;q.HoldDuration=hold
	q.RequiresLineOfSight=false;q:SetAttribute("Public",true);q.Parent=p
	return q
end
-- Info kiosk with a GPS prompt (TravelController draws the route to `to`).
-- face: -1 = screen towards -Z, +1 = towards +Z
local function kiosk(parent: Instance,x: number,z: number,top: number,face: number,to: string,label: string)
	local k=box(parent,"InfoKiosk",x-1.5,x+1.5,top,top+5,z-1,z+1,C.metal,Enum.Material.Metal)
	local sz=z+face*1.1
	local screen=box(parent,"InfoKioskScreen",x-1.3,x+1.3,top+2.6,top+4.8,sz-.05,sz+.05,C.screen,nil,true)
	sign(screen,"i  GPS\n"..label,if face&lt;0 then Enum.NormalId.Front else Enum.NormalId.Back,Color3.fromRGB(150,210,190))
	local q=prompt(k,"Show route",label,10,0);q:SetAttribute("CityAction","navigate");q:SetAttribute("To",to)
end
local function tree(parent: Instance,x: number,z: number,k: number,top: number?)
	local h=9+(k%3)*1.5;local base=top or G
	mk(parent,"Tree",Vector3.new(1.2,h,1.2),CFrame.new(x,base+h/2,z),C.oak,Enum.Material.Wood)
	local d=9+(k%4)
	local canopy=mk(parent,"TreeCanopy",Vector3.new(d,d*.8,d),CFrame.new(x,base+h+d*.25,z),if k%2==0 then C.foliage else C.foliageLight,Enum.Material.LeafyGrass,true)
	canopy.Shape=Enum.PartType.Ball
end
local function lamp(parent: Instance,x: number,z: number,lit: boolean,top: number?)
	local base=top or City.WALK_TOP
	mk(parent,"StreetLamp",Vector3.new(.5,12,.5),CFrame.new(x,base+6,z),C.metal,Enum.Material.Metal)
	local head=mk(parent,"StreetLampHead",Vector3.new(2.2,.4,2.2),CFrame.new(x,base+12.2,z),GLOW,Enum.Material.Neon,true)
	if lit then light(head,28,.75) end
end
local function hash(s: string): number
	local h=7
	for i=1,#s do h=(h*31+string.byte(s,i))%2147483647 end
	return h
end

------------------------------------------------------------------------------------------------ roads
-- Positions along road r where other roads cross it (centre, half width incl. sidewalks).
local function crossings(r: City.Road): {{number}}
	local out: {{number}}={}
	for _,o in City.ROADS do
		if o~=r and o.axis~=r.axis and o.c&gt;=r.a1-1 and o.c&lt;=r.a2+1 and r.c&gt;=o.a1-1 and r.c&lt;=o.a2+1 then
			table.insert(out,{o.c,o.width/2+o.walk})
		end
	end
	table.sort(out,function(a,b) return a[1]&lt;b[1] end)
	return out
end
-- [a1,a2] minus the crossing gaps (each gap widened by `pad`)
local function spans(a1: number,a2: number,gaps: {{number}},pad: number): {{number}}
	local out: {{number}}={};local cur=a1
	for _,g in gaps do
		local g1,g2=g[1]-g[2]-pad,g[1]+g[2]+pad
		if g2&gt;cur and g1&lt;a2 then
			if g1&gt;cur+1 then table.insert(out,{cur,g1}) end
			cur=math.max(cur,g2)
		end
	end
	if a2&gt;cur+1 then table.insert(out,{cur,a2}) end
	return out
end
local function strip(parent: Instance,name: string,r: City.Road,a1: number,a2: number,off: number,w: number,y1: number,y2: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	if r.axis=="x" then return box(parent,name,a1,a2,y1,y2,r.c+off-w/2,r.c+off+w/2,color,material,decor) end
	return box(parent,name,r.c+off-w/2,r.c+off+w/2,y1,y2,a1,a2,color,material,decor)
end
local function roads(root: Instance)
	local m=folder(root,"Roads")
	for _,r in City.ROADS do
		local ring=r.walk==0
		strip(m,"CityRoad",r,r.a1,r.a2,0,r.width,G+.02,City.ROAD_TOP,C.asphalt,Enum.Material.Asphalt)
		local gaps=crossings(r)
		-- centre line, interrupted at the crossings
		for _,s in spans(r.a1,r.a2,gaps,2) do
			strip(m,"CentreLine",r,s[1],s[2],0,.35,City.ROAD_TOP,City.ROAD_TOP+.03,if ring then YELLOW else WHITE,nil,true)
		end
		if r.walk&gt;0 then
			-- sidewalks on both sides, open where another street crosses
			for _,side in {-1,1} do
				for _,s in spans(r.a1,r.a2,gaps,0) do
					strip(m,"Sidewalk",r,s[1],s[2],side*(r.width/2+r.walk/2),r.walk,G-.175,City.WALK_TOP,BASE_STONE,Enum.Material.Concrete)
				end
			end
			-- street lamps on alternating sides every 160 studs (not on a crossing)
			local n=0
			for a=r.a1+80,r.a2-40,160 do
				local free=true
				for _,g in gaps do if math.abs(a-g[1])&lt;g[2]+10 then free=false end end
				if free then
					n+=1
					local side=if n%2==0 then 1 else -1
					local off=side*(r.width/2+r.walk-1.5)
					if r.axis=="x" then lamp(m,a,r.c+off,n%2==1) else lamp(m,r.c+off,a,n%2==1) end
				end
			end
		else
			-- ring roads: lamps outside the outer edge, neon heads only
			for a=r.a1+300,r.a2-60,240 do
				local x=r.c+(if r.c&lt;0 then -1 else 1)*(r.width/2+3)
				if a&gt;800 then lamp(m,x,a,false,G) end
			end
		end
	end
	-- raised crossings where the new roads meet the South Boulevard's outer sidewalk (z 542..550)
	for _,x in {-1008,0,1008} do
		local hw=if x==0 then 20 else 16
		box(m,"RoadCrossing",x-hw,x+hw,G+.3,City.WALK_TOP+.03,541,551,C.asphalt,Enum.Material.Asphalt)
		for i=-3,3 do box(m,"Zebra",x+i*4-1,x+i*4+1,City.WALK_TOP+.03,City.WALK_TOP+.06,542,550,WHITE,nil,true) end
	end
	-- signposts at the entrances from the district
	local post=box(m,"CitySignPost",30,31,G,G+14,560,561,C.metal,Enum.Material.Metal)
	local board=box(m,"CitySign",24,38,G+8,G+14,559.4,560,Color3.fromRGB(43,51,47),Enum.Material.Metal,true)
	sign(board,"↓ BUSINESS CITY · AIRPORT",Enum.NormalId.Front)
	local _=post
	for _,x in {-1046,1046} do
		box(m,"CitySignPost",x-.5,x+.5,G,G+14,600,601,C.metal,Enum.Material.Metal)
		local b2=box(m,"CitySign",x-7,x+7,G+8,G+14,599.4,600,Color3.fromRGB(43,51,47),Enum.Material.Metal,true)
		sign(b2,"↓ BUSINESS CITY · AIRPORT",Enum.NormalId.Front)
	end
end

------------------------------------------------------------------------------------------------ ground
local function ground(root: Instance)
	local m=folder(root,"Ground")
	-- downtown + airport: stone base with a lawn skin, four pieces (parts stay &lt;= 2048)
	for _,x in {{-1150,0},{0,1150}} do
		for _,z in {{800,2000},{2000,3200}} do
			box(m,"CityGround",x[1],x[2],-2,G,z[1],z[2],BASE_STONE,Enum.Material.Concrete)
			box(m,"CityLawn",x[1],x[2],G,G+.1,z[1],z[2],LAWN,Enum.Material.Grass)
		end
	end
	-- harbour: quay wall, railing, water, and invisible walls along the edges of the south strip
	for _,x in {{-1150,0},{0,1150}} do
		box(m,"Quay",x[1],x[2],-2,G+.6,3200,3206,C.stoneDeep,Enum.Material.Limestone)
		box(m,"QuayRailing",x[1],x[2],G+.6,G+3.8,3203.6,3204.2,C.metal,Enum.Material.Metal,true)
		glass(box(m,"Sea",x[1],x[2],G-3.2,G-3,3206,3800,C.water,nil,true),.15)
		invisible(box(m,"BoundaryWall",x[1],x[2],G,G+80,3206,3210,C.white))
	end
	for _,x in {-1154,1150} do
		for _,z in {{800,2000},{2000,3210}} do invisible(box(m,"BoundaryWall",x,x+4,G,G+80,z[1],z[2],C.white)) end
	end
end

------------------------------------------------------------------------------------------------ buildings
type Style={core: Color3,coreMat: Enum.Material,coreT: number,band: Color3?,bandMat: Enum.Material?,bandT: number?,trim: Color3}
local STYLES: {[string]: Style}={
	glass={core=C.glassDeep,coreMat=Enum.Material.Glass,coreT=0,trim=C.stoneDeep},
	stone={core=C.stone,coreMat=Enum.Material.Limestone,coreT=0,band=Color3.fromRGB(70,82,92),bandMat=Enum.Material.Glass,bandT=.15,trim=C.stoneDeep},
	brick={core=C.terracotta,coreMat=Enum.Material.Brick,coreT=0,band=Color3.fromRGB(64,74,82),bandMat=Enum.Material.Glass,bandT=.2,trim=C.stone},
	ribbon={core=C.white,coreMat=Enum.Material.Plaster,coreT=0,band=Color3.fromRGB(52,60,70),bandMat=Enum.Material.Glass,bandT=.1,trim=C.metalSoft},
	fins={core=C.blueSoft,coreMat=Enum.Material.Glass,coreT=0,trim=C.stone},
	setback={core=C.stone,coreMat=Enum.Material.Limestone,coreT=0,band=Color3.fromRGB(60,72,84),bandMat=Enum.Material.Glass,bandT=.15,trim=C.stoneDeep},
	hotel={core=C.fabricSand,coreMat=Enum.Material.Plaster,coreT=0,band=Color3.fromRGB(58,64,72),bandMat=Enum.Material.Glass,bandT=.1,trim=C.brass},
}
-- Upper floors: facade only (the ground-floor ceiling closes the volume; nothing above it is enterable).
local function shellUpper(f: CFrame,m: Instance,b: City.Building,base: number,top: number,fh: number)
	local hw,d=b.width/2,b.depth;local st=STYLES[b.style] or STYLES.stone
	local floors=math.max(1,math.floor((top-base)/fh+.5))
	local coreTop=top
	if b.style=="setback" and floors&gt;=4 then
		coreTop=base+(floors-2)*fh
		local inset=8
		glass(lbox(f,m,"UpperVolume",-hw+inset,hw-inset,coreTop+1,top,inset,d-inset,C.glassDeep:Lerp(b.accent,.12),nil),0).Material=Enum.Material.Glass
		lbox(f,m,"Terrace",-hw,hw,coreTop,coreTop+1,0,d,st.trim,Enum.Material.Limestone)
		glass(lbox(f,m,"TerraceRail",-hw,hw,coreTop+1,coreTop+3.6,-.1,.3,C.glass,nil,true),.5)
	end
	local core=lbox(f,m,"Volume",-hw+.5,hw-.5,base,coreTop,.5,d-.5,if b.style=="glass" then st.core:Lerp(b.accent,.15) else st.core,st.coreMat)
	core.Transparency=st.coreT
	local n=math.max(1,math.floor((coreTop-base)/fh+.5))
	if b.style=="glass" then
		for k=1,n-1 do lbox(f,m,"FloorBand",-hw-.3,hw+.3,base+k*fh-.4,base+k*fh+.4,-.3,d+.3,st.trim,Enum.Material.Limestone,true) end
		for i=-2,3 do lbox(f,m,"Fin",i*10-5.6,i*10-4.4,base,coreTop,-1.2,0,C.metal,Enum.Material.Metal,true) end
	elseif b.style=="fins" then
		for i=-3,3 do lbox(f,m,"Fin",i*8.4-.6,i*8.4+.6,base,coreTop,-1.4,0,st.trim,Enum.Material.Limestone,true) end
		for _,x in {-hw,hw-1.4} do for j=1,3 do lbox(f,m,"Fin",x,x+1.4,base,coreTop,j*d/4-.6,j*d/4+.6,st.trim,Enum.Material.Limestone,true) end end
	elseif b.style=="brick" then
		for i=-2,2 do
			local x=i*10.5
			glass(lbox(f,m,"WindowColumn",x-2.6,x+2.6,base+2,coreTop-2,-.2,d+.2,st.band or C.metal,nil,true),st.bandT or .2)
		end
		for k=1,n-1 do lbox(f,m,"FloorBand",-hw-.2,hw+.2,base+k*fh-.35,base+k*fh+.35,-.25,d+.25,st.trim,Enum.Material.Limestone,true) end
	else
		-- stone / ribbon / setback / hotel: one glass ribbon per floor wrapping all four sides
		for k=1,n do
			local y=base+(k-1)*fh
			local ribbon=lbox(f,m,"WindowRibbon",-hw-.1,hw+.1,y+2.5,y+fh-2.5,-.1,d+.1,st.band or C.metal,st.bandMat or Enum.Material.Glass,true)
			ribbon.Transparency=st.bandT or .15
		end
		if b.style=="stone" or b.style=="setback" then
			for _,c in {{-hw-.4,-hw+1.6,-.4,1.6},{hw-1.6,hw+.4,-.4,1.6},{-hw-.4,-hw+1.6,d-1.6,d+.4},{hw-1.6,hw+.4,d-1.6,d+.4}} do
				lbox(f,m,"Pilaster",c[1],c[2],base,coreTop,c[3],c[4],st.trim,Enum.Material.Limestone,true)
			end
		elseif b.style=="ribbon" then
			lbox(f,m,"AccentStripe",hw-6,hw-2,base,coreTop,-.5,.2,b.accent,nil,true)
		end
	end
	-- roof: cap, accent crown, plant room
	lbox(f,m,"Roof",-hw-.3,hw+.3,top,top+1.2,-.3,d+.3,st.trim,Enum.Material.Limestone)
	lbox(f,m,"Crown",-hw-.2,hw+.2,top-1.6,top,-.2,d+.2,b.accent,nil,true)
	lbox(f,m,"PlantRoom",-hw*.4,hw*.3,top+1.2,top+4.6,d*.45,d*.8,C.metalSoft,Enum.Material.Metal,true)
end
local function officeInterior(f: CFrame,m: Instance,b: City.Building,l: City.Layout,gf: number)
	local name=b.name
	-- reception desk, logo wall, receptionist post (placeholder: the later staff package puts an NPC here)
	lbox(f,m,"ReceptionDesk",-8,8,.5,4,21.5,23.5,C.oak,Enum.Material.Wood)
	lbox(f,m,"ReceptionTop",-8.5,8.5,4,4.4,21.2,24,C.stone,Enum.Material.Limestone)
	local wall=lbox(f,m,"LogoWall",-10,10,.5,13,33,34,b.accent:Lerp(C.metal,.35),Enum.Material.SmoothPlastic)
	sign(wall,name,Enum.NormalId.Front)
	local post=invisible(mk(m,"ReceptionistPost",Vector3.new(2,5,1),f*CFrame.new(l.reception),C.white,nil,true))
	post:SetAttribute("CityPost","reception");post:SetAttribute("BuildingId",b.id)
	if b.clientId then post:SetAttribute("ClientId",b.clientId) end
	-- waiting area
	lbox(f,m,"Sofa",-27,-17,.5,2.6,8,12,C.fabric,Enum.Material.Fabric)
	lbox(f,m,"SofaBack",-27,-17,2.6,5,11,12,C.fabric,Enum.Material.Fabric,true)
	lbox(f,m,"CoffeeTable",-25,-19,.5,1.9,3.5,6.5,C.oakDark,Enum.Material.Wood)
	lbox(f,m,"Planter",-27,-24,.5,3,27,30,C.terracotta,Enum.Material.Slate)
	local leaf=lbox(f,m,"PlantLeaves",-28,-23,3,8,26,31,C.foliage,Enum.Material.LeafyGrass,true);leaf.Shape=Enum.PartType.Ball
	light(lbox(f,m,"CeilingLight",-6,6,gf-.4,gf,8,20,C.lightWarm,Enum.Material.Neon,true),30,.9,C.lightWarm)
	-- meeting room (glass partitions; door gap x 12..18)
	local r=l.meetingRoom
	if r then
		glass(lbox(f,m,"MeetingGlass",r.x1,12,.5,gf,r.z1,r.z1+.6,C.glass))
		glass(lbox(f,m,"MeetingGlass",18,r.x2,.5,gf,r.z1,r.z1+.6,C.glass))
		lbox(f,m,"MeetingLintel",12,18,11,gf,r.z1,r.z1+.6,C.stone,Enum.Material.Limestone)
		glass(lbox(f,m,"MeetingGlass",r.x1,r.x1+.6,.5,gf,r.z1+.6,r.z2,C.glass))
		local tableTop=lbox(f,m,"MeetingTable",12,23,.5,3.2,46,53,C.oak,Enum.Material.Wood)
		local q=prompt(tableTop,"Start meeting",name,10,.5)
		q:SetAttribute("CityAction","meeting");q:SetAttribute("BuildingId",b.id)
		if b.clientId then q:SetAttribute("ClientId",b.clientId);tableTop:SetAttribute("ClientId",b.clientId) end
		for _,x in {14,17.5,21} do
			for _,z in {44.6,54.4} do lbox(f,m,"MeetingChair",x-1,x+1,.5,2.4,z-1,z+1,C.fabricCharcoal,Enum.Material.Fabric,true) end
		end
		local screen=lbox(f,m,"MeetingScreen",11,24,5,11,58.4,59,C.screen,Enum.Material.SmoothPlastic,true)
		sign(screen,name.."\nMeeting room",Enum.NormalId.Front,Color3.fromRGB(200,214,220))
		lbox(f,m,"MeetingLightPanel",12,23,gf-.4,gf,45,54,C.lightNeutral,Enum.Material.Neon,true)
	end
end
local function hotelInterior(f: CFrame,m: Instance,b: City.Building,l: City.Layout,gf: number)
	local hw,d=b.width/2,b.depth
	local dz=l.desk.Z
	lbox(f,m,"ReceptionDesk",-12,12,.5,4,dz-1.5,dz+1.5,C.oakDark,Enum.Material.Wood)
	lbox(f,m,"ReceptionTop",-12.5,12.5,4,4.4,dz-1.8,dz+1.8,C.stone,Enum.Material.Marble)
	local wall=lbox(f,m,"LogoWall",-16,16,.5,13,dz+10,dz+11,C.brass:Lerp(C.oakDark,.4),Enum.Material.Wood)
	sign(wall,string.upper(b.name).."\nReception",Enum.NormalId.Front)
	local post=invisible(mk(m,"ReceptionistPost",Vector3.new(2,5,1),f*CFrame.new(l.reception),C.white,nil,true))
	post:SetAttribute("CityPost","hotel_reception");post:SetAttribute("BuildingId",b.id)
	-- lounge
	for i,x in {-hw+6,-hw+20} do
		lbox(f,m,"LoungeSofa",x,x+10,.5,2.6,14,18,C.fabricBlue,Enum.Material.Fabric)
		lbox(f,m,"LoungeSofaBack",x,x+10,2.6,5,17,18,C.fabricBlue,Enum.Material.Fabric,true)
		local _=i
	end
	lbox(f,m,"LoungeTable",-hw+10,-hw+26,.5,1.9,8,12,C.oak,Enum.Material.Wood)
	for _,x in {hw-14,hw-24} do lbox(f,m,"Armchair",x,x+5,.5,2.8,16,21,C.leather,Enum.Material.Leather) end
	for _,x in {-hw+4,hw-7} do
		lbox(f,m,"Planter",x,x+3,.5,3,d-12,d-9,C.terracotta,Enum.Material.Slate)
		local leaf=lbox(f,m,"PlantLeaves",x-1,x+4,3,8,d-13,d-8,C.foliage,Enum.Material.LeafyGrass,true);leaf.Shape=Enum.PartType.Ball
	end
	-- lift doors to the (abstract) room floors, and a direction sign
	for _,x in {-14,-2,10} do lbox(f,m,"LiftFront",x,x+4.6,.5,11,d-1.25,d-1,C.metalSoft,Enum.Material.Metal,true) end
	local info=lbox(f,m,"FloorSign",-14,14.6,11.6,13.6,d-1.3,d-1.1,C.metal,Enum.Material.Metal,true)
	sign(info,"Lifts · Rooms 101–"..tostring(100*(b.floors-1)+12),Enum.NormalId.Front)
	light(lbox(f,m,"CeilingLight",-10,10,gf-.4,gf,10,30,C.lightWarm,Enum.Material.Neon,true),36,.9,C.lightWarm)
	light(lbox(f,m,"CeilingLight",-10,10,gf-.4,gf,d-34,d-14,C.lightWarm,Enum.Material.Neon,true),36,.8,C.lightWarm)
end
-- Office / hotel / tower: enterable ground floor (lobby + reception + meeting room or lounge), facade above.
function Builder.building(parent: Instance,b: City.Building): Model
	local f=b.frame;local hw,d=b.width/2,b.depth
	local l=City.layout(b)
	local gf=City.OFFICE.groundHeight
	local fh=if b.interior=="hotel" then 12 else City.OFFICE.floorHeight
	local base=gf+1;local top=base+(b.floors-1)*fh
	local m=Instance.new("Model");m.Name=(if b.kind=="hotel" then "Hotel_" elseif b.kind=="tower" then "ClientTower_" else "ClientOffice_")..b.id
	m:SetAttribute("BuildingId",b.id);m:SetAttribute("Zone",b.zone)
	if b.clientId then m:SetAttribute("ClientId",b.clientId) end
	local shell=folder(m,"Shell",if b.skyline then Enum.ModelStreamingMode.Persistent else nil)
	local inside=folder(m,"Interior",Enum.ModelStreamingMode.Atomic)
	local dw=if b.interior=="hotel" then 14 else City.OFFICE.doorWidth
	-- ground floor shell
	lbox(f,shell,"Floor",-hw,hw,0,.5,0,d,C.stone,Enum.Material.Limestone)
	glass(lbox(f,shell,"Storefront",-hw,-dw/2,.5,gf,0,.8,C.glass))
	glass(lbox(f,shell,"Storefront",dw/2,hw,.5,gf,0,.8,C.glass))
	lbox(f,shell,"EntranceLintel",-dw/2,dw/2,11,gf,0,.8,C.stoneDeep,Enum.Material.Limestone)
	for x=-hw+10,hw-10,10 do
		if math.abs(x)&gt;dw/2+.5 then lbox(f,shell,"Mullion",x-.2,x+.2,.5,gf,-.2,.9,C.metal,Enum.Material.Metal,true) end
	end
	lbox(f,shell,"SideWall",-hw,-hw+1,.5,gf,.8,d,C.stone,Enum.Material.Limestone)
	lbox(f,shell,"SideWall",hw-1,hw,.5,gf,.8,d,C.stone,Enum.Material.Limestone)
	lbox(f,shell,"BackWall",-hw+1,hw-1,.5,gf,d-1,d,C.stone,Enum.Material.Limestone)
	lbox(f,shell,"Ceiling",-hw,hw,gf,base,0,d,C.stoneDeep,Enum.Material.Limestone)
	shellUpper(f,shell,b,base,top,fh)
	-- entrance canopy and the company sign
	lbox(f,shell,"Canopy",-dw/2-3,dw/2+3,11.2,11.8,-6,0,b.accent,Enum.Material.Metal,true)
	local plate=lbox(f,shell,"CompanySign",-14,14,12.4,15.4,-.7,-.1,C.metal,Enum.Material.Metal,true)
	sign(plate,b.name,Enum.NormalId.Front)
	if b.skyline or b.kind=="tower" then
		local roofSign=lbox(f,shell,"RoofSign",-hw+6,hw-6,top+1.2,top+7,.4,1,C.metal,Enum.Material.Metal,true)
		sign(roofSign,string.upper(b.name),Enum.NormalId.Front,b.accent:Lerp(Color3.new(1,1,1),.55))
	end
	-- forecourt: visitor parking (downtown) or paving (abroad)
	local pd=City.OFFICE.parkingDepth
	if b.parking then
		local lot=lbox(f,shell,"VisitorParking",-hw,hw,-.05,.3,-pd,0,C.asphalt,Enum.Material.Asphalt);lot:SetAttribute("VisitorBays",#l.bays)
		lbox(f,shell,"Walkway",-dw/2-1,dw/2+1,.3,.34,-pd,0,C.stonePave,Enum.Material.Pavement,true)
		local edges: {number}={}
		for _,x in l.bays do
			for _,e in {x-5,x+5} do if not table.find(edges,e) then table.insert(edges,e) end end
		end
		table.sort(edges)
		for _,x in edges do lbox(f,shell,"BayLine",x-.15,x+.15,.3,.33,-pd+1,-1,WHITE,nil,true) end
		local visitor=lbox(f,shell,"VisitorSign",-hw+1,-hw+5,.3,3.3,-1.4,-1.2,Color3.fromRGB(58,88,140),nil,true)
		sign(visitor,"P\nVISITORS",Enum.NormalId.Front)
	else
		lbox(f,shell,"Forecourt",-hw,hw,-.05,.3,-pd,0,C.stonePave,Enum.Material.Pavement)
	end
	if b.interior=="hotel" then hotelInterior(f,inside,b,l,gf) else officeInterior(f,inside,b,l,gf) end
	m.Parent=parent
	return m
end

------------------------------------------------------------------------------------------------ downtown
local function convention(root: Instance)
	local c=City.CONVENTION;local f=c.frame;local hw,d,h=c.width/2,c.depth,c.height
	local m=Instance.new("Model");m.Name="ConventionCentre";m:SetAttribute("BuildingId","convention")
	local shell=folder(m,"Shell");local inside=folder(m,"Interior",Enum.ModelStreamingMode.Atomic)
	local setback=-f:PointToObjectSpace(Vector3.new(f.Position.X,G,1000)).Z -- street centre in front
	lbox(f,shell,"Forecourt",-hw,hw,-.05,.3,-(setback-28),0,C.stonePave,Enum.Material.Pavement)
	lbox(f,shell,"Floor",-hw,hw,0,.5,0,d,C.stone,Enum.Material.Limestone)
	local doors={-40,0,40}
	local x0=-hw
	for _,x in doors do
		glass(lbox(f,shell,"Facade",x0,x-6,.5,h,0,.8,C.glass))
		lbox(f,shell,"EntranceLintel",x-6,x+6,12,h,0,.8,C.stoneDeep,Enum.Material.Limestone)
		x0=x+6
	end
	glass(lbox(f,shell,"Facade",x0,hw,.5,h,0,.8,C.glass))
	for x=-hw+20,hw-20,20 do
		local free=true;for _,dx in doors do if math.abs(x-dx)&lt;7 then free=false end end
		if free then lbox(f,shell,"Mullion",x-.3,x+.3,.5,h,-.3,.9,C.metal,Enum.Material.Metal,true) end
	end
	lbox(f,shell,"SideWall",-hw,-hw+1.5,.5,h,.8,d,C.stone,Enum.Material.Limestone)
	lbox(f,shell,"SideWall",hw-1.5,hw,.5,h,.8,d,C.stone,Enum.Material.Limestone)
	lbox(f,shell,"BackWall",-hw+1.5,hw-1.5,.5,h,d-1.5,d,C.stone,Enum.Material.Limestone)
	lbox(f,shell,"Roof",-hw-4,hw+4,h,h+2,-8,d+2,C.stoneDeep,Enum.Material.Limestone)
	lbox(f,shell,"RoofCrown",-hw-4.2,hw+4.2,h-1.4,h,-8.2,-7.8,C.sage,nil,true)
	local title=lbox(f,shell,"VenueSign",-36,36,h-7,h-2,-8.6,-8.2,C.metal,Enum.Material.Metal,true)
	sign(title,"CONVENTION CENTRE",Enum.NormalId.Front)
	-- foyer / hall partition with two openings
	local pz=50
	for _,s in {{-hw+1.5,-50},{-38,38},{50,hw-1.5}} do lbox(f,inside,"HallWall",s[1],s[2],.5,h,pz,pz+1,C.interior,Enum.Material.Plaster) end
	for _,x in {-44,44} do lbox(f,inside,"HallLintel",x-6,x+6,12,h,pz,pz+1,C.interior,Enum.Material.Plaster) end
	local expo=lbox(f,inside,"ExpoBanner",-30,30,16,24,pz-.2,pz,C.sage,nil,true)
	sign(expo,"AI EMPIRE EXPO\nBusiness City",Enum.NormalId.Front)
	lbox(f,inside,"InfoDesk",-10,10,.5,4,24,27,C.oak,Enum.Material.Wood)
	-- hall: stage with two steps, screen, seating blocks either side of the centre aisle
	lbox(f,inside,"Stage",-60,60,.5,3.5,150,d-2,C.oakDark,Enum.Material.WoodPlanks)
	lbox(f,inside,"StageStep",-8,8,.5,2,146,150,C.oakDark,Enum.Material.WoodPlanks)
	local screen=lbox(f,inside,"StageScreen",-40,40,8,26,d-3.5,d-2,C.screen,nil,true)
	sign(screen,"AI EMPIRE EXPO",Enum.NormalId.Front,Color3.fromRGB(150,210,190))
	for row=0,5 do
		local z=80+row*10
		for _,s in {{-70,-8},{8,70}} do lbox(f,inside,"SeatRow",s[1],s[2],.5,2.3,z,z+3,C.fabricCharcoal,Enum.Material.Fabric) end
	end
	light(lbox(f,inside,"CeilingLight",-14,14,h-.4,h,18,34,C.lightWarm,Enum.Material.Neon,true),36,.9,C.lightWarm)
	light(lbox(f,inside,"CeilingLight",-30,30,h-.4,h,90,100,C.lightNeutral,Enum.Material.Neon,true),48,.8)
	light(lbox(f,inside,"CeilingLight",-30,30,h-.4,h,130,140,C.lightNeutral,Enum.Material.Neon,true),48,.8)
	m.Parent=root
end
local function plaza(root: Instance)
	local r=City.PLAZA;local m=folder(root,"CityPlaza")
	box(m,"PlazaPaving",r.x1,r.x2,G,G+.3,r.z1,r.z2,C.stonePave,Enum.Material.Pavement)
	local cx,cz=(r.x1+r.x2)/2,(r.z1+r.z2)/2
	local top=G+.3
	-- fountain
	for _,s in {{cx-15,cx+15,cz-15,cz-13},{cx-15,cx+15,cz+13,cz+15},{cx-15,cx-13,cz-13,cz+13},{cx+13,cx+15,cz-13,cz+13}} do
		box(m,"FountainRim",s[1],s[2],top,top+1.4,s[3],s[4],C.stone,Enum.Material.Limestone)
	end
	glass(box(m,"FountainWater",cx-13,cx+13,top,top+.9,cz-13,cz+13,C.water,nil,true),.25)
	box(m,"FountainColumn",cx-2,cx+2,top,top+4,cz-2,cz+2,C.stoneDeep,Enum.Material.Limestone)
	local jet=box(m,"FountainJet",cx-.6,cx+.6,top+4,top+12,cz-.6,cz+.6,Color3.fromRGB(190,226,236),Enum.Material.Neon,true);jet.Transparency=.35
	-- planters with trees, benches, lamps
	local k=0
	for _,x in {r.x1+30,r.x2-30} do
		for _,z in {r.z1+60,cz-80,cz+80,r.z2-40} do
			k+=1
			box(m,"Planter",x-4,x+4,top,top+1.6,z-4,z+4,C.stone,Enum.Material.Limestone)
			tree(m,x,z,k,top+1.6)
		end
	end
	for _,z in {cz-40,cz+40} do
		for _,x in {cx-34,cx+30} do box(m,"Bench",x,x+4,top,top+1.6,z-5,z+5,C.oak,Enum.Material.Wood) end
	end
	for i,p in {{r.x1+8,r.z1+8},{r.x2-8,r.z1+8},{r.x1+8,r.z2-8},{r.x2-8,r.z2-8}} do lamp(m,p[1],p[2],i&lt;=2,top) end
	local plinth=box(m,"MapBoard",cx-10,cx+10,top,top+9,r.z1+14,r.z1+15,Color3.fromRGB(43,51,47),Enum.Material.Metal)
	sign(plinth,"BUSINESS CITY\nParkway · Business Avenue · Harbour Road\nCity Hotel east · Airport south",Enum.NormalId.Front)
	local q=prompt(plinth,"Show route","City Airport",10,0);q:SetAttribute("CityAction","navigate");q:SetAttribute("To","airport")
end
-- Background blocks: solid, not enterable (core + glass skin + roof; tall ones get a setback crown).
local function filler(m: Instance,x: number,z: number,w: number,dd: number,h: number,k: number)
	local tones={C.stone,C.concrete,C.sageLight,C.fabricSand,C.blueSoft,C.white}
	local tone=tones[k%#tones+1]
	local glassy=k%3==0
	box(m,"CityBlock",x-w/2,x+w/2,G,G+h,z-dd/2,z+dd/2,if glassy then C.glassDeep else tone,if glassy then Enum.Material.Glass elseif k%2==0 then Enum.Material.Limestone else Enum.Material.Concrete)
	if not glassy then glass(box(m,"CityBlockWindows",x-w/2-.2,x+w/2+.2,G+6,G+h-3,z-dd/2-.2,z+dd/2+.2,Color3.fromRGB(70,86,98),nil,true),.55) end
	box(m,"CityBlockRoof",x-w/2-.4,x+w/2+.4,G+h,G+h+1,z-dd/2-.4,z+dd/2+.4,C.stoneDeep,Enum.Material.Limestone,true)
	if h&gt;=70 then box(m,"CityBlockCrown",x-w/3,x+w/3,G+h+1,G+h+9,z-dd/3,z+dd/3,if glassy then C.stone else C.glassDeep,if glassy then Enum.Material.Limestone else Enum.Material.Glass,true) end
end
local function overlaps(a: City.Rect,b: City.Rect): boolean return a.x1&lt;b.x2 and a.x2&gt;b.x1 and a.z1&lt;b.z2 and a.z2&gt;b.z1 end
-- World rectangle of a building incl. its forecourt, padded.
local function footprint(b: City.Building,pad: number): City.Rect
	local hw=b.width/2;local r: City.Rect={x1=math.huge,x2=-math.huge,z1=math.huge,z2=-math.huge}
	for _,c in {Vector3.new(-hw,0,-City.OFFICE.parkingDepth),Vector3.new(hw,0,-City.OFFICE.parkingDepth),Vector3.new(-hw,0,b.depth),Vector3.new(hw,0,b.depth)} do
		local w=b.frame:PointToWorldSpace(c)
		r.x1,r.x2,r.z1,r.z2=math.min(r.x1,w.X),math.max(r.x2,w.X),math.min(r.z1,w.Z),math.max(r.z2,w.Z)
	end
	return {x1=r.x1-pad,x2=r.x2+pad,z1=r.z1-pad,z2=r.z2+pad}
end
-- Fill a city block with background buildings on a 92-stud lot grid (26+ stud walkways between them),
-- skipping lots that touch `occupied`; about every sixth lot is a pocket park. Deterministic (hash).
local function fillLots(m: Instance,block: City.Rect,occupied: {City.Rect},seed: string,minH: number,stepH: number)
	local step=92
	local nx,nz=math.floor((block.x2-block.x1)/step),math.floor((block.z2-block.z1)/step)
	local ox=block.x1+((block.x2-block.x1)-nx*step)/2;local oz=block.z1+((block.z2-block.z1)-nz*step)/2
	for i=0,nx-1 do
		for j=0,nz-1 do
			local h=hash(seed..":"..i..":"..j)
			local w,dd=52+(h%3)*8,52+(math.floor(h/3)%3)*8
			local cx,cz=ox+i*step+step/2,oz+j*step+step/2
			local lot: City.Rect={x1=cx-w/2,x2=cx+w/2,z1=cz-dd/2,z2=cz+dd/2}
			local free=true
			for _,o in occupied do if overlaps(lot,o) then free=false;break end end
			if free then
				if h%6==0 then
					box(m,"PocketPark",lot.x1,lot.x2,G+.1,G+.2,lot.z1,lot.z2,LAWN,Enum.Material.Grass)
					for t=0,2 do tree(m,cx+(t-1)*w/3,cz+(if t==1 then dd/4 else -dd/5),h+t,G+.2) end
				else
					filler(m,cx,cz,w,dd,minH+(math.floor(h/9)%7)*stepH,h)
				end
			end
		end
	end
end
local function downtown(root: Instance)
	local m=folder(root,"Downtown")
	local offices=folder(m,"ClientOffices")
	for _,b in City.BUILDINGS do if b.zone=="downtown" then Builder.building(offices,b) end end
	convention(m)
	plaza(m)
	local green=folder(m,"Greenery")
	-- City Park between the campus parkland and the Parkway, with a footpath
	for _,s in {{-990,-28},{28,990}} do box(green,"ParkPath",s[1],s[2],G,G+.15,882,888,C.stonePave,Enum.Material.Pavement) end
	local k=0
	for _,z in {836,930} do
		for x=-950,950,95 do
			k+=1
			local tx=x+((k*37)%30)-15
			if math.abs(tx)&gt;48 and math.abs(tx)&lt;975 then tree(green,tx,z+((k*23)%24)-12,k) end
		end
	end
	-- trees along Airport Road
	for x=-960,960,120 do k+=1;if math.abs(x)&gt;60 then tree(green,x,2330,k) end end
	-- background blocks fill the city blocks around the client offices, the plaza and the convention centre
	local blocks=folder(m,"CityBlocks")
	local occupied: {City.Rect}={}
	for _,b in City.BUILDINGS do if b.zone=="downtown" then table.insert(occupied,footprint(b,10)) end end
	local cv=City.CONVENTION
	table.insert(occupied,{x1=cv.frame.X-cv.width/2-12,x2=cv.frame.X+cv.width/2+12,z1=1028,z2=cv.frame.Z+cv.depth+12})
	local pz=City.PLAZA;table.insert(occupied,{x1=pz.x1-12,x2=pz.x2+12,z1=pz.z1-12,z2=pz.z2+12})
	table.insert(occupied,{x1=-1200,x2=1200,z1=2290,z2=2420}) -- tree row and Airport Road
	local xs={{-992,-368},{-312,-28},{28,312},{368,992}}
	for row,zs in {{1028,1472},{1528,1972}} do
		for col,x in xs do fillLots(blocks,{x1=x[1]+6,x2=x[2]-6,z1=zs[1]+6,z2=zs[2]-6},occupied,"dt"..row..col,30,12) end
	end
	for col,x in {{-992,-28},{28,992}} do fillLots(blocks,{x1=x[1]+6,x2=x[2]-6,z1=2034,z2=2346},occupied,"south"..col,24,10) end
end

------------------------------------------------------------------------------------------------ halls (Port Meridian kit)
-- A glass hall with door openings in the front facade (frontSide -1 = facade at z1, +1 = facade at z2).
local function hall(parent: Instance,r: City.Rect,h: number,frontSide: number,doors: {number},w: number): Model
	local m=folder(parent,"Hall")
	local fz=if frontSide&lt;0 then r.z1 else r.z2-.8
	local bz=if frontSide&lt;0 then r.z2-.8 else r.z1
	box(m,"HallFloor",r.x1,r.x2,G,G+.5,r.z1,r.z2,C.stone,Enum.Material.Limestone)
	local x0=r.x1
	for _,x in doors do
		glass(box(m,"Facade",x0,x-w/2,G+.5,G+h,fz,fz+.8,C.glass))
		box(m,"EntranceLintel",x-w/2,x+w/2,G+12,G+h,fz,fz+.8,C.stoneDeep,Enum.Material.Limestone)
		x0=x+w/2
	end
	glass(box(m,"Facade",x0,r.x2,G+.5,G+h,fz,fz+.8,C.glass))
	glass(box(m,"BackGlass",r.x1,r.x2,G+.5,G+h,bz,bz+.8,C.glass))
	box(m,"SideWall",r.x1,r.x1+1.5,G+.5,G+h,r.z1+.8,r.z2-.8,C.stone,Enum.Material.Limestone)
	box(m,"SideWall",r.x2-1.5,r.x2,G+.5,G+h,r.z1+.8,r.z2-.8,C.stone,Enum.Material.Limestone)
	box(m,"Roof",r.x1-6,r.x2+6,G+h,G+h+2,r.z1-6,r.z2+6,C.stoneDeep,Enum.Material.Limestone)
	box(m,"RoofBand",r.x1-6.2,r.x2+6.2,G+h+.4,G+h+1.6,(if frontSide&lt;0 then r.z1-6.2 else r.z2+5.8),(if frontSide&lt;0 then r.z1-5.8 else r.z2+6.2),C.sage,nil,true)
	for x=r.x1+24,r.x2-24,24 do
		local free=true;for _,dx in doors do if math.abs(x-dx)&lt;w/2+1 then free=false end end
		if free then box(m,"Mullion",x-.3,x+.3,G+.5,G+h,fz-.3,fz+1.1,C.metal,Enum.Material.Metal,true) end
	end
	return m
end
local function checkin(m: Instance,p: Vector3,facing: number,to: string,action: string,object: string)
	-- facing +1: passengers stand at larger z (counter faces +Z); -1: passengers at smaller z
	local z=p.Z
	local counter=box(m,"CheckinCounter",p.X-12,p.X+12,G+.5,G+4.3,z-2,z+2,C.white,Enum.Material.Marble)
	box(m,"BagBelt",p.X+12,p.X+16,G+.5,G+2,z-2,z+2,C.metalSoft,Enum.Material.Metal,true)
	local backZ=z-facing*5
	local panel=box(m,"CheckinPanel",p.X-12,p.X+12,G+.5,G+10,backZ-.5,backZ+.5,Color3.fromRGB(58,88,140),Enum.Material.SmoothPlastic)
	sign(panel,if to=="abroad" then "CHECK-IN\nPort Meridian" else "CHECK-IN\nCity Airport (home)",if facing&lt;0 then Enum.NormalId.Front else Enum.NormalId.Back)
	local q=prompt(counter,action,object,10,1)
	q:SetAttribute("CityAction","checkin");q:SetAttribute("FlightTo",to)
	counter:SetAttribute("CheckinTo",to)
end

------------------------------------------------------------------------------------------------ entry
-- Builds the whole shared world under workspace.WorldCity (replacing an old one) and returns it.
-- ticketText: ObjectText of the home check-in prompts (price from CityPlan.TRAVEL, formatted by CityService).
function Builder.build(ticketText: string?): Model
	local old=workspace:FindFirstChild("WorldCity");if old then old:Destroy() end
	table.clear(lights)
	local root=Instance.new("Model");root.Name="WorldCity"
	ground(root)
	downtown(root) -- buildings take their lights first ...
	Airport.build(root,{light=light,prompt=prompt,kiosk=kiosk,tree=tree,lamp=lamp},ticketText or "Port Meridian") -- City Airport (AirportBuilder)
	Metro.build(root,{folder=folder,box=box,hall=hall,checkin=checkin,kiosk=kiosk,light=light,sign=sign,tree=tree,lamp=lamp,
		footprint=footprint,fillLots=fillLots,glass=glass,invisible=invisible,building=Builder.building}) -- Port Meridian (MetroBuilder)
	roads(root) -- ... street lamps use what is left of each zone's budget
	root.Parent=workspace
	return root
end
return Builder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000018"><Properties><string name="Name">CityService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- CityService: the shared world beyond the campus district and travel through it.
--   * init: CityBuilder builds Business City, the airport and Port Meridian ONCE per server (a failed build
--     is logged and never stops the server); binds TravelAction; meeting prompts (placeholder until the
--     customers package registers a handler); travel state reset on respawn; PlotService away check.
--   * Flights - TravelAction {action="flight", to="abroad"|"home"} at a check-in counter:
--     the ticket is paid at the home check-in (return flight included, price CityPlan.TRAVEL.ticket); the
--     server holds the character (root anchored), asks Roblox to stream the arrival hall to the player
--     (Player:RequestStreamAroundAsync), pivots the character there and answers {seconds}. The client
--     plays its fade + plane cutscene meanwhile; tick() releases the character after `seconds`.
--     States: home -&gt; flying -&gt; abroad -&gt; flying -&gt; home. A respawn or leaving resets to home.
--   * Shuttle (ShuttleService, package "flight"): the scheduled Port Meridian shuttle replaces the cutscene in
--     normal play - TravelAction {action="ticket", to} at a check-in counter (spend once), {action="board"} at
--     the gate during boarding (or automatically at the end of boarding), the ride shown by the client on the
--     client-animated aircraft, server PivotTo at arrival; {action="heli", to="hotel"|"airport"} = VIP
--     helicopter in Port Meridian. Riders are trips with state "flying" (kind "shuttle"/"heli"), so isAway,
--     respawn reset and leaving work the same; ShuttleService.drop refunds an unfinished ride. The instant
--     flight above stays (fallback when the shuttle is off, ShuttleService.setEnabled(false)).
--   * GPS - TravelAction {action="route", to=destinationId|"home"} returns the CityPlan road route from the
--     character to the destination (points + length); City.guide(player, id) asks the client to fetch and
--     draw one (Notify TRAVEL_GUIDE) - for appointments later.
-- Server writes: the Player attribute "TravelState" on each change (nil = home), nothing per frame.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Prompts=game:GetService("ProximityPromptService")
local CityPlan=require(ReplicatedStorage.Shared.Config.CityPlan)
local Format=require(ReplicatedStorage.Shared.Format)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local Plot=require(script.Parent.PlotService)
local Builder=require(script.Parent.CityBuilder)
local Shuttle=require(script.Parent.ShuttleService)
local City={}
-- kind: nil = instant flight / abroad, "shuttle" / "heli" = ShuttleService rides (releaseAt = math.huge: their
-- end is handled by ShuttleService.tick)
type Trip={player: Player,state: string,to: string,character: Model?,root: BasePart?,wasAnchored: boolean,releaseAt: number,kind: string?}
local trips: {[number]: Trip}={}
local clock=0
local meetingHandler: ((Player,string,ProximityPrompt)-&gt;())?=nil
local promptAt: {[Player]: number}={}
City.trips=trips

local function setState(player: Player,state: string)
	player:SetAttribute("TravelState",if state=="home" then nil else state)
end
-- "home", "flying" or "abroad"
function City.state(player: Player): string
	local t=trips[player.UserId]
	return if t then t.state else "home"
end
function City.isAway(player: Player): boolean return City.state(player)~="home" end
function City.ticketText(): string
	return "Port Meridian · "..Format.money(CityPlan.TRAVEL.ticket).." return"
end
local function rootOf(player: Player): (Model?,BasePart?,Humanoid?)
	local character=player.Character
	local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
	if character and root and root:IsA("BasePart") then return character,root,humanoid end
	return nil,nil,nil
end
local function near(p: Vector3,points: {Vector3},radius: number): boolean
	for _,q in points do if CityPlan.flat(p,q)&lt;=radius and math.abs(p.Y-q.Y)&lt;12 then return true end end
	return false
end
local function reset(player: Player)
	Shuttle.drop(player,"respawn") -- an unfinished shuttle / helicopter ride is refunded
	trips[player.UserId]=nil;setState(player,"home")
end

------------------------------------------------------------------------------------------------ flights
function City.flight(s: any,destination: any): {[string]: any}
	local player: Player=s.player
	if destination~="abroad" and destination~="home" then return {ok=false,err="BAD_INPUT"} end
	local to: string=destination
	local state=City.state(player)
	if state=="flying" then return {ok=false,err="BUSY"} end
	local from: {[string]: string}={abroad="home",home="abroad"} -- where a flight to `to` must start
	if state~=from[to] then return {ok=false,err=if to=="abroad" then "ALREADY_ABROAD" else "NOT_ABROAD"} end
	local character,root,humanoid=rootOf(player)
	if not character or not root or not humanoid or humanoid.Health&lt;=0 then return {ok=false,err="LOADING"} end
	if humanoid.SeatPart then return {ok=false,err="LEAVE_VEHICLE"} end
	local counters=if to=="abroad" then CityPlan.AIRPORT.checkin else CityPlan.ABROAD.checkin
	if not near(root.Position,counters,CityPlan.TRAVEL.checkinRadius) then return {ok=false,err="NOT_AT_CHECKIN"} end
	local price=if to=="abroad" then CityPlan.TRAVEL.ticket else 0
	local held=Shuttle.takeTicket(player,to) -- a shuttle ticket already bought for this trip is used instead
	if held then price=0 end
	if not Economy.spend(s,price,"travel") then return {ok=false,err="NO_MONEY"} end -- P&amp;L line "travel"
	local arrival=if to=="abroad" then CityPlan.ABROAD.arrival else CityPlan.AIRPORT.arrival
	local trip: Trip={player=player,state="flying",to=to,character=character,root=root,wasAnchored=root.Anchored,releaseAt=math.huge}
	trips[player.UserId]=trip;setState(player,"flying")
	root.Anchored=true -- held until tick() releases it: nothing falls before the arrival hall has streamed in
	-- With StreamingEnabled the client only has parts near the character: stream the arrival area first.
	local ok,err=pcall(function() player:RequestStreamAroundAsync(arrival.Position,CityPlan.TRAVEL.streamTimeout) end)
	if not ok then warn("[City] RequestStreamAroundAsync failed for "..player.Name..": "..tostring(err)) end
	if trips[player.UserId]~=trip or player.Character~=character or not root.Parent then
		-- left, respawned or reset while the stream request yielded: no flight, the ticket is refunded
		if trips[player.UserId]==trip then reset(player) end
		if root.Parent then root.Anchored=trip.wasAnchored end
		if price&gt;0 then Economy.grant(s,price,"travel");s.data.stats.totalCost=math.max(0,s.data.stats.totalCost-price) end
		if held then Shuttle.restoreTicket(player,held) end
		return {ok=false,err="CANCELLED"}
	end
	character:PivotTo(arrival)
	trip.releaseAt=clock+CityPlan.TRAVEL.flightSeconds
	Session.markDirty(s,true)
	return {ok=true,to=to,seconds=CityPlan.TRAVEL.flightSeconds,price=price,destination=if to=="abroad" then "Port Meridian" else "City Airport"}
end

------------------------------------------------------------------------------------------------ routes
function City.route(s: any,to: any): {[string]: any}
	if typeof(to)~="string" or #to&gt;40 then return {ok=false,err="BAD_INPUT"} end
	local _,root=rootOf(s.player)
	if not root then return {ok=false,err="LOADING"} end
	local target: Vector3;local name: string
	if to=="home" then
		local p=Plot.get(s.player)
		if not p or typeof(p.index)~="number" then return {ok=false,err="LOADING"} end
		local info=CityPlan.plots()[p.index];if not info then return {ok=false,err="LOADING"} end
		target=info.gate;name=if s.data.company then s.data.company.name.." HQ" else "Your HQ"
	else
		local d=CityPlan.destination(to);if not d then return {ok=false,err="BAD_INPUT"} end
		target=d.drive or d.door.Position;name=d.name
	end
	local r,err=CityPlan.route(root.Position,target)
	if not r then return {ok=false,err=err or "NO_ROUTE"} end
	return {ok=true,to=to,name=name,points=r.points,length=math.floor(r.length+.5)}
end
-- Ask the player's client to fetch and draw a GPS route (appointments, assistant hints ...).
function City.guide(player: Player,destinationId: string)
	Remote.fire(player,"Notify","TRAVEL_GUIDE",{to=destinationId})
end
-- The customers package registers the real meeting here: fn(player, clientId, prompt).
function City.setMeetingHandler(fn: (Player,string,ProximityPrompt)-&gt;())
	meetingHandler=fn
end

------------------------------------------------------------------------------------------------ lifecycle
local function onPrompt(q: ProximityPrompt,player: Player)
	if q:GetAttribute("CityAction")~="meeting" then return end
	local part=q.Parent;local _,root=rootOf(player)
	if not part or not part:IsA("BasePart") or not root or (root.Position-part.Position).Magnitude&gt;16 then return end
	local now=workspace:GetServerTimeNow()
	if (promptAt[player] or 0)&gt;now then return end;promptAt[player]=now+1
	local clientId=q:GetAttribute("ClientId")
	if typeof(clientId)~="string" then return end
	local handler=meetingHandler
	if handler then handler(player,clientId,q);return end
	local d=CityPlan.clientOffice(clientId)
	Remote.fire(player,"Notify","CAMPUS_NOTICE",{text="No meeting with "..(if d then d.name else clientId).." is scheduled yet."})
end
function City.tick(dt: number)
	clock+=dt
	Shuttle.tick(dt)
	for userId,t in trips do
		if t.state=="flying" and clock&gt;=t.releaseAt then
			local root=t.root
			if root and root.Parent then root.Anchored=t.wasAnchored end
			if t.to=="abroad" then t.state="abroad";setState(t.player,"abroad")
			else trips[userId]=nil;setState(t.player,"home") end
		end
	end
end
function City.init()
	local ok,err=pcall(function() Builder.build(City.ticketText()) end)
	if not ok then warn("[City] building the shared world failed: "..tostring(err)) end
	local okShuttle,errShuttle=pcall(function() Shuttle.init({trips=trips,setState=setState,rootOf=rootOf}) end)
	if not okShuttle then warn("[City] starting the shuttle failed: "..tostring(errShuttle)) end
	Remote.bind("TravelAction",{burst=4,perSecond=.6},function(s,p)
		local action=p.action
		if action=="flight" then return City.flight(s,p.to) end
		if action=="route" then return City.route(s,p.to) end
		if action=="ticket" then return Shuttle.ticket(s,p.to) end
		if action=="board" then return Shuttle.board(s) end
		if action=="heli" then return Shuttle.heli(s,p.to) end
		if action=="status" then
			local res: {[string]: any}={ok=true,state=City.state(s.player),ticket=CityPlan.TRAVEL.ticket,seconds=CityPlan.TRAVEL.flightSeconds}
			local okStatus,info=pcall(Shuttle.status,s.player)
			if okStatus then for k,v in info do res[k]=v end end
			return res
		end
		return {ok=false,err="BAD_INPUT"}
	end)
	Prompts.PromptTriggered:Connect(onPrompt)
	Session.onLoaded(function(s)
		reset(s.player)
		-- a new character always starts at home (PlotService sends it to the plaza 0.25 s later)
		s.player.CharacterAdded:Connect(function() reset(s.player) end)
	end)
	Session.onClosing(function(s) Shuttle.drop(s.player,"leave");trips[s.userId]=nil;promptAt[s.player]=nil end)
	Plot.setAwayCheck(City.isAway)
end
return City
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000019"><Properties><string name="Name">CoreDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Circulation core of the headquarters: the lift shaft with a framed portal at every stop, the
-- physical lift cabin, the landing door sets, the switchback stair (smooth invisible ramps under
-- stone treads), the riser closure and the roof head house. Geometry only: LiftService drives the
-- cabin and landing doors, the wall planner (BuildingLayout) supplies the stair room walls and door.
-- Everything is built in building-local studs through ctx.cf, so the core works on every plot.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local P = require(ReplicatedStorage.Shared.Config.ArchPalette)

local CoreDesign = {}

export type Context = {
	office: Model,
	cf: CFrame,
	tier: number,
	floors: number,
	owner: number,
	accent: Color3,
	company: string,
	folders: { [string]: Instance },
}
export type Result = {
	landings: { [number]: Model },
	cabin: Model,
	guide: Part,
}

local COLOR, MAT = P.color, P.material

-- Shaft: 0.5 thick walls centred on the SHAFT outline.
local SH = Plan.SHAFT
local WALL = 0.5
local FZ1, FZ2 = SH.z1 - WALL / 2, SH.z1 + WALL / 2 -- front wall 53.75..54.25
local BZ1, BZ2 = SH.z2 - WALL / 2, SH.z2 + WALL / 2 -- back wall 67.75..68.25
local SXO, SXI = SH.x2 + WALL / 2, SH.x2 - WALL / 2 -- side walls |x| 6.75..7.25
local PIT_DEPTH = 4
local SHAFT_TOP = 13 -- shaft walls end at roof + 13 (head house slab top), cap above
local HEAD_HOUSE = 12 -- head house walls are 12 high, its roof slab sits on them

-- Landing doors: two leaves just in front of the shaft wall, parking behind the portal cladding.
local DOOR = Plan.LIFT_DOOR
local LEAF_W, LEAF_T, LEAF_SLIDE = 3.05, 0.3, 3.0
local LEAF_Z = FZ1 - LEAF_T / 2 -- 53.6
local LEAF_LIFT = 0.01 -- leaves run on the sill, whose top is 0.01 proud of the slab
local SILL_DEPTH = 0.17 -- sill bottom below the floor line
local PORTAL_FRONT = LEAF_Z - LEAF_T / 2 -- 53.45: cladding/jamb back face (leaves slide behind it)

-- Cabin (built resting at level 0). See SPEC §4.
local CB = Plan.CABIN
local CAB_Z = (CB.z1 + CB.z2) / 2 -- 60.8
local CAB_LEAF_Z = 54.97 -- cabin leaves z 54.82..55.12, front wall pieces behind them
local CAB_FRONT1, CAB_FRONT2 = 55.13, 55.28 -- front wall pieces (inside the leaves)
local CAB_BACK = 66.66 -- back wall inner face; oak/mirror lining in front of it
local CAB_SIDE = 5.86 -- side wall inner face (|x|); oak lining in front of it
local CAB_DOOR_H = DOOR.height
local CAB_CEIL = CB.height -- 10.4: ceiling bottom

-- Stair
local ST = Plan.STAIR_LAYOUT
local STEPS = 16
local RAMP_T = 0.4 -- invisible ramp thickness (perpendicular)
local WAIST = 1 -- vertical thickness of the visible stair waist (soffit slab)
local RAIL_H = 3.2 -- handrail height above the walking line

-- ---------------------------------------------------------------------------------------------
-- Part helpers (ArchKit is written in parallel; the core keeps its own tiny kit)

local function block(parent: Instance, cf: CFrame, name: string, size: Vector3, at: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf * at
	p.Anchored = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Axis-aligned block between two building-local corners.
local function box(parent: Instance, cf: CFrame, name: string, x1: number, x2: number, y1: number, y2: number, z1: number, z2: number, color: Color3, material: Enum.Material): Part
	return block(parent, cf, name, Vector3.new(x2 - x1, y2 - y1, z2 - z1), CFrame.new((x1 + x2) / 2, (y1 + y2) / 2, (z1 + z2) / 2), color, material)
end

-- Rotation about X that lays a block's local Z along the (dy, dz) direction; returns the angle
-- and the block's local up vector (0, ny, nz) (always pointing upwards).
local function pitch(dy: number, dz: number): (number, number, number, number)
	if dz &lt; 0 then
		dy, dz = -dy, -dz
	end
	local a = -math.atan2(dy, dz)
	return a, math.cos(a), math.sin(a), math.sqrt(dy * dy + dz * dz)
end

-- Inclined block across x1..x2 whose TOP face runs exactly from (yA, zA) to (yB, zB).
local function slopeTop(parent: Instance, cf: CFrame, name: string, x1: number, x2: number, yA: number, zA: number, yB: number, zB: number, t: number, color: Color3, material: Enum.Material): Part
	local a, ny, nz, len = pitch(yB - yA, zB - zA)
	local at = CFrame.new((x1 + x2) / 2, (yA + yB) / 2 - ny * t / 2, (zA + zB) / 2 - nz * t / 2) * CFrame.Angles(a, 0, 0)
	return block(parent, cf, name, Vector3.new(x2 - x1, t, len), at, color, material)
end

-- Inclined block whose centre line runs from (yA, zA) to (yB, zB) (handrails).
local function slopeBeam(parent: Instance, cf: CFrame, name: string, x1: number, x2: number, yA: number, zA: number, yB: number, zB: number, h: number, color: Color3, material: Enum.Material): Part
	local a, _, _, len = pitch(yB - yA, zB - zA)
	local at = CFrame.new((x1 + x2) / 2, (yA + yB) / 2, (zA + zB) / 2) * CFrame.Angles(a, 0, 0)
	return block(parent, cf, name, Vector3.new(x2 - x1, h, len), at, color, material)
end

-- Decorative part: never collides, never blocks rays or touches.
local function detail(p: BasePart)
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
end

-- Invisible helper part (markers, guide, nodes).
local function ghost(p: BasePart)
	detail(p)
	p.Transparency = 1
	p.CastShadow = false
end

local function shaftPart(p: Instance)
	p:SetAttribute("LiftShaft", true)
end

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function surface(part: BasePart, name: string, canvas: Vector2, light: number, maxDistance: number): SurfaceGui
	local g = Instance.new("SurfaceGui")
	g.Name = name
	g.Face = Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	g.CanvasSize = canvas
	g.LightInfluence = light
	g.MaxDistance = maxDistance
	g.Parent = part
	return g
end

-- TextLabel positioned in scale coordinates of its SurfaceGui.
local function label(parent: Instance, name: string, text: string, x: number, y: number, w: number, h: number, color: Color3, font: Enum.Font, align: Enum.TextXAlignment): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(x, y)
	t.Size = UDim2.fromScale(w, h)
	t.Text = text
	t.TextScaled = true
	t.TextWrapped = true
	t.TextColor3 = color
	t.Font = font
	t.TextXAlignment = align
	t.Parent = parent
	return t
end

local function prompt(part: BasePart, action: string, distance: number, campusAction: string, value: number?): ProximityPrompt
	local q = Instance.new("ProximityPrompt")
	q.ActionText = action
	q.ObjectText = "Lift"
	q.MaxActivationDistance = distance
	q.RequiresLineOfSight = false
	q.HoldDuration = 0
	q:SetAttribute("CampusAction", campusAction)
	q:SetAttribute("Public", true)
	if value ~= nil then
		q:SetAttribute("Value", value)
	end
	q.Parent = part
	return q
end

-- Level / Arrow / Status display used by the landing indicators and the cabin display.
local function display(part: BasePart, canvas: Vector2, level: string, status: string, accent: Color3, maxDistance: number)
	local g = surface(part, "Display", canvas, 0.1, maxDistance)
	label(g, "Level", level, 0.03, 0.06, 0.25, 0.88, COLOR.white, Enum.Font.BuilderSansBold, Enum.TextXAlignment.Center)
	label(g, "Arrow", "", 0.29, 0.14, 0.14, 0.72, accent, Enum.Font.BuilderSansBold, Enum.TextXAlignment.Center)
	label(g, "Status", status, 0.45, 0.2, 0.52, 0.6, COLOR.lightNeutral, Enum.Font.BuilderSansMedium, Enum.TextXAlignment.Left)
end

local function folderFor(ctx: Context, name: string): Instance
	local f = ctx.folders[name] or ctx.office:FindFirstChild(name)
	if f then
		return f
	end
	local made = Instance.new("Folder")
	made.Name = name
	made.Parent = ctx.office
	return made
end

-- ---------------------------------------------------------------------------------------------
-- Lift shaft: walls from the pit floor to roof + 13, door openings at every stop, pit, cap.

local function buildShaft(parent: Instance, cf: CFrame, tier: number)
	local m = model(parent, "LiftShaft")
	local roofY = Plan.levelY(Plan.roofLevel(tier))
	local pit = Plan.levelY(-1) - PIT_DEPTH
	local bottom, top = pit - 1, roofY + SHAFT_TOP
	local function add(p: Part)
		shaftPart(p)
	end
	add(box(m, cf, "ShaftBack", -SXO, SXO, bottom, top, BZ1, BZ2, COLOR.concrete, MAT.concrete))
	add(box(m, cf, "ShaftSide", -SXO, -SXI, bottom, top, FZ2, BZ1, COLOR.interior, MAT.plaster))
	add(box(m, cf, "ShaftSide", SXI, SXO, bottom, top, FZ2, BZ1, COLOR.interior, MAT.plaster))
	-- front wall: full-height piers beside the door line, spandrels between the openings
	add(box(m, cf, "ShaftFront", -SXO, DOOR.x1, bottom, top, FZ1, FZ2, COLOR.stone, MAT.stone))
	add(box(m, cf, "ShaftFront", DOOR.x2, SXO, bottom, top, FZ1, FZ2, COLOR.stone, MAT.stone))
	local below = bottom
	for _, stop in Plan.liftStops(tier) do
		add(box(m, cf, "ShaftSpandrel", DOOR.x1, DOOR.x2, below, stop.y - SILL_DEPTH, FZ1, FZ2, COLOR.stone, MAT.stone))
		below = stop.y + DOOR.height
	end
	add(box(m, cf, "ShaftSpandrel", DOOR.x1, DOOR.x2, below, top, FZ1, FZ2, COLOR.stone, MAT.stone))
	add(box(m, cf, "LiftPit", -SXI, SXI, bottom, pit, FZ2, BZ1, COLOR.concrete, MAT.concrete))
	for _, x in { -3.2, 3.2 } do
		local buffer = box(m, cf, "PitBuffer", x - 0.5, x + 0.5, pit, pit + 1.2, CAB_Z - 0.5, CAB_Z + 0.5, COLOR.metal, MAT.metal)
		add(buffer)
	end
	add(box(m, cf, "ShaftCap", -SXO - 0.25, SXO + 0.25, top, top + 0.5, FZ1 - 0.25, BZ2 + 0.25, COLOR.metal, MAT.metal))
end

-- Roof head house: roof slab over the lobby / stair / machine room / riser cluster, coping, and the
-- riser's back wall (the wall planner builds every other head house wall).
local function buildHeadHouse(parent: Instance, cf: CFrame, tier: number)
	local m = model(parent, "HeadHouse")
	local roofY = Plan.levelY(Plan.roofLevel(tier))
	local y1, y2 = roofY + HEAD_HOUSE, roofY + SHAFT_TOP
	local X, Z1, Z2 = 23, 41, 81 -- outline x -22..22, z 42..80 plus a small overhang
	local function add(p: Part)
		shaftPart(p)
	end
	-- the shaft passes through the slab up to its cap
	add(box(m, cf, "HeadHouseRoof", -X, X, y1, y2, Z1, FZ1, COLOR.concrete, MAT.concrete))
	add(box(m, cf, "HeadHouseRoof", -X, X, y1, y2, BZ2, Z2, COLOR.concrete, MAT.concrete))
	add(box(m, cf, "HeadHouseRoof", -X, -SXO, y1, y2, FZ1, BZ2, COLOR.concrete, MAT.concrete))
	add(box(m, cf, "HeadHouseRoof", SXO, X, y1, y2, FZ1, BZ2, COLOR.concrete, MAT.concrete))
	local c, lo, hi = 0.3, y1 - 0.3, y2 + 0.25
	add(box(m, cf, "HeadHouseCoping", -X - c, X + c, lo, hi, Z1 - c, Z1, COLOR.metal, MAT.metal))
	add(box(m, cf, "HeadHouseCoping", -X - c, X + c, lo, hi, Z2, Z2 + c, COLOR.metal, MAT.metal))
	add(box(m, cf, "HeadHouseCoping", -X - c, -X, lo, hi, Z1, Z2, COLOR.metal, MAT.metal))
	add(box(m, cf, "HeadHouseCoping", X, X + c, lo, hi, Z1, Z2, COLOR.metal, MAT.metal))
	local r = Plan.RISER
	add(box(m, cf, "RiserBackWall", r.x1 - 0.5, r.x2 + 0.5, roofY, y1, r.z2 - 0.5, r.z2 + 0.5, COLOR.stone, MAT.stone))
end

-- Portal around the landing doors: stone cladding hides the parked leaves, dark metal jambs + head.
local function buildPortal(parent: Instance, cf: CFrame, tier: number, level: number)
	local m = model(parent, "LiftPortal_" .. level)
	local y = Plan.levelY(level)
	local front, jambFront = 53.1, 52.95
	local j = 0.4
	for _, s in { -1, 1 } do
		local clad = box(m, cf, "PortalCladding", math.min(s * (DOOR.x2 + j), s * (SXO + 0.25)), math.max(s * (DOOR.x2 + j), s * (SXO + 0.25)), y, y + DOOR.height + 0.5, front, PORTAL_FRONT, COLOR.stoneDeep, MAT.marble)
		shaftPart(clad)
		local jamb = box(m, cf, "PortalJamb", math.min(s * DOOR.x2, s * (DOOR.x2 + j)), math.max(s * DOOR.x2, s * (DOOR.x2 + j)), y, y + DOOR.height, jambFront, PORTAL_FRONT, COLOR.metal, MAT.metal)
		shaftPart(jamb)
	end
	local head = box(m, cf, "PortalHead", DOOR.x1 - j, DOOR.x2 + j, y + DOOR.height, y + DOOR.height + 0.5, jambFront, PORTAL_FRONT, COLOR.metal, MAT.metal)
	shaftPart(head)
	local g = surface(head, "LevelNumber", Vector2.new(680, 50), 0.4, 60)
	label(g, "Label", Plan.levelLabel(tier, level), 0.4, 0.12, 0.2, 0.76, COLOR.brass, Enum.Font.BuilderSansBold, Enum.TextXAlignment.Center)
end

-- ---------------------------------------------------------------------------------------------
-- Landing door sets (Lift folder)

local function buildLanding(parent: Instance, cf: CFrame, tier: number, level: number, accent: Color3): Model
	local y = Plan.levelY(level)
	local m = Instance.new("Model")
	m.Name = "Landing_" .. level
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	m:SetAttribute("LiftStop", level)
	m:SetAttribute("LevelLabel", Plan.levelLabel(tier, level))
	m.Parent = parent
	for _, s in { -1, 1 } do
		local closed = CFrame.new(s * LEAF_W / 2, y + LEAF_LIFT + DOOR.height / 2, LEAF_Z)
		local open = CFrame.new(s * (LEAF_W / 2 + LEAF_SLIDE), y + LEAF_LIFT + DOOR.height / 2, LEAF_Z)
		local leaf = block(m, cf, if s &lt; 0 then "DoorL" else "DoorR", Vector3.new(LEAF_W, DOOR.height, LEAF_T), closed, COLOR.metalSoft, MAT.metal)
		leaf:SetAttribute("ClosedCFrame", cf * closed)
		leaf:SetAttribute("OpenCFrame", cf * open)
		shaftPart(leaf)
	end
	-- threshold plate through the wall opening, stopping 0.1 short of the cabin
	local sill = box(m, cf, "Sill", DOOR.x1, DOOR.x2, y - SILL_DEPTH, y + LEAF_LIFT, 53.4, CB.z1 - 0.1, COLOR.metalSoft, MAT.metal)
	shaftPart(sill)
	-- call button on the right-hand portal cladding
	local button = block(m, cf, "CallButton", Vector3.new(0.62, 1.1, 0.1), CFrame.new(4.6, y + 3.6, 53.05), COLOR.metal, MAT.metal)
	button.CanCollide = false
	button.CanTouch = false
	local ring = block(m, cf, "CallRing", Vector3.new(0.06, 0.42, 0.42), CFrame.new(4.6, y + 3.75, 52.97) * CFrame.Angles(0, math.pi / 2, 0), COLOR.lightWarm, MAT.neon)
	ring.Shape = Enum.PartType.Cylinder
	detail(ring)
	local q = prompt(button, "Call lift", 7, "liftCall", level)
	q.Name = "CallPrompt"
	-- floor indicator above the portal, facing the lobby (-Z)
	local indicator = block(m, cf, "Indicator", Vector3.new(4.8, 1.2, 0.55), CFrame.new(0, y + 11.2, FZ1 - 0.275), COLOR.screen, MAT.smooth)
	detail(indicator)
	display(indicator, Vector2.new(480, 120), Plan.levelLabel(tier, level), Plan.floorTitle(tier, level), accent, 80)
	-- queue marker for NPCs and a brass floor plate in front of the doors
	local wait = block(m, cf, "WaitMarker", Vector3.new(1, 1, 1), CFrame.new(Plan.liftWaitPoint(level, 1)), COLOR.white, MAT.smooth)
	ghost(wait)
	wait:SetAttribute("LiftStop", level)
	local plate = box(m, cf, "FloorMarker", -2.4, 2.4, y, y + 0.06, 51.9, 52.5, COLOR.brass, MAT.metal)
	detail(plate)
	return m
end

-- ---------------------------------------------------------------------------------------------
-- Lift cabin (built at level 0; LiftService unanchors and welds it to CabinFloor)

local function buildCabin(parent: Instance, cf: CFrame, tier: number, accent: Color3, company: string): Model
	local cabin = Instance.new("Model")
	cabin.Name = "LiftCabin"
	cabin.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	cabin:SetAttribute("CurrentLevel", 0)
	cabin.Parent = parent
	local y = Plan.levelY(0)
	local x1, x2, z1, z2 = CB.x1, CB.x2, CB.z1, CB.z2
	local metal, oak = COLOR.metal, COLOR.oak
	local function add(name: string, ax: number, bx: number, ay: number, by: number, az: number, bz: number, color: Color3, material: Enum.Material, decorative: boolean?): Part
		local p = box(cabin, cf, name, ax, bx, y + ay, y + by, az, bz, color, material)
		if decorative then
			detail(p)
		end
		return p
	end
	local floor = add("CabinFloor", x1, x2, -0.5, 0, z1, z2, COLOR.stoneDeep, MAT.marble)
	cabin.PrimaryPart = floor
	add("CabinFloorInlay", -4.6, 4.6, 0, 0.05, 56.6, 65.2, COLOR.oakLight, MAT.wood, true)
	add("CabinThreshold", DOOR.x1, DOOR.x2, 0, 0.05, z1, 55.4, COLOR.metalSoft, MAT.metal, true)
	-- shell: front pieces beside the door (the leaves park in front of them), sides, back, roof
	add("CabinFront", x1, DOOR.x1, 0, CAB_DOOR_H, CAB_FRONT1, CAB_FRONT2, oak, MAT.wood)
	add("CabinFront", DOOR.x2, x2, 0, CAB_DOOR_H, CAB_FRONT1, CAB_FRONT2, oak, MAT.wood)
	add("CabinTransom", x1, x2, CAB_DOOR_H, CAB_CEIL, CAB_LEAF_Z - LEAF_T / 2, CAB_FRONT2, metal, MAT.metal)
	add("CabinSide", x1, -CAB_SIDE, 0, CAB_CEIL, CAB_FRONT2, CAB_BACK, metal, MAT.metal)
	add("CabinSide", CAB_SIDE, x2, 0, CAB_CEIL, CAB_FRONT2, CAB_BACK, metal, MAT.metal)
	add("CabinBack", x1, x2, 0, CAB_CEIL, CAB_BACK, z2, metal, MAT.metal)
	add("CabinCeiling", x1, x2, CAB_CEIL, CAB_CEIL + 0.4, z1, z2, COLOR.white, MAT.smooth)
	-- interior: oak panelling with dark metal joints, satin steel panel on the back wall
	local lin = CAB_SIDE - 0.08 -- 5.78: oak face
	add("CabinPanelling", x1 + 0.14, -lin, 0, CAB_CEIL, CAB_FRONT2, CAB_BACK - 0.07, oak, MAT.wood, true)
	add("CabinPanelling", lin, x2 - 0.14, 0, CAB_CEIL, CAB_FRONT2, CAB_BACK - 0.07, oak, MAT.wood, true)
	add("CabinPanelling", -lin, lin, 0, CAB_CEIL, CAB_BACK - 0.07, CAB_BACK, oak, MAT.wood, true)
	add("CabinSatinPanel", -3.6, 3.6, 3.9, 9.5, CAB_BACK - 0.12, CAB_BACK - 0.07, COLOR.glassDeep, MAT.metal, true)
	for _, s in { -1, 1 } do
		for _, z in { 59.1, 62.9 } do
			add("CabinJoint", math.min(s * lin, s * (lin - 0.05)), math.max(s * lin, s * (lin - 0.05)), 0.35, CAB_CEIL, z - 0.06, z + 0.06, metal, MAT.metal, true)
		end
		add("CabinSkirting", math.min(s * lin, s * (lin - 0.06)), math.max(s * lin, s * (lin - 0.06)), 0, 0.35, CAB_FRONT2, CAB_BACK - 0.13, metal, MAT.metal, true)
	end
	add("CabinSkirting", -(lin - 0.06), lin - 0.06, 0, 0.35, CAB_BACK - 0.13, CAB_BACK - 0.07, metal, MAT.metal, true)
	-- handrails (outside the 11 x 11 clear floor: |x| &gt;= 5.52, z &lt;= 66.43)
	local railY1, railY2 = RAIL_H - 0.06, RAIL_H + 0.06
	add("CabinHandrail", -4.8, 4.8, railY1, railY2, 66.43, 66.53, oak, MAT.wood, true)
	for _, x in { -3.5, 3.5 } do
		add("CabinRailBracket", x - 0.05, x + 0.05, railY1 + 0.01, railY2 - 0.01, 66.53, CAB_BACK - 0.07, metal, MAT.metal, true)
	end
	for _, s in { -1, 1 } do
		add("CabinHandrail", math.min(s * 5.52, s * 5.62), math.max(s * 5.52, s * 5.62), railY1, railY2, 57, 65.5, oak, MAT.wood, true)
		for _, z in { 58, 64.5 } do
			add("CabinRailBracket", math.min(s * 5.62, s * lin), math.max(s * 5.62, s * lin), railY1 + 0.01, railY2 - 0.01, z - 0.05, z + 0.05, metal, MAT.metal, true)
		end
	end
	-- recessed light panel
	add("CabinLightTrim", -3.7, 3.7, CAB_CEIL - 0.06, CAB_CEIL, 57.2, 64.6, metal, MAT.metal, true)
	local light = add("CabinLight", -3.5, 3.5, CAB_CEIL - 0.07, CAB_CEIL, 57.4, 64.4, COLOR.lightWarm, MAT.neon, true)
	local lamp = Instance.new("SurfaceLight")
	lamp.Face = Enum.NormalId.Bottom
	lamp.Angle = 120
	lamp.Range = 12
	lamp.Brightness = 1.1
	lamp.Color = COLOR.lightWarm
	lamp.Shadows = false
	lamp.Parent = light
	-- door leaves on the cabin front
	for _, s in { -1, 1 } do
		local closed = CFrame.new(s * LEAF_W / 2, y + CAB_DOOR_H / 2, CAB_LEAF_Z)
		local open = CFrame.new(s * (LEAF_W / 2 + LEAF_SLIDE), y + CAB_DOOR_H / 2, CAB_LEAF_Z)
		local leaf = block(cabin, cf, if s &lt; 0 then "CabinDoorL" else "CabinDoorR", Vector3.new(LEAF_W, CAB_DOOR_H, LEAF_T), closed, COLOR.metalSoft, MAT.metal)
		leaf:SetAttribute("ClosedOffset", floor.CFrame:ToObjectSpace(cf * closed))
		leaf:SetAttribute("OpenOffset", floor.CFrame:ToObjectSpace(cf * open))
	end
	-- floor strip display in the transom, facing the riders (+Z)
	local turn = CFrame.Angles(0, math.pi, 0)
	local screen = block(cabin, cf, "CabinDisplay", Vector3.new(3.2, 0.34, 0.06), CFrame.new(0, y + CAB_DOOR_H + 0.2, CAB_FRONT2 + 0.03) * turn, COLOR.screen, MAT.smooth)
	detail(screen)
	display(screen, Vector2.new(640, 68), Plan.levelLabel(tier, 0), Plan.levelName(tier, 0), accent, 40)
	-- button column beside the door (riders' right when facing the doors)
	local px1, px2, py1, py2 = 4.3, 5.5, 2.4, 7.2
	local panel = block(cabin, cf, "CabinPanel", Vector3.new(px2 - px1, py2 - py1, 0.08), CFrame.new((px1 + px2) / 2, y + (py1 + py2) / 2, CAB_FRONT2 + 0.04) * turn, metal, MAT.metal)
	panel.CanCollide = false
	panel.CanTouch = false
	local q = prompt(panel, "Choose floor", 6, "liftPanel", nil)
	q.Name = "PanelPrompt"
	local g = surface(panel, "Buttons", Vector2.new(240, 960), 0.2, 30)
	label(g, "Company", company, 0.06, 0.02, 0.88, 0.06, COLOR.brass, Enum.Font.BuilderSansBold, Enum.TextXAlignment.Center)
	label(g, "Title", "LIFT · " .. Plan.CABIN.capacity .. " persons", 0.06, 0.085, 0.88, 0.04, COLOR.lightNeutral, Enum.Font.BuilderSans, Enum.TextXAlignment.Center)
	local stops = Plan.liftStops(tier)
	local cells: { { text: string, level: number?, door: string? } } = { { text = "&lt;&gt;", door = "open" }, { text = "&gt;&lt;", door = "close" } }
	for _, stop in stops do
		table.insert(cells, { text = stop.label, level = stop.level })
	end
	local rows = math.ceil(#cells / 2)
	local pitchY = math.min(0.5, (py2 - py1 - 1.1) / rows)
	for k, cell in cells do
		local row, col = (k - 1) // 2, (k - 1) % 2
		local cx = px1 + 0.3 + 0.6 * col - 0.1 -- button centre (world x grows to the riders' right)
		local cy = py1 + 0.3 + pitchY * (row + 0.5)
		local b = block(cabin, cf, "CabinButton", Vector3.new(0.24, 0.24, 0.05), CFrame.new(cx, y + cy, CAB_FRONT2 + 0.105) * turn, if cell.door then COLOR.metalSoft else COLOR.brass, MAT.metal)
		detail(b)
		if cell.level ~= nil then
			b:SetAttribute("LiftStop", cell.level)
		else
			b:SetAttribute("DoorButton", cell.door)
		end
		local u = (cx + 0.16 - px1) / (px2 - px1)
		local v = (py2 - (cy + 0.14)) / (py2 - py1)
		label(g, "Key", cell.text, u, v, 0.18, 0.28 / (py2 - py1), COLOR.white, Enum.Font.BuilderSansBold, Enum.TextXAlignment.Left)
	end
	return cabin
end

-- ---------------------------------------------------------------------------------------------
-- Switchback stair (Core folder)

-- One flight rising from (yA, zA) to (yB, zB) over x1..x2: an invisible smooth ramp whose top face
-- passes exactly through both end points, 16 stone treads with their nosings on the walking line,
-- a dark nosing per step, the plastered waist below and wall-mounted oak rails on both sides.
local function buildFlight(m: Model, cf: CFrame, x1: number, x2: number, yA: number, zA: number, yB: number, zB: number, onFloor: boolean, rails: { { number } }): Part
	local dir = if zB &gt; zA then 1 else -1
	local rise = (yB - yA) / STEPS
	local going = math.abs(zB - zA) / STEPS
	local ramp = slopeTop(m, cf, "StairRamp", x1, x2, yA, zA, yB, zB, RAMP_T, COLOR.stone, MAT.stone)
	ramp.Transparency = 1
	ramp.CanTouch = false
	ramp.CastShadow = false
	ramp:SetAttribute("StairRamp", true)
	local function nosing(z: number, top: number)
		local n = box(m, cf, "StairNosing", x1, x2, top - 0.1, top + 0.015, math.min(z - dir * 0.02, z + dir * 0.16), math.max(z - dir * 0.02, z + dir * 0.16), COLOR.metal, MAT.metal)
		detail(n)
	end
	for i = 0, STEPS - 1 do
		local top = yA + rise * i
		local za, zb = zA + dir * going * i, zA + dir * going * (i + 1)
		-- tread 0 is flush with the landing it leaves; on a solid floor (B1) the floor already shows
		if i &gt; 0 or not onFloor then
			local t = box(m, cf, "StairTread", x1, x2, top - rise - 0.45, top, math.min(za, zb), math.max(za, zb), COLOR.stone, MAT.stone)
			detail(t)
		end
		if i &gt; 0 then
			nosing(za, top)
		end
	end
	nosing(zB, yB) -- the arrival landing's edge is the last nosing
	local waist = WAIST * going / math.sqrt(going * going + rise * rise)
	slopeTop(m, cf, "StairSoffit", x1, x2, yA - rise, zA, yB - rise, zB, waist, COLOR.interior, MAT.plaster)
	-- rails follow the walking line at RAIL_H
	local function lineY(z: number): number
		return yA + (z - zA) * (yB - yA) / (zB - zA)
	end
	local zs, ze = zA + dir * 0.6, zB - dir * 0.6
	for _, r in rails do
		local rail = slopeBeam(m, cf, "StairHandrail", r[1], r[2], lineY(zs) + RAIL_H, zs, lineY(ze) + RAIL_H, ze, 0.2, COLOR.oak, MAT.wood)
		detail(rail)
	end
	return ramp
end

local function buildStairLevel(parent: Instance, cf: CFrame, level: number): Model
	local m = model(parent, "Stair_" .. level)
	local y0, y1 = Plan.levelY(level), Plan.levelY(level + 1)
	local mid = y0 + (y1 - y0) / 2
	local A, B, dv = ST.flightA, ST.flightB, ST.divider
	local rw = 0.25 -- rail projection from its wall
	buildFlight(m, cf, A.x1, A.x2, y0, A.z1, mid, A.z2, level &lt; 0, { { A.x1, A.x1 + rw }, { dv.x1 - rw, dv.x1 } })
	buildFlight(m, cf, B.x1, B.x2, mid, B.z2, y1, B.z1, false, { { dv.x2, dv.x2 + rw }, { B.x2 - rw, B.x2 } })
	box(m, cf, "StairLanding", ST.inner.x1, ST.inner.x2, mid - 1, mid, ST.midLanding.z1, ST.midLanding.z2, COLOR.stone, MAT.stone)
	-- wall light on the divider end over the mid landing
	local fixture = box(m, cf, "StairLight", dv.x1 + 0.05, dv.x2 - 0.05, mid + 6.2, mid + 7.6, ST.midLanding.z1, ST.midLanding.z1 + 0.12, COLOR.lightWarm, MAT.neon)
	detail(fixture)
	local lamp = Instance.new("PointLight")
	lamp.Range = 20
	lamp.Brightness = 0.9
	lamp.Color = COLOR.lightWarm
	lamp.Shadows = false
	lamp.Parent = fixture
	return m
end

-- Shared stair pieces: the full-height divider, the lining that makes the shaft side flush with the
-- stair room walls, level signs facing the stair door, and the guard over the top flight.
local function buildStairCore(parent: Instance, cf: CFrame, tier: number, accent: Color3)
	local m = model(parent, "StairCore")
	local roof = Plan.roofLevel(tier)
	local base, top = Plan.levelY(-1), Plan.levelY(roof) + HEAD_HOUSE
	local dv = ST.divider
	box(m, cf, "StairDivider", dv.x1, dv.x2, base, top, ST.flightA.z1, ST.flightA.z2, COLOR.interior, MAT.plaster)
	box(m, cf, "StairLining", ST.inner.x2, -SXO, base, top, ST.inner.z1, SH.z2, COLOR.interior, MAT.plaster)
	for level = -1, roof do
		local y = Plan.levelY(level)
		local z = ST.flightA.z1
		local sign = box(m, cf, "StairSign_" .. level, dv.x1 - 1, dv.x2 + 1, y + 7, y + 10.2, z - 0.12, z, COLOR.metal, MAT.metal)
		detail(sign)
		local g = surface(sign, "Sign", Vector2.new(260, 320), 0.3, 70)
		label(g, "Level", Plan.levelLabel(tier, level), 0.08, 0.04, 0.84, 0.56, COLOR.white, Enum.Font.BuilderSansBold, Enum.TextXAlignment.Center)
		local bar = Instance.new("Frame")
		bar.Name = "Accent"
		bar.BackgroundColor3 = accent
		bar.BorderSizePixel = 0
		bar.Position = UDim2.fromScale(0.3, 0.62)
		bar.Size = UDim2.fromScale(0.4, 0.015)
		bar.Parent = g
		label(g, "Title", Plan.levelName(tier, level), 0.08, 0.66, 0.84, 0.28, COLOR.lightNeutral, Enum.Font.BuilderSansMedium, Enum.TextXAlignment.Center)
	end
	-- roof: the flight below ends here, so the void over flight A gets a glass guard on the slab edge
	local roofY = Plan.levelY(roof)
	local z = ST.flightA.z1
	local glass = box(m, cf, "StairGuardGlass", ST.flightA.x1, ST.flightA.x2, roofY, roofY + 3.5, z - 0.2, z - 0.08, COLOR.glass, MAT.glass)
	glass.Transparency = P.railTransparency
	box(m, cf, "StairGuardRail", ST.flightA.x1, ST.flightA.x2, roofY + 3.5, roofY + 3.7, z - 0.22, z - 0.06, COLOR.metal, MAT.metal)
end

-- ---------------------------------------------------------------------------------------------
-- Navigation nodes (lift queue point and stair door per level)

local function node(parent: Instance, cf: CFrame, name: string, x: number, y: number, z: number, kind: string, level: number): Part
	local p = block(parent, cf, name, Vector3.new(0.2, 0.2, 0.2), CFrame.new(x, y, z), COLOR.white, MAT.smooth)
	ghost(p)
	p:SetAttribute("NavigationNode", kind)
	p:SetAttribute("Floor", level)
	CollectionService:AddTag(p, "NavigationNode")
	return p
end

-- ---------------------------------------------------------------------------------------------

function CoreDesign.build(ctx: Context): Result
	local cf, tier = ctx.cf, ctx.tier
	local roof = Plan.roofLevel(tier)
	local coreFolder = folderFor(ctx, "Core")
	local liftFolder = folderFor(ctx, "Lift")
	local navFolder = folderFor(ctx, "Navigation")

	buildShaft(coreFolder, cf, tier)
	buildHeadHouse(coreFolder, cf, tier)
	local landings: { [number]: Model } = {}
	for _, stop in Plan.liftStops(tier) do
		buildPortal(coreFolder, cf, tier, stop.level)
		landings[stop.level] = buildLanding(liftFolder, cf, tier, stop.level, ctx.accent)
	end

	local guide = block(liftFolder, cf, "LiftGuide", Vector3.new(1, 1, 1), CFrame.new(0, Plan.levelY(-1), CAB_Z), COLOR.white, MAT.smooth)
	ghost(guide)
	local cabin = buildCabin(liftFolder, cf, tier, ctx.accent, ctx.company)

	local stairs = model(coreFolder, "Stair")
	for level = -1, roof - 1 do
		buildStairLevel(stairs, cf, level)
	end
	buildStairCore(stairs, cf, tier, ctx.accent)

	for level = -1, roof do
		local y = Plan.levelY(level) + 2.8
		local w = Plan.liftWaitPoint(level, 1)
		local s = Plan.stairEntry(level)
		node(navFolder, cf, string.format("L%d_LiftWait", level), w.X, y, w.Z, "Elevator", level)
		node(navFolder, cf, string.format("L%d_Stair", level), s.X, y, s.Z, "Stairs", level)
	end

	return { landings = landings, cabin = cabin, guide = guide }
end

return CoreDesign
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000020"><Properties><string name="Name">DoorService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Server door controller for every CampusDoor model (contract: SPEC §3).
--
-- Each door runs one small state machine:
--   closed → opening → open (HoldOpen timer, extended by new requests and an occupied doorway)
--          → closing → closed
-- Leaves are animated with leaf:PivotTo(ClosedPivot:Lerp(OpenPivot, eased alpha)). A door that is
-- asked again while it moves simply continues/reverses its single animation, so repeated triggers
-- never start competing tweens. Leaf parts stop colliding as soon as a door starts to open and only
-- collide again when the doorway Sensor is empty at the moment the leaves are shut; somebody stepping
-- into a closing doorway reopens it.
--
-- Access: the protected side (SecureNormal) can always leave — locked doors, founder rooms, the
-- bookcase, the vault and the hidden lab can never trap anybody. Entry from the other side asks the
-- authorizer (FacilityService: founder, company card, guest card → BuildingPlan.playerAllows) or,
-- for employees, BuildingPlan.roleAllows. Hidden doors (flush, bookcase, vault) never open for NPCs.
-- Automatic doors (AutoOpen: entrance, badge speed gates, garage gate) open by themselves for an
-- authorized person approaching from outside and for anybody approaching from the protected side;
-- a denied approach turns the reader red and notifies the player (throttled).
--
-- Cost: idle doors cost nothing. tick() only visits doors that are moving, open, flashing a reader
-- light or waiting for their doorway to clear, plus the few automatic doors (polled 5×/s). The
-- Heartbeat connection exists only while at least one door is animating.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout = require(ReplicatedStorage.Shared.BuildingLayout)
local Palette = require(ReplicatedStorage.Shared.Config.ArchPalette)
local Sound = require(script.Parent.CampusSoundService)

local Doors = {}

local TAG = "CampusDoor"
local REQUEST_RANGE = 10 -- player prompt requests
local NPC_RANGE = 8 -- employee requests
local AUTO_RANGE = 7 -- automatic doors: approach distance (gates 14, speed gate lanes 3.5)
local LIGHT_SECONDS = 1.5
local AUTO_POLL = 0.2
local SWEEP_SECONDS = 3
local REOPEN_HOLD = 2.5 -- hold after an obstruction reopened a closing door
local OCCUPIED_HOLD = 0.8 -- an occupied doorway keeps the timer at least this high
local DENY_COOLDOWN = 4 -- seconds between "access denied" notices for one player at automatic doors
local DEFAULT_DURATION = 0.6
local DURATION: { [string]: number } = { vault = 1.4, bookcase = 1.1, gate = 1.0, speedgate = 0.45 }
local DEFAULT_HOLD: { [string]: number } = { speedgate = 2 }
local DEFAULT_APPROACH: { [string]: number } = { gate = 14, speedgate = 3.5 }
local HIDDEN_KINDS: { [string]: boolean } = { flush = true, bookcase = true, vault = true }
local FEEDBACK: { [string]: Color3 } = {
	good = Palette.color.statusGood,
	bad = Palette.color.statusBad,
	busy = Palette.color.statusBusy,
}

type Leaf = { model: Model, closed: CFrame, open: CFrame }
type Light = { part: BasePart, neutral: Color3 }
type Record = {
	model: Model,
	office: Model,
	id: string,
	kind: string,
	access: string,
	normal: Vector3, -- world unit vector into the protected side; zero = unknown (both sides may leave)
	centre: Vector3, -- doorway centre (closed leaves)
	reach: number, -- quick-reject radius for sensor tests
	auto: boolean,
	approach: number,
	hold: number,
	hidden: boolean,
	duration: number,
	fixture: string?,
	leaves: { Leaf },
	solid: { BasePart }, -- leaf parts that collide while the door is shut
	sensor: BasePart?,
	lights: { Light },
	soundPart: BasePart?,
	state: string, -- closed | opening | open | closing
	progress: number, -- 0 = closed .. 1 = open
	timer: number,
	locked: boolean,
	forced: boolean, -- manual close (cubicle toggle): do not reopen for occupancy
	pendingSolid: boolean, -- shut, but leaves stay non-colliding until the doorway is clear
	collidable: boolean,
	lightTimer: number,
	lastUser: string?,
	written: string?,
}
type Registry = { doors: { [Model]: Record }, byId: { [string]: Record }, toilets: { [string]: Seat }? }
type PlayerRoot = { player: Player, root: BasePart }
type NpcRoot = { npc: Model, root: BasePart }
export type DoorInfo = { id: string, kind: string, state: string, access: string, lastUser: string? }

local offices: { [Model]: Registry } = {}
local records: { [Model]: Record } = {}
local active: { [Record]: boolean } = {}
local animating: { [Record]: boolean } = {}
local autos: { [Record]: boolean } = {}
local heartbeat: RBXScriptConnection? = nil
local authorizer: (Player, Model, Model) -&gt; (boolean, string?) = function()
	return false, "Door offline."
end
local notifier: (Player, string) -&gt; () = function() end
local playerSource: () -&gt; { Player } = function()
	return Players:GetPlayers()
end
local clock = 0 -- dt-driven time (tick), used for throttling
local deniedAt: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local stamp = 0
local playerCache: { stamp: number, list: { PlayerRoot } } = { stamp = -1, list = {} }
local npcCache: { [Model]: { stamp: number, list: { NpcRoot } } } = {}
local autoClock, sweepClock = 0, 0
local warned: { [string]: boolean } = {}

local function warnOnce(key: string, text: string)
	if warned[key] then
		return
	end
	warned[key] = true
	warn("[Doors] " .. text)
end

local function snapshot(set: { [Record]: boolean }): { Record }
	local list = {}
	for rec in set do
		table.insert(list, rec)
	end
	return list
end

local function rootOf(model: Instance?): BasePart?
	if model == nil then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	if model:IsA("Model") and model.PrimaryPart then
		return model.PrimaryPart
	end
	return nil
end

-- Character roots of all players for this tick (fresh = rebuild now).
local function playerRoots(fresh: boolean?): { PlayerRoot }
	if fresh or playerCache.stamp ~= stamp then
		local list: { PlayerRoot } = {}
		for _, player in playerSource() do
			local root = rootOf(player.Character)
			if root then
				table.insert(list, { player = player, root = root })
			end
		end
		playerCache = { stamp = stamp, list = list }
	end
	return playerCache.list
end

-- Employee NPC roots of one office for this tick.
local function npcRoots(office: Model, fresh: boolean?): { NpcRoot }
	local cached = npcCache[office]
	if cached and cached.stamp == stamp and not fresh then
		return cached.list
	end
	local list: { NpcRoot } = {}
	for _, name in { "Employees", "OperationsEmployees", "Visitors", "Assistant" } do
		local folder = office:FindFirstChild(name)
		if folder then
			for _, npc in folder:GetChildren() do
				if npc:IsA("Model") then
					local root = rootOf(npc)
					if root then
						table.insert(list, { npc = npc, root = root })
					end
				end
			end
		end
	end
	npcCache[office] = { stamp = stamp, list = list }
	return list
end

local function alive(rec: Record): boolean
	return rec.model.Parent ~= nil and rec.office.Parent ~= nil and records[rec.model] == rec
end

local function drop(rec: Record)
	if records[rec.model] == rec then
		records[rec.model] = nil
	end
	active[rec] = nil
	animating[rec] = nil
	autos[rec] = nil
	local reg = offices[rec.office]
	if reg then
		if reg.doors[rec.model] == rec then
			reg.doors[rec.model] = nil
		end
		if reg.byId[rec.id] == rec then
			reg.byId[rec.id] = nil
		end
	end
end

local function stateOf(rec: Record): string
	return if rec.locked and rec.state == "closed" then "locked" else rec.state
end

local function publish(rec: Record)
	local value = stateOf(rec)
	if rec.written ~= value then
		rec.written = value
		rec.model:SetAttribute("DoorState", value)
	end
end

-- Doorway geometry -------------------------------------------------------------------------------

local function inSensor(rec: Record, p: Vector3): boolean
	local sensor = rec.sensor
	if sensor and sensor.Parent then
		local v = sensor.CFrame:PointToObjectSpace(p)
		local h = sensor.Size / 2
		return math.abs(v.X) &lt;= h.X + 0.25 and math.abs(v.Y) &lt;= h.Y + 0.5 and math.abs(v.Z) &lt;= h.Z + 0.25
	end
	return (p - rec.centre).Magnitude &lt;= 5
end

local function occupied(rec: Record, fresh: boolean?): boolean
	for _, entry in playerRoots(fresh) do
		local p = entry.root.Position
		if (p - rec.centre).Magnitude &lt;= rec.reach and inSensor(rec, p) then
			return true
		end
	end
	for _, entry in npcRoots(rec.office, fresh) do
		local p = entry.root.Position
		if (p - rec.centre).Magnitude &lt;= rec.reach and inSensor(rec, p) then
			return true
		end
	end
	return false
end

-- True on the protected side (or when the door's orientation is unknown: never trap anybody).
local function secureSide(rec: Record, p: Vector3): boolean
	if rec.normal.Magnitude &lt; 0.5 then
		return true
	end
	return (p - rec.centre):Dot(rec.normal) &gt; 0
end

-- Animation ------------------------------------------------------------------------------------

local function ease(t: number): number
	return t * t * (3 - 2 * t)
end

local function apply(rec: Record)
	local alpha = ease(rec.progress)
	for _, leaf in rec.leaves do
		if leaf.model.Parent then
			leaf.model:PivotTo(leaf.closed:Lerp(leaf.open, alpha))
		end
	end
end

local function setCollision(rec: Record, on: boolean)
	if rec.collidable == on then
		return
	end
	rec.collidable = on
	for _, part in rec.solid do
		if part.Parent then
			part.CanCollide = on
		end
	end
end

local function playSound(rec: Record)
	local part = rec.soundPart
	if part and part.Parent then
		Sound.play(part, "door")
	end
end

local animate: (number) -&gt; ()

local function startAnimating(rec: Record)
	animating[rec] = true
	active[rec] = true
	if heartbeat == nil then
		heartbeat = RunService.Heartbeat:Connect(animate)
	end
end

local function beginOpen(rec: Record, hold: number?)
	local want = hold or rec.hold
	rec.timer = math.max(rec.timer, want)
	rec.forced = false
	if rec.state == "open" or rec.state == "opening" then
		active[rec] = true
		return -- already open or on its way: the hold was extended above
	end
	if rec.state == "closed" then
		playSound(rec)
	end
	rec.state = "opening"
	rec.pendingSolid = false
	setCollision(rec, false)
	startAnimating(rec)
	publish(rec)
end

local function beginClose(rec: Record, forced: boolean)
	if rec.state == "closed" or rec.state == "closing" then
		return
	end
	rec.state = "closing"
	rec.timer = 0
	rec.forced = forced
	startAnimating(rec)
	publish(rec)
end

local function finishClosed(rec: Record)
	rec.state = "closed"
	rec.progress = 0
	rec.forced = false
	animating[rec] = nil
	setCollision(rec, true)
	publish(rec)
end

animate = function(dt: number)
	for _, rec in snapshot(animating) do
		if not alive(rec) then
			drop(rec)
			continue
		end
		if rec.state == "opening" then
			rec.progress = math.min(1, rec.progress + dt / rec.duration)
			apply(rec)
			if rec.progress &gt;= 1 then
				rec.state = "open"
				animating[rec] = nil
				publish(rec)
			end
		elseif rec.state == "closing" then
			rec.progress = math.max(0, rec.progress - dt / rec.duration)
			apply(rec)
			if rec.progress &lt;= 0 then
				if not occupied(rec, true) then
					finishClosed(rec)
				elseif rec.forced then
					-- Manual cubicle close: shut visually, collide once the doorway is clear.
					rec.state = "closed"
					rec.forced = false
					rec.pendingSolid = true
					animating[rec] = nil
					publish(rec)
				else
					rec.state = "opening" -- somebody is in the doorway: reopen
					rec.timer = math.max(rec.timer, REOPEN_HOLD)
					publish(rec)
				end
			end
		else
			animating[rec] = nil
		end
	end
	if next(animating) == nil and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

-- Reader feedback --------------------------------------------------------------------------------

local function paint(rec: Record, kind: string?)
	for _, light in rec.lights do
		if light.part.Parent then
			light.part.Color = if kind then FEEDBACK[kind] else light.neutral
		end
	end
end

local function flash(rec: Record, kind: string)
	if #rec.lights == 0 then
		return
	end
	paint(rec, kind)
	rec.lightTimer = LIGHT_SECONDS
	active[rec] = true
end

local function grant(rec: Record, who: string?)
	rec.lastUser = who
	flash(rec, "good")
	beginOpen(rec)
end

-- Registry ---------------------------------------------------------------------------------------

local function isDoor(m: Instance): boolean
	if not m:IsA("Model") then
		return false
	end
	return CollectionService:HasTag(m, TAG) or (m:GetAttribute("DoorId") ~= nil and m:GetAttribute("DoorKind") ~= nil)
end

local function boundsCentre(parts: { BasePart }): Vector3?
	if #parts == 0 then
		return nil
	end
	local lx, ly, lz = math.huge, math.huge, math.huge
	local hx, hy, hz = -math.huge, -math.huge, -math.huge
	for _, part in parts do
		local cf, s = part.CFrame, part.Size / 2
		local r, u, b = cf.RightVector, cf.UpVector, cf.LookVector
		local ex = math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(b.X) * s.Z
		local ey = math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(b.Y) * s.Z
		local ez = math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(b.Z) * s.Z
		local p = cf.Position
		lx, ly, lz = math.min(lx, p.X - ex), math.min(ly, p.Y - ey), math.min(lz, p.Z - ez)
		hx, hy, hz = math.max(hx, p.X + ex), math.max(hy, p.Y + ey), math.max(hz, p.Z + ez)
	end
	return Vector3.new((lx + hx) / 2, (ly + hy) / 2, (lz + hz) / 2)
end

local function partsOf(root: Instance?): { BasePart }
	local out: { BasePart } = {}
	if root then
		for _, d in root:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(out, d)
			end
		end
	end
	return out
end

-- Fallback when a builder forgot SecureNormal: the plan's inward normal for this door id.
local function layoutNormal(office: Model, id: string): Vector3?
	local tier = office:GetAttribute("OfficeTier")
	local cf = office:GetAttribute("CampusCFrame")
	if typeof(tier) ~= "number" or typeof(cf) ~= "CFrame" then
		return nil
	end
	for _, d in Layout.doors(tier) do
		if d.id == id then
			return cf:VectorToWorldSpace(d.inward)
		end
	end
	return nil
end

local function add(office: Model, model: Model, reg: Registry): Record
	local rawId = model:GetAttribute("DoorId")
	local id = if rawId ~= nil then tostring(rawId) else (string.gsub(model.Name, "^Door_", ""))
	local kindAttr = model:GetAttribute("DoorKind")
	local kind = if typeof(kindAttr) == "string" then kindAttr else "solid"
	local accessAttr = model:GetAttribute("AccessClass")
	local access = if typeof(accessAttr) == "string" then accessAttr else "staff"

	local leaves: { Leaf } = {}
	local solid: { BasePart } = {}
	local leafParts: { BasePart } = {}
	for _, child in model:GetChildren() do
		if child:IsA("Model") and string.sub(child.Name, 1, 4) == "Leaf" then
			local closed, open = child:GetAttribute("ClosedPivot"), child:GetAttribute("OpenPivot")
			if typeof(closed) == "CFrame" and typeof(open) == "CFrame" then
				child:PivotTo(closed) -- registry always starts from a shut door
				table.insert(leaves, { model = child, closed = closed, open = open })
				for _, part in partsOf(child) do
					table.insert(leafParts, part)
					if part.CanCollide then
						table.insert(solid, part)
					end
				end
			else
				warnOnce(id .. child.Name, string.format("%s.%s has no ClosedPivot/OpenPivot; leaf stays static", model.Name, child.Name))
			end
		end
	end

	local sensorInst = model:FindFirstChild("Sensor")
	local sensor: BasePart? = if sensorInst and sensorInst:IsA("BasePart") then sensorInst else nil
	local centre = boundsCentre(leafParts)
		or boundsCentre(partsOf(model:FindFirstChild("Frame")))
		or (if sensor then sensor.Position else model:GetPivot().Position)

	local normalAttr = model:GetAttribute("SecureNormal")
	local normal = Vector3.zero
	if typeof(normalAttr) == "Vector3" and normalAttr.Magnitude &gt; 0.5 then
		normal = normalAttr.Unit
	else
		local fallback = layoutNormal(office, id)
		if fallback then
			normal = fallback.Unit
		else
			warnOnce("normal" .. id, model.Name .. " has no SecureNormal; both sides are treated as egress")
		end
	end

	local lights: { Light } = {}
	for _, d in model:GetDescendants() do
		if d.Name == "ReaderLight" and d:IsA("BasePart") then
			local neutral = d:GetAttribute("NeutralColor")
			table.insert(lights, { part = d, neutral = if typeof(neutral) == "Color3" then neutral else d.Color })
		end
	end

	local reach = 6
	if sensor then
		reach = (sensor.Position - centre).Magnitude + sensor.Size.Magnitude / 2 + 1
	end
	local autoAttr = model:GetAttribute("AutoOpen")
	local holdAttr = model:GetAttribute("HoldOpen")
	local approachAttr = model:GetAttribute("ApproachRadius")
	local fixture = model:GetAttribute("FixtureKey")
	local rec: Record = {
		model = model,
		office = office,
		id = id,
		kind = kind,
		access = access,
		normal = normal,
		centre = centre,
		reach = reach,
		auto = autoAttr == true or (autoAttr == nil and kind == "autoslide"),
		approach = if typeof(approachAttr) == "number" then approachAttr else DEFAULT_APPROACH[kind] or AUTO_RANGE,
		hold = if typeof(holdAttr) == "number" and holdAttr &gt; 0 then holdAttr else DEFAULT_HOLD[kind] or 5,
		hidden = model:GetAttribute("Hidden") == true or HIDDEN_KINDS[kind] == true,
		duration = DURATION[kind] or DEFAULT_DURATION,
		fixture = if fixture ~= nil then tostring(fixture) else nil,
		leaves = leaves,
		solid = solid,
		sensor = sensor,
		lights = lights,
		soundPart = sensor or leafParts[1],
		state = "closed",
		progress = 0,
		timer = 0,
		locked = false,
		forced = false,
		pendingSolid = false,
		collidable = true,
		lightTimer = 0,
		lastUser = nil,
		written = nil,
	}
	for _, part in solid do
		part.CanCollide = true
	end
	if reg.byId[id] and reg.byId[id].model ~= model then
		warnOnce("dup" .. id, "duplicate DoorId " .. id .. " in one office")
	end
	records[model] = rec
	reg.doors[model] = rec
	reg.byId[id] = rec
	if rec.auto then
		autos[rec] = true
	end
	publish(rec)
	return rec
end

-- Record for a door model; lazily registers doors added to an already registered office.
local function ensure(door: Instance?): Record?
	if door == nil or not door:IsA("Model") then
		return nil
	end
	local rec = records[door]
	if rec then
		if alive(rec) then
			return rec
		end
		drop(rec)
		return nil
	end
	local office = door:FindFirstAncestor("Office")
	if office and office:IsA("Model") and offices[office] and door.Parent and isDoor(door) then
		return add(office, door, offices[office])
	end
	return nil
end

local function toiletBusy(rec: Record, humanoid: Humanoid?): boolean
	local key = rec.fixture
	local reg = offices[rec.office]
	if key == nil or reg == nil then
		return false
	end
	local toilets = reg.toilets
	if toilets == nil then
		local map: { [string]: Seat } = {}
		for _, d in rec.office:GetDescendants() do
			if d.Name == "ToiletSeat" and d:IsA("Seat") and d:GetAttribute("FixtureKey") ~= nil then
				map[tostring(d:GetAttribute("FixtureKey"))] = d
			end
		end
		reg.toilets = map
		toilets = map
	end
	local seat: Seat? = (toilets :: { [string]: Seat })[key]
	if not seat or not seat.Parent then
		return false
	end
	local occupant = seat.Occupant
	return occupant ~= nil and occupant ~= humanoid
end

local function authorize(player: Player, rec: Record): (boolean, string?)
	local ok, allowed, reason = pcall(authorizer, player, rec.office, rec.model)
	if not ok then
		warnOnce("auth", "authorizer failed: " .. tostring(allowed))
		return false, "Door offline."
	end
	return allowed == true, reason
end

-- Denied approach at an automatic door: red reader + one notice per player every few seconds.
local function deny(rec: Record, player: Player, reason: string?)
	local last = deniedAt[player]
	if last and clock - last &lt; DENY_COOLDOWN then
		return
	end
	deniedAt[player] = clock
	flash(rec, "bad")
	if not pcall(notifier, player, reason or "Access denied.") then
		warnOnce("notify", "notifier failed")
	end
end

local function autoCheck(rec: Record)
	local opened = false
	for _, entry in playerRoots() do
		local p = entry.root.Position
		if (p - rec.centre).Magnitude &lt;= rec.approach then
			local allowed: boolean, reason: string? = secureSide(rec, p), nil
			if not allowed then
				if rec.locked then
					reason = "Locked."
				else
					allowed, reason = authorize(entry.player, rec)
				end
			end
			if allowed then
				if not opened then
					rec.lastUser = entry.player.Name
					beginOpen(rec)
					opened = true
				end
			else
				deny(rec, entry.player, reason)
			end
		end
	end
	if opened then
		return
	end
	local owner = rec.office:GetAttribute("OwnerUserId")
	for _, entry in npcRoots(rec.office) do
		local p = entry.root.Position
		if (p - rec.centre).Magnitude &lt;= rec.approach and entry.npc:GetAttribute("OwnerUserId") == owner then
			local role = entry.npc:GetAttribute("RoleId")
			if secureSide(rec, p) or (not rec.locked and Plan.roleAllows(if typeof(role) == "string" then role else "support", rec.access)) then
				beginOpen(rec)
				return
			end
		end
	end
end

local function sweep()
	for office, reg in offices do
		if office.Parent == nil then
			Doors.unregister(office)
		else
			for model, rec in reg.doors do
				if model.Parent == nil then
					drop(rec)
				end
			end
		end
	end
end

-- Public API -----------------------------------------------------------------------------------

function Doors.init()
	autoClock, sweepClock = 0, 0
end

-- fn(player, office, door) -&gt; (allowed, denyReason?) for entry from the non-secure side.
function Doors.setAuthorizer(fn: (Player, Model, Model) -&gt; (boolean, string?))
	authorizer = fn
end

-- fn(player, text): shows a short notice (FacilityService → CAMPUS_NOTICE). Used for denied approaches.
function Doors.setNotifier(fn: (Player, string) -&gt; ())
	notifier = fn
end

-- Test seam: replaces Players:GetPlayers() (the headless harness has no real players).
function Doors._setPlayerSource(fn: () -&gt; { Player })
	playerSource = fn
end

function Doors.register(office: Model)
	if offices[office] then
		Doors.unregister(office)
	end
	local reg: Registry = { doors = {}, byId = {}, toilets = nil }
	offices[office] = reg
	local seen: { [Instance]: boolean } = {}
	local function consider(m: Instance)
		if seen[m] or not m:IsA("Model") or not isDoor(m) then
			return
		end
		seen[m] = true
		add(office, m, reg)
	end
	local folder = office:FindFirstChild("Doors")
	if folder then
		for _, m in folder:GetDescendants() do
			consider(m)
		end
	end
	-- Doors parked elsewhere in the office (e.g. an appliance door inside a room model).
	for _, m in CollectionService:GetTagged(TAG) do
		if m:IsDescendantOf(office) then
			consider(m)
		end
	end
end

function Doors.unregister(office: Model)
	local reg = offices[office]
	npcCache[office] = nil
	if reg == nil then
		return
	end
	offices[office] = nil
	for model, rec in reg.doors do
		if records[model] == rec then
			records[model] = nil
		end
		active[rec] = nil
		animating[rec] = nil
		autos[rec] = nil
	end
end

function Doors.tick(dt: number)
	stamp += 1
	clock += dt
	for _, rec in snapshot(active) do
		if not alive(rec) then
			drop(rec)
			continue
		end
		if rec.lightTimer &gt; 0 then
			rec.lightTimer -= dt
			if rec.lightTimer &lt;= 0 then
				rec.lightTimer = 0
				paint(rec, nil)
			end
		end
		if rec.state == "open" then
			if occupied(rec) then
				rec.timer = math.max(rec.timer, OCCUPIED_HOLD)
			end
			rec.timer -= dt
			if rec.timer &lt;= 0 then
				beginClose(rec, false)
			end
		elseif rec.state == "closing" then
			if not rec.forced and occupied(rec) then
				beginOpen(rec, REOPEN_HOLD)
			end
		elseif rec.state == "closed" and rec.pendingSolid and not occupied(rec) then
			rec.pendingSolid = false
			setCollision(rec, true)
		end
		if rec.state == "closed" and not rec.pendingSolid and rec.lightTimer &lt;= 0 then
			active[rec] = nil
		end
	end
	autoClock += dt
	if autoClock &gt;= AUTO_POLL then
		autoClock = 0
		for _, rec in snapshot(autos) do
			if alive(rec) then
				autoCheck(rec)
			else
				drop(rec)
			end
		end
	end
	sweepClock += dt
	if sweepClock &gt;= SWEEP_SECONDS then
		sweepClock = 0
		sweep()
	end
end

-- Player request (prompt). `side` is the prompt's Side attribute and only advisory: the player's
-- position relative to SecureNormal decides whether this is egress.
function Doors.request(player: Player, door: Model, side: string?): (boolean, string?)
	local _ = side
	local rec = ensure(door)
	if rec == nil then
		return false, "This door is not connected."
	end
	local character = player.Character
	local root = rootOf(character)
	if root == nil or (root.Position - rec.centre).Magnitude &gt; REQUEST_RANGE then
		return false, "Move closer to the door."
	end
	local inside = secureSide(rec, root.Position)
	if rec.kind == "cubicle" then
		if rec.state == "open" or rec.state == "opening" then
			rec.lastUser = player.Name
			beginClose(rec, true) -- toggle shut; collision returns once the doorway is clear
			return true
		end
		if not inside then
			if rec.locked then
				flash(rec, "bad")
				return false, "Locked."
			end
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if toiletBusy(rec, humanoid) then
				flash(rec, "busy")
				return false, "Occupied"
			end
		end
		grant(rec, player.Name)
		return true
	end
	if inside then
		grant(rec, player.Name) -- egress always works
		return true
	end
	if rec.locked then
		flash(rec, "bad")
		return false, "Locked."
	end
	local ok, reason = authorize(player, rec)
	if not ok then
		flash(rec, "bad")
		return false, reason or "Access denied."
	end
	grant(rec, player.Name)
	return true
end

-- Employee request (navigation). The NPC must belong to the door's office and stand close.
function Doors.requestNPC(npc: Model, door: Model): boolean
	local rec = ensure(door)
	if rec == nil or rec.hidden then
		return false
	end
	local office = npc:FindFirstAncestor("Office")
	if office == nil or office ~= rec.office or door:FindFirstAncestor("Office") ~= office then
		return false
	end
	if npc:GetAttribute("OwnerUserId") ~= office:GetAttribute("OwnerUserId") then
		return false
	end
	local root = rootOf(npc)
	if root == nil or (root.Position - rec.centre).Magnitude &gt; NPC_RANGE then
		return false
	end
	if not secureSide(rec, root.Position) then
		local roleAttr = npc:GetAttribute("RoleId")
		local role = if typeof(roleAttr) == "string" then roleAttr else "support"
		if rec.locked or not Plan.roleAllows(role, rec.access) then
			flash(rec, "bad")
			return false
		end
		if rec.kind == "cubicle" and toiletBusy(rec, npc:FindFirstChildOfClass("Humanoid")) then
			return false
		end
	end
	local name = npc:GetAttribute("EmployeeName")
	grant(rec, if typeof(name) == "string" then name else npc.Name)
	return true
end

function Doors.state(door: Model): string
	local rec = ensure(door)
	if rec then
		return stateOf(rec)
	end
	local attr = door:GetAttribute("DoorState")
	return if typeof(attr) == "string" then attr else "unknown"
end

function Doors.isPassable(door: Model): boolean
	local rec = ensure(door)
	return rec ~= nil and rec.state == "open"
end

function Doors.doorsNear(office: Model, position: Vector3, radius: number): { Model }
	local reg = offices[office]
	if reg == nil then
		return {}
	end
	local found: { { model: Model, d: number } } = {}
	for model, rec in reg.doors do
		local d = (rec.centre - position).Magnitude
		if d &lt;= radius and model.Parent then
			table.insert(found, { model = model, d = d })
		end
	end
	table.sort(found, function(a, b)
		return a.d &lt; b.d
	end)
	local out: { Model } = {}
	for _, f in found do
		table.insert(out, f.model)
	end
	return out
end

function Doors.find(office: Model, doorId: string): Model?
	local reg = offices[office]
	local rec = if reg then reg.byId[doorId] else nil
	if rec and alive(rec) then
		return rec.model
	end
	local folder = office:FindFirstChild("Doors")
	local model = if folder then folder:FindFirstChild("Door_" .. doorId, true) else nil
	if model and model:IsA("Model") and ensure(model) then
		return model
	end
	return nil
end

-- Lockdown: blocks entry from the non-secure side; egress keeps working.
function Doors.lockAll(office: Model, locked: boolean)
	local reg = offices[office]
	if reg == nil then
		return
	end
	for _, rec in reg.doors do
		rec.locked = locked
		if locked and rec.kind ~= "cubicle" and (rec.state == "open" or rec.state == "opening") then
			beginClose(rec, false)
		end
		publish(rec)
	end
end

function Doors.inspect(office: Model): { DoorInfo }
	local out: { DoorInfo } = {}
	local reg = offices[office]
	if reg then
		for _, rec in reg.doors do
			table.insert(out, { id = rec.id, kind = rec.kind, state = stateOf(rec), access = rec.access, lastUser = rec.lastUser })
		end
	end
	table.sort(out, function(a, b)
		return a.id &lt; b.id
	end)
	return out
end

return Doors
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000021"><Properties><string name="Name">ExteriorDesign</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Exterior generator: the structure (slabs, atrium edges, columns, skylight), the facade envelope with
-- its exterior doors, the entrance portal and canopy, the garage shell and ramp, the foundations and the
-- landscaped site (arrival plaza, campus arcade, rear garden, service yard). Concept: a readable stone
-- plinth, a main body of stone bands and fins with oak sun screens, a glazed lantern over the double-height
-- reception hall and a set-back glass founder storey under a thin floating roof.
-- Everything is building-local (`ctx.cf * CFrame.new(...)`), so it works on every plot orientation.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout = require(ReplicatedStorage.Shared.BuildingLayout)
local A = require(ReplicatedStorage.Shared.Config.ArchPalette)
local CampusConfig = require(ReplicatedStorage.Shared.Config.CampusConfig)
local Kit = require(script.Parent.ArchKit)
local HotelKit = require(script.Parent.RoomKitsHotel) -- built lettering of the guest-house signs

type Opts = Kit.Opts
type Rect = { x1: number, x2: number, z1: number, z2: number }
-- A facade line: axis "x" runs along X at z = c, axis "z" runs along Z at x = c. `out` is the outward
-- normal sign; facade coordinates are (a along the line, y, d = distance outward from the line).
-- Holes are door openings in (a, y) space (stored as Rect x = a, z = y).
type Face = { id: string, axis: string, c: number, out: number, model: Model, holes: { Rect } }
type Seg = { a1: number, a2: number, t: string }
type Vert = { f: Face, name: string, a: number, w: number, d1: number, d2: number, color: Color3, mat: Enum.Material, opts: Opts?, spans: { { number } } }
type StoreyOpts = {
	tier: number,
	level: number,
	grid: number, -- mullion grid offset (positions offset + k * pitch)
	pitch: number?,
	skip: { number }?, -- positions hidden by pilasters / fins
	skipW: number?,
	mullionW: number?,
	transom: number?, -- transom height (y) over glass segments
	vy1: number?, -- vertical span used for mullions (lets them merge through bands)
	vy2: number?,
	louvres: boolean?, -- horizontal oak louvres over glass segments
}

local Exterior = {}

local C = A.color
local M = A.material
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local PI = math.pi

local DETAIL: Opts = { detail = true }
local GLASS: Opts = { transparency = A.glassTransparency, castShadow = false }
local RAIL_GLASS: Opts = { transparency = A.railTransparency, castShadow = false }
local WATER: Opts = { transparency = 0.3, castShadow = false, canCollide = false, canQuery = false, canTouch = false }

-- Room kinds that get a solid stone panel ("solid") or a high strip window ("slot") instead of full glazing.
local TREAT: { [string]: string } = {
	sauna = "solid", vault = "solid", secret_lab = "solid", archive = "solid", ups = "solid", plant = "solid", machine = "solid",
	founder_bath = "slot", restrooms = "slot", showers = "slot", wc = "slot", kitchen_boh = "slot", delivery = "slot",
	compute = "slot", security = "slot", prototype = "slot",
	hotel_pantry = "slot", hotel_service = "slot",
}

-- Building CFrame of the build in progress (builds never yield, so module state is safe).
local B: CFrame = CFrame.identity
local verts: { Vert } = {}
local vindex: { [string]: Vert } = {}

---------------------------------------------------------------------------------------------
-- Geometry helpers
---------------------------------------------------------------------------------------------
-- Axis-aligned box from building-local extents.
local function box(parent: Instance, name: string, x1: number, x2: number, y1: number, y2: number, z1: number, z2: number, color: Color3, mat: Enum.Material, opts: Opts?): Part?
	if x2 - x1 &lt; 0.01 or y2 - y1 &lt; 0.01 or z2 - z1 &lt; 0.01 then
		return nil
	end
	return Kit.part(parent, B, name, V3(x2 - x1, y2 - y1, z2 - z1), CF((x1 + x2) / 2, (y1 + y2) / 2, (z1 + z2) / 2), color, mat, opts)
end

local function uniq(t: { number }): { number }
	table.sort(t)
	local out: { number } = {}
	for _, v in t do
		if #out == 0 or v - out[#out] &gt; 1e-4 then
			table.insert(out, v)
		end
	end
	return out
end

-- Rectangle minus holes, decomposed into few rectangles (grid cells merged greedily).
local function subtract(r: Rect, holes: { Rect }): { Rect }
	local xs, zs = { r.x1, r.x2 }, { r.z1, r.z2 }
	local hs: { Rect } = {}
	for _, h in holes do
		local x1, x2 = math.max(h.x1, r.x1), math.min(h.x2, r.x2)
		local z1, z2 = math.max(h.z1, r.z1), math.min(h.z2, r.z2)
		if x2 - x1 &gt; 1e-3 and z2 - z1 &gt; 1e-3 then
			table.insert(hs, { x1 = x1, x2 = x2, z1 = z1, z2 = z2 })
			table.insert(xs, x1)
			table.insert(xs, x2)
			table.insert(zs, z1)
			table.insert(zs, z2)
		end
	end
	if #hs == 0 then
		return { r }
	end
	xs, zs = uniq(xs), uniq(zs)
	local nx, nz = #xs - 1, #zs - 1
	local free: { { boolean } } = {}
	for i = 1, nx do
		free[i] = {}
		for j = 1, nz do
			local cx, cz = (xs[i] + xs[i + 1]) / 2, (zs[j] + zs[j + 1]) / 2
			local f = true
			for _, h in hs do
				if cx &gt; h.x1 and cx &lt; h.x2 and cz &gt; h.z1 and cz &lt; h.z2 then
					f = false
					break
				end
			end
			free[i][j] = f
		end
	end
	local out: { Rect } = {}
	for j = 1, nz do
		for i = 1, nx do
			if free[i][j] then
				local i2 = i
				while i2 + 1 &lt;= nx and free[i2 + 1][j] do
					i2 += 1
				end
				local j2 = j
				local grow = true
				while grow and j2 + 1 &lt;= nz do
					for k = i, i2 do
						if not free[k][j2 + 1] then
							grow = false
							break
						end
					end
					if grow then
						j2 += 1
					end
				end
				for k = i, i2 do
					for l = j, j2 do
						free[k][l] = false
					end
				end
				table.insert(out, { x1 = xs[i], x2 = xs[i2 + 1], z1 = zs[j], z2 = zs[j2 + 1] })
			end
		end
	end
	return out
end

-- (min, max) of s*u1 and s*u2: mirrors a span given as distances from the centre line.
local function sp(s: number, u1: number, u2: number): (number, number)
	local p, q = s * u1, s * u2
	if p &lt; q then
		return p, q
	end
	return q, p
end

---------------------------------------------------------------------------------------------
-- Facade helpers
---------------------------------------------------------------------------------------------
local function newFace(id: string, model: Model, axis: string, c: number, out: number): Face
	return { id = id, axis = axis, c = c, out = out, model = model, holes = {} }
end

local function fpart(f: Face, name: string, a1: number, a2: number, y1: number, y2: number, d1: number, d2: number, color: Color3, mat: Enum.Material, opts: Opts?): Part?
	local n1, n2 = f.c + f.out * d1, f.c + f.out * d2
	if n1 &gt; n2 then
		n1, n2 = n2, n1
	end
	if f.axis == "x" then
		return box(f.model, name, a1, a2, y1, y2, n1, n2, color, mat, opts)
	end
	return box(f.model, name, n1, n2, y1, y2, a1, a2, color, mat, opts)
end

-- Facade element that keeps every door opening of its line clear.
local function fsolid(f: Face, name: string, a1: number, a2: number, y1: number, y2: number, d1: number, d2: number, color: Color3, mat: Enum.Material, opts: Opts?)
	if a2 - a1 &lt; 0.01 or y2 - y1 &lt; 0.01 then
		return
	end
	for _, r in subtract({ x1 = a1, x2 = a2, z1 = y1, z2 = y2 }, f.holes) do
		if r.x2 - r.x1 &gt;= 0.1 and r.z2 - r.z1 &gt;= 0.1 then -- no slivers around door openings
			fpart(f, name, r.x1, r.x2, r.z1, r.z2, d1, d2, color, mat, opts)
		end
	end
end

-- Vertical element (fin, mullion, pier). Spans registered per storey are merged into one part per line.
local function vert(f: Face, name: string, a: number, w: number, d1: number, d2: number, y1: number, y2: number, color: Color3, mat: Enum.Material, opts: Opts?)
	if y2 - y1 &lt; 0.05 then
		return
	end
	local key = string.format("%s|%s|%.3f|%.3f|%.3f|%.3f", f.id, name, a, w, d1, d2)
	local v: Vert? = vindex[key]
	if not v then
		local nv: Vert = { f = f, name = name, a = a, w = w, d1 = d1, d2 = d2, color = color, mat = mat, opts = opts, spans = {} }
		vindex[key] = nv
		table.insert(verts, nv)
		v = nv
	end
	table.insert((v :: Vert).spans, { y1, y2 })
end

local function flushVerts()
	for _, v in verts do
		table.sort(v.spans, function(p, q)
			return p[1] &lt; q[1]
		end)
		local lo, hi = v.spans[1][1], v.spans[1][2]
		for i = 2, #v.spans do
			local s = v.spans[i]
			if s[1] &lt;= hi + 0.05 then
				hi = math.max(hi, s[2])
			else
				fsolid(v.f, v.name, v.a - v.w / 2, v.a + v.w / 2, lo, hi, v.d1, v.d2, v.color, v.mat, v.opts)
				lo, hi = s[1], s[2]
			end
		end
		fsolid(v.f, v.name, v.a - v.w / 2, v.a + v.w / 2, lo, hi, v.d1, v.d2, v.color, v.mat, v.opts)
	end
	table.clear(verts)
	table.clear(vindex)
end

local function grid(a1: number, a2: number, offset: number, pitch: number): { number }
	local out: { number } = {}
	for k = math.ceil((a1 + 0.3 - offset) / pitch), math.floor((a2 - 0.3 - offset) / pitch) do
		table.insert(out, offset + k * pitch)
	end
	return out
end

local function hidden(a: number, list: { number }?, w: number?): boolean
	if not list then
		return false
	end
	local half = (w or 1) / 2 + 0.25
	for _, p in list do
		if math.abs(a - p) &lt; half then
			return true
		end
	end
	return false
end

-- Facade treatment segments along [a1, a2] from the rooms behind the line (privacy reads on the outside).
local function segments(tier: number, level: number, f: Face, a1: number, a2: number): { Seg }
	local marks: { Seg } = {}
	for _, r in Plan.roomsOnLevel(tier, level) do
		local t = TREAT[r.kind]
		if t then
			local edge, r1, r2
			if f.axis == "x" then
				edge, r1, r2 = if f.out &gt; 0 then r.z2 else r.z1, r.x1, r.x2
			else
				edge, r1, r2 = if f.out &gt; 0 then r.x2 else r.x1, r.z1, r.z2
			end
			if math.abs(edge - f.c) &lt; 0.01 then
				local s1, s2 = math.max(r1, a1), math.min(r2, a2)
				if s2 - s1 &gt; 0.01 then
					table.insert(marks, { a1 = s1, a2 = s2, t = t })
				end
			end
		end
	end
	table.sort(marks, function(p, q)
		return p.a1 &lt; q.a1
	end)
	local out: { Seg } = {}
	local cur = a1
	for _, m in marks do
		if m.a1 &gt; cur + 0.01 then
			table.insert(out, { a1 = cur, a2 = m.a1, t = "glass" })
		end
		local s1 = math.max(m.a1, cur)
		if m.a2 &gt; s1 + 0.01 then
			table.insert(out, { a1 = s1, a2 = m.a2, t = m.t })
			cur = m.a2
		end
	end
	if a2 &gt; cur + 0.01 then
		table.insert(out, { a1 = cur, a2 = a2, t = "glass" })
	end
	return out
end

-- One storey of an envelope line between yb and yt: glass with mullions, or stone panels / strip windows
-- where the rooms behind need privacy. One glass layer on the line (d 0..0.2), mullions every `pitch`.
local function storey(f: Face, a1: number, a2: number, yb: number, yt: number, o: StoreyOpts)
	local pitch = o.pitch or 4
	local mw = o.mullionW or 0.15
	local vy1, vy2 = o.vy1 or yb, o.vy2 or yt
	local segs = segments(o.tier, o.level, f, a1, a2)
	for _, s in segs do
		local s1, s2 = s.a1, s.a2
		if s.t == "glass" then
			fsolid(f, "Glass", s1, s2, yb, yt, 0, 0.2, C.glass, M.glass, GLASS)
			local tr = o.transom
			if tr then
				fsolid(f, "Transom", s1, s2, tr, tr + 0.3, 0, 0.45, C.metal, M.metal, DETAIL)
			end
			if o.louvres then
				for k = 0, 2 do
					local y = yt - 3.2 + k * 1.0
					fsolid(f, "Louvre", s1, s2, y, y + 0.3, 1.85, 2.75, C.oak, M.wood, DETAIL)
				end
			end
			for _, a in grid(s1, s2, o.grid, pitch) do
				if not hidden(a, o.skip, o.skipW) then
					vert(f, "Mullion", a, mw, 0, 0.45, vy1, vy2, C.metal, M.metal, DETAIL)
				end
			end
		elseif s.t == "slot" then
			local y1, y2 = yb + (yt - yb) * 0.62, yb + (yt - yb) * 0.85
			fsolid(f, "Panel", s1, s2, yb, y1, 0, 0.9, C.stone, M.stone)
			fsolid(f, "Glass", s1, s2, y1, y2, 0, 0.2, C.glass, M.glass, GLASS)
			fsolid(f, "Panel", s1, s2, y2, yt, 0, 0.9, C.stone, M.stone)
			if o.louvres then
				for k = 0, 1 do
					local y = y1 + (y2 - y1) * (0.3 + 0.4 * k)
					fsolid(f, "Louvre", s1, s2, y - 0.15, y + 0.15, 0.85, 1.65, C.oak, M.wood, DETAIL)
				end
			end
			for _, a in grid(s1, s2, o.grid, pitch * 2) do
				if not hidden(a, o.skip, o.skipW) then
					vert(f, "Mullion", a, mw, 0.1, 0.6, y1, y2, C.metal, M.metal, DETAIL)
				end
			end
		else
			fsolid(f, "Panel", s1, s2, yb, yt, 0, 0.9, C.stone, M.stone)
		end
	end
end

-- Glass balustrade on top of a parapet/upstand (top = y + 2.6).
local function glassRail(f: Face, a1: number, a2: number, y: number, d: number)
	fsolid(f, "RailGlass", a1, a2, y, y + 2.4, d - 0.08, d + 0.08, C.glass, M.glass, RAIL_GLASS)
	fsolid(f, "RailCap", a1, a2, y + 2.4, y + 2.6, d - 0.2, d + 0.2, C.metal, M.metal)
end

-- Vertical oak sun-screen lamellas across a bay between two fins (b1 &lt; b2 are the fin centres).
local function lamellas(f: Face, b1: number, b2: number, y1: number, y2: number)
	local c1, c2 = b1 + 0.8, b2 - 0.8
	local n = math.max(1, math.floor((c2 - c1) / 1.2 + 0.5))
	for i = 0, n do
		vert(f, "Lamella", c1 + i * (c2 - c1) / n, 0.35, 1.95, 2.6, y1, y2, C.oak, M.wood, DETAIL)
	end
end

-- Two-storey dark metal box frame in front of a bay.
local function boxFrame(f: Face, b1: number, b2: number, y1: number, y2: number)
	fsolid(f, "BoxFrame", b1 - 0.6, b1 + 0.2, y1, y2, 2.7, 3.6, C.metal, M.metal)
	fsolid(f, "BoxFrame", b2 - 0.2, b2 + 0.6, y1, y2, 2.7, 3.6, C.metal, M.metal)
	fsolid(f, "BoxFrame", b1 + 0.2, b2 - 0.2, y1, y1 + 0.8, 2.7, 3.6, C.metal, M.metal)
	fsolid(f, "BoxFrame", b1 + 0.2, b2 - 0.2, y2 - 0.8, y2, 2.7, 3.6, C.metal, M.metal)
end

-- Glass balustrade with base shoe and oak handrail along a slab edge (top 3.85 above the slab).
local function slabRail(parent: Instance, axis: string, c: number, a1: number, a2: number, y: number)
	if a2 - a1 &lt; 0.2 then
		return
	end
	local function b(name: string, n1: number, n2: number, y1: number, y2: number, color: Color3, mat: Enum.Material, opts: Opts?)
		if axis == "x" then
			box(parent, name, a1, a2, y1, y2, c + n1, c + n2, color, mat, opts)
		else
			box(parent, name, c + n1, c + n2, y1, y2, a1, a2, color, mat, opts)
		end
	end
	b("RailShoe", -0.15, 0.15, y, y + 0.25, C.metal, M.metal)
	b("RailGlass", -0.06, 0.06, y + 0.25, y + 3.55, C.glass, M.glass, RAIL_GLASS)
	b("Handrail", -0.2, 0.2, y + 3.55, y + 3.85, C.oak, M.wood)
end

-- Metal guard rail (posts every ~8, mid and top rail) from y to y + 2.6 along a line.
local function metalRail(parent: Instance, axis: string, c: number, a1: number, a2: number, y: number)
	local function b(name: string, p1: number, p2: number, y1: number, y2: number, w: number, opts: Opts?)
		if axis == "x" then
			box(parent, name, p1, p2, y1, y2, c - w / 2, c + w / 2, C.metal, M.metal, opts)
		else
			box(parent, name, c - w / 2, c + w / 2, y1, y2, p1, p2, C.metal, M.metal, opts)
		end
	end
	b("GuardRail", a1, a2, y + 2.4, y + 2.6, 0.25)
	b("GuardRail", a1, a2, y + 1.2, y + 1.35, 0.12, DETAIL)
	local n = math.max(1, math.ceil((a2 - a1) / 8))
	for i = 0, n do
		local p = a1 + 0.15 + i * (a2 - a1 - 0.3) / n
		b("GuardPost", p - 0.15, p + 0.15, y, y + 2.4, 0.25)
	end
end

---------------------------------------------------------------------------------------------
-- Landscape helpers
---------------------------------------------------------------------------------------------
local function tree(parent: Instance, x: number, z: number, seed: number, base: number?)
	local y = base or 0.1
	local h = Kit.range(seed, 1, 7, 10)
	local d = Kit.range(seed, 2, 6, 8)
	Kit.cylinder(parent, B, "TreeTrunk", "y", h, 0.9, CF(x, y + h / 2, z), C.oakDark, M.wood)
	Kit.ball(parent, B, "TreeCanopy", d, CF(x, y + h + d * 0.15, z), if Kit.rand(seed, 3) &lt; 0.5 then C.foliage else C.foliageLight, M.leafy, DETAIL)
	local yaw = Kit.range(seed, 4, 0, 2 * PI)
	Kit.ball(parent, B, "TreeCanopy", d * 0.72, CF(x, y + h - d * 0.1, z) * ANG(0, yaw, 0) * CF(d * 0.32, 0, 0), C.foliageLight, M.leafy, DETAIL)
	Kit.ball(parent, B, "TreeCanopy", d * 0.62, CF(x, y + h + d * 0.2, z) * ANG(0, yaw + 2.4, 0) * CF(d * 0.3, 0, 0), C.foliage, M.leafy, DETAIL)
end

-- Raised stone planting island with a lawn top, two shrubs and one tree.
local function island(parent: Instance, x1: number, x2: number, z1: number, z2: number, seed: number)
	box(parent, "PlanterIsland", x1, x2, 0, 1.3, z1, z2, C.stoneDeep, M.stone)
	box(parent, "PlanterLawn", x1 + 0.5, x2 - 0.5, 1.3, 1.42, z1 + 0.5, z2 - 0.5, C.grass, M.grass)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	local alongX = x2 - x1 &gt;= z2 - z1
	for _, k in { -1, 1 } do
		local off = (if alongX then x2 - x1 else z2 - z1) * 0.32 * k
		local sx, sz = if alongX then cx + off else cx, if alongX then cz else cz + off
		Kit.ball(parent, B, "Shrub", Kit.range(seed, 10 + k, 2.0, 2.8), CF(sx, 2.0, sz), if k &gt; 0 then C.foliage else C.foliageLight, M.leafy, DETAIL)
	end
	tree(parent, cx, cz, seed, 1.42)
end

local function bollard(parent: Instance, x: number, z: number, lit: boolean)
	Kit.cylinder(parent, B, "Bollard", "y", 3, 0.6, CF(x, 0.12 + 1.5, z), C.metal, M.metal)
	local glow = box(parent, "BollardLight", x - 0.22, x + 0.22, 2.4, 2.8, z - 0.32, z + 0.32, C.lightWarm, M.neon, DETAIL)
	if lit and glow then
		Kit.light(glow, "point", C.lightWarm, 12, 0.6)
	end
end

local function publicPrompt(part: Instance, objectText: string, app: string?, action: string?, value: any?): ProximityPrompt
	-- same contract as the original store terminals: public, no line of sight, 12 studs
	local q = Instance.new("ProximityPrompt")
	q.ActionText = if action then "Use" else "Open"
	q.ObjectText = objectText
	q.MaxActivationDistance = 12
	q.RequiresLineOfSight = false
	q.HoldDuration = 0
	q:SetAttribute("Public", true)
	if app then
		q:SetAttribute("App", app)
	end
	if action then
		q:SetAttribute("CampusAction", action)
		q:SetAttribute("Value", value)
	end
	q.Parent = part
	return q
end

---------------------------------------------------------------------------------------------
-- 1. Structure: slabs, atrium edges, columns, skylight
---------------------------------------------------------------------------------------------
local function structure(ctx: any)
	local tier: number = ctx.tier
	local folder: Instance = ctx.folders.Structure
	local roof = Plan.roofLevel(tier)
	local founder = Plan.founderLevel(tier)
	local RY = Plan.levelY(roof)

	local slabs = Kit.model(folder, "Slabs")
	for level = -1, roof do
		local y = Plan.levelY(level)
		local rects, holes = Layout.slabs(tier, level)
		local hs: { Rect } = {}
		for _, h in holes do
			table.insert(hs, { x1 = h.x1, x2 = h.x2, z1 = h.z1, z2 = h.z2 })
		end
		for _, r in rects do
			for _, piece in subtract({ x1 = r.x1, x2 = r.x2, z1 = r.z1, z2 = r.z2 }, hs) do
				box(slabs, "Slab", piece.x1, piece.x2, y - 1, y, piece.z1, piece.z2, C.concrete, M.concrete)
			end
		end
	end

	-- Atrium void: oak slab-edge fascias and glass balustrades on every storey up to the founder level.
	local at = Plan.ATRIUM
	local edges = Kit.model(folder, "AtriumEdges")
	local cl = 1.05 -- clearance from the corner columns
	for level = 1, founder do
		local y = Plan.levelY(level)
		box(edges, "SlabFascia", at.x1, at.x1 + 0.15, y - 1.3, y, at.z1 + 1, at.z2 - 1, C.oak, M.wood)
		box(edges, "SlabFascia", at.x2 - 0.15, at.x2, y - 1.3, y, at.z1 + 1, at.z2 - 1, C.oak, M.wood)
		box(edges, "SlabFascia", at.x1 + 1, at.x2 - 1, y - 1.3, y, at.z1, at.z1 + 0.15, C.oak, M.wood)
		box(edges, "SlabFascia", at.x1 + 1, at.x2 - 1, y - 1.3, y, at.z2 - 0.15, at.z2, C.oak, M.wood)
		slabRail(edges, "z", at.x1 - 0.3, at.z1 + cl, at.z2 - cl, y)
		slabRail(edges, "z", at.x2 + 0.3, at.z1 + cl, at.z2 - cl, y)
		slabRail(edges, "x", at.z1 - 0.3, at.x1 + cl, at.x2 - cl, y)
		slabRail(edges, "x", at.z2 + 0.3, at.x1 + cl, at.x2 - cl, y)
	end
	-- Level 1: the reception-hall void; its north edge makes the gallery bridge railed on both sides.
	local v = Plan.LOBBY_VOID
	local y1 = Plan.levelY(1)
	box(edges, "SlabFascia", v.x1 + 0.5, v.x2 - 0.5, y1 - 1.3, y1, v.z2 - 0.15, v.z2, C.oak, M.wood)
	slabRail(edges, "x", v.z2 + 0.3, v.x1 + 0.5, v.x2 - 0.5, y1)

	-- Round stone columns at the four void corners, ground floor to the roof slab.
	local cols = Kit.model(folder, "AtriumColumns")
	for _, p in { { at.x1, at.z1 }, { at.x2, at.z1 }, { at.x1, at.z2 }, { at.x2, at.z2 } } do
		Kit.cylinder(cols, B, "AtriumColumn", "y", RY - 1, 2.0, CF(p[1], (RY - 1) / 2, p[2]), C.stone, M.stone)
	end

	-- Roof skylight over the atrium: stone curb, glass, dark metal grid, guard railing around it.
	local sky = Kit.model(folder, "Skylight")
	local e = 0.6
	box(sky, "SkylightCurb", at.x1 - e, at.x2 + e, RY, RY + 1, at.z1 - e, at.z1, C.stoneDeep, M.stone)
	box(sky, "SkylightCurb", at.x1 - e, at.x2 + e, RY, RY + 1, at.z2, at.z2 + e, C.stoneDeep, M.stone)
	box(sky, "SkylightCurb", at.x1 - e, at.x1, RY, RY + 1, at.z1, at.z2, C.stoneDeep, M.stone)
	box(sky, "SkylightCurb", at.x2, at.x2 + e, RY, RY + 1, at.z1, at.z2, C.stoneDeep, M.stone)
	box(sky, "SkylightGlass", at.x1 - e, at.x2 + e, RY + 1, RY + 1.15, at.z1 - e, at.z2 + e, C.glass, M.glass, GLASS)
	for x = at.x1 + 4, at.x2 - 4, 4 do
		box(sky, "SkylightBar", x - 0.12, x + 0.12, RY + 1.15, RY + 1.4, at.z1 - e, at.z2 + e, C.metal, M.metal, DETAIL)
	end
	for z = at.z1 + 4, at.z2 - 4, 4 do
		box(sky, "SkylightBar", at.x1 - e, at.x2 + e, RY + 1.15, RY + 1.4, z - 0.12, z + 0.12, C.metal, M.metal, DETAIL)
	end
	local g = 1.0 -- just outside the curb: keeps ~5 studs clear in front of the roof lobby doors (z 42)
	slabRail(sky, "z", at.x1 - g, at.z1 - g, at.z2 + g, RY)
	slabRail(sky, "z", at.x2 + g, at.z1 - g, at.z2 + g, RY)
	slabRail(sky, "x", at.z1 - g, at.x1 - g + 0.2, at.x2 + g - 0.2, RY)
	slabRail(sky, "x", at.z2 + g, at.x1 - g + 0.2, at.x2 + g - 0.2, RY)
end

---------------------------------------------------------------------------------------------
-- 4. Facades + exterior doors
---------------------------------------------------------------------------------------------
local function facades(ctx: any)
	local tier: number = ctx.tier
	local folder: Instance = ctx.folders.Facade
	local F = Plan.founderLevel(tier)
	local R = Plan.roofLevel(tier)
	local FY, RY = Plan.levelY(F), Plan.levelY(R)

	local function model(name: string): Model
		return Kit.model(folder, name)
	end
	local front = newFace("front", model("Facade_Front"), "x", Plan.MAIN.z1, -1)
	local west = newFace("west", model("Facade_West"), "z", Plan.MAIN.x1, -1)
	local east = newFace("east", model("Facade_East"), "z", Plan.MAIN.x2, 1)
	local back = newFace("back", model("Facade_Back"), "x", Plan.MAIN.z2, 1)
	local founder = newFace("founder", model("Facade_Founder"), "x", Plan.FOUNDER_FRONT_Z, -1)
	local pwest = newFace("pwest", model("Facade_PavilionWest"), "z", Plan.PAVILION.x1, -1)
	local peast = newFace("peast", model("Facade_PavilionEast"), "z", Plan.PAVILION.x2, 1)
	local pback = newFace("pback", model("Facade_PavilionBack"), "x", Plan.PAVILION.z2, 1)
	local faces = { front, west, east, back, founder, pwest, peast, pback }

	-- Door openings first, so every element of the line keeps them clear.
	local doors = {}
	for _, d in Layout.doors(tier) do
		if d.builder == "exterior" and d.id ~= "G_ENTRANCE" and not d.annex then
			local da = if d.axis == "x" then d.x else d.z
			local dc = if d.axis == "x" then d.z else d.x
			local y = Plan.levelY(d.level)
			local host: Face? = nil
			for _, f in faces do
				if f.axis == d.axis and math.abs(f.c - dc) &lt; 0.01 then
					table.insert(f.holes, { x1 = da - d.w / 2 - 0.6, x2 = da + d.w / 2 + 0.6, z1 = y, z2 = y + d.h + 0.6 })
					host = host or f
				end
			end
			if host then
				table.insert(doors, { def = d, face = host, a = da, y = y })
			else
				warn(`[Exterior] door {d.id} is not on a facade line`)
			end
		end
	end

	local frontGrid, sideGrid = 2, 0 -- mullion grids aligned with the interior wall lines
	---------------------------------------------------------------- front (z = -48)
	local bays = { { 66, 76 }, { 58, 66 }, { 50, 58 }, { 42, 50 }, { 34, 42 }, { 26, 34 } } -- outer -&gt; inner
	for _, s in { -1, 1 } do
		local p1, p2 = sp(s, 76, 84.5)
		fsolid(front, "CornerPier", p1, p2, 0, FY + 1.2, 0, 2.5, C.stone, M.stone)
		p1, p2 = sp(s, 22, 23.5)
		fsolid(front, "LanternPier", p1, p2, 0, FY + 1.2, 0, 2.7, C.stone, M.stone)
		local g1, g2 = sp(s, 23.5, 76)
		-- plinth: base course, glazing with transom, pilasters on the 16-stud rhythm, cornice
		local pil = { s * 34, s * 50, s * 66 }
		fsolid(front, "BaseCourse", g1, g2, 0, 0.9, 0, 1.0, C.stoneDeep, M.stone)
		storey(front, g1, g2, 0.9, 15, { tier = tier, level = 0, grid = frontGrid, skip = pil, skipW = 2.5, transom = 10.8, vy1 = 0.9, vy2 = 15 })
		for _, a in pil do
			fsolid(front, "Pilaster", a - 1.25, a + 1.25, 0, 15, 0.2, 2.2, C.stone, M.stone)
		end
		local c1, c2 = sp(s, 23.5, 85)
		fsolid(front, "Cornice", c1, c2, 15, 16.6, 0, 3.0, C.stone, M.stone)
		-- main body: stone bands, fins every 8, recessed glass, oak lamellas, box frames
		local fins: { number } = {}
		for _, u in { 26, 34, 42, 50, 58, 66 } do
			table.insert(fins, s * u)
			vert(front, "Fin", s * u, 1, 0.2, 2.7, 16.6, FY - 2, C.stone, M.stone)
		end
		for L = 1, F - 1 do
			local yb = if L == 1 then 16.6 else 16 * L + 1
			local yt = 16 * (L + 1) - 2
			storey(front, g1, g2, yb, yt, { tier = tier, level = L, grid = frontGrid, skip = fins, skipW = 1, vy1 = if L == 1 then 15 else 16 * L - 2, vy2 = yt })
			if L &gt;= 2 then
				fsolid(front, "Band", g1, g2, 16 * L - 2, 16 * L + 1, 0, 2.0, C.stone, M.stone)
			end
		end
		for p = 0, math.floor((F - 2) / 2) do
			local L1 = 1 + 2 * p
			local L2 = math.min(L1 + 1, F - 1)
			local y1 = if L1 == 1 then 16.6 else 16 * L1 + 1
			local y2 = 16 * (L2 + 1) - 2
			-- checkerboard of screened bays per floor pair; one framed bay per side, staggered up the facade
			local framed = if p % 2 == 0 then 1 else 4
			for k, bay in bays do
				local b1, b2 = sp(s, bay[1], bay[2])
				if k - 1 == framed and L2 &gt; L1 then
					boxFrame(front, b1, b2, if L1 == 1 then 15 else 16 * L1 - 2, 16 * (L2 + 1) + 1)
				elseif (k - 1 + p) % 2 == 0 then
					lamellas(front, b1, b2, y1, y2)
				end
			end
		end
	end
	-- the terrace upstand of the founder storey closes the front as one long stone band
	fsolid(front, "Band", -84.5, 84.5, FY - 2, FY + 1.2, 0, 2.0, C.stone, M.stone)
	glassRail(front, -82.5, 82.5, FY + 1.2, 0.5)

	-- lantern over the double-height reception hall: one tall glass front with dark metal fins
	for _, s in { -1, 1 } do
		local l1, l2 = sp(s, 17, 22)
		fsolid(front, "BaseCourse", l1, l2, 0, 0.9, 0, 1.0, C.stoneDeep, M.stone)
		fsolid(front, "Glass", l1, l2, 0.9, 16.6, 0, 0.2, C.glass, M.glass, GLASS)
		fsolid(front, "Transom", l1, l2, 10.8, 11.1, 0, 0.45, C.metal, M.metal, DETAIL)
		for i = 0, 4 do
			vert(front, "LanternFin", s * (2 + 4 * i), 0.3, 0.2, 1.7, 16.6, FY - 2, C.metal, M.metal)
		end
	end
	fsolid(front, "Glass", -22, 22, 16.6, FY - 2, 0, 0.2, C.glass, M.glass, GLASS)
	fsolid(front, "LanternTransom", -22, 22, 16.4, 16.9, 0, 0.8, C.metal, M.metal)
	for L = 2, F - 1 do
		fsolid(front, "LanternTransom", -22, 22, 16 * L - 0.8, 16 * L - 0.2, 0.2, 0.6, C.metal, M.metal)
	end

	---------------------------------------------------------------- sides (x = -82 / 82)
	for _, f in { west, east } do
		local isWest = f == west
		fsolid(f, "CornerPier", -48, -42, 0, FY + 1.2, 0, 2.5, C.stone, M.stone)
		fsolid(f, "CornerPier", 74, 80, 0, RY + 1.2, 0, 2.5, C.stone, M.stone)
		local pil = { -24, -8, 8, 24, 40, 56 }
		fsolid(f, "BaseCourse", -42, 74, 0, 0.9, 0, 1.0, C.stoneDeep, M.stone)
		storey(f, -42, 74, 0.9, 15, { tier = tier, level = 0, grid = sideGrid, skip = pil, skipW = 2.5, transom = 10.8, vy1 = 0.9, vy2 = 15 })
		for _, a in pil do
			fsolid(f, "Pilaster", a - 1.25, a + 1.25, 0, 15, 0.2, 2.2, C.stone, M.stone)
		end
		-- one cornice from the front corner to the pavilion's back corner ties both volumes together
		fsolid(f, "Cornice", -51, 163, 15, 16.6, 0, 3.0, C.stone, M.stone)
		local fins: { number } = {}
		for a = -32, 64, 8 do
			table.insert(fins, a)
			vert(f, "Fin", a, 1, 0.2, 2.7, 16.6, FY - 2, C.stone, M.stone)
		end
		for L = 1, F - 1 do
			local yb = if L == 1 then 16.6 else 16 * L + 1
			local yt = 16 * (L + 1) - 2
			storey(f, -42, 74, yb, yt, { tier = tier, level = L, grid = sideGrid, skip = fins, skipW = 1, vy1 = if L == 1 then 15 else 16 * L - 2, vy2 = yt })
			if L &gt;= 2 then
				fsolid(f, "Band", -42, 74, 16 * L - 2, 16 * L + 1, 0, 2.0, C.stone, M.stone)
			end
		end
		-- oak lamellas: a rhythm on the west (afternoon sun), only a few near the front on the east
		local sideBays: { { number } } = { { -42, -32 } }
		for a = -32, 56, 8 do
			table.insert(sideBays, { a, a + 8 })
		end
		table.insert(sideBays, { 64, 74 })
		for p = 0, math.floor((F - 2) / 2) do
			local L1 = 1 + 2 * p
			local L2 = math.min(L1 + 1, F - 1)
			local y1 = if L1 == 1 then 16.6 else 16 * L1 + 1
			local y2 = 16 * (L2 + 1) - 2
			for k, bay in sideBays do
				local on = if isWest then (k - 1 + p) % 3 == 0 else (k - 1 + p) % 5 == 1
				if on then
					lamellas(f, bay[1], bay[2], y1, y2)
				end
			end
		end
		-- founder floor: band (terrace upstand at the side returns), glazed storey, floating roof canopy
		fsolid(f, "Band", -42, -32, FY - 2, FY + 1.2, 0, 2.0, C.stone, M.stone)
		fsolid(f, "Band", -32, 74, FY - 2, FY + 1, 0, 2.0, C.stone, M.stone)
		storey(f, -32, 74, FY + 1, RY - 1, { tier = tier, level = F, grid = sideGrid, mullionW = 0.12 })
		fsolid(f, "CanopyPlate", -32, 74, RY - 0.6, RY, 0, 3, C.metal, M.metal)
		fsolid(f, "CanopySoffit", -32, 74, RY - 1.0, RY - 0.6, 0.2, 3, C.oak, M.wood)
		fsolid(f, "CanopyFascia", -35.3, 74, RY - 1.2, RY + 0.2, 3, 3.3, C.metal, M.metal)
		fsolid(f, "Parapet", -33, 74, RY, RY + 1.2, 0, 1.0, C.stone, M.stone)
		glassRail(f, -48.5, -32, FY + 1.2, 0.5)
		glassRail(f, -32.5, 80.5, RY + 1.2, 0.5)
	end

	---------------------------------------------------------------- founder storey (z = -32)
	fsolid(founder, "Sill", -82, 82, FY, FY + 0.3, 0, 0.45, C.metal, M.metal)
	fsolid(founder, "Glass", -82, 82, FY + 0.3, RY - 1.0, 0, 0.2, C.glass, M.glass, GLASS)
	for _, a in grid(-82, 82, frontGrid, 4) do
		vert(founder, "Mullion", a, 0.12, 0, 0.4, FY + 0.3, RY - 1.0, C.metal, M.metal, DETAIL)
	end
	for _, s in { -1, 1 } do
		local c1, c2 = sp(s, 82, 82.3)
		fpart(founder, "CornerPost", c1, c2, FY, RY - 1.0, 0, 0.3, C.metal, M.metal)
	end
	fsolid(founder, "CanopyPlate", -85, 85, RY - 0.6, RY, 0, 3, C.metal, M.metal)
	fsolid(founder, "CanopySoffit", -85, 85, RY - 1.0, RY - 0.6, 0.2, 3, C.oak, M.wood)
	fsolid(founder, "CanopyFascia", -85.3, 85.3, RY - 1.2, RY + 0.2, 3, 3.3, C.metal, M.metal)
	fsolid(founder, "Parapet", -83, 83, RY, RY + 1.2, 0, 1.0, C.stone, M.stone)
	glassRail(founder, -82.5, 82.5, RY + 1.2, 0.5)
	-- founder-level terrace floor (stone pavers, oak deck in front of the founder office)
	box(founder.model, "TerracePaving", Plan.MAIN.x1, 42, FY, FY + 0.1, Plan.MAIN.z1, Plan.FOUNDER_FRONT_Z, C.stonePave, M.pave)
	box(founder.model, "TerraceDeck", 42, Plan.MAIN.x2, FY, FY + 0.1, Plan.MAIN.z1, Plan.FOUNDER_FRONT_Z, C.oakDark, M.planks)

	---------------------------------------------------------------- back (z = 80, levels &gt;= 2)
	for _, s in { -1, 1 } do
		local p1, p2 = sp(s, 76, 84.5)
		fsolid(back, "CornerPier", p1, p2, 30, RY + 1.2, 0, 2.5, C.stone, M.stone)
	end
	local piers = { { 0, 47 } }
	for _, pc in { { 25.5, 4 }, { 34, 3 }, { 42, 3 }, { 50, 3 }, { 58, 3 }, { 66, 3 }, { 74.25, 3.5 } } do
		table.insert(piers, { pc[1], pc[2] })
		table.insert(piers, { -pc[1], pc[2] })
	end
	for L = 2, F do
		local yb, yt = 16 * L + 1, 16 * (L + 1) - 2
		fsolid(back, "Band", -76, 76, 16 * L - 2, 16 * L + 1, 0, 2.0, C.stone, M.stone)
		fsolid(back, "Glass", -76, 76, yb, yt, 0, 0.2, C.glass, M.glass, GLASS)
		fsolid(back, "Sill", -76, 76, yb, yb + 2, 0.2, 1.4, C.stone, M.stone)
		fsolid(back, "Head", -76, 76, yb + 10, yt, 0.2, 1.4, C.stone, M.stone)
		for _, pc in piers do
			vert(back, if pc[1] == 0 then "BackCore" else "BackPier", pc[1], pc[2], 0.2, 1.4, 16 * L - 2, 16 * (L + 1) - 2, C.stone, M.stone)
		end
	end
	fsolid(back, "Band", -76, 76, RY - 2, RY + 1.2, 0, 2.0, C.stone, M.stone)
	glassRail(back, -82.5, 82.5, RY + 1.2, 0.5)

	---------------------------------------------------------------- pavilion (levels 0-1, roof garden on top)
	for _, f in { pwest, peast } do
		local pil = { 96, 112, 128, 144 }
		fsolid(f, "CornerPier", 154, 160, 0, 33.2, 0, 2.5, C.stone, M.stone)
		fsolid(f, "BaseCourse", 80, 154, 0, 0.9, 0, 1.0, C.stoneDeep, M.stone)
		storey(f, 80, 154, 0.9, 15, { tier = tier, level = 0, grid = sideGrid, skip = pil, skipW = 2.5, transom = 10.8, louvres = true, vy1 = 0.9, vy2 = 15 })
		storey(f, 80, 154, 16.6, 30, { tier = tier, level = 1, grid = sideGrid, skip = pil, skipW = 2.5, louvres = true, vy1 = 15, vy2 = 30 })
		for _, a in pil do
			fsolid(f, "Pier", a - 1.25, a + 1.25, 0, 30, 0.2, 1.9, C.stone, M.stone)
		end
		fsolid(f, "Parapet", 80, 154, 30, 33.2, 0, 2.0, C.stone, M.stone)
		glassRail(f, 80, 160.5, 33.2, 0.5)
		fpart(f, "GreenRoofEdge", 80, 158.8, 32, 32.25, -1.2, 0, C.grass, M.grass, DETAIL)
	end
	do
		local f = pback
		local pil = { -64, -48, -32, -16, 0, 16, 32, 48, 64 }
		for _, s in { -1, 1 } do
			local p1, p2 = sp(s, 76, 84.5)
			fsolid(f, "CornerPier", p1, p2, 0, 33.2, 0, 2.5, C.stone, M.stone)
		end
		fsolid(f, "BaseCourse", -76, 76, 0, 0.9, 0, 1.0, C.stoneDeep, M.stone)
		storey(f, -76, 76, 0.9, 15, { tier = tier, level = 0, grid = 0, skip = pil, skipW = 2.5, transom = 10.8, louvres = true, vy1 = 0.9, vy2 = 15 })
		storey(f, -76, 76, 16.6, 30, { tier = tier, level = 1, grid = 0, skip = pil, skipW = 2.5, louvres = true, vy1 = 15, vy2 = 30 })
		for _, a in pil do
			fsolid(f, "Pier", a - 1.25, a + 1.25, 0, 30, 0.2, 1.9, C.stone, M.stone)
		end
		fsolid(f, "Cornice", -85, 85, 15, 16.6, 0, 3.0, C.stone, M.stone)
		fsolid(f, "Parapet", -76, 76, 30, 33.2, 0, 2.0, C.stone, M.stone)
		glassRail(f, -82.5, 82.5, 33.2, 0.5)
		fpart(f, "GreenRoofEdge", -80.8, 80.8, 32, 32.25, -1.2, 0, C.grass, M.grass, DETAIL)
	end

	flushVerts()

	---------------------------------------------------------------- exterior doors with stone surrounds
	for _, entry in doors do
		local d, f = entry.def, entry.face
		local a1, a2 = entry.a - d.w / 2, entry.a + d.w / 2
		local top = entry.y + d.h
		fpart(f, "OpeningJamb", a1 - 0.6, a1, entry.y, top + 0.6, 0, 1.5, C.stoneDeep, M.stone)
		fpart(f, "OpeningJamb", a2, a2 + 0.6, entry.y, top + 0.6, 0, 1.5, C.stoneDeep, M.stone)
		fpart(f, "OpeningHead", a1, a2, top, top + 0.6, 0, 1.5, C.stoneDeep, M.stone)
		local def: any = table.clone(d)
		-- the leaves sit on the glass line of the facade (0.1 outside the plan line)
		if d.axis == "x" then
			def.z = f.c + f.out * 0.1
		else
			def.x = f.c + f.out * 0.1
		end
		def.thickness = if d.kind == "service" then 0.6 else 0.4
		Kit.door(ctx.folders.Doors, B, def, ctx.owner)
	end
end

---------------------------------------------------------------------------------------------
-- 5. Entrance: portal, glazed entrance wall + automatic door, canopy, company sign
---------------------------------------------------------------------------------------------
local function entrance(ctx: any)
	local m = Kit.model(ctx.folders.Facade, "Facade_Entrance")
	local pt = Plan.PORTAL
	local z = Plan.ENTRANCE.z
	local e1, e2 = Plan.ENTRANCE.x1, Plan.ENTRANCE.x2
	box(m, "PortalFloor", pt.x1, pt.x2, 0, 0.12, pt.z1, pt.z2, C.stone, M.marble)
	box(m, "PortalJamb", pt.x1 - 3, pt.x1, 0, 16.6, pt.z1 - 1, pt.z2, C.stone, M.stone)
	box(m, "PortalJamb", pt.x2, pt.x2 + 3, 0, 16.6, pt.z1 - 1, pt.z2, C.stone, M.stone)
	box(m, "PortalHead", pt.x1, pt.x2, 12.2, 16.6, pt.z1 - 1, pt.z1 + 0.2, C.stone, M.stone)
	box(m, "PortalSoffit", pt.x1, pt.x2, 11.9, 12.2, pt.z1 + 0.2, pt.z2, C.oak, M.wood)
	-- glazed entrance wall with the automatic doors in the middle
	for _, r in { { pt.x1, e1 }, { e2, pt.x2 } } do
		box(m, "EntranceSill", r[1], r[2], 0, 0.15, z - 0.2, z + 0.2, C.metal, M.metal)
		box(m, "EntranceGlass", r[1], r[2], 0.15, 11.9, z - 0.1, z + 0.1, C.glass, M.glass, GLASS)
		local mx = (r[1] + r[2]) / 2
		box(m, "Mullion", mx - 0.08, mx + 0.08, 0.15, 11.9, z - 0.25, z + 0.25, C.metal, M.metal, DETAIL)
	end
	box(m, "EntranceTransom", e1, e2, 10, 10.3, z - 0.2, z + 0.2, C.metal, M.metal)
	box(m, "EntranceGlass", e1, e2, 10.3, 11.9, z - 0.1, z + 0.1, C.glass, M.glass, GLASS)
	for _, d in Layout.doors(ctx.tier) do
		if d.id == "G_ENTRANCE" then
			Kit.door(ctx.folders.Doors, B, d, ctx.owner)
		end
	end
	-- card reader pedestal for staff after hours (the doors open for visitors during the day)
	box(m, "CardReaderPedestal", 8.25, 8.75, 0.12, 3.8, -46.75, -46.25, C.metal, M.metal)
	box(m, "CardReaderFace", 8.3, 8.7, 3.0, 3.6, -46.85, -46.75, C.screen, M.smooth, DETAIL)
	box(m, "ReaderLight", 8.4, 8.6, 3.45, 3.52, -46.92, -46.85, C.statusGood, M.neon, DETAIL)

	-- cantilevered canopy: dark metal deck, oak soffit with three downlights, two slender columns, rods
	local cz1, cz2 = -66, pt.z1 - 0.9
	box(m, "CanopyDeck", -20, 20, 12.8, 13.8, cz1, cz2, C.metal, M.metal)
	box(m, "CanopySoffit", -19.7, 19.7, 12.6, 12.8, cz1 + 0.3, cz2, C.oak, M.wood)
	box(m, "CanopyFascia", -20.3, 20.3, 12.4, 14.0, cz1 - 0.3, cz1, C.metal, M.metal)
	for _, s in { -1, 1 } do
		local f1, f2 = sp(s, 20, 20.3)
		box(m, "CanopyFascia", f1, f2, 12.4, 14.0, cz1, cz2, C.metal, M.metal)
		Kit.cylinder(m, B, "CanopyColumn", "y", 12.48, 0.8, CF(s * 17, 0.12 + 6.24, -63), C.metal, M.metal)
		local p1, p2 = V3(s * 14, 13.9, -64.5), V3(s * 14, 27, -49.75)
		local mid = (p1 + p2) / 2
		Kit.cylinder(m, B, "TensionRod", "z", (p2 - p1).Magnitude, 0.18, CFrame.lookAt(mid, p2), C.metalSoft, M.metal, DETAIL)
		box(m, "RodAnchor", s * 14 - 0.4, s * 14 + 0.4, 26.6, 27.4, -49.9, -49.7, C.metal, M.metal, DETAIL)
	end
	for _, x in { -10, 0, 10 } do
		local lamp = box(m, "CanopyDownlight", x - 0.45, x + 0.45, 12.55, 12.6, -58.45, -57.55, C.lightWarm, M.neon, DETAIL)
		if lamp then
			Kit.light(lamp, "spot", C.lightWarm, 14, 0.9, Enum.NormalId.Bottom)
		end
	end
	-- company sign band above the canopy, on the lantern fins (direct child of the office)
	local sign = Kit.part(ctx.office, B, "SignAnchor", V3(40, 5.5, 0.4), CF(0, 20.25, -49.9), C.metal, M.metal, { canCollide = false, castShadow = false })
	Kit.text(sign, ctx.company, { guiName = "Sign", name = "Label", font = Enum.Font.BuilderSansExtraBold, maxDistance = 260, color = C.white, light = 0.2, pps = 40, pad = 0.1 })
	local wash = box(m, "SignWash", -14, 14, 13.8, 14.05, -50.7, -50.3, C.metal, M.metal, DETAIL)
	if wash then
		Kit.light(wash, "spot", C.lightWarm, 10, 0.7, Enum.NormalId.Top)
	end
end

---------------------------------------------------------------------------------------------
-- 2. Garage shell, ramp, barrier
---------------------------------------------------------------------------------------------
local RAMP = { x1 = 92, x2 = 112, zTop = -146, zBottom = -36, drop = 16 }
local function rampY(z: number): number
	return -(z - RAMP.zTop) * RAMP.drop / (RAMP.zBottom - RAMP.zTop)
end

local function garage(ctx: any)
	local m = Kit.model(ctx.folders.Site, "GarageShell")
	local g = Plan.GARAGE
	local by = Plan.B1_Y - 1
	box(m, "GarageWall", g.x1 - 1, g.x1, by, 0, g.z1 - 1, g.z2 + 1, C.concrete, M.concrete)
	box(m, "GarageWall", g.x2, g.x2 + 1, by, 0, g.z1 - 1, g.z2 + 1, C.concrete, M.concrete)
	box(m, "GarageWall", g.x1, RAMP.x1, by, 0, g.z1 - 1, g.z1, C.concrete, M.concrete)
	box(m, "GarageWall", g.x1, g.x2, by, 0, g.z2, g.z2 + 1, C.concrete, M.concrete)
	box(m, "GarageRaft", g.x1 - 1, g.x2 + 1, -26, by, g.z1 - 1, g.z2 + 1, C.concrete, M.concrete)
	-- ramp portal: lintel under the ground slab rising into a parapet at the channel head
	box(m, "RampPortal", RAMP.x1, RAMP.x2, -2, 1.2, g.z1 - 1, g.z1, C.stone, M.stone)

	-- one smooth ramp part: top surface from (z -146, y 0) down to (z -36, y -16)
	local run = RAMP.zBottom - RAMP.zTop
	local L = math.sqrt(run * run + RAMP.drop * RAMP.drop)
	local th = math.atan2(RAMP.drop, run)
	local t = 1
	local n = V3(0, run / L, RAMP.drop / L)
	local mid = V3((RAMP.x1 + RAMP.x2) / 2, -RAMP.drop / 2, (RAMP.zTop + RAMP.zBottom) / 2)
	Kit.part(m, B, "GarageRamp", V3(RAMP.x2 - RAMP.x1, t, L), CF(mid - n * (t / 2)) * ANG(th, 0, 0), C.asphalt, M.asphalt)
	-- concrete fill under the ramp (wedge flush with its underside) and its footing outside the garage
	local hW = RAMP.drop - t * L / run
	local lenW = hW * run / RAMP.drop
	Kit.wedge(m, B, "RampFill", V3(RAMP.x2 - RAMP.x1, hW, lenW), CF((RAMP.x1 + RAMP.x2) / 2, Plan.B1_Y + hW / 2, RAMP.zTop + lenW / 2) * ANG(0, PI, 0), C.concrete, M.concrete)
	box(m, "RampFooting", RAMP.x1, RAMP.x2, -26, Plan.B1_Y, RAMP.zTop, g.z1 - 1, C.concrete, M.concrete)
	-- stone retaining walls up to +1.2 with a metal guard rail
	box(m, "RetainingWall", RAMP.x1 - 1, RAMP.x1, -26, 1.2, RAMP.zTop, g.z1 - 1, C.stone, M.stone)
	box(m, "RetainingWall", RAMP.x2, RAMP.x2 + 1, -26, 1.2, RAMP.zTop, g.z1 - 1, C.stone, M.stone)
	metalRail(m, "z", RAMP.x1 - 0.5, RAMP.zTop, g.z1 - 1, 1.2)
	metalRail(m, "z", RAMP.x2 + 0.5, RAMP.zTop, g.z1 - 1, 1.2)
	metalRail(m, "x", g.z1 - 0.5, RAMP.x1, RAMP.x2, 1.2)
	-- lane marking down the ramp
	local lane = Kit.part(m, B, "RampLaneMark", V3(0.3, 0.05, L - 4), CF(mid + n * 0.025) * ANG(th, 0, 0), C.white, M.smooth, DETAIL)
	lane.Transparency = 0.2

	-- boom barrier at the ramp head (drivers holding a card open it by approaching)
	local def: any = {
		id = "SITE_BARRIER", level = 0, room = "B1_GARAGE", kind = "gate", access = "staff", axis = "x",
		x = (RAMP.x1 + RAMP.x2) / 2, z = -140, w = RAMP.x2 - RAMP.x1, h = 4, inward = V3(0, 0, 1),
		exterior = true, hidden = false, builder = "exterior", variant = "barrier", y = rampY(-140),
	}
	local barrier = Kit.door(ctx.folders.Doors, B, def, ctx.owner)
	if barrier then
		barrier:SetAttribute("AutoOpen", true)
	end
end

---------------------------------------------------------------------------------------------
-- 3 + 6. Foundations, surfaces, arrival plaza and landscape
---------------------------------------------------------------------------------------------
local function site(ctx: any)
	local folder: Instance = ctx.folders.Site
	local s = Plan.SITE
	local fnd = Kit.model(folder, "Foundations")
	-- SITE minus the garage footprint (with its walls) and minus the ramp channel; top y = 0
	-- (y = -1 under the pavilion's ground slab)
	local hotel = Plan.hasHotel(ctx.tier)
	local hr: Rect = { x1 = Plan.HOTEL.x1, x2 = Plan.HOTEL.x2, z1 = Plan.HOTEL.z1, z2 = Plan.HOTEL.z2 }
	for _, r in {
		{ s.x1, RAMP.x1 - 1, s.z1, -65 },
		{ RAMP.x1 - 1, s.x2, s.z1, RAMP.zTop },
		{ RAMP.x2 + 1, s.x2, RAMP.zTop, 89 },
		{ s.x1, -95, -65, 89 },
		{ s.x1, -82, 89, s.z2 },
		{ 82, s.x2, 89, s.z2 },
		{ -82, 82, 160, s.z2 },
	} do
		if hotel then
			-- the guest house stands on its own ground slab: its footprint is lowered like the pavilion's
			for _, piece in subtract({ x1 = r[1], x2 = r[2], z1 = r[3], z2 = r[4] }, { hr }) do
				box(fnd, "Foundation", piece.x1, piece.x2, -26, 0, piece.z1, piece.z2, C.concrete, M.concrete)
			end
		else
			box(fnd, "Foundation", r[1], r[2], -26, 0, r[3], r[4], C.concrete, M.concrete)
		end
	end
	box(fnd, "Foundation", -82, 82, -26, -1, 89, 160, C.concrete, M.concrete)
	if hotel then
		box(fnd, "Foundation", hr.x1, hr.x2, -26, -1, hr.z1, hr.z2, C.concrete, M.concrete)
	end

	local srf = Kit.model(folder, "Surfaces")
	local function lawn(x1: number, x2: number, z1: number, z2: number)
		box(srf, "Lawn", x1, x2, 0, 0.1, z1, z2, C.grass, M.grass)
	end
	local function pave(name: string, x1: number, x2: number, z1: number, z2: number, color: Color3?, mat: Enum.Material?)
		box(srf, name, x1, x2, 0, 0.12, z1, z2, color or C.stonePave, mat or M.pave)
	end
	local function asphalt(name: string, x1: number, x2: number, z1: number, z2: number)
		box(srf, name, x1, x2, 0, 0.1, z1, z2, C.asphalt, M.asphalt)
	end
	-- front lawns either side of the arrival walk, visitor parking beside the driveway
	lawn(s.x1, -12, s.z1, -120)
	lawn(12, 70, s.z1, -120)
	lawn(70, RAMP.x1, s.z1, -200)
	lawn(70, RAMP.x1 - 1, -150, -120)
	lawn(RAMP.x2, s.x2, s.z1, RAMP.zTop)
	lawn(RAMP.x2 + 1, s.x2, RAMP.zTop, 40)
	pave("ArrivalWalk", -12, 12, s.z1, -120, C.stone, M.stone)
	asphalt("Driveway", RAMP.x1, RAMP.x2, s.z1, RAMP.zTop)
	asphalt("VisitorParking", 70, RAMP.x1, -200, -150)
	pave("VisitorPath", 74, 80, -150, -120)
	-- plaza (over foundation and over the garage roof in front of the building)
	pave("Plaza", -96, RAMP.x1 - 1, -120, -48)
	pave("Plaza", RAMP.x1 - 1, Plan.GARAGE.x2 + 1, Plan.GARAGE.z1, -48)
	-- west: lawn south of the arcade, colonnade, path to the garden, lawn behind the pavilion
	lawn(s.x1, -96, -120, -56)
	pave("ColonnadeFloor", -96, -82, -48, 72, C.stone, M.stone)
	pave("WestPath", -96, -88, 72, 184)
	if hotel then
		for _, piece in subtract({ x1 = s.x1, x2 = -96, z1 = 72, z2 = s.z2 }, { hr }) do
			lawn(piece.x1, piece.x2, piece.z1, piece.z2)
		end
	else
		lawn(s.x1, -96, 72, s.z2)
	end
	box(srf, "PlantingBed", -88, -82, 0, 0.15, 72, 160, C.soil, M.leafy)
	-- east: facade path to the service yard, green roof over the garage strip
	pave("EastPath", 82, 92, -48, 40)
	lawn(92, Plan.GARAGE.x2 + 1, -48, 40)
	box(srf, "PlantingBed", 82, 86, 0, 0.15, 89, 160, C.soil, M.leafy)

	-- walk joints (large calm pavers) and the plaza's joint grid: few long thin non-colliding parts
	local pz = Kit.model(folder, "Plaza")
	for z = s.z1 + 6, -126, 6 do
		box(pz, "PavingJoint", -12, 12, 0.12, 0.17, z - 0.06, z + 0.06, C.stoneDeep, M.stone, DETAIL)
	end
	for x = -84, 84, 12 do
		local z2 = if x &lt;= RAMP.x1 - 1 then -120 else Plan.GARAGE.z1
		box(pz, "PavingJoint", x - 0.06, x + 0.06, 0.12, 0.17, z2, -48, C.stoneDeep, M.pave, DETAIL)
	end
	for z = -108, -60, 12 do
		box(pz, "PavingJoint", -96, if z &gt;= Plan.GARAGE.z1 then Plan.GARAGE.x2 + 1 else RAMP.x1 - 1, 0.12, 0.17, z - 0.06, z + 0.06, C.stoneDeep, M.pave, DETAIL)
	end
	-- low planters flanking the entrance along the plinth
	for k, x in { -40, 40 } do
		Kit.planter(pz, B, Kit.place(x, 0.12, -52, 0), 12, 2.4, Kit.hash("entry") + k)
	end
	-- planting islands with benches facing the plaza
	local seed = Kit.hash("plaza")
	island(pz, -68, -52, -108, -96, seed + 1)
	island(pz, 52, 68, -108, -96, seed + 2)
	island(pz, -46, -34, -86, -76, seed + 3)
	island(pz, 34, 46, -86, -76, seed + 4)
	local benchX, benchZ, benchF = { -60, 60, -40, 40 }, { -95, -95, -87, -87 }, { "N", "N", "S", "S" }
	for i = 1, 4 do
		Kit.bench(pz, B, Kit.place(benchX[i], 0.12, benchZ[i], benchF[i]), 6, seed + 10 + i)
	end
	-- path lights along the arrival walk (six of them carry a real light)
	for i, z in { -206, -188, -170, -152, -134 } do
		for _, x in { -13.6, 13.6 } do
			bollard(pz, x, z, i % 2 == 1)
		end
	end
	-- bike racks
	box(pz, "BikeRackRail", 22, 36, 0.12, 0.3, -116.2, -115.8, C.metal, M.metal)
	for x = 23, 35, 3 do
		for _, dz in { -0.9, 0.9 } do
			box(pz, "BikeHoop", x - 0.08, x + 0.08, 0.3, 2.6, -116 + dz - 0.08, -116 + dz + 0.08, C.metal, M.metal, DETAIL)
		end
		box(pz, "BikeHoop", x - 0.08, x + 0.08, 2.6, 2.76, -116.98, -115.02, C.metal, M.metal, DETAIL)
	end
	-- company stele at the walk / plaza junction
	box(pz, "SteleBase", -22.4, -17.6, 0.1, 0.5, -125.4, -122.6, C.stoneDeep, M.stone)
	local stele = box(pz, "CompanyStele", -21.6, -18.4, 0.5, 12.5, -124.6, -123.4, C.stone, M.stone)
	if stele then
		local plate = Kit.part(stele, B, "StelePlate", V3(2.6, 6.5, 0.12), CF(-20, 8.6, -124.66), C.metal, M.metal, { castShadow = false })
		Kit.text(plate, ctx.company, { color = C.white, font = Enum.Font.BuilderSansBold, maxDistance = 120, pps = 60, pad = 0.08 })
		box(pz, "SteleAccent", -21.3, -18.7, 12.0, 12.2, -124.68, -124.6, ctx.accent, M.smooth, DETAIL)
	end
	-- visitor bays (4) with markings
	for z = -196, -156, 10 do
		box(pz, "BayLine", 72, 90, 0.1, 0.15, z - 0.12, z + 0.12, C.white, M.smooth, DETAIL)
	end
	box(pz, "BayLine", 72, 72.25, 0.1, 0.15, -196, -156, C.white, M.smooth, DETAIL)
	for z = -191, -161, 10 do
		box(pz, "WheelStop", 73, 74, 0.1, 0.4, z - 3, z + 3, C.stoneDeep, M.concrete)
	end

	-- trees: street row at the frontage, lawns, green roof planters
	local land = Kit.model(folder, "Landscape")
	local ts = Kit.hash("trees")
	local i = 0
	local function t(x: number, z: number)
		i += 1
		if hotel and x &gt; hr.x1 - 3 and x &lt; hr.x2 + 3 and z &gt; hr.z1 - 3 and z &lt; hr.z2 + 3 then
			return -- trees inside the guest house footprint are not planted (seeds of the others unchanged)
		end
		tree(land, x, z, ts + i * 17)
	end
	for _, x in { -132, -110, -88, -66, -44, -24, 24, 46, 128 } do
		t(x, -205)
		box(land, "TreeGrate", x - 2, x + 2, 0.1, 0.16, -207, -203, C.metal, M.metal, DETAIL)
	end
	for _, p in { { -38, -150 }, { -64, -172 }, { -96, -150 }, { -124, -176 }, { 36, -146 }, { 56, -172 }, { -124, -104 }, { -110, -76 },
		{ 128, -126 }, { 130, -96 }, { 126, -60 }, { 130, -24 }, { 128, 12 }, { -124, 92 }, { -112, 124 }, { -128, 150 } } do
		t(p[1], p[2])
	end
	island(land, 96, 108, -32, -22, ts + 101)
	island(land, 96, 108, 4, 14, ts + 102)
end

---------------------------------------------------------------------------------------------
-- Campus arcade: four public stores facing a colonnade west of the HQ
---------------------------------------------------------------------------------------------
local function storeUnit(parent: Instance, store: any, index: number, z1: number, z2: number, accent: Color3)
	local um = Kit.model(parent, "Store_" .. tostring(store.id))
	local zc = (z1 + z2) / 2
	local seed = Kit.hash(tostring(store.id))
	local X1, X2 = -141, -96
	local floorColor: { [string]: Color3 } = { cafe = C.oak, hardware = C.metalSoft, studio = C.oakLight, mobility = C.stone }
	local floorMat: { [string]: Enum.Material } = { cafe = M.planks, hardware = M.slate, studio = M.planks, mobility = M.stone }
	local id = tostring(store.id)
	box(um, "StoreFloor", X1, X2, 0, 0.12, z1, z2, floorColor[id] or C.stone, floorMat[id] or M.stone)
	Kit.ceiling(um, B, { x1 = X1, x2 = X2, z1 = z1, z2 = z2 }, 0, "plaster", "warm", { height = 10.6, maxLights = 1 })
	box(um, "StoreCladding", X1, X1 + 0.2, 0.12, 10.6, z1, z2, C.oakLight, M.wood)
	-- open storefront: stone lintel with the store sign, glass side lights in oak frames
	box(um, "StoreLintel", X2 - 0.6, X2 + 0.4, 9, 11, z1, z2, C.stone, M.stone)
	local sign = box(um, "StoreSign", X2 + 0.4, X2 + 0.6, 9.3, 10.7, zc - 9, zc + 9, accent, M.smooth)
	if sign then
		Kit.text(sign, string.upper(tostring(store.name)), { face = Enum.NormalId.Right, color = C.white, font = Enum.Font.BuilderSansBold, maxDistance = 140, pad = 0.12 })
	end
	for _, r in { { z1, z1 + 7 }, { z2 - 7, z2 } } do
		box(um, "StoreGlass", X2 - 0.1, X2 + 0.1, 0.12, 9, r[1], r[2], C.glass, M.glass, GLASS)
	end
	box(um, "StoreFrame", X2 - 0.25, X2 + 0.25, 0.12, 9, z1 + 7, z1 + 7.4, C.oak, M.wood)
	box(um, "StoreFrame", X2 - 0.25, X2 + 0.25, 0.12, 9, z2 - 7.4, z2 - 7, C.oak, M.wood)
	-- subtitle plaque on the back wall
	local info = box(um, "StoreInfo", X1 + 0.2, X1 + 0.35, 6.2, 8.2, zc - 6, zc + 6, C.metal, M.metal)
	if info then
		Kit.text(info, tostring(store.subtitle), { face = Enum.NormalId.Right, color = C.white, font = Enum.Font.BuilderSans, maxDistance = 60, pad = 0.12 })
	end
	-- counter (customers on the east side) with the owner-agnostic store terminal
	local cx = -124
	Kit.counter(um, B, Kit.place(cx, 0.12, zc - 2, "E"), 12, seed)
	local terminal = box(um, "StoreTerminal", cx + 0.2, cx + 0.4, 3.725, 5.3, zc - 7.6, zc - 5.6, C.screen, M.smooth)
	if terminal then
		publicPrompt(terminal, tostring(store.name), tostring(store.app))
		Kit.text(terminal, tostring(store.name), { face = Enum.NormalId.Right, color = accent, font = Enum.Font.BuilderSansBold, maxDistance = 40, pad = 0.15 })
	end
	if store.id == "cafe" then
		for n, snack in CampusConfig.SNACKS do
			local col = Color3.fromRGB(snack.color[1], snack.color[2], snack.color[3])
			local z = zc - 4.4 + (n - 1) * 2.2
			local item = box(um, "StoreSnack", cx - 0.4, cx + 0.8, 3.725, 4.925, z - 0.7, z + 0.7, col, M.smooth)
			if item then
				publicPrompt(item, snack.name .. " · $" .. tostring(snack.price), nil, "snack", snack.id)
			end
		end
		Kit.kitchenette(um, B, Kit.place(X1 + 0.2, 0.12, zc - 2, "E"), 12, seed, { fridge = false, coffeeName = "StoreCoffee" })
		for k, z in { zc - 9, zc + 8 } do
			local at = Kit.place(-106, 0.12, z, 0)
			Kit.meetingTable(um, B, at, "round", 3.6, nil, seed + k)
			Kit.stool(um, B, at * CF(-2.8, 0, 0) * ANG(0, -PI / 2, 0), seed + k, 2.2)
			Kit.stool(um, B, at * CF(2.8, 0, 0) * ANG(0, PI / 2, 0), seed + k + 1, 2.2)
		end
		Kit.tvScreen(um, B, Kit.place(X1 + 0.2, 0.12, zc + 9, "E"), 5, "cafe", accent, { y = 6.5 })
	elseif store.id == "hardware" then
		for k, x in { -136, -130 } do
			Kit.rackShelf(um, B, Kit.place(x, 0.12, z2, "S"), 5, seed + k)
			Kit.rackShelf(um, B, Kit.place(x, 0.12, z1, "N"), 5, seed + k + 5)
		end
		box(um, "DisplayPlinth", -110, -106, 0.12, 3.1, zc - 2, zc + 2, C.stone, M.stone)
		box(um, "GPUDisplay", -109.4, -106.6, 3.1, 3.7, zc - 1.2, zc + 1.2, C.metal, M.metal)
		box(um, "GPUAccent", -106.65, -106.55, 3.2, 3.6, zc - 1.0, zc + 1.0, accent, M.neon, DETAIL)
		Kit.tvScreen(um, B, Kit.place(X1 + 0.2, 0.12, zc + 8, "E"), 5, "compute", accent, { y = 6.5 })
	elseif store.id == "studio" then
		for k, z in { zc - 6, zc + 6 } do
			box(um, "DisplayTable", -114, -106, 2.6, 2.9, z - 2, z + 2, C.oak, M.wood)
			box(um, "DisplayBase", -113, -107, 0.12, 2.6, z - 1.4, z + 1.4, C.white, M.smooth)
			for j = 0, 2 do
				local x = -112.5 + j * 2.5
				box(um, "Product", x - 0.6, x + 0.6, 2.9, 3.9 + (j % 2) * 0.6, z - 0.8, z + 0.8, if (j + k) % 2 == 0 then accent else C.white, M.smooth)
			end
		end
		Kit.cabinet(um, B, Kit.place(-134, 0.12, z2, "S"), 4, 7, seed)
		Kit.tvScreen(um, B, Kit.place(X1 + 0.2, 0.12, zc + 8, "E"), 6, "product", accent, { y = 6.5 })
	else
		Kit.cabinet(um, B, Kit.place(-134, 0.12, z2, "S"), 5, 7, seed)
		Kit.loungeChair(um, B, Kit.place(-108, 0.12, zc + 7, "S"), seed)
		Kit.loungeChair(um, B, Kit.place(-108, 0.12, zc - 9, "N"), seed + 1)
		Kit.coffeeTable(um, B, Kit.place(-108, 0.12, zc - 1, 0), seed, 3, 2.4)
		Kit.tvScreen(um, B, Kit.place(X1 + 0.2, 0.12, zc + 8, "E"), 6, "fleet", accent, { y = 6.5 })
	end
	if store.id ~= "hardware" then
		Kit.rackShelf(um, B, Kit.place(-112, 0.12, z1, "N"), 6, seed + 30)
	end
	Kit.plant(um, B, Kit.place(X2 - 3, 0.12, z1 + 3, 0), "l", seed + index)
end

local function arcade(ctx: any)
	local m = Kit.model(ctx.folders.Site, "CampusArcade")
	local X1, X2 = -142, -96
	local Z0, W = -56, 32
	local n = #CampusConfig.STORES
	local Z1 = Z0 + n * W
	-- shell: party walls (projecting as stone frames), back wall, roof, stone fascia over the colonnade
	for i = 0, n do
		local z = Z0 + i * W
		box(m, "ArcadeWall", X1, X2 + 1, 0.1, 14, z - 0.6, z + 0.6, C.stone, M.stone)
	end
	box(m, "ArcadeBack", X1, X1 + 1, 0.1, 14, Z0 - 0.6, Z1 + 0.6, C.stone, M.stone)
	box(m, "ArcadeRoof", X1, X2 + 1, 13, 14, Z0 - 0.6, Z1 + 0.6, C.stoneDeep, M.stone)
	box(m, "GreenRoof", X1 + 1, X2 - 0.4, 14, 14.25, Z0, Z1, C.grass, M.grass)
	box(m, "ArcadeFascia", X2 - 0.4, X2 + 0.6, 11.8, 14.6, Z0 - 0.6, Z1 + 0.6, C.stone, M.stone)
	-- colonnade: stone columns every 8 under one continuous canopy
	for z = Z0 + 4, Z1 - 4, 8 do
		box(m, "ColonnadeColumn", -86.7, -85.3, 0.12, 11, z - 0.7, z + 0.7, C.stone, M.stone)
	end
	box(m, "ColonnadeCanopy", X2 + 0.6, -85, 11, 11.8, Z0 - 0.6, Z1 + 0.6, C.stone, M.stone)
	box(m, "ColonnadeSoffit", X2 + 0.6, -85.3, 10.8, 11, Z0 - 0.6, Z1 + 0.6, C.oak, M.wood)
	box(m, "ColonnadeFascia", -85.3, -85, 10.6, 12.0, Z0 - 0.6, Z1 + 0.6, C.metal, M.metal)
	for i, store in CampusConfig.STORES do
		local z1 = Z0 + (i - 1) * W
		storeUnit(m, store, i, z1 + 0.6, z1 + W - 0.6, ctx.accent)
	end
end

---------------------------------------------------------------------------------------------
-- Rear garden: lawn, stone paths, water basin, pergola, benches, trees
---------------------------------------------------------------------------------------------
local function garden(ctx: any)
	local m = Kit.model(ctx.folders.Site, "Garden")
	local s = Plan.SITE
	box(m, "Lawn", -96, 86, 0, 0.1, 160, s.z2, C.grass, M.grass)
	box(m, "GardenPath", -96, 86, 0, 0.14, 184, 190, C.stonePave, M.pave)
	box(m, "GardenPath", 66, 74, 0, 0.14, 160, 184, C.stonePave, M.pave)
	box(m, "GardenPath", -32, -24, 0, 0.14, 190, 200, C.stonePave, M.pave)
	-- long shallow water basin: collidable stone rim, non-colliding water surface
	local bx1, bx2, bz1, bz2 = -70, 30, 166, 178
	box(m, "BasinRim", bx1, bx2, 0.1, 1.0, bz1, bz1 + 0.8, C.stone, M.stone)
	box(m, "BasinRim", bx1, bx2, 0.1, 1.0, bz2 - 0.8, bz2, C.stone, M.stone)
	box(m, "BasinRim", bx1, bx1 + 0.8, 0.1, 1.0, bz1 + 0.8, bz2 - 0.8, C.stone, M.stone)
	box(m, "BasinRim", bx2 - 0.8, bx2, 0.1, 1.0, bz1 + 0.8, bz2 - 0.8, C.stone, M.stone)
	box(m, "BasinFloor", bx1 + 0.8, bx2 - 0.8, 0.1, 0.25, bz1 + 0.8, bz2 - 0.8, C.metalSoft, M.slate)
	box(m, "Water", bx1 + 0.8, bx2 - 0.8, 0.25, 0.7, bz1 + 0.8, bz2 - 0.8, C.water, M.glass, WATER)
	-- pergola with oak beams over a seating area
	local px1, px2, pz1, pz2 = -46, -10, 200, 216
	box(m, "PergolaFloor", px1, px2, 0, 0.14, pz1, pz2, C.stone, M.stone)
	for _, x in { px1 + 1, (px1 + px2) / 2, px2 - 1 } do
		for _, z in { pz1 + 1, pz2 - 1 } do
			box(m, "PergolaPost", x - 0.4, x + 0.4, 0.14, 9.8, z - 0.4, z + 0.4, C.oak, M.wood)
		end
	end
	for _, z in { pz1 + 1, pz2 - 1 } do
		box(m, "PergolaBeam", px1, px2, 9.0, 9.8, z - 0.4, z + 0.4, C.oak, M.wood)
	end
	for x = px1 + 1.5, px2 - 1.5, 3 do
		box(m, "PergolaRafter", x - 0.2, x + 0.2, 9.8, 10.3, pz1 - 0.5, pz2 + 0.5, C.oakDark, M.wood)
	end
	local seed = Kit.hash("garden")
	box(m, "GardenTable", -36, -20, 2.9, 3.2, 207, 209, C.oakDark, M.wood)
	for _, x in { -34, -22 } do
		box(m, "GardenTableLeg", x - 0.3, x + 0.3, 0.14, 2.9, 207.4, 208.6, C.metal, M.metal)
	end
	Kit.bench(m, B, Kit.place(-28, 0.14, 205.4, "N"), 15, seed + 1)
	Kit.bench(m, B, Kit.place(-28, 0.14, 210.6, "S"), 15, seed + 2)
	Kit.bench(m, B, Kit.place(-40, 0.14, 181.8, "S"), 6, seed + 3)
	Kit.bench(m, B, Kit.place(0, 0.14, 181.8, "S"), 6, seed + 4)
	Kit.bench(m, B, Kit.place(-92, 0.14, 150, "E"), 6, seed + 5)
	local i = 0
	local h = Plan.HOTEL
	local hotel = Plan.hasHotel(ctx.tier)
	for _, p in { { -80, 214 }, { 2, 214 }, { 24, 204 }, { 48, 216 }, { 74, 210 }, { -104, 168 }, { -118, 196 }, { -130, 218 }, { -80, 172 }, { 50, 170 } } do
		i += 1
		if hotel and p[1] &gt; h.x1 - 3 and p[1] &lt; h.x2 + 3 and p[2] &gt; h.z1 - 3 and p[2] &lt; h.z2 + 12 then
			continue -- inside the guest house footprint / its terrace
		end
		tree(m, p[1], p[2], seed + i * 23)
	end
end

