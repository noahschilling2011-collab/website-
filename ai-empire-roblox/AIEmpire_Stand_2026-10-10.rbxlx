local function foundationOrWork(level: number, theme: string, out: { Room })
	local t = THEMES[theme]
	for _, side in { "W", "E" } do
		for zone, def in t[side] do
			table.insert(out, wingRoom(level, side == "E", zone, def))
		end
	end
end

