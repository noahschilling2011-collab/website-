	{id="northside",client="Northside Studio",kind="website",minimum=48,reward=6500,headline="Make something worth keeping.",sub="Independent design, thoughtful spaces and ideas made tangible.",items={"Brand identities","Digital products","Creative direction"}},
	{id="field",client="Field Supply",kind="shop",minimum=50,reward=8000,headline="Everyday objects. Made well.",sub="Useful things, honest materials and fewer distractions.",items={"Canvas carryall","Desk organiser","Stoneware cup"}},
	{id="orbitgame",client="Orbit Games",kind="gamebot",minimum=62,reward=11000,headline="A better companion for every player.",sub="Guide new players, plan a route and answer the next question.",items={"Navigation","Player support","Quest planning"}},
	{id="ledgerflow",client="Ledger Office",kind="workflow",minimum=55,reward=9000,headline="A calmer working day.",sub="Organise the queue, summarise requests and keep the team moving.",items={"Sort requests","Draft replies","Review results"}},
}
function Config.find(list: any,id: any): any
	if typeof(id)~="string" then return nil end
	for _, def in list do if def.id==id then return def end end
	return nil
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000004"><Properties><string name="Name">ArchPalette</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The headquarters' single material palette. Generators never invent ad-hoc colours: large
-- surfaces stay material-true (stone, oak, plaster, metal, glass); the company colour only tints
-- signage, a few accent surfaces and screens.
local P = {}

local rgb = Color3.fromRGB

P.color = {
	stone = rgb(216, 212, 201), -- warm light natural stone (facade, plinth, floors)
	stoneDeep = rgb(190, 184, 171), -- shadowed stone, reveals, copings
	stonePave = rgb(184, 180, 170), -- outdoor paving
	interior = rgb(239, 236, 228), -- light interior plaster
	plasterShade = rgb(226, 222, 212),
	metal = rgb(38, 43, 47), -- dark metal profiles, mullions, frames
	metalSoft = rgb(66, 72, 77),
	oak = rgb(151, 111, 76), -- warm oak
	oakLight = rgb(178, 140, 101),
	oakDark = rgb(112, 81, 56),
	sage = rgb(104, 126, 111), -- calm sage green
	sageLight = rgb(150, 168, 152),
	blue = rgb(94, 136, 162), -- subtle technical blue
	blueSoft = rgb(158, 186, 202),
	glass = rgb(196, 219, 228), -- light, slightly cool glass
	glassDeep = rgb(150, 182, 196),
	concrete = rgb(176, 175, 170),
	asphalt = rgb(58, 61, 63),
	carpet = rgb(126, 131, 128),
	carpetWarm = rgb(150, 138, 122),
	fabric = rgb(112, 132, 118),
	fabricSand = rgb(198, 184, 160),
	fabricCharcoal = rgb(70, 74, 78),
	fabricBlue = rgb(98, 118, 136),
	leather = rgb(120, 86, 62),
	white = rgb(246, 244, 239),
	screen = rgb(22, 27, 31),
	brass = rgb(178, 150, 98),
	terracotta = rgb(170, 110, 84),
	foliage = rgb(80, 112, 76),
	foliageLight = rgb(112, 142, 96),
	grass = rgb(104, 134, 94),
	soil = rgb(70, 60, 47),
	water = rgb(118, 166, 178),
	lightWarm = rgb(255, 234, 204),
	lightNeutral = rgb(246, 244, 236),
	lightCool = rgb(226, 238, 248),
	lightSecret = rgb(176, 196, 255),
	statusGood = rgb(120, 190, 150),
	statusBad = rgb(214, 104, 92),
	statusBusy = rgb(226, 186, 110),
}

P.material = {
	stone = Enum.Material.Limestone,
	pave = Enum.Material.Pavement,
	plaster = Enum.Material.Plaster,
	metal = Enum.Material.Metal,
	wood = Enum.Material.Wood,
	planks = Enum.Material.WoodPlanks,
	glass = Enum.Material.Glass,
	concrete = Enum.Material.Concrete,
	carpet = Enum.Material.Carpet,
	fabric = Enum.Material.Fabric,
	leather = Enum.Material.Leather,
	tile = Enum.Material.CeramicTiles,
	marble = Enum.Material.Marble,
	slate = Enum.Material.Slate,
	rubber = Enum.Material.Rubber,
	asphalt = Enum.Material.Asphalt,
	grass = Enum.Material.Grass,
	leafy = Enum.Material.LeafyGrass,
	smooth = Enum.Material.SmoothPlastic,
	neon = Enum.Material.Neon,
}

-- Tested-in-code defaults (verify in Studio): glass stays readable without milky stacking.
P.glassTransparency = 0.62 -- facade and partitions
P.glassTransparencyDoor = 0.55
P.railTransparency = 0.5

-- Light moods per room (BuildingPlan room.mood)
P.mood = {
	warm = { color = P.color.lightWarm, brightness = 0.75, range = 18 },
	neutral = { color = P.color.lightNeutral, brightness = 0.7, range = 18 },
	cool = { color = P.color.lightCool, brightness = 0.7, range = 18 },
	tech = { color = P.color.lightCool, brightness = 0.6, range = 16 },
	founder = { color = rgb(255, 226, 190), brightness = 0.7, range = 20 },
	secret = { color = P.color.lightSecret, brightness = 0.5, range = 16 },
	wellness = { color = rgb(255, 230, 200), brightness = 0.6, range = 18 },
}

-- Department accent tints for identity panels (desaturated so they read as material, not toy colour)
P.department = {
	data = rgb(105, 140, 153),
	engineering = rgb(108, 133, 123),
	design = rgb(147, 137, 107),
	training = rgb(96, 128, 150),
	research = rgb(126, 121, 149),
	evaluation = rgb(129, 149, 115),
	growth = rgb(168, 133, 109),
	deployment = rgb(160, 128, 104),
	operations = rgb(120, 126, 120),
	compute = rgb(90, 118, 140),
	executive = rgb(150, 120, 88),
}

return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000005"><Properties><string name="Name">BuildingPlan</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One architectural plan for the whole headquarters. Geometry generators, room access, employee
-- navigation, the lift, wayfinding and camera channels all read these definitions, so a wall, a
-- door and the rule that protects the room behind it can never disagree.
--
-- Coordinates are building-local studs: origin = plot CFrame at street level, -Z faces the street.
-- Level L has its finished floor at levelY(L). B1 = level -1, roof = level floors(tier).
--
-- Plan tiers: 1..4 are the headquarters buildings. Plan tier 0 is the GARAGE STAGE: the company starts
-- in a converted single-storey garage beside the plaza (Plan.GARAGE_LAB) while the future HQ footprint is
-- a fenced construction site (no B1, no lift, no core). From Plan.hasHotel(tier) on, the site also has a
-- two-storey company guest house on the west strip (Plan.HOTEL): its rooms are ordinary plan rooms with
-- `annex = "hotel"` (own facade lines, slabs, stair; HQ wayfinding and the HQ lift ignore them).
local Plan = {}

Plan.FLOOR_HEIGHT = 16
Plan.B1_Y = -16
Plan.SLAB = 1 -- slab top = level Y, slab bottom = level Y - 1
Plan.CEILING = 13 -- suspended ceiling height in rooms and corridors
Plan.TIER_FLOORS = { 3, 4, 5, 7 } -- above-ground storeys incl. ground floor and founder floor
Plan.MIN_TIER = 0 -- plan tier 0 = the garage stage
Plan.MAX_TIER = #Plan.TIER_FLOORS

-- Garage stage (plan tier 0). Numbers marked CORE_SPEC are placeholders the economy design tunes.
Plan.GARAGE_STAGE = {
	floors = 1, -- single storey (the flat roof is not accessible)
	desks = 6, -- CORE_SPEC 2.3: founder desk + 5 team desks
	staff = 5, -- CORE_SPEC 2.3: hired people that fit (founder not counted) = EmpireConfig.OFFICES[1].staff
	blades = 3, -- CORE_SPEC 2.3: lit GPU blades = HardwareConfig.slots at stage 1 (lit per owned GPU)
}
-- The converted garage: interior rectangle (outer walls stand outside it, 1 thick), roof at y 14.
Plan.GARAGE_LAB = { x1 = 60, x2 = 112, z1 = -118, z2 = -78, height = 14 }
-- Up-and-over garage door in the south wall, facing the extended driveway (x 92..112).
Plan.GARAGE_ROLLUP = { x1 = 94, x2 = 110, z = -118, height = 10 }
-- Fenced construction site over the future HQ footprint (main block, pavilion, B1 garage).
Plan.CONSTRUCTION = { x1 = -82, x2 = 82, z1 = -46, z2 = 160 }
-- Company car parking spot in front of the garage door (tier 0), nose towards the street, and the
-- parked company van beside it (ground point under the van's centre; static scenery).
Plan.GARAGE_STAGE_SPAWN = CFrame.new(107, 4, -136)
Plan.GARAGE_STAGE_VAN = CFrame.new(97.4, 0.11, -136)

-- Envelope
Plan.MAIN = { x1 = -82, x2 = 82, z1 = -48, z2 = 80 }
Plan.PAVILION = { x1 = -82, x2 = 82, z1 = 80, z2 = 160, levels = 2 } -- G and 1, roof at y=32
Plan.GARAGE = { x1 = -94, x2 = 112, z1 = -64, z2 = 88 }
Plan.SITE = { x1 = -142, x2 = 145, z1 = -217, z2 = 228 }
Plan.FOUNDER_FRONT_Z = -32 -- the founder storey steps back for a terrace

-- Circulation core and atrium
Plan.ATRIUM = { x1 = -14, x2 = 14, z1 = -16, z2 = 36 } -- open void from level 1 to the roof skylight
Plan.LIFT_LOBBY = { x1 = -22, x2 = 22, z1 = 36, z2 = 54 }
Plan.SHAFT = { x1 = -7, x2 = 7, z1 = 54, z2 = 68 } -- outer shaft; front wall z 53.5..54.5
Plan.CABIN = { x1 = -6, x2 = 6, z1 = 54.8, z2 = 66.8, height = 10.4, capacity = 6 }
Plan.LIFT_DOOR = { x1 = -3, x2 = 3, z = 54, height = 10 } -- centre-opening doors; leaves park inside the 12-stud cabin/shaft width
Plan.RISER = { x1 = -7, x2 = 7, z1 = 68, z2 = 80 }
Plan.STAIR = { x1 = -22, x2 = -7, z1 = 54, z2 = 80 }
-- Switchback stair inside STAIR: front landing at level Y, flight A rises +Z, mid landing at Y+8,
-- flight B rises -Z back to the front landing of the next level. Flights are smooth ramps under
-- non-colliding visual treads so Humanoids and PathfindingService walk them reliably.
Plan.STAIR_LAYOUT = {
	inner = { x1 = -21.5, x2 = -7.5, z1 = 54.5, z2 = 79.5 },
	frontLanding = { z1 = 54.5, z2 = 60 },
