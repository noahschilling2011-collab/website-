local shops: {Spot}={}
local stops: {Spot}={}
local views: {Spot}={}
local function spot(list: {Spot},x: number,z: number,y: number,face: Vector3,kind: string) table.insert(list,{x=x,z=z,y=y,face=face,kind=kind}) end
