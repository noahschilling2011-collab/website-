local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local Math=require(Shared.ArenaMath)
local Format=require(Shared.Format)
local UI=script.Parent.Parent
local State=require(UI.Parent.Controllers.StateController)
local Action=require(UI.Parent.Controllers.ActionController)
local Theme=require(UI.Theme)
local Kit=require(UI.Kit)
local C,F=Theme.colors,Theme.font
local App={}
local refresh=function(_s: any)end
function App.mount(parent: Frame,nav: any)
	local scroll=Kit.scroll(parent);Kit.padding(scroll,2,14,24,2);Kit.list(scroll,16)
	Kit.heading(scroll,"Courier lab","Watch your model plan a route around obstacles. Better reasoning means fewer detours; reliable code improves its decisions.",1)
	local left,right=Kit.columns(scroll,.43,18,2)
	local config=Kit.card(left,1,12);Kit.caption(config,"Checkpoint under test",1)
	local name=Kit.text(config,"No trained model",21,F.bold,C.text);name.LayoutOrder=2
	local detail=Kit.para(config,"",13,C.muted,3)
	local controls=Kit.row(config,32,8,4)
	local previous=Kit.button(controls,"Previous","secondary",UDim2.fromOffset(100,30))
	local nextButton=Kit.button(controls,"Next model","secondary",UDim2.fromOffset(110,30));nextButton.LayoutOrder=2
	local index=1;local ids={}
	local start=Kit.button(config,"RUN COURIER TEST","primary",UDim2.new(1,0,0,42));start.LayoutOrder=5
	Kit.onClick(previous,function() index=math.max(1,index-1);if State.snapshot then refresh(State.snapshot) end end)
	Kit.onClick(nextButton,function() index=math.min(#ids,index+1);if State.snapshot then refresh(State.snapshot) end end)
	Kit.onClick(start,function() if ids[index] then Action.call("RunArena",{modelId=ids[index]}) end end)
	local progress=Kit.bar(config,6,6)
	local running=Kit.para(config,"",13,C.dim,7)
	Kit.para(config,"The physical course is at Courier Lab, west of the founder district. Run a test here, then walk over to watch your robot. Tests award a record, never farmable cash.",13,C.dim,8)
	local historyCard=Kit.card(left,2,8);Kit.caption(historyCard,"Recent tests",1)
	local histories={};for i=1,6 do histories[i]=Kit.para(historyCard,"",13,C.muted,i+1) end
	local mapCard=Kit.card(right,1,12);Kit.caption(mapCard,"Route planner / nine by seven",1)
	local map=Kit.frame(mapCard,UDim2.new(1,0,0,230));map.LayoutOrder=2
	local cells={}
	for x=1,Math.WIDTH do for z=1,Math.HEIGHT do
		local cell=Kit.frame(map,UDim2.new(1/9,-4,1/7,-4),UDim2.new((x-1)/9,2,(z-1)/7,2));cell.BackgroundTransparency=0;Kit.corner(cell,3)
		local label=Kit.text(cell,"",11,F.medium,C.text);label.AnchorPoint=Vector2.new(.5,.5);label.Position=UDim2.fromScale(.5,.5)
		cells[tostring(x)..":"..tostring(z)]={frame=cell,label=label,x=x,z=z}
	end end
	local routeInfo=Kit.para(mapCard,"",13,C.dim,3)
	local rivalsCard=Kit.card(right,2,10);Kit.caption(rivalsCard,"Rival companies / live activity",1)
	local activities={};for i=1,5 do activities[i]=Kit.para(rivalsCard,"",13,C.muted,i+1) end
	refresh=function(s: any)
		ids={};for _,id in s.data.modelOrder do local m=s.data.models[id];if m and (m.status=="trained" or m.status=="live") then table.insert(ids,id) end end
		index=math.clamp(index,1,math.max(1,#ids));local m=s.data.models[ids[index]]
		local info=s.live.arena or {};local active=info.active
		name.Text=if m then m.name.." v"..tostring(m.version) else "Train a model first"
		detail.Text=if m then string.format("Reasoning %.1f · Coding %.1f · Reliability %.1f",m.stats.reasoning or 0,m.stats.coding or 0,m.stats.reliability or 0) else "Your own checkpoint is required for a ranked test."
		Kit.setDisabled(start,not m or active~=nil)
		progress.set(if active then active.progress else 0)
		running.Text=if active then "Lane "..tostring(active.lane).." · "..Format.percent(active.progress).." · competing with "..active.opponent else "Best arena record: "..tostring(s.data.empire.arenaBest).." points"
		local plan=if m then Math.route(m.stats,#s.data.empire.arenaHistory+1) else nil
		local route={};if plan then for i,p in plan.path do route[tostring(p.x)..":"..tostring(p.z)]=i end end
		for key,c in cells do
			c.frame.BackgroundColor3=if Math.blocked(c.x,c.z) then C.raised elseif route[key] then Theme.accent:Lerp(C.bg,.4) else C.panel
			c.label.Text=if c.x==1 and c.z==4 then "IN" elseif c.x==9 and c.z==4 then "OUT" elseif route[key] then tostring(route[key]) else ""
		end
		routeInfo.Text=if plan then string.format("%d moves · %.1fs estimate · %d detours · %d expected points",plan.moves,plan.seconds,plan.detours,plan.score) else "Select a trained model to inspect its route."
		for i,l in histories do local h=s.data.empire.arenaHistory[i];l.Visible=h~=nil;if h then l.Text=h.name.." · "..tostring(h.score).." pts · "..tostring(h.moves).." moves · "..(if h.winner then "Beat " else "Behind ")..h.opponent end end
		for i,l in activities do local a=info.rivals and info.rivals[i];l.Visible=a~=nil;if a then l.Text=a.company.." / "..a.text end end
	end
	State.onChange(function(s) if parent.Visible and nav.isOpen() then refresh(s) end end)
end
function App.onShow() if State.snapshot then refresh(State.snapshot) end end
return App
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000042"><Properties><string name="Name">EmpireApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Company OS: reactive cards are built on tab changes, updated in place on snapshots.
-- Tabs: Overview, Clients (B2B pipeline, CORE_SPEC 3.2), Money (P&amp;L per company day from empire.ledger, CORE_SPEC 4/6),
-- Team, Research, Goals, Office, Settings (auto-HR, Save mode, night shift, apprentices, company jet: CORE_SPEC 8.1,
-- 11.1, 11.2) and Board. Every number comes from the replicated company state; decisions go to the server through
-- EmpireAction / DealAction / HireEmployee (errors: ActionController texts, CORE_SPEC 11.8).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config.EmpireConfig)
local DepartmentConfig = require(Shared.Config.DepartmentConfig)
local HardwareConfig = require(Shared.Config.HardwareConfig)
local Math = require(Shared.EmpireMath)
local Ops = require(Shared.CompanyOps)
local ModelMath = require(Shared.ModelMath)
local Format = require(Shared.Format)
local UI = script.Parent.Parent
local Client = UI.Parent
local State = require(Client.Controllers.StateController)
local Action = require(Client.Controllers.ActionController)
local People = require(Client.Controllers.PeopleController)
local Conversation = require(UI.Screens.Conversation)
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Toast = require(UI.Toast)
local C, F = Theme.colors, Theme.font
local App = {}
local page: Frame? = nil
local scroll: ScrollingFrame? = nil
local current = "overview"
local updaters: { (any) -&gt; () } = {}
local nav: any = nil
local tabButtons: { [string]: TextButton } = {}
local function watch(fn: (any) -&gt; ())
	table.insert(updaters, fn)
	if State.snapshot then fn(State.snapshot) end
end
local function button(parent: Instance, label: string, callback: () -&gt; ())
	local b = Kit.button(parent, label, "primary", UDim2.new(1,0,0,40))
	b.LayoutOrder = 9
	Kit.onClick(b, callback)
	return b
end
local function call(name: string, payload: any, message: string?)
	task.spawn(function()
		local ok = Action.call(name, payload)
		if ok and message then Toast.show("success", message) end
	end)
end
local function para(parent: Instance, text: string, order: number?)
	return Kit.para(parent, text, 14, C.muted, order or 2)
end
local function title(parent: Instance, text: string)
	local t = Kit.para(parent, text, 18, C.text, 1)
	t.Font = F.bold
	return t
end
local function dim(parent: Instance, text: string, order: number?)
	return Kit.para(parent, text, 13, C.dim, order or 8)
end
local function metric(parent: Instance, label: string, value: (any) -&gt; string, order: number)
	local card = Kit.card(parent, order)
	Kit.caption(card, label, 1)
	local t = Kit.para(card, "", 23, C.text, 2)
	t.Font = F.bold
	watch(function(s) t.Text = value(s) end)
	return card
end
local function dollars(n: number): string
	return Ops.money(n)
end
local function perDay(perMinute: number): string
	return dollars(perMinute * Ops.DAY / 60) .. "/day"
end
local function stageName(i: number): string
	local def = Config.OFFICES[math.clamp(math.floor(i), 1, #Config.OFFICES)]
	return def.name
end
local function clearRows(rows: Instance)
	for _, child in rows:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
end
-- small segmented switch inside a card row (Off / On, 25 / 40 / 55 %, Auto / Off)
local function switch(parent: Instance, options: { Kit.Option }, initial: string, order: number, width: number?, onSelect: (string) -&gt; ()): Kit.Segmented
	local seg = Kit.segmented(parent, options, initial, onSelect, 36)
	seg.frame.LayoutOrder = order
	if width then seg.frame.Size = UDim2.fromOffset(width, 36) end
	return seg
end
local function profitChart(parent: Instance, order: number)
	local card=Kit.card(parent,order)
	title(card,"How the business is doing")
	local caption=para(card,"",2)
	local graph=Kit.frame(card,UDim2.new(1,0,0,130))
	graph.LayoutOrder=3
	local positive=Kit.text(graph,"",11,F.medium,C.dim)
	positive.Position=UDim2.new(0,0,0,0)
	local negative=Kit.text(graph,"",11,F.medium,C.dim)
	negative.Position=UDim2.new(0,0,1,-15)
	local plot=Kit.frame(graph,UDim2.new(1,0,1,-34),UDim2.fromOffset(0,17))
	for i=0,3 do
		local line=Kit.frame(plot,UDim2.new(1,0,0,1),UDim2.fromScale(0,i/3))
		line.BackgroundColor3=C.line
		line.BackgroundTransparency=0.96
	end
	local baseline=Kit.frame(plot,UDim2.new(1,0,0,1))
	baseline.BackgroundColor3=C.dim
	baseline.BackgroundTransparency=0.4
	local bars={}
	for i=1,36 do
		local b=Kit.frame(plot)
		Kit.corner(b,2)
		bars[i]=b
	end
	watch(function(s)
		local history=s.data.empire.history
		local min,max=0,1
		for _,sample in history do min=math.min(min,sample.profit);max=math.max(max,sample.profit) end
		local range=max-min
		local zero=1-(0-min)/range
		baseline.Position=UDim2.fromScale(0,zero)
		positive.Text=Format.money(max).." / min"
		negative.Text=Format.money(min).." / min"
		caption.Text=if #history==0 then "The first sample appears after 10 seconds. Staff wages are included." else "Actual net profit · one sample every 10 seconds · staff wages included"
		for i,b in bars do
			local sample=history[i]
			b.Visible=sample~=nil
			if sample then
				b.AnchorPoint=Vector2.new(0,if sample.profit&gt;=0 then 1 else 0)
				b.Position=UDim2.fromScale((i-1)/36,zero)
				b.Size=UDim2.fromScale(0.021,math.abs(sample.profit)/range)
				b.BackgroundColor3=if sample.profit&gt;=0 then C.good else C.bad
				b.BackgroundTransparency=0.15
			end
		end
	end)
end
local function overview(parent: Instance)
	local hero = Kit.card(parent, 1)
	local headline = title(hero, "Your next chapter")
	local text = para(hero, "", 2)
	watch(function(s)
		local e = s.data.empire
		local stage = Ops.stageIndex(e)
		headline.Text = stageName(stage) .. "  /  Level " .. tostring(1 + math.floor(e.xp / 250))
		local b = Math.bonuses(e)
		local goal = Math.nextGoal(s.data, s.live)
		text.Text = string.format("%s  ·  %d/%d employees  ·  %.0f research points  ·  %.0f XP\nTraining +%.0f%%  ·  Revenue +%.0f%%  ·  Wages %s/day\nNext goal: %s",
			Format.dayClock(Ops.day(e), Ops.hour(s.serverTime)), Math.staff(e), Config.OFFICES[stage].staff, e.points, e.xp, (b.speed-1)*100, (b.revenue-1)*100, dollars(b.wage*Ops.DAY),
			if goal then goal.text else "every goal reached")
	end)
	local start = Kit.row(hero, 40, 8, 3)
	for _, def in {{"Clients","empire","clients"},{"Money","empire","money"},{"Settings","empire","settings"}} do
		local b = Kit.button(start, def[1], "secondary", UDim2.new(1/3,-6,1,0))
		Kit.onClick(b, function() App.openSection(def[3]) end)
	end
	local metrics = Kit.grid(parent, 3, 96, 10, 2)
	metric(metrics, "Cash available", function(s) return Format.money(s.data.money) end, 1)
	metric(metrics, "Profit per game day", function(s) return Format.perDay(s.live.revenue-s.live.cost) end, 2)
	metric(metrics, "Active users", function(s) return Format.compact(s.live.users) end, 3)
	profitChart(parent,3)
	local cycle = Kit.card(parent, 4)
	local cycleTitle = title(cycle, "Market cycle")
	local cycleText = para(cycle, "")
	watch(function(s)
		local def, left = Config.cycle(s.serverTime)
		cycleTitle.Text = def.name
		cycleText.Text = def.desc .. "  Next cycle in " .. tostring(math.ceil(left)) .. "s."
	end)
	local daily = Kit.card(parent, 5)
	title(daily, "Daily founder grant")
	local dailyText = para(daily, "")
	local claim = button(daily, "Claim daily grant", function() call("ClaimDaily", {}, "Daily grant collected! +15 research points") end)
	watch(function(s)
		local e = s.data.empire
		local day = math.floor(s.serverTime/86400)
		local done = e.daily.day &gt;= day
		local nextStreak = if e.daily.day == day-1 then math.min(7,e.daily.streak+1) else 1
		dailyText.Text = if done then "Collected today. Streak: " .. tostring(e.daily.streak) .. ". Resets at 00:00 UTC."
			else "Today's grant: " .. Format.money(1000+(nextStreak-1)*500) .. " + 15 research points. Consecutive days increase the grant."
		Kit.setDisabled(claim, done)
		claim.Text = if done then "Come back tomorrow" else "Claim founder grant"
	end)
	local goal = Kit.card(parent, 6)
	title(goal, "A business with a plan")
	para(goal, "1. Buy data and train a model in Models.\n2. Launch it at the Recommended price.\n3. Sign business clients: you and your Growth &amp; Sales reps visit them by yourselves.\n4. Hire a team, research upgrades and move into a bigger office.\n5. Build a frontier model and climb the server board.")
end

-- Clients (CORE_SPEC 3.2): the B2B pipeline -------------------------------------------------------------------
local TIER_TEXT: { [string]: string } = { city = "City", region = "Region", abroad = "Abroad" }
local GROUPS: { [string]: number } = { account = 100, lead = 200, needs = 300, later = 400 }
-- remaining company days of an account -&gt; the company day it ends on (the calendar moves with the server day)
local function endDay(s: any, secondsLeft: number): number
	local e = s.data.empire
	local into = (s.serverTime % Ops.DAY) / Ops.DAY
	return Ops.day(e) + math.floor(into + math.max(0, secondsLeft) / Ops.DAY)
end
local function tripOf(s: any, clientId: string): any
	local ops = s.live.ops
	if typeof(ops) == "table" and typeof(ops.trips) == "table" then
		for _, t in ops.trips do if typeof(t) == "table" and t.client == clientId then return t end end
	end
	local d = s.data.empire.deals
	if typeof(d) == "table" and typeof(d.tripList) == "table" then
		for _, t in d.tripList do if typeof(t) == "table" and t.client == clientId then return t end end
	end
	return nil
end
local function tripText(s: any, t: any): string
	local c = Ops.client(t.client)
	local name = if c then c.name else tostring(t.client)
	local tier = t.tier or (if c then c.trip else "city")
	local left = Format.duration(math.max(0, (tonumber(t.back) or 0) - (tonumber(s.data.empire.seconds) or 0)))
	local what = if t.kind == "renew" then "check-in" else "pilot visit"
	if t.hosted then return string.format("%s team at your guest house · %s · back in %s", name, what, left) end
	local who = if t.founder then "You (founder)" elseif (tonumber(t.crew) or 1) &gt;= 2 then "Field rep + engineer" else "Field rep"
	local how = if tier == "abroad" then (if s.data.empire.jet == true then "company jet" else "flight + 2 nights") elseif tier == "region" then "City Hotel night" else "car"
	return string.format("%s → %s · %s · %s · back in %s", who, name, what, how, left)
end
type ClientRow = { frame: Frame, update: (any) -&gt; () }
local function clientRow(parent: Instance, c: any): ClientRow
	local frame = Kit.frame(parent, UDim2.new(1, 0, 0, 84))
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = C.panel2
	Kit.corner(frame, 10)
	local stroke = Kit.stroke(frame, 0.93)
	Kit.padding(frame, 12, 14, 12, 16)
	local nameRow = Kit.frame(frame, UDim2.new(1, -190, 0, 22))
	Kit.list(nameRow, 8, true)
	local name = Kit.text(nameRow, c.name, 17, F.bold, C.text)
	name.LayoutOrder = 1
	local tierTag = Kit.tag(nameRow, TIER_TEXT[c.trip] or c.trip, if c.trip == "abroad" then C.warn elseif c.trip == "region" then C.good else C.muted, 2)
	tierTag.Name = "Tier"
	local pinTag = Kit.tag(nameRow, "Pinned", C.text, 3)
	Theme.bindAccent(pinTag, "TextColor3")
	pinTag.Visible = false
	local value = Kit.text(frame, dollars(c.retainer) .. "/day", 16, F.bold, C.text)
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.fromScale(1, 0)
	local status = Kit.text(frame, "", 14, F.medium, C.muted)
	status.Name = "Status"
	status.AutomaticSize = Enum.AutomaticSize.None
	status.Size = UDim2.new(1, -190, 0, 18)
	status.Position = UDim2.fromOffset(0, 27)
	status.TextTruncate = Enum.TextTruncate.AtEnd
	local bar = Kit.bar(frame, 6)
	bar.frame.Name = "Trust"
	bar.frame.Size = UDim2.new(1, -190, 0, 6)
	bar.frame.Position = UDim2.fromOffset(0, 52)
	local buttons = Kit.frame(frame, UDim2.fromOffset(176, 30), UDim2.fromScale(1, 1))
	buttons.AnchorPoint = Vector2.new(1, 1)
	local layout = Kit.list(buttons, 8, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	local pin = Kit.button(buttons, "Pin", "secondary", UDim2.fromOffset(84, 30))
	pin.Name = "Pin"
	pin.TextSize = 14
	pin.LayoutOrder = 1
	local skip = Kit.button(buttons, "Skip", "ghost", UDim2.fromOffset(84, 30))
	skip.Name = "Skip"
	skip.TextSize = 14
	skip.LayoutOrder = 2
	local join = Kit.button(buttons, "Join in person", "secondary", UDim2.fromOffset(176, 30))
	join.Name = "Join"
	join.TextSize = 14
	join.LayoutOrder = 3
	Kit.onClick(pin, function() call("DealAction", { action = "pin", clientId = c.id }) end)
	Kit.onClick(skip, function() call("DealAction", { action = "skip", clientId = c.id }) end)
	Kit.onClick(join, function()
		task.spawn(function()
			local ok, res = Action.call("DealAction", { action = "joinMeeting", clientId = c.id }, true)
			if ok then Toast.show("success", "You joined the " .. c.name .. " meeting: trust +15 %.", 5)
			elseif res.err == "ALREADY_DONE" then Toast.show("info", "You are already in the " .. c.name .. " meeting.", 4)
			elseif res.err ~= "BUSY" then Toast.show("error", Action.message(res.err)) end
		end)
	end)
	local function update(s: any)
		local data = s.data
		local e = data.empire
		local d = if typeof(e.deals) == "table" then e.deals else Ops.newDeals()
		local acc = if typeof(d.accounts) == "table" then d.accounts[c.id] else nil
		local trust = if typeof(d.trust) == "table" then tonumber(d.trust[c.id]) else nil
		local pinned = d.pinned == c.id
		local skipped = typeof(d.skip) == "table" and d.skip[c.id] == true
		local trip = tripOf(s, c.id)
		local stage = Ops.stageIndex(e)
		local best = Ops.liveBest(data, c.stat)
		local group, text, color = "lead", "", C.muted
		local fraction: number? = nil
		local canPin, canJoin = false, false
		if acc then
			group = "account"
			local left = (tonumber(acc.expires) or 0) - (tonumber(e.seconds) or 0)
			if acc.renewing or (trip and trip.kind == "renew") then
				text = "Account · check-in visit under way · renews for " .. Ops.TERM_DAYS .. " more days"
			else
				text = string.format("Account until day %d · %.1f days left", endDay(s, left), math.max(0, left) / Ops.DAY)
			end
			color = C.good
		elseif stage &lt; c.stage then
			group = "later"
			text = "Unlocks at the " .. stageName(c.stage) .. (if c.trip == "abroad" then " · Port Meridian, flight + 2 nights" elseif c.trip == "region" then " · Business City, City Hotel night" else "")
			color = C.dim
		elseif best &lt; c.minimum then
			group = "needs"
			text = string.format("Needs %s %d · your best live model: %d", c.stat, c.minimum, math.floor(best))
			color = C.warn
			canPin = true
		else
			canPin = true
			fraction = math.min(1, trust or 0)
			if trip and trip.kind == "sign" then
				text = (if trip.hosted then "Client team at your guest house" else "Pilot visit under way") .. " · back in " .. Format.duration(math.max(0, (tonumber(trip.back) or 0) - (tonumber(e.seconds) or 0)))
				color = C.text
				canJoin = not trip.hosted
				canPin = false -- the visit is already under way
			elseif skipped then
				text = "Skipped · your sales team leaves it out"
				color = C.dim
			else
				local accounts, limit = 0, Ops.accountLimit(e)
				if typeof(d.accounts) == "table" then for _ in d.accounts do accounts += 1 end end
				local seller = if c.trip == "city" then "you or a field rep" else "a field rep"
				local why = if accounts &gt;= limit then " · all account slots are taken" elseif c.trip ~= "city" and Ops.fieldReps(e) == 0 then " · needs a field rep (Growth &amp; Sales)" else " · next visit by " .. seller
				text = string.format("Lead · trust %d %%", math.floor((trust or 0) * 100)) .. why
				color = C.muted
			end
		end
		if pinned and group ~= "account" then text = "Pinned · visited next · " .. text end
		status.Text = text
		status.TextColor3 = color
		pinTag.Visible = pinned and group ~= "account"
		stroke.Color = if pinned and group ~= "account" then Theme.accent else C.line
		stroke.Transparency = if pinned and group ~= "account" then 0.4 else 0.93
		bar.frame.Visible = fraction ~= nil
		if fraction then bar.set(fraction) end
		pin.Visible = canPin
		skip.Visible = canPin and not canJoin
		join.Visible = canJoin

		pin.Text = if pinned then "Unpin" else "Pin"
		skip.Text = if skipped then "Unskip" else "Skip"
		value.TextColor3 = if group == "account" then C.good elseif group == "later" then C.dim else C.text
		name.TextColor3 = if group == "later" then C.muted else C.text
		frame.LayoutOrder = GROUPS[group] + table.find(Ops.CLIENTS, c) :: number
		-- rows without a trust bar or buttons (accounts, later stages) are shorter
		frame.Size = UDim2.new(1, 0, 0, if fraction ~= nil or canPin then 84 else 62)
		frame:SetAttribute("Group", group)
	end
	return { frame = frame, update = update }
end
local function clients(parent: Instance)
	local head = Kit.card(parent, 1)
	title(head, "Business clients")
	local summary = para(head, "", 2)
	local stats = Kit.grid(head, 4, 52, 10, 3)
	local mAccounts = Kit.metric(stats, "Accounts", 1, 20)
	local mRetainers = Kit.metric(stats, "Retainers", 2, 20)
	local mReps = Kit.metric(stats, "Field reps", 3, 20)
	local mTrips = Kit.metric(stats, "On the road", 4, 20)
	dim(head, "Sales run by themselves: the founder sells city clients (up to " .. Ops.FOUNDER_ACCOUNTS .. " accounts), Growth &amp; Sales field reps take " .. Ops.ACCOUNTS_PER_REP .. " accounts each. Visits start 08:00–15:00. A signed client pays one day as pilot fee, then every day for " .. Ops.TERM_DAYS .. " days; a check-in visit renews it. Pin a client to visit it next, skip to leave it out.", 4)
	local road = Kit.card(parent, 2)
	title(road, "On the road")
	local roadRows = Kit.stack(road, 6, 2)
	local list = Kit.stack(parent, 8, 3)
	local captions: { [string]: TextLabel } = {}
	for group, order in GROUPS do
		local cap = Kit.text(list, "", 15, F.bold, C.text)
		cap.LayoutOrder = order
		captions[group] = cap
	end
	local rows: { ClientRow } = {}
	for _, c in Ops.CLIENTS do table.insert(rows, clientRow(list, c)) end
	local log = Kit.card(parent, 4)
	title(log, "Company log")
	local logText = Kit.para(log, "", 13, C.muted, 2)
	local roadSig: string? = nil
	watch(function(s)
		local e = s.data.empire
		local d = if typeof(e.deals) == "table" then e.deals else Ops.newDeals()
		local ops = if typeof(s.live.ops) == "table" then s.live.ops else {}
		local accounts, retainer = 0, 0
		if typeof(d.accounts) == "table" then
			for id in d.accounts do
				local c = Ops.client(id)
				accounts += 1
				if c then retainer += c.retainer end
			end
		end
		local limit = Ops.accountLimit(e)
		local reps = Ops.fieldReps(e)
		local trips = if typeof(ops.trips) == "table" then ops.trips else (if typeof(d.tripList) == "table" then d.tripList else {})
		mAccounts.value.Text = string.format("%d / %d", accounts, limit)
		mRetainers.value.Text = dollars(retainer) .. "/day"
		mReps.value.Text = tostring(reps)
		mTrips.value.Text = tostring(#trips)
		local slots = Ops.stage(e).clients
		summary.Text = string.format("%d of %d account slots in use (%s: %d slots, you %d + field reps %d × %d). Retainers pay %s/day.",
			accounts, limit, stageName(Ops.stageIndex(e)), slots, Ops.FOUNDER_ACCOUNTS, reps, Ops.ACCOUNTS_PER_REP, dollars(retainer))
		local sig = ""
		for _, t in trips do sig ..= tostring(t.client) .. tostring(t.kind) .. "|" end
		if sig ~= roadSig then
			roadSig = sig
			clearRows(roadRows)
			for i, t in trips do
				local line = Kit.para(roadRows, "", 14, C.text, i)
				line.Name = "Trip_" .. tostring(t.client)
			end
			if #trips == 0 then
				Kit.para(roadRows, "Nobody is travelling right now.", 14, C.dim, 1).Name = "Empty"
			end
		end
		for _, t in trips do
			local line = roadRows:FindFirstChild("Trip_" .. tostring(t.client))
			if line and line:IsA("TextLabel") then line.Text = tripText(s, t) end
		end
		local counts: { [string]: number } = { account = 0, lead = 0, needs = 0, later = 0 }
		for _, row in rows do
			row.update(s)
			local g = row.frame:GetAttribute("Group")
			if typeof(g) == "string" then counts[g] = (counts[g] or 0) + 1 end
		end
		captions.account.Text = string.format("Accounts (%d)", counts.account)
		captions.lead.Text = string.format("Leads (%d)", counts.lead)
		captions.needs.Text = string.format("Needs a better model (%d)", counts.needs)
		captions.later.Text = string.format("Later stages (%d)", counts.later)
		for group, cap in captions do cap.Visible = (counts[group] or 0) &gt; 0 end
		local news = if typeof(d.news) == "table" then d.news else {}
		local lines = {}
		for i = 1, math.min(Ops.NEWS_SHOWN, #news) do table.insert(lines, tostring(news[i])) end
		logText.Text = if #lines &gt; 0 then table.concat(lines, "\n") else "Nothing happened yet. Every automatic decision (trips, signings, hires, prices, Save mode) is written here."
	end)
end

-- Money (CORE_SPEC 4 / 6): P&amp;L per company day from the replicated ledger -------------------------------------
local LABELS: { [string]: string } = {
	market = "AI products (users + API)", api = "API access sales", b2b = "Client retainers", pilot = "Pilot fees", studio = "Studio briefs",
	guest = "Guest house", retail = "Café &amp; stores", daily = "Daily grant", quest = "Milestones", shop = "Shop", campus = "Campus",
	wages = "Wages", ops = "Operations staff", upkeep = "Rent &amp; utilities", food = "Lunch", fleet = "Fleet leases", trips = "Trips &amp; hotels",
	b2bserve = "Client serving", jet = "Company jet", jetbuy = "Jet purchase", hire = "Hiring fees", research = "Research", lab = "Lab levels",
	office = "Office move", gpu = "GPUs", data = "Training data", training = "Training runs", refine = "Refinement", marketing = "Marketing",
	travel = "Travel", cars = "Cars", other = "Other", admin = "Admin", debug = "Debug",
}
local COST_LABELS: { [string]: string } = { market = "Serving &amp; power", guest = "Guest house running", campus = "Campus purchases" }
function App.categoryLabel(cat: string, cost: boolean): string
	if cost and COST_LABELS[cat] then return COST_LABELS[cat] end
	local known = LABELS[cat]
	if known then return known end
	return string.upper(string.sub(cat, 1, 1)) .. string.sub(cat, 2)
end
-- one company day of the ledger: sorted lines and totals (whole dollars, zero lines dropped)
function App.ledgerDay(entry: any): ({ { cat: string, value: number } }, { { cat: string, value: number } }, number, number)
	local function side(map: any): ({ { cat: string, value: number } }, number)
		local out, total = {}, 0
		if typeof(map) == "table" then
			for cat, v in map do
				local n = tonumber(v) or 0
				if n &gt; 0 and typeof(cat) == "string" then table.insert(out, { cat = cat, value = n }); total += n end
			end
		end
		table.sort(out, function(a, b) if a.value ~= b.value then return a.value &gt; b.value end; return a.cat &lt; b.cat end)
		return out, total
	end
	local income, inTotal = side(if typeof(entry) == "table" then entry.i else nil)
	local costs, outTotal = side(if typeof(entry) == "table" then entry.o else nil)
	return income, costs, inTotal, outTotal
end
function App.ledgerDays(ledger: any): { number }
	local days = {}
	if typeof(ledger) == "table" then for key in ledger do local n = tonumber(key); if n then table.insert(days, n) end end end
	table.sort(days, function(a, b) return a &gt; b end)
	return days
end
local function lineRow(parent: Instance, order: number, label: string, value: string, color: Color3, bold: boolean?): Frame
	local row = Kit.frame(parent, UDim2.new(1, 0, 0, 22))
	row.LayoutOrder = order
	Kit.cell(row, label, UDim.new(0.62, 0), 14, if bold then F.bold else F.regular, if bold then C.text else C.muted).Position = UDim2.new()
	local v = Kit.cell(row, value, UDim.new(0.38, 0), 14, F.bold, color)
	v.Position = UDim2.fromScale(0.62, 0)
	v.TextXAlignment = Enum.TextXAlignment.Right
	return row
end
local function money(parent: Instance)
	local today = Kit.card(parent, 1)
	local todayTitle = title(today, "Today")
	local todayText = para(today, "", 2)
	local cols = Kit.frame(today, UDim2.fromScale(1, 0))
	cols.AutomaticSize = Enum.AutomaticSize.Y
	cols.LayoutOrder = 3
	local left = Kit.frame(cols, UDim2.new(0.5, -12, 0, 0))
	left.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(left, 2)
	local right = Kit.frame(cols, UDim2.new(0.5, -12, 0, 0), UDim2.new(0.5, 12, 0, 0))
	right.AutomaticSize = Enum.AutomaticSize.Y
	Kit.list(right, 2)
	local net = Kit.text(today, "", 20, F.display, C.text)
	net.LayoutOrder = 4
	local days = Kit.card(parent, 2)
	title(days, "Last company days")
	local daysText = para(days, "", 2)
	local tableFrame = Kit.stack(days, 2, 3)
	local chart = Kit.frame(days, UDim2.new(1, 0, 0, 96))
	chart.LayoutOrder = 4
	local running = Kit.card(parent, 3)
	title(running, "Running now, per game day")
	local runRows = Kit.stack(running, 2, 2)
	dim(running, "Live rates at this moment (a game day is 20 minutes: 15 min day, 5 min night). Wages are paid day and night, also during vacation and sick days.", 3)
	local sig: string? = nil
	watch(function(s)
		local e = s.data.empire
		local ledger = if typeof(e.ledger) == "table" then e.ledger else {}
		local dayNow = Ops.day(e)
		local list = App.ledgerDays(ledger)
		local income, costs, inTotal, outTotal = App.ledgerDay(ledger[tostring(dayNow)])
		todayTitle.Text = "Today · day " .. dayNow
		todayText.Text = if #income + #costs == 0 then "Nothing booked yet today." else "Every dollar of today, by category (the company day started at 08:00)."
		local s2 = tostring(dayNow) .. "|" .. tostring(inTotal) .. "|" .. tostring(outTotal) .. "|" .. tostring(#list)
		for _, k in list do local _, _, a, b = App.ledgerDay(ledger[tostring(k)]); s2 ..= "|" .. a .. ":" .. b end
		if s2 ~= sig then
			sig = s2
			clearRows(left); clearRows(right)
			Kit.list(left, 2); Kit.list(right, 2)
			Kit.caption(left, "Income", 0)
			Kit.caption(right, "Costs", 0)
			for i, l in income do lineRow(left, i, App.categoryLabel(l.cat, false), "+" .. dollars(l.value), C.good) end
			for i, l in costs do lineRow(right, i, App.categoryLabel(l.cat, true), "-" .. dollars(l.value), C.bad) end
			if #income == 0 then lineRow(left, 1, "No income yet", "$0", C.dim) end
			if #costs == 0 then lineRow(right, 1, "No costs yet", "$0", C.dim) end
			lineRow(left, 99, "Total", "+" .. dollars(inTotal), C.good, true)
			lineRow(right, 99, "Total", if outTotal &gt; 0 then "-" .. dollars(outTotal) else "$0", C.bad, true)
			local n = inTotal - outTotal
			net.Text = "Net today  " .. (if n &gt;= 0 then "+" else "") .. dollars(n)
			net.TextColor3 = if n &gt;= 0 then C.good else C.bad
			-- last days: oldest left, today right
			clearRows(tableFrame)
			clearRows(chart)
			local shown = {}
			for i = math.min(#list, Ops.LEDGER_SHOWN), 1, -1 do table.insert(shown, list[i]) end
			daysText.Text = if #shown &lt;= 1 then "The table fills up day by day (the last " .. Ops.LEDGER_SHOWN .. " company days are kept here)." else string.format("The last %d company days (today so far on the right).", #shown)
			local head = Kit.frame(tableFrame, UDim2.new(1, 0, 0, 22))
			head.LayoutOrder = 0
			local w = 1 / (#shown + 1)
			Kit.cell(head, "", UDim.new(w, 0), 13, F.medium, C.muted)
			local rowNames = { "Income", "Costs", "Net" }
			local totals: { { number } } = {}
			for j, day in shown do
				local _, _, a, b = App.ledgerDay(ledger[tostring(day)])
				totals[j] = { a, b, a - b }
				local cell = Kit.cell(head, if day == dayNow then "Day " .. day .. " (today)" else "Day " .. day, UDim.new(w, 0), 13, F.bold, C.muted)
				cell.Position = UDim2.fromScale(w * j, 0)
				cell.TextXAlignment = Enum.TextXAlignment.Right
			end
			for r, rowName in rowNames do
				local row = Kit.frame(tableFrame, UDim2.new(1, 0, 0, 22))
				row.LayoutOrder = r
				Kit.cell(row, rowName, UDim.new(w, 0), 14, if r == 3 then F.bold else F.regular, if r == 3 then C.text else C.muted)
				for j in shown do
					local v = totals[j][r]
					local text = if r == 1 then "+" .. dollars(v) elseif r == 2 then "-" .. dollars(v) else (if v &gt;= 0 then "+" else "") .. dollars(v)
					local cell = Kit.cell(row, text, UDim.new(w, 0), 14, F.bold, if r == 1 then C.good elseif r == 2 then C.bad elseif v &gt;= 0 then C.good else C.bad)
					cell.Position = UDim2.fromScale(w * j, 0)
					cell.TextXAlignment = Enum.TextXAlignment.Right
				end
			end
			-- net bars per day (zero line placed by the largest gain and loss, like the profit chart)
			tableFrame.Visible = #shown &gt;= 1
			chart.Visible = #shown &gt;= 1
			local hi, lo = 0, 0
			for _, t in totals do hi = math.max(hi, t[3]); lo = math.min(lo, t[3]) end
			local range = math.max(1, hi - lo)
			local zeroY = hi / range
			local zero = Kit.frame(chart, UDim2.new(1, 0, 0, 1), UDim2.fromScale(0, zeroY))
			zero.BackgroundTransparency = 0.5
			zero.BackgroundColor3 = C.dim
			for j, t in totals do
				local h = math.abs(t[3]) / range
				local b = Kit.frame(chart, UDim2.new(w * 0.5, 0, h, 0), UDim2.fromScale(w * j + w * 0.45, zeroY))
				b.AnchorPoint = Vector2.new(0, if t[3] &gt;= 0 then 1 else 0)
				b.BackgroundTransparency = 0.15
				b.BackgroundColor3 = if t[3] &gt;= 0 then C.good else C.bad
				Kit.corner(b, 3)
			end
		end
		-- running rates per game day from the live summary (live.ops: $/min per category)
		clearRows(runRows)
		local ops = if typeof(s.live.ops) == "table" then s.live.ops else {}
		local revenueMin = (tonumber(s.live.revenue) or 0) * 60
		local costMin = (tonumber(s.live.cost) or 0) * 60
		local b2b, guest = tonumber(ops.b2b) or 0, tonumber(ops.guest) or 0
		type Line = { label: string, value: number, income: boolean }
		local lines: { Line } = {
			{ label = "AI products (users + API)", value = math.max(0, revenueMin - b2b - guest), income = true },
			{ label = "Client retainers", value = b2b, income = true },
			{ label = "Guest house", value = guest, income = true },
		}
		local known = 0
		for _, key in { "wages", "ops", "upkeep", "food", "fleet", "guest", "jet", "b2bserve" } do
			local v = tonumber(ops[key .. "Cost"]) or 0
			known += v
			table.insert(lines, { label = App.categoryLabel(key, true), value = v, income = false })
		end
		table.insert(lines, { label = "Serving &amp; power", value = math.max(0, costMin - known), income = false })
		local order = 0
		for _, l in lines do
			if l.value &gt; 0.5 then
				order += 1
				lineRow(runRows, order, l.label, (if l.income then "+" else "-") .. perDay(l.value), if l.income then C.good else C.bad)
			end
		end
		order += 1
		local netMin = revenueMin - costMin
		lineRow(runRows, order, "Net", (if netMin &gt;= 0 then "+" else "-") .. perDay(math.abs(netMin)), if netMin &gt;= 0 then C.good else C.bad, true)
	end)
end

-- Team section: open applications (invite → the candidate walks to the visitor lounge for an in-person
-- interview), the hired team with persistent names, revealed skill and individual wage, and the
-- instant agency hires below.
local function stars(k: number): string
	local n = math.clamp(math.floor(k + 0.5), 1, 5)
	return string.rep("★", n) .. string.rep("☆", 5 - n)
end
local function applications(parent: Instance, order: number)
	local card = Kit.card(parent, order)
	title(card, "Applications")
	local info = para(card, "", 2)
	local rows = Kit.stack(card, 8, 3)
	local signature: string? = nil
	local expiry: { [string]: TextLabel } = {}
	watch(function(s)
		local e = s.data.empire
		local list = e.applicants or {}
		local full = Math.staff(e) &gt;= Config.OFFICES[e.office].staff
		info.Text = if #list == 0 then (if full then "Every desk is filled, so nobody is applying. Upgrade your office to grow the team." else "No open applications right now. While desks are free, a new candidate applies every few minutes.")
			else "Invite a candidate and they walk to the visitor lounge on the ground floor. Talk to them there: the interview decides whether you hire them. Applications close after 30 minutes."
		local sig = ""
		for _, a in list do sig ..= a.id .. a.st .. "|" end
		sig ..= tostring(Math.staff(e))
		if sig ~= signature then
			signature = sig
			clearRows(rows)
			table.clear(expiry)
			for i, a in list do
				local roleDef = Config.find(Config.ROLES, a.role)
				local row = Kit.frame(rows, UDim2.new(1, 0, 0, 52))
				row.LayoutOrder = i
				local initials = ""
				for word in string.gmatch(a.n, "%S+") do initials ..= string.sub(word, 1, 1) end
				Conversation.avatar(row, string.upper(string.sub(initials, 1, 2)), a.s, 40).Position = UDim2.fromOffset(0, 6)
				local name = Kit.text(row, a.n, 16, F.bold, C.text)
				name.Position = UDim2.fromOffset(52, 4)
				-- same price the server charges (RecruitingService.hireCost: escalates with the team size)
				local cost = if roleDef then Format.money(math.floor(Math.hireCost(e, roleDef) * a.ask + 0.5)) else "?"
				local sub = Kit.text(row, string.format("%s  ·  %d yrs  ·  ex-%s  ·  asks %s", if roleDef then roleDef.name else a.role, a.xp, a.prev, cost), 13, F.regular, C.muted)
				sub.Position = UDim2.fromOffset(52, 27)
				sub.AutomaticSize = Enum.AutomaticSize.None
				sub.Size = UDim2.new(1, -250, 0, 18)
				sub.TextTruncate = Enum.TextTruncate.AtEnd
				local status = Kit.text(row, "", 12, F.medium, C.muted)
				status.AnchorPoint = Vector2.new(1, 0)
				status.Position = UDim2.new(1, -180, 0, 6)
				status.TextXAlignment = Enum.TextXAlignment.Right
				if a.st == "new" then
					expiry[a.id] = status
					local invite = Kit.button(row, "Invite", "primary", UDim2.fromOffset(86, 34))
					invite.AnchorPoint = Vector2.new(1, 0.5)
					invite.Position = UDim2.new(1, -90, 0.5, 0)
					invite.TextSize = 15
					Kit.onClick(invite, function()
						task.spawn(function()
							local ok = People.call("RecruitAction", { action = "invite", id = a.id })
							if ok then Toast.show("success", a.n .. " is on the way to your visitor lounge.", 4) end
						end)
					end)
				else
					status.Text = if a.st == "interviewing" then "In the interview" else "Waiting in the visitor lounge (G)"
					Theme.bindAccent(status, "TextColor3")
				end
				local reject = Kit.button(row, "Reject", "danger", UDim2.fromOffset(80, 34))
				reject.AnchorPoint = Vector2.new(1, 0.5)
				reject.Position = UDim2.new(1, 0, 0.5, 0)
				reject.TextSize = 15
				Kit.onClick(reject, function()
					task.spawn(function()
						local ok = People.call("RecruitAction", { action = "reject", id = a.id })
						if ok then Toast.show("info", "Application from " .. a.n .. " declined.", 3) end
					end)
				end)
			end
		end
		for _, a in list do
			local label = expiry[a.id]
			if label then label.Text = "Closes in " .. Format.duration(math.max(0, Math.APPLICATION_SECONDS - ((e.seconds or 0) - a.at))) end
		end
	end)
end
local ROSTER_LIMIT = 40
local function roster(parent: Instance, order: number)
	local card = Kit.card(parent, order)
	title(card, "Your team")
	local summary = para(card, "", 2)
	local filter = "all"
	local signature: string? = nil
	local rows: Frame
	local more: TextLabel
	local function update(s: any)
		local e = s.data.empire
		local profiles = e.staffProfiles or {}
		local total, skill, payroll = 0, 0, 0
		local entries = {}
		local day = Ops.day(e)
		for _, roleDef in Config.ROLES do
			local list = profiles[roleDef.id] or {}
			for i = 1, e.employees[roleDef.id] or 0 do
				local p = list[i]
				local k = if p and typeof(p.k) == "number" then p.k else 3
				local w = if p and typeof(p.w) == "number" then p.w else 1
				local apprentice = if p and typeof(p.s) == "number" then (Ops.apprentice(e, p.s, day)) else nil
				total += 1; skill += k; payroll += roleDef.wage * w
				if filter == "all" or filter == roleDef.id then
					table.insert(entries, { role = roleDef, index = i, name = if p and typeof(p.n) == "string" then p.n else "New hire", k = k, wage = roleDef.wage * w, apprentice = apprentice ~= nil })
				end
			end
		end
		summary.Text = if total == 0 then "Nobody works here yet. Interview applicants or hire through the agency below."
			else string.format("%d people  ·  average skill %.1f ★  ·  payroll $%.2f/s  ·  skill ★1–★5 changes each person's output from 80%% to 120%%", total, skill / total, payroll)
		table.sort(entries, function(a, b) if a.k ~= b.k then return a.k &gt; b.k end; return a.name &lt; b.name end)
		local sig = filter
		for n, entry in entries do if n &gt; ROSTER_LIMIT then break end; sig ..= entry.role.id .. entry.index .. entry.name .. entry.k .. string.format("%.3f", entry.wage) .. tostring(entry.apprentice) end
		if sig == signature then return end
		signature = sig
		clearRows(rows)
		for n, entry in entries do
			if n &gt; ROSTER_LIMIT then break end
			local row = Kit.frame(rows, UDim2.new(1, 0, 0, 34))
			row.LayoutOrder = n
			Kit.cell(row, entry.name, UDim.new(0.3, 0), 15, F.bold, C.text).Position = UDim2.new()
			local roleCell = Kit.cell(row, if entry.apprentice then entry.role.name .. " · apprentice" else entry.role.name, UDim.new(0.22, 0), 13, F.regular, C.muted)
			roleCell.Position = UDim2.fromScale(0.3, 0)
			local starCell = Kit.cell(row, stars(entry.k), UDim.new(0.18, 0), 15, F.bold, C.warn)
			starCell.Position = UDim2.fromScale(0.52, 0)
			local wageCell = Kit.cell(row, string.format("$%.2f/s", entry.wage), UDim.new(0.14, 0), 13, F.medium, C.muted)
			wageCell.Position = UDim2.fromScale(0.7, 0)
			local dismiss = Kit.button(row, "Dismiss", "ghost", UDim2.new(0.15, 0, 1, -4))
			dismiss.AnchorPoint = Vector2.new(1, 0)
			dismiss.Position = UDim2.new(1, 0, 0, 2)
			dismiss.TextSize = 13
			Kit.onClick(dismiss, function()
				call("FireEmployee", { roleId = entry.role.id, index = entry.index, name = entry.name }, entry.name .. " left the company.")
			end)
		end
		more.Text = if #entries &gt; ROSTER_LIMIT then string.format("+ %d more (showing the %d most skilled)", #entries - ROSTER_LIMIT, ROSTER_LIMIT) else ""
		more.Visible = #entries &gt; ROSTER_LIMIT
	end
	local selector = Kit.segmented(card, { { id = "all", label = "All" }, { id = "researcher", label = "Research" }, { id = "engineer", label = "Engineering" }, { id = "curator", label = "Data" }, { id = "marketer", label = "Growth" } }, filter, function(id)
		filter = id
		signature = nil
		if State.snapshot then update(State.snapshot) end
	end)
	selector.frame.LayoutOrder = 3
	rows = Kit.stack(card, 4, 4)
	more = para(card, "", 5)
	watch(update)
end
local function team(parent: Instance)
	local intro = Kit.card(parent, 1)
	title(intro, "Specialists, real advantages")
	local capacity = para(intro, "")
	watch(function(s)
		local e = s.data.empire
		capacity.Text = string.format("%d / %d desks filled. Staff earn wages every second, day and night (also on vacation and sick days). Bonuses stop when you dismiss an employee. Hiring fees are non-refundable. Agency hires start at once with average skill (★2–★3); interviewing applicants is how you find stronger people. Automatic HR and apprentices: Company → Settings.",Math.staff(e),Config.OFFICES[e.office].staff)
	end)
	applications(parent, 2)
	roster(parent, 3)
	for i, role in Config.ROLES do
		local card = Kit.card(parent, i+3)
		title(card, role.name)
		para(card, role.desc)
		local info = para(card, "", 3)
		local row = Kit.row(card,40,10,4)
		local hire = Kit.button(row,"Hire","primary",UDim2.new(0.4,-6,1,0))
		local group = Kit.button(row,"Hire 5","secondary",UDim2.new(0.35,-6,1,0))
		local fire = Kit.button(row,"Dismiss one","secondary",UDim2.new(0.25,-6,1,0))
		Kit.onClick(hire,function() call("HireEmployee",{roleId=role.id},role.name .. " hired!") end)
		Kit.onClick(group,function()call("HireEmployee",{roleId=role.id,count=5},"Five specialists hired!")end)
		Kit.onClick(fire,function() call("FireEmployee",{roleId=role.id},"Employee dismissed.") end)
		watch(function(s)
			local e=s.data.empire
			local count=e.employees[role.id] or 0
			local price=Math.hireCost(e,role)
			info.Text=string.format("On your team: %d  ·  Wage: $%.2f/s each (%s/day)",count,role.wage,dollars(role.wage*Ops.DAY))
			hire.Text="Hire · " .. Format.money(price)
			Kit.setDisabled(hire,Math.staff(e)&gt;=Config.OFFICES[e.office].staff or s.data.money&lt;price)
			local groupCost=0
			for j=0,4 do groupCost+=Math.hireCost({employees={[role.id]=count+j}},role) end
			group.Text="Hire 5 · "..Format.money(groupCost)
			Kit.setDisabled(group,Math.staff(e)+5&gt;Config.OFFICES[e.office].staff or s.data.money&lt;groupCost)
			Kit.setDisabled(fire,count==0)
		end)
	end
end
local function research(parent: Instance)
	local active=Kit.card(parent,1)
	title(active,"The research lab")
	local info=para(active,"")
	local bar=Kit.bar(active,8,3)
	watch(function(s)
		local e=s.data.empire
		local job=e.researchJob
		local b=Math.bonuses(e)
		info.Text=string.format("%.0f RP available · +%.2f RP/s at full staff (only during office hours)\n",e.points,b.points*(if s.data.company.spec=="research" then 1.2 else 1)) ..
			(if job then "Researching " .. Config.find(Config.RESEARCH,job.id).name .. " · " .. tostring(math.ceil(job.seconds-job.elapsed)) .. "s left" else "Pick your next breakthrough. Research continues while you are online.")
		bar.frame.Visible=job~=nil
		if job then bar.set(job.elapsed/job.seconds) end
	end)
	for i,def in Config.RESEARCH do
		local card=Kit.card(parent,i+1)
		title(card,def.name)
		para(card,def.desc)
		local info=para(card,"",3)
		local b=button(card,"Research",function() call("StartResearch",{researchId=def.id},"Research started: " .. def.name) end)
		watch(function(s)
			local e=s.data.empire
			local locked=def.prereq and not e.research[def.prereq]
			local done=e.research[def.id]==true
			info.Text=string.format("%s · %d RP · %ds",Format.money(def.cost),def.points,def.seconds) ..
				(if locked then "\nRequires: " .. Config.find(Config.RESEARCH,def.prereq).name else "")
			b.Text=if done then "Completed" elseif e.researchJob and e.researchJob.id==def.id then "Researching..." elseif locked then "Locked" else "Start research"
			Kit.setDisabled(b,done or locked==true or e.researchJob~=nil or e.points&lt;def.points or s.data.money&lt;def.cost)
		end)
	end
end
local function milestones(parent: Instance)
	for i,def in Config.QUESTS do
		local card=Kit.card(parent,i)
		title(card,def.name)
		para(card,def.desc .. "  Reward: " .. Format.money(def.reward) .. " + " .. tostring(def.xp) .. " XP")
		local bar=Kit.bar(card,7,3)
		local b=button(card,"In progress",function() call("ClaimQuest",{questId=def.id},"Milestone reward collected!") end)
		watch(function(s)
			local p=Math.progress(s.data,def)
			local done=s.data.empire.quests[def.id]==true
			bar.set(math.min(1,p/def.target))
			b.Text=if done then "Collected" elseif p&gt;=def.target then "Collect " .. Format.money(def.reward) else Format.compact(p) .. " / " .. Format.compact(def.target)
			Kit.setDisabled(b,done or p&lt;def.target)
		end)
	end
end
local function office(parent: Instance)
	local card=Kit.card(parent,1)
	local name=title(card,"Office")
	local info=para(card,"")
	local b=button(card,"Upgrade",function() call("UpgradeOffice",{},"Office expanded. Visit your new building!") end)
	watch(function(s)
		local e=s.data.empire
		local def=Config.OFFICES[e.office]
		local nextOffice=Config.OFFICES[e.office+1]
		name.Text=def.name
		-- 5 stages (CORE_SPEC 2.1): the Garage Lab, then the four headquarters buildings
		local gate=e.office==1 and (tonumber(e.contractsCompleted) or 0)&lt;1
		info.Text=string.format("Stage %d / %d · %d staff desks · %.2f base RP/s · rent &amp; utilities %s/day\n%s",e.office,#Config.OFFICES,def.staff,def.points,dollars(Ops.STAGES[Ops.stageIndex(e)].upkeep),
			if e.office==1 then "A converted garage with 5 team desks, the founder corner and a small GPU shelf. Leaving it needs your first signed business client." else "Floors, campus operations staff, stores, kitchen and underground parking grow with every stage.")
		b.Text=if not nextOffice then "Maximum office reached" elseif gate then "Sign your first client to leave the garage" else "Upgrade: " .. nextOffice.name .. " · " .. Format.money(nextOffice.price)
		Kit.setDisabled(b,nextOffice==nil or gate or (nextOffice~=nil and s.data.money&lt;nextOffice.price))
	end)
	for i,def in Config.OFFICES do
		local row=Kit.card(parent,i+1)
		local head=title(row,tostring(i) .. " · " .. def.name)
		watch(function(s)
			local here=Ops.stageIndex(s.data.empire)==i
			head.Text=tostring(i) .. " · " .. def.name .. (if here then "  ·  your office" else "")
			head.TextColor3=if here then Theme.accent:Lerp(C.white,0.3) else C.text
		end)
		local st=Ops.STAGES[i]
		para(row,string.format("%d employee desks · %d GPU slots · %d product line%s · %d client slots · %s trips · rent &amp; utilities %s/day\n%s",
			def.staff,HardwareConfig.STAGE_SLOTS[i] or 0,ModelMath.productSlots(i),if ModelMath.productSlots(i)==1 then "" else "s",st.clients,st.trips,dollars(st.upkeep),
			if i==1 then "Where every company starts" elseif i==2 then Format.money(def.price) .. " + your first signed client" else Format.money(def.price)))
	end
end

-- Settings (CORE_SPEC 8.1 / 11.1 / 11.2): the player decisions of the automatic company -------------------------
local function apprenticeList(e: any): { { name: string, role: string, day: number, skill: number } }
	local out = {}
	local map = e.apprentices
	if typeof(map) ~= "table" or next(map) == nil or typeof(e.staffProfiles) ~= "table" then return out end
	local today = Ops.day(e)
	for _, roleDef in Config.ROLES do
		local list = e.staffProfiles[roleDef.id]
		if typeof(list) == "table" then
			for i = 1, math.min(#list, e.employees[roleDef.id] or 0) do
				local p = list[i]
				local entry = if typeof(p) == "table" and typeof(p.s) == "number" then map[tostring(p.s)] else nil
				if typeof(entry) == "table" then
					local skill = Ops.apprentice(e, p.s, today)
					if skill then
						table.insert(out, { name = tostring(p.n), role = roleDef.name, day = today - (tonumber(entry.day) or today) + 1, skill = skill })
					end
				end
			end
		end
	end
	table.sort(out, function(a, b) if a.day ~= b.day then return a.day &gt; b.day end; return a.name &lt; b.name end)
	return out
end
App.apprenticeList = apprenticeList
local function settings(parent: Instance)
	-- automatic HR
	local hr = Kit.card(parent, 1)
	title(hr, "Automatic HR")
	local hrText = para(hr, "", 2)
	local autoRow = Kit.row(hr, 36, 12, 3)
	Kit.text(autoRow, "Hire automatically", 15, F.medium, C.text).LayoutOrder = 1
	local autoSwitch = switch(autoRow, { { id = "on", label = "On" }, { id = "off", label = "Off" } }, "on", 2, 170, function(id)
		call("EmpireAction", { action = "hrAuto", on = id == "on" }, if id == "on" then "Automatic HR is on." else "Automatic HR is off. Hire by hand in Team.")
	end)
	local budgetRow = Kit.row(hr, 36, 12, 4)
	Kit.text(budgetRow, "Wage budget", 15, F.medium, C.text).LayoutOrder = 1
	local budgetOptions: { Kit.Option } = {}
	for _, b in Ops.HR_BUDGETS do table.insert(budgetOptions, { id = string.format("%.2f", b), label = string.format("%d %%", math.floor(b * 100 + 0.5)) }) end
	local budgetSwitch = switch(budgetRow, budgetOptions, "0.40", 2, 260, function(id)
		call("EmpireAction", { action = "hrBudget", budget = tonumber(id) }, "Wage budget set to " .. math.floor((tonumber(id) or 0) * 100 + 0.5) .. " % of income.")
	end)
	local needText = para(hr, "", 5)
	dim(hr, "HR hires one person every " .. Ops.HIRE_GAP .. " s into the department furthest below its need, only while the payroll (team + operations staff) stays inside the budget share of the 5-minute income. The first " .. Ops.HR_STARTERS .. " hires are always allowed. In Save mode HR stops at half the desks.", 6)
	-- Save mode
	local save = Kit.card(parent, 2)
	title(save, "Save mode")
	local saveText = para(save, "", 2)
	local saveRow = Kit.row(save, 36, 12, 3)
	Kit.text(saveRow, "Save for the next office", 15, F.medium, C.text).LayoutOrder = 1
	local saveSwitch = switch(saveRow, { { id = "auto", label = "Auto" }, { id = "off", label = "Off" } }, "auto", 2, 170, function(id)
		call("EmpireAction", { action = "saveMode", mode = id }, if id == "auto" then "Save mode: automatic." else "Save mode switched off.")
	end)
	dim(save, "Auto switches on when the next office is less than " .. Ops.SAVE_MINUTES .. " minutes of profit away. It pauses research, Lab levels, big trainings, HR beyond half the desks and ordinary GPU buys. GPUs that pay back fast while servers are full still get bought.", 4)
	-- night shift
	local night = Kit.card(parent, 3)
	title(night, "Night shift")
	local nightText = para(night, "", 2)
	local nightRows = Kit.stack(night, 6, 3)
	local nightSwitches: { [string]: Kit.Segmented } = {}
	local nightLabels: { [string]: TextLabel } = {}
	-- the night crew works per role (CompanyOps.nightOn: any department of the role); the switch sets all of them
	for i, roleDef in Config.ROLES do
		local row = Kit.row(nightRows, 36, 12, i)
		row.Name = "Night_" .. roleDef.id
		local label = Kit.cell(row, roleDef.name, UDim.new(0, 170), 15, F.medium, C.text)
		label.LayoutOrder = 1
		local sub = Kit.cell(row, "", UDim.new(1, -370), 13, F.regular, C.muted)
		sub.LayoutOrder = 2
		nightLabels[roleDef.id] = sub
		nightSwitches[roleDef.id] = switch(row, { { id = "off", label = "Off" }, { id = "on", label = "On" } }, "off", 3, 170, function(id)
			local snapshot = State.snapshot
			if not snapshot then return end
			local map = snapshot.data.empire.nightShift
			task.spawn(function()
				local okAll = true
				for _, dept in Ops.ROLE_DEPTS[roleDef.id] or {} do
					local on = typeof(map) == "table" and map[dept] == true
					if on ~= (id == "on") then
						local ok = Action.call("EmpireAction", { action = "nightShift", dept = dept, on = id == "on" })
						okAll = okAll and ok
					end
				end
				if okAll then Toast.show("success", roleDef.name .. (if id == "on" then ": night shift on." else ": night shift off.")) end
			end)
		end)
	end
	dim(night, "Heads beyond the desks (up to as many again) work 22:00–06:00 at full output instead of half, for " .. string.format("%.1f", Ops.NIGHT.wage) .. "× wage. It only pays when a department has more people than desks. Paused while cash stays below $0 for a whole day.", 4)
	-- apprentices
	local appr = Kit.card(parent, 4)
	title(appr, "Apprentices")
	local apprText = para(appr, "", 2)
	local hireRow = Kit.grid(appr, 4, 40, 8, 3)
	local hireButtons: { [string]: TextButton } = {}
	for i, roleDef in Config.ROLES do
		local b = Kit.button(hireRow, roleDef.name, "secondary", UDim2.new())
		b.LayoutOrder = i
		b.TextSize = 14
		b.Name = "Apprentice_" .. roleDef.id
		hireButtons[roleDef.id] = b
		Kit.onClick(b, function() call("HireEmployee", { roleId = roleDef.id, apprentice = true }, "New apprentice: " .. roleDef.name .. ". The Training Lead shows them around.") end)
	end
	local apprRows = Kit.stack(appr, 4, 4)
	dim(appr, string.format("Young trainees start at skill %d, gain +1 skill every %d company days up to %d and become regular staff after %d days. They cost %d %% of the agency fee and %d %% of the wage. The Training Lead (%s/day) is paid while you have apprentices.",
		Ops.APPRENTICE.startSkill, Ops.APPRENTICE.rampDays, Ops.APPRENTICE.endSkill, Ops.APPRENTICE.graduateDays, math.floor(Ops.APPRENTICE.fee * 100), math.floor(Ops.APPRENTICE.wage * 100), dollars(Ops.TRAINING_LEAD.wage)), 5)
	-- company jet
	local jet = Kit.card(parent, 5)
	title(jet, "Company jet")
	local jetText = para(jet, "", 2)
	local jetButton = button(jet, "Buy company jet", function()
		call("EmpireAction", { action = "buyJet" }, "The company jet is yours. It waits in the airport hangar with your 2 pilots.")
	end)
	jetButton.Name = "BuyJet"
	-- Lab level lives in the Models app
	local lab = Kit.card(parent, 6)
	title(lab, "Lab level")
	local labText = para(lab, "", 2)
	local labButton = Kit.button(lab, "Open Models", "secondary", UDim2.new(1, 0, 0, 40))
	labButton.LayoutOrder = 3
	Kit.onClick(labButton, function() if nav then nav.show("lab") end end)
	local apprSig: string? = nil
	watch(function(s)
		local e = s.data.empire
		local stage = Ops.stageIndex(e)
		local ops = if typeof(s.live.ops) == "table" then s.live.ops else {}
		local auto, budget = Ops.hrSettings(e)
		autoSwitch.set(if auto then "on" else "off")
		budgetSwitch.set(string.format("%.2f", budget))
		local payrollMin = (tonumber(ops.wagesCost) or 0) + (tonumber(ops.opsCost) or 0)
		local income = tonumber(ops.income) or 0
		local anyLive = false
		for _, id in s.data.modelOrder do local m = s.data.models[id]; if m and m.status == "live" then anyLive = true; break end end
		hrText.Text = string.format("Payroll now %s · budget %s (%d %% of the income of the last 5 minutes)%s",
			perDay(payrollMin), perDay(budget * income), math.floor(budget * 100 + 0.5), if not auto then " · automatic hiring is off" elseif not anyLive then " · HR starts hiring once your first model is live" else "")
		local needs = {}
		for _, id in Ops.HR_ORDER do
			local roleDef = Config.find(Config.ROLES, id)
			table.insert(needs, string.format("%s %d / %d", if roleDef then roleDef.name else id, e.employees[id] or 0, Ops.hrNeed(e, id)))
		end
		needText.Text = "People / HR target: " .. table.concat(needs, "  ·  ")
		-- Save mode
		saveSwitch.set(if e.saveMode == "off" then "off" else "auto")
		local nextDef = Config.OFFICES[stage + 1]
		saveText.Text = if e.saveMode == "off" then "Off: the company spends freely."
			elseif ops.saveMode == true and nextDef then "On now: saving for the " .. nextDef.name .. " (" .. Format.money(nextDef.price) .. ")."
			elseif not nextDef then "You own the largest office: nothing to save for."
			elseif stage == 1 and (tonumber(e.contractsCompleted) or 0) &lt; 1 then "Starts after your first client has signed."
			else "Not active: the " .. nextDef.name .. " is still more than " .. Ops.SAVE_MINUTES .. " minutes of profit away."
		-- night shift
		local nightOpen = stage &gt;= Ops.NIGHT.from
		nightRows.Visible = nightOpen
		nightText.Text = if nightOpen then "Optional per team. Needs a security guard on duty (operations staff)." else "Night shifts start at the " .. stageName(Ops.NIGHT.from) .. "."
		if nightOpen then
			for _, roleDef in Config.ROLES do
				local heads = e.employees[roleDef.id] or 0
				local seats = Ops.seats(e, roleDef.id)
				local over = math.max(0, heads - seats)
				local on = false
				for _, dept in Ops.ROLE_DEPTS[roleDef.id] or {} do
					if typeof(e.nightShift) == "table" and e.nightShift[dept] == true then on = true end
				end
				nightSwitches[roleDef.id].set(if on then "on" else "off")
				nightLabels[roleDef.id].Text = string.format("%d people / %d desks%s", heads, seats,
					if over &gt; 0 then string.format(" · %d work at night", math.min(over, seats)) elseif on then " · nobody over the desks yet" else "")
			end
		end
		-- apprentices
		local apprOpen = stage &gt;= Ops.TRAINING_LEAD.from
		hireRow.Visible = apprOpen
		local list = apprenticeList(e)
		local full = Math.staff(e) &gt;= Config.OFFICES[stage].staff
		apprText.Text = if not apprOpen then "Apprentices start at the " .. stageName(Ops.TRAINING_LEAD.from) .. " with a Training Lead."
			elseif #list &gt; 0 then string.format("Training Lead on duty (%s/day) · %d apprentice%s in training. Hire another:", dollars(Ops.TRAINING_LEAD.wage), #list, if #list == 1 then "" else "s")
			else "No apprentices: the Training Lead is not paid. Hire one:"
		for _, roleDef in Config.ROLES do
			local b = hireButtons[roleDef.id]
			local fee = math.floor(Math.hireCost(e, roleDef) * Ops.APPRENTICE.fee)
			b.Text = string.format("%s · %s", string.gsub(roleDef.name, "^AI ", ""), dollars(fee))
			Kit.setDisabled(b, not apprOpen or full or s.data.money &lt; fee)
		end
		local sig = ""
		for _, a in list do sig ..= a.name .. a.day .. a.skill .. "|" end
		if sig ~= apprSig then
			apprSig = sig
			clearRows(apprRows)
			for i, a in list do
				local row = Kit.frame(apprRows, UDim2.new(1, 0, 0, 26))
				row.LayoutOrder = i
				Kit.cell(row, a.name, UDim.new(0.3, 0), 15, F.bold, C.text)
				Kit.cell(row, a.role, UDim.new(0.25, 0), 13, F.regular, C.muted).Position = UDim2.fromScale(0.3, 0)
				Kit.cell(row, string.format("day %d of %d", math.max(1, a.day), Ops.APPRENTICE.graduateDays), UDim.new(0.2, 0), 13, F.medium, C.muted).Position = UDim2.fromScale(0.55, 0)
				local skillCell = Kit.cell(row, if a.skill &gt;= Ops.APPRENTICE.endSkill then string.format("skill %d (max)", a.skill) else string.format("skill %d → %d", a.skill, Ops.APPRENTICE.endSkill), UDim.new(0.25, 0), 13, F.bold, C.warn)
				skillCell.Position = UDim2.fromScale(0.75, 0)
				skillCell.TextXAlignment = Enum.TextXAlignment.Right
			end
		end
		-- company jet
		local J = Ops.JET
		local running = J.pilots * J.pilotWage + J.upkeep
		if e.jet == true then
			jetText.Text = string.format("Owned. Parked in the airport hangar with %d company pilots · running %s/day · abroad trips take %.1f days instead of %d, %d hotel night, +%d %% trust, no airline tickets.",
				J.pilots, dollars(running), J.days, Ops.TRIPS.abroad.days, J.nights, math.floor(J.trust * 100))
			jetButton.Text = "Owned"
			Kit.setDisabled(jetButton, true)
		else
			jetText.Text = string.format("%s once, then %s/day (%d pilots + upkeep) and %s fuel per abroad trip. Abroad trips take %.1f days instead of %d and win +%d %% trust. Needs the %s.",
				dollars(J.price), dollars(running), J.pilots, dollars(J.fuel), J.days, Ops.TRIPS.abroad.days, math.floor(J.trust * 100), stageName(J.stage))
			jetButton.Text = if stage &lt; J.stage then "Needs the " .. stageName(J.stage) else "Buy company jet · " .. dollars(J.price)
			Kit.setDisabled(jetButton, stage &lt; J.stage or s.data.money &lt; J.price)
		end
		local level = math.floor(tonumber(e.labLevel) or 0)
		if level &gt;= Ops.LAB_MAX then
			labText.Text = string.format("Lab level %d / %d: the highest level. Every future model gets +%d core stats.", level, Ops.LAB_MAX, level)
		else
			local pts, cost = Ops.labCost(level)
			local treeDone = true
			for _, def in Config.RESEARCH do if not e.research[def.id] then treeDone = false end end
			labText.Text = string.format("Lab level %d / %d. The next level costs %s research points + %s%s and adds +1 to every core stat of future models. It lives in Models.", level, Ops.LAB_MAX, Format.int(pts), dollars(cost), if treeDone then "" else " (after the whole research tree)")
		end
	end)
end
local function board(parent: Instance)
	local head=Kit.card(parent,1)
	title(head,"Company rankings")
	local status=para(head,"Global rankings load in a published game with saving enabled.")
	local mode="overall"
	local selector=Kit.segmented(head,{{id="overall",label="Overall"},{id="coding",label="Coding"},{id="math",label="Math"},{id="reasoning",label="Reasoning"},{id="creativity",label="Creative"},{id="arena",label="Arena"}},mode,function(id) mode=id;if State.snapshot then for _,fn in updaters do fn(State.snapshot) end end end)
	selector.frame.LayoutOrder=3
	watch(function(s) status.Text=if s.live.rankings then s.live.rankings.status.." · best self-trained records, refreshed every three minutes" else "Server preview · strongest self-trained AI" end)
	for i=1,10 do
		local row=Kit.card(parent,i+1)
		local name=title(row,"");local stats=para(row,"")
		watch(function(s)
			local ranking=s.live.rankings
			local entry=if ranking then ranking.boards[mode] and ranking.boards[mode][i] else s.live.empire and s.live.empire.board[i]
			row.Visible=entry~=nil
			if entry then name.Text=tostring(i)..". "..entry.name;stats.Text=string.format("%.1f %s points",entry.score or entry.best,mode) end
		end)
	end
end
local builders: { [string]: (Instance) -&gt; () } = {overview=overview,clients=clients,money=money,team=team,research=research,milestones=milestones,office=office,settings=settings,board=board}
local TABS = {{"overview","Overview"},{"clients","Clients"},{"money","Money"},{"team","Team"},{"research","Research"},{"milestones","Goals"},{"office","Office"},{"settings","Settings"},{"board","Board"}}
local function paintTabs()
	for id,btn in tabButtons do btn.BackgroundColor3=if id==current then Theme.accent:Lerp(C.panel,0.6) else C.raised end
end
local function render()
	local container=scroll
	if not container then return end
	updaters={}
	for _,child in container:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local stack=Kit.stack(container,12)
	stack.Name="Tab_"..current
	Kit.padding(stack,0,8,24,0)
	builders[current](stack)
	container.CanvasPosition=Vector2.zero
	paintTabs()
end
function App.mount(parent: Frame, navigation: any)
	nav=navigation
	page=parent
	local head=Kit.frame(parent,UDim2.new(1,0,0,38))
	local label=Kit.text(head,"Company",24,F.display,C.text)
	label.Position=UDim2.fromOffset(0,2)
	local tabs=Instance.new("ScrollingFrame")
	tabs.Name="Tabs"
	tabs.BackgroundTransparency=1
	tabs.BorderSizePixel=0
	tabs.Size=UDim2.new(1,0,0,46)
	tabs.Position=UDim2.fromOffset(0,42)
	tabs.CanvasSize=UDim2.new()
	tabs.AutomaticCanvasSize=Enum.AutomaticSize.X
	tabs.ScrollingDirection=Enum.ScrollingDirection.X
	tabs.ScrollBarThickness=2
	tabs.Parent=parent
	Kit.list(tabs,6,true)
	tabButtons={}
	for i,def in TABS do
		local b=Kit.button(tabs,def[2],"secondary",UDim2.fromOffset(96,36))
		b.Name="Tab_"..def[1]
		b.LayoutOrder=i
		tabButtons[def[1]]=b
		Kit.onClick(b,function()
			current=def[1]
			render()
		end)
	end
	paintTabs()
	local body=Kit.scroll(parent,UDim2.new(1,0,1,-100),UDim2.fromOffset(0,100))
	body.Name="EmpireScroll"
	scroll=body
	State.onChange(function(s)
		if not s.data.company then return end
		if #updaters==0 then render() end
		for _,fn in updaters do fn(s) end
	end)
	State.onNotify(function(kind,payload)
		if kind=="EMPIRE_NOTICE" and typeof(payload.text)=="string" then Toast.show("success",payload.text,5) end
	end)
end
function App.onShow()
	if #updaters==0 and State.snapshot and State.snapshot.data.company then render() end
end
function App.openSection(section: string)
	local id=if section=="contracts" then "clients" else section
	if builders[id] then current=id;render() end
end
return App
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000050"><Properties><string name="Name">ModelsUI</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Shared helpers of the Lab and Market apps (models package, CORE_SPEC 7): product lines, Lab level,
-- serving capacity, auto-price and robust remote calls. No Instances are built here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local ModelConfig = require(Shared.Config.ModelConfig)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local ModelMath = require(Shared.ModelMath)
local PricingMath = require(Shared.PricingMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local Client = script.Parent.Parent.Parent
local ActionController = require(Client.Controllers.ActionController)
local Toast = require(script.Parent.Parent.Toast)

type ModelData = Types.ModelData
type PlayerData = Types.PlayerData

local ModelsUI = {}

-- Texts for the models error codes, used only while ActionController has none of its own.
local MESSAGES: { [string]: string } = {
	LINE_LIMIT = "All product lines of this office are taken. Release a new version into a live line, or move to a bigger office for another line.",
	REFINE_LIMIT = "This model was already refined 3 times. Train a new version instead.",
	MODEL_LIMIT = "Your company reached the limit of 80 active models. Retire old models first.",
	MAX_LEVEL = "The Lab is at its highest level.",
	PREREQUISITE = "Finish the whole research tree first.",
	NO_POINTS = "Not enough research points. Hire researchers to generate more.",
	NO_MONEY = "Not enough money.",
	UNAVAILABLE = "This needs the next server update.",
}

function ModelsUI.message(err: string?): string
	local text = ActionController.message(err)
	if text == "Something went wrong." and err and MESSAGES[err] then
		return MESSAGES[err]
	end
	return text
end

function ModelsUI.hasRemote(name: string): boolean
	return table.find(Net.FUNCTIONS, name) ~= nil
end

-- ActionController.call with the models texts. Never waits for a remote the server does not have.
function ModelsUI.call(name: string, payload: { [string]: any }): (boolean, { [string]: any })
	if not ModelsUI.hasRemote(name) then
		Toast.show("error", MESSAGES.UNAVAILABLE)
		return false, { ok = false, err = "UNAVAILABLE" }
	end
	local ok, result = ActionController.call(name, payload, true)
	if not ok and result.err ~= "BUSY" then
		Toast.show("error", ModelsUI.message(result.err))
	end
	return ok, result
end

-- Auto-price on/off (CORE_SPEC 7.7): EmpireAction {action="autoPrice"}; until the server has EmpireAction,
-- UpdatePricing {modelId, auto} is the same switch.
function ModelsUI.setAutoPrice(modelId: string, on: boolean): boolean
	if ModelsUI.hasRemote("EmpireAction") then
		return (ModelsUI.call("EmpireAction", { action = "autoPrice", model = modelId, modelId = modelId, on = on }))
	end
	return (ModelsUI.call("UpdatePricing", { modelId = modelId, auto = on }))
end

---------------------------------------------------------------------------- lines

function ModelsUI.lineLabel(target: string?): string
	local line = ModelConfig.getLine(target)
	return if line then line.label else "Model"
end

function ModelsUI.officeName(stage: number?): string
	local def = EmpireConfig.OFFICES[math.clamp(math.floor(tonumber(stage) or 1), 1, #EmpireConfig.OFFICES)]
	return if def then def.name else "Office"
end

-- First office (index) whose product slots exceed `used` lines, or nil.
function ModelsUI.officeForLines(lines: number): number?
	for stage = 1, #EmpireConfig.OFFICES do
		if ModelMath.productSlots(stage) &gt; lines then
			return stage
		end
	end
	return nil
end

export type LineRow = {
	line: ModelConfig.LineDef,
	model: ModelData?, -- the live model of the line (first in model order)
	extra: number, -- more live models in the line (old saves from before product lines)
	version: number, -- line version of `model`
	open: boolean, -- no live model, but a free slot
}

-- One row per product line in ModelConfig.LINES order, plus used lines and slots of the office.
function ModelsUI.lines(data: PlayerData): ({ LineRow }, number, number)
	local byLine, used = ModelMath.liveLines(data)
	local slots = ModelMath.productSlots(data.empire.office)
	local rows: { LineRow } = {}
	for _, line in ModelConfig.LINES do
		local list = byLine[ModelMath.lineOf(line.target)]
		local model = if list then list[1] else nil
		table.insert(rows, {
			line = line,
			model = model,
			extra = if list then #list - 1 else 0,
			version = if model then ModelMath.lineVersion(data, model.id) else 0,
			open = model == nil and used &lt; slots,
		})
	end
	return rows, used, slots
end

-- "age 41 min · -5 fit" (CORE_SPEC 7.3: up to -8 fit points after 3 game days)
function ModelsUI.ageText(model: ModelData): string
	local vage = ModelMath.versionAge(model)
	local fit = ModelMath.ageFit(vage)
	local minutes = math.floor(vage / 60)
	local age = if minutes &lt; 1 then "new" else `age {minutes} min`
	return if fit &gt;= 0.5 then `{age} · -{string.format("%.0f", fit)} fit` else age
end

-- The model this one replaced in its line (the newest predecessor), or nil.
function ModelsUI.predecessor(data: PlayerData, modelId: string): ModelData?
	local best: ModelData? = nil
	for _, id in data.modelOrder do
		local model = data.models[id]
		if model and (model :: any).replacedBy == modelId then
			best = model
		end
	end
	return best
end

-- Status line of a live model's price: auto on/off and the last automatic change (live.pricing[id].note).
function ModelsUI.autoPriceText(live: any, model: ModelData): string
	local release: any = model.release
	if not release or release.auto == false then
		return "Manual price. Switch to Auto price to use the Recommended price again."
	end
	local pricing = if typeof(live) == "table" then live.pricing else nil
	local entry = if typeof(pricing) == "table" then pricing[model.id] else nil
	if typeof(entry) == "table" and typeof(entry.note) == "string" then
		return "Auto: " .. entry.note
	end
	return `Auto price: re-checks the best menu price every {math.floor(ModelConfig.PRICING.autoPeriod / 60 + 0.5)} minutes.`
end

function ModelsUI.refineText(model: ModelData): string
	return `refined {math.floor(tonumber(model.iterations) or 0)}/{ModelConfig.REFINE.limit}`
end

---------------------------------------------------------------------------- Lab level

local opsModule: any = nil
local function companyOps(): any
	if opsModule == nil then
		local found = Shared:FindFirstChild("CompanyOps")
		if not (found and found:IsA("ModuleScript")) then
			return nil
		end
		local ok, result = pcall(require, found)
		opsModule = if ok then result else false
	end
	return if opsModule then opsModule else nil
end

export type LabInfo = {
	level: number,
	max: number,
	points: number, -- research points for the next level
	cash: number, -- dollars for the next level
	treeDone: boolean, -- the whole research tree is finished (Lab levels come after it)
	canBuy: boolean,
	reason: string, -- why not, or what the next level costs
}

-- CORE_SPEC 7.5: level L -&gt; L+1 costs floor(200 * 1.35^L) points and $floor(6000 * 1.6^L), +1 core stat on
-- future models, max 10. The price comes from CompanyOps.labCost when the econ package provides it.
function ModelsUI.lab(data: PlayerData, money: number): LabInfo
	local e = data.empire
	local ops = companyOps()
	local max = if ops and typeof(ops.LAB_MAX) == "number" then ops.LAB_MAX else 10
	local level = math.clamp(math.floor(tonumber(e.labLevel) or 0), 0, max)
	local points, cash
	if ops and typeof(ops.labCost) == "function" then
		points, cash = ops.labCost(level)
	end
	points = tonumber(points) or math.floor(200 * 1.35 ^ level)
	cash = tonumber(cash) or math.floor(6000 * 1.6 ^ level)
	local treeDone = true
	for _, def in EmpireConfig.RESEARCH do
		if not e.research[def.id] then
			treeDone = false
		end
	end
	local reason: string
	if level &gt;= max then
		reason = "Highest level reached"
	elseif not treeDone then
		reason = "Unlocks after the whole research tree"
	elseif (tonumber(e.points) or 0) &lt; points then
		reason = `Needs {Format.int(points)} research points`
	elseif money &lt; cash then
		reason = `Needs {Format.money(cash)}`
	else
		reason = `Next level: {Format.int(points)} RP + {Format.money(cash)}`
	end
	return {
		level = level,
		max = max,
		points = points,
		cash = cash,
		treeDone = treeDone,
		canBuy = level &lt; max and treeDone and (tonumber(e.points) or 0) &gt;= points and money &gt;= cash,
		reason = reason,
	}
end

---------------------------------------------------------------------------- serving capacity

export type Serving = { known: boolean, capacity: number, load: number, waitlist: number, full: number, text: string }

-- From live.capacity / live.load / live.waitlist (MarketService, CORE_SPEC 3.1), when present.
function ModelsUI.serving(live: any): Serving
	local capacity = if typeof(live) == "table" then tonumber(live.capacity) else nil
	local load = if typeof(live) == "table" then tonumber(live.load) else nil
	local waitlist = if typeof(live) == "table" then tonumber(live.waitlist) else nil
	if not capacity or capacity ~= capacity or capacity == math.huge or not load then
		return { known = false, capacity = 0, load = 0, waitlist = 0, full = 0, text = "" }
	end
	local full = if capacity &gt; 0 then load / capacity else (if load &gt; 0 then math.huge else 0)
	local wait = math.max(0, waitlist or 0)
	local text
	if wait &gt;= 1 then
		text = `{Format.int(wait)} waiting — buy GPUs`
	elseif full &gt;= 0.85 then
		text = `Servers {Format.percent(math.min(full, 9.99))} full — add GPUs before the next launch`
	else
		text = `Servers {Format.percent(full)} full`
	end
	return { known = true, capacity = capacity, load = load, waitlist = wait, full = full, text = text }
end

---------------------------------------------------------------------------- business clients

-- One line about the signed business clients (CompanyOps accounts), e.g.
-- "3 business clients · $31,500/day in retainers. Your sales team signs and renews them by visits."
function ModelsUI.businessText(data: PlayerData): string
	local e: any = data.empire
	local deals = if typeof(e) == "table" then e.deals else nil
	local accounts = if typeof(deals) == "table" then deals.accounts else nil
	local ops = companyOps()
	local count, retainer = 0, 0
	if typeof(accounts) == "table" then
		for id in accounts do
			count += 1
			local client = if ops and typeof(ops.client) == "function" then ops.client(id) else nil
			if typeof(client) == "table" and typeof(client.retainer) == "number" then
				retainer += client.retainer
			end
		end
	end
	if count == 0 then
		return "No business clients yet. Your founder and the Growth &amp; Sales field reps visit clients and sign them; a client needs a live model strong enough in its stat."
	end
	local money = if retainer &gt; 0 then ` · {Format.money(retainer)}/day in retainers` else ""
	return `{count} business client{if count == 1 then "" else "s"}{money}. Your sales team keeps them with check-in visits.`
end

---------------------------------------------------------------------------- pricing inputs on the client

-- Forecast context from the snapshot: rivals from the replicated marketplace offers (own models excluded).
function ModelsUI.context(snapshot: Types.Snapshot): PricingMath.Context
	local data = snapshot.data
	local own: { [string]: any } = {}
	for id in data.models do
		own[id] = true
	end
	local market: any = snapshot.live.marketplace
	local offers = if typeof(market) == "table" then market.offers else nil
	local rivals = PricingMath.rivalsFromOffers(offers, own)
	local npc = false
	for _, rival in rivals do
		if rival.player == false then
			npc = true
		end
	end
	-- MarketService passes {} as the static NPC list while NPC labs run as sessions (their offers are listed)
	return PricingMath.context(data, rivals, if npc then {} else nil)
end

function ModelsUI.priceText(sub: number, api: number): string
	return (if sub == 0 then "Free" else `${sub}/month`) .. ` · {Format.price(api)} per 1M tokens`
end

return ModelsUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000051"><Properties><string name="Name">ShopApp</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Shop: what players can spend Robux on (catalogue: ShopConfig, purchases: ShopService).
-- Prices come from Roblox (GetProductInfoAsync, fetched once); an item whose price can't be loaded is
-- hidden. Buy buttons only open the Roblox purchase window. Granting happens on the server
-- (ProcessReceipt / pass events) and arrives here as Notify SHOP_GRANTED; nothing is ever granted
-- from PromptProductPurchaseFinished. With every id at 0 the app says "Shop coming soon".

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShopConfig = require(ReplicatedStorage.Shared.Config.ShopConfig)
local Format = require(ReplicatedStorage.Shared.Format)
local Types = require(ReplicatedStorage.Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local State = require(Client.Controllers.StateController)
local Action = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot
type ItemKind = "product" | "pass"

local App = {}

-- Seams for the headless client test (tests/shop): MarketplaceService does not exist outside Roblox.
local deps = {
	market = MarketplaceService :: any,
	player = function(): any
		return Players.LocalPlayer
	end,
}
function App._setDeps(patch: { [string]: any })
	for key, value in patch do
		(deps :: any)[key] = value
	end
end

local PRICE_RETRY_SECONDS = 30

local MESSAGES: { [string]: string } = {
	NO_VOUCHER = "You don't have that voucher.",
	NOT_AVAILABLE = "This voucher can't be redeemed yet. It stays in your account.",
	PARTY_ACTIVE = "A party is already running at your headquarters.",
	NO_PLOT = "Your headquarters isn't ready yet. Try again in a moment.",
	BUSY = "One moment, the last voucher is still being redeemed.",
	APPLICANTS_FULL = "Your application list is full. Hire or reject someone first; the voucher stays.",
	BAD_INPUT = "That didn't work. Try again.",
}

-- keyed by "product:&lt;id&gt;" / "pass:&lt;id&gt;" (ids are read live from ShopConfig)
local prices: { [string]: number } = {} -- PriceInRobux from Roblox
local failedAt: { [string]: number } = {} -- os.clock() of the last failed price lookup
local fetching: { [string]: boolean } = {}

local function priceKey(kind: ItemKind, id: number): string
	return kind .. ":" .. tostring(id)
end
local refreshers: { (Snapshot) -&gt; () } = {}
local mounted = false

local function liveShop(snapshot: Snapshot?): any
	local live = if snapshot then snapshot.live :: any else nil
	local shop = if live then live.shop else nil
	return if typeof(shop) == "table" then shop else nil
end

local function dataShop(snapshot: Snapshot?): any
	local shop = if snapshot then (snapshot.data :: any).shop else nil
	return if typeof(shop) == "table" then shop else nil
end

function App.owns(snapshot: Snapshot?, key: string): boolean
	local shop = liveShop(snapshot)
	return shop ~= nil and typeof(shop.passes) == "table" and shop.passes[key] == true
end

local function isAvailable(snapshot: Snapshot?, key: string): boolean
	local shop = liveShop(snapshot)
	return shop ~= nil and typeof(shop.available) == "table" and shop.available[key] == true
end

local function canRedeem(snapshot: Snapshot?, key: string): boolean
	local shop = liveShop(snapshot)
	return shop ~= nil and typeof(shop.redeemable) == "table" and shop.redeemable[key] == true
end

local function voucherCount(snapshot: Snapshot?, key: string): number
	local shop = dataShop(snapshot)
	local count = if shop and typeof(shop.vouchers) == "table" then tonumber(shop.vouchers[key]) else nil
	return if count and count == count and count &gt; 0 then math.floor(count) else 0
end

local function tips(snapshot: Snapshot?): number
	local shop = dataShop(snapshot)
	local n = if shop then tonumber(shop.tips) else nil
	return if n and n == n and n &gt; 0 then math.floor(n) else 0
end

local function refreshAll()
	local snapshot = State.snapshot
	if not snapshot then
		return
	end
	for _, fn in refreshers do
		fn(snapshot)
	end
end

-- One lookup per item; failures are retried on the next onShow after PRICE_RETRY_SECONDS.
local function fetchPrice(kind: ItemKind, id: number)
	local key = priceKey(kind, id)
	if id &lt;= 0 or prices[key] ~= nil or fetching[key] then
		return
	end
	local failed = failedAt[key]
	if failed and os.clock() - failed &lt; PRICE_RETRY_SECONDS then
		return
	end
	fetching[key] = true
	task.spawn(function()
		local ok, info = pcall(function(): any
			return deps.market:GetProductInfoAsync(id, if kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
		end)
		fetching[key] = nil
		local price = if ok and typeof(info) == "table" then info.PriceInRobux else nil
		if typeof(price) == "number" and price == price and price &gt;= 0 then
			prices[key] = price
			failedAt[key] = nil
		else
			failedAt[key] = os.clock()
		end
		refreshAll()
	end)
end

local function fetchAll()
	for _, def in ShopConfig.PRODUCTS do
		fetchPrice("product", def.id)
	end
	for _, def in ShopConfig.PASSES do
		fetchPrice("pass", def.id)
	end
end

-- Opens the Roblox purchase window. Nothing is granted here.
local function prompt(kind: ItemKind, id: number)
	local ok = pcall(function()
		if kind == "pass" then
			deps.market:PromptGamePassPurchase(deps.player(), id)
		else
			deps.market:PromptProductPurchase(deps.player(), id)
		end
	end)
	if not ok then
		Toast.show("error", "The Roblox purchase window could not open. Try again.")
	end
end

local function priceText(kind: ItemKind, id: number): string
	local price = prices[priceKey(kind, id)]
	return if price then "R$ " .. Format.int(price) else ""
end

local function title(parent: Instance, text: string, order: number): TextLabel
	local label = Kit.para(parent, text, 18, C.text, order)
	label.Font = F.bold
	return label
end

local function section(parent: Instance, text: string, order: number): TextLabel
	local label = Kit.caption(parent, text, order)
	label.TextSize = 14
	return label
end

local function card(parent: Instance, order: number): (Frame, TextLabel, TextLabel, TextButton)
	local frame = Kit.card(parent, order, 8)
	local name = title(frame, "", 1)
	local info = Kit.para(frame, "", 14, C.muted, 2)
	local button = Kit.button(frame, "", "primary", UDim2.new(1, 0, 0, 38))
	button.LayoutOrder = 3
	return frame, name, info, button
end

local function productText(def: ShopConfig.Product, snapshot: Snapshot): string
	if def.kind == "cash" then
		local amount = ShopConfig.cashFor(def, snapshot.data.empire.office)
		return `+{Format.money(amount)} company cash at your current office. {def.desc}`
	elseif def.key == "party" then
		local minutes = math.max(1, math.round(ShopConfig.PARTY_SECONDS / 60))
		return `{def.desc} Lasts {minutes} minute{if minutes == 1 then "" else "s"}.`
	end
	return def.desc
end

local function passText(def: ShopConfig.Pass): string
	if def.key == "investor" then
		return `+{math.round((ShopConfig.INVESTOR_MULTIPLIER - 1) * 100)}% revenue from your own AI models. {def.desc}`
	end
	return def.desc
end

local function grantedText(payload: { [string]: any }): string
	local kind = payload.kind
	local key = if typeof(payload.key) == "string" then payload.key else ""
	if kind == "cash" and typeof(payload.amount) == "number" then
		return `Thank you! +{Format.money(payload.amount)} company cash.`
	elseif kind == "voucher" then
		local def = ShopConfig.voucher(if typeof(payload.voucher) == "string" then payload.voucher else key)
		return `Thank you! {if def then def.name else "Voucher"} added. Redeem it in the Shop.`
	elseif kind == "pass" then
		local def = ShopConfig.pass(key)
		return `Thank you! {if def then def.name else "Your pass"} is now active.`
	end
	return "Thank you so much for supporting the game!"
end

local REDEEMED: { [string]: string } = {
	party = "Party time! Look in front of your headquarters.",
	headhunter = "The headhunter found someone. Check your applications.",
}

local function redeem(key: string, button: TextButton)
	Kit.setDisabled(button, true)
	task.spawn(function()
		local ok, result = Action.call("ShopAction", { action = "redeem", key = key }, true)
		Kit.setDisabled(button, false)
		if ok then
			Toast.show("success", REDEEMED[key] or "Voucher redeemed.")
		else
			local err = if typeof(result.err) == "string" then result.err else nil
			Toast.show("error", if err and MESSAGES[err] then MESSAGES[err] else Action.message(err))
		end
	end)
end

-- Sidebar status line in the computer
function App.status(snapshot: Snapshot): (string, Color3)
	local vouchers = 0
	for _, def in ShopConfig.VOUCHERS do
		vouchers += voucherCount(snapshot, def.key)
	end
	if vouchers &gt; 0 then
		return `{vouchers} voucher{if vouchers == 1 then "" else "s"} to redeem`, C.good
	end
	if not ShopConfig.anyListed() then
		return "Coming soon", C.dim
	end
	if App.owns(snapshot, "vip") then
		return "VIP Founder", C.warn
	end
	return "Support the game", C.dim
end

function App.mount(parent: Frame, _nav: Kit.Nav)
	mounted = true
	local head = Kit.frame(parent, UDim2.new(1, 0, 0, 38))
	local heading = Kit.text(head, "Shop", 24, F.display, C.text)
	heading.Position = UDim2.fromOffset(0, 2)
	local scroll = Kit.scroll(parent, UDim2.new(1, 0, 1, -46), UDim2.fromOffset(0, 46))
	scroll.Name = "ShopScroll"
	local stack = Kit.stack(scroll, 12)
	Kit.padding(stack, 0, 8, 24, 0)

	local intro = Kit.para(stack, "Robux items to support the game. Prices come from Roblox, and nothing here is random.", 14, C.muted, 1)
	intro.Name = "Intro"

	local soon = Kit.card(stack, 2)
	soon.Name = "ComingSoon"
	title(soon, "Shop coming soon", 1)
	Kit.para(soon, "Robux items appear here as soon as the game owner sets them up. Until then everything in AI Empire is earned by playing.", 14, C.muted, 2)

	local empty = Kit.card(stack, 3)
	empty.Name = "NothingNow"
	title(empty, "Nothing to buy right now", 1)
	Kit.para(empty, "Prices could not be loaded from Roblox. Open the shop again in a moment.", 14, C.muted, 2)

	local order = 10
	local function nextOrder(): number
		order += 1
		return order
	end

	-- vouchers you own (always shown when you have one, even if the product is no longer sold)
	local voucherHeader = section(stack, "Your vouchers", nextOrder())
	local voucherCards: { Frame } = {}
	for _, def in ShopConfig.VOUCHERS do
		local frame, name, info, button = card(stack, nextOrder())
		frame.Name = "Voucher_" .. def.key
		info.Text = def.desc
		Kit.onClick(button, function()
			redeem(def.key, button)
		end)
		table.insert(voucherCards, frame)
		table.insert(refreshers, function(snapshot: Snapshot)
			local count = voucherCount(snapshot, def.key)
			frame.Visible = count &gt; 0
			name.Text = if count &gt; 1 then `{def.name} ×{count}` else def.name
			local ready = canRedeem(snapshot, def.key)
			button.Text = if ready then "Redeem" else "Available soon"
			Kit.setDisabled(button, not ready)
		end)
	end

	-- def: a ShopConfig.PRODUCTS / PASSES entry; its id is read on every refresh/click
	local function itemCard(kind: ItemKind, def: { key: string, id: number, name: string }, describe: (Snapshot) -&gt; string): Frame
		local key = def.key
		local frame, name, info, button = card(stack, nextOrder())
		frame.Name = (if kind == "pass" then "Pass_" else "Product_") .. key
		name.Text = def.name
		local baseText = button.TextColor3
		Kit.onClick(button, function()
			if def.id &gt; 0 and not (kind == "pass" and App.owns(State.snapshot, key)) then
				prompt(kind, def.id)
			end
		end)
		table.insert(refreshers, function(snapshot: Snapshot)
			local id = def.id
			local owned = kind == "pass" and App.owns(snapshot, key)
			local listed = id &gt; 0 and isAvailable(snapshot, key)
			frame.Visible = id &gt; 0 and (owned or (listed and prices[priceKey(kind, id)] ~= nil))
			info.Text = describe(snapshot)
			button.Text = if owned then "✓ Owned" else "Buy · " .. priceText(kind, id)
			Kit.setDisabled(button, owned)
			-- the disabled look fades text to ~2:1 contrast; "Owned" is the only proof of the
			-- purchase, so it stays fully readable in the success colour on a faint panel
			button.TextColor3 = if owned then C.good else baseText
			if owned then
				button.TextTransparency = 0
				button.BackgroundTransparency = 0.88
			end
		end)
		return frame
	end

	local groups: { { header: TextLabel, cards: { Frame } } } = {}
	local function group(text: string): { header: TextLabel, cards: { Frame } }
		local g = { header = section(stack, text, nextOrder()), cards = {} }
		table.insert(groups, g)
		return g
	end

	-- each header is created right before its own cards (LayoutOrder follows creation order)
	local function productGroup(text: string, kind: string)
		local g = group(text)
		for _, def in ShopConfig.PRODUCTS do
			local k = if def.kind == "cash" or def.kind == "voucher" then def.kind else "support"
			if k == kind then
				local product = def
				table.insert(g.cards, itemCard("product", def, function(snapshot: Snapshot): string
					return productText(product, snapshot)
				end))
			end
		end
	end
	productGroup("Company cash", "cash")
	productGroup("Vouchers", "voucher")
	productGroup("Support the developer", "support")
	local passes = group("Game passes")
	for _, def in ShopConfig.PASSES do
		local pass = def
		table.insert(passes.cards, itemCard("pass", def, function(_snapshot: Snapshot): string
			return passText(pass)
		end))
	end
	local thanks = Kit.para(stack, "", 14, C.good, nextOrder())
	thanks.Name = "Thanks"

	-- section headers and the empty states follow the visible cards (runs after the card refreshers)
	table.insert(refreshers, function(snapshot: Snapshot)
		local anyVoucher = false
		for _, frame in voucherCards do
			anyVoucher = anyVoucher or frame.Visible
		end
		voucherHeader.Visible = anyVoucher
		local anyItem = false
		for _, g in groups do
			local visible = false
			for _, frame in g.cards do
				visible = visible or frame.Visible
			end
			g.header.Visible = visible
			anyItem = anyItem or visible
		end
		local listed = ShopConfig.anyListed()
		soon.Visible = not listed and not anyVoucher
		local loading = false
		for _, busy in fetching do
			loading = loading or busy
		end
		empty.Visible = listed and not anyItem and not loading
		local n = tips(snapshot)
		thanks.Visible = n &gt; 0
		thanks.Text = if n == 1 then "Thank you for your supporter tip!" else `Thank you for your {n} supporter tips!`
	end)

	State.onChange(function(_snapshot: Snapshot)
		refreshAll()
	end)
	State.onNotify(function(kind: string, payload: { [string]: any })
		if kind == "SHOP_GRANTED" then
			Toast.show("success", grantedText(payload), 5)
		end
	end)
	-- UI feedback only (the server grants via ProcessReceipt / the pass event)
	pcall(function()
		deps.market.PromptProductPurchaseFinished:Connect(function(userId: number, _productId: number, purchased: boolean)
			local player = deps.player()
			if purchased and player and userId == player.UserId then
				Toast.show("info", "Purchase received. Adding it to your company...")
			end
		end)
		deps.market.PromptGamePassPurchaseFinished:Connect(function(who: any, _passId: number, purchased: boolean)
			if purchased and who == deps.player() then
				task.delay(1, function()
					Action.call("ShopAction", { action = "status", recheck = true }, true)
				end)
			end
		end)
	end)
	refreshAll()
end

function App.onShow()
	if mounted then
		fetchAll()
		refreshAll()
	end
end

return App
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000050"><Properties><string name="Name">Screens</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">Computer</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Der Computer im Büro: ein Fenster mit Sidebar (Company, Lab, Data, Compute, Market, ..., Shop).
-- Öffnet über den Laptop-Prompt, den COMPUTER-Button im HUD oder die Taste C.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local Types = require(ReplicatedStorage.Shared.Types)
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local HardwareConfig = require(ReplicatedStorage.Shared.Config.HardwareConfig)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local LabApp = require(UI.Apps.LabApp)
local DataApp = require(UI.Apps.DataApp)
local ComputeApp = require(UI.Apps.ComputeApp)
local MarketApp = require(UI.Apps.MarketApp)
local StudioApp=require(UI.Apps.StudioApp)
local ArenaApp=require(UI.Apps.ArenaApp)
local CampusApp=require(UI.Apps.CampusApp)
local EmpireApp = require(UI.Apps.EmpireApp)
local ShopApp = require(UI.Apps.ShopApp)

local C = Theme.colors
local F = Theme.font

type AppModule = { mount: (Frame, Kit.Nav) -&gt; (), onShow: () -&gt; () }
type Entry = { id: string, app: AppModule, container: Frame, status: TextLabel, paint: () -&gt; () }

local APPS: { { id: string, label: string, app: AppModule } } = {
	{ id = "empire", label = "Company", app = EmpireApp },
	{ id = "lab", label = "Models", app = LabApp },
	{ id = "data", label = "Datasets", app = DataApp },
	{ id = "compute", label = "Hardware", app = ComputeApp },
	{ id = "market", label = "Market", app = MarketApp },
	{ id = "studio", label = "Projects", app = StudioApp },
	{ id = "arena", label = "Test arena", app = ArenaApp },
	{ id = "campus", label = "Campus", app = CampusApp },
	{ id = "shop", label = "Shop", app = ShopApp },
}

local SIDEBAR = 196
local HEADER = 64
local FLOW = 66

local Computer = {}

local root: Frame? = nil
local dim: TextButton? = nil
local windowScale: UIScale? = nil
local blur: BlurEffect? = nil
local entries: { Entry } = {}
local current = "empire"
local opened = false
local moneyLabel: TextLabel? = nil

local function entryOf(id: string): Entry?
	for _, entry in entries do
		if entry.id == id then
			return entry
		end
	end
	return nil
end

function Computer.isOpen(): boolean
	return opened
end

function Computer.show(appId: string)
	local target = entryOf(appId)
	if not target then
		return
	end
	local switched = current ~= appId
	current = appId
	for _, entry in entries do
		entry.container.Visible = entry.id == appId
		entry.paint()
	end
	if switched then
		-- kurze Antwort auf den Klick: neue App gleitet 10 px nach oben ein
		target.container.Position = UDim2.fromOffset(0, 10)
		Kit.tween(target.container, 0.25, { Position = UDim2.new() })
	end
	target.app.onShow()
end

function Computer.open(appId: string?,section: string?)
	local frame, shade, scale, effect = root, dim, windowScale, blur
	if not frame or not shade or not scale or not effect then
		return
	end
	if not opened then
		opened = true
		frame.Visible = true
		shade.Visible = true
		shade.BackgroundTransparency = 1
		Kit.tween(shade, 0.25, { BackgroundTransparency = 0.32 })
		scale.Scale = 0.96
		Kit.tween(scale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.tween(effect, 0.3, { Size = 8 })
	end
	Computer.show(appId or current)
 if section then local target=entryOf(appId or current);if target then local app=target.app :: any;if app.openSection then app.openSection(section) end end end
end

function Computer.close()
	local frame, shade, effect = root, dim, blur
	if not opened or not frame or not shade or not effect then
		return
	end
	opened = false
	Kit.tween(shade, 0.18, { BackgroundTransparency = 1 })
	Kit.tween(effect, 0.18, { Size = 0 })
	task.delay(0.18, function()
		if not opened then
			frame.Visible = false
			shade.Visible = false
		end
	end)
end

function Computer.toggle()
	if opened then
		Computer.close()
	else
		Computer.open()
	end
end

local function statusFor(id: string, snapshot: Types.Snapshot): (string, Color3)
	local data = snapshot.data
	if id == "empire" then
		return "Team · Research · Goals", C.dim
	elseif id == "lab" then
		local training = data.training
		if training then
			if training.event and training.event.pending then
				return "Decision needed", C.warn
			end
			return "Training " .. Format.percent(training.workDone / training.workTotal), Theme.accent
		end
		local ready = 0
		for _, model in data.models do
			if model.status == "trained" then
				ready += 1
			end
		end
		if ready &gt; 0 then
			return `{ready} ready to launch`, C.good
		end
		return "Design and train", C.dim
	elseif id == "data" then
		return Format.tokens(ModelMath.dataSummary(data.data).total) .. " tokens", C.dim
	elseif id == "compute" then
		local fleet = ModelMath.fleet(data.gpus)
		return `{fleet.slotsUsed} of {HardwareConfig.slots(data.empire)} compute slots`, C.dim
	end
	if id=="campus" then return "Cards · Fleet · Stores",C.dim end
	if id=="shop" then return ShopApp.status(snapshot) end
	if id=="studio" then return tostring(#data.empire.projectOrder).." projects",C.dim end
	if id=="arena" then return tostring(data.empire.arenaBest).." best points",C.dim end
	local live = 0
	for _, model in data.models do
		if model.status == "live" then
			live += 1
		end
	end
	if live == 0 then
		return "Nothing live yet", C.dim
	end
	return `{Format.compact(snapshot.live.users)} users`, C.good
end

local function headerStatus(snapshot: Types.Snapshot): (string, Color3)
	local data = snapshot.data
	local training = data.training
	if training then
		if training.event and training.event.pending then
			return "Training paused: decision needed", C.warn
		end
		return "Training " .. Format.percent(training.workDone / training.workTotal), Theme.accent
	end
	local live = 0
	for _, model in data.models do
		if model.status == "live" then
			live += 1
		end
	end
	if live &gt; 0 then
		return `{live} model{if live == 1 then "" else "s"} live`, C.good
	end
	return "No model live yet", C.dim
end

local function buildNavButton(sidebar: Frame, index: number, id: string, label: string): (TextLabel, () -&gt; ())
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Text = ""
	button.Size = UDim2.new(1, 0, 0, 58)
	button.LayoutOrder = index
	button.BackgroundColor3 = C.raised
	button.BackgroundTransparency = 1
	button.Parent = sidebar
	Kit.corner(button, 12)

	-- Akzent-Strich = aktuelle Auswahl
	local bar = Kit.frame(button, UDim2.new(0, 3, 0, 24), UDim2.new(0, 0, 0.5, -12))
	bar.BackgroundTransparency = 0
	Theme.bindAccent(bar, "BackgroundColor3")
	Kit.corner(bar, 2)

	local icon = Kit.icon(button, id, 18)
	icon.frame.AnchorPoint = Vector2.new(0, 0.5)
	icon.frame.Position = UDim2.new(0, 16, 0.5, 0)
	local title = Kit.text(button, label, 16, F.bold, C.text)
	title.Position = UDim2.fromOffset(48, 10)
	local status = Kit.text(button, "", 12, F.medium, C.dim)
	status.Position = UDim2.fromOffset(48, 32)
	status.Size = UDim2.new(1, -54, 0, 16)
	status.AutomaticSize = Enum.AutomaticSize.None
	status.TextTruncate = Enum.TextTruncate.AtEnd

	local function paint()
		local selected = current == id
		button.BackgroundTransparency = if selected then 0 else 1
		bar.Visible = selected
		title.TextColor3 = if selected then C.text else C.muted
		icon.setColor(if selected then Theme.accent else C.dim)
	end
	Theme.onAccent(function()
		paint()
	end)
	Kit.onClick(button, function()
		Computer.show(id)
	end)
	paint()
	return status, paint
end

function Computer.mount(parent: Frame, dimLayer: Frame)
	local frame = Kit.frame(parent)
	frame.Name = "Computer"
	frame.Visible = false
	frame.ZIndex = 10
	root = frame

	-- Abdunkeln liegt in einer randlosen Ebene (deckt auch den Topbar-Streifen ab) und schluckt Klicks
	local shade = Kit.blocker(dimLayer, C.black, 1)
	shade.Visible = false
	dim = shade

	local effect = Instance.new("BlurEffect")
	effect.Name = "AIEmpireBlur"
	effect.Size = 0
	effect.Parent = Lighting -- vom Client erstellt = existiert nur bei diesem Spieler
	blur = effect

	local window = Kit.panel(frame, UDim2.new(1, -40, 1, -28), UDim2.fromScale(0.5, 0.5))
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.ZIndex = 11
	window.BackgroundColor3 = C.bg
	window.BackgroundTransparency = 0.03
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(1180, 740)
	constraint.Parent = window
	local scale = Instance.new("UIScale")
	scale.Parent = window
	windowScale = scale

	-- Kopfzeile: Firma + Live-Status links, Geld + Schließen rechts
	local header = Kit.frame(window, UDim2.new(1, 0, 0, HEADER))
	local logoBox = Kit.frame(header, UDim2.fromOffset(38, 38), UDim2.new(0, 18, 0.5, -19))
	logoBox.BackgroundTransparency = 0.72
	Theme.bindAccent(logoBox, "BackgroundColor3")
	Kit.corner(logoBox, 10)
	local logo = Kit.text(logoBox, "", 20, F.regular)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.fromScale(0.5, 0.5)
	-- name + VIP badge share a horizontal row, so the badge never needs pixel measuring
	local titleRow = Kit.frame(header, UDim2.fromOffset(0, 22), UDim2.fromOffset(68, 12))
	titleRow.AutomaticSize = Enum.AutomaticSize.X
	local titleLayout = Instance.new("UIListLayout")
	titleLayout.FillDirection = Enum.FillDirection.Horizontal
	titleLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	titleLayout.SortOrder = Enum.SortOrder.LayoutOrder
	titleLayout.Padding = UDim.new(0, 10)
	titleLayout.Parent = titleRow
	local title = Kit.text(titleRow, "AI Empire", 16, F.bold, C.text)
	title.LayoutOrder = 1
	local status = Kit.text(header, "", 13, F.medium, C.dim)
	status.Position = UDim2.fromOffset(68, 34)
	-- VIP Founder game pass: small badge right of the company name (ShopService live.shop)
	local vip = Kit.tag(titleRow, "VIP", C.warn, 2)
	vip.Name = "VipBadge"
	vip.Visible = false
	local money = Kit.text(header, "$0", 18, F.display, C.text)
	money.AnchorPoint = Vector2.new(1, 0.5)
	money.Position = UDim2.new(1, -72, 0.5, 0)
	moneyLabel = money
	local close = Kit.button(header, "×", "ghost", UDim2.fromOffset(40, 40))
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.new(1, -16, 0.5, 0)
	Kit.onClick(close, Computer.close)
	local headerLine = Kit.divider(header)
	headerLine.Position = UDim2.new(0, 0, 1, -1)

	-- Sidebar
	local sidebar = Kit.frame(window, UDim2.new(0, SIDEBAR, 1, -HEADER), UDim2.fromOffset(0, HEADER))
	Kit.padding(sidebar, 14, 10, 14, 12)
	Kit.list(sidebar, 4)
	local sidebarScale = Instance.new("UIScale")
	sidebarScale.Parent = sidebar
	-- nav buttons are 58 px + 4 px gap, plus the sidebar padding (8 apps needed ~512 px)
	local sidebarNeed = #APPS * 62 + 22
	-- AbsoluteSize is in screen pixels (includes UIRoot's UIScale); compare in design pixels
	local function designScale(inst: Instance): number
		local s = 1
		local node: Instance? = inst
		while node do
			local u = node:FindFirstChildOfClass("UIScale")
			if u and u ~= sidebarScale then
				s *= u.Scale
			end
			node = node.Parent
		end
		return if s &gt; 0 then s else 1
	end
	local function fitSidebar()
		local designHeight = window.AbsoluteSize.Y / designScale(window)
		sidebarScale.Scale = math.min(1, math.max(0.55, (designHeight - HEADER - 24) / sidebarNeed))
	end
	window:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitSidebar)
	fitSidebar()
	local sideLine = Kit.frame(window, UDim2.new(0, 1, 1, -HEADER), UDim2.fromOffset(SIDEBAR, HEADER))
	sideLine.BackgroundTransparency = 0.93
	sideLine.BackgroundColor3 = C.line

	-- The seven physical departments use the same permanent flow in Company OS.
 local flow=Kit.frame(window,UDim2.new(1,-SIDEBAR-1,0,FLOW),UDim2.fromOffset(SIDEBAR+1,HEADER));flow.Name="AIJourney"
 local labels={};local buttons={}
 for i,def in Journey.STEPS do
  local b=Kit.button(flow,def.label,"ghost",UDim2.new(1/7,-4,0,28));b.Position=UDim2.new((i-1)/7,2,0,4);b.TextSize=12;b.Name="Journey_"..def.id;buttons[i]=b
  Kit.onClick(b,function()Computer.open(def.app,def.section)end)
 end
 local hint=Kit.text(flow,"",12,F.medium,C.dim);hint.Position=UDim2.fromOffset(12,38);hint.Size=UDim2.new(1,-24,0,20);hint.AutomaticSize=Enum.AutomaticSize.None;hint.TextTruncate=Enum.TextTruncate.AtEnd
 local function paintFlow()
  local snapshot=StateController.snapshot;if not snapshot then return end
  local progress=Journey.progress(snapshot.data,StateController.ui)
  for i,b in buttons do b.Text=(if progress.done[i] then "✓ " else "")..Journey.STEPS[i].label;b.BackgroundColor3=if i==progress.index then Theme.accent:Lerp(C.panel,.72) else C.panel;b.BackgroundTransparency=if i==progress.index then 0 else 1;b.TextColor3=if progress.done[i] then C.good elseif i==progress.index then C.text else C.dim end
  hint.Text=progress.hint;hint.TextColor3=if progress.missingVram&gt;0 then C.warn else C.dim
 end
 StateController.onChange(paintFlow);StateController.onUiChange(paintFlow)
 -- Inhalt
 local content = Kit.frame(window, UDim2.new(1, -SIDEBAR - 1, 1, -HEADER-FLOW), UDim2.fromOffset(SIDEBAR + 1, HEADER+FLOW))
	content.ClipsDescendants = true
	Kit.padding(content, 20, 20, 0, 24)

	local nav: Kit.Nav = {
		show = function(appId: string)
			Computer.open(appId)
		end,
		close = Computer.close,
		isOpen = Computer.isOpen,
	}

	for index, def in APPS do
		local container = Kit.frame(content)
		container.Name = def.id
		container.Visible = false
		local statusLabel, paint = buildNavButton(sidebar, index, def.id, def.label)
		table.insert(entries, {
			id = def.id,
			app = def.app,
			container = container,
			status = statusLabel,
			paint = paint,
		})
		def.app.mount(container, nav)
	end

	StateController.onChange(function(snapshot)
		for _, entry in entries do
			local text, color = statusFor(entry.id, snapshot)
			entry.status.Text = text
			entry.status.TextColor3 = color
		end
		local company = snapshot.data.company
		title.Text = if company then company.name else "AI Empire"
		logo.Text = if company then company.logo else ""
		local text, color = headerStatus(snapshot)
		status.Text = text
		status.TextColor3 = color
		vip.Visible = ShopApp.owns(snapshot, "vip")
	end)

	RunService.RenderStepped:Connect(function()
		local label = moneyLabel
		if opened and label then
			local value = StateController.money()
			label.Text = Format.money(value)
			label.TextColor3 = if value &lt; 0 then C.bad else C.text
		end
	end)
end

return Computer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">HUD</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- HUD rechts oben (links oben gehört dem Roblox-Chat):
--   Glas-Panel (Firma, Geld, Nutzer, Reputation), "Next goal"-Karte, COMPUTER-Button
-- The "Next goal" card (CORE_SPEC 8.2) always shows ONE goal: EmpireMath.nextGoal(data, live) gives the goal,
-- its progress (have / need) and the ETA in minutes; this module only words it and adds the concrete hint from
-- real state (journey step, client trip, Save mode, research, Lab level). A pending training decision is the
-- only thing shown instead of the goal (it auto-resolves within seconds). A tap opens the relevant app.
-- Phones (small HUD scale): the card is compact (no hint line, larger title), the column width stays 300 so
-- the company phone keeps its lane (Screens/Phone: HUD_WIDTH = 300 + 16).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local CompanyConfig = require(Shared.Config.CompanyConfig)
local EmpireConfig = require(Shared.Config.EmpireConfig)
local ModelConfig = require(Shared.Config.ModelConfig)
local EmpireMath = require(Shared.EmpireMath)
local CompanyOps = require(Shared.CompanyOps)
local ModelMath = require(Shared.ModelMath)
local Journey = require(Shared.JourneyMath)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)
local Computer = require(UI.Screens.Computer)
local LabApp = require(UI.Apps.LabApp)

local C = Theme.colors
local F = Theme.font

type Snapshot = Types.Snapshot
type ModelData = Types.ModelData
-- One rendered goal: what the card shows and where a tap goes.
export type GoalView = {
	id: string, -- nextGoal id, "decision" (pending training event) or "done"
	caption: string,
	title: string,
	body: string, -- hint line (hidden on phones)
	progress: string, -- left text under the bar ("$18,400 / $27,000", "Trust 50 %", "Step 2 of 7")
	eta: string, -- right text ("~2 min", "ready", "back in 1:20", "")
	fraction: number?, -- bar fill 0..1 (nil = no bar)
	training: boolean, -- bar follows the running training (smooth, client-side)
	warn: boolean,
	saving: boolean, -- Save mode is on (server: live.ops.saveMode)
	app: string,
	section: string?,
	releaseId: string?,
}

local WIDTH = 300 -- Screens/Phone.HUD_WIDTH depends on this width and the 16 px margin
local COMPACT_SCALE = 0.62 -- UIRoot scale below which the HUD is drawn compact (phones in landscape)

local HUD = {}

local root: Frame? = nil

local function dollars(n: number): string
	return (if n &lt; 0 then "-$" else "$") .. Format.int(math.abs(n))
end

-- "~3 min", "~1.4 h", "&lt;1 min", "" (no profit = no ETA)
function HUD.etaText(minutes: number?): string
	if minutes == nil or minutes ~= minutes or minutes == math.huge then
		return ""
	end
	if minutes &lt;= 0 then
		return "ready"
	end
	if minutes &lt; 1 then
		return "&lt;1 min"
	end
	if minutes &lt; 120 then
		return "~" .. tostring(math.ceil(minutes)) .. " min"
	end
	if minutes &lt; 600 then
		return string.format("~%.1f h", minutes / 60)
	end
	return string.format("~%d h", math.ceil(minutes / 60))
end

local function trainedModel(data: any): ModelData?
	for _, id in data.modelOrder do
		local m: ModelData? = data.models[id]
		if m and m.status == "trained" then
			return m
		end
	end
	return nil
end

local function lineLabel(target: string?): string
	local line = ModelConfig.getLine(target or "general")
	return if line then line.label else "Consumer Chat"
end

local JOURNEY_HINT: { [string]: string } = {
	data = "Get training data: scrape the web for free or buy a pack in Datasets.",
	compute = "Check your compute: the laptop trains a 100M model; more VRAM fits bigger ones.",
	design = "Design your model in Models: pick a name, size and focus.",
	train = "Start the training run in Models and watch the loss drop.",
	evaluation = "Evaluate it in Models, then release it.",
	release = "Pick the Recommended price and launch it.",
	grow = "Users pay for your live model every second.",
}

-- seconds of play left until a trip is back (live.ops.trips[*].back is in empire.seconds)
local function tripFor(live: any, clientId: string): any
	local ops = live.ops
	if typeof(ops) ~= "table" or typeof(ops.trips) ~= "table" then
		return nil
	end
	for _, trip in ops.trips do
		if typeof(trip) == "table" and trip.client == clientId then
			return trip
		end
	end
	return nil
end

-- Words the goal of EmpireMath.nextGoal for the HUD (pure: snapshot in, view out; tests call it directly).
function HUD.describe(snapshot: Snapshot, selection: any?): GoalView
	local data: any = snapshot.data
	local live: any = snapshot.live
	local e = data.empire
	local ops = if typeof(live.ops) == "table" then live.ops else {}
	local saving = ops.saveMode == true
	local view: GoalView = {
		id = "done", caption = "Next goal", title = "", body = "", progress = "", eta = "", fraction = nil,
		training = false, warn = false, saving = saving, app = "empire", section = nil, releaseId = nil,
	}
	local training = data.training
	local trainingModel: ModelData? = if training then data.models[training.modelId] else nil
	if training and training.event and training.event.pending then
		view.id = "decision"
		view.caption = "Decision needed"
		view.title = "Your training run needs a decision"
		view.body = "Open Models and choose what to do. Otherwise the default is picked automatically."
		view.app = "lab"
		view.warn = true
		return view
	end
	local goal = EmpireMath.nextGoal(data, live)
	if goal == nil then
		view.title = "Every goal reached"
		view.body = "Keep shipping new versions: models age and rivals never stop."
		view.app = "market"
		return view
	end
	view.id = goal.id
	view.title = goal.text
	local have, need = tonumber(goal.have) or 0, math.max(1, tonumber(goal.need) or 1)
	local id = goal.id
	if id == "train" then
		local journey = Journey.progress(data, selection)
		view.app = journey.step.app
		view.section = journey.step.section
		if training then
			view.body = (if trainingModel then `Training {trainingModel.name} v{trainingModel.version}` else "Training") .. " · watch the loss drop in Models."
			view.progress = "Training"
			view.fraction = 0
			view.training = true
			view.app = "lab"
		else
			view.body = JOURNEY_HINT[journey.step.id] or journey.step.body
			view.progress = `Step {journey.index} of {#Journey.STEPS}`
			view.fraction = (journey.index - 1) / #Journey.STEPS
		end
	elseif id == "release" then
		local ready = trainedModel(data)
		view.app = "lab"
		view.section = "release"
		view.releaseId = if ready then ready.id else nil
		view.body = if ready then `{ready.name} v{ready.version} is trained. Pick the Recommended price and launch it.` else "Train a model, then launch it with the Recommended price."
		view.progress = `Step 6 of {#Journey.STEPS}`
		view.fraction = 5 / #Journey.STEPS
	elseif id == "client" then
		local first = CompanyOps.CLIENTS[1]
		view.app = "empire"
		view.section = "clients"
		view.progress = `Trust {math.floor(have)} %`
		view.fraction = have / need
		local trip = tripFor(live, first.id)
		local best = CompanyOps.liveBest(data, first.stat)
		if trip then
			view.body = `You drive to {first.name} for the pilot visit. Signing pays {dollars(first.retainer)} at once and every day.`
			view.eta = "back in " .. Format.duration(math.max(0, (tonumber(trip.back) or 0) - (tonumber(e.seconds) or 0)))
		elseif best &lt; first.minimum then
			view.body = `{first.name} needs {first.stat} {first.minimum}. Your best live model: {math.floor(best)}.`
		else
			view.body = `{first.name} wants a pilot. You drive over by yourself as soon as cash covers the trip.`
		end
	elseif id == "office2" or id == "office3" or id == "office4" or id == "office5" or id == "jet" then
		view.app = "empire"
		view.section = if id == "jet" then "settings" else "office"
		view.progress = (if id == "office2" then "First client ✓ · " else "") .. dollars(have) .. " / " .. dollars(need)
		view.fraction = have / need
		view.eta = if have &gt;= need then "ready" else HUD.etaText(goal.etaMinutes)
		if saving then
			view.body = "Save mode: research, Lab levels and big buys wait until the move."
		elseif have &lt; need and goal.etaMinutes == nil then
			view.body = "No profit right now. Release models and sign clients to get there."
		elseif id == "jet" then
			view.body = `Abroad trips by jet: {CompanyOps.JET.days} days, +{math.floor(CompanyOps.JET.trust * 100)} % trust.`
		else
			local stage = math.clamp(math.floor(tonumber(e.office) or 1) + 1, 1, #EmpireConfig.OFFICES)
			local def = EmpireConfig.OFFICES[stage]
			view.body = `{def.staff} desks, {ModelMath.productSlots(stage)} product lines, {CompanyOps.STAGES[stage].clients} client slots.`
		end
	elseif id == "lines2" then
		local ready = trainedModel(data)
		view.app = "lab"
		view.section = if ready then "release" else nil
		view.releaseId = if ready then ready.id else nil
		view.progress = `{math.floor(have)} / {math.floor(need)} lines live`
		view.fraction = have / need
		local lines = ModelMath.liveLines(data)
		local free: string? = nil
		for _, def in ModelConfig.LINES do
			if not lines[def.segment] then
				free = def.label
				break
			end
		end
		view.body = `Release a model into a second line{if free then ", e.g. " .. free else ""}. A specialist owns its line.`
	elseif id == "region" then
		view.app = "empire"
		view.section = "clients"
		view.progress = "0 / 1 region clients"
		view.fraction = 0
		local hint = "Region clients need a field rep: hire Growth &amp; Sales."
		if CompanyOps.fieldReps(e) &gt; 0 then
			hint = "Field reps visit region clients by themselves (City Hotel night)."
			for _, c in CompanyOps.CLIENTS do
				if c.trip == "region" and c.stage &lt;= CompanyOps.stageIndex(e) then
					local best = CompanyOps.liveBest(data, c.stat)
					local trust = if typeof(e.deals) == "table" and typeof(e.deals.trust) == "table" then tonumber(e.deals.trust[c.id]) else nil
					if best &lt; c.minimum then
						hint = `{c.name} needs {c.stat} {c.minimum}. Your best live model: {math.floor(best)}.`
					elseif trust then
						hint = `{c.name}: trust {math.floor(math.min(1, trust) * 100)} %. Reps keep visiting.`
						view.fraction = math.min(1, trust)
					else
						hint = `{c.name} is ready for a pilot visit by a field rep.`
					end
					break
				end
			end
		end
		view.body = hint
	elseif id == "frontier" then
		view.app = "empire"
		view.section = "research"
		view.progress = "Research"
		view.fraction = 0
		view.body = "Research Frontier Architecture to train 7B models."
	elseif id == "lines90" then
		view.app = "lab"
		view.progress = `{math.floor(have)} / {math.floor(need)} lines at 90+`
		view.fraction = have / need
		view.body = "Train stronger versions for every product line."
	elseif id == "lab" then
		view.app = "lab"
		view.progress = `Lab level {math.floor(have)} / {math.floor(need)}`
		view.fraction = have / need
		local pts, cost = CompanyOps.labCost(math.floor(have))
		view.body = `Next level: {Format.int(pts)} research points + {dollars(cost)}.`
	else
		view.progress = `{math.floor(have)} / {math.floor(need)}`
		view.fraction = have / need
	end
	if training and id ~= "train" and not saving then
		local progress = if training.workTotal &gt; 0 then training.workDone / training.workTotal else 0
		view.body = (if trainingModel then `Training {trainingModel.name} v{trainingModel.version}` else "Training") .. ` · {math.floor(progress * 100)} %. ` .. view.body
	end
	if view.fraction then
		view.fraction = math.clamp(view.fraction :: number, 0, 1)
	end
	return view
end

local function travelState(): string?
	local player = Players.LocalPlayer
	local ok, value = pcall(function(): any
		return (player :: any):GetAttribute("TravelState")
	end)
	return if ok and typeof(value) == "string" then value else nil
end

function HUD.mount(parent: Frame, devAllowed: boolean, onDev: () -&gt; ())
	local frame = Kit.frame(parent)
	frame.Name = "HUD"
	frame.Visible = false
	root = frame

	local column = Kit.frame(frame, UDim2.fromOffset(WIDTH, 0), UDim2.new(1, -16, 0, 12))
	column.Name = "Column"
	column.AnchorPoint = Vector2.new(1, 0)
	column.AutomaticSize = Enum.AutomaticSize.Y
	local layout = Kit.list(column, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	-- Firma und Zahlen in einem Glas-Panel: Geld groß, Nutzer und Reputation als Nebenwerte
	local panel = Kit.panel(column, UDim2.new(1, 0, 0, 0))
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.LayoutOrder = 1
	Kit.padding(panel, 12, 14, 12, 12)
	Kit.list(panel, 10)

	local identity = Kit.frame(panel, UDim2.new(1, 0, 0, 40))
	identity.LayoutOrder = 1
	local logoBox = Kit.frame(identity, UDim2.fromOffset(40, 40))
	logoBox.BackgroundTransparency = 0.72
	Theme.bindAccent(logoBox, "BackgroundColor3")
	Kit.corner(logoBox, 11)
	local logo = Kit.text(logoBox, "", 22, F.regular)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.fromScale(0.5, 0.5)
	local nameLabel = Kit.text(identity, "", 17, F.bold, C.text)
	nameLabel.AutomaticSize = Enum.AutomaticSize.None
	nameLabel.Size = UDim2.new(1, -52, 0, 22)
	nameLabel.Position = UDim2.fromOffset(52, 1)
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	local rankLabel = Kit.text(identity, "", 13, F.bold, C.muted)
	rankLabel.AutomaticSize = Enum.AutomaticSize.None
	rankLabel.Size = UDim2.new(1, -52, 0, 16)
	rankLabel.Position = UDim2.fromOffset(52, 23)
	rankLabel.TextTruncate = Enum.TextTruncate.AtEnd
	Theme.bindAccent(rankLabel, "TextColor3", Theme.lighter(0.3))

	Kit.divider(panel, 2)
	local moneyRow = Kit.frame(panel, UDim2.new(1, 0, 0, 26))
	moneyRow.LayoutOrder = 3
	local moneyValue = Kit.text(moneyRow, "$0", 22, F.display, C.text)
	moneyValue.AnchorPoint = Vector2.new(0, 0.5)
	moneyValue.Position = UDim2.fromScale(0, 0.5)
	local moneySub = Kit.text(moneyRow, "", 13, F.bold, C.dim)
	moneySub.Name = "NetPerDay"
	moneySub.AnchorPoint = Vector2.new(1, 0.5)
	moneySub.Position = UDim2.fromScale(1, 0.5)
	local statsRow = Kit.frame(panel, UDim2.new(1, 0, 0, 18))
	statsRow.LayoutOrder = 4
	local usersValue = Kit.text(statsRow, "0 users", 14, F.medium, C.muted)
	local repValue = Kit.text(statsRow, "Reputation 0", 14, F.medium, C.muted)
	repValue.AnchorPoint = Vector2.new(1, 0)
	repValue.Position = UDim2.fromScale(1, 0)

	local badges = Kit.frame(column, UDim2.new(1, 0, 0, 0))
	badges.AutomaticSize = Enum.AutomaticSize.Y
	badges.LayoutOrder = 2
	local badgeLayout = Kit.list(badges, 6, true)
	badgeLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	local travelBadge = Kit.tag(badges, "Abroad · Port Meridian", C.muted, 1)
	travelBadge.Name = "TravelBadge"
	travelBadge.Visible = false
	local saveBadge = Kit.tag(badges, "Saving off (Studio test)", C.warn, 2)
	saveBadge.Visible = false

	-- Next goal: one goal with progress and ETA; a tap opens the matching app
	local step = Instance.new("TextButton")
	step.Name = "NextGoal"
	step.AutoButtonColor = false
	step.Text = ""
	step.BorderSizePixel = 0
	step.Size = UDim2.new(1, 0, 0, 0)
	step.AutomaticSize = Enum.AutomaticSize.Y
	step.LayoutOrder = 3
	step.BackgroundColor3 = C.panel
	step.BackgroundTransparency = 0.02
	step.Selectable = true
	step.Parent = column
	Kit.corner(step, 14)
	local stepStroke = Kit.stroke(step, 0.87)
	stepStroke.Color = C.line
	local stepPadding = Kit.padding(step, 12, 14, 13, 14)
	Kit.list(step, 5)
	local captionRow = Kit.frame(step, UDim2.new(1, 0, 0, 16))
	captionRow.LayoutOrder = 1
	local stepCaption = Kit.text(captionRow, "Next goal", 13, F.medium, C.muted)
	stepCaption.Name = "Caption"
	stepCaption.AnchorPoint = Vector2.new(0, 0.5)
	stepCaption.Position = UDim2.fromScale(0, 0.5)
	Theme.bindAccent(stepCaption, "TextColor3")
	local saveTag = Kit.tag(captionRow, "Save mode", C.warn)
	saveTag.Name = "SaveMode"
	saveTag.AnchorPoint = Vector2.new(1, 0.5)
	saveTag.Position = UDim2.fromScale(1, 0.5)
	saveTag.Visible = false
	local stepTitle = Kit.para(step, "", 17, C.text, 2)
	stepTitle.Name = "Title"
	stepTitle.Font = F.bold
	local stepBody = Kit.para(step, "", 14, C.muted, 3)
	stepBody.Name = "Hint"
	local stepBar = Kit.bar(step, 6, 4)
	stepBar.frame.Name = "Progress"
	local progressRow = Kit.frame(step, UDim2.new(1, 0, 0, 16))
	progressRow.Name = "ProgressRow"
	progressRow.LayoutOrder = 5
	local progressText = Kit.text(progressRow, "", 13, F.medium, C.muted)
	progressText.Name = "Have"
	progressText.AutomaticSize = Enum.AutomaticSize.None
	progressText.Size = UDim2.new(0.7, 0, 1, 0)
	progressText.TextTruncate = Enum.TextTruncate.AtEnd
	local etaText = Kit.text(progressRow, "", 13, F.bold, C.text)
	etaText.Name = "Eta"
	etaText.AnchorPoint = Vector2.new(1, 0)
	etaText.Position = UDim2.fromScale(1, 0)
	etaText.TextXAlignment = Enum.TextXAlignment.Right
	Theme.bindAccent(etaText, "TextColor3", Theme.lighter(0.25))
	local current: GoalView? = nil
	Kit.onClick(step, function()
		local target = current
		if not target then
			return
		end
		Computer.open(target.app, target.section)
		local releaseId = target.releaseId
		if releaseId then
			LabApp.openRelease(releaseId)
		end
	end)

	-- milestone rewards are claimed by hand (EmpireAction ClaimQuest in Company → Goals): a small nudge
	local reward = Kit.button(column, "Milestone reward ready · Collect", "secondary", UDim2.new(1, 0, 0, 34))
	reward.Name = "RewardReady"
	reward.LayoutOrder = 4
	reward.TextSize = 14
	reward.Visible = false
	Kit.onClick(reward, function()
		Computer.open("empire", "milestones")
	end)

	-- Computer-Button, für Tastatur mit Tastenkappe "C"
	local computerButton = Kit.button(column, "Open company", "primary", UDim2.new(1, 0, 0, 50))
	computerButton.Name = "OpenCompany"
	computerButton.LayoutOrder = 5
	computerButton.TextSize = 17
	Kit.onClick(computerButton, Computer.toggle)
	if UserInputService.KeyboardEnabled then
		local keycap = Kit.frame(computerButton, UDim2.fromOffset(26, 24), UDim2.new(1, -12, 0.5, 0))
		keycap.AnchorPoint = Vector2.new(1, 0.5)
		keycap.BackgroundTransparency = 0.82
		keycap.BackgroundColor3 = C.bg
		Kit.corner(keycap, 6)
		local key = Kit.text(keycap, "C", 13, F.bold, C.bg)
		key.AnchorPoint = Vector2.new(0.5, 0.5)
		key.Position = UDim2.fromScale(0.5, 0.5)
	end
	if devAllowed then
		local dev = Kit.button(column, "DEV TOOLS", "ghost", UDim2.fromOffset(110, 30))
		dev.LayoutOrder = 6
		dev.TextSize = 12
		Kit.onClick(dev, onDev)
	end

	-- Phones: the whole HUD layer is scaled down a lot (UIRoot), so the goal card drops its hint line and uses a
	-- larger title. Read the scale of the HUD layer (sibling UIScale of this frame's parent).
	local compact = false
	local function applyCompact()
		local scale = parent:FindFirstChildOfClass("UIScale")
		compact = scale ~= nil and scale.Scale &lt; COMPACT_SCALE
		stepTitle.TextSize = if compact then 19 else 17
		stepCaption.TextSize = if compact then 14 else 13
		progressText.TextSize = if compact then 15 else 13
		etaText.TextSize = if compact then 15 else 13
		stepPadding.PaddingTop = UDim.new(0, if compact then 9 else 12)
		stepPadding.PaddingBottom = UDim.new(0, if compact then 10 else 13)
		stepBody.Visible = not compact and stepBody.Text ~= ""
	end
	local layerScale = parent:FindFirstChildOfClass("UIScale")
	if layerScale then
		layerScale:GetPropertyChangedSignal("Scale"):Connect(applyCompact)
	end
	applyCompact()

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not frame.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.C then
			Computer.toggle()
		end
	end)

	StateController.onChange(function(snapshot: Snapshot)
		local data = snapshot.data
		local info = data.company
		frame.Visible = info ~= nil and frame:GetAttribute("Hidden") ~= true
		if not info then
			return
		end
		logo.Text = info.logo
		nameLabel.Text = info.name
		local stage = EmpireConfig.OFFICES[math.clamp(math.floor(tonumber(data.empire.office) or 1), 1, #EmpireConfig.OFFICES)]
		rankLabel.Text = CompanyConfig.rankFor(data.stats.peakUsers) .. "  ·  " .. (string.gsub(stage.name, "Headquarters", "HQ"))
		repValue.Text = `Reputation {string.format("%.0f", info.reputation)}`
		saveBadge.Visible = not snapshot.saveEnabled
		local travel = travelState()
		travelBadge.Visible = travel ~= nil
		travelBadge.Text = if travel == "flying" then "IN THE AIR" elseif travel == "abroad" then "ABROAD · PORT MERIDIAN" else ""
		badges.Visible = travelBadge.Visible or saveBadge.Visible
		local claimable = false
		for _, quest in EmpireConfig.QUESTS do
			if not data.empire.quests[quest.id] and EmpireMath.progress(data, quest) &gt;= quest.target then
				claimable = true
				break
			end
		end
		reward.Visible = claimable

		-- money per game day (CORE_SPEC 6: the UI shows running money per game day)
		local live = snapshot.live
		local net = live.revenue - live.cost
		if live.revenue &gt; 0 or live.cost &gt; 0 then
			moneySub.Text = Format.perDay(net)
			moneySub.TextColor3 = if net &gt;= 0 then C.good else C.bad
		else
			moneySub.Text = "no income yet"
			moneySub.TextColor3 = C.dim
		end

		local view = HUD.describe(snapshot, StateController.ui)
		current = view
		stepCaption.Text = view.caption
		stepCaption.TextColor3 = if view.warn then C.warn else Theme.accent
		saveTag.Visible = view.saving
		stepTitle.Text = view.title
		stepBody.Text = view.body
		stepBody.Visible = not compact and view.body ~= ""
		stepBar.frame.Visible = view.fraction ~= nil
		if view.fraction and not view.training then
			stepBar.set(view.fraction :: number)
		end
		progressRow.Visible = view.progress ~= "" or view.eta ~= ""
		progressText.Text = view.progress
		etaText.Text = view.eta
		stepStroke.Color = if view.warn then C.warn else C.line
		stepStroke.Transparency = if view.warn then 0.45 else 0.87
	end)

	-- Zahlen gleiten zum Zielwert (Geld läuft zwischen den Snapshots weiter)
	local shownMoney, shownUsers = 0, 0
	RunService.RenderStepped:Connect(function(dt: number)
		local snapshot = StateController.snapshot
		column.Visible = not Computer.isOpen() -- im Computer stehen dieselben Zahlen in der Kopfzeile
		if not snapshot or not frame.Visible then
			return
		end
		local alpha = math.min(1, dt * 8)
		local money = StateController.money()
		shownMoney = if math.abs(money - shownMoney) &gt; 1e8 then money else shownMoney + (money - shownMoney) * alpha
		moneyValue.Text = Format.money(shownMoney)
		moneyValue.TextColor3 = if shownMoney &lt; 0 then C.bad else C.text
		local users = snapshot.live.users
		shownUsers = if math.abs(users - shownUsers) &gt; 1e7 then users else shownUsers + (users - shownUsers) * alpha
		usersValue.Text = `{Format.compact(shownUsers)} users`
		local view = current
		if view and view.training and stepBar.frame.Visible then
			local done, total = StateController.trainingWork()
			local fraction = if total &gt; 0 then done / total else 0
			stepBar.set(fraction)
			progressText.Text = string.format("Training %d %%", math.floor(fraction * 100))
			local eta = StateController.trainingEta()
			etaText.Text = if eta &gt; 0 and eta &lt; math.huge then Format.duration(eta) .. " left" else ""
		end
	end)

	-- Benachrichtigungen vom Server
	StateController.onNotify(function(kind: string, payload: { [string]: any })
		if kind == "TRAINING_EVENT" then
			if Computer.isOpen() then
				return -- das Lab zeigt die Entscheidung ohnehin groß an
			end
			local def = if typeof(payload.eventId) == "string" then ModelConfig.getEvent(payload.eventId) else nil
			Toast.show("warn", `Training paused: {if def then def.title else "decision needed"}. Open the Lab to decide.`, 5)
		elseif kind == "TRAINING_COMPLETE" then
			local overall = if typeof(payload.overall) == "number" then payload.overall else 0
			if not Computer.isOpen() then -- bei offenem Computer erscheint das Ergebnis direkt im Lab
				Toast.show("success", `Training complete! Overall {string.format("%.1f", overall)}. Open your computer to see it.`, 5)
			end
		elseif kind == "MODEL_LIVE" then
			if not Computer.isOpen() then
				Toast.show("success", "Your model is live. Users are coming in!")
			end
		elseif kind == "RANK_UP" then
			local rank = if typeof(payload.rank) == "string" then payload.rank else "new rank"
			Toast.show("success", `Rank up! Your company is now a {rank}.`, 6)
		end
	end)
end

-- Während des Intros ausblenden
function HUD.setHidden(hidden: boolean)
	local frame = root
	if not frame then
		return
	end
	frame:SetAttribute("Hidden", hidden)
	local snapshot = StateController.snapshot
	frame.Visible = not hidden and snapshot ~= nil and snapshot.data.company ~= nil
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">Intro</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Intro: Titelbildschirm und Firmengründung. Eigene randlose Ebene über allem, bis eine Firma existiert.
-- Bei bestehender Firma: "Welcome back" + CONTINUE. Nach Debug-Reset erscheint es wieder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CompanyConfig = require(Shared.Config.CompanyConfig)
local Format = require(Shared.Format)
local Types = require(Shared.Types)

local UI = script.Parent.Parent
local Client = UI.Parent
local StateController = require(Client.Controllers.StateController)
local ActionController = require(Client.Controllers.ActionController)
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local Toast = require(UI.Toast)

local C = Theme.colors
local F = Theme.font

export type Callbacks = { onFinish: () -&gt; (), onReopen: () -&gt; () }

local Intro = {}

local function trim(text: string): string
	return (string.gsub(string.gsub(text, "^%s+", ""), "%s+$", ""))
end

local function validName(text: string): boolean
	local length = utf8.len(trim(text))
	return length ~= nil and length &gt;= GameConfig.COMPANY_NAME_MIN and length &lt;= GameConfig.COMPANY_NAME_MAX
end

local function colorOf(id: string): Color3
	local def = CompanyConfig.getColor(id)
	return if def then Theme.rgb(def.rgb) else Theme.DEFAULT_ACCENT
end

function Intro.mount(parent: Frame, callbacks: Callbacks)
	local blocker = Kit.blocker(parent, C.white, 0)
	blocker.Name = "Intro"
	blocker.ZIndex = 30
	

	-- Quiet architectural backdrop: one border, a small wordmark and generous space.
	blocker.BackgroundColor3 = C.bg
	local edge = Kit.frame(blocker, UDim2.new(0, 1, 1, -96), UDim2.new(0, 48, 0, 48))
	edge.BackgroundColor3 = C.line
	edge.BackgroundTransparency = 0.92
	local edition = Kit.text(blocker, "FOUNDER DISTRICT   /   01", 12, F.bold, C.muted)
	edition.Position = UDim2.fromOffset(72, 52)
	local footerNote = Kit.text(blocker, "A garage today. Your company tomorrow.", 14, F.regular, C.dim)
	footerNote.Position = UDim2.new(0, 72, 1, -48)
	local mark = Kit.frame(blocker, UDim2.fromOffset(28, 28), UDim2.new(1,-72,0,52))
	mark.BackgroundColor3 = Theme.accent
	mark.BackgroundTransparency = 0.1
	Kit.corner(mark, 5)
	local cut = Kit.frame(mark,UDim2.fromOffset(8,20),UDim2.fromOffset(10,4))
	cut.BackgroundColor3 = C.bg
	cut.BackgroundTransparency = 0

	---------------------------------------------------------------- Titel
	local splash = Kit.frame(blocker, UDim2.fromOffset(860, 0), UDim2.fromScale(0.5, 0.46))
	splash.AnchorPoint = Vector2.new(0.5, 0.5)
	splash.AutomaticSize = Enum.AutomaticSize.Y
	local splashLayout = Kit.list(splash, 12)
	splashLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local title = Kit.text(splash, "AI Empire", 64, F.display, C.white)
	title.LayoutOrder = 1
	title.TextXAlignment = Enum.TextXAlignment.Center
	local horizon = Kit.frame(splash, UDim2.fromOffset(52, 3))
	horizon.LayoutOrder = 2
	horizon.BackgroundTransparency = 0
	Theme.bindAccent(horizon, "BackgroundColor3")
	local horizonFade = Instance.new("UIGradient")
	horizonFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	horizonFade.Parent = horizon
	local tagline = Kit.text(splash, "Train the model. Build the business.", 21, F.medium, C.muted)
	tagline.LayoutOrder = 3
	local spacer = Kit.frame(splash, UDim2.fromOffset(1, 10))
	spacer.LayoutOrder = 4
	local status = Kit.text(splash, "Connecting...", 16, F.medium, C.dim)
	status.LayoutOrder = 5
	local start = Kit.button(splash, "Build your company", "primary", UDim2.fromOffset(260, 56))
	start.LayoutOrder = 6
	start.TextSize = 19
	start.Visible = false

	---------------------------------------------------------------- Formular
	local form = Kit.scroll(blocker)
	form.Visible = false
	Kit.padding(form, 72, 24, 28, 24) -- oben Platz für die Roblox-Topbar (Ebene ist randlos)
	local formLayout = Kit.list(form, 14)
	formLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local column = Kit.frame(form, UDim2.fromScale(1, 0))
	column.AutomaticSize = Enum.AutomaticSize.Y
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(800, math.huge)
	limit.Parent = column
	Kit.list(column, 14)

	local head = Kit.stack(column, 8, 1)
	local formTitle = Kit.text(head, "Make it your company", 26, F.display, C.text)
	formTitle.LayoutOrder = 1
	Kit.para(
		head,
		`You start in a garage with {Format.money(GameConfig.START_MONEY)} and an old laptop. Everything else you build yourself.`,
		16,
		C.muted,
		2
	)

	local selectedLogo = CompanyConfig.LOGOS[1]
	local selectedColor = CompanyConfig.COLORS[1].id
	local selectedSpec = CompanyConfig.SPECIALIZATIONS[1].id

	local formPanel = Kit.panel(column, UDim2.fromScale(1, 0))
	formPanel.AutomaticSize = Enum.AutomaticSize.Y
	formPanel.LayoutOrder = 2
	formPanel.BackgroundTransparency = 0.06
	Kit.padding(formPanel, 22, 24, 22, 24)
	Kit.list(formPanel, 20)

	-- Name
	local nameCard = Kit.stack(formPanel, 8, 1)
	local nameHead = Kit.frame(nameCard, UDim2.new(1, 0, 0, 18))
	nameHead.LayoutOrder = 1
	Kit.caption(nameHead, "Company name")
	local counter = Kit.text(nameHead, "", 13, F.bold, C.dim)
	counter.AnchorPoint = Vector2.new(1, 0)
	counter.Position = UDim2.fromScale(1, 0)
	local nameBox = Kit.input(nameCard, "e.g. Nimbus Labs")
	nameBox.LayoutOrder = 2

	-- Logo
	local logoCard = Kit.stack(formPanel, 10, 2)
	Kit.caption(logoCard, "Logo", 1)
	local logoRow = Kit.row(logoCard, 54, 8, 2)
	local logoButtons: { [string]: { button: TextButton, stroke: UIStroke } } = {}
	for index, glyph in CompanyConfig.LOGOS do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = glyph
		button.TextSize = 26
		button.Font = F.regular
		button.Size = UDim2.fromOffset(54, 54)
		button.LayoutOrder = index
		button.BackgroundColor3 = C.raised
		button.Parent = logoRow
		Kit.corner(button, 12)
		local stroke = Kit.stroke(button, 1, Theme.accent, 2)
		logoButtons[glyph] = { button = button, stroke = stroke }
	end

	-- Farbe
	local colorCard = Kit.stack(formPanel, 10, 3)
	Kit.caption(colorCard, "Brand color", 1)
	local colorRow = Kit.row(colorCard, 44, 10, 2)
	local colorButtons: { [string]: UIStroke } = {}
	local colorClicks: { [string]: TextButton } = {}
	for index, def in CompanyConfig.COLORS do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = ""
		button.Size = UDim2.fromOffset(40, 40)
		button.LayoutOrder = index
		button.BackgroundColor3 = Theme.rgb(def.rgb)
		button.Parent = colorRow
		Kit.corner(button, 20)
		colorButtons[def.id] = Kit.stroke(button, 1, C.white, 3)
		colorClicks[def.id] = button
	end

	-- Spezialisierung
	local specCard = Kit.stack(formPanel, 10, 4)
	Kit.caption(specCard, "Specialization: a small bonus that lasts forever", 1)
	local specGrid = Kit.grid(specCard, 3, 80, 10, 2)
	local specButtons: { [string]: { button: TextButton, stroke: UIStroke } } = {}
	for index, spec in CompanyConfig.SPECIALIZATIONS do
		local button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.Text = ""
		button.LayoutOrder = index
		button.BackgroundColor3 = C.bg
		button.BackgroundTransparency = 0.3
		button.Parent = specGrid
		Kit.corner(button, 12)
		local stroke = Kit.stroke(button, 0.88, C.line, 2)
		Kit.padding(button, 10, 12, 10, 12)
		Kit.list(button, 4)
		local name = Kit.text(button, spec.name, 16, F.bold, C.text)
		name.LayoutOrder = 1
		Kit.para(button, spec.desc, 13, C.muted, 2)
		specButtons[spec.id] = { button = button, stroke = stroke }
	end

	-- Vorschau + Gründen
	Kit.divider(formPanel, 5)
	local footer = Kit.frame(formPanel, UDim2.new(1, 0, 0, 60))
	footer.LayoutOrder = 6
	local previewLogo = Kit.frame(footer, UDim2.fromOffset(52, 52), UDim2.new(0, 0, 0.5, -26))
	previewLogo.BackgroundTransparency = 0.7
	Theme.bindAccent(previewLogo, "BackgroundColor3")
	Kit.corner(previewLogo, 14)
	local previewGlyph = Kit.text(previewLogo, selectedLogo, 28, F.regular)
	previewGlyph.AnchorPoint = Vector2.new(0.5, 0.5)
	previewGlyph.Position = UDim2.fromScale(0.5, 0.5)
	local previewName = Kit.text(footer, "", 22, F.black, C.text)
	previewName.AutomaticSize = Enum.AutomaticSize.None
	previewName.Size = UDim2.new(1, -340, 0, 26)
	previewName.Position = UDim2.fromOffset(66, 8)
	previewName.TextTruncate = Enum.TextTruncate.AtEnd
	local previewSpec = Kit.text(footer, "", 14, F.bold, C.muted)
	previewSpec.Position = UDim2.fromOffset(66, 36)
	Theme.bindAccent(previewSpec, "TextColor3")
	local found = Kit.button(footer, "Create company", "primary", UDim2.fromOffset(250, 54))
	found.AnchorPoint = Vector2.new(1, 0.5)
	found.Position = UDim2.fromScale(1, 0.5)
	found.TextSize = 18

	local function paint()
		local text = trim(nameBox.Text)
		local length = utf8.len(text) or 0
		counter.Text = `{length}/{GameConfig.COMPANY_NAME_MAX}`
		counter.TextColor3 = if length &gt; GameConfig.COMPANY_NAME_MAX then C.bad else C.dim
		previewName.Text = if text ~= "" then text else "Your company"
		previewGlyph.Text = selectedLogo
		local spec = CompanyConfig.getSpec(selectedSpec)
		previewSpec.Text = if spec then spec.name else ""
		for glyph, refs in logoButtons do
			local on = glyph == selectedLogo
			refs.stroke.Transparency = if on then 0 else 1
			refs.stroke.Color = Theme.accent
			refs.button.BackgroundColor3 = if on then Theme.accent:Lerp(C.bg, 0.65) else C.raised
		end
		for id, stroke in colorButtons do
			stroke.Transparency = if id == selectedColor then 0 else 1
		end
		for id, refs in specButtons do
			local on = id == selectedSpec
			refs.stroke.Color = if on then Theme.accent else C.line
			refs.stroke.Transparency = if on then 0 else 0.88
		end
		Kit.setDisabled(found, not validName(nameBox.Text))
	end

	for glyph, refs in logoButtons do
		refs.button.Activated:Connect(function()
			selectedLogo = glyph
			paint()
		end)
	end
	for id, button in colorClicks do
		button.Activated:Connect(function()
			selectedColor = id
			Theme.setAccent(colorOf(id)) -- Vorschau sofort in der Firmenfarbe
			paint()
		end)
	end
	for id, refs in specButtons do
		refs.button.Activated:Connect(function()
			selectedSpec = id
			paint()
		end)
	end
	nameBox:GetPropertyChangedSignal("Text"):Connect(paint)
	Theme.onAccent(function()
		paint()
	end)
	paint()

	---------------------------------------------------------------- Ablauf
	local stage = "loading" -- loading | welcome | new | form | done

	local function finish()
		if stage == "done" then
			return
		end
		stage = "done"
		Kit.tween(blocker, 0.6, { Position = UDim2.fromScale(0, -1) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.6, function()
			if stage == "done" then
				blocker.Visible = false
			end
		end)
		callbacks.onFinish()
	end

	local function showNew()
		stage = "new"
		blocker.Position = UDim2.new()
		blocker.Visible = true
		form.Visible = false
		splash.Visible = true
		status.Text = `You have {Format.money(GameConfig.START_MONEY)}, an old laptop and a big idea.`
		start.Text = "Build your company"
		start.Visible = true
	end

	Kit.onClick(start, function()
		if stage == "welcome" then
			finish()
		elseif stage == "new" then
			stage = "form"
			splash.Visible = false
			form.Visible = true
		end
	end)

	Kit.onClick(found, function()
		local name = trim(nameBox.Text)
		local ok = ActionController.call("CreateCompany", {
			name = name,
			logo = selectedLogo,
			color = selectedColor,
			spec = selectedSpec,
		})
		if ok then
			Toast.show("success", `Welcome to {name}! Your garage office is ready.`, 5)
			finish()
		end
	end)

	StateController.onChange(function(snapshot: Types.Snapshot)
		local company = snapshot.data.company
		if stage == "done" then
			if not company then
				-- Firma wurde zurückgesetzt (Debug): Intro wieder zeigen
				callbacks.onReopen()
				showNew()
			end
			return
		end
		if company then
			if stage == "form" then
				finish()
			elseif stage ~= "welcome" then
				stage = "welcome"
				status.Text = `Welcome back, {company.logo} {company.name}`
				start.Text = "Back to work"
				start.Visible = true
			end
		elseif stage == "loading" then
			showNew()
		end
	end)
end

return Intro
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000055"><Properties><string name="Name">Conversation</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Job interview in the visitor lounge. Chat transcript: the founder's questions on the right, the
-- candidate's answers on the left after a short "typing…" pause. Answers come from the server's
-- authored dialogue templates (RecruitingService) chosen by the candidate's hidden skill and temperament;
-- there is no language model behind it.
-- Header: candidate card (initials avatar, applied role, experience, previous employer, specialty, salary
-- ask) and the impression bar = estimated skill range so far (the true skill is revealed after hiring).
-- Footer: Hire (signing cost + wage), a 15% lower offer, Reject, Close (the candidate keeps waiting).
-- Own ScreenGui with a UIScale fitted to the viewport like the lift panel; Kit buttons work with mouse,
-- touch and gamepad (GuiService selection on open and after every answer).
local Players=game:GetService("Players")
local GuiService=game:GetService("GuiService")
local UserInputService=game:GetService("UserInputService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Format=require(ReplicatedStorage.Shared.Format)
local UI=script.Parent.Parent
local Kit=require(UI.Kit)
local Theme=require(UI.Theme)
local Toast=require(UI.Toast)
local C,F=Theme.colors,Theme.font
local Conversation={}
export type Call=(payload: {[string]:any})-&gt;(boolean,any)
local W,H=820,600
local player=Players.LocalPlayer
local gui: ScreenGui?=nil
local token=0
local function money(n: number): string return Format.money(n) end
local function wage(n: number): string return string.format("$%.2f/s",n) end
function Conversation.avatarColor(seed: number): Color3
 return Color3.fromHSV((math.floor(math.abs(seed))%360)/360,.32,.72)
end
-- Initials avatar circle (no images, no asset ids).
function Conversation.avatar(parent: Instance,initials: string,seed: number,size: number): Frame
 local circle=Kit.frame(parent,UDim2.fromOffset(size,size))
 circle.BackgroundTransparency=0;circle.BackgroundColor3=Conversation.avatarColor(seed)
 Kit.corner(circle,size//2+1)
 local label=Kit.text(circle,initials,math.floor(size*.38),F.bold,C.bg)
 label.AutomaticSize=Enum.AutomaticSize.None;label.Size=UDim2.fromScale(1,1);label.TextXAlignment=Enum.TextXAlignment.Center
 return circle
end
function Conversation.isOpen(): boolean return gui~=nil end
function Conversation.close()
 token+=1
 if gui then gui:Destroy();gui=nil end
end
local function fitScale(scale: UIScale)
 local camera=workspace.CurrentCamera
 local vp=if camera then camera.ViewportSize else Vector2.new(1280,720)
 scale.Scale=math.clamp(math.min((vp.Y-24)/H,(vp.X-24)/W),.3,1)
end
function Conversation.open(payload: any,call: Call)
 Conversation.close()
 local mine=token
 local data=payload
 local busy=false
 local screen=Instance.new("ScreenGui");screen.Name="PeopleInterview";screen.ResetOnSpawn=false;screen.DisplayOrder=42;screen.IgnoreGuiInset=false
 screen.Parent=player:WaitForChild("PlayerGui");gui=screen
 local box=Kit.frame(screen,UDim2.fromOffset(W,H),UDim2.fromScale(.5,.5));box.AnchorPoint=Vector2.new(.5,.5)
 box.BackgroundColor3=C.panel;box.BackgroundTransparency=0;Kit.corner(box,14);Kit.stroke(box,.85)
 local scale=Instance.new("UIScale");scale.Parent=box;fitScale(scale)
 local camera=workspace.CurrentCamera
 if camera then
  local resize=camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() if scale.Parent then fitScale(scale) end end)
  screen.Destroying:Connect(function() resize:Disconnect() end)
 end
 local inner=Kit.frame(box,UDim2.new(1,-32,1,-32),UDim2.fromOffset(16,16))
 -- Header: candidate card
 Conversation.avatar(inner,data.initials or "?",data.seed or 0,64).Position=UDim2.fromOffset(0,4)
 local name=Kit.text(inner,data.name or "",22,F.bold,C.text);name.Position=UDim2.fromOffset(78,2)
 local roleLine=Kit.text(inner,"",14,F.medium,C.muted);roleLine.Position=UDim2.fromOffset(78,31)
 local facts=Kit.text(inner,"",14,F.regular,C.muted);facts.Position=UDim2.fromOffset(78,51)
 local askLine=Kit.text(inner,"",14,F.medium,C.text);askLine.AnchorPoint=Vector2.new(1,0);askLine.Position=UDim2.new(1,0,0,44);askLine.TextXAlignment=Enum.TextXAlignment.Right
 local closeTop=Kit.button(inner,"Close","ghost",UDim2.fromOffset(92,32));closeTop.AnchorPoint=Vector2.new(1,0);closeTop.Position=UDim2.new(1,0,0,2)
 -- Impression bar
 local impCaption=Kit.text(inner,"Estimated skill",13,F.medium,C.muted);impCaption.Position=UDim2.fromOffset(0,90)
 local track=Kit.frame(inner,UDim2.fromOffset(300,12),UDim2.fromOffset(112,93));track.BackgroundTransparency=0;track.BackgroundColor3=C.raised;Kit.corner(track,6)
 local fill=Kit.frame(track,UDim2.fromScale(1,1));fill.BackgroundTransparency=0;Theme.bindAccent(fill,"BackgroundColor3");Kit.corner(fill,6)
 for i=1,5 do
  local tick=Kit.text(inner,tostring(i),11,F.medium,C.dim);tick.AnchorPoint=Vector2.new(.5,0);tick.Position=UDim2.fromOffset(112+(i-1)/4*300,107)
 end
 local range=Kit.text(inner,"",15,F.bold,C.text);range.Position=UDim2.fromOffset(426,88)
 local note=Kit.text(inner,"",13,F.regular,C.muted);note.Position=UDim2.fromOffset(426,108);note.AutomaticSize=Enum.AutomaticSize.None;note.Size=UDim2.new(1,-426,0,18);note.TextTruncate=Enum.TextTruncate.AtEnd
 -- Transcript
 local scroll=Kit.scroll(inner,UDim2.new(1,0,0,224),UDim2.fromOffset(0,134))
 scroll.BackgroundTransparency=0;scroll.BackgroundColor3=C.bg;Kit.corner(scroll,10)
 local list=Kit.frame(scroll,UDim2.fromScale(1,0));list.AutomaticSize=Enum.AutomaticSize.Y;Kit.list(list,8);Kit.padding(list,10,12,10,10)
 local order=0
 local firstName=string.match(data.name or "","^(%S+)") or "Candidate"
 local function toBottom()
  task.defer(function() if scroll.Parent then scroll.CanvasPosition=Vector2.new(0,math.max(0,scroll.AbsoluteCanvasSize.Y-scroll.AbsoluteWindowSize.Y)) end end)
 end
 local function bubble(fromFounder: boolean,text: string): (Frame,TextLabel)
  order+=1
  local holder=Kit.frame(list,UDim2.fromScale(1,0));holder.AutomaticSize=Enum.AutomaticSize.Y;holder.LayoutOrder=order
  local b=Kit.frame(holder,UDim2.new(.8,0,0,0));b.AutomaticSize=Enum.AutomaticSize.Y;b.BackgroundTransparency=0
  if fromFounder then b.AnchorPoint=Vector2.new(1,0);b.Position=UDim2.fromScale(1,0);Theme.bindAccent(b,"BackgroundColor3",Theme.tint(.62)) else b.BackgroundColor3=C.raised end
  Kit.corner(b,10);Kit.padding(b,7,12,9,12);Kit.list(b,2)
  local who=Kit.text(b,if fromFounder then "You" else firstName,12,F.bold,if fromFounder then C.text else C.muted);who.LayoutOrder=1
  local label=Kit.para(b,text,15,C.text,2)
  toBottom()
  return holder,label
 end
 local function typing(): Frame
  local holder,label=bubble(false,"typing")
  task.spawn(function()
   local dots=0
   while holder.Parent do dots=dots%3+1;label.Text="typing"..string.rep(".",dots);task.wait(.35) end
  end)
  return holder
 end
 for _,line in data.transcript or {} do bubble(line.from=="founder",line.text) end
 -- Questions / replies
 local qCaption=Kit.text(inner,"",13,F.medium,C.muted);qCaption.Position=UDim2.fromOffset(0,366);qCaption.AutomaticSize=Enum.AutomaticSize.None;qCaption.Size=UDim2.new(1,0,0,18);qCaption.TextTruncate=Enum.TextTruncate.AtEnd
 local qArea=Kit.scroll(inner,UDim2.new(1,0,0,124),UDim2.fromOffset(0,388))
 local footer=Kit.frame(inner,UDim2.new(1,0,0,46),UDim2.new(0,0,1,-46));Kit.list(footer,10,true)
 local hire=Kit.button(footer,"Hire","primary",UDim2.new(.38,-8,1,0));hire.LayoutOrder=1
 local low=Kit.button(footer,"Offer less","secondary",UDim2.new(.26,-8,1,0));low.LayoutOrder=2
 local reject=Kit.button(footer,"Reject","danger",UDim2.new(.18,-8,1,0));reject.LayoutOrder=3
 local close=Kit.button(footer,"Close","ghost",UDim2.new(.18,0,1,0));close.LayoutOrder=4
 for _,b in {hire,low,reject,close} do b.TextSize=15 end
 local actionButtons: {TextButton}={}
 local function setBusy(value: boolean)
  busy=value
  for _,b in actionButtons do if b.Parent then Kit.setDisabled(b,value or b:GetAttribute("Locked")==true) end end
 end
 local function lock(b: TextButton,locked: boolean)
  b:SetAttribute("Locked",locked);Kit.setDisabled(b,locked or busy)
 end
 local renderQuestions: ()-&gt;()
 local function refresh()
  local imp=data.impression or {estimateLow=1,estimateHigh=5,note=""}
  local lo,hi=tonumber(imp.estimateLow) or 1,tonumber(imp.estimateHigh) or 5
  roleLine.Text="Applying as "..tostring(data.roleName).."  ·  "..tostring(data.years).." of experience"
  facts.Text="Previously at "..tostring(data.prev).."  ·  Specialty: "..tostring(data.spec)
  askLine.Text="Asks "..money(data.cost).." + "..wage(data.wage).."\n≈ "..money(data.wage*(data.monthSeconds or 3600)).." per game month"
  fill.Position=UDim2.fromScale((lo-1)/4,0);fill.Size=UDim2.fromScale(math.max(.03,(hi-lo)/4),1)
  range.Text=string.format("%s – %s ★",tostring(lo),tostring(hi))
  note.Text=imp.note or ""
  hire.Text=if data.staffFull then "All desks filled" else "Hire · "..money(data.cost).." · "..wage(data.wage)
  low.Text=if data.lowDeclined then "Lower offer declined" else "Offer −15% · "..money(data.lowCost)
  lock(hire,data.staffFull==true);lock(low,data.staffFull==true or data.lowDeclined==true)
  renderQuestions()
 end
 local first: GuiObject?=nil
 local function select()
  if UserInputService.GamepadEnabled and screen.Parent then GuiService.SelectedObject=first or hire end
 end
 local function ask(q: any)
  if busy then return end
  setBusy(true)
  bubble(true,q.text)
  local pendingBubble=typing();local started=os.clock()
  local ok,res=call({action="question",id=data.id,questionId=q.id})
  if ok and typeof(res.answer)=="string" then
   local delay=math.clamp(#res.answer/110,.9,2.2)-(os.clock()-started)
   if delay&gt;0 then task.wait(delay) end
   if mine~=token then return end
   pendingBubble:Destroy();bubble(false,res.answer)
   if typeof(res.interview)=="table" then data=res.interview end
  else pendingBubble:Destroy() end
  if mine~=token then return end
  setBusy(false);refresh();select()
 end
 local function reply(index: number,text: string)
  if busy then return end
  setBusy(true)
  bubble(true,text)
  local pendingBubble=typing()
  local ok,res=call({action="reply",id=data.id,option=index})
  task.wait(.9)
  if mine~=token then return end
  pendingBubble:Destroy()
  if ok and typeof(res.text)=="string" then bubble(false,res.text) end
  if ok and typeof(res.interview)=="table" then data=res.interview end
  setBusy(false);refresh();select()
 end
 renderQuestions=function()
  for _,child in qArea:GetChildren() do if child:IsA("GuiObject") or child:IsA("UIGridLayout") or child:IsA("UIListLayout") then child:Destroy() end end
  table.clear(actionButtons);table.insert(actionButtons,hire);table.insert(actionButtons,low);table.insert(actionButtons,reject)
  first=nil
  local pending=data.pendingAsk
  if typeof(pending)=="table" then
   qCaption.Text=firstName.." asked you a question. Your answer:"
   Kit.list(qArea,6)
   for i,text in pending.options do
    local b=Kit.button(qArea,text,"secondary",UDim2.new(1,-8,0,36));b.LayoutOrder=i;b.TextSize=14;b.TextWrapped=true
    Kit.onClick(b,function() task.spawn(reply,i,text) end)
    table.insert(actionButtons,b);if not first then first=b end
   end
  else
   local left=(data.max or 7)-(data.asked or 0)
   local questions=data.questions or {}
   qCaption.Text=if left&lt;=0 or #questions==0 then "You've asked enough. Decide: hire, offer less or reject." else string.format("Ask a question  ·  %d of %d left  ·  technical questions show real skill",left,data.max or 7)
   local grid=Instance.new("UIGridLayout");grid.CellSize=UDim2.new(.5,-6,0,40);grid.CellPadding=UDim2.fromOffset(8,6);grid.SortOrder=Enum.SortOrder.LayoutOrder;grid.Parent=qArea
   for i,q in questions do
    local technical=q.kind=="technical"
    local b=Kit.button(qArea,(if technical then "Technical: " else "")..q.text,if technical then "ghost" else "secondary")
    b.LayoutOrder=if technical then i else 100+i;b.TextSize=13;b.TextWrapped=true;b.TextXAlignment=Enum.TextXAlignment.Left
    if technical then b.TextColor3=C.text;local stroke=Kit.stroke(b,.35,Theme.accent);Theme.bindAccent(stroke,"Color") end
    Kit.padding(b,2,10,2,10)
    Kit.onClick(b,function() task.spawn(ask,q) end)
    table.insert(actionButtons,b);if technical and not first then first=b end
   end
   if not first then for _,child in qArea:GetChildren() do if child:IsA("TextButton") then first=child;break end end end
  end
  for _,b in actionButtons do Kit.setDisabled(b,busy or b:GetAttribute("Locked")==true) end
 end
 local function offer(lower: boolean)
  if busy then return end
  setBusy(true)
  bubble(true,if lower then "We'd like to offer you "..money(data.lowCost).." to sign and "..wage(data.lowWage).."." else "We'd like to offer you the job: "..money(data.cost).." to sign and "..wage(data.wage)..".")
  local pendingBubble=typing()
  local ok,res=call({action="hire",id=data.id,offer=if lower then "low" else "full"})
  task.wait(1)
  if mine~=token then return end
  pendingBubble:Destroy()
  if ok and res.accepted then
   bubble(false,tostring(res.text))
   Toast.show("success",tostring(data.name).." joined your team.",4)
   task.delay(2,function() if mine==token then Conversation.close() end end)
   return
  end
  if ok and typeof(res.text)=="string" then bubble(false,res.text) end
  if ok and typeof(res.interview)=="table" then data=res.interview end
  setBusy(false);refresh();select()
 end
 Kit.onClick(hire,function() task.spawn(offer,false) end)
 Kit.onClick(low,function() task.spawn(offer,true) end)
 Kit.onClick(reject,function()
  if busy then return end
  setBusy(true)
  task.spawn(function()
   local ok=call({action="reject",id=data.id})
   if mine~=token then return end
   if ok then Toast.show("info","Application declined. "..firstName.." is leaving the building.",4);Conversation.close() else setBusy(false) end
  end)
 end)
 local function leave()
  task.spawn(function() call({action="close",id=data.id}) end)
  Conversation.close()
 end
 Kit.onClick(close,leave);Kit.onClick(closeTop,leave)
 refresh();select()
 -- respawning ends the conversation (the candidate keeps waiting in the lounge)
 local character=player.Character;local h=if character then character:FindFirstChildOfClass("Humanoid") else nil
 if h then h.Died:Connect(function() if mine==token then leave() end end) end
end
return Conversation
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000056"><Properties><string name="Name">Phone</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The company phone UI (package "phone"): its own ScreenGui "AIEmpire_Phone" with
--   * a phone button in the bottom-right corner (badge = unread messages + missed calls). On touch devices it
--     sits left of Roblox's jump button; it never overlaps the HUD column (top right).
--   * the phone itself, placed left of the HUD column: a dark smartphone with a status bar (company time and
--     day, decorative signal and battery), app screens (UI/Phone/PhoneScreens) and a navigation bar (back, home,
--     close). Portrait on desktops and consoles; LANDSCAPE on small screens (an iPhone held sideways), because
--     a portrait phone there would be too small to read. Its own UIScale per shape.
--   * an incoming-call banner next to the phone button (Answer / Decline) while the phone is closed.
-- The PhoneController feeds the view model (Phone.setView) and does every remote call (deps).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Kit = require(UI.Kit)
local PhoneKit = require(UI.Phone.PhoneKit)
local Screens = require(UI.Phone.PhoneScreens)

local C = Theme.colors
local F = Theme.font
local P = PhoneKit.colors

type View = Screens.View
type Deps = Screens.Deps
type Built = Screens.Built

local Phone = {}

Phone.PORTRAIT = Vector2.new(330, 640) -- design size of the portrait phone
Phone.LANDSCAPE = Vector2.new(580, 300) -- design size of the landscape phone
Phone.BUTTON = 58
Phone.HUD_WIDTH = 300 + 16 -- HUD column width + its right margin (Screens/HUD: WIDTH = 300 at offset -16)
Phone.MARGIN = 12

local gui: ScreenGui? = nil
local phoneFrame: Frame? = nil
local phoneScale: UIScale? = nil
local content: Frame? = nil
local statusTime: TextLabel? = nil
local statusDay: TextLabel? = nil
local statusBar: Frame? = nil
local navBar: Frame? = nil
local screenArea: Frame? = nil
local button: TextButton? = nil
local buttonScale: UIScale? = nil
local buttonBadge: PhoneKit.Badge? = nil
local banner: Frame? = nil
local bannerScale: UIScale? = nil
local view: View? = nil
local deps: Deps? = nil
local current: { name: string, arg: any } = { name = "home", arg = nil }
local stack: { { name: string, arg: any } } = {}
local built: Built? = nil
local builtSig = ""
local landscape = false
local open = false
local hidden = false
local bannerCall: string? = nil
local layoutInfo: { [string]: any } = {}

Phone.layoutInfo = layoutInfo -- tests: chosen shape and scales

local function playerGui(): Instance?
	local player = Players.LocalPlayer
	return if player then player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 5) else nil
end

-- the UIRoot scale of the HUD layer (read from the real HUD ScreenGui; same formula as a fallback)
local function hudScale(size: Vector2): number
	local pg = playerGui()
	local hud = pg and pg:FindFirstChild("AIEmpire_HUD")
	local root = hud and hud:FindFirstChild("Root")
	local s = root and root:FindFirstChildOfClass("UIScale")
	if s then return s.Scale end
	if size.X &lt;= 0 or size.Y &lt;= 0 then return 1 end
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.3, 1.25)
end

-- Roblox's touch jump button (PlayerModule TouchGui) in this gui's coordinates: (left x, top y, height) or nil
local function jumpButton(g: ScreenGui): (number?, number?, number?)
	local pg = playerGui()
	local touch = pg and pg:FindFirstChild("TouchGui")
	local frame = touch and touch:FindFirstChild("TouchControlFrame")
	local jump = frame and frame:FindFirstChild("JumpButton")
	if jump and jump:IsA("GuiObject") and jump.Visible then
		return jump.AbsolutePosition.X - g.AbsolutePosition.X, jump.AbsolutePosition.Y - g.AbsolutePosition.Y, jump.AbsoluteSize.Y
	end
	return nil, nil, nil
end

local function touchLayout(): boolean
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

------------------------------------------------------------------------------------------------ layout
local function applyLayout()
	local g = gui
	local frame, scale = phoneFrame, phoneScale
	if not g or not frame or not scale then return end
	local size = g.AbsoluteSize
	if size.X &lt;= 0 or size.Y &lt;= 0 then return end
	local hs = hudScale(size)
	local hudW = Phone.HUD_WIDTH * hs
	local m = Phone.MARGIN
	-- phone button: bottom right; on touch screens left of the jump button
	local bs = math.clamp(hs * 1.3, 0.8, 1.15)
	local bpx = Phone.BUTTON * bs
	local right, bottom = m + 4, m + 4
	if touchLayout() then
		local jx, jy, jh = jumpButton(g)
		if jx and jy and jh then
			right = math.max(m, size.X - jx + 10)
			bottom = math.max(m, size.Y - (jy + jh * 0.5 + bpx * 0.5)) -- level with the jump button's centre
		else
			local small = math.min(size.X, size.Y) &lt;= 500
			right = if small then 95 + 10 else 170 + 12 -- PlayerModule TouchJump: x = W - 1.5 * size + 10
			bottom = m
		end
	end
	if buttonScale and button then
		buttonScale.Scale = bs
		button.Position = UDim2.new(1, -right, 1, -bottom)
	end
	if bannerScale and banner then
		bannerScale.Scale = bs
		banner.Position = UDim2.new(1, -(right + bpx + 10), 1, -bottom)
	end
	-- the phone: left of the HUD column, portrait when it is readable, otherwise landscape
	local availW, availH = size.X - hudW - 2 * m, size.Y - 2 * m
	local pw, ph = Phone.PORTRAIT.X, Phone.PORTRAIT.Y
	local lw, lh = Phone.LANDSCAPE.X, Phone.LANDSCAPE.Y
	local sp = math.min(availH / ph, availW / pw, 1.15)
	local shapeLandscape = sp &lt; 0.78
	local s = sp
	local rightEdge = hudW + m
	if shapeLandscape then
		s = math.min(availH / lh, availW / lw, 1.15)
		if s &lt; 0.7 then -- very narrow: use the full width (the HUD column is only covered while the phone is open)
			s = math.min(availH / lh, (size.X - 2 * m) / lw, 1.15)
			rightEdge = m
		end
	end
	s = math.max(0.45, s)
	layoutInfo.landscape = shapeLandscape
	layoutInfo.scale = s
	layoutInfo.hudScale = hs
	layoutInfo.buttonScale = bs
	layoutInfo.rightEdge = rightEdge
	scale.Scale = s
	frame.Size = UDim2.fromOffset(if shapeLandscape then lw else pw, if shapeLandscape then lh else ph)
	frame.Position = UDim2.new(1, -rightEdge, 1, -m)
	if shapeLandscape ~= landscape then
		landscape = shapeLandscape
		builtSig = "" -- rebuild the screen in the new shape
		if open then Phone.render(true) end
	end
	-- chrome sizes per shape
	local sb, nb = statusBar, navBar
	if sb and nb and screenArea and content then
		local barH = if landscape then 22 else 30
		local navH = if landscape then 28 else 36
		sb.Size = UDim2.new(1, 0, 0, barH)
		nb.Size = UDim2.new(1, 0, 0, navH)
		content.Size = UDim2.new(1, 0, 1, -(barH + navH))
		content.Position = UDim2.fromOffset(0, barH)
	end
end
Phone.layout = applyLayout

------------------------------------------------------------------------------------------------ screens
local function clearContent()
	local c = content
	if not c then return end
	for _, child in c:GetChildren() do child:Destroy() end
end

local function ctxFor(): Screens.Ctx?
	local c, v, d = content, view, deps
	if not c or not v or not d then return nil end
	return {
		view = v,
		deps = d,
		go = function(name: string, arg: any?) Phone.go(name, arg) end,
		back = function() Phone.back() end,
		content = c,
		landscape = landscape,
	}
end

-- (re)build the current screen; force = always rebuild
function Phone.render(force: boolean?)
	local ctx = ctxFor()
	if not ctx then return end
	local builder = (Screens :: any)[current.name]
	if typeof(builder) ~= "function" then current = { name = "home", arg = nil }; builder = Screens.home end
	if not force and built then
		local b = built :: Built
		local sig = b.sig(ctx.view)
		if sig == builtSig then
			if b.live then b.live(ctx.view) end -- cheap in-place updates (clock text)
			return
		end
		if b.update then
			b.update(ctx.view)
			builtSig = sig
			return
		end
	end
	-- keep the scroll position of a list that is rebuilt in place
	local keep: Vector2? = nil
	local c = content
	local old = c and c:FindFirstChild("Body")
	if not force and old and old:IsA("ScrollingFrame") then keep = old.CanvasPosition end
	clearContent()
	local result: Built = builder(ctx, current.arg)
	built = result
	builtSig = result.sig(ctx.view)
	local body = c and c:FindFirstChild("Body")
	if keep and body and body:IsA("ScrollingFrame") then body.CanvasPosition = keep end
end

function Phone.go(name: string, arg: any?)
	if current.name ~= name or current.arg ~= arg then
		table.insert(stack, current)
		while #stack &gt; 12 do table.remove(stack, 1) end
	end
	current = { name = name, arg = arg }
	if name == "home" then table.clear(stack) end
	Phone.render(true)
end

function Phone.back()
	local prev = table.remove(stack)
	if not prev then
		if current.name == "home" then Phone.close() return end
		prev = { name = "home", arg = nil }
	end
	current = prev :: any
	Phone.render(true)
end

function Phone.screen(): (string, any)
	return current.name, current.arg
end

------------------------------------------------------------------------------------------------ open / close
local function refreshBadge()
	local v = view
	if buttonBadge and v then (buttonBadge :: PhoneKit.Badge).set(v.unread + v.missed) end
end

local function updateVisibility()
	if button then (button :: TextButton).Visible = not hidden end
	if phoneFrame then (phoneFrame :: Frame).Visible = open and not hidden end
	if banner then (banner :: Frame).Visible = bannerCall ~= nil and not open and not hidden end
end

function Phone.isOpen(): boolean
	return open
end

function Phone.open(name: string?, arg: any?)
	if hidden or not view then return end
	local d = deps
	if d then d.refresh() end -- fresh calendar and model list (setView does not render while closed)
	open = true
	Phone.hideBanner()
	applyLayout()
	updateVisibility()
	if name then
		table.clear(stack)
		if name ~= "home" then table.insert(stack, { name = "home", arg = nil }) end
		current = { name = name, arg = arg }
	end
	Phone.render(true)
end

function Phone.close()
	if not open then return end
	open = false
	if UserInputService.GamepadEnabled and GuiService.SelectedObject and phoneFrame and GuiService.SelectedObject:IsDescendantOf(phoneFrame :: Frame) then
		GuiService.SelectedObject = nil
	end
	local c = content
	local box = c and c:FindFirstChild("ChatInput", true)
	if box and box:IsA("TextBox") and box:IsFocused() then box:ReleaseFocus() end
	updateVisibility()
end

function Phone.toggle()
	if open then Phone.close() else Phone.open() end
end

-- hide everything (Computer open, intro, no company); closes the phone
function Phone.setHidden(value: boolean)
	if hidden == value then return end
	hidden = value
	if value then Phone.close() end
	updateVisibility()
end

function Phone.isHidden(): boolean
	return hidden
end

-- new data from the controller: badges, status bar, the open screen when its data changed
function Phone.setView(v: View)
	view = v
	refreshBadge()
	if statusTime then (statusTime :: TextLabel).Text = v.status end
	if statusDay then (statusDay :: TextLabel).Text = v.dayText end
	if open then Phone.render(false) end
end

------------------------------------------------------------------------------------------------ incoming call banner
function Phone.hideBanner()
	bannerCall = nil
	local b = banner
	if b then
		for _, child in b:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
	end
	updateVisibility()
end

-- show a ringing call: the call screen when the phone is open, else the banner next to the phone button
function Phone.incoming(call: any)
	if open then
		Phone.go("call", call.id)
		return
	end
	local b = banner
	if not b or hidden then return end
	Phone.hideBanner()
	bannerCall = call.id
	local card = Kit.frame(b, UDim2.fromScale(1, 1))
	card.Name = "Card"
	card.BackgroundTransparency = 0.02
	card.BackgroundColor3 = P.card
	Kit.corner(card, 16)
	Kit.stroke(card, 0.8)
	local av = PhoneKit.avatar(card, string.sub(tostring(call.from), 1, 1), PhoneKit.senderColor(tostring(call.from)), 40)
	av.Position = UDim2.new(0, 10, 0.5, -20)
	local who = Kit.text(card, tostring(call.from) .. " is calling", 13, F.medium, C.muted)
	who.Position = UDim2.fromOffset(60, 9)
	local title = Kit.text(card, tostring(call.title), 15, F.bold, C.text)
	title.Name = "Title"
	title.AutomaticSize = Enum.AutomaticSize.None
	title.Size = UDim2.new(1, -172, 0, 20)
	title.Position = UDim2.fromOffset(60, 29)
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local function round(name: string, color: Color3, x: number, cross: boolean): TextButton
		local r = PhoneKit.tap(card, UDim2.fromOffset(42, 42), UDim2.new(1, x, 0.5, 0))
		r.Name = name
		r.AnchorPoint = Vector2.new(1, 0.5)
		r.BackgroundTransparency = 0
		r.BackgroundColor3 = color
		r.Selectable = true
		Kit.corner(r, 21)
		if cross then
			local t = Kit.text(r, "×", 28, F.bold, C.white)
			t.AutomaticSize = Enum.AutomaticSize.None
			t.Size = UDim2.fromScale(1, 1)
			t.TextXAlignment = Enum.TextXAlignment.Center
		else
			local g = PhoneKit.glyph(r, "calls", 24)
			g.AnchorPoint = Vector2.new(0.5, 0.5)
			g.Position = UDim2.fromScale(0.5, 0.5)
		end
		return r
	end
	local decline = round("Decline", P.decline, -62, true)
	local answer = round("Answer", P.accept, -12, false)
	local id = call.id
	Kit.onClick(answer, function()
		Phone.hideBanner()
		Phone.open("call", id)
	end)
	Kit.onClick(decline, function()
		Phone.hideBanner()
		local d = deps
		if d then d.answer(id, "decline") end
	end)
	updateVisibility()
	local ring = tonumber(call.ring) or 25
	task.delay(ring, function()
		if bannerCall == id then Phone.hideBanner() end
	end)
end

function Phone.bannerCall(): string?
	return bannerCall
end

------------------------------------------------------------------------------------------------ mount
local function chromeButton(parent: Instance, name: string, text: string, size: number, x: UDim): TextButton
	local b = PhoneKit.tap(parent, UDim2.new(0, 64, 1, 0), UDim2.new(x, UDim.new(0, 0)))
	b.Name = name
	b.AnchorPoint = Vector2.new(0.5, 0)
	b.Selectable = true
	local t = Kit.text(b, text, size, F.bold, C.muted)
	t.AutomaticSize = Enum.AutomaticSize.None
	t.Size = UDim2.fromScale(1, 1)
	t.TextXAlignment = Enum.TextXAlignment.Center
	return b
end

function Phone.mount(parent: Instance, d: Deps)
	deps = d
	local old = parent:FindFirstChild("AIEmpire_Phone")
	if old then old:Destroy() end
	local g = Instance.new("ScreenGui")
	g.Name = "AIEmpire_Phone"
	g.ResetOnSpawn = false
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	g.DisplayOrder = 15 -- above the HUD (10), below the Computer (19/20) and the talk panels (41/42)
	g.Parent = parent
	gui = g

	-- phone button
	local b = PhoneKit.tap(g, UDim2.fromOffset(Phone.BUTTON, Phone.BUTTON))
	b.Name = "PhoneButton"
	b.AnchorPoint = Vector2.new(1, 1)
	b.BackgroundTransparency = 0.02
	b.BackgroundColor3 = P.card
	b.Selectable = true
	Kit.corner(b, 18)
	Kit.stroke(b, 0.78)
	local bs = Instance.new("UIScale")
	bs.Parent = b
	buttonScale = bs
	local icon = Kit.frame(b, UDim2.fromOffset(40, 40), UDim2.fromScale(0.5, 0.5))
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.BackgroundTransparency = 0
	Theme.bindAccent(icon, "BackgroundColor3")
	Kit.corner(icon, 12)
	local ig = PhoneKit.glyph(icon, "calls", 24, P.screen)
	ig.AnchorPoint = Vector2.new(0.5, 0.5)
	ig.Position = UDim2.fromScale(0.5, 0.5)
	buttonBadge = PhoneKit.badge(b, 22)
	if UserInputService.KeyboardEnabled then
		local key = Kit.text(b, "P", 11, F.bold, C.dim)
		key.AnchorPoint = Vector2.new(0.5, 1)
		key.Position = UDim2.new(0.5, 0, 1, -1)
		key.Name = "Key"
	end
	Kit.onClick(b, Phone.toggle)
	button = b

	-- incoming call banner (left of the button)
	local bn = Kit.frame(g, UDim2.fromOffset(380, 64))
	bn.Name = "CallBanner"
	bn.AnchorPoint = Vector2.new(1, 1)
	bn.Visible = false
	local bns = Instance.new("UIScale")
	bns.Parent = bn
	banner = bn
	bannerScale = bns

	-- the phone
	local frame = Kit.frame(g, UDim2.fromOffset(Phone.PORTRAIT.X, Phone.PORTRAIT.Y))
	frame.Name = "PhoneFrame"
	frame.AnchorPoint = Vector2.new(1, 1)
	frame.Visible = false
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = P.bezel
	frame.Active = true
	Kit.corner(frame, 40)
	Kit.stroke(frame, 0.55, Color3.fromRGB(70, 78, 82), 2)
	local ps = Instance.new("UIScale")
	ps.Parent = frame
	phoneFrame, phoneScale = frame, ps
	-- swallow taps on the phone body (no camera turn underneath)
	local sink = PhoneKit.tap(frame)
	sink.Name = "Sink"
	sink.Selectable = false
	local screen = Kit.frame(frame, UDim2.new(1, -16, 1, -16), UDim2.fromOffset(8, 8))
	screen.Name = "Screen"
	screen.BackgroundTransparency = 0
	screen.BackgroundColor3 = P.screen
	screen.ClipsDescendants = true
	Kit.corner(screen, 32)
	screenArea = screen
	-- wallpaper: a soft accent glow at the top
	local glow = Kit.frame(screen, UDim2.new(1, 0, 0.55, 0))
	glow.Name = "Wallpaper"
	glow.BackgroundTransparency = 0.55
	Theme.bindAccent(glow, "BackgroundColor3", Theme.darker(0.45))
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	grad.Parent = glow
	-- status bar: time · notch · day + signal + battery
	local sb = Kit.frame(screen, UDim2.new(1, 0, 0, 30))
	sb.Name = "StatusBar"
	statusBar = sb
	local tl = Kit.text(sb, "--:--", 14, F.bold, C.text)
	tl.Name = "Time"
	tl.AnchorPoint = Vector2.new(0, 0.5)
	tl.Position = UDim2.new(0, 22, 0.5, 1)
	statusTime = tl
	local notch = Kit.frame(sb, UDim2.fromOffset(84, 20), UDim2.new(0.5, 0, 0, 5))
	notch.Name = "Notch"
	notch.AnchorPoint = Vector2.new(0.5, 0)
	notch.BackgroundTransparency = 0
	notch.BackgroundColor3 = P.bezel
	Kit.corner(notch, 10)
	local rightBox = Kit.frame(sb, UDim2.fromOffset(120, 20), UDim2.new(1, -18, 0.5, 1))
	rightBox.AnchorPoint = Vector2.new(1, 0.5)
	local rl = Kit.list(rightBox, 5, true)
	rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	local dl = Kit.text(rightBox, "", 12, F.bold, C.muted)
	dl.Name = "Day"
	dl.LayoutOrder = 1
	statusDay = dl
	PhoneKit.glyph(rightBox, "signal", 14, C.text).LayoutOrder = 2
	PhoneKit.glyph(rightBox, "battery", 20, C.text).LayoutOrder = 3
	-- content
	local c = Kit.frame(screen, UDim2.new(1, 0, 1, -66), UDim2.fromOffset(0, 30))
	c.Name = "Content"
	c.ClipsDescendants = true
	content = c
	-- navigation bar: back · home · close
	local nb = Kit.frame(screen, UDim2.new(1, 0, 0, 36), UDim2.fromScale(0, 1))
	nb.Name = "NavBar"
	nb.AnchorPoint = Vector2.new(0, 1)
	navBar = nb
	local back = chromeButton(nb, "NavBack", "‹", 26, UDim.new(0.2, 0))
	Kit.onClick(back, Phone.back)
	local home = PhoneKit.tap(nb, UDim2.new(0, 96, 1, 0), UDim2.fromScale(0.5, 0))
	home.Name = "NavHome"
	home.AnchorPoint = Vector2.new(0.5, 0)
	home.Selectable = true
	local pill = Kit.frame(home, UDim2.fromOffset(84, 5), UDim2.fromScale(0.5, 0.5))
	pill.AnchorPoint = Vector2.new(0.5, 0.5)
	pill.BackgroundTransparency = 0.1
	pill.BackgroundColor3 = C.text
	Kit.corner(pill, 3)
	Kit.onClick(home, function() Phone.go("home") end)
	local close = chromeButton(nb, "NavClose", "×", 24, UDim.new(0.8, 0))
	Kit.onClick(close, Phone.close)

	g:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyLayout)
	applyLayout()
	updateVisibility()
end

function Phone.gui(): ScreenGui?
	return gui
end

return Phone
