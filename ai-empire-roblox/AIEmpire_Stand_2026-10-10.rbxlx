-- B1 · Energy &amp; plant room (operations post 11)
---------------------------------------------------------------------------------------------
local function plantRoom(r: R)
	for i = 0, 4 do
		local s = at(r, -92 + i * 2.5, 79.5, "S")
		box(r, "Switchgear", V3(2.45, 7.6, 2.6), s * CF(0, 3.8, -1.3), C.plasterShade, M.metal)
		box(r, "SwitchgearMeter", V3(1.0, 0.7, 0.05), s * CF(0, 5.8, -2.63), C.screen, M.smooth, DETAIL)
		box(r, "SwitchgearHandle", V3(0.15, 1.0, 0.15), s * CF(0.8, 3.6, -2.68), C.metal, M.metal, DETAIL)
	end
	for i = 0, 2 do
		local b = at(r, -91 + i * 3.8, 64.5, "N")
		box(r, "BatteryCabinet", V3(3.6, 6.4, 2.4), b * CF(0, 3.2, -1.2), C.fabricCharcoal, M.metal)
		box(r, "CabinetLED", V3(0.6, 0.15, 0.05), b * CF(1.2, 5.6, -2.43), C.statusGood, M.neon, DETAIL)
	end
	for i = 1, 3 do
		Kit.serverRack(r.m, r.cf, at(r, -60.5, 65.5 + i * 2, "W"), r.seed + i, nil, { variant = "network", index = 0, trayY = 9.4, name = "NetworkRack" })
	end
	box(r, "FibreTray", V3(1.4, 0.35, 8), pt(r, -59.7, 9.575, 69.5), C.statusBusy, M.smooth)
	strut(r, -61, -58.6, r.y + 9.3, 69.5, r.ceil)
	-- building management console
	local bms = at(r, -66, 79.5, "S")
	local scr = box(r, "BMSPanel", V3(4.2, 2.6, 0.2), bms * CF(0, 5.4, -0.1), C.screen, M.smooth)
	label(scr, "BMS · PLANT STATUS\nChillers OK · UPS OK · Generator standby", { color = C.statusGood, light = 0, align = "left" })
	box(r, "BMSDesk", V3(4.4, 0.2, 1.8), bms * CF(0, 3.6, -0.9), C.metalSoft, M.metal)
	box(r, "BMSDeskBody", V3(4.0, 3.5, 1.4), bms * CF(0, 1.75, -0.7), C.metal, M.metal)
	-- facilities (post 11): BMS console, switchgear round, battery cabinets
	opsPost(r, 11, V3(-66, 0, 75.6), V3(-66, 0, 79.5), nil, {
		jp("bms", V3(-66, 0, 75.6), V3(-66, 0, 79.5)),
		jp("switchgear", V3(-87, 0, 74.4), V3(-87, 0, 77)),
		jp("batteries", V3(-87.2, 0, 69.4), V3(-87.2, 0, 66.9)),
	})
	cyl(r, "ChilledWaterFlow", "x", 35, 0.9, pt(r, -76, 11.2, 71), C.blue, M.metal)
	cyl(r, "ChilledWaterReturn", "x", 35, 0.9, pt(r, -76, 11.2, 72.6), C.blueSoft, M.metal)
	for _, x in { -88, -64 } do
		strut(r, x - 0.4, x + 0.4, r.y + 10.6, 71.8, r.ceil)
	end
	plate(r, "WarningSign", 3.0, 1.3, at(r, -93.5, 70, "E") * CF(0, 8.2, -0.06), "DANGER\n11 kV SWITCHGEAR", C.statusBusy, C.screen)
	plate(r, "PlantSign", 4.6, 0.9, at(r, -84, 64.5, "N") * CF(0, 9.4, -0.06), "ENERGY &amp; PLANT · TECHNICAL STAFF", C.metal, C.white)
end

---------------------------------------------------------------------------------------------
-- B1 · Fleet office (desk station + operations post 12)
---------------------------------------------------------------------------------------------
local function fleetOffice(r: R)
	Kit.station(r.m, r.cf, r.room.id .. "_Desk1", "operations", nil, at(r, 27.5, 61.0, "S"), r.level, "ldesk", r.owner, r.accent, "campus", "fleet", r.room.access, r.room.id)
	local dAt = at(r, 36.5, 61.0, "S")
	local _, topY = Kit.desk(r.m, r.cf, dAt, "bench", r.seed + 1)
	box(r, "Monitor", V3(3.2, 1.9, 0.12), dAt * CF(0, topY + 1.35, 0.85), C.screen, M.smooth)
	local seat = opsChair(r, dAt * CF(0, 0, -2.9) * ANG(0, PI, 0), r.seed + 2)
	-- fleet (post 12): desk, key cabinet, and charging the parked company EVs in bays 02 / 04
	-- (points "ev2" / "ev4" lie in the garage: reached by navigation through the office door)
	opsPost(r, 12, V3(39.3, 0, 57.6), V3(36.5, 0, 61), seat, {
		jp("keys", V3(25.9, 0, 49), V3(22.5, 0, 49)),
		jp("ev2", V3(2.2, 0, -60.4), V3(1.3, 0, -63.5), "EVCharger2"),
		jp("ev4", V3(23.4, 0, -60.4), V3(22.5, 0, -63.5), "EVCharger4"),
	})
	Kit.cabinet(r.m, r.cf, at(r, 22.5, 49, "E"), 3, 6, r.seed + 3)
	plate(r, "KeySign", 2.6, 0.6, at(r, 22.5, 49, "E") * CF(0, 6.6, -0.06), "FLEET KEYS", C.metal, C.white)
	Kit.tvScreen(r.m, r.cf, at(r, 22.5, 55.5, "E"), 6, "fleet", r.accent, { name = "FleetScreen" })
	Kit.loungeChair(r.m, r.cf, at(r, 42, 47.6, "W"), r.seed + 4)
	Kit.loungeChair(r.m, r.cf, at(r, 42, 51.6, "W"), r.seed + 5)
	Kit.plant(r.m, r.cf, at(r, 44.4, 62.2), "m", r.seed + 6)
end

---------------------------------------------------------------------------------------------
-- B1 · Workshop (operations post 5)
---------------------------------------------------------------------------------------------
local function workshop(r: R)
	-- two-post car lift (PropFx slider): the car rests on the arms just off the floor and is raised
	-- 2.9 studs while the mechanic inspects it; everything that moves is non-colliding
	local lift = Kit.propModel(r.m, r.cf, "CarLift", pt(r, 30, 0, 72))
	local MOVE: Kit.Opts = { canCollide = false, castShadow = true }
	local function moving(p: BasePart)
		p:SetAttribute("FxMove", true)
	end
	local liftPost: BasePart? = nil
	for _, x in { 24.5, 35.5 } do
		local post = Kit.part(lift, r.cf, "LiftPost", V3(1.2, 11, 1.2), pt(r, x, 5.5, 72), C.blue, M.metal)
		if x &gt; 30 then
			liftPost = post
		end
		Kit.part(lift, r.cf, "LiftFoot", V3(2.2, 0.2, 2.2), pt(r, x, 0.1, 72), C.metal, M.metal)
		for _, dz in { -1, 1 } do
			moving(Kit.part(lift, r.cf, "LiftArm", V3(4.2, 0.3, 0.5), pt(r, x + (if x &lt; 30 then 2.0 else -2.0), 1.0, 72 + dz * 2.6) * ANG(0, dz * (if x &lt; 30 then -0.4 else 0.4), 0), C.metalSoft, M.metal, MOVE))
		end
	end
	Kit.part(lift, r.cf, "LiftCrossbar", V3(12.2, 0.6, 0.8), pt(r, 30, 11.3, 72), C.blue, M.metal)
	moving(Kit.part(lift, r.cf, "CarBody", V3(6.4, 1.8, 12), pt(r, 30, 2.1, 72), C.blueSoft, M.smooth, MOVE))
	moving(Kit.part(lift, r.cf, "CarRoof", V3(5.6, 1.4, 6), pt(r, 30, 3.7, 72.5), C.blueSoft, M.smooth, MOVE))
	moving(Kit.part(lift, r.cf, "CarGlass", V3(5.0, 1.0, 6.2), pt(r, 30, 3.7, 72.5), C.glassDeep, M.glass, { transparency = 0.3, canCollide = false, canTouch = false, canQuery = false }))
	for _, wx in { -3.25, 3.25 } do
		for _, wz in { -4, 4 } do
			moving(Kit.cylinder(lift, r.cf, "CarWheel", "x", 0.8, 2.6, pt(r, 30 + wx, 1.3, 72 + wz), C.screen, M.rubber, DETAIL))
		end
	end
	fx(lift, "slider", { FxAxis = "y", FxTravel = 2.9, FxSeconds = 14, PropId = "CarLift" })
	if liftPost then
		Kit.action(liftPost, "prop", "Car lift", "CarLift", { actionText = "Raise", maxDistance = 9 })
	end
	for _, e in { { 30, 64.9, 14, 0.25 }, { 30, 79.1, 14, 0.25 }, { 23.1, 72, 0.25, 14.2 }, { 36.9, 72, 0.25, 14.2 } } do
		box(r, "LiftBayLine", V3(e[3], 0.05, e[4]), pt(r, e[1], 0.025, e[2]), C.statusBusy, M.smooth, DETAIL)
	end
	Kit.workbench(r.m, r.cf, at(r, 54, 79.5, "S"), 8, r.seed)
	Kit.toolWall(r.m, r.cf, at(r, 61.5, 72, "W"), 6, r.seed + 1)
	Kit.rackShelf(r.m, r.cf, at(r, 61.5, 66.6, "W"), 4, r.seed + 2)
	Kit.rackShelf(r.m, r.cf, at(r, 61.5, 77.2, "W"), 4, r.seed + 3)
	-- tyres and an oil drum between the lift bay and the door route (S door x 49..59, N door x 40..46)
	for i = 0, 2 do
		cyl(r, "Tyre", "y", 0.9, 2.6, pt(r, 39.6, 0.45 + i * 0.9, 66.2), C.screen, M.rubber, DETAIL)
	end
	cyl(r, "OilDrum", "y", 3.0, 2.0, pt(r, 39.6, 1.5, 69.4), C.terracotta, M.metal)
	-- facilities / mechanic (post 5): workbench and the car on the lift
	opsPost(r, 5, V3(54, 0, 75.4), V3(54, 0, 79.5), nil, {
		jp("bench", V3(54, 0, 75.4), V3(54, 0, 79.5)),
		jp("lift", V3(38.0, 0, 74.6), V3(33, 0, 74.6), "CarLift"),
	})
end

---------------------------------------------------------------------------------------------
-- B1 · Goods-in &amp; IT storage
---------------------------------------------------------------------------------------------
local function storage(r: R)
	for _, xc in { 72, 102 } do
		for k, z in { 67.9, 76.1 } do
			Kit.shelfRack(r.m, r.cf, at(r, xc, z, if k == 1 then "N" else "S"), 16, r.seed + xc + k)
		end
	end
	-- pallet jack and an IT delivery beside the door aisle
	local pj = at(r, 81.6, 77.4, "N")
	box(r, "PalletJackForks", V3(2.0, 0.3, 4.0), pj * CF(0, 0.25, 0), C.terracotta, M.metal)
	box(r, "PalletJackHandle", V3(0.3, 3.6, 0.3), pj * CF(0, 2.0, 1.9) * ANG(math.rad(-15), 0, 0), C.metal, M.metal)
	local itp = at(r, 81.6, 67)
	box(r, "Pallet", V3(2.6, 0.4, 3.4), itp * CF(0, 0.2, 0), C.oakLight, M.wood)
	for i = 0, 2 do
		local b = box(r, "ITBox", V3(2.2, 1.2, 1.5), itp * CF(0, 1.0 + math.floor(i / 2) * 1.2, -0.8 + (i % 2) * 1.6), C.fabricSand, M.smooth)
		if i == 0 then
			label(b, "IT · LAPTOPS", { color = C.metal, light = 0.5 })
		end
	end
	plate(r, "StorageSign", 5, 0.9, at(r, 88, 79.5, "S") * CF(0, 10.6, -0.06), "GOODS-IN &amp; IT STORAGE", C.metal, C.white)
end

---------------------------------------------------------------------------------------------
-- B1 · Technical spine, lift pit, service passage
---------------------------------------------------------------------------------------------
local function spine(r: R)
	local x1, x2 = -93.5, 111.5
	local L = x2 - x1
	local xc = (x1 + x2) / 2
	box(r, "SpineCableTray", V3(L, 0.35, 1.6), pt(r, xc, 9.6, 86.2), C.metalSoft, M.metal)
	box(r, "SpineFibreTray", V3(L, 0.3, 0.9), pt(r, xc, 8.9, 86.9), C.statusBusy, M.smooth, DETAIL)
	cyl(r, "ChilledWaterFlow", "x", L, 0.9, pt(r, xc, 11.2, 87.0), C.blue, M.metal)
	cyl(r, "ChilledWaterReturn", "x", L, 0.9, pt(r, xc, 12.2, 86.0), C.blueSoft, M.metal)
	for x = -88, 108, 28 do
		local slab = Plan.levelY(0) - 1 - r.y
		box(r, "PipeBracket", V3(0.2, slab - 8.6, 2.8), pt(r, x, (8.6 + slab) / 2, 86.2), C.metal, M.metal, DETAIL)
	end
	for _, z in { 80.6, 87.3 } do
		box(r, "FloorEdgeLine", V3(L, 0.05, 0.25), pt(r, xc, 0.025, z), C.statusBusy, M.smooth, DETAIL)
	end
	plate(r, "SpineSign", 7, 1.0, at(r, -50, 87.5, "S") * CF(0, 6.8, -0.06), "TECHNICAL SERVICE SPINE · AUTHORISED STAFF", C.metal, C.white)
	plate(r, "SpineSign", 7, 1.0, at(r, 0, 87.5, "S") * CF(0, 6.8, -0.06), "←  ENERGY PLANT · UPS        WORKSHOP · STORAGE  →", C.metal, C.white)
	plate(r, "SpineSign", 7, 1.0, at(r, 60, 87.5, "S") * CF(0, 6.8, -0.06), "←  LIFT PIT · SERVICE PASSAGE · DATA HALL", C.metal, C.white)
end

local function liftPit(r: R)
	for _, sx in { -0.75, 0.75 } do
		box(r, "LadderRail", V3(0.15, 10, 0.15), pt(r, 3.5 + sx, 5, 68.45), C.statusBusy, M.metal)
	end
	for k = 1, 9 do
		box(r, "LadderRung", V3(1.5, 0.1, 0.1), pt(r, 3.5, k * 1.0, 68.45), C.metal, M.metal, DETAIL)
	end
	box(r, "PitHatch", V3(2.6, 2.6, 0.12), pt(r, 3.5, 11.4, 68.32), C.metalSoft, M.metal, DETAIL)
	local cb = at(r, -6.5, 73, "E")
	box(r, "LiftController", V3(3, 6, 1.4), cb * CF(0, 3.5, -0.7), C.plasterShade, M.metal)
	local d = box(r, "ControllerDisplay", V3(1.2, 0.6, 0.05), cb * CF(0, 5.4, -1.43), C.screen, M.smooth, DETAIL)
	label(d, "LIFT 1 · NORMAL", { color = C.statusGood, light = 0 })
	for k = 0, 6 do
		box(r, "HazardStripe", V3(1.4, 0.05, 0.7), pt(r, -5.4 + k * 1.8, 0.025, 69.0) * ANG(0, math.rad(35), 0), if k % 2 == 0 then C.statusBusy else C.screen, M.smooth, DETAIL)
	end
	plate(r, "PitSign", 4.4, 1.2, at(r, -6.5, 76.4, "E") * CF(0, 6.4, -0.06), "LIFT MACHINE ACCESS\nAUTHORISED PERSONNEL ONLY", C.statusBusy, C.screen)
end

local function servicePassage(r: R)
	for i, z in { 59.5, 64.5, 69.5 } do
		Kit.rackShelf(r.m, r.cf, at(r, 21.5, z, "W"), 4.4, r.seed + i)
	end
	for i, z in { 72.5, 77 } do
		Kit.rackShelf(r.m, r.cf, at(r, 7.5, z, "E"), 4.0, r.seed + 10 + i)
	end
	plate(r, "ServiceSign", 4.4, 1.1, at(r, 21.5, 57.4, "W") * CF(0, 6.6, -0.06), "SERVICE · AUTHORISED STAFF", C.statusBusy, C.screen)
	box(r, "CableTray", V3(1.4, 0.35, 25), pt(r, 19.4, 9.6, 67), C.metalSoft, M.metal)
	strut(r, 18.4, 21.4, r.y + 9.32, 67, r.ceil)
end

---------------------------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------------------------
local KITS: { [string]: (R) -&gt; () } = {
	lobby = lobby,
	atrium = atrium,
	visitor_lounge = visitorLounge,
	showroom = showroom,
	project_meeting = projectRoom,
	compute = computeOps,
	first_ai = firstAI,
	itdesk = itDesk,
	cafe = cafe,
	kitchen_boh = kitchenBoh,
	delivery = delivery,
	mailroom = mailroom,
	datahall = dataHall,
	garage = garage,
	b1_lobby = b1Lobby,
	ups = upsRoom,
	plant = plantRoom,
	fleet = fleetOffice,
	workshop = workshop,
	storage = storage,
	spine = spine,
	liftpit = liftPit,
	service_passage = servicePassage,
}
-- Build order: the G showcase racks come first so PlotService lights them before the data hall.
local ORDER = { "lobby", "atrium", "visitor_lounge", "showroom", "project_meeting", "compute", "first_ai", "itdesk", "cafe", "kitchen_boh", "delivery", "mailroom", "datahall", "garage", "b1_lobby", "ups", "plant", "fleet", "workshop", "storage", "spine", "liftpit", "service_passage" }
Special.KINDS = ORDER

local function roomModel(ctx: any, room: Room): Model
	local existing = ctx.rooms[room.id]
	if existing then
		return existing
	end
	local m = Kit.model(ctx.folders.Rooms, room.id, true)
	m:SetAttribute("RoomId", room.id)
	m:SetAttribute("RoomName", room.name)
	m:SetAttribute("RoomKind", room.kind)
	m:SetAttribute("Level", room.level)
	m:SetAttribute("AccessClass", room.access)
	ctx.rooms[room.id] = m
	return m
end

function Special.build(ctx: any)
	local rank: { [string]: number } = {}
	for i, kind in ORDER do
		rank[kind] = i
	end
	local list: { Room } = {}
	for _, room in Plan.rooms(ctx.tier) do
		if KITS[room.kind] then
			table.insert(list, room)
		end
	end
	table.sort(list, function(a: Room, b: Room): boolean
		if rank[a.kind] ~= rank[b.kind] then
			return rank[a.kind] &lt; rank[b.kind]
		end
		return a.id &lt; b.id
	end)
	local shared: Shared = { blade = 0, lunch = 0 }
	for _, room in list do
		local fit = Kit.model(roomModel(ctx, room), "Fitout")
		local levelY = Plan.levelY(room.level)
		local r: R = {
			ctx = ctx,
			room = room,
			m = fit,
			cf = ctx.cf,
			y = levelY + Kit.FINISH,
			ceil = levelY + Kit.CEILING,
			level = room.level,
			owner = ctx.owner,
			accent = ctx.accent,
			seed = Kit.hash(room.id) % 100000,
			s = shared,
		}
		local ok, err = pcall(KITS[room.kind] :: (R) -&gt; any, r)
		if not ok then
			warn(`[RoomKitsSpecial] {room.id} ({room.kind}) failed: {err}`)
		end
	end
end

return Special
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000032"><Properties><string name="Name">RoomKitsWork</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- RoomKitsWork: furniture, fixtures, workstations, activities, screens and prompts of the work floors and
-- the founder level (SPEC §11): team rooms, studios, labs, control rooms, meeting rooms, pantries, lounges,
-- focus/phone/print rooms, restrooms, the boardroom, the founder suite and the terraces.
-- Walls, doors, floors, ceilings, lights, nameplates, cameras and access volumes come from InteriorDesign;
-- this module only adds a "FitOut" model inside ctx.rooms[room.id] (WC cubicle doors go to Office.Doors).
--
-- Every room is laid out in its own frame: origin = centre of the entry wall at finished-floor height,
-- local +Z points into the room, X runs along the entry wall (W wide) and Z spans the depth D. Kits place
-- furniture in that frame, so mirrored east/west rooms and every plot orientation come out the same.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout = require(ReplicatedStorage.Shared.BuildingLayout)
local Departments = require(ReplicatedStorage.Shared.Config.DepartmentConfig)
local Kit = require(script.Parent.ArchKit)

local Work = {}

local C, M, A = Kit.C, Kit.M, Kit.A
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local RAD = math.rad
local DETAIL: Kit.Opts = { detail = true }
local GLASS: Kit.Opts = { transparency = A.glassTransparency, castShadow = false }

local ENTRY = 6 -- free band along the entry wall (door swing + circulation)
local CR = 2.5 -- chair zone beyond the user edge of a desk (chair incl. its back)
local AISLE = 4 -- aisle between two chair rows
local WALL_AISLE = 3.6 -- aisle between a chair row and a wall
local FACADE_GAP = 2 -- furniture keeps this distance from glazed facades
local EPS = 0.01
local STRIP = 1.8 -- depth of the wall furniture along a feature wall (credenza, boards)

-- Desk pitch along a row and depth of the desk top per ArchKit station variant.
local DESK: { [string]: { p: number, dd: number, cr: number } } = {
	bench = { p = 7, dd = 3.4, cr = CR },
	ldesk = { p = 7, dd = 3.4, cr = 2.9 }, -- the return + pedestal reach 4.5 behind the desk centre
	standing = { p = 6, dd = 3.0, cr = CR },
	dual = { p = 8, dd = 3.6, cr = CR },
	lab = { p = 7, dd = 3.4, cr = CR },
	trading = { p = 13, dd = 3.3, cr = CR },
}

-- Desk monitors show the department screen, except where the room kind has its own screen kind.
local KIND_SCREEN: { [string]: string } = { support = "customers", studio = "product", platform = "platform", hr = "hr" }

-- Yaw (degrees) so that a piece's FRONT (-Z) faces a room direction: F = towards the entry wall (-z),
-- B = towards the back wall (+z), L = -x, R = +x.
local FRONT: { [string]: number } = { F = 0, B = 180, L = 90, R = -90 }
-- Yaw so that a desk user LOOKS towards a room direction (ArchKit desks: user at -Z looking +Z).
local LOOK: { [string]: number } = { B = 0, F = 180, R = 90, L = -90 }
-- Yaw of wall-mounted pieces (front towards the room) per wall side.
local WALL_YAW: { [string]: number } = { back = 0, front = 180, left = -90, right = 90 }
local INSET: { [string]: number } = { solid = 0.5, panel = 0.5, glass = 0.2, barrier = 0.15, fence = 0.25, facade = 0.6, open = 0 }
local INWARD: { [string]: Vector3 } = { S = V3(0, 0, 1), N = V3(0, 0, -1), W = V3(1, 0, 0), E = V3(-1, 0, 0) }

type Rect = { x1: number, x2: number, z1: number, z2: number }
type Box = { x1: number, x2: number, z1: number, z2: number, name: string }
type DoorL = { x: number, z: number, w: number, side: string, id: string, kind: string }
type R = {
	ctx: any,
	room: Plan.Room,
	tier: number,
	model: Model,
	cf: CFrame,
	rf: CFrame,
	W: number,
	D: number,
	level: number,
	seed: number,
	style: number,
	owner: number,
	accent: Color3,
	dept: string,
	access: string,
	face: string,
	sideFace: { [string]: string },
	side: { [string]: string },
	inner: { [string]: number },
	zEnd: number,
	doorX: number,
	doors: { DoorL },
	keep: { Box },
	boxes: { Box },
	desks: number,
	acts: number,
	issues: { string },
}

---------------------------------------------------------------------------------------------
-- Room frame, wall finishes and doors
---------------------------------------------------------------------------------------------
local function dirFace(d: Vector3): string
	if d.X &gt; 0.5 then
		return "E"
	elseif d.X &lt; -0.5 then
		return "W"
	elseif d.Z &gt; 0.5 then
		return "N"
	end
	return "S"
end

local function faceLine(room: Plan.Room, face: string): (string, number, number, number)
	if face == "N" then
		return "x", room.z2, room.x1, room.x2
	elseif face == "S" then
		return "x", room.z1, room.x1, room.x2
	elseif face == "E" then
		return "z", room.x2, room.z1, room.z2
	end
	return "z", room.x1, room.z1, room.z2
end

-- Envelope lines (facades built by the exterior generator) at this level.
local function envelope(tier: number, level: number, axis: string, c: number): boolean
	if level &gt;= Plan.roofLevel(tier) or level &lt; 0 then
		return false
	end
	local m = Plan.MAIN
	if axis == "z" then
		return math.abs(c - m.x1) &lt; EPS or math.abs(c - m.x2) &lt; EPS
	end
	local front = if level == Plan.founderLevel(tier) then Plan.FOUNDER_FRONT_Z else m.z1
	if math.abs(c - front) &lt; EPS or math.abs(c - m.z1) &lt; EPS then
		return true
	end
	return math.abs(c - m.z2) &lt; EPS and level &gt;= 2
end

-- Finish of the wall at point `a` of a room face: facade | solid | glass | panel | fence | barrier | open.
local function finishAt(tier: number, room: Plan.Room, face: string, a: number): string
	local axis, c = faceLine(room, face)
	if envelope(tier, room.level, axis, c) then
		return "facade"
	end
	if room.open then
		for _, f in room.open do
			if f == face then
				return "open"
			end
		end
	end
	for _, w in Layout.walls(tier, room.level) do
		if w.axis == axis and math.abs(w.c - c) &lt; EPS and a &gt; w.a1 - EPS and a &lt; w.a2 + EPS then
			return w.finish
		end
	end
	-- the lift shaft / riser walls are built by the core generator
	local s, r = Plan.SHAFT, Plan.RISER
	if axis == "z" and (math.abs(c - s.x1) &lt; EPS or math.abs(c - s.x2) &lt; EPS) and a &gt; s.z1 - EPS and a &lt; r.z2 + EPS then
		return "solid"
	end
	if axis == "x" and math.abs(c - s.z1) &lt; EPS and a &gt; s.x1 - EPS and a &lt; s.x2 + EPS then
		return "solid"
	end
	return "open"
end

local function majorityFinish(tier: number, room: Plan.Room, face: string): string
	local _, _, a1, a2 = faceLine(room, face)
	local count: { [string]: number } = {}
	local best, bestN = "open", -1
	for i = 1, 7 do
		local f = finishAt(tier, room, face, a1 + (a2 - a1) * (i - 0.5) / 7)
		count[f] = (count[f] or 0) + 1
	end
	for _, f in { "solid", "panel", "facade", "glass", "fence", "barrier", "open" } do
		if (count[f] or 0) &gt; bestN then
			best, bestN = f, count[f] or 0
		end
	end
	return best
end

local function newRoom(ctx: any, room: Plan.Room, parent: Model, face: string?): R
	local f = face or (if room.doors[1] then room.doors[1].face else "S")
	local inward = INWARD[f]
	local up = V3(0, 1, 0)
	local right = up:Cross(inward)
	local y = Plan.levelY(room.level) + (if room.outdoor then 0 else Kit.FINISH)
	local origin, W, D
	if f == "S" then
		origin, W, D = V3((room.x1 + room.x2) / 2, y, room.z1), room.x2 - room.x1, room.z2 - room.z1
	elseif f == "N" then
		origin, W, D = V3((room.x1 + room.x2) / 2, y, room.z2), room.x2 - room.x1, room.z2 - room.z1
	elseif f == "W" then
		origin, W, D = V3(room.x1, y, (room.z1 + room.z2) / 2), room.z2 - room.z1, room.x2 - room.x1
	else
		origin, W, D = V3(room.x2, y, (room.z1 + room.z2) / 2), room.z2 - room.z1, room.x2 - room.x1
	end
	local rf = CFrame.fromMatrix(origin, right, up, inward)
	local sideFace: { [string]: string } = { front = f, back = dirFace(inward), left = dirFace(-right), right = dirFace(right) }
	local side: { [string]: string } = {}
	for s, bf in sideFace do
		side[s] = if room.outdoor and not room.fence then "open" else majorityFinish(ctx.tier, room, bf)
	end
	if room.outdoor then
		-- terraces: the building face and the slab edge railing keep a gap like a facade
		side.front = "facade"
		side.back = "facade"
	end
	local inner = {
		front = INSET[side.front] or 0.5,
		back = D - (INSET[side.back] or 0.5),
		left = -W / 2 + (INSET[side.left] or 0.5),
		right = W / 2 - (INSET[side.right] or 0.5),
	}
	local r: R = {
		ctx = ctx,
		room = room,
		tier = ctx.tier,
		model = parent,
		cf = ctx.cf,
		rf = rf,
		W = W,
		D = D,
		level = room.level,
		seed = Kit.hash(room.id),
		style = room.style,
		owner = ctx.owner,
		accent = ctx.accent,
		dept = room.dept or "operations",
		access = room.access,
		face = f,
		sideFace = sideFace,
		side = side,
		inner = inner,
		zEnd = inner.back - (if side.back == "facade" then FACADE_GAP else 0.3),
		doorX = 0,
		doors = {},
		keep = {},
		boxes = {},
		desks = 0,
		acts = 0,
		issues = {},
	}
	-- every door on the room boundary (its own and the neighbours' doors opening into it)
	local primary = false
	for _, d in Layout.doors(ctx.tier) do
		if d.level ~= room.level then
			continue
		end
		local on
		if d.axis == "x" then
			on = (math.abs(d.z - room.z1) &lt; EPS or math.abs(d.z - room.z2) &lt; EPS) and d.x &gt; room.x1 - EPS and d.x &lt; room.x2 + EPS
		else
			on = (math.abs(d.x - room.x1) &lt; EPS or math.abs(d.x - room.x2) &lt; EPS) and d.z &gt; room.z1 - EPS and d.z &lt; room.z2 + EPS
		end
		if not on then
			continue
		end
		local p = rf:PointToObjectSpace(V3(d.x, y, d.z))
		local s = if math.abs(p.Z) &lt; 0.1 then "front" elseif math.abs(p.Z - D) &lt; 0.1 then "back" elseif p.X &lt; 0 then "left" else "right"
		table.insert(r.doors, { x = p.X, z = p.Z, w = d.w, side = s, id = d.id, kind = d.kind })
		local h = d.w / 2 + 1
		local box: Box
		if s == "front" then
			box = { x1 = p.X - h, x2 = p.X + h, z1 = 0, z2 = ENTRY, name = d.id }
			if not primary then
				r.doorX = p.X
				primary = true
			end
		elseif s == "back" then
			box = { x1 = p.X - h, x2 = p.X + h, z1 = D - ENTRY, z2 = D, name = d.id }
		elseif s == "left" then
			box = { x1 = -W / 2, x2 = -W / 2 + ENTRY, z1 = p.Z - h, z2 = p.Z + h, name = d.id }
		else
			box = { x1 = W / 2 - ENTRY, x2 = W / 2, z1 = p.Z - h, z2 = p.Z + h, name = d.id }
		end
		table.insert(r.keep, box)
	end
	return r
end

-- Layout bookkeeping: every floor-standing piece claims its footprint; overlaps with door zones,
-- other pieces or the walls are collected and reported once per build.
local function overlap(a: Rect, b: Rect): boolean
	return a.x1 &lt; b.x2 - 0.05 and b.x1 &lt; a.x2 - 0.05 and a.z1 &lt; b.z2 - 0.05 and b.z1 &lt; a.z2 - 0.05
end
local function claim(R: R, name: string, x1: number, x2: number, z1: number, z2: number)
	local b: Box = { x1 = math.min(x1, x2), x2 = math.max(x1, x2), z1 = math.min(z1, z2), z2 = math.max(z1, z2), name = name }
	local i = R.inner
	if b.x1 &lt; i.left - 0.05 or b.x2 &gt; i.right + 0.05 or b.z1 &lt; i.front - 0.05 or b.z2 &gt; i.back + 0.05 then
		table.insert(R.issues, string.format("%s %s outside the room", R.room.id, name))
	end
	for _, k in R.keep do
		if overlap(b, k) then
			table.insert(R.issues, string.format("%s %s in door zone %s", R.room.id, name, k.name))
		end
	end
	for _, o in R.boxes do
		if overlap(b, o) then
			table.insert(R.issues, string.format("%s %s overlaps %s", R.room.id, name, o.name))
		end
	end
	table.insert(R.boxes, b)
end
local function free(R: R, x1: number, x2: number, z1: number, z2: number): boolean
	local b: Rect = { x1 = math.min(x1, x2), x2 = math.max(x1, x2), z1 = math.min(z1, z2), z2 = math.max(z1, z2) }
	for _, k in R.keep do
		if overlap(b, k) then
			return false
		end
	end
	for _, o in R.boxes do
		if overlap(b, o) then
			return false
		end
	end
	return true
end

---------------------------------------------------------------------------------------------
-- Placement helpers (room-local -&gt; building-local)
---------------------------------------------------------------------------------------------
local function at(R: R, x: number, z: number, yaw: number?): CFrame
	return R.rf * CF(x, 0, z) * ANG(0, RAD(yaw or 0), 0)
end
local function pt(R: R, x: number, h: number, z: number): Vector3
	return R.rf:PointToWorldSpace(V3(x, h, z))
end
-- Room-local (x, z) at `dist` in front of a wall side at coordinate t along it.
local function wallPoint(R: R, side: string, t: number, dist: number): (number, number)
	if side == "back" then
		return t, R.inner.back - dist
	elseif side == "front" then
		return t, R.inner.front + dist
	elseif side == "left" then
		return R.inner.left + dist, t
	end
	return R.inner.right - dist, t
end
local function wallAt(R: R, side: string, t: number, off: number?): CFrame
	local x, z = wallPoint(R, side, t, off or 0)
	return at(R, x, z, WALL_YAW[side])
end
-- Footprint of a wall piece: width w along the wall, depth d from the wall face (+ offset).
local function wallClaim(R: R, name: string, side: string, t: number, w: number, d: number, off: number?)
	local o = off or 0
	local xa, za = wallPoint(R, side, t, o)
	local xb, zb = wallPoint(R, side, t, o + d)
	if side == "back" or side == "front" then
		claim(R, name, t - w / 2, t + w / 2, za, zb)
	else
		claim(R, name, xa, xb, t - w / 2, t + w / 2)
	end
end
local function opposite(side: string): string
	return if side == "left" then "right" elseif side == "right" then "left" elseif side == "front" then "back" else "front"
end
local function solidish(f: string): boolean
	return f == "solid" or f == "panel"
end
local function pick&lt;T&gt;(list: { T }, seed: number): T
	return Kit.pick(list, seed)
end

local function activity(R: R, kind: string, dept: string, role: string, x: number, z: number, fx: number, fz: number, seat: Seat?, extra: Kit.ActivityExtra?): Model
	R.acts += 1
	local e: Kit.ActivityExtra = extra or {}
	e.roomAccess = R.access
	e.homeRoom = R.room.id
	e.facing = pt(R, fx, 4.5, fz)
	local id = string.format("%s_%s%d", R.room.id, kind, R.acts)
	return Kit.activity(R.model, R.cf, id, kind, dept, role, CF(pt(R, x, 2.8, z)), R.level, R.owner, seat, e)
end
-- Activity standing in front of a seat (distance `d` along the sitter's view), facing the seat.
local function seatActivity(R: R, kind: string, dept: string, seat: Seat, d: number, extra: Kit.ActivityExtra?): Model
	local p = R.rf:PointToObjectSpace(R.cf:PointToObjectSpace(seat.Position))
	local look = R.rf:VectorToObjectSpace(R.cf:VectorToObjectSpace(seat.CFrame.LookVector))
	return activity(R, kind, dept, "any", p.X + look.X * d, p.Z + look.Z * d, p.X, p.Z, seat, extra)
end
local function roleOf(dept: string): string
	local d = (Departments.DEPARTMENTS :: any)[dept]
	return if d and d.role then d.role elseif dept == "compute" then "engineer" else "any"
end

---------------------------------------------------------------------------------------------
-- Workstations
---------------------------------------------------------------------------------------------
-- Decorative parts dropped (in this order) until a station meets its part budget.
local TRIM = {
	"Mouse", "ModestyPanel", "InstrumentPanel", "Flask", "Papers", "Notebook", "PhotoFrame", "Mug", "DeskPlant", "DeskPot",
	"LampHead", "LampArm", "LampFoot", "LaptopLid", "LaptopBase", "ArmRest", "PCTower", "ReagentShelf", "ShelfPost",
	"DeskFascia", "@foot", "Instrument", "@stand",
}
-- Part budget per station variant (desk + chair + monitors + keyboard).
local STATION_MAX: { [string]: number } = { bench = 10, ldesk = 11, standing = 10, dual = 10, lab = 9, trading = 12 }
-- Two crossed chair base bars -&gt; one round foot (one part less).
local function roundFoot(m: Model): boolean
	local bars: { BasePart } = {}
	for _, d in m:GetDescendants() do
		if d.Name == "ChairBase" and d:IsA("BasePart") then
			table.insert(bars, d)
		end
	end
	if #bars ~= 2 then
		return false
	end
	local p = bars[1]
	local foot = Instance.new("Part")
	foot.Name = "ChairFoot"
	foot.Shape = Enum.PartType.Cylinder
	foot.Anchored = true
	foot.CanCollide = false
	foot.CanTouch = false
	foot.CanQuery = false
	foot.CastShadow = false
	foot.Size = V3(0.3, 1.9, 1.9)
	foot.CFrame = p.CFrame * CF(0, -0.15, 0) * ANG(0, 0, math.pi / 2)
	foot.Color = p.Color
	foot.Material = p.Material
	foot.Parent = p.Parent
	bars[1]:Destroy()
	bars[2]:Destroy()
	return true
end

-- Monitors stand directly on the desk top instead of on a stand (one part less per monitor).
local function standless(m: Model, budget: number): number
	local removed = 0
	for _, d in m:GetDescendants() do
		if removed &gt;= budget then
			break
		end
		if d.Name == "MonitorStand" and d:IsA("BasePart") then
			local best: BasePart? = nil
			local dist = 3
			for _, s in m:GetDescendants() do
				if (s.Name == "DisplayContent" or s.Name == "SecondaryDisplay") and s:IsA("BasePart") then
					local gap = (s.Position - d.Position).Magnitude
					if gap &lt; dist then
						best, dist = s, gap
					end
				end
			end
			if best then
				local bottom = d.Position.Y - d.Size.Y / 2
				local drop = (best.Position.Y - best.Size.Y / 2) - bottom - 0.02
				best.CFrame = best.CFrame - Vector3.new(0, drop, 0)
			end
			d:Destroy()
			removed += 1
		end
	end
	return removed
end

local function trim(m: Model, max: number)
	local parts: { BasePart } = {}
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	local count = #parts
	local firstFascia: BasePart? = nil
	for _, p in parts do
		if p.Name == "DeskFascia" then
			firstFascia = p
			break
		end
	end
	for _, name in TRIM do
		if name == "@foot" then
			if count &gt; max and roundFoot(m) then
				count -= 1
			end
			continue
		elseif name == "@stand" then
			if count &gt; max then
				count -= standless(m, count - max)
			end
			continue
		end
		for i = #parts, 1, -1 do
			if count &lt;= max then
				return
			end
			local p = parts[i]
			if p.Name == name and p.Parent and p ~= firstFascia then
				p:Destroy()
				count -= 1
			end
		end
	end
end

local function deptInfo(dept: string): (string, string?, string, string)
	if dept == "operations" then
		return "empire", "team", "support", "hr"
	elseif dept == "executive" then
		return "empire", nil, "any", "founder"
	end
	local d = (Departments.DEPARTMENTS :: any)[dept]
	if d then
		return d.app or "market", d.section, d.role or "any", d.screen or dept
	end
	return "market", nil, "any", dept
end

local function station(R: R, x: number, z: number, yaw: number, variant: string, dept: string?): Model
	R.desks += 1
	local dp = dept or R.dept
	local app, section, role, screenKind = deptInfo(dp)
	local id = R.room.id .. "_Desk" .. R.desks
	local m = Kit.station(R.model, R.cf, id, dp, role, at(R, x, z, yaw), R.level, variant, R.owner, R.accent, app, section, R.access, R.room.id)
	local disp = m:FindFirstChild("DisplayContent")
	if disp then
		disp:SetAttribute("LiveScreen", KIND_SCREEN[R.room.kind] or screenKind)
	end
	-- stand just behind the chair line, beside the chair (on the aisle, not between desk returns)
	local g = DESK[variant] or DESK.bench
	local sideX = if variant == "ldesk" then -2.0 else 2.0
	m:SetAttribute("InteractionPosition", (R.cf * at(R, x, z, yaw) * CF(sideX, 2.8, -(g.dd / 2 + g.cr) - 0.3)).Position)
	trim(m, STATION_MAX[variant] or 12)
	return m
end

-- Desk + chair footprint of a station at (x, z) whose user looks along `yaw` (0/90/180/-90 only).
local function stationClaim(R: R, x: number, z: number, yaw: number, variant: string)
	local g = DESK[variant] or DESK.bench
	local half = g.p / 2
	local a1, a2 = -g.dd / 2 - g.cr, g.dd / 2 -- along the look axis, user side negative
	local y = ((yaw % 360) + 360) % 360
	if y &lt; 1 or y &gt; 359 then
		claim(R, "Desk", x - half, x + half, z + a1, z + a2)
	elseif math.abs(y - 180) &lt; 1 then
		claim(R, "Desk", x - half, x + half, z - a2, z - a1)
	elseif math.abs(y - 90) &lt; 1 then
		claim(R, "Desk", x + a1, x + a2, z - half, z + half)
	else
		claim(R, "Desk", x - a2, x - a1, z - half, z + half)
	end
end

---------------------------------------------------------------------------------------------
-- Desk rows: candidate arrangements across a band (singles facing a wall, back-to-back pods)
---------------------------------------------------------------------------------------------
type Row = { c: number, look: number }
type RowSet = { rows: { Row }, pods: number, slack: number }
local UNIT: { [string]: { low: boolean, high: boolean } } = {
	SL = { low = false, high = true }, -- desk front towards the low edge, chairs on the high side
	SH = { low = true, high = false }, -- chairs on the low side, users look towards the high edge
	P = { low = true, high = true }, -- back-to-back pod
}
local function rowSets(lo: number, hi: number, lowEdge: string, highEdge: string, dd: number, cr: number, slackTo: string): { RowSet }
	local out: { RowSet } = {}
	local seen: { [string]: boolean } = {}
	for _, front in { "", "SL", "SH" } do
		for np = 0, 3 do
			for _, back in { "", "SH", "SL" } do
				local units: { string } = {}
				if front ~= "" then
					table.insert(units, front)
				end
				for _ = 1, np do
					table.insert(units, "P")
				end
				if back ~= "" then
					table.insert(units, back)
				end
				local key = table.concat(units, ",")
				if #units == 0 or seen[key] then
					continue
				end
				seen[key] = true
				local bad = (units[1] == "SL" and lowEdge ~= "wall") or (units[#units] == "SH" and highEdge ~= "wall")
				for i, u in units do
					if (u == "SL" and i ~= 1) or (u == "SH" and i ~= #units) then
						bad = true
					end
				end
				if bad then
					continue
				end
				local gaps: { number } = {}
				gaps[1] = if UNIT[units[1]].low then (if lowEdge == "open" then 0 else WALL_AISLE) else (if lowEdge == "open" then 0.5 else 0.4)
				for i = 2, #units do
					gaps[i] = AISLE
				end
				gaps[#units + 1] = if UNIT[units[#units]].high then (if highEdge == "open" then 0 else WALL_AISLE) else (if highEdge == "open" then 0.5 else 0.4)
				local total = 0
				for _, u in units do
					total += if u == "P" then 2 * cr + 2 * dd else cr + dd
				end
				for _, g in gaps do
					total += g
				end
				if total &gt; hi - lo + 1e-6 then
					continue
				end
				local slack = hi - lo - total
				local spare = slack
				if #units &gt; 1 then
					local add = math.min(1.5, spare / (#units - 1))
					for i = 2, #units do
						gaps[i] += add
					end
					spare -= add * (#units - 1)
				end
				if slackTo == "high" then
					gaps[#units + 1] += spare
				elseif slackTo == "low" then
					gaps[1] += spare
				else
					gaps[1] += spare / 2
					gaps[#units + 1] += spare / 2
				end
				local rows: { Row } = {}
				local pos = lo + gaps[1]
				for i, u in units do
					if u == "SL" then
						table.insert(rows, { c = pos + dd / 2, look = -1 })
						pos += dd + cr
					elseif u == "SH" then
						table.insert(rows, { c = pos + cr + dd / 2, look = 1 })
						pos += cr + dd
					else
						table.insert(rows, { c = pos + cr + dd / 2, look = 1 })
						table.insert(rows, { c = pos + cr + dd + dd / 2, look = -1 })
						pos += 2 * cr + 2 * dd
					end
					pos += gaps[i + 1]
				end
				table.insert(out, { rows = rows, pods = np, slack = slack })
			end
		end
	end
	return out
end

type BlockPlan = { axis: string, variant: string, k: number, rows: { Row }, along1: number, along2: number, across1: number, across2: number, fw: number }
-- Rows run along `axis` ("x": parallel to the entry wall; "z": towards the back wall) inside `rect`.
local function planBlock(rect: Rect, axis: string, n: number, variant: string, lowEdge: string, highEdge: string, slackTo: string, fw: number): BlockPlan?
	local g = DESK[variant] or DESK.bench
	local al1, al2, ac1, ac2
	if axis == "x" then
		al1, al2, ac1, ac2 = rect.x1, rect.x2, rect.z1, rect.z2
	else
		al1, al2, ac1, ac2 = rect.z1, rect.z2, rect.x1, rect.x2
	end
	local k = math.floor((al2 - al1 + 1e-6) / g.p)
	if k &lt; 1 then
		return nil
	end
	local best: RowSet? = nil
	for _, s in rowSets(ac1, ac2, lowEdge, highEdge, g.dd, g.cr, slackTo) do
		if #s.rows * k &gt;= n then
			if not best or #s.rows &lt; #best.rows or (#s.rows == #best.rows and (s.pods &gt; best.pods or (s.pods == best.pods and s.slack &gt; best.slack))) then
				best = s
			end
		end
	end
	if not best then
		return nil
	end
	return { axis = axis, variant = variant, k = k, rows = best.rows, along1 = al1, along2 = al2, across1 = ac1, across2 = ac2, fw = fw }
end

-- Places the stations of a plan. Partial rows are pushed to `alignEnd` (-1 low / +1 high / 0 centre).
-- Returns the free rectangles left in partial rows and behind the last row (for kit furniture).
local function placeBlock(R: R, plan: BlockPlan, n: number, alignEnd: number): { Rect }
	local g = DESK[plan.variant] or DESK.bench
	local freeRects: { Rect } = {}
	local remaining = n
	local maxFoot, minFoot = -math.huge, math.huge
	local function rect(a1: number, a2: number, c1: number, c2: number): Rect
		if plan.axis == "x" then
			return { x1 = a1, x2 = a2, z1 = c1, z2 = c2 }
		end
		return { x1 = c1, x2 = c2, z1 = a1, z2 = a2 }
	end
	for _, row in plan.rows do
		local m = math.min(plan.k, remaining)
		remaining -= m
		local f1 = if row.look &gt; 0 then row.c - g.dd / 2 - g.cr else row.c - g.dd / 2
		local f2 = if row.look &gt; 0 then row.c + g.dd / 2 else row.c + g.dd / 2 + g.cr
		maxFoot, minFoot = math.max(maxFoot, f2), math.min(minFoot, f1)
		local span = m * g.p
		local start
		if alignEnd &lt; 0 then
			start = plan.along1
		elseif alignEnd &gt; 0 then
			start = plan.along2 - span
		else
			start = (plan.along1 + plan.along2) / 2 - span / 2
		end
		for j = 0, m - 1 do
			local s = start + g.p / 2 + j * g.p
			local x, z, yaw
			if plan.axis == "x" then
				x, z, yaw = s, row.c, if row.look &gt; 0 then LOOK.B else LOOK.F
			else
				x, z, yaw = row.c, s, if row.look &gt; 0 then LOOK.R else LOOK.L
			end
			station(R, x, z, yaw, plan.variant)
			stationClaim(R, x, z, yaw, plan.variant)
		end
		-- free part of the row
		if m &lt; plan.k then
			if start - plan.along1 &gt; 3 then
				table.insert(freeRects, rect(plan.along1, start - 0.3, f1, f2))
			end
			if plan.along2 - (start + span) &gt; 3 then
				table.insert(freeRects, rect(start + span + 0.3, plan.along2, f1, f2))
			end
		end
	end
	if plan.across2 - maxFoot &gt; WALL_AISLE + 3 then
		table.insert(freeRects, rect(plan.along1, plan.along2, maxFoot + WALL_AISLE, plan.across2))
	end
	if minFoot - plan.across1 &gt; WALL_AISLE + 3 then
		table.insert(freeRects, rect(plan.along1, plan.along2, plan.across1, minFoot - WALL_AISLE))
	end
	return freeRects
end

-- Takes a w x d footprint out of the free rectangles (either orientation, pushed towards the back);
-- returns its centre and whether it is turned (long side along z).
local function takeFree(R: R, rects: { Rect }, w: number, d: number): (number?, number?, boolean)
	for i, r in rects do
		local rw, rd = r.x2 - r.x1, r.z2 - r.z1
		for _, turned in { false, true } do
			local fw, fd = if turned then d else w, if turned then w else d
			if fw &lt;= rw + 1e-6 and fd &lt;= rd + 1e-6 then
				local cx = r.x1 + fw / 2 + (rw - fw) / 2
				local cz = r.z2 - fd / 2
				if not free(R, cx - fw / 2, cx + fw / 2, cz - fd / 2, cz + fd / 2) then
					continue
				end
				-- shrink the rectangle along its longer side
				if rw - fw &gt;= rd - fd then
					rects[i] = { x1 = r.x1, x2 = r.x1 + (rw - fw) / 2 - 0.5, z1 = r.z1, z2 = r.z2 }
					table.insert(rects, { x1 = cx + fw / 2 + 0.5, x2 = r.x2, z1 = r.z1, z2 = r.z2 })
				else
					rects[i] = { x1 = r.x1, x2 = r.x2, z1 = r.z1, z2 = cz - fd / 2 - 0.5 }
				end
				return cx, cz, turned
			end
		end
	end
	return nil, nil, false
end

---------------------------------------------------------------------------------------------
-- Shared furniture pieces (local builders on top of ArchKit)
---------------------------------------------------------------------------------------------
-- Plant size that varies by room style (small plants keep the part budget).
local function deco(R: R): string
	return if R.style % 2 == 0 then "m" else "s"
end

local function plant(R: R, x: number, z: number, size: string, n: number)
	local r = if size == "s" then 0.8 elseif size == "m" then 1.1 elseif size == "l" then 1.3 else 1.9
	if not free(R, x - r, x + r, z - r, z + r) then
		return
	end
	Kit.plant(R.model, R.cf, at(R, x, z), size, R.seed + n * 17)
	claim(R, "Plant", x - r, x + r, z - r, z + r)
end

-- Plants in the requested corners (fb: "front"/"back", lr: "left"/"right"), skipping door zones.
local function cornerPlant(R: R, fb: string, lr: string, size: string, n: number)
	local gapB = if R.side.back == "facade" then FACADE_GAP else 0.4
	local gapS = if R.side[lr] == "facade" then FACADE_GAP else 0.4
	local r = if size == "s" then 0.8 elseif size == "m" then 1.1 else 1.3
	local x = if lr == "left" then R.inner.left + gapS + r else R.inner.right - gapS - r
	local z = if fb == "back" then R.inner.back - gapB - r else R.inner.front + 0.4 + r
	plant(R, x, z, size, n)
end

local function coatRack(R: R, x: number, z: number)
	if not free(R, x - 0.8, x + 0.8, z - 0.8, z + 0.8) then
		return
	end
	local b = at(R, x, z)
	Kit.cylinder(R.model, R.cf, "CoatRackBase", "y", 0.15, 1.4, b * CF(0, 0.075, 0), C.metal, M.metal)
	Kit.cylinder(R.model, R.cf, "CoatRackPole", "y", 6.0, 0.18, b * CF(0, 3.1, 0), C.metal, M.metal)
	claim(R, "CoatRack", x - 0.8, x + 0.8, z - 0.8, z + 0.8)
end

-- Coat rack in the front corner farthest from the entry door.
local function entryCoatRack(R: R)
	local x = if R.doorX &gt; 0 then R.inner.left + 1.2 else R.inner.right - 1.2
	coatRack(R, x, R.inner.front + 1.2)
end

local function credenza(R: R, side: string, t: number, L: number): boolean
	if solidish(R.side[side]) or R.side[side] == "glass" then
		Kit.sideboard(R.model, R.cf, wallAt(R, side, t), L, R.seed + math.floor(t * 7))
		wallClaim(R, "Credenza", side, t, L + 0.1, 1.7)
		return true
	end
	return false
end

-- Wall screen with an optional owner prompt; free-standing on a floor stand where the wall is glass/open.
local function wallScreen(R: R, side: string, t: number, w: number, kind: string, prompt: { text: string, app: string?, section: string? }?, y: number?): Part
	local mounted = solidish(R.side[side])
	local off = if mounted then 0 elseif R.side[side] == "facade" then FACADE_GAP + 1 else 1.0
	local screen = Kit.tvScreen(R.model, R.cf, wallAt(R, side, t, off), w, kind, R.accent, { y = y or 6.0, floor = not mounted, name = "WallScreen" })
	if not mounted then
		wallClaim(R, "ScreenStand", side, t, w, 1.7, off - 0.95)
	end
	if prompt then
		Kit.prompt(screen, prompt.text, R.owner, prompt.app, prompt.section)
	end
	return screen
end

-- Whiteboard on the wall (mobile stand where the wall is glass/open) + optional activity in front.
local function whiteboard(R: R, side: string, t: number, w: number, text: string, actKind: string?, dept: string?)
	local mounted = solidish(R.side[side])
	local off = if mounted then 0 elseif R.side[side] == "facade" then FACADE_GAP + 0.8 else 0.8
	local base = wallAt(R, side, t, off)
	Kit.whiteboard(R.model, R.cf, base, w, text, R.seed + math.floor(t * 3), { y = 5 })
	if not mounted then
		for _, sx in { -1, 1 } do
			Kit.part(R.model, R.cf, "BoardStand", V3(0.2, 7.2, 0.2), base * CF(sx * (w / 2 + 0.2), 3.6, -0.1), C.metalSoft, M.metal)
		end
		Kit.part(R.model, R.cf, "BoardFoot", V3(w + 0.8, 0.15, 1.8), base * CF(0, 0.075, -0.1), C.metalSoft, M.metal)
		wallClaim(R, "BoardStand", side, t, w + 0.8, 1.8, off - 0.8)
	end
	if actKind then
		local dp = dept or R.dept
		local ax, az = wallPoint(R, side, t, off + 2.6)
		local fx, fz = wallPoint(R, side, t, off)
		-- employees write on the board (Whiteboard) or read the pipeline board (Pipeline)
		local job = if actKind == "Whiteboard" then { JobPose = "write", JobItem = "marker" } else { JobPose = "scan" }
		activity(R, actKind, dp, roleOf(dp), ax, az, fx, fz, nil, { attributes = job })
	end
end

local function acoustic(R: R, side: string, t: number, w: number)
	if solidish(R.side[side]) then
		Kit.acousticPanels(R.model, R.cf, wallAt(R, side, t), math.min(w, 6.6), 2.4, R.seed + 5, { y = 8.6 })
	end
end

-- Floor lamp without a light object (rooms keep their ceiling lights).
local function floorLamp(R: R, x: number, z: number, n: number)
	if free(R, x - 0.7, x + 0.7, z - 0.7, z + 0.7) then
		Kit.floorLamp(R.model, R.cf, at(R, x, z, 0), R.seed + n)
		claim(R, "Lamp", x - 0.7, x + 0.7, z - 0.7, z + 0.7)
	end
end

-- Meeting chair on a sled frame (ArchKit chair, four legs replaced by two side runners).
local function chair(R: R, x: number, z: number, yaw: number, n: number, color: Color3?): Seat
	local base = at(R, x, z, yaw)
	local m = Instance.new("Model")
	m.Name = "Chair"
	local seat = Kit.meetingChair(m, R.cf, base, R.seed + n, if color then { color = color } else nil)
	for _, d in m:GetChildren() do
		if d.Name == "ChairLeg" then
			d:Destroy()
		end
	end
	Kit.part(m, R.cf, "ChairBase", V3(1.9, 1.68, 1.7), base * CF(0, 0.84, 0.05), seat.Color, seat.Material)
	m.Parent = R.model
	return seat
end

-- Low open shelf (wall unit) with a row of files: two parts.
local function lowShelf(R: R, side: string, t: number, w: number)
	local base = wallAt(R, side, t)
	Kit.part(R.model, R.cf, "LowShelf", V3(w, 2.8, 1.3), base * CF(0, 1.4, -0.65), pick({ C.oak, C.white, C.oakDark }, R.seed + 31), M.wood)
	Kit.part(R.model, R.cf, "Files", V3(w - 0.6, 0.9, 1.0), base * CF(0, 1.95, -0.7), pick({ C.fabricSand, C.blue, C.sage }, R.seed + 32), M.smooth, DETAIL)
	wallClaim(R, "LowShelf", side, t, w, 1.4)
end

local function lounge(R: R, x: number, z: number, yaw: number, n: number, armless: boolean?): Seat
	-- built 0.2 lower with the two floor runners removed: the upholstered base stands on the floor
	local m = Instance.new("Model")
	m.Name = "LoungeChair"
	local seat = Kit.loungeChair(m, R.cf, at(R, x, z, yaw) * CF(0, -0.2, 0), R.seed + n)
	for _, d in m:GetChildren() do
		if d.Name == "ChairLeg" or (armless and d.Name == "ArmRest") then
			d:Destroy()
		end
	end
	m.Parent = R.model
	local swap = math.abs(math.sin(RAD(yaw))) &gt; 0.7
	local hw, hd = if swap then 1.45 else 1.5, if swap then 1.5 else 1.45
	claim(R, "LoungeChair", x - hw, x + hw, z - hd, z + hd)
	return seat
end

local function sofa(R: R, x: number, z: number, yaw: number, L: number, n: number): { Seat }
	local m = Instance.new("Model")
	m.Name = "Sofa"
	local seats = Kit.sofa(m, R.cf, at(R, x, z, yaw) * CF(0, -0.2, 0), L, R.seed + n)
	for _, d in m:GetChildren() do
		if d.Name == "SofaLeg" then
			d:Destroy()
		end
	end
	m.Parent = R.model
	return seats
end

local function coffeeTable(R: R, x: number, z: number, w: number, d: number, n: number)
	Kit.coffeeTable(R.model, R.cf, at(R, x, z, 0), R.seed + n, w, d)
	claim(R, "CoffeeTable", x - w / 2, x + w / 2, z - d / 2, z + d / 2)
end

-- Island lab bench (free-standing, front -Z of its frame) with instruments or screens on top.
local function labIsland(R: R, x: number, z: number, yaw: number, L: number, screens: boolean, printer: boolean?): Model?
	local b = at(R, x, z, yaw)
	local made: Model? = nil
	Kit.part(R.model, R.cf, "LabBenchTop", V3(L, 0.25, 3), b * CF(0, 3.075, 0), C.metalSoft, M.slate)
	for _, s in { -1, 1 } do
		Kit.part(R.model, R.cf, "LabBenchBase", V3(2.2, 2.95, 2.6), b * CF(s * (L / 2 - 1.2), 1.475, 0), C.white, M.smooth)
	end
	if screens then
		for _, s in { -1, 1 } do
			Kit.part(R.model, R.cf, "BenchMonitor", V3(2.4, 1.5, 0.12), b * CF(s * L / 4, 4.15, 0.6) * ANG(0, s * 0.2, 0), C.screen, M.smooth, DETAIL)
		end
	else
		Kit.part(R.model, R.cf, "Instrument", V3(1.6, 1.1, 1.3), b * CF(-L / 4, 3.75, 0.3), C.white, M.smooth, DETAIL)
		if printer then
			-- 3D printer (PropFx): prints while a researcher works at the bench beside it (FxStation, set by
			-- the caller), players can start it too
			made = Kit.printer3d(R.model, R.cf, b * CF(L / 4 - 0.1, 3.2, 0.2), R.seed + 7, { prompt = "3D printer", propId = R.room.id .. "_Printer3D" })
		else
			Kit.part(R.model, R.cf, "InstrumentScreen", V3(1.3, 0.9, 0.1), b * CF(L / 4, 3.7, 0.7) * ANG(RAD(-10), 0, 0), C.screen, M.smooth, DETAIL)
		end
	end
	local swap = math.abs(math.sin(RAD(yaw))) &gt; 0.7
	local hw, hd = if swap then 1.5 else L / 2, if swap then L / 2 else 1.5
	claim(R, "LabBench", x - hw, x + hw, z - hd, z + hd)
	return made
end


-- Two LabBench activities in front of a bench whose frame is (x, z, yaw); researchers inspect there.
local function benchActivities(R: R, x: number, z: number, yaw: number, L: number, dept: string): { Model }
	local b = CF(x, 0, z) * ANG(0, RAD(yaw), 0)
	local out: { Model } = {}
	for _, s in { -1, 1 } do
		local p = (b * CF(s * L / 4, 0, -3.0)).Position
		local f = (b * CF(s * L / 4, 0, 0)).Position
		table.insert(out, activity(R, "LabBench", dept, roleOf(dept), p.X, p.Z, f.X, f.Z, nil, { attributes = { JobPose = "inspect" } }))
	end
	return out
end

-- Lab island + its two LabBench activities; the 3D printer (if any) follows the right-hand bench.
local function labBench(R: R, x: number, z: number, yaw: number, L: number, dept: string, printer: boolean)
	local made = labIsland(R, x, z, yaw, L, false, printer)
	local acts = benchActivities(R, x, z, yaw, L, dept)
	if made and acts[2] then
		made:SetAttribute("FxStation", acts[2].Name)
	end
end

---------------------------------------------------------------------------------------------
-- Room shapes
---------------------------------------------------------------------------------------------
-- Feature wall: a solid side wall (the one away from the door when both are solid).
local function featureSide(R: R, awayFromDoor: boolean?): string
	local l, r = solidish(R.side.left), solidish(R.side.right)
	if l and not r then
		return "left"
	elseif r and not l then
		return "right"
	elseif l and r then
		if awayFromDoor and math.abs(R.doorX) &gt; 1 then
			return if R.doorX &gt; 0 then "left" else "right"
		end
		return if R.style % 2 == 0 then "left" else "right"
	end
	return if R.side.left ~= "facade" then "left" else "right"
end

type ShapeA = { fside: string, fw: number, t1: number, t2: number, freeRects: { Rect } }
-- Deep wing room (S zones): entry band along the entry wall, a feature strip (fw deep) along one solid
-- side wall, desk rows in the rest. Big kit pieces go into the returned free rectangles.
local function shapeA(R: R, n: number, variant: string, fwPref: number, axisPref: string, axes: { string }?): ShapeA
	local fside = featureSide(R)
	local other = opposite(fside)
	local otherGap = if R.side[other] == "facade" then FACADE_GAP else 0
	local best: BlockPlan? = nil
	local bestScore = -math.huge
	local axisList: { string } = axes or { axisPref }
	local variants = { variant }
	for _, v in { "bench", "standing" } do
		if v ~= variant then
			table.insert(variants, v)
		end
	end
	for _, axis in axisList do
		-- the strip keeps a 4-stud walkway in front of the wall furniture: rows parallel to the entry wall
		-- end at it, rows towards the back have their chairs backing onto it
		local fws: { number } = { math.max(fwPref, STRIP + 4), STRIP + 4 }
		for _, fw in fws do
			for _, v in variants do
				local rect: Rect
				if fside == "left" then
					rect = { x1 = R.inner.left + fw, x2 = R.inner.right - otherGap, z1 = ENTRY, z2 = R.zEnd }
				else
					rect = { x1 = R.inner.left + otherGap, x2 = R.inner.right - fw, z1 = ENTRY, z2 = R.zEnd }
				end
				local low, high = "open", "wall"
				if axis == "z" then
					low, high = if fside == "left" then "open" else "wall", if fside == "left" then "wall" else "open"
				end
				local plan = planBlock(rect, axis, n, v, low, high, if axis == "x" then "high" else "edges", fw)
				if plan then
					local score = (if v == variant then 5000 elseif v == "bench" then 2500 else 0) + (if axis == axisPref then 2000 else 0) - #plan.rows * 300 + fw * 10
					if score &gt; bestScore then
						best, bestScore = plan, score
					end
				end
			end
		end
	end
	local t1, t2 = ENTRY + 0.5, R.zEnd
	if not best then
		table.insert(R.issues, string.format("%s: no desk arrangement for %d desks", R.room.id, n))
		return { fside = fside, fw = fwPref, t1 = t1, t2 = t2, freeRects = {} }
	end
	local plan = best :: BlockPlan
	local align = if plan.axis == "x" then (if fside == "left" then -1 else 1) else -1
	local freeRects = placeBlock(R, plan, n, align)
	return { fside = fside, fw = plan.fw, t1 = t1, t2 = t2, freeRects = freeRects }
end

type ShapeB = { cx1: number, cx2: number, backFree: { Rect } }
-- Shallow room (I3 zones): central aisle from the door to the back wall, desks along both side walls
-- (users facing the walls), front-aligned so the back corners stay free.
local function shapeB(R: R, nL: number, nR: number, variant: string): ShapeB
	local g = DESK[variant] or DESK.bench
	local z1 = R.inner.front + 0.6
	local cx1, cx2 = R.inner.left + 0.4 + g.dd + g.cr, R.inner.right - 0.4 - g.dd - g.cr
	local backFree: { Rect } = {}
	for _, s in { "left", "right" } do
		local count = if s == "left" then nL else nR
		local x = if s == "left" then R.inner.left + 0.4 + g.dd / 2 else R.inner.right - 0.4 - g.dd / 2
		local yaw = if s == "left" then LOOK.L else LOOK.R
		for i = 1, count do
			local z = z1 + g.p / 2 + (i - 1) * g.p
			station(R, x, z, yaw, variant)
			stationClaim(R, x, z, yaw, variant)
		end
		local zEndRow = z1 + count * g.p
		local x1 = if s == "left" then R.inner.left else cx2
		local x2 = if s == "left" then cx1 else R.inner.right
		if R.inner.back - zEndRow &gt; 3 then
			table.insert(backFree, { x1 = x1, x2 = x2, z1 = zEndRow + 0.4, z2 = R.inner.back - 0.3 })
		end
	end
	return { cx1 = cx1, cx2 = cx2, backFree = backFree }
end

local function shapeOf(R: R): string
	if R.D &gt;= 26 and R.W &gt;= 22 then
		return "A"
	elseif R.W &lt;= 22 and R.D &gt;= 28 then
		return "C"
	end
	return "B"
end

-- Variant of the desks of a room: kind first, then department + style (no 13-wide trading cockpits in rows).
local function variantFor(R: R): string
	local v = Kit.deskVariant(R.dept, R.room.kind, R.style)
	if v == "trading" then
		v = "dual"
	end
	return v
end

---------------------------------------------------------------------------------------------
-- Work room kits
---------------------------------------------------------------------------------------------
local TEAM_TEXT: { [string]: string } = {
	data = "SPRINT · DATA QUALITY\n1  dedupe web crawl\n2  label review queue\n3  tokenizer refresh",
	engineering = "SPRINT · TRAINING STACK\n1  eval harness\n2  checkpoint restore\n3  latency budget",
	design = "ARCHITECTURE NOTES\nlayers · heads · context\nmixture of experts?",
	training = "TRAINING RUNS\nloss curve review 10:00\nnext checkpoint: 6h",
	research = "OPEN QUESTIONS\nscaling laws · reasoning\nread: 3 new papers",
	evaluation = "BENCHMARK PLAN\ncoding · maths · reasoning\nsafety review Friday",
	growth = "GO-TO-MARKET\npricing · partners · launch\ncustomer calls: 4",
	deployment = "RELEASE CHECKLIST\nstaging · canary · docs\nrollback plan",
	operations = "PEOPLE &amp; COMPANY\nonboarding · reviews\nteam offsite",
}

-- Team board (department screen + owner prompt) with a credenza, a whiteboard with its activity and,
-- for data rooms, a pipeline board, along a wall from t1 to t2. Returns the next free coordinate.
local function teamWall(R: R, side: string, t1: number, t2: number): number
	local app, section, _, screenKind = deptInfo(R.dept)
	local t = t1
	if t2 - t &gt;= 7.5 then
		if credenza(R, side, t + 3.5, 6) then
			-- team printer on the credenza (PropFx paper + light)
			Kit.deskPrinter(R.model, R.cf, wallAt(R, side, t + 3.5) * CF(0, 2.82, -0.85), { prompt = "Team printer", propId = R.room.id .. "_Printer" })
		end
		wallScreen(R, side, t + 3.5, 6, screenKind, { text = "Team board · " .. R.room.name, app = app, section = section }, 6.3)
		t += 8
	end
	if t2 - t &gt;= 6.5 then
		whiteboard(R, side, t + 3, 5.5, TEAM_TEXT[R.dept] or TEAM_TEXT.operations, "Whiteboard")
		t += 7
	end
	if R.dept == "data" and t2 - t &gt;= 6.5 then
		whiteboard(R, side, t + 3, 5.5, "DATA PIPELINE\ncollect → filter → clean → tokenize", "Pipeline")
		t += 7
	end
	return t
end

local function kitTeam(R: R)
	local n = R.room.desks or 0
	local variant = variantFor(R)
	if shapeOf(R) == "A" then
		local s = shapeA(R, n, variant, 5.5, if R.style % 2 == 0 then "x" else "z", { "x", "z" })
		teamWall(R, s.fside, s.t1, s.t2)
		acoustic(R, opposite(s.fside), (s.t1 + s.t2) / 2, 8)
		cornerPlant(R, "back", opposite(s.fside), deco(R), 1)
		if n &gt;= 10 then
			cornerPlant(R, "back", s.fside, "s", 2)
		end
		if n &gt;= 8 then
			entryCoatRack(R)
		end
	else
		local nL = math.ceil(n / 2)
		local b = shapeB(R, nL, n - nL, variant)
		local w = R.inner.right - R.inner.left
		local app, section, _, screenKind = deptInfo(R.dept)
		wallScreen(R, "back", -3.6, 6, screenKind, { text = "Team board · " .. R.room.name, app = app, section = section })
		whiteboard(R, "back", 3.6, 5, TEAM_TEXT[R.dept] or TEAM_TEXT.operations, "Whiteboard")
		for i, r in b.backFree do
			if r.x2 - r.x1 &gt; 3 then
				plant(R, (r.x1 + r.x2) / 2, r.z2 - 1.3, "s", i)
			end
		end
		if w &gt; 24 then
			entryCoatRack(R)
		end
	end
end

local function kitArchitecture(R: R)
	local n = R.room.desks or 0
	local s = shapeA(R, n, if R.style % 2 == 0 then "ldesk" else "bench", 7, "x")
	local side = s.fside
	-- sketches and the design screen on the feature wall
	local app = "lab"
	local t = s.t1
	Kit.pinboard(R.model, R.cf, wallAt(R, side, t + 2.5), 4.5, 3.2, R.seed + 1, { y = 5.6 })
	wallScreen(R, side, t + 9, 6.4, "design", { text = "Design screen · model architecture", app = app }, 6.0)
	if s.t2 - (t + 13) &gt;= 5 then
		Kit.pinboard(R.model, R.cf, wallAt(R, side, t + 15.5), 4.5, 3.2, R.seed + 2, { y = 5.6 })
	end
	-- big studio table with drawings, physical model display
	local x, z, turned = takeFree(R, s.freeRects, 9, 5)
	if x and z then
		local yaw = if turned then 90 else 0
		Kit.meetingTable(R.model, R.cf, at(R, x, z, yaw), "rect", 8, 4, R.seed + 3)
		local b = at(R, x, z, yaw)
		for i = 1, 3 do
			Kit.part(R.model, R.cf, "Drawing", V3(1.6, 0.05, 2.2), b * CF(-3 + i * 1.6, 3.165, Kit.range(R.seed, i, -0.8, 0.8)) * ANG(0, Kit.range(R.seed, i + 3, -0.3, 0.3), 0), C.white, M.smooth, DETAIL)
		end
		claim(R, "StudioTable", x - (if turned then 2.5 else 4.5), x + (if turned then 2.5 else 4.5), z - (if turned then 4.5 else 2.5), z + (if turned then 4.5 else 2.5))
	end
	local mx, mz = takeFree(R, s.freeRects, 3.6, 3.6)
	if mx and mz then
		local b = at(R, mx, mz, 0)
		Kit.part(R.model, R.cf, "ModelPlinth", V3(3, 3.2, 3), b * CF(0, 1.6, 0), C.white, M.smooth)
		for i = 1, 4 do
			local w = Kit.range(R.seed, i + 20, 0.5, 1.0)
			local h = Kit.range(R.seed, i + 30, 0.4, 1.8)
			Kit.part(R.model, R.cf, "ModelBlock", V3(w, h, Kit.range(R.seed, i + 40, 0.5, 1.0)), b * CF(-0.65 + ((i - 1) % 2) * 1.3, 3.2 + h / 2, -0.65 + math.floor((i - 1) / 2) * 1.3), pick({ C.white, C.oakLight, C.stone, C.sageLight }, R.seed + i), M.smooth, DETAIL)
		end
		claim(R, "ModelDisplay", mx - 1.5, mx + 1.5, mz - 1.5, mz + 1.5)
	end
	-- large-format plotter for the model diagrams (PropFx)
	local px, pz, pturned = takeFree(R, s.freeRects, 6, 3)
	if px and pz then
		Kit.plotter(R.model, R.cf, at(R, px, pz, if pturned then 90 else 0), 5, { propId = R.room.id .. "_Plotter" })
		claim(R, "Plotter", px - (if pturned then 1 else 2.6), px + (if pturned then 1 else 2.6), pz - (if pturned then 2.6 else 1), pz + (if pturned then 2.6 else 1))
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
	entryCoatRack(R)
end

-- Data lab (shallow): data-quality wall of three screens at the back with the Pipeline activity, dual
-- monitor desks along the side walls, a small server shelf in a back corner.
local function dataWall(R: R, t: number, kinds: { string }, prompt: { text: string, app: string?, section: string? }?)
	local side = "back"
	local mounted = solidish(R.side.back)
	local off = if mounted then 0 elseif R.side.back == "facade" then FACADE_GAP + 0.6 else 0.6
	local base = wallAt(R, side, t, off)
	local sw, sh, gap = 4.6, 2.6, 0.15
	local total = #kinds * sw + (#kinds - 1) * gap
	Kit.part(R.model, R.cf, "ScreenWallFrame", V3(total + 0.5, sh + 0.5, 0.25), base * CF(0, 5.6, -0.125), C.metal, M.metal)
	if not mounted then
		for _, s in { -1, 1 } do
			Kit.part(R.model, R.cf, "ScreenWallLeg", V3(0.3, 4.1, 0.3), base * CF(s * (total / 2 - 0.5), 2.05, -0.125), C.metal, M.metal)
		end
		Kit.part(R.model, R.cf, "ScreenWallFoot", V3(total, 0.15, 1.4), base * CF(0, 0.075, -0.4), C.metal, M.metal)
		wallClaim(R, "ScreenWall", side, t, total + 0.5, 1.2, off - 0.1)
	end
	for i, kind in kinds do
		local s = Kit.screen(R.model, R.cf, "DataWall" .. i, V3(sw, sh, 0.1), base * CF(-total / 2 + sw / 2 + (i - 1) * (sw + gap), 5.6, -0.3), kind, R.accent)
		if prompt and i == math.ceil(#kinds / 2) then
			Kit.prompt(s, prompt.text, R.owner, prompt.app, prompt.section)
		end
	end
end

local function serverShelf(R: R, x: number, z: number, yaw: number)
	local b = at(R, x, z, yaw)
	Kit.part(R.model, R.cf, "ServerShelf", V3(2.4, 5.2, 2.2), b * CF(0, 2.6, 0), C.screen, M.metal)
	for i = 1, 3 do
		Kit.part(R.model, R.cf, "ServerUnit", V3(2.0, 0.6, 0.06), b * CF(0, 1.0 + i * 1.1, -1.12), C.metalSoft, M.metal, DETAIL)
	end
	Kit.part(R.model, R.cf, "ServerLeds", V3(0.12, 3.4, 0.04), b * CF(0.85, 2.6, -1.14), C.statusGood, M.neon, DETAIL)
	claim(R, "ServerShelf", x - 1.3, x + 1.3, z - 1.3, z + 1.3)
end

local function kitDatalab(R: R)
	local n = R.room.desks or 0
	if shapeOf(R) ~= "B" then
		local s = shapeA(R, n, "dual", 7, "x")
		teamWall(R, s.fside, s.t1, s.t2)
		return
	end
	local nL = math.ceil(n / 2)
	local b = shapeB(R, nL, n - nL, "dual")
	local dept = R.dept
	dataWall(R, 0, { "data", "data", "data" }, { text = "Data quality wall", app = "data" })
	local ax, az = wallPoint(R, "back", 0, 3.2)
	activity(R, "Pipeline", dept, roleOf(dept), ax, az, 0, R.inner.back, nil, { attributes = { JobPose = "scan" } })
	for i, r in b.backFree do
		if r.x2 - r.x1 &gt;= 2.8 and r.z2 - r.z1 &gt;= 2.8 then
			local x = if r.x1 &lt; 0 then r.x1 + 1.5 else r.x2 - 1.5
			serverShelf(R, x, r.z2 - 1.4, FRONT.F)
			break
		end
	end
	cornerPlant(R, "front", if R.doorX &gt; 0 then "left" else "right", "s", 1)
end

-- Training control: curved console rows facing a three-screen video wall on a solid side wall,
-- supervisor cockpit behind.
local function kitControl(R: R)
	local n = R.room.desks or 0
	if shapeOf(R) ~= "A" then
		local nL = math.ceil(n / 2)
		shapeB(R, nL, n - nL, "dual")
		dataWall(R, 0, { "training", "compute", "training" }, { text = "Training control wall", app = "lab" })
		return
	end
	local side = featureSide(R, true)
	local sgn = if side == "left" then 1 else -1 -- rows advance away from the wall in +x for a left wall
	local wallX = if side == "left" then R.inner.left else R.inner.right
	local farX = if side == "left" then R.inner.right - (if R.side.right == "facade" then FACADE_GAP else 0) else R.inner.left + (if R.side.left == "facade" then FACADE_GAP else 0)
	-- rows run along z between the entry band and the facade gap
	local z1 = ENTRY + 0.2
	local z2 = R.zEnd
	local L = z2 - z1
	local zc = (z1 + z2) / 2
	local Rv = 30 -- console rows lie on arcs centred beyond the video wall
	local function sagOf(count: number, p: number): number
		return Rv * (1 - math.cos((count - 1) / 2 * p / Rv))
	end
	-- aisles between console rows stay wide (turned chairs eat into them); the arc is dropped from the
	-- rear rows, then from all rows, before the viewing distance shrinks
	type Plan = { variant: string, rows: { number }, vd: number, aisle: number, arcs: number }
	local chosen: Plan? = nil
	for _, v in { "dual", "bench", "standing" } do
		local g = DESK[v]
		local k = math.floor(L / g.p)
		if k &lt; 2 or chosen then
			continue
		end
		local rows: { number } = {}
		local left = n
		while left &gt; 0 do
			table.insert(rows, math.min(k, left))
			left -= math.min(k, left)
		end
		for _, vd in { 5.5, 4.5, 4.0 } do
			for _, arcs in { #rows, 1, 0 } do
				for _, aisle in { 4.8, 4.4 } do
					local extent = vd + WALL_AISLE
					for i, c in rows do
						local sup = i == #rows and (c - 1) * g.p + DESK.trading.p &lt;= L
						extent += if sup then 5.8 else g.dd + g.cr + (if i &lt;= arcs then sagOf(c, g.p) else 0)
						if i &lt; #rows then
							extent += aisle
						end
					end
					if not chosen and extent &lt;= math.abs(farX - wallX) then
						chosen = { variant = v, rows = rows, vd = vd, aisle = aisle, arcs = arcs }
					end
				end
			end
		end
	end
	-- video wall
	local frameW = 3 * 6.2 + 2 * 0.15
	local base = wallAt(R, side, zc)
	Kit.part(R.model, R.cf, "VideoWallFrame", V3(frameW + 0.6, 4.2, 0.2), base * CF(0, 6.4, -0.1), C.metal, M.metal)
	for i, kind in { "training", "compute", "training" } do
		local s = Kit.screen(R.model, R.cf, "VideoWall" .. i, V3(6.2, 3.6, 0.1), base * CF(-frameW / 2 + 3.1 + (i - 1) * 6.35, 6.4, -0.25), kind, R.accent)
		if i == 2 then
			Kit.prompt(s, "Training control wall", R.owner, "lab", nil)
		end
	end
	Kit.part(R.model, R.cf, "VideoWallSill", V3(frameW + 0.6, 0.3, 0.6), base * CF(0, 4.15, -0.3), C.metal, M.metal, DETAIL)
	if not chosen then
		table.insert(R.issues, R.room.id .. ": control room rows do not fit, using rows")
		shapeA(R, n, "bench", 5.8, "x")
		return
	end
	local ch = chosen :: Plan
	local g = DESK[ch.variant]
	local look = if side == "left" then LOOK.L else LOOK.R
	local rowFront = wallX + sgn * ch.vd -- desk front edge of the current row
	for ri, count in ch.rows do
		local supervisor = ri == #ch.rows and (count - 1) * g.p + DESK.trading.p &lt;= L
		local depth
		if supervisor then
			-- supervisor cockpit in the middle of the last row, remaining desks beside it
			local variants: { string } = {}
			local total = 0
			for i = 1, count do
				local v = if i == math.ceil(count / 2) then "trading" else ch.variant
				table.insert(variants, v)
				total += DESK[v].p
			end
			depth = 5.8
			local s = zc - total / 2
			for _, v in variants do
				local w = DESK[v].p
				local zz = s + w / 2
				local half = if v == "trading" then 1.6 else DESK[v].dd / 2
				station(R, rowFront + sgn * half, zz, look, v)
				local fx1, fx2 = rowFront, rowFront + sgn * depth
				claim(R, "Desk", math.min(fx1, fx2), math.max(fx1, fx2), zz - w / 2, zz + w / 2)
				s += w
			end
		else
			local step = if ri &lt;= ch.arcs then g.p / Rv else 0
			for i = 1, count do
				local th = (i - (count + 1) / 2) * step
				local sag = Rv * (1 - math.cos(th))
				local zz = if step &gt; 0 then zc + Rv * math.sin(th) else zc + (i - (count + 1) / 2) * g.p
				station(R, rowFront + sgn * (sag + g.dd / 2), zz, look - sgn * math.deg(th), ch.variant)
				local fx1, fx2 = rowFront + sgn * sag, rowFront + sgn * (sag + g.dd + g.cr)
				claim(R, "Console", math.min(fx1, fx2), math.max(fx1, fx2), zz - g.p / 2 + 0.3, zz + g.p / 2 - 0.3)
			end
			depth = g.dd + g.cr + (if step &gt; 0 then sagOf(count, g.p) else 0)
		end
		rowFront += sgn * (depth + ch.aisle)
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
end

local function kitEvaluation(R: R)
	local n = R.room.desks or 0
	local dept = R.dept
	if shapeOf(R) == "B" then
		local nL = math.ceil(n / 2)
		local b = shapeB(R, nL, n - nL, "dual")
		wallScreen(R, "back", 0, 7, "evaluation", { text = "Benchmark wall", app = "lab", section = "evaluation" })
		local z = math.max(ENTRY + 4.5, (b.backFree[1] and b.backFree[1].z1 or 9) - 1)
		labIsland(R, 0, z, FRONT.F, 6.4, true)
		benchActivities(R, 0, z, FRONT.F, 6.4, dept)
		return
	end
	local s = shapeA(R, n, if R.style % 2 == 0 then "dual" else "bench", 7, "x")
	local side = s.fside
	wallScreen(R, side, s.t1 + 4.5, 7, "evaluation", { text = "Benchmark wall", app = "lab", section = "evaluation" })
	whiteboard(R, side, s.t1 + 12.5, 5, "EVAL MATRIX\ncoding · maths · reasoning\nreliability · safety")
	for i = 1, 2 do
		local x, z, turned = takeFree(R, s.freeRects, 7, 6.5)
		if x and z then
			local yaw = if turned then FRONT.L else FRONT.F
			local bx, bz = x, z + (if turned then 0 else 1.6)
			if turned then
				bx = x + 1.6
			end
			labIsland(R, bx, bz, yaw, 6.4, true)
			benchActivities(R, bx, bz, yaw, 6.4, dept)
		elseif i == 1 then
			-- no free stretch: one comparison bench in the feature strip
			local tx = s.t2 - 4
			local wx, wz = wallPoint(R, side, tx, 1.6)
			labIsland(R, wx, wz, WALL_YAW[side], 6.4, true)
			benchActivities(R, wx, wz, WALL_YAW[side], 6.4, dept)
		end
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
end

local function kitLaunch(R: R)
	local n = R.room.desks or 0
	local s = shapeA(R, n, if R.style % 2 == 0 then "standing" else "bench", 7, "x")
	local side = s.fside
	whiteboard(R, side, s.t1 + 3.2, 6, "PRICING · PLANS\nFree · Pro · Team · Enterprise\nAPI · per 1M tokens")
	wallScreen(R, side, s.t1 + 10.5, 6, "growth", { text = "Growth dashboard", app = "market" }, 6.0)
	if s.t2 - (s.t1 + 14) &gt;= 6.5 then
		wallScreen(R, side, s.t1 + 17.5, 6, "deployment", { text = "Release control", app = "lab", section = "release" }, 6.0)
	else
		wallScreen(R, opposite(side), (s.t1 + s.t2) / 2, 6, "deployment", { text = "Release control", app = "lab", section = "release" }, 6.0)
	end
	-- war-room table (standing height) with stools
	local x, z, turned = takeFree(R, s.freeRects, 10, 6)
	if x and z then
		local yaw = if turned then 90 else 0
		local b = at(R, x, z, yaw)
		Kit.part(R.model, R.cf, "WarRoomTable", V3(8, 0.25, 3.4), b * CF(0, 3.9, 0), C.oakDark, M.wood)
		for _, sx in { -1, 1 } do
			Kit.part(R.model, R.cf, "WarRoomLeg", V3(0.4, 3.8, 2.6), b * CF(sx * 3.3, 1.9, 0), C.metal, M.metal)
		end
		Kit.part(R.model, R.cf, "LaunchPlan", V3(3, 0.05, 2), b * CF(-1.5, 4.04, 0), C.white, M.smooth, DETAIL)
		for i, sx in { -2.2, 2.2 } do
			Kit.stool(R.model, R.cf, b * CF(sx, 0, -2.6) * ANG(0, math.pi, 0), R.seed + i, 3.0)
		end
		claim(R, "WarRoomTable", x - (if turned then 3 else 5), x + (if turned then 3 else 5), z - (if turned then 5 else 3), z + (if turned then 5 else 3))
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
	entryCoatRack(R)
end

local function headsets(R: R)
	for _, d in R.model:GetChildren() do
		if d:IsA("Model") and d:GetAttribute("WorkstationType") == "Computer" then
			local top = d:FindFirstChild("DeskTop")
			if top and top:IsA("BasePart") then
				local p = top.CFrame * CF(-1.9, top.Size.Y / 2 + 0.1, 0.4)
				local h = Instance.new("Part")
				h.Name = "Headset"
				h.Anchored = true
				h.CanCollide = false
				h.CanTouch = false
				h.CanQuery = false
				h.CastShadow = false
				h.Size = V3(0.8, 0.2, 0.7)
				h.CFrame = p
				h.Color = C.fabricCharcoal
				h.Material = M.rubber
				h.Parent = d
			end
		end
	end
end

local function softCorner(R: R, rects: { Rect })
	local x, z, turned = takeFree(R, rects, 9, 4.2)
	if not (x and z) then
		return
	end
	if turned then
		lounge(R, x, z - 2.6, FRONT.B, 1)
		lounge(R, x, z + 2.6, FRONT.F, 2)
	else
		lounge(R, x - 3, z, FRONT.R, 1)
		lounge(R, x + 3, z, FRONT.L, 2)
	end
	Kit.coffeeTable(R.model, R.cf, at(R, x, z, if turned then 90 else 0), R.seed + 4, 2.4, 1.8)
end

local function kitSupport(R: R)
	local n = R.room.desks or 0
	local shape = shapeOf(R)
	if shape == "A" then
		local s = shapeA(R, n, "bench", 7, "x")
		wallScreen(R, s.fside, s.t1 + 4.5, 7, "customers", { text = "Customer wall", app = "empire", section = "contracts" })
		whiteboard(R, s.fside, s.t1 + 12.5, 5, "SUPPORT QUEUE\nP1 · 0   P2 · 3   P3 · 11\nfirst response &lt; 2h")
		softCorner(R, s.freeRects)
		cornerPlant(R, "back", opposite(s.fside), deco(R), 1)
		entryCoatRack(R)
	elseif shape == "C" then
		-- desks along the solid side wall (back part), soft seating at the front of the other side
		local side = if solidish(finishAt(R.tier, R.room, R.sideFace.left, 0)) then "left" else "right"
		local probeT = R.D * 0.6
		local lf = finishAt(R.tier, R.room, R.sideFace.left, (R.room.x1 + R.room.x2) / 2)
		side = if solidish(R.side.left) or solidish(lf) then "left" else "right"
		local g = DESK.bench
		local x = if side == "left" then R.inner.left + 0.4 + g.dd / 2 else R.inner.right - 0.4 - g.dd / 2
		local z0 = R.zEnd - WALL_AISLE - n * g.p
		for i = 1, n do
			local z = z0 + g.p / 2 + (i - 1) * g.p
			station(R, x, z, if side == "left" then LOOK.L else LOOK.R, "bench")
			stationClaim(R, x, z, if side == "left" then LOOK.L else LOOK.R, "bench")
		end
		local _ = probeT
		local o = opposite(side)
		local sx = if o == "left" then R.inner.left + 4.5 else R.inner.right - 4.5
		local rects: { Rect } = { { x1 = sx - 4.5, x2 = sx + 4.5, z1 = ENTRY + 0.5, z2 = ENTRY + 5.5 } }
		softCorner(R, rects)
		wallScreen(R, "back", 0, 7, "customers", { text = "Customer wall", app = "empire", section = "contracts" })
		cornerPlant(R, "back", o, deco(R), 1)
	else
		local nL = math.ceil(n / 2)
		shapeB(R, nL, n - nL, "bench")
		wallScreen(R, "back", 0, 7, "customers", { text = "Customer wall", app = "empire", section = "contracts" })
	end
	headsets(R)
end

local function deviceTable(R: R, x: number, z: number, yaw: number)
	local b = at(R, x, z, yaw)
	Kit.part(R.model, R.cf, "DeviceTable", V3(6, 0.25, 3), b * CF(0, 3.075, 0), C.oakLight, M.wood)
	for _, s in { -1, 1 } do
		Kit.part(R.model, R.cf, "TableLeg", V3(0.3, 2.95, 2.6), b * CF(s * 2.6, 1.475, 0), C.metal, M.metal)
	end
	for i = 1, 3 do
		Kit.part(R.model, R.cf, "TestPhone", V3(0.5, 0.06, 1.0), b * CF(-2.3 + i * 0.8, 3.23, -0.6) * ANG(0, Kit.range(R.seed, i, -0.3, 0.3), 0), C.screen, M.smooth, DETAIL)
	end
	Kit.part(R.model, R.cf, "TestTablet", V3(1.3, 0.06, 1.8), b * CF(1.4, 3.23, -0.3), C.metal, M.smooth, DETAIL)
	Kit.part(R.model, R.cf, "TestTabletStand", V3(1.3, 1.8, 0.08), b * CF(1.4, 4.1, 0.9) * ANG(RAD(-15), 0, 0), C.screen, M.smooth, DETAIL)
	local swap = math.abs(math.sin(RAD(yaw))) &gt; 0.7
	claim(R, "DeviceTable", x - (if swap then 1.5 else 3), x + (if swap then 1.5 else 3), z - (if swap then 3 else 1.5), z + (if swap then 3 else 1.5))
end

local function kitStudio(R: R)
	local n = R.room.desks or 0
	if shapeOf(R) == "B" then
		local nL = math.ceil(n / 2)
		shapeB(R, nL, n - nL, "ldesk")
		wallScreen(R, "back", -3.8, 6, "product", { text = "Product board", app = "studio" })
		Kit.pinboard(R.model, R.cf, wallAt(R, "back", 3.8, if solidish(R.side.back) then 0 else 0.3), 5, 3.2, R.seed + 1, { y = 5.6 })
		deviceTable(R, 0, ENTRY + 5, 0)
		return
	end
	local s = shapeA(R, n, if R.style % 2 == 0 then "ldesk" else "bench", 7, "x")
	local side = s.fside
	Kit.pinboard(R.model, R.cf, wallAt(R, side, s.t1 + 2.6), 4.6, 3.4, R.seed + 1, { y = 5.6, name = "MoodBoard" })
	wallScreen(R, side, s.t1 + 9.5, 6.4, "product", { text = "Product board", app = "studio" })
	if s.t2 - (s.t1 + 13.5) &gt;= 5 then
		Kit.pinboard(R.model, R.cf, wallAt(R, side, s.t1 + 16.2), 4.6, 3.4, R.seed + 2, { y = 5.6, name = "MoodBoard" })
	end
	local x, z, turned = takeFree(R, s.freeRects, 7, 5)
	if x and z then
		deviceTable(R, x, z, if turned then 90 else 0)
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
	entryCoatRack(R)
end

local function kitPlatform(R: R)
	local n = R.room.desks or 0
	if shapeOf(R) == "B" then
		-- one row of standing desks facing the NOC wall at the back
		local g = DESK.standing
		local total = n * g.p
		local z = ENTRY + CR + g.dd / 2 + 0.1
		for i = 1, n do
			local x = -total / 2 + g.p / 2 + (i - 1) * g.p
			station(R, x, z, LOOK.B, "standing")
			stationClaim(R, x, z, LOOK.B, "standing")
		end
		dataWall(R, 0, { "platform", "platform", "platform" }, { text = "NOC wall", app = "market" })
		cornerPlant(R, "back", "left", deco(R), 1)
		return
	end
	local s = shapeA(R, n, "dual", 7, "x")
	local side = s.fside
	local base = wallAt(R, side, (s.t1 + s.t2) / 2)
	Kit.part(R.model, R.cf, "NocFrame", V3(20.6, 4.0, 0.2), base * CF(0, 6.4, -0.1), C.metal, M.metal)
	for i = 1, 3 do
		local sc = Kit.screen(R.model, R.cf, "NocWall" .. i, V3(6.6, 3.6, 0.1), base * CF(-6.75 + (i - 1) * 6.75, 6.4, -0.25), "platform", R.accent)
		if i == 2 then
			Kit.prompt(sc, "NOC wall · platform", R.owner, "market", nil)
		end
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
end

local function kitLab(R: R)
	local n = R.room.desks or 0
	local dept = R.dept
	if shapeOf(R) == "B" then
		local nL = math.ceil(n / 2)
		local b = shapeB(R, nL, n - nL, "lab")
		local z = ENTRY + 4
		labBench(R, 0, z, FRONT.F, 6.4, dept, true)
		wallScreen(R, "back", -4, 5.6, "research", { text = "Research screen", app = "empire", section = "research" })
		whiteboard(R, "back", 4, 5, "EXPERIMENT LOG\nhypothesis · run · result", "Whiteboard")
		local _ = b
		return
	end
	local s = shapeA(R, n, "lab", 7, "x")
	local side = s.fside
	wallScreen(R, side, s.t1 + 4, 6, "research", { text = "Research screen", app = "empire", section = "research" })
	whiteboard(R, side, s.t1 + 11.5, 5.5, "EXPERIMENT LOG\nhypothesis · run · result", "Whiteboard")
	local placedBench = false
	for _ = 1, 2 do
		local x, z, turned = takeFree(R, s.freeRects, 7, 6.5)
		if x and z then
			local yaw = if turned then FRONT.L else FRONT.F
			local bx, bz = x, z
			if turned then
				bx += 1.6
			else
				bz += 1.6
			end
			labBench(R, bx, bz, yaw, 6.4, dept, not placedBench)
			placedBench = true
		end
	end
	if not placedBench and s.t2 - (s.t1 + 15) &gt;= 7 then
		local wx, wz = wallPoint(R, side, s.t2 - 4, 1.6)
		labBench(R, wx, wz, WALL_YAW[side], 6.4, dept, true)
	end
	cornerPlant(R, "back", opposite(side), deco(R), 1)
end

-- GPU test bench: workbench against a wall with two open chassis on top.
local function gpuBench(R: R, side: string, t: number, L: number)
	local base = wallAt(R, side, t)
	Kit.workbench(R.model, R.cf, base, L, R.seed + math.floor(t))
	for _, sx in { -L / 4, L / 4 } do
		local c = base * CF(sx, 3.2, -1.4)
		Kit.part(R.model, R.cf, "ChassisTray", V3(2.2, 0.15, 1.8), c * CF(0, 0.075, 0), C.metalSoft, M.metal, DETAIL)
		for k = -1, 1, 2 do
			Kit.part(R.model, R.cf, "GPUCard", V3(1.7, 0.9, 0.18), c * CF(0, 0.6, k * 0.35), A.department.compute, M.metal, DETAIL)
		end
	end
	wallClaim(R, "GpuBench", side, t, L, 2.7)
end

local function kitHwlab(R: R)
	local n = R.room.desks or 0
	local dept = "compute"
	local nL = math.min(n, 2)
	local b = shapeB(R, nL, 0, "lab")
	-- right wall: remaining desks at the front, GPU benches behind them
	local g = DESK.lab
	local x = R.inner.right - 0.4 - g.dd / 2
	local zRow = R.inner.front + 0.6
	for i = 1, n - nL do
		local z = zRow + g.p / 2 + (i - 1) * g.p
		station(R, x, z, LOOK.R, "lab")
		stationClaim(R, x, z, LOOK.R, "lab")
	end
	local benchStart = zRow + (n - nL) * g.p + 0.6
	local benchLen = math.min(8, R.inner.back - benchStart - 0.4)
	if benchLen &gt;= 5 then
		local t = benchStart + benchLen / 2
		gpuBench(R, "right", t, benchLen)
		Kit.toolWall(R.model, R.cf, wallAt(R, "right", t), math.min(5, benchLen - 1), R.seed + 9, { y = 8.4 })
		for k = -1, 1, 2 do
			local ax, az = wallPoint(R, "right", t + k * benchLen / 4, 4.2)
			local fx, fz = wallPoint(R, "right", t + k * benchLen / 4, 1.3)
			activity(R, "LabBench", if k &lt; 0 then dept else "engineering", "engineer", ax, az, fx, fz)
		end
	end
	wallScreen(R, "back", (b.cx1 + 0) / 2 - 1, 6, "compute", { text = "Compute monitor", app = "compute" })
	cornerPlant(R, "front", "right", "s", 1)
end

local function interviewTable(R: R, x: number, z: number)
	if not free(R, x - 4.3, x + 4.3, z - 4.3, z + 4.3) then
		return
	end
	Kit.meetingTable(R.model, R.cf, at(R, x, z, 0), "round", 4.6, nil, R.seed + 3)
	for i = 1, 3 do
		local a = RAD(90 + (i - 1) * 120)
		local px, pz = x + math.cos(a) * 3.6, z + math.sin(a) * 3.6
		chair(R, px, pz, math.deg(math.atan2(px - x, pz - z)), 10 + i)
	end
	claim(R, "InterviewTable", x - 4.3, x + 4.3, z - 4.3, z + 4.3)
end

local function kitHr(R: R)
	local n = R.room.desks or 0
	if shapeOf(R) == "A" then
		local s = shapeA(R, n, "ldesk", 7, "x")
		wallScreen(R, s.fside, s.t1 + 4.5, 6, "hr", { text = "People &amp; company", app = "empire", section = "team" })
		Kit.cabinet(R.model, R.cf, wallAt(R, s.fside, s.t1 + 10), 3, 6.5, R.seed + 1)
		wallClaim(R, "Cabinet", s.fside, s.t1 + 10, 3, 1.7)
		lowShelf(R, s.fside, s.t1 + 14.5, 4)
		Kit.deskPrinter(R.model, R.cf, wallAt(R, s.fside, s.t1 + 14.5) * CF(0.8, 2.8, -0.65), { prompt = "HR printer", propId = R.room.id .. "_Printer" })
		local x, z = takeFree(R, s.freeRects, 8.8, 8.8)
		if x and z then
			interviewTable(R, x, z)
		end
	else
		-- two desks along the solid side wall, the rest on the other side; interview table behind them
		local solidSide = if solidish(R.side.left) then "left" else "right"
		local nSolid = math.min(n, 2)
		local nL = if solidSide == "left" then nSolid else n - nSolid
		shapeB(R, nL, n - nL, if R.W &lt;= 24 then "bench" else "ldesk")
		local o = opposite(solidSide)
		local ix = if o == "left" then R.inner.left + 4.6 else R.inner.right - 4.6
		interviewTable(R, ix, R.inner.back - 4.6)
		local st = if solidSide == "left" then R.inner.left + 4 else R.inner.right - 4
		wallScreen(R, "back", st, 5, "hr", { text = "People &amp; company", app = "empire", section = "team" })
	end
	cornerPlant(R, "front", if R.doorX &gt; 0 then "left" else "right", "s", 1)
end

-- Focus room: one desk on a solid side wall, lounge chair + floor lamp in the back corner, low shelf, plant.
local function kitFocus(R: R)
	local side = if solidish(R.side.right) and (not solidish(R.side.left) or R.style % 2 == 1) then "right" else "left"
	local g = DESK.ldesk
	local x = if side == "right" then R.inner.right - 0.4 - g.dd / 2 else R.inner.left + 0.4 + g.dd / 2
	local z = ENTRY + 0.6 + g.p / 2
	station(R, x, z, if side == "right" then LOOK.R else LOOK.L, "ldesk")
	stationClaim(R, x, z, if side == "right" then LOOK.R else LOOK.L, "ldesk")
	local o = opposite(side)
	local lx = if o == "left" then R.inner.left + 2.2 else R.inner.right - 2.2
	local lz = R.inner.back - 2.4
	lounge(R, lx, lz, if o == "left" then -150 else 150, 1, true)
	local lamp = R.style % 2 == 0 or R.level == Plan.founderLevel(R.tier)
	if lamp then
		floorLamp(R, if o == "left" then R.inner.left + 0.9 else R.inner.right - 0.9, R.inner.back - 5, 2)
	end
	local sx = if side == "right" then R.inner.right - 2.6 else R.inner.left + 2.6
	if free(R, sx - 2.1, sx + 2.1, R.inner.back - 1.5, R.inner.back) then
		lowShelf(R, "back", sx, 4)
	end
	if not lamp or R.level == Plan.founderLevel(R.tier) then
		plant(R, if o == "left" then R.inner.left + 1.0 else R.inner.right - 1.0, ENTRY + 1.6, "s", 4)
	end
end

local function kitPhone(R: R)
	local side = if solidish(finishAt(R.tier, R.room, R.sideFace.right, if R.sideFace.right == "E" or R.sideFace.right == "W" then (R.room.z1 + R.room.z2) / 2 + 6 else (R.room.x1 + R.room.x2) / 2)) then "right" else "left"
	local count = if R.D &gt;= 30 and R.tier &lt;= 2 then 3 else 2
	local x = if side == "right" then R.inner.right - 2.7 else R.inner.left + 2.7
	-- booths keep a 2.5-stud gap so each can be walked around
	local pitch = math.min(7.5, (R.zEnd - ENTRY - 1) / count)
	local z0 = R.zEnd - count * pitch
	for i = 1, count do
		local z = z0 + pitch / 2 + (i - 1) * pitch
		Kit.phoneBooth(R.model, R.cf, at(R, x, z, if side == "right" then FRONT.L else FRONT.R), R.room.id .. "_Booth" .. i, R.owner, R.seed + i)
		claim(R, "PhoneBooth", x - 2.5, x + 2.5, z - 2.5, z + 2.5)
	end
	local o = opposite(side)
	local lx = if o == "left" then R.inner.left + 2 else R.inner.right - 2
	lounge(R, lx, R.zEnd - 3, if o == "left" then FRONT.R else FRONT.L, 1, true)
	plant(R, lx, R.zEnd - 6.8, "s", 2)
end

local function kitPrint(R: R)
	-- supplies and paper cabinet on a solid side wall, copier free-standing facing the door
	local side = if solidish(R.side.left) then "left" elseif solidish(R.side.right) then "right" else "left"
	local probe = R.D * 0.7
	if not solidish(finishAt(R.tier, R.room, R.sideFace[side], if R.sideFace[side] == "E" or R.sideFace[side] == "W" then (R.room.z1 + R.room.z2) / 2 else (R.room.x1 + R.room.x2) / 2)) then
		side = opposite(side)
	end
	local _ = probe
	local t1 = R.zEnd - 4
	lowShelf(R, side, t1, 4.5)
	Kit.cabinet(R.model, R.cf, wallAt(R, side, t1 - 5), 3, 4.2, R.seed + 2)
	wallClaim(R, "PaperCabinet", side, t1 - 5, 3, 1.7)
	local cx, cz = 0, R.zEnd - 6
	local b = at(R, cx, cz, FRONT.F)
	-- copier as a PropFx prop: pages slide out of the front and the panel blinks while it copies
	local copier = Kit.propModel(R.model, R.cf, "CopierUnit", b)
	local body = Kit.part(copier, R.cf, "Copier", V3(4, 3.2, 3), b * CF(0, 1.6, 0), C.white, M.smooth)
	body:SetAttribute("FxOut", true)
	Kit.part(copier, R.cf, "CopierScanner", V3(3.6, 0.5, 2.6), b * CF(0, 3.45, 0.1), C.plasterShade, M.smooth)
	local panel = Kit.part(copier, R.cf, "CopierPanel", V3(1.2, 0.08, 0.7), b * CF(1.1, 3.74, -1.0), C.screen, M.smooth, DETAIL)
	panel:SetAttribute("FxGlow", true)
	Kit.part(copier, R.cf, "PaperTray", V3(3.4, 0.06, 0.02), b * CF(0, 1.2, -1.51), C.metalSoft, M.smooth, DETAIL)
	Kit.fx(copier, "paper,blink", { FxColor = C.statusGood, FxRate = 2, FxSeconds = 6, PropId = R.room.id .. "_Copier" })
	Kit.action(body, "prop", "Copier", R.room.id .. "_Copier", { actionText = "Copy", maxDistance = 7 })
	claim(R, "Copier", cx - 2, cx + 2, cz - 1.5, cz + 1.5)
	-- sorting table + recycling bin
	local tz = cz - 7
	local tb = at(R, 0, tz, 0)
	Kit.part(R.model, R.cf, "SortingTable", V3(5, 0.2, 2.4), tb * CF(0, 3.1, 0), C.oakLight, M.wood)
	for _, s in { -1, 1 } do
		Kit.part(R.model, R.cf, "TableLeg", V3(0.25, 3.0, 2.0), tb * CF(s * 2.2, 1.5, 0), C.metal, M.metal)
	end
	claim(R, "SortingTable", -2.5, 2.5, tz - 1.2, tz + 1.2)
	local o = opposite(side)
	local bx = if o == "left" then R.inner.left + 1 else R.inner.right - 1
	Kit.cylinder(R.model, R.cf, "RecyclingBin", "y", 2.2, 1.4, at(R, bx, R.zEnd - 2) * CF(0, 1.1, 0), C.sage, M.smooth)
	claim(R, "Bin", bx - 0.7, bx + 0.7, R.zEnd - 2.7, R.zEnd - 1.3)
	cornerPlant(R, "front", if R.doorX &gt; 0 then "left" else "right", "s", 1)
end

---------------------------------------------------------------------------------------------
-- Meeting rooms, boardroom
---------------------------------------------------------------------------------------------
-- Chair at (x, z) facing the table point (tx, tz) + Meeting activity beside it.
local function meetingSeat(R: R, x: number, z: number, tx: number, tz: number, meetingId: string, dept: string, n: number, executive: boolean?, gap: number?)
	local yaw = math.deg(math.atan2(x - tx, z - tz)) -- front (-Z) towards the table
	local cfr = at(R, x, z, yaw)
	local seat
	if executive then
		local m = Instance.new("Model")
		m.Name = "ExecutiveChair"
		seat = Kit.officeChair(m, R.cf, cfr, R.seed + n, { lite = true, arms = true, color = C.leather })
		m.Parent = R.model
		trim(m, 4)
	else
		seat = chair(R, x, z, yaw, n)
	end
	-- stand beside the chair, slightly behind it
	local th = RAD(yaw)
	local backX, backZ = math.sin(th), math.cos(th)
	local sideX, sideZ = math.cos(th), -math.sin(th)
	local side = (gap or 3.4) / 2
	local ax, az = x + backX * 1.6 + sideX * side, z + backZ * 1.6 + sideZ * side
	activity(R, "Meeting", dept, "any", ax, az, tx, tz, seat, { meetingRoom = meetingId })
end

local function reviewRoom(room: Plan.Room): boolean
	local n = string.lower(room.name)
	return string.find(n, "review", 1, true) ~= nil or string.find(n, "results", 1, true) ~= nil or string.find(n, "paper", 1, true) ~= nil
end

local function kitMeeting(R: R)
	local seats = R.room.seats or 6
	local meetingId = R.room.meeting or R.room.id
	local dept = if reviewRoom(R.room) then "evaluation" else "social"
	local z1, z2 = ENTRY, R.zEnd
	local zc = (z1 + z2) / 2
	local shape = if seats &lt;= 4 then "round" elseif seats &lt;= 6 then "rect" else "boat"
	local perSide = math.ceil(seats / 2)
	local L = if shape == "round" then 5.5 elseif shape == "rect" then perSide * 3.4 + 1.2 else perSide * 3.3 + 3
	local Wt = if shape == "boat" then 5.5 else 4.5
	local axis = if (R.inner.right - R.inner.left) &gt;= (z2 - z1) then "x" else "z"
	local tableAt = at(R, 0, zc, if axis == "x" then 0 else 90)
	Kit.meetingTable(R.model, R.cf, tableAt, shape, L, Wt, R.seed + 1)
	-- conference speakerphone: its ring glows while this room's meeting runs (FxGate Meeting)
	Kit.speakerphone(R.model, R.cf, tableAt * CF(if shape == "round" then 0 else math.min(1.8, L / 4), 3.15, 0), meetingId)
	local n = 0
	if shape == "round" then
		for i = 1, seats do
			local a = RAD(45 + (i - 1) * 360 / seats)
			n += 1
			meetingSeat(R, math.cos(a) * (L / 2 + 1.6), zc + math.sin(a) * (L / 2 + 1.6), 0, zc, meetingId, dept, n)
		end
		claim(R, "MeetingTable", -(L / 2 + 2.7), L / 2 + 2.7, zc - L / 2 - 2.7, zc + L / 2 + 2.7)
	else
		local span = (perSide - 1) * 3.3
		for sgn = -1, 1, 2 do
			for i = 1, perSide do
				if n &gt;= seats then
					break
				end
				local a = -span / 2 + (i - 1) * 3.3
				n += 1
				local off = Wt / 2 + 1.5
				if axis == "x" then
					meetingSeat(R, a, zc + sgn * off, a, zc, meetingId, dept, n, false, 3.3)
				else
					meetingSeat(R, sgn * off, zc + a, 0, zc + a, meetingId, dept, n, false, 3.3)
				end
			end
		end
		local hl, hw = L / 2, Wt / 2 + 2.6
		if axis == "x" then
			claim(R, "MeetingTable", -hl, hl, zc - hw, zc + hw)
		else
			claim(R, "MeetingTable", -hw, hw, zc - hl, zc + hl)
		end
	end
	-- screen at one table end, whiteboard at the other (or beside the screen)
	local endA, endB
	if axis == "x" then
		endA, endB = "left", "right"
		if solidish(R.side.right) and not solidish(R.side.left) then
			endA, endB = "right", "left"
		end
	else
		endA, endB = "back", "front"
	end
	local tScreen = if axis == "x" then zc else 0
	local screen = wallScreen(R, endA, tScreen, 7, "meeting", nil, 6.2)
	screen:SetAttribute("MeetingRoom", meetingId)
	if axis == "x" and solidish(R.side[endA]) and seats &gt;= 8 then
		credenza(R, endA, tScreen, 6)
	end
	if axis == "x" and solidish(R.side[endB]) then
		whiteboard(R, endB, zc, 6, "AGENDA\n1  status\n2  decisions\n3  next steps")
	elseif axis == "x" and solidish(R.side[endA]) and z2 - (tScreen + 4) &gt;= 6.5 then
		whiteboard(R, endA, tScreen + 7.5, 5, "AGENDA\n1  status\n2  decisions\n3  next steps")
	else
		local wx = if R.doorX &gt; 0 then R.inner.left + 4 else R.inner.right - 4
		local wz = R.zEnd - 0.8
		if free(R, wx - 3.4, wx + 3.4, wz - 1, wz + 0.8) then
			local base = at(R, wx, wz, 0)
			Kit.whiteboard(R.model, R.cf, base, 5, "AGENDA\n1  status\n2  decisions", R.seed + 4, { y = 5 })
			for _, sx in { -1, 1 } do
				Kit.part(R.model, R.cf, "BoardStand", V3(0.2, 7.2, 0.2), base * CF(sx * 2.7, 3.6, -0.1), C.metalSoft, M.metal)
			end
			Kit.part(R.model, R.cf, "BoardFoot", V3(5.8, 0.15, 1.8), base * CF(0, 0.075, -0.1), C.metalSoft, M.metal)
			claim(R, "BoardStand", wx - 3, wx + 3, wz - 1, wz + 0.8)
		end
	end
	if seats &gt; 4 then
		cornerPlant(R, "back", if R.doorX &gt; 0 then "left" else "right", "s", 1)
	end
end

local function kitBoardroom(R: R)
	local seats = R.room.seats or 12
	local meetingId = R.room.meeting or "Boardroom"
	local zc = (ENTRY + R.zEnd) / 2
	local perSide = math.ceil(seats / 2)
	local L = perSide * 3.5 + 4
	local Wt = 6
	Kit.meetingTable(R.model, R.cf, at(R, 0, zc, 0), "boat", L, Wt, R.seed + 1)
	Kit.speakerphone(R.model, R.cf, at(R, 2.2, zc, 0) * CF(0, 3.15, 0), meetingId)
	local n = 0
	local span = (perSide - 1) * 3.5
	for sgn = -1, 1, 2 do
		for i = 1, perSide do
			if n &gt;= seats then
				break
			end
			n += 1
			local a = -span / 2 + (i - 1) * 3.5
			meetingSeat(R, a, zc + sgn * (Wt / 2 + 1.5), a, zc, meetingId, "executive", n, true, 3.5)
		end
	end
	claim(R, "BoardTable", -L / 2, L / 2, zc - Wt / 2 - 2.6, zc + Wt / 2 + 2.6)
	local side = featureSide(R)
	local screen = wallScreen(R, side, zc, 10, "boardroom", { text = "Boardroom screen", app = "empire", section = "board" }, 6.4)
	screen:SetAttribute("MeetingRoom", meetingId)
	credenza(R, side, zc, 9)
	Kit.artwork(R.model, R.cf, wallAt(R, side, math.min(R.zEnd - 3, zc + 9.5)), 4, 3.2, R.seed + 2, { y = 6 })
	cornerPlant(R, "back", "left", "m", 1)
	cornerPlant(R, "back", "right", "m", 2)
	Kit.pendant(R.model, R.cf, at(R, 0, zc) * CF(0, Kit.CEILING - Kit.FINISH, 0), "founder", { drop = 4 })
end

---------------------------------------------------------------------------------------------
-- Pantry, lounge
---------------------------------------------------------------------------------------------
local function kitPantry(R: R)
	local side = featureSide(R)
	local L = 12
	local t = ENTRY + 2 + L / 2
	local k = Kit.kitchenette(R.model, R.cf, wallAt(R, side, t), L, R.seed + 1)
	wallClaim(R, "Kitchenette", side, t, L, 2.4)
	-- the coffee machine sits at kitchenette-local x = -L/2 + (L-2.4) - 1, which runs along +t on this wall
	local alongSign = if side == "left" then 1 elseif side == "right" then -1 else 1
	local coffeeT = t + alongSign * (-L / 2 + (L - 2.4) - 1.0)
	for i = 1, 3 do
		local tt = coffeeT - alongSign * (i - 1) * 2.2
		local ax, az = wallPoint(R, side, tt, 2.3 + 1.7)
		local fx, fz = wallPoint(R, side, tt, 1)
		activity(R, "Coffee", "kitchen", "any", ax, az, fx, fz)
	end
	local _ = k
	-- bar table with stools
	local o = opposite(side)
	local bx = (R.inner.left + R.inner.right) / 2 + (if o == "left" then -2 else 2)
	local bz = R.zEnd - 6
	local b = at(R, bx, bz, 0)
	Kit.cylinder(R.model, R.cf, "BarTableTop", "y", 0.2, 3.4, b * CF(0, 3.6, 0), C.oak, M.wood)
	Kit.cylinder(R.model, R.cf, "BarTableColumn", "y", 3.4, 0.4, b * CF(0, 1.8, 0), C.metal, M.metal)
	Kit.cylinder(R.model, R.cf, "BarTableFoot", "y", 0.15, 2.0, b * CF(0, 0.075, 0), C.metal, M.metal)
	for i = 1, 2 do
		local a = RAD(-90 + (i - 1) * 180)
		local sx, sz = bx + math.cos(a) * 2.5, bz + math.sin(a) * 2.5
		Kit.stool(R.model, R.cf, at(R, sx, sz, math.deg(math.atan2(sx - bx, sz - bz))), R.seed + i, 3.0)
	end
	claim(R, "BarTable", bx - 3.3, bx + 3.3, bz - 3.3, bz + 3.3)
	-- bin next to the kitchenette, plants
	local bt = t - alongSign * (L / 2 + 1.2)
	local wx, wz = wallPoint(R, side, bt, 0.9)
	if free(R, wx - 0.7, wx + 0.7, wz - 0.7, wz + 0.7) then
		Kit.cylinder(R.model, R.cf, "Bin", "y", 1.8, 1.2, at(R, wx, wz) * CF(0, 0.9, 0), C.metalSoft, M.metal)
		claim(R, "Bin", wx - 0.7, wx + 0.7, wz - 0.7, wz + 0.7)
	end
	cornerPlant(R, "back", o, "s", 2)
end

local function kitLounge(R: R)
	local zc = (ENTRY + R.zEnd) / 2 + 0.5
	local cx = 0
	Kit.rug(R.model, R.cf, at(R, cx, zc, 0), 13, 9, R.seed + 1)
	local seats = sofa(R, cx, zc + 3.3, FRONT.F, 8, 2)
	claim(R, "Sofa", cx - 4, cx + 4, zc + 1.8, zc + 4.8)
	local s1 = lounge(R, cx - 5.2, zc - 0.6, FRONT.R, 3)
	local s2 = lounge(R, cx + 5.2, zc - 0.6, FRONT.L, 4)
	coffeeTable(R, cx, zc - 0.6, 3.6, 2.2, 5)
	for _, s in seats do
		seatActivity(R, "Lounge", "lounge", s, 2.2)
	end
	seatActivity(R, "Lounge", "lounge", s1, 1.9)
	seatActivity(R, "Lounge", "lounge", s2, 1.9)
	floorLamp(R, cx + 5.4, zc + 3.6, 6)
	-- bookshelf on a solid wall, plants, a standing conversation spot by the window
	local side = featureSide(R)
	Kit.bookshelf(R.model, R.cf, wallAt(R, side, zc), 6, 5, R.seed + 7, { books = 3 })
	wallClaim(R, "Bookshelf", side, zc, 6, 1.4)
	cornerPlant(R, "back", opposite(side), "l", 1)
	local tz = R.zEnd - 1.5
	local tx = if side == "left" then R.inner.right - 6 else R.inner.left + 6
	if R.D - zc &lt; 12 then
		tz = ENTRY + 1.5
		tx = if R.doorX &gt; 0 then R.inner.left + 5 else R.inner.right - 5
	end
	local group = R.room.id .. "_Talk"
	activity(R, "Conversation", "social", "any", tx - 1.2, tz, tx + 1.2, tz, nil, { conversationGroup = group })
	activity(R, "Conversation", "social", "any", tx + 1.2, tz, tx - 1.2, tz, nil, { conversationGroup = group })
	-- aquarium (PropFx, always on near the camera) on the far side of the back wall, clear of the
	-- standing conversation spot
	local ax = if tx &gt; 0 then R.inner.left + 3.2 else R.inner.right - 3.2
	local az = R.zEnd - 1.3
	local clearOfTalk = math.abs(ax - tx) &gt; 5 or math.abs(az - tz) &gt; 2.6
	if clearOfTalk and free(R, ax - 2.3, ax + 2.3, az - 1, az + 1) then
		Kit.aquarium(R.model, R.cf, at(R, ax, az, 0), R.seed + 11)
		claim(R, "Aquarium", ax - 2.3, ax + 2.3, az - 1, az + 1)
	end
end

---------------------------------------------------------------------------------------------
-- Restrooms
---------------------------------------------------------------------------------------------
-- Toilet against a wall: `base` = wall surface frame (front towards the room).
local function toilet(R: R, base: CFrame, key: string, ownerOnly: boolean)
	Kit.part(R.model, R.cf, "ToiletBowl", V3(1.5, 1.4, 2.2), base * CF(0, 0.7, -1.3), C.white, M.smooth)
	Kit.part(R.model, R.cf, "ToiletTank", V3(1.9, 2.2, 0.7), base * CF(0, 2.4, -0.35), C.white, M.smooth)
	local seat = Kit.seat(R.model, R.cf, "ToiletSeat", V3(1.5, 0.2, 1.8), base * CF(0, 1.5, -1.4), C.white, M.smooth, { canTouch = false })
	seat.Disabled = true
	seat.Transparency = 0
	seat:SetAttribute("FixtureKey", key)
	Kit.action(seat, "toilet", "Toilet", nil, { actionText = "Use", maxDistance = 6, ownerOnly = ownerOnly })
	local flush = Kit.part(R.model, R.cf, "FlushButton", V3(0.6, 0.35, 0.08), base * CF(0, 3.0, -0.74), C.metalSoft, M.metal, { canCollide = false, canTouch = false })
	flush:SetAttribute("FixtureKey", key)
	Kit.action(flush, "flush", "Flush", nil, { actionText = "Flush", maxDistance = 6, ownerOnly = ownerOnly })
	local water = Kit.part(R.model, R.cf, "ToiletWater", V3(1.0, 0.05, 1.2), base * CF(0, 1.32, -1.45), C.water, M.smooth, { detail = true, transparency = 0.25 })
	water:SetAttribute("FixtureKey", key)
	Kit.fx(water, "flow", { FxAxis = "y", FxTravel = -0.3, FxRate = 3, FxSeconds = 2 })
end

-- Basin on a counter: `base` = wall surface frame at the basin centre.
local function basin(R: R, base: CFrame, key: string, ownerOnly: boolean)
	Kit.part(R.model, R.cf, "Basin", V3(1.6, 0.35, 1.3), base * CF(0, 3.1, -0.95), C.white, M.smooth)
	local tap = Kit.part(R.model, R.cf, "Tap", V3(0.2, 0.7, 0.5), base * CF(0, 3.55, -0.35), C.metalSoft, M.metal, { canCollide = false })
	tap:SetAttribute("FixtureKey", key)
	Kit.action(tap, "tap", "Tap", nil, { actionText = "Wash hands", maxDistance = 6, ownerOnly = ownerOnly })
	local water = Kit.part(R.model, R.cf, "TapWater", V3(0.15, 0.55, 0.15), base * CF(0, 3.25, -0.6), C.water, M.smooth, { detail = true, transparency = 1 })
	water:SetAttribute("FixtureKey", key)
	water:SetAttribute("FxShow", 0.5)
	Kit.fx(water, "flow", { FxSeconds = 6 })
end

local function kitWc(R: R)
	-- three cubicles along a solid side wall, basins along the other side
	local side = if solidish(R.side.right) then "right" else "left"
	local o = opposite(side)
	local depth = 6
	local cw = (R.inner.back - (ENTRY + 3)) / 3
	cw = math.min(cw, 5.6)
	local zStart = R.inner.back - 3 * cw
	local wallX = if side == "right" then R.inner.right else R.inner.left
	local frontX = wallX + (if side == "right" then -depth else depth)
	local sgnIn = if side == "right" then 1 else -1 -- +x local points into the cubicles for a right wall
	local doorsFolder = R.ctx.folders.Doors
	for i = 1, 3 do
		local za = zStart + (i - 1) * cw
		local zb = za + cw
		local key = R.room.id .. "_C" .. i
		-- side partition at za (the last cubicle ends at the back wall)
		Kit.part(R.model, R.cf, "CubiclePartition", V3(depth, 7.2, 0.15), at(R, (wallX + frontX) / 2, za) * CF(0, 3.6, 0), C.white, M.smooth)
		-- door opening at the +z end of the front, fixed panel at the -z end
		local ow = 3.6
		local oz2 = zb - 0.15
		local oz1 = oz2 - ow
		Kit.part(R.model, R.cf, "CubicleFront", V3(0.15, 7.2, oz1 - za - 0.075), at(R, frontX, (za + 0.075 + oz1) / 2) * CF(0, 3.6, 0), C.white, M.smooth)
		local centre = pt(R, frontX, 0, (oz1 + oz2) / 2)
		local def: any = {
			id = key,
			level = R.level,
			room = R.room.id,
			kind = "cubicle",
			access = "staff",
			axis = if math.abs(R.rf.RightVector.X) &gt; 0.5 then "x" else "z",
			x = centre.X,
			z = centre.Z,
			w = ow,
			h = 7.2,
			inward = R.rf:VectorToWorldSpace(V3(sgnIn, 0, 0)),
			exterior = false,
			hidden = false,
			builder = "interior",
			y = centre.Y,
			thickness = 0.15,
		}
		-- for a left wall the hinge must stay at the +z end of the opening
		if side == "left" then
			def.hinge = "right"
		end
		local door = Kit.door(doorsFolder, R.cf, def :: any, R.owner)
		if door then
			door:SetAttribute("FixtureKey", key)
		end
		-- toilet against the side wall, centred in the cubicle
		local tz = (za + zb) / 2 - 0.4
		toilet(R, wallAt(R, side, tz), key, false)
		claim(R, "Cubicle" .. i, math.min(wallX, frontX), math.max(wallX, frontX), za, zb)
	end
	-- vanity with two basins on the other wall
	local vL = 7.2
	local vt = ENTRY + 2.5 + vL / 2
	local vb = wallAt(R, o, vt)
	Kit.part(R.model, R.cf, "VanityTop", V3(vL, 0.25, 2.0), vb * CF(0, 2.85, -1.0), C.stone, M.marble)
	Kit.part(R.model, R.cf, "VanityBase", V3(vL - 0.4, 2.4, 1.6), vb * CF(0, 1.5, -0.85), C.oak, M.wood)
	Kit.part(R.model, R.cf, "Mirror", V3(vL - 0.4, 3.4, 0.08), vb * CF(0, 5.6, -0.05), C.glassDeep, M.glass, { detail = true, reflectance = 0.25 })
	local alongSign = if o == "left" then 1 elseif o == "right" then -1 else 1
	for i = 1, 2 do
		basin(R, vb * CF((i - 1.5) * 3.4 * alongSign * alongSign, 0, 0), R.room.id .. "_T" .. i, false)
	end
	wallClaim(R, "Vanity", o, vt, vL, 2.1)
	local dt = math.min(R.inner.back - 2, vt + vL / 2 + 3)
	local dryer = Kit.part(R.model, R.cf, "HandDryer", V3(1.0, 1.4, 0.7), wallAt(R, o, dt) * CF(0, 4.6, -0.35), C.white, M.smooth, DETAIL)
	local air = Kit.steamEmitter(dryer, "WarmAir", 6, 0.2)
	air.EmissionDirection = Enum.NormalId.Bottom
	Kit.fx(dryer, "steam", { FxSeconds = 4 })
	Kit.action(dryer, "prop", "Hand dryer", nil, { actionText = "Dry hands", maxDistance = 6 })
	-- the cleaner wipes the vanity here (Clean activity, support staff)
	local cx, cz = wallPoint(R, o, vt, 2.1 + 1.7)
	local fx2, fz2 = wallPoint(R, o, vt, 0.5)
	activity(R, "Clean", "operations", "support", cx, cz, fx2, fz2, nil, { attributes = { JobPose = "wipe", JobItem = "sponge" } })
end

---------------------------------------------------------------------------------------------
-- Founder suite
---------------------------------------------------------------------------------------------
local function kitFounderOffice(R: R)
	-- frame: entry wall = the assistant's door (west); +x of the frame runs towards the setback facade
	local deskX, deskZ = 6, R.inner.back - 8.4
	local desk = station(R, deskX, deskZ, LOOK.F, "ldesk", "executive")
	desk:SetAttribute("Role", "founder") -- the founder's own desk: no employee takes it
	claim(R, "FounderDesk", deskX - 3.5, deskX + 3.5, deskZ - 1.7, deskZ + 4.5)
	local top = desk:FindFirstChild("DeskTop")
	local deskAt = at(R, deskX, deskZ, LOOK.F)
	local topY = if top and top:IsA("BasePart") then top.Size.Y / 2 + 3.0 else 3.15
	local term = Kit.part(R.model, R.cf, "FounderTerminal", V3(1.8, 1.2, 0.15), deskAt * CF(-2.4, topY + 0.65, 0.9) * ANG(0, RAD(-15), 0), C.screen, M.smooth, { canCollide = false })
	Kit.action(term, "ownerComputer", "Founder computer · whole company", "empire", { ownerOnly = true, actionText = "Open", maxDistance = 8 })
	local tablet = Kit.part(R.model, R.cf, "FounderCameraTablet", V3(1.2, 0.08, 1.6), deskAt * CF(2.3, topY + 0.04, -0.3) * ANG(0, RAD(20), 0), C.metal, M.smooth, { canCollide = false })
	Kit.action(tablet, "security", "Security cameras", nil, { ownerOnly = true, actionText = "View", maxDistance = 8 })
	-- visitor chairs in front of the desk
	for i, vx in { deskX - 1.8, deskX + 1.8 } do
		local vz = deskZ - 4.6
		chair(R, vx, vz, FRONT.B, 20 + i, C.leather)
		claim(R, "VisitorChair", vx - 1.05, vx + 1.05, vz - 1, vz + 1)
	end
	-- entry wall: bookshelf, history screen, founder screen over a credenza, milestones screen
	local W2 = R.W / 2
	Kit.bookshelf(R.model, R.cf, wallAt(R, "front", -W2 + 7), 8, 9, R.seed + 2, { books = 3 })
	wallClaim(R, "Bookshelf", "front", -W2 + 7, 8, 1.4)
	wallScreen(R, "front", -6.5, 5, "history", nil, 6.2)
	credenza(R, "front", 11.5, 8)
	wallScreen(R, "front", 11.5, 7, "founder", { text = "Founder screen", app = "empire" }, 6.4)
	wallScreen(R, "front", W2 - 5, 5, "milestones", { text = "Milestones", app = "empire", section = "milestones" }, 6.2)
	-- seating group on a rug
	local gx, gz = -9, 15.5
	Kit.rug(R.model, R.cf, at(R, gx, gz, 0), 13, 10, R.seed + 3)
	sofa(R, gx, gz + 4.2, FRONT.F, 8, 4)
	claim(R, "Sofa", gx - 4, gx + 4, gz + 2.7, gz + 5.7)
	lounge(R, gx - 5.6, gz - 0.3, FRONT.R, 5)
	lounge(R, gx + 5.6, gz - 0.3, FRONT.L, 6)
	coffeeTable(R, gx, gz - 0.3, 4, 2.4, 7)
	Kit.pendant(R.model, R.cf, at(R, gx, gz) * CF(0, Kit.CEILING - Kit.FINISH, 0), "founder", { drop = 3.5 })
	-- art between the library and bath doors, plants
	local doorZ: { number } = {}
	for _, d in R.doors do
		if d.side == "left" then
			table.insert(doorZ, d.z)
		end
	end
	table.sort(doorZ)
	local artZ = if #doorZ &gt;= 2 then (doorZ[1] + doorZ[2]) / 2 else gz
	Kit.artwork(R.model, R.cf, wallAt(R, "left", artZ), 5, 3.6, R.seed + 8, { y = 6 })
	cornerPlant(R, "back", "left", "l", 1)
	cornerPlant(R, "back", "right", "l", 2)
	cornerPlant(R, "front", "right", "m", 3)
end

local function kitFounderAssist(R: R)
	-- reception desk facing the entry door, waiting chairs along the side wall
	local dx, dz = -R.W / 4, R.inner.back - 7.5
	if dx &gt; R.doorX - 7 and dx &lt; R.doorX + 7 then
		dx = R.doorX - 9
	end
	station(R, dx, dz, LOOK.F, "ldesk", "operations")
	claim(R, "ReceptionDesk", dx - 4, dx + 4, dz - 2.5, dz + 4.5)
	local led = at(R, dx, dz - 2.3, 0)
	Kit.part(R.model, R.cf, "ReceptionFront", V3(8, 3.6, 0.4), led * CF(0, 1.8, 0), C.oak, M.wood)
	Kit.part(R.model, R.cf, "ReceptionLedge", V3(8.4, 0.15, 1.0), led * CF(0, 3.675, -0.2), C.stone, M.marble)
	local side = if R.doorX &gt; 0 then "left" else "right"
	local wx = if side == "right" then R.inner.right - 1.4 else R.inner.left + 1.4
	for i = 1, 3 do
		local wz = ENTRY + 1 + (i - 1) * 2.8
		chair(R, wx, wz, if side == "right" then FRONT.L else FRONT.R, i, C.fabricSand)
		claim(R, "WaitingChair", wx - 1.05, wx + 1.05, wz - 1, wz + 1)
	end
	Kit.artwork(R.model, R.cf, wallAt(R, side, ENTRY + 3.8), 4.5, 3, R.seed + 5, { y = 6.8 })
	Kit.artwork(R.model, R.cf, wallAt(R, opposite(side), (ENTRY + R.zEnd) / 2), 4, 3, R.seed + 6, { y = 6 })
	cornerPlant(R, "back", side, "l", 1)
	cornerPlant(R, "front", opposite(side), "m", 2)
end

local function kitFounderLibrary(R: R)
	local W2 = R.W / 2
	local n = 2
	for i = 1, n do
		local t = (i - 1.5) * 9
		Kit.bookshelf(R.model, R.cf, wallAt(R, "back", t), 6.2, 9, R.seed + i, { books = 3, color = C.oakDark })
		wallClaim(R, "Bookshelf", "back", t, 6.2, 1.4)
	end
	local lt = ENTRY + 2
	Kit.bookshelf(R.model, R.cf, wallAt(R, "left", lt), 5, 9, R.seed + 9, { books = 3, color = C.oakDark })
	wallClaim(R, "Bookshelf", "left", lt, 5, 1.4)
	-- reading corner
	Kit.rug(R.model, R.cf, at(R, -W2 + 7, R.inner.back - 6, 0), 7, 5, R.seed + 3)
	lounge(R, -W2 + 5.5, R.inner.back - 5.6, -130, 4)
	floorLamp(R, -W2 + 2.4, R.inner.back - 3.2, 5)
	-- sideboard with the report printer
	local st = ENTRY + 1
	Kit.sideboard(R.model, R.cf, wallAt(R, "right", st), 5, R.seed + 6)
	wallClaim(R, "Sideboard", "right", st, 5.1, 1.7)
	local printer = Kit.part(R.model, R.cf, "ReportPrinter", V3(1.6, 0.9, 1.3), wallAt(R, "right", st + 0.8) * CF(0, 2.82 + 0.45, -0.85), C.white, M.smooth, { canCollide = false })
	Kit.fx(printer, "paper", { FxSeconds = 3 })
	Kit.action(printer, "report", "Report printer", nil, { ownerOnly = true, actionText = "Print report", maxDistance = 8 })
	plant(R, R.inner.right - 1.4, R.inner.back - 2.8, "m", 7)
end

local function kitFounderBath(R: R)
	-- shower niche in the back corner away from the facade, WC beside it, basin near the door
	local sideS = if R.side.left == "facade" then "right" else "left"
	local sgn = if sideS == "left" then 1 else -1
	local wallX = if sideS == "left" then R.inner.left else R.inner.right
	local sx1 = wallX
	local sx2 = wallX + sgn * 5
	local sz1 = R.inner.back - 5
	local cx = (sx1 + sx2) / 2
	Kit.part(R.model, R.cf, "ShowerTray", V3(5, 0.15, 5), at(R, cx, (sz1 + R.inner.back) / 2) * CF(0, 0.075, 0), C.white, M.tile)
	Kit.part(R.model, R.cf, "ShowerGlass", V3(0.12, 7.6, 5), at(R, sx2, (sz1 + R.inner.back) / 2) * CF(0, 3.9, 0), C.glass, M.glass, GLASS)
	Kit.part(R.model, R.cf, "ShowerGlassFront", V3(2.4, 7.6, 0.12), at(R, wallX + sgn * 1.2, sz1) * CF(0, 3.9, 0), C.glass, M.glass, GLASS)
	local hb = wallAt(R, "back", cx)
	local head = Kit.part(R.model, R.cf, "ShowerHead", V3(0.9, 0.15, 0.9), hb * CF(0, 8.2, -0.9), C.metalSoft, M.metal, { canCollide = false })
	Kit.part(R.model, R.cf, "ShowerArm", V3(0.12, 0.12, 0.9), hb * CF(0, 8.3, -0.45), C.metalSoft, M.metal, DETAIL)
	head:SetAttribute("FixtureKey", R.room.id .. "_S1")
	Kit.action(head, "shower", "Shower", nil, { actionText = "Shower", maxDistance = 7, ownerOnly = true })
	local water = Kit.part(R.model, R.cf, "ShowerWater", V3(0.8, 7.9, 0.8), hb * CF(0, 4.2, -0.9), C.water, M.smooth, { detail = true, transparency = 1 })
	water:SetAttribute("FixtureKey", R.room.id .. "_S1")
	claim(R, "Shower", math.min(sx1, sx2), math.max(sx1, sx2), sz1, R.inner.back)
	-- toilet on the back wall next to the shower
	local tx = sx2 + sgn * 3
	toilet(R, wallAt(R, "back", tx), R.room.id .. "_W1", true)
	claim(R, "Toilet", tx - 1, tx + 1, R.inner.back - 2.5, R.inner.back)
	-- basin on the side wall near the entry
	local bt = ENTRY + 2.2
	local vb = wallAt(R, sideS, bt)
	Kit.part(R.model, R.cf, "VanityTop", V3(3.2, 0.25, 2.0), vb * CF(0, 2.85, -1.0), C.stone, M.marble)
	Kit.part(R.model, R.cf, "VanityBase", V3(2.8, 2.4, 1.6), vb * CF(0, 1.5, -0.85), C.oakDark, M.wood)
	Kit.part(R.model, R.cf, "Mirror", V3(2.8, 3.2, 0.08), vb * CF(0, 5.6, -0.05), C.glassDeep, M.glass, { detail = true, reflectance = 0.25 })
	basin(R, vb, R.room.id .. "_T1", true)
	wallClaim(R, "Vanity", sideS, bt, 3.2, 2.1)
	Kit.part(R.model, R.cf, "TowelRail", V3(2.4, 0.1, 0.25), wallAt(R, opposite(sideS), ENTRY + 3) * CF(0, 4.4, -0.2), C.brass, M.metal, DETAIL)
	Kit.part(R.model, R.cf, "Towel", V3(2.0, 1.6, 0.12), wallAt(R, opposite(sideS), ENTRY + 3) * CF(0, 3.6, -0.3), C.white, M.fabric, DETAIL)
	cornerPlant(R, "front", opposite(sideS), "s", 1)
end

---------------------------------------------------------------------------------------------
-- Terraces (founder level, outdoor)
---------------------------------------------------------------------------------------------
local function parasol(R: R, x: number, z: number)
	local b = at(R, x, z)
	Kit.cylinder(R.model, R.cf, "ParasolBase", "y", 0.3, 1.6, b * CF(0, 0.15, 0), C.stoneDeep, M.concrete)
	Kit.cylinder(R.model, R.cf, "ParasolPole", "y", 7.6, 0.2, b * CF(0, 4.0, 0), C.metal, M.metal)
	Kit.cylinder(R.model, R.cf, "ParasolCanopy", "y", 0.35, 8, b * CF(0, 7.9, 0), C.fabricSand, M.fabric, { canCollide = false, castShadow = true })
	claim(R, "Parasol", x - 0.8, x + 0.8, z - 0.8, z + 0.8)
end

local function pergola(R: R, x: number, z: number, w: number, d: number)
	local b = at(R, x, z)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.part(R.model, R.cf, "PergolaPost", V3(0.5, 8.5, 0.5), b * CF(sx * (w / 2 - 0.25), 4.25, sz * (d / 2 - 0.25)), C.oakDark, M.wood)
		end
		Kit.part(R.model, R.cf, "PergolaBeam", V3(0.4, 0.6, d), b * CF(sx * (w / 2 - 0.25), 8.8, 0), C.oakDark, M.wood)
	end
	local slats = math.floor(w / 1.4)
	for i = 1, slats do
		Kit.part(R.model, R.cf, "PergolaSlat", V3(0.3, 0.4, d + 0.6), b * CF(-w / 2 + (i - 0.5) * w / slats, 9.3, 0) * ANG(0, 0, 0), C.oak, M.wood, DETAIL)
	end
	-- ceiling fan hanging from the middle slat (PropFx, turns during working hours)
	local mid = math.ceil(slats / 2)
	Kit.ceilingFan(R.model, R.cf, b * CF(-w / 2 + (mid - 0.5) * w / slats, 9.1, 0), math.min(4, d - 1))
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			claim(R, "PergolaPost", x + sx * (w / 2 - 0.25) - 0.25, x + sx * (w / 2 - 0.25) + 0.25, z + sz * (d / 2 - 0.25) - 0.25, z + sz * (d / 2 - 0.25) + 0.25)
		end
	end
end

local function kitTerrace(R: R)
	local staff = R.access ~= "founder"
	local zMid = (R.inner.front + FACADE_GAP + R.inner.back - 4) / 2
	-- planters along the railing (kept 1.5 studs off it)
	local pz = R.inner.back - 1.5 - 1.2
	local span = R.inner.right - R.inner.left - 4
	local count = math.max(2, math.floor(span / 20))
	local pitch = span / count
	for i = 1, count do
		local px = R.inner.left + 2 + (i - 0.5) * pitch
		local w = math.min(9, pitch - 4)
		if free(R, px - w / 2, px + w / 2, pz - 1.2, pz + 1.2) then
			Kit.planter(R.model, R.cf, at(R, px, pz, 0), w, 2.4, R.seed + i)
			claim(R, "Planter", px - w / 2, px + w / 2, pz - 1.2, pz + 1.2)
		end
	end
	-- seating groups: two lounge chairs facing each other across a low table + shade
	local groups = if staff then 3 else 1
	local gpitch = span / groups
	local loungeActs = 0
	for g = 1, groups do
		local gx = R.inner.left + 2 + (g - 0.5) * gpitch
		-- keep clear of door zones
		for _, k in R.keep do
			if gx + 6 &gt; k.x1 and gx - 6 &lt; k.x2 then
				gx = if gx &lt; (k.x1 + k.x2) / 2 then k.x1 - 7 else k.x2 + 7
			end
		end
		local gz = zMid
		local a = lounge(R, gx - 2.9, gz, FRONT.R, g * 3, true)
		local b = lounge(R, gx + 2.9, gz, FRONT.L, g * 3 + 1, true)
		coffeeTable(R, gx, gz, 2.2, 2.2, g * 3 + 2)
		if staff and loungeActs &lt; 2 then
			seatActivity(R, "Lounge", "roof", a, 1.6)
			loungeActs += 1
			if loungeActs &lt; 2 then
				seatActivity(R, "Lounge", "roof", b, 1.6)
				loungeActs += 1
			end
		end
		if staff and g == 2 then
			pergola(R, gx, gz, 11, 6.5)
		else
			parasol(R, gx + 5.6, gz - 2.2)
		end
	end
	if not staff then
		-- a pair of sun loungers by the railing
		for i, lx in { R.inner.right - 8, R.inner.right - 4.5 } do
			local lz = pz - 4.6
			if free(R, lx - 1.3, lx + 1.3, lz - 3, lz + 3) then
				local b = at(R, lx, lz, FRONT.F)
				Kit.part(R.model, R.cf, "LoungerBase", V3(2.4, 1.0, 6), b * CF(0, 0.5, 0), C.oakDark, M.wood)
				Kit.seat(R.model, R.cf, "Seat", V3(2.2, 0.35, 4.4), b * CF(0, 1.17, 0.7), C.fabricSand, M.fabric)
				Kit.wedge(R.model, R.cf, "LoungerBack", V3(2.2, 1.6, 1.6), b * CF(0, 1.8, -2.2) * ANG(0, math.pi, 0), C.fabricSand, M.fabric)
				claim(R, "Lounger", lx - 1.2, lx + 1.2, lz - 3, lz + 3)
			end
			local _ = i
		end
	end
end

---------------------------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------------------------
local KITS: { [string]: (R) -&gt; () } = {
	team = kitTeam,
	architecture = kitArchitecture,
	datalab = kitDatalab,
	control = kitControl,
	evaluation = kitEvaluation,
	launch = kitLaunch,
	support = kitSupport,
	studio = kitStudio,
	platform = kitPlatform,
	lab = kitLab,
	hwlab = kitHwlab,
	hr = kitHr,
	focus = kitFocus,
	phone = kitPhone,
	meeting = kitMeeting,
	pantry = kitPantry,
	lounge = kitLounge,
	print = kitPrint,
	wc = kitWc,
	boardroom = kitBoardroom,
	founder_office = kitFounderOffice,
	founder_assist = kitFounderAssist,
	founder_library = kitFounderLibrary,
	founder_bath = kitFounderBath,
	terrace = kitTerrace,
}
-- Decorative sub-parts dropped from every fit-out for the part budget.
local NOISE: { [string]: boolean } = { StickyNote = true, Groove = true, MarkerTray = true, PowerHub = true, Vase = true, Books = true, BoothFelt = true }
-- Frame overrides: rooms whose main entrance is not their own first door.
local FRAME: { [string]: string } = { founder_office = "W", terrace = "N" }
Work.KINDS = KITS

local function roomModel(ctx: any, room: Plan.Room): Model
	local m = ctx.rooms[room.id]
	if not m then
		m = Instance.new("Model")
		m.Name = room.id
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		m:SetAttribute("RoomId", room.id)
		m:SetAttribute("RoomName", room.name)
		m:SetAttribute("RoomKind", room.kind)
		m:SetAttribute("Level", room.level)
		m:SetAttribute("AccessClass", room.access)
		m.Parent = ctx.folders.Rooms
		ctx.rooms[room.id] = m
	end
	return m
end

function Work.build(ctx: any)
	local issues: { string } = {}
	for _, room in Plan.rooms(ctx.tier) do
		local kit = KITS[room.kind]
		if not kit then
			continue
		end
		local parent = roomModel(ctx, room)
		local fit = Instance.new("Model")
		fit.Name = "FitOut"
		fit.Parent = parent
		local R = newRoom(ctx, room, fit, FRAME[room.kind])
		local ok, err = pcall(function()
			kit(R)
		end)
		for _, d in fit:GetDescendants() do
			if NOISE[d.Name] and d:IsA("BasePart") then
				d:Destroy()
			end
		end
		if not ok then
			table.insert(issues, string.format("%s (%s) failed: %s", room.id, room.kind, tostring(err)))
		end
		if (room.desks or 0) ~= R.desks then
			table.insert(issues, string.format("%s: %d of %d desks placed", room.id, R.desks, room.desks or 0))
		end
		for _, s in R.issues do
			table.insert(issues, s)
		end
	end
	if #issues &gt; 0 then
		warn(string.format("[RoomKitsWork] %d layout issue(s): %s", #issues, table.concat(issues, " | ", 1, math.min(#issues, 12))))
	end
end

return Work
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000033"><Properties><string name="Name">ShopDecor</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Visible effects of cosmetic Robux items (ShopService decides WHEN, this module builds WHAT):
--   * party        team-party kit in front of the headquarters (balloon towers, banner, sparkles)
--   * founderSuite brass and leather lounge with a fire bowl on the private founder terrace
--   * vipTag       BillboardGui name tag above a VIP player's head
-- Built once (no per-frame work), all decorative parts non-colliding unless they are furniture.
-- Positions are building-local (cf = plot CFrame, like every generator; world = cf * at).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Kit = require(script.Parent.ArchKit)

local C = Kit.C
local M = Kit.M
local V3 = Vector3.new
local CF = CFrame.new
local DETAIL: Kit.Opts = { detail = true }

local ShopDecor = {}

ShopDecor.PARTY_NAME = "TeamParty"
ShopDecor.SUITE_NAME = "FounderSuiteDecor"
ShopDecor.TAG_NAME = "ShopVipTag"

-- Party colours: bright on purpose (a party, not architecture)
local BALLOONS = {
	Color3.fromRGB(232, 84, 84),
	Color3.fromRGB(246, 196, 72),
	Color3.fromRGB(86, 156, 232),
	Color3.fromRGB(112, 200, 128),
	Color3.fromRGB(236, 132, 196),
}
local GOLD = Color3.fromRGB(236, 196, 92)

-- Front plaza between the arrival point and the entrance canopy (Plan.ARRIVAL is where players
-- arrive, 3 studs above the paving; the canopy reaches to z = -66).
local function partyOrigin(): CFrame
	local a = Plan.ARRIVAL
	return CF(a.X, a.Y - 3 + 0.15, a.Z + 30)
end

-- Team party kit: two balloon towers 28 studs apart with a banner between them, facing the arrival
-- point. 25 parts + 2 Sparkles, removed by ShopService after ShopConfig.PARTY_SECONDS.
function ShopDecor.party(parent: Instance, cf: CFrame, title: string): Model
	local model = Kit.model(parent, ShopDecor.PARTY_NAME)
	local o = partyOrigin()
	model.WorldPivot = cf * o
	for side, x in { -14, 14 } do
		local base = o * CF(x, 0, 0)
		Kit.cylinder(model, cf, "PartyBase", "y", 0.4, 2.2, base * CF(0, 0.2, 0), C.metal, M.metal, DETAIL)
		Kit.part(model, cf, "PartyPole", V3(0.35, 10, 0.35), base * CF(0, 5.2, 0), C.brass, M.metal, DETAIL)
		-- two rings of four balloons around the pole top, one on top
		for i = 1, 8 do
			local upper = i &gt; 4
			local angle = (i / 4) * math.pi * 2 + (if upper then math.pi / 4 else 0) + side
			local ring = if upper then 1.0 else 1.5
			local at = base * CF(math.cos(angle) * ring, if upper then 13.0 else 11.4, math.sin(angle) * ring)
			local balloon = Kit.ball(model, cf, "Balloon", 2.3, at, BALLOONS[(i + side) % #BALLOONS + 1], M.smooth, DETAIL)
			if i == 1 then
				local sparkles = Instance.new("Sparkles")
				sparkles.SparkleColor = GOLD
				sparkles.Parent = balloon
			end
		end
		Kit.ball(model, cf, "Balloon", 2.6, base * CF(0, 14.6, 0), BALLOONS[side * 2], M.smooth, DETAIL)
	end
	local banner = Kit.part(model, cf, "PartyBanner", V3(26, 3.6, 0.25), o * CF(0, 8.6, 0), C.white, M.fabric, DETAIL)
	Kit.part(model, cf, "PartyBannerTrim", V3(26.2, 0.3, 0.3), o * CF(0, 6.7, 0), GOLD, M.smooth, DETAIL)
	Kit.part(model, cf, "PartyBannerTrim", V3(26.2, 0.3, 0.3), o * CF(0, 10.5, 0), GOLD, M.smooth, DETAIL)
	-- text on both faces: arriving players see the front (-Z), people leaving see the back
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		Kit.text(banner, "TEAM PARTY · " .. string.upper(title), {
			face = face,
			color = Color3.fromRGB(196, 64, 96),
			font = Enum.Font.BuilderSansExtraBold,
			maxDistance = 220,
			light = 0.2,
			pps = 24,
			pad = 0.1,
			wrap = false,
		})
	end
	return model
end

-- Founder Suite lounge on the private founder terrace. Free zone (measured on the built terrace):
-- x 66..82.4 (door from the founder office at x 59..65, existing seating/parasol in the west half),
-- z -43.5 (front planters) .. -32.45 (facade sill); the deck top is level Y + Kit.FINISH. nil when the
-- current building has no founder terrace (ShopService tries again after every rebuild).
function ShopDecor.founderSuite(parent: Instance, cf: CFrame, tier: number): Model?
	local room = Plan.room(tier, "F_TERRACE_PRIVATE")
	if not room then
		return nil
	end
	local y = Plan.levelY(room.level) + Kit.FINISH
	local x2, z2 = room.x2, room.z2 -- east end, against the founder office facade
	local function at(x: number, z: number, yaw: number?): CFrame
		return CF(x2 + x, y, z2 + z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	end
	local model = Kit.model(parent, ShopDecor.SUITE_NAME)
	model.WorldPivot = cf * at(-7.5, -5.5)
	-- brass-edged rug
	Kit.part(model, cf, "SuiteRugEdge", V3(11.4, 0.04, 7.8), at(-7.5, -5.5) * CF(0, 0.02, 0), C.brass, M.fabric, DETAIL)
	Kit.part(model, cf, "SuiteRug", V3(10.8, 0.05, 7.2), at(-7.5, -5.5) * CF(0, 0.025, 0), C.fabricCharcoal, M.fabric, DETAIL)
	-- two leather lounge chairs looking out over the terrace (sitter faces -Z)
	Kit.loungeChair(model, cf, at(-10.5, -4.5), 3, { color = C.leather, name = "Seat" })
	Kit.loungeChair(model, cf, at(-4.5, -4.5), 7, { color = C.leather, name = "Seat" })
	-- marble plinth with a brass fire bowl in front, between the chairs
	Kit.part(model, cf, "SuitePlinth", V3(2.2, 1.2, 2.2), at(-7.5, -7.4) * CF(0, 0.6, 0), C.white, M.marble)
	local bowl = Kit.cylinder(model, cf, "SuiteFireBowl", "y", 0.5, 2.0, at(-7.5, -7.4) * CF(0, 1.45, 0), C.brass, M.metal)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 2
	fire.Color = Color3.fromRGB(255, 150, 60)
	fire.SecondaryColor = Color3.fromRGB(255, 90, 40)
	fire.Parent = bowl
	Kit.light(bowl, "point", Color3.fromRGB(255, 196, 140), 14, 1.1)
	-- tall plants at the front corners (crowns stay clear of the rail at x 82.4)
	Kit.plant(model, cf, at(-14.0, -9.6), "l", 11)
	Kit.plant(model, cf, at(-2.0, -9.6), "l", 23)
	-- brass plaque on a short stand beside the facade, facing the lounge (front = -X)
	local stand = at(-0.8, -2.0, 90)
	Kit.part(model, cf, "SuitePlaqueStand", V3(0.3, 3.2, 0.3), stand * CF(0, 1.6, 0.25), C.metal, M.metal, DETAIL)
	local plaque = Kit.part(model, cf, "SuitePlaque", V3(2.6, 1.2, 0.12), stand * CF(0, 3.4, 0.1), C.brass, M.metal, DETAIL)
	Kit.text(plaque, "FOUNDER SUITE", { color = C.metal, font = Enum.Font.BuilderSansExtraBold, maxDistance = 40, light = 0.3, pps = 60, pad = 0.12 })
	return model
end

-- VIP name tag above the head (cosmetic, replicated with the character).
function ShopDecor.vipTag(head: BasePart, company: string?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = ShopDecor.TAG_NAME
	gui.Adornee = head
	gui.Size = UDim2.new(5, 0, 1.3, 0) -- studs: scales with distance like a world label
	gui.StudsOffset = V3(0, 2.7, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	local badge = Instance.new("TextLabel")
	badge.Name = "Badge"
	badge.BackgroundColor3 = Color3.fromRGB(28, 26, 22)
	badge.BackgroundTransparency = 0.2
	badge.Position = UDim2.fromScale(0.15, 0)
	badge.Size = UDim2.fromScale(0.7, if company then 0.6 else 1)
	badge.Text = "VIP FOUNDER"
	badge.TextColor3 = GOLD
	badge.TextScaled = true
	badge.Font = Enum.Font.BuilderSansExtraBold
	badge.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.3, 0)
	corner.Parent = badge
	local stroke = Instance.new("UIStroke")
	stroke.Color = GOLD
	stroke.Thickness = 1.5
	stroke.Transparency = 0.2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = badge
	if company then
		local line = Instance.new("TextLabel")
		line.Name = "Company"
		line.BackgroundTransparency = 1
		line.Position = UDim2.fromScale(0, 0.62)
		line.Size = UDim2.fromScale(1, 0.38)
		line.Text = company
		line.TextColor3 = Color3.fromRGB(246, 244, 239)
		line.TextStrokeTransparency = 0.4
		line.TextScaled = true
		line.Font = Enum.Font.BuilderSansBold
		line.Parent = gui
	end
	gui.Parent = head
	return gui
end

return ShopDecor
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000034"><Properties><string name="Name">ShopService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Robux purchases (catalogue: ShopConfig). The ONLY script that sets MarketplaceService.ProcessReceipt.
--
-- Developer products are granted exactly once. The grant and its record live in the same
-- session-locked save record (data.shop.receipts[PurchaseId]):
--   find player -&gt; wait for the loaded session (up to 45 s: products can be bought outside the game,
--   so receipts arrive during joins) -&gt; if the id is not recorded: grant + record (no yield in between)
--   -&gt; save now -&gt; PurchaseGranted only after a successful save, NotProcessedYet otherwise.
-- A retry of an already recorded id only saves again; a server crash before the save loses grant AND
-- record together, so Roblox's retry on the next join grants it fresh. Ids answered PurchaseGranted
-- are never sent again, so only the newest ShopConfig.RECEIPTS_KEPT ids are kept.
-- Anything that could fail later (an applicant, a party) is granted as a voucher and redeemed through
-- the ShopAction remote under the normal game rules.
--
-- Game passes: ownership is asked from Roblox when the session loads (retried on failure), set at
-- once by PromptGamePassPurchaseFinished, and kept per session (module-level weak table). The saved
-- data.shop.passes is only a fallback cache while Roblox can't be asked. Clients see the flags in
-- live.shop (written on change; MarketService merges session.live instead of replacing it).
--
-- Public API for other systems:
--   ShopService.owns(player|session, passKey) -&gt; boolean        (VehicleService: limo)
--   ShopService.revenueMultiplier(session) -&gt; number             (MarketService: investor pass)
--   ShopService.setRedeemHandler(voucherKey, fn(session) -&gt; (ok, errCode?))   (RecruitingService: headhunter)
--   ShopService.onPassChanged(fn(session, passKey, owned))
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShopConfig = require(ReplicatedStorage.Shared.Config.ShopConfig)
local ServerTypes = require(script.Parent.Parent.Lib.ServerTypes)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local Template = require(script.Parent.Parent.Lib.Template)
local SaveService = require(script.Parent.SaveService)
local SessionService = require(script.Parent.SessionService)
local EconomyService = require(script.Parent.EconomyService)
local ShopDecor = require(script.Parent.ShopDecor)

type Session = ServerTypes.Session
type Redeemer = (Session) -&gt; (boolean, string?)
type PassListener = (Session, string, boolean) -&gt; ()

local Shop = {}

local NOT_PROCESSED = Enum.ProductPurchaseDecision.NotProcessedYet
local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local SAVE_WAIT_SECONDS = 15 -- like SessionService.closeSession: wait for a running autosave

-- Seams for the headless tests (tests/shop): MarketplaceService does not exist outside Roblox.
type Deps = {
	market: any,
	players: any,
	save: (userId: number, data: any, release: boolean) -&gt; (boolean, boolean),
	getSession: (player: any) -&gt; Session?,
	now: () -&gt; number,
	plot: () -&gt; any, -- PlotService, required lazily (it pulls in the whole building generator)
}
local deps: Deps = {
	market = MarketplaceService,
	players = Players,
	save = SaveService.save,
	getSession = SessionService.get,
	now = os.time,
	plot = function(): any
		return require(script.Parent.PlotService) :: any
	end,
}

type PassState = { checkedAt: number, checked: boolean }
local passFlags: { [Session]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any
local passStates: { [Session]: PassState } = setmetatable({}, { __mode = "k" }) :: any
-- passes bought during this session (purchase event): a later "not owned" answer from Roblox (its
-- ownership answer can lag behind a fresh purchase, e.g. Studio test purchases) never takes them away
local boughtNow: { [Session]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any
local parties: { [Session]: Model } = setmetatable({}, { __mode = "k" }) :: any
local redeeming: { [Session]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local redeemers: { [string]: Redeemer } = {}
local passListeners: { PassListener } = {}
local investorWired = false -- becomes true when the market applies revenueMultiplier
local initialised = false

---------------------------------------------------------------------------------------------- data

-- data.shop with a valid shape (repairs it in place when another system replaced data)
local function shopOf(session: Session): any
	local data = session.data :: any
	local shop = data.shop
	if
		typeof(shop) ~= "table"
		or typeof(shop.receipts) ~= "table"
		or typeof(shop.order) ~= "table"
		or typeof(shop.vouchers) ~= "table"
		or typeof(shop.passes) ~= "table"
		or typeof(shop.tips) ~= "number"
	then
		shop = Template.cleanShop(shop)
		data.shop = shop
	end
	return shop
end

local function stateOf(session: Session): PassState
	local state = passStates[session]
	if not state then
		state = { checkedAt = -math.huge, checked = false }
		passStates[session] = state
	end
	return state
end

local function isSession(target: any): boolean
	return typeof(target) == "table" and target.data ~= nil and target.player ~= nil
end

-------------------------------------------------------------------------------------- publishing

-- Which listed items can be sold right now (features owned by other systems must exist first).
function Shop.available(): { [string]: boolean }
	local out: { [string]: boolean } = {}
	for _, def in ShopConfig.PRODUCTS do
		out[def.key] = if def.kind == "voucher" then def.voucher ~= nil and redeemers[def.voucher] ~= nil else true
	end
	for _, def in ShopConfig.PASSES do
		if def.key == "limo" then
			out[def.key] = ShopConfig.limoCarExists()
		elseif def.key == "investor" then
			out[def.key] = investorWired
		else
			out[def.key] = true
		end
	end
	return out
end

-- live.shop for the client: owned passes, sellable items, redeemable vouchers.
local function publish(session: Session)
	if session.closed then
		return
	end
	local flags = passFlags[session] or {}
	local passes: { [string]: boolean } = {}
	for _, def in ShopConfig.PASSES do
		if flags[def.key] == true then
			passes[def.key] = true
		end
	end
	local redeemable: { [string]: boolean } = {}
	for key in redeemers do
		redeemable[key] = true
	end
	local live = session.live :: any
	live.shop = { passes = passes, available = Shop.available(), redeemable = redeemable, checked = stateOf(session).checked }
	SessionService.markDirty(session)
end

local function publishAll()
	for _, session in SessionService.all() do
		publish(session)
	end
end

------------------------------------------------------------------------------- office + character

-- FounderSuite attribute + decor on the owner's office (after pass changes and every rebuild).
local function refreshOffice(session: Session)
	local ok, err = pcall(function(): any
		local Plot = deps.plot()
		local plot = Plot.get(session.player)
		local office: Instance? = if plot then plot.office else nil
		if not plot or not office then
			return nil
		end
		local owned = Shop.owns(session, "founderSuite")
		office:SetAttribute("FounderSuite", if owned then true else nil)
		local existing = office:FindFirstChild(ShopDecor.SUITE_NAME)
		if owned and not existing then
			local tier = office:GetAttribute("OfficeTier")
			ShopDecor.founderSuite(office, plot.cframe, if typeof(tier) == "number" then tier else (session.data.empire.office :: number))
		elseif not owned and existing then
			existing:Destroy()
		end
		return nil
	end)
	if not ok then
		warn("[Shop] founder suite:", err)
	end
end

-- VIP tag on the current character (character spawns, pass changes)
local function refreshTag(player: Player)
	local character = player.Character
	local head = if character then character:FindFirstChild("Head") else nil
	if not head or not head:IsA("BasePart") then
		return
	end
	local session = deps.getSession(player)
	local owned = session ~= nil and Shop.owns(session, "vip")
	local existing = head:FindFirstChild(ShopDecor.TAG_NAME)
	if owned and session and not existing then
		local company = session.data.company
		ShopDecor.vipTag(head, if company then company.name else nil)
	elseif not owned and existing then
		existing:Destroy()
	end
end

local function watchCharacter(player: Player)
	local function spawned(character: Model)
		task.spawn(function()
			character:WaitForChild("Head", 10)
			if character.Parent then
				refreshTag(player)
			end
		end)
	end
	player.CharacterAdded:Connect(spawned)
	if player.Character then
		spawned(player.Character)
	end
end

------------------------------------------------------------------------------------- game passes

-- persist = true: an authoritative answer (Roblox / purchase event) -&gt; update the fallback cache
local function setPass(session: Session, key: string, owned: boolean, persist: boolean)
	local flags = passFlags[session]
	if not flags then
		flags = {}
		passFlags[session] = flags
	end
	if persist then
		local passes = shopOf(session).passes
		if (passes[key] == true) ~= owned then
			passes[key] = if owned then true else nil
			SessionService.markDirty(session)
		end
	end
	if flags[key] == owned then
		return
	end
	flags[key] = owned
	publish(session)
	if key == "vip" then
		refreshTag(session.player)
	elseif key == "founderSuite" then
		refreshOffice(session)
	end
	for _, listener in passListeners do
		task.spawn(listener, session, key, owned)
	end
end

-- Asks Roblox for every listed pass (yields). true when every answer arrived.
function Shop.refreshPasses(session: Session): boolean
	local state = stateOf(session)
	state.checkedAt = os.clock()
	local allAnswered = true
	for _, def in ShopConfig.PASSES do
		if def.id &gt; 0 then
			local ok, owns = pcall(function(): any
				return deps.market:UserOwnsGamePassAsync(session.userId, def.id)
			end)
			if session.closed then
				return false
			end
			if ok then
				local bought = boughtNow[session]
				if owns == true or not (bought and bought[def.key]) then
					setPass(session, def.key, owns == true, true)
				end
			else
				allAnswered = false
				warn(`[Shop] UserOwnsGamePassAsync {def.key} for {session.userId} failed: {owns}`)
				local flags = passFlags[session]
				if not flags or flags[def.key] == nil then
					setPass(session, def.key, shopOf(session).passes[def.key] == true, false) -- fallback cache
				end
			end
		end
	end
	if allAnswered and not state.checked then
		state.checked = true
		publish(session)
	end
	return allAnswered
end

local function onPassPurchaseFinished(player: Player, passId: number, purchased: boolean)
	if not purchased then
		return
	end
	local def = ShopConfig.passById(passId)
	local session = deps.getSession(player)
	if not def or not session or session.closed then
		return
	end
	local bought = boughtNow[session]
	if not bought then
		bought = {}
		boughtNow[session] = bought
	end
	bought[def.key] = true
	setPass(session, def.key, true, true)
	Remote.fire(player, "Notify", "SHOP_GRANTED", { key = def.key, kind = "pass" })
end

function Shop.owns(target: Player | Session, key: string): boolean
	local session: Session? = if isSession(target) then target :: any else deps.getSession(target)
	if not session then
		return false
	end
	local flags = passFlags[session]
	return flags ~= nil and flags[key] == true
end

-- MarketService multiplies the player's own market revenue with this (after market shares are
-- computed, so it never changes anyone else's share). Its first call also makes the Investor pass
-- sellable: the pass is only offered once the game really applies it.
function Shop.revenueMultiplier(session: Session): number
	if not investorWired then
		investorWired = true
		publishAll()
	end
	return if Shop.owns(session, "investor") then ShopConfig.INVESTOR_MULTIPLIER else 1
end

function Shop.onPassChanged(listener: PassListener)
	table.insert(passListeners, listener)
end

------------------------------------------------------------------------------------------ receipts

-- Waits for a free save slot, saves (not releasing the lock) and reports whether it was written.
-- Same rules as SessionService: session.saving keeps saves in order, a lost lock closes the session.
function Shop.saveNow(session: Session): boolean
	local waited = 0
	while session.saving and waited &lt; SAVE_WAIT_SECONDS do
		task.wait(0.2)
		waited += 0.2
	end
	if session.saving or session.closed then
		return false -- closing: the final save carries the grant; the retry then finds the record
	end
	session.saving = true
	local ok, saved, lostLock = pcall(deps.save, session.userId, session.data, false)
	session.saving = false
	if not ok then
		warn("[Shop] save failed:", saved)
		return false
	end
	if lostLock then
		session.closed = true
		session.player:Kick("AI Empire: Your company was opened on another server.")
		return false
	end
	return saved == true
end

local function waitForSession(player: any): Session?
	local waited = 0
	while true do
		local session = deps.getSession(player)
		if session then
			return session
		end
		if player.Parent == nil or waited &gt;= ShopConfig.SESSION_WAIT_SECONDS then
			return nil
		end
		task.wait(0.5)
		waited += 0.5
	end
end

-- The effect of one purchase. Must never fail: cash, a voucher count or a tip count.
local function grant(session: Session, def: ShopConfig.Product): { [string]: any }
	local shop = shopOf(session)
	if def.kind == "cash" then
		local amount = ShopConfig.cashFor(def, session.data.empire.office)
		EconomyService.grant(session, amount)
		return { key = def.key, kind = "cash", amount = amount }
	elseif def.kind == "voucher" and def.voucher then
		local count = (tonumber(shop.vouchers[def.voucher]) or 0) + 1
		shop.vouchers[def.voucher] = count
		return { key = def.key, kind = "voucher", voucher = def.voucher, count = count }
	end
	shop.tips += 1
	return { key = def.key, kind = "tip", tips = shop.tips }
end

local function trimReceipts(shop: any)
	while #shop.order &gt; ShopConfig.RECEIPTS_KEPT do
		local oldest = table.remove(shop.order, 1)
		if typeof(oldest) == "string" then
			shop.receipts[oldest] = nil
		end
	end
end

-- MarketplaceService.ProcessReceipt
function Shop.processReceipt(info: any): Enum.ProductPurchaseDecision
	if typeof(info) ~= "table" then
		return NOT_PROCESSED
	end
	local purchaseId, playerId, productId = info.PurchaseId, info.PlayerId, info.ProductId
	if typeof(purchaseId) ~= "string" or #purchaseId == 0 or #purchaseId &gt; 128 then
		return NOT_PROCESSED
	end
	if typeof(playerId) ~= "number" or typeof(productId) ~= "number" then
		return NOT_PROCESSED
	end
	local def = ShopConfig.productById(productId)
	if not def then
		warn(`[Shop] receipt {purchaseId}: unknown product {productId} (not in ShopConfig.PRODUCTS)`)
		return NOT_PROCESSED
	end
	local player = deps.players:GetPlayerByUserId(playerId)
	if not player then
		return NOT_PROCESSED -- Roblox retries when the player is back
	end
	local session = waitForSession(player)
	if not session or session.closed then
		return NOT_PROCESSED
	end
	-- check, grant and record without yielding in between
	local shop = shopOf(session)
	if shop.receipts[purchaseId] == nil then
		local result = grant(session, def)
		shop.receipts[purchaseId] = deps.now()
		table.insert(shop.order, purchaseId)
		trimReceipts(shop)
		SessionService.markDirty(session, true)
		Remote.fire(player, "Notify", "SHOP_GRANTED", result)
	end
	if Shop.saveNow(session) then
		return GRANTED
	end
	return NOT_PROCESSED
end

------------------------------------------------------------------------------------------ vouchers

function Shop.setRedeemHandler(voucher: string, handler: Redeemer)
	redeemers[voucher] = handler
	publishAll()
end

-- Built-in voucher: a team party in front of the player's headquarters.
local function throwParty(session: Session): (boolean, string?)
	local Plot = deps.plot()
	local plot = Plot.get(session.player)
	local office: Instance? = if plot then plot.office else nil
	if not plot or not office or not office.Parent then
		return false, "NO_PLOT"
	end
	local running = parties[session]
	if running and running.Parent then
		return false, "PARTY_ACTIVE"
	end
	local company = session.data.company
	local kit = ShopDecor.party(office, plot.cframe, if company then company.name else session.player.DisplayName)
	parties[session] = kit
	local untilTime = workspace:GetServerTimeNow() + ShopConfig.PARTY_SECONDS
	office:SetAttribute("TeamPartyUntil", untilTime) -- for staff/talk systems that want to react
	task.delay(ShopConfig.PARTY_SECONDS, function()
		if kit.Parent then
			kit:Destroy()
		end
		if parties[session] == kit then
			parties[session] = nil
		end
		if office.Parent and office:GetAttribute("TeamPartyUntil") == untilTime then
			office:SetAttribute("TeamPartyUntil", nil)
		end
	end)
	return true, nil
end

local function redeem(session: Session, key: string): ServerTypes.Result
	if not ShopConfig.voucher(key) then
		return { ok = false, err = "BAD_INPUT" }
	end
	if (tonumber(shopOf(session).vouchers[key]) or 0) &lt; 1 then
		return { ok = false, err = "NO_VOUCHER" }
	end
	local handler = redeemers[key]
	if not handler then
		return { ok = false, err = "NOT_AVAILABLE" } -- the voucher stays
	end
	if redeeming[session] then
		return { ok = false, err = "BUSY" }
	end
	redeeming[session] = true
	local ok, done, err = pcall(handler, session)
	redeeming[session] = nil
	if not ok then
		warn(`[Shop] redeem {key} failed: {done}`)
		return { ok = false, err = "SERVER_ERROR" }
	end
	if done ~= true then
		return { ok = false, err = if typeof(err) == "string" then err else "NOT_AVAILABLE" }
	end
	-- re-read after the handler (it may yield)
	local vouchers = shopOf(session).vouchers
	local left = math.max(0, (tonumber(vouchers[key]) or 0) - 1)
	vouchers[key] = if left &gt; 0 then left else nil
	SessionService.markDirty(session, true)
	return { ok = true, key = key, left = left }
end

local function action(session: Session, payload: ServerTypes.Payload): ServerTypes.Result
	local act = Guard.id(payload.action)
	if act == "status" then
		if payload.recheck == true and os.clock() - stateOf(session).checkedAt &gt;= ShopConfig.RECHECK_SECONDS then
			Shop.refreshPasses(session)
		end
		if session.closed then
			return { ok = false, err = "LOADING" }
		end
		local flags = passFlags[session] or {}
		local passes: { [string]: boolean } = {}
		for _, def in ShopConfig.PASSES do
			if flags[def.key] == true then
				passes[def.key] = true
			end
		end
		return { ok = true, passes = passes, vouchers = table.clone(shopOf(session).vouchers), available = Shop.available() }
	elseif act == "redeem" then
		local key = Guard.id(payload.key)
		if not key then
			return { ok = false, err = "BAD_INPUT" }
		end
		return redeem(session, key)
	end
	return { ok = false, err = "BAD_INPUT" }
end

----------------------------------------------------------------------------------- debug + tests

-- Studio test helpers (DebugService gates them to Studio). Flags only for this session, not saved.
function Shop.debugGrantPass(session: Session, key: string): boolean
	if not ShopConfig.pass(key) then
		return false
	end
	setPass(session, key, true, false)
	return true
end

function Shop.debugGrantVoucher(session: Session, key: string): boolean
	if not ShopConfig.voucher(key) then
		return false
	end
	local vouchers = shopOf(session).vouchers
	vouchers[key] = (tonumber(vouchers[key]) or 0) + 1
	SessionService.markDirty(session)
	return true
end

function Shop._setDeps(patch: { [string]: any })
	for key, value in patch do
		(deps :: any)[key] = value
	end
end

Shop._action = action

------------------------------------------------------------------------------------------- start

local function onLoaded(session: Session)
	passFlags[session] = passFlags[session] or {}
	publish(session)
	refreshTag(session.player)
	for _ = 0, ShopConfig.PASS_RETRIES do
		if session.closed or Shop.refreshPasses(session) then
			return
		end
		task.wait(ShopConfig.PASS_RETRY_SECONDS)
	end
end

function Shop.init()
	assert(not initialised, "ShopService.init called twice")
	initialised = true
	redeemers.party = throwParty
	deps.market.ProcessReceipt = Shop.processReceipt
	deps.market.PromptGamePassPurchaseFinished:Connect(onPassPurchaseFinished)
	Remote.bind("ShopAction", { burst = 4, perSecond = 1 }, action)
	SessionService.onLoaded(onLoaded)
	SessionService.onClosing(function(session: Session)
		passFlags[session] = nil
		passStates[session] = nil
		boughtNow[session] = nil
		redeeming[session] = nil
		parties[session] = nil -- the kit lives in the office and goes with it
	end)
	deps.players.PlayerAdded:Connect(watchCharacter)
	for _, player in deps.players:GetPlayers() do
		watchCharacter(player)
	end
	deps.plot().onChanged(function(_plot: any, session: any)
		if session and passFlags[session] then
			refreshOffice(session)
		end
	end)
end

return Shop
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000035"><Properties><string name="Name">ShuttleService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- ShuttleService (package "flight"): the scheduled Port Meridian shuttle, its two pilots, boarding, the ride
-- and the VIP helicopter - server side. Required, initialised and ticked by CityService (City.init/tick).
--   * Timetable + path: FlightPlan (shared). The server never moves the aircraft: it publishes the timetable
--     state as attributes on ReplicatedStorage.Shuttle (always replicated, no streaming): Enabled, Interval,
--     Epoch, Kind, Scale, Airline, Phase, PhaseStart, PhaseEnd, Leg ("out" | "back"), Cycle, LegStart,
--     Flight, From, To, NextOut, NextBack (departure times), CrewState, CaptainName, FirstOfficerName, Heli*.
--     They change once per phase (~11 writes per leg). Every client animates the aircraft from
--     workspace:GetServerTimeNow() with the same FlightPlan maths (ShuttleController).
--   * Pilots: two EmployeeRigDesign rigs (role "pilot": uniform + cap, fixed names) built ONCE into
--     ReplicatedStorage.Shuttle.Crew as templates (no tag, no talk prompt, not in workspace = no physics);
--     clients clone them, walk them from the CrewRoom marker / the terminal to the aircraft and seat them in
--     the cockpit (CrewState says which).
--   * Tickets: TravelAction {action="ticket"} at a check-in counter (City Airport: CityPlan.TRAVEL.ticket via
--     Economy.spend, the return flight included; Port Meridian: free). One ticket per player, valid for the
--     next departures until used.
--   * Boarding: at the gate (prompt CityAction="board" -&gt; TravelAction {action="board"}) during "boarding",
--     or automatically when boarding ends for ticket holders standing at the gate. A boarded passenger's
--     character is held server-side: root anchored, name hidden, parked under the departure stand (below the
--     apron, nobody sees it, and the replication focus stays at the airport the aircraft is at); the Player
--     attribute ShuttleLeg tells the client to show the ride (cabin window or chase camera on the
--     client-animated aircraft over the real streamed map). Why this is safe: the server only ever moves the
--     character three times (board, mid-cruise, arrival), each move after Player:RequestStreamAroundAsync of
--     the target area (MinimumRadiusPause never stalls the ride), nothing is welded to a client-only model
--     (no physics ownership or replication conflicts), and a respawn, leave or rebuild cannot strand the
--     player: CityService state "flying" (PlotService away check), refund unless arrived.
--   * Arrival: when the aircraft reaches "deboarding" the server streams the arrival hall and pivots the
--     character there (CityPlan.ABROAD.arrival / AIRPORT.arrival), unanchored, state abroad / home.
--   * VIP helicopter: TravelAction {action="heli", to="hotel"|"airport"} between the "Helipad" markers
--     (Purpose VIPAirport = Port Meridian Airport, VIP = Meridian Grand Hotel roof; built by MetroBuilder; the
--     service answers HELI_UNAVAILABLE if they are missing). Free with the "limo" game pass
--     (ShopService.owns via pcall), else HELI_FEE. Same hold/stream/arrive pattern; the ride is published as
--     HeliStart/HeliFrom/HeliTo/HeliRider so every client sees the helicopter fly.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local CityPlan=require(ReplicatedStorage.Shared.Config.CityPlan)
local FP=require(ReplicatedStorage.Shared.FlightPlan)
local Format=require(ReplicatedStorage.Shared.Format)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local Economy=require(script.Parent.EconomyService)
local Session=require(script.Parent.SessionService)
local Rig=require(script.Parent.EmployeeRigDesign)
local Shuttle={}
Shuttle.ENABLED=true
Shuttle.HELI_FEE=2500 -- tuned by CORE_SPEC: VIP helicopter transfer without the limousine pass
Shuttle.HELI_RADIUS=40 -- server distance check: character to the departure helipad / hotel lobby
Shuttle.CREW={captain=9160,firstOfficer=9140} -- CampusMath.staffName indices (owner 0): the same two pilots on every server
-- (Tom Nakamura, Sana Okafor; indices far apart so the surnames differ)

export type Api={trips: {[number]: any},setState: (Player,string)-&gt;(),rootOf: (Player)-&gt;(Model?,BasePart?,Humanoid?)}
type Ticket={to: string,price: number,session: any,at: number}
local api: Api?=nil
local folder: Folder?=nil
local tickets: {[number]: Ticket}={}
Shuttle.tickets=tickets
local lastKey=""
local lastPhase=""
local lastCrew=""
local nextPadSearch=0
local autoDone: {[string]: boolean}={}
local heli: {busyUntil: number,from: Vector3?,to: Vector3?,fromPad: BasePart?,toPad: BasePart?}={busyUntil=0,from=nil,to=nil,fromPad=nil,toPad=nil}

local function now(): number return workspace:GetServerTimeNow() end
local function flat(a: Vector3,b: Vector3): number return Vector3.new(a.X-b.X,0,a.Z-b.Z).Magnitude end
local function nearAny(p: Vector3,points: {Vector3},radius: number): boolean
	for _,q in points do if flat(p,q)&lt;=radius and math.abs(p.Y-q.Y)&lt;14 then return true end end
	return false
end
local function refund(s: any,price: number)
	if price&lt;=0 or not s or not s.data then return end
	Economy.grant(s,price,"travel") -- refund: P&amp;L line "travel" (design/requests/econ.md #4)
	s.data.stats.totalCost=math.max(0,s.data.stats.totalCost-price)
	Session.markDirty(s,true)
end
local function setAttr(name: string,value: any)
	local f=folder
	if f and f:GetAttribute(name)~=value then f:SetAttribute(name,value) end
end
function Shuttle.enabled(): boolean
	local f=folder
	return Shuttle.ENABLED and f~=nil and f:GetAttribute("Enabled")==true
end
-- Shuttle.ENABLED=false (or the attribute Enabled=false) turns the scheduled shuttle off: check-in falls back
-- to the instant flight (CityService.flight) on the client.
function Shuttle.setEnabled(on: boolean)
	Shuttle.ENABLED=on
	setAttr("Enabled",on)
end

------------------------------------------------------------------------------------------------ crew
local function buildCrew(f: Folder)
	local crew=Instance.new("Folder");crew.Name="Crew"
	local temp=Instance.new("Folder");temp.Name="CrewBuild"
	local names: {[string]: string}={}
	type Def={key: string,index: number,title: string}
	local defs: {Def}={{key="Captain",index=Shuttle.CREW.captain,title="Captain"},{key="FirstOfficer",index=Shuttle.CREW.firstOfficer,title="First Officer"}}
	for _,def in defs do
		local ok,err=pcall(function()
			local name=CampusMath.staffName(def.index,0)
			local m=Rig.build(temp,0,def.index,"pilot",CFrame.new(),{n=name})
			-- a template, not an employee: no tag (EmployeeController/TalkController), no talk prompt
			m:RemoveTag("CompanyEmployee")
			for _,d in m:GetDescendants() do
				if d:IsA("ProximityPrompt") then d:Destroy()
				elseif d:IsA("BasePart") then d.Anchored=d.Name=="HumanoidRootPart";d.CanCollide=false;d.CanTouch=false;d.CanQuery=false
				elseif d:IsA("TextLabel") and d.Parent and d.Parent.Name=="EmployeeBadge" then d.Text=def.title.." "..name.."\n"..FP.CONFIG.airline end
			end
			m.Name=def.key;m:SetAttribute("CrewRole",def.title);m:SetAttribute("Role","Pilot")
			m.Parent=crew
			names[def.key]=name
		end)
		if not ok then warn("[Shuttle] building the pilot rig failed: "..tostring(err)) end
	end
	temp:Destroy()
	crew.Parent=f
	f:SetAttribute("CaptainName",names.Captain or "")
	f:SetAttribute("FirstOfficerName",names.FirstOfficer or "")
end

------------------------------------------------------------------------------------------------ world hooks
-- Board prompts (invisible anchored parts, client handles CityAction="board" -&gt; TravelAction {action="board"}).
local function gatePrompt(parent: Instance,name: string,pos: Vector3,from: string,objectText: string)
	local p=Instance.new("Part");p.Name=name;p.Size=Vector3.new(1,1,1);p.Transparency=1;p.Anchored=true
	p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.CFrame=CFrame.new(pos);p.Parent=parent
	p:SetAttribute("BoardFrom",from)
	local q=Instance.new("ProximityPrompt");q.Name="BoardPrompt";q.ActionText="Board";q.ObjectText=objectText
	q.MaxActivationDistance=12;q.HoldDuration=0.3;q.RequiresLineOfSight=false
	-- Public: WorldController disables every prompt that is neither the player's own nor Public
	q:SetAttribute("CityAction","board");q:SetAttribute("BoardFrom",from);q:SetAttribute("Public",true);q.Parent=p
end
local function findHomeDesk(): Vector3
	local world=workspace:FindFirstChild("WorldCity")
	local gate=if world then world:FindFirstChild("GateA"..CityPlan.AIRPORT.shuttleStand,true) else nil
	local desk=if gate then gate:FindFirstChild("GateDesk") else nil
	if desk and desk:IsA("BasePart") then return desk.Position+Vector3.new(0,1.4,-desk.Size.Z/2-1.6) end
	return FP.HOME_GATES[1]+Vector3.new(0,0,6)
end
local function findPads()
	local world=workspace:FindFirstChild("WorldCity")
	if not world then return end
	for _,d in world:GetDescendants() do
		if d:IsA("BasePart") and d.Name=="Helipad" then
			local purpose=d:GetAttribute("Purpose")
			if purpose=="VIPAirport" then heli.fromPad=d elseif purpose=="VIP" then heli.toPad=d end
		end
	end
end
local function padTop(p: BasePart): Vector3 return p.Position+Vector3.new(0,p.Size.Y/2,0) end

------------------------------------------------------------------------------------------------ publish
local function publish(st: FP.State,t: number)
	local f=folder
	if not f then return end
	local leg=st.leg
	setAttr("Leg",st.dir);setAttr("Cycle",st.cycle);setAttr("LegStart",st.legStart)
	setAttr("Phase",st.phase);setAttr("PhaseStart",st.phaseStart);setAttr("PhaseEnd",st.phaseEnd)
	setAttr("Flight",leg.flight);setAttr("From",leg.from);setAttr("To",leg.to)
	local _,_,depOut=FP.nextLeg("out",t);local _,_,depBack=FP.nextLeg("back",t)
	setAttr("NextOut",depOut);setAttr("NextBack",depBack)
	setAttr("CrewState",FP.crewState(st))
end

------------------------------------------------------------------------------------------------ tickets
-- "abroad" ticket at a City Airport counter (paid, return included), "home" ticket at Port Meridian (free).
function Shuttle.ticket(s: any,destination: any): {[string]: any}
	local a=api
	if not a or not Shuttle.enabled() then return {ok=false,err="SHUTTLE_OFF"} end
	local player: Player=s.player
	if destination~="abroad" and destination~="home" then return {ok=false,err="BAD_INPUT"} end
	local trip=a.trips[player.UserId]
	local state=if trip then trip.state else "home"
	if state=="flying" then return {ok=false,err="BUSY"} end
	local from=if destination=="abroad" then "home" else "abroad"
	if state~=from then return {ok=false,err=if destination=="abroad" then "ALREADY_ABROAD" else "NOT_ABROAD"} end
	local _,root,humanoid=a.rootOf(player)
	if not root or not humanoid or humanoid.Health&lt;=0 then return {ok=false,err="LOADING"} end
	local counters=if destination=="abroad" then CityPlan.AIRPORT.checkin else CityPlan.ABROAD.checkin
	if not nearAny(root.Position,counters,CityPlan.TRAVEL.checkinRadius) then return {ok=false,err="NOT_AT_CHECKIN"} end
	local dir=if destination=="abroad" then "out" else "back"
	local t=now()
	local _,legStart,departs,boardEnd=FP.nextLeg(dir,t)
	local leg=FP.leg(dir)
	local info={ok=true,flight=leg.flight,to=destination,gate=FP.GATE_NAME[dir],departs=departs,boardingStarts=legStart,boardingEnds=boardEnd,
		destination=if destination=="abroad" then "Port Meridian" else "City Airport"}
	local held=tickets[player.UserId]
	if held and held.to==destination then info.price=0;info.held=true;return info end
	local price=if destination=="abroad" then CityPlan.TRAVEL.ticket else 0
	if not Economy.spend(s,price,"travel") then return {ok=false,err="NO_MONEY"} end
	tickets[player.UserId]={to=destination,price=price,session=s,at=t}
	Session.markDirty(s,true)
	info.price=price
	return info
end

-- The instant flight (CityService.flight) uses a held ticket for the same destination instead of charging
-- again; restoreTicket puts it back when that flight is cancelled.
function Shuttle.takeTicket(player: Player,destination: string): Ticket?
	local t=tickets[player.UserId]
	if t and t.to==destination then tickets[player.UserId]=nil;return t end
	return nil
end
function Shuttle.restoreTicket(player: Player,ticket: Ticket)
	if tickets[player.UserId]==nil then tickets[player.UserId]=ticket end
end

------------------------------------------------------------------------------------------------ boarding
local function hide(trip: any,humanoid: Humanoid?)
	if humanoid then trip.display=humanoid.DisplayDistanceType;humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end
end
local function restore(trip: any)
	local character: Model?=trip.character
	local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid and trip.display then humanoid.DisplayDistanceType=trip.display end
end
local function streamAsync(player: Player,pos: Vector3)
	local ok,err=pcall(function() player:RequestStreamAroundAsync(pos,CityPlan.TRAVEL.streamTimeout) end)
	if not ok then warn("[Shuttle] RequestStreamAroundAsync failed for "..player.Name..": "..tostring(err)) end
end
local function valid(trip: any): boolean
	local a=api
	if not a then return false end
	local player: Player=trip.player
	local root: BasePart?=trip.root
	return a.trips[player.UserId]==trip and player.Character==trip.character and root~=nil and root.Parent~=nil
end
-- Board the shuttle leg `key` (dir..":"..cycle). Internal: all checks done by the caller.
local function doBoard(s: any,ticket: Ticket,st: FP.State,character: Model,root: BasePart,humanoid: Humanoid)
	local a=api :: Api
	local player: Player=s.player
	local key=st.dir..":"..st.cycle
	local trip={player=player,state="flying",to=ticket.to,character=character,root=root,wasAnchored=root.Anchored,releaseAt=math.huge,
		kind="shuttle",price=ticket.price,session=s,leg=key,dir=st.dir,cycle=st.cycle,moved=false,arriving=false,arrived=false,display=nil}
	tickets[player.UserId]=nil
	a.trips[player.UserId]=trip
	a.setState(player,"flying")
	player:SetAttribute("ShuttleLeg",key)
	root.Anchored=true
	hide(trip,humanoid)
	local hold=if st.dir=="out" then FP.HOLD.home else FP.HOLD.abroad
	character:PivotTo(hold)
	Session.markDirty(s,true)
	-- pre-stream the take-off roll (the camera follows the aircraft down the runway)
	task.spawn(streamAsync,player,if st.dir=="out" then Vector3.new(0,CityPlan.GROUND,(CityPlan.AIRPORT.runway.z1+CityPlan.AIRPORT.runway.z2)/2) else Vector3.new(-250,CityPlan.GROUND,7555))
	return trip
end
function Shuttle.board(s: any): {[string]: any}
	local a=api
	if not a or not Shuttle.enabled() then return {ok=false,err="SHUTTLE_OFF"} end
	local player: Player=s.player
	local trip=a.trips[player.UserId]
	if trip and trip.state=="flying" then return {ok=false,err="BUSY"} end
	local ticket=tickets[player.UserId]
	if not ticket then return {ok=false,err="NO_TICKET"} end
	local character,root,humanoid=a.rootOf(player)
	if not character or not root or not humanoid or humanoid.Health&lt;=0 then return {ok=false,err="LOADING"} end
	if humanoid.SeatPart then return {ok=false,err="LEAVE_VEHICLE"} end
	local dir=if ticket.to=="abroad" then "out" else "back"
	local gates=if dir=="out" then FP.HOME_GATES else FP.PM_GATES
	if not nearAny(root.Position,gates,FP.GATE_RADIUS) then return {ok=false,err="NOT_AT_GATE"} end
	local t=now()
	local st=FP.at(t)
	if st.dir~=dir or st.phase~="boarding" then
		local _,legStart,departs=FP.nextLeg(dir,t)
		return {ok=false,err="NOT_BOARDING",boardingStarts=legStart,departs=departs,flight=FP.leg(dir).flight}
	end
	doBoard(s,ticket,st,character,root,humanoid)
	return {ok=true,flight=st.leg.flight,departs=st.legStart+st.leg.phases.pushback.t0,leg=st.dir..":"..st.cycle,to=ticket.to}
end
-- End of boarding: every ticket holder of this leg standing at the gate is boarded automatically.
local function autoBoard(st: FP.State)
	local a=api
	if not a then return end
	for userId,ticket in tickets do
		local dir=if ticket.to=="abroad" then "out" else "back"
		if dir~=st.dir then continue end
		local s=ticket.session
		local player: Player?=if s then s.player else nil
		if not player or s.closed then tickets[userId]=nil;continue end
		local trip=a.trips[userId]
		if trip and trip.state=="flying" then continue end
		local character,root,humanoid=a.rootOf(player)
		if character and root and humanoid and humanoid.Health&gt;0 and not humanoid.SeatPart
			and nearAny(root.Position,if dir=="out" then FP.HOME_GATES else FP.PM_GATES,FP.GATE_RADIUS) then
			doBoard(s,ticket,{cycle=st.cycle,dir=st.dir,leg=st.leg,tau=st.tau,phase="boarding",legStart=st.legStart,phaseStart=st.phaseStart,phaseEnd=st.phaseEnd},character,root,humanoid)
		end
	end
end

------------------------------------------------------------------------------------------------ ride
local function arrive(trip: any)
	local a=api
	if not a or trip.arriving then return end
	trip.arriving=true
	local player: Player=trip.player
	local dest=if trip.to=="abroad" then CityPlan.ABROAD.arrival else CityPlan.AIRPORT.arrival
	if trip.kind=="heli" then dest=trip.dest end
	task.spawn(function()
		streamAsync(player,dest.Position)
		if not valid(trip) then return end -- respawned / left meanwhile: drop() handled it
		local character: Model=trip.character
		local root: BasePart=trip.root
		character:PivotTo(dest)
		root.Anchored=trip.wasAnchored
		restore(trip)
		trip.arrived=true
		local wasShuttle=trip.kind=="shuttle"
		-- state first, then ShuttleLeg: the client reads TravelState when the ride ends (welcome message)
		if trip.to=="abroad" then trip.state="abroad";trip.kind=nil;a.setState(player,"abroad")
		else a.trips[player.UserId]=nil;a.setState(player,"home") end
		if wasShuttle then player:SetAttribute("ShuttleLeg",nil) end
		if trip.session then Session.markDirty(trip.session,true) end
	end)
end
local function moveHold(trip: any)
	trip.moved=true
	local player: Player=trip.player
	local target=if trip.to=="abroad" then FP.HOLD.abroad else FP.HOLD.home
	task.spawn(function()
		streamAsync(player,(if trip.to=="abroad" then FP.PM_STAND else FP.HOME_STAND).Position)
		if not valid(trip) or trip.arriving then return end
		local character: Model=trip.character
		character:PivotTo(target)
	end)
end

------------------------------------------------------------------------------------------------ helicopter
Shuttle.heliTimes=FP.heliTimes
function Shuttle.heliInfo(): (boolean,Vector3?,Vector3?)
	if not heli.fromPad or not heli.toPad or not heli.fromPad.Parent or not heli.toPad.Parent then findPads() end
	local fp,tp=heli.fromPad,heli.toPad
	if not fp or not tp then return false,nil,nil end
	return true,padTop(fp),padTop(tp)
end
local function shopOwns(player: Player,pass: string): boolean
	local ok,mod=pcall(function(): any return require(script.Parent.ShopService) end)
	local shop: any=if ok then mod else nil
	if typeof(shop)~="table" or typeof(shop.owns)~="function" then return false end
	local okOwns,owned=pcall(shop.owns,player,pass)
	return okOwns and owned==true
end
Shuttle.shopOwns=shopOwns
-- Arrival frames: next to the airport helipad gate / in the Meridian Grand lobby (the roof pad has no way down).
function Shuttle.heliArrival(to: string): CFrame
	if to=="hotel" then
		local hotel=CityPlan.INTL_HOTEL
		return if hotel then hotel.lobby else CityPlan.ABROAD.arrival
	end
	local ok,from=Shuttle.heliInfo()
	local p=if ok and from then from else Vector3.new(310,CityPlan.GROUND+1,7648)
	return CFrame.lookAt(Vector3.new(p.X-28,CityPlan.GROUND+3.5,p.Z+44),Vector3.new(p.X-28,CityPlan.GROUND+3.5,p.Z+80))
end
function Shuttle.heli(s: any,destination: any): {[string]: any}
	local a=api
	if not a then return {ok=false,err="HELI_UNAVAILABLE"} end
	if destination~="hotel" and destination~="airport" then return {ok=false,err="BAD_INPUT"} end
	local player: Player=s.player
	local trip=a.trips[player.UserId]
	local state=if trip then trip.state else "home"
	if state=="flying" then return {ok=false,err="BUSY"} end
	if state~="abroad" then return {ok=false,err="HELI_ABROAD_ONLY"} end
	local okPads,fromPad,toPad=Shuttle.heliInfo()
	if not okPads or not fromPad or not toPad then return {ok=false,err="HELI_UNAVAILABLE"} end
	local character,root,humanoid=a.rootOf(player)
	if not character or not root or not humanoid or humanoid.Health&lt;=0 then return {ok=false,err="LOADING"} end
	if humanoid.SeatPart then return {ok=false,err="LEAVE_VEHICLE"} end
	local hotel=CityPlan.INTL_HOTEL
	local startAt: Vector3=if destination=="hotel" then fromPad elseif hotel then hotel.lobby.Position else toPad
	if flat(root.Position,startAt)&gt;Shuttle.HELI_RADIUS or math.abs(root.Position.Y-startAt.Y)&gt;16 then return {ok=false,err="NOT_AT_HELIPAD"} end
	local t=now()
	if heli.busyUntil&gt;t then return {ok=false,err="HELI_BUSY",seconds=math.ceil(heli.busyUntil-t)} end
	local pass=shopOwns(player,"limo")
	local price=if pass then 0 else Shuttle.HELI_FEE
	if not Economy.spend(s,price,"travel") then return {ok=false,err="NO_MONEY",price=price} end
	-- The helicopter waits on the airport pad: to the hotel = ride A-&gt;B then an empty ferry back; to the airport
	-- = ferry A-&gt;B to pick the passenger up, then the ride B-&gt;A. (Shuttle.heliTimes, the same on the client.)
	local ride0,ride1,busy=Shuttle.heliTimes(destination,t,fromPad,toPad)
	local dest=Shuttle.heliArrival(destination)
	local hold=if destination=="hotel" then fromPad else toPad
	local ride={player=player,state="flying",to="abroad",character=character,root=root,wasAnchored=root.Anchored,releaseAt=math.huge,
		kind="heli",price=price,session=s,dest=dest,finishAt=ride1,arriving=false,arrived=false,display=nil}
	a.trips[player.UserId]=ride
	a.setState(player,"flying")
	root.Anchored=true
	hide(ride,humanoid)
	character:PivotTo(CFrame.new(hold.X,CityPlan.GROUND-40,hold.Z))
	heli.busyUntil=busy
	setAttr("HeliStart",t);setAttr("HeliMode",destination);setAttr("HeliRider",player.UserId)
	Session.markDirty(s,true)
	task.spawn(streamAsync,player,dest.Position)
	return {ok=true,seconds=ride1-t,rideStart=ride0,price=price,pass=pass,destination=if destination=="hotel" then "Meridian Grand Hotel" else "Port Meridian Airport",start=t}
end

------------------------------------------------------------------------------------------------ drop / status
-- A respawn (reason "respawn") or leaving ("leave"): cancels the ride (refund unless arrived), clears tickets.
-- Called by CityService BEFORE it resets the trip.
function Shuttle.drop(player: Player,reason: string)
	local a=api
	local ticket=tickets[player.UserId]
	if ticket then
		-- an unused paid ticket survives a respawn at home; leaving refunds it; a "home" ticket is moot after a respawn
		if reason=="leave" then refund(ticket.session,ticket.price);tickets[player.UserId]=nil
		elseif ticket.to=="home" then tickets[player.UserId]=nil end
	end
	if not a then return end
	local trip=a.trips[player.UserId]
	if trip and (trip.kind=="shuttle" or trip.kind=="heli") and not trip.arrived then
		refund(trip.session,trip.price or 0)
		local root: BasePart?=trip.root
		if root and root.Parent then root.Anchored=trip.wasAnchored end
		restore(trip)
		trip.arrived=true -- never processed again
		if trip.kind=="shuttle" then pcall(function() player:SetAttribute("ShuttleLeg",nil) end) end
	end
end
function Shuttle.status(player: Player): {[string]: any}
	local t=now()
	local st=FP.at(t)
	local ticket=tickets[player.UserId]
	local _,_,depOut=FP.nextLeg("out",t);local _,_,depBack=FP.nextLeg("back",t)
	local okPads=Shuttle.heliInfo()
	return {shuttle=Shuttle.enabled(),phase=st.phase,leg=st.dir,flight=st.leg.flight,nextOut=depOut,nextBack=depBack,
		ticketTo=if ticket then ticket.to else nil,heli=okPads,heliFee=Shuttle.HELI_FEE,heliPass=shopOwns(player,"limo")}
end
function Shuttle.state(): FP.State return FP.at(now()) end

------------------------------------------------------------------------------------------------ tick
function Shuttle.tick(_dt: number)
	local a=api
	if not a or not folder then return end
	local t=now()
	local st=FP.at(t)
	local key=st.dir..":"..st.cycle
	local crewState=FP.crewState(st)
	if key~=lastKey or st.phase~=lastPhase or crewState~=lastCrew then
		lastKey=key;lastPhase=st.phase;lastCrew=crewState
		publish(st,t)
	end
	-- the helipads may be built after the shuttle started (or stream in later on a test server): retry
	local f=folder :: Folder
	if f:GetAttribute("HeliAvailable")~=true and t&gt;=nextPadSearch then
		nextPadSearch=t+5
		local okPads,fromPad,toPad=Shuttle.heliInfo()
		if okPads and fromPad and toPad then
			f:SetAttribute("HeliFromPad",fromPad);f:SetAttribute("HeliToPad",toPad);f:SetAttribute("HeliAvailable",true)
		end
	end
	-- auto-boarding once per leg, when boarding has ended (doors closing)
	if Shuttle.enabled() and st.phase~="boarding" and not autoDone[key] and st.tau&lt;st.leg.phases.pushback.t0 then
		autoDone[key]=true
		autoBoard(st)
	end
	-- riders
	for _,trip in a.trips do
		if trip.arrived or trip.arriving then continue end
		if trip.kind=="shuttle" then
			if not valid(trip) then continue end -- CharacterAdded / closing calls drop()
			local leg=FP.leg(trip.dir)
			local start=FP.legStart(trip.dir,trip.cycle)
			local cruise=leg.phases.cruise
			if not trip.moved and t&gt;=start+(cruise.t0+cruise.t1)/2 then moveHold(trip) end
			if t&gt;=start+leg.phases.deboarding.t0 then arrive(trip) end
		elseif trip.kind=="heli" then
			if not valid(trip) then continue end
			if t&gt;=trip.finishAt then arrive(trip) end
		end
	end
	-- forget old auto-board keys
	local n=0
	for _ in autoDone do n+=1 end
	if n&gt;8 then table.clear(autoDone);autoDone[key]=true end
end

------------------------------------------------------------------------------------------------ init
function Shuttle.init(cityApi: Api)
	api=cityApi
	local old=ReplicatedStorage:FindFirstChild("Shuttle")
	if old then old:Destroy() end
	local f=Instance.new("Folder");f.Name="Shuttle"
	local C=FP.CONFIG
	f:SetAttribute("Enabled",Shuttle.ENABLED);f:SetAttribute("Interval",FP.interval());f:SetAttribute("Epoch",C.epoch)
	f:SetAttribute("Kind",C.kind);f:SetAttribute("Scale",C.scale);f:SetAttribute("Airline",C.airline)
	f:SetAttribute("Ticket",CityPlan.TRAVEL.ticket);f:SetAttribute("HeliFee",Shuttle.HELI_FEE)
	folder=f
	buildCrew(f)
	local okPads,fromPad,toPad=Shuttle.heliInfo()
	f:SetAttribute("HeliAvailable",okPads)
	if fromPad and toPad then f:SetAttribute("HeliFromPad",fromPad);f:SetAttribute("HeliToPad",toPad) end
	f.Parent=ReplicatedStorage
	-- gate prompts
	local gates=workspace:FindFirstChild("ShuttleGates")
	if gates then gates:Destroy() end
	local g=Instance.new("Folder");g.Name="ShuttleGates"
	gatePrompt(g,"GateBoardHome",findHomeDesk(),"home","Gate "..FP.GATE_NAME.out.." · "..C.flights.out.." to Port Meridian")
	gatePrompt(g,"GateBoardAbroad",FP.PM_GATES[1],"abroad",C.flights.back.." to City Airport")
	g.Parent=workspace
	lastKey="";lastPhase="";lastCrew="";nextPadSearch=0
	table.clear(autoDone)
	local st=FP.at(now())
	autoDone[st.dir..":"..st.cycle]=st.phase~="boarding" -- a leg already past boarding at start-up boards nobody
	Shuttle.tick(0)
end
-- Formatting helper for messages (server-side notices).
function Shuttle.clock(serverTime: number): string
	local sec=math.max(0,math.floor(serverTime-now()))
	return Format.duration(sec)
end
return Shuttle
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000036"><Properties><string name="Name">StaffAssignment</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Staff assignment for a built office: one rig per hired employee with a home desk, plus the operations
-- staff at their OperationsStation posts (SPEC §10). Called by HeadquartersDesign.staff at the end of every
-- build and whenever the hired team changes (PlotService compares StaffKey).
-- Desks: pass 1 gives every employee a desk whose PreferredRole is their role (lowest floor first);
-- pass 2 seats the rest at any desk their clearance allows ("any" desks first, lowest floor first).
-- Identities: generated from (index, owner), or from session.data.empire.staffProfiles (see profile()).
-- Plan tier = the built office's OfficeTier attribute (tier 0 = garage stage: 5 team desks, the founder's
-- and the assistant's desks are not for staff, no operations posts). Operations posts are optional where
-- the plan has none (garage stage), where EmployeeConfig.OPTIONAL_POSTS lists them, or where they belong to
-- an annex that this tier does not build (guest house jobs without Plan.hasHotel): those are skipped
-- silently; any other missing post (incl. a guest-house post in a tier with the guest house) warns once.
-- staffops:
--  * INCREMENTAL: a rig whose identity (role, appearance seed, name) is still on the team keeps its Model
--    and its desk; only new people get a rig (built hidden: OffDuty, StaffService walks them in through
--    reception) and people who left lose theirs. Indices are renumbered in place. A hire therefore costs
--    one rig instead of rebuilding (and re-replicating) every rig of the office. StaffRev counts calls.
--  * Apprentices (empire.apprentices, CORE_SPEC 11.1) look young: no facial hair, no grey hair, a green
--    "Apprentice" lanyard and badge, a slightly smaller build (Model:ScaleTo, within the existing body-size
--    spread). dressApprentice also undoes the lanyard / badge / size at graduation (StaffService).
--  * The Training Lead (OPERATIONS_JOBS[17]) is placed only while the company has apprentices, at a free
--    desk in the People &amp; Company (HR) room, else another free operations desk, else at the reception.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local EmployeeConfig=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local CampusMath=require(ReplicatedStorage.Shared.CampusMath)
local Ops=require(ReplicatedStorage.Shared.CompanyOps)
local Rig=require(script.Parent.EmployeeRigDesign)
local Assignment={}
local warned: {[string]:boolean}={}
-- Operations jobs whose posts belong to an annex building (built only in some plan tiers).
local ANNEX_JOBS: {[string]:string}={["Hotel Reception"]="hotel",Housekeeping="hotel"}
local rgb=Color3.fromRGB
Assignment.APPRENTICE_GREEN=rgb(118,196,64)
Assignment.APPRENTICE_BADGE=rgb(214,240,190)
local BADGE=rgb(227,230,215)
local function hex(c: Color3): number
 return math.floor(c.R*255+.5)*65536+math.floor(c.G*255+.5)*256+math.floor(c.B*255+.5)
end
-- the grey hair tones of EmployeeRigDesign (GREY) for "older" looks
local GREY_HAIR: {[number]:boolean}={[hex(rgb(124,122,120))]=true,[hex(rgb(160,158,154))]=true,[hex(rgb(206,204,198))]=true}
local YOUNG_HAIR={rgb(24,21,20),rgb(44,34,28),rgb(70,52,38),rgb(101,70,45),rgb(156,96,56),rgb(196,160,104)}
local HAIR_PARTS={Hair=true,HairBack=true,LongHair=true,Bob=true,Braid=true,CurlsBack=true,Curl=true,SidePart=true,HairBun=true,Ponytail=true}
local FACIAL={Beard=true,ShortBeard=true,Moustache=true}
-- Training Lead uniform tones (same build-up as EmployeeRigDesign.UNIFORMS: shirt / trousers)
local TRAINER={shirt=rgb(46,126,112),trousers=rgb(44,50,66),lanyard=rgb(118,196,64)}
type Person={index:number,role:string,profile:Rig.Profile?,seed:number,name:string,rig:Model?}
local function key(id: any): string return tostring(id) end
local function folder(office: Model,name: string): (Folder,boolean)
 local existing=office:FindFirstChild(name)
 if existing and existing:IsA("Folder") then return existing,true end
 if existing then existing:Destroy() end
 local f=Instance.new("Folder");f.Name=name;f.Parent=office;return f,false
end
-- Persistent identity hook: session.data.empire.staffProfiles[roleId][i] = {n=name, s=seed, k=skill}
-- gives the i-th employee of that role its name, appearance seed and Skill attribute. Invalid fields
-- fall back to the generated identity; StaffKey still only reflects the hired counts.
local function profile(raw: any): Rig.Profile?
 if typeof(raw)~="table" then return nil end
 local n=raw.n;local s=raw.s;local k=raw.k
 local out: Rig.Profile={
  n=if typeof(n)=="string" and string.match(n,"%S") then string.sub(n,1,40) else nil,
  s=if typeof(s)=="number" and s==s and math.abs(s)&lt;1e15 then s else nil,
  k=if typeof(k)=="number" and k==k then math.clamp(math.floor(k+.5),1,5) else nil,
 }
 return if out.n or out.s or out.k then out else nil
end
-- The identity Rig.build gives (index, owner, profile): appearance seed + name decide the whole look.
local function identity(index: number,owner: number,p: Rig.Profile?): (number,string)
 local seed=if p and p.s then math.floor(math.abs(p.s))%2147483647 else EmployeeConfig.seed(index,owner)
 local name=if p and p.n then p.n else CampusMath.staffName(index,owner)
 return seed,name
end
local function identKey(role: any,seed: any,name: any): string
 return tostring(role).."|"..tostring(seed).."|"..tostring(name)
end
local function standing(m: Model): CFrame?
 local seat=m:GetAttribute("SeatPosition")
 if typeof(seat)=="CFrame" then return seat*CFrame.new(0,1.6,0) end
 local p=m:GetAttribute("InteractionPosition");if typeof(p)~="Vector3" then return nil end
 local face=m:GetAttribute("FacingPosition")
 if typeof(face)=="Vector3" then
  local level=Vector3.new(face.X,p.Y,face.Z)
  if (level-p).Magnitude&gt;.1 then return CFrame.lookAt(p,level) end
 end
 return CFrame.new(p)
end
local function set(m: Instance,name: string,value: any)
 if m:GetAttribute(name)~=value then m:SetAttribute(name,value) end
end
local function badgeLabel(model: Model): TextLabel?
 local head=model:FindFirstChild("Head")
 local badge=if head then head:FindFirstChild("EmployeeBadge") else nil
 local label=if badge then badge:FindFirstChildWhichIsA("TextLabel") else nil
 return label
end
-- Young look + "Apprentice" lanyard/badge (on), or back to the regular badge at graduation (off).
function Assignment.dressApprentice(model: Model,on: boolean,_empire: any?)
 local role=model:GetAttribute("RoleId")
 local title=EmployeeConfig.ROLES[tostring(role)] or "Employee"
 local name=tostring(model:GetAttribute("EmployeeName") or "")
 local label=badgeLabel(model)
 if on then
  if model:GetAttribute("Apprentice")==true then return end
  model:SetAttribute("Apprentice",true)
  local seed=tonumber(model:GetAttribute("PersonalitySeed")) or 0
  local young=YOUNG_HAIR[seed%#YOUNG_HAIR+1]
  for _,p in model:GetDescendants() do
   if p:IsA("BasePart") then
    if FACIAL[p.Name] then p:Destroy()
    elseif p.Name=="Lanyard" then
     if model:GetAttribute("LanyardColor")==nil then model:SetAttribute("LanyardColor",p.Color) end
     p.Color=Assignment.APPRENTICE_GREEN
    elseif p.Name=="IDBadge" then p.Color=Assignment.APPRENTICE_BADGE
    elseif HAIR_PARTS[p.Name] and GREY_HAIR[hex(p.Color)] then p.Color=young end
   elseif p:IsA("Frame") and p.Name=="Brow" and GREY_HAIR[hex(p.BackgroundColor3)] then p.BackgroundColor3=young end
  end
  if label then label.Text=name.."\nApprentice · "..title end
  local scale=EmployeeConfig.APPRENTICE.scale
  if math.abs(model:GetScale()-1)&lt;1e-3 and scale&lt;1 then model:ScaleTo(scale) end
 else
  if model:GetAttribute("Apprentice")~=true then return end
  model:SetAttribute("Apprentice",nil)
  local lanyard=model:GetAttribute("LanyardColor")
  for _,p in model:GetDescendants() do
   if p:IsA("BasePart") then
    if p.Name=="Lanyard" and typeof(lanyard)=="Color3" then p.Color=lanyard
    elseif p.Name=="IDBadge" then p.Color=BADGE end
   end
  end
  model:SetAttribute("LanyardColor",nil)
  if label then label.Text=name.."\n"..title end
  if math.abs(model:GetScale()-1)&gt;1e-3 then model:ScaleTo(1) end
 end
end
-- Training Lead: uniform tones on the shirt (torso, sleeves) and trousers, the programme's green lanyard.
local function dressTrainer(model: Model)
 for _,p in model:GetDescendants() do
  if p:IsA("BasePart") then
   if p.Name=="Torso" or p.Name=="Left Arm" or p.Name=="Right Arm" then p.Color=TRAINER.shirt
   elseif (p.Name=="Left Leg" or p.Name=="Right Leg") and model:FindFirstChild("Skirt")==nil then p.Color=TRAINER.trousers
   elseif p.Name=="Lanyard" then p.Color=TRAINER.lanyard end
  end
 end
end
-- Active apprentices of a save (CompanyOps.apprentice on today's company day): seed -&gt; true
local function apprenticeSeeds(e: any): {[number]:boolean}
 local out: {[number]:boolean}={}
 if typeof(e.apprentices)~="table" or next(e.apprentices)==nil then return out end
 local day=Ops.day(e)
 for k in e.apprentices do
  local seed=tonumber(k)
  if seed and Ops.apprentice(e,seed,day) then out[seed]=true end
 end
 return out
end
Assignment.apprenticeSeeds=apprenticeSeeds
function Assignment.assign(office: Model,cf: CFrame,session: any)
 local tierAttr=office:GetAttribute("OfficeTier")
 local tier: number=if typeof(tierAttr)=="number" then tierAttr else Plan.tierForOffice(session.data.empire.office)
 local owner=session.userId
 local fallback=Plan.staffFallback(tier) -- used only when no desk is left (HQ: staff atrium)
 local employees,hadEmployees=folder(office,"Employees")
 local operations,_=folder(office,"OperationsEmployees")
 -- rigs added to an office that already has staff appear hidden: StaffService walks them in (first day)
 local live=hadEmployees
 -- One descendants pass: Computer desks and operations posts.
 local desks: {Model}={};local posts: {[number]:Model}={};local byId: {[string]:Model}={}
 for _,m in office:GetDescendants() do
  if m:IsA("Model") and m:GetAttribute("WorkstationId")~=nil then
   local kind=m:GetAttribute("WorkstationType")
   if kind=="Computer" then table.insert(desks,m);byId[key(m:GetAttribute("WorkstationId"))]=m
   elseif kind=="Service" then
    local i=m:GetAttribute("OpsIndex")
    if typeof(i)=="number" and not posts[i] then posts[i]=m end
   end
  end
 end
 table.sort(desks,function(a,b)return key(a:GetAttribute("WorkstationId"))&lt;key(b:GetAttribute("WorkstationId")) end)
 -- Clearance per (desk, role) is static for this office: compute once.
 local clearance: {[Model]:{[string]:boolean}}={}
 local function allowed(w: Model,role: string): boolean
  local byRole=clearance[w];if not byRole then byRole={};clearance[w]=byRole end
  local ok=byRole[role]
  if ok==nil then
   local p=w:GetAttribute("InteractionPosition");local r=w:GetAttribute("Role");local access=w:GetAttribute("RoomAccess")
   ok=typeof(p)=="Vector3" and (r==nil or r=="any" or r==role) and Plan.roleAllows(role,if typeof(access)=="string" then access else nil) and Plan.employeeAllowed(role,tier,cf:PointToObjectSpace(p))
   byRole[role]=ok
  end
  return ok==true
 end
 local function floor(w: Model): number local f=w:GetAttribute("Floor");return if typeof(f)=="number" then f else 0 end
 local profiles=session.data.empire.staffProfiles
 local people: {Person}={};local staffKey=""
 for _,role in EmpireConfig.ROLES do
  local count=session.data.empire.employees[role.id] or 0
  staffKey..=role.id..tostring(count)
  local list=if typeof(profiles)=="table" then profiles[role.id] else nil
  for i=1,count do
   local index=#people+1
   local p=profile(if typeof(list)=="table" then list[i] else nil)
   local seed,name=identity(index,owner,p)
   table.insert(people,{index=index,role=role.id,profile=p,seed=seed,name=name})
  end
 end
 -- keep every rig whose person is still on the team (same role, seed and name = the same look)
 local existing: {[string]:{Model}}={}
 for _,m in employees:GetChildren() do
  if m:IsA("Model") then
   local k=identKey(m:GetAttribute("RoleId"),m:GetAttribute("PersonalitySeed"),m:GetAttribute("EmployeeName"))
   local list=existing[k];if not list then list={};existing[k]=list end
   table.insert(list,m)
  end
 end
 for _,person in people do
  local list=existing[identKey(person.role,person.seed,person.name)]
  if list and #list&gt;0 then person.rig=table.remove(list,1) end
 end
 for _,list in existing do for _,m in list do m:Destroy() end end
 local taken: {[Model]:boolean}={};local home: {[number]:Model}={}
 -- kept people keep their desk while it is still theirs to use
 for _,person in people do
  local m=person.rig
  if m then
   local w=byId[key(m:GetAttribute("HomeWorkstation"))]
   if w and not taken[w] and allowed(w,person.role) then taken[w]=true;home[person.index]=w end
  end
 end
 local function pick(person: Person,preferredOnly: boolean)
  local best: Model?=nil;local score=-math.huge
  for _,w in desks do
   if taken[w] then continue end
   local preferred=w:GetAttribute("PreferredRole")
   if preferredOnly and preferred~=person.role then continue end
   if not allowed(w,person.role) then continue end
   local value=(if preferredOnly or preferred==nil or preferred=="any" then 500 else 0)-floor(w)*5
   if value&gt;score then best=w;score=value end
  end
  if best then taken[best]=true;home[person.index]=best end
 end
 for _,person in people do if not home[person.index] then pick(person,true) end end
 for _,person in people do if not home[person.index] then pick(person,false) end end
 local apprentices=apprenticeSeeds(session.data.empire)
 for _,person in people do
  local best=home[person.index]
  local work: CFrame=(if best then standing(best) else nil) or cf*CFrame.new(fallback+Vector3.new((person.index%3-1)*3,0,0))
  local kept=person.rig
  local employee: Model
  if kept then
   employee=kept
   -- renumber in place (the rig index follows the team list: TalkService profileOf, Employee_&lt;i&gt;)
   if employee:GetAttribute("StaffIndex")~=person.index then
    employee:SetAttribute("StaffIndex",person.index);employee.Name="Employee_"..person.index
    local head=employee:FindFirstChild("Head");local prompt=if head then head:FindFirstChild("EmployeeTalk") else nil
    if prompt then prompt:SetAttribute("EmployeeTalk",person.index) end
   end
   if person.profile and person.profile.k then set(employee,"Skill",person.profile.k) end
  else
   employee=Rig.build(employees,owner,person.index,person.role,work,person.profile)
   if live then employee:SetAttribute("OffDuty",true) end
  end
  local e=employee
  set(e,"HomeWorkstation",if best then best:GetAttribute("WorkstationId") else "")
  set(e,"WorkCFrame",work);set(e,"CampusCFrame",cf)
  set(e,"StaffFloor",if best then Plan.levelY(floor(best)) else 0)
  local localPos=cf:PointToObjectSpace(work.Position);set(e,"StaffX",localPos.X);set(e,"StaffZ",localPos.Z)
  local young=apprentices[person.seed]==true and person.role~="support"
  if young~=(e:GetAttribute("Apprentice")==true) then Assignment.dressApprentice(e,young,session.data.empire) end
 end
 -- Operations staff 301.. at their posts; a missing post skips that person. A post is expected (else one
 -- warning) in the HQ tiers unless EmployeeConfig.OPTIONAL_POSTS lists it; the posts of an annex job are
 -- expected exactly when the annex is built (guest house: Plan.hasHotel); the garage stage has none.
 local missing={}
 local optional: {[number]:boolean}=(EmployeeConfig :: any).OPTIONAL_POSTS or {}
 local keepOps: {[number]:Model}={}
 for _,m in operations:GetChildren() do
  local i=m:GetAttribute("StaffIndex")
  if m:IsA("Model") and typeof(i)=="number" and not keepOps[i] then keepOps[i]=m else m:Destroy() end
 end
 local leadPost=(EmployeeConfig :: any).TRAINING_LEAD_POST or 17
 for i,job in EmployeeConfig.OPERATIONS_JOBS do
  local existingRig=keepOps[300+i];keepOps[300+i]=nil
  if i==leadPost then
   -- the Training Lead: only while there are apprentices, at a free HR desk (else reception)
   if next(apprentices)==nil or tier&lt;1 then
    if existingRig then existingRig:Destroy() end
    continue
   end
   local desk: Model?=nil
   local existingDesk=if existingRig then byId[key(existingRig:GetAttribute("HomeWorkstation"))] else nil
   if existingDesk and not taken[existingDesk] then desk=existingDesk end
   if not desk then
    local bestScore=-math.huge
    for _,w in desks do
     if taken[w] or not allowed(w,"support") then continue end
     local room=Plan.room(tier,tostring(w:GetAttribute("HomeRoom")))
     local score=(if room and room.kind=="hr" then 1000 elseif w:GetAttribute("Department")=="operations" then 500 else 0)-floor(w)*5
     if score&gt;bestScore then desk=w;bestScore=score end
    end
   end
   if desk then taken[desk]=true end
   local work=(if desk then standing(desk) else nil) or cf*CFrame.new(Plan.visitorRoute(tier).portal+Vector3.new(6,0,8))
   local lead=existingRig or Rig.build(operations,owner,300+i,"support",work)
   if not existingRig then
    dressTrainer(lead)
    if live then lead:SetAttribute("OffDuty",true) end
   end
   set(lead,"HomeWorkstation",if desk then desk:GetAttribute("WorkstationId") else "")
   set(lead,"WorkCFrame",work);set(lead,"CampusCFrame",cf)
   set(lead,"StaffFloor",if desk then Plan.levelY(floor(desk)) else 0)
   local lp=cf:PointToObjectSpace(work.Position);set(lead,"StaffX",lp.X);set(lead,"StaffZ",lp.Z)
   continue
  end
  local post=posts[i];local work=if post then standing(post) else nil
  if not post or not work then
   if existingRig then existingRig:Destroy() end
   local annex=ANNEX_JOBS[job]
   local expected=tier&gt;=1 and (if annex=="hotel" then Plan.hasHotel(tier) else not optional[i])
   if expected then table.insert(missing,i) end
   continue
  end
  local r: Model
  if existingRig and existingRig:GetAttribute("HomeWorkstation")==post:GetAttribute("WorkstationId") then r=existingRig
  else
   if existingRig then existingRig:Destroy() end
   r=Rig.build(operations,owner,300+i,"support",work)
   if live then r:SetAttribute("OffDuty",true) end
  end
  set(r,"HomeWorkstation",post:GetAttribute("WorkstationId"));set(r,"WorkCFrame",work);set(r,"CampusCFrame",cf)
  set(r,"StaffFloor",Plan.levelY(floor(post)))
  local localPos=cf:PointToObjectSpace(work.Position);set(r,"StaffX",localPos.X);set(r,"StaffZ",localPos.Z)
 end
 for _,m in keepOps do m:Destroy() end
 if #missing&gt;0 then
  local id=tostring(tier)..":"..table.concat(missing,",")
  if not warned[id] then warned[id]=true;warn(`[Staff] Missing OperationsStation posts (OpsIndex {table.concat(missing,", ")}) in tier {tier}; those operations staff are not placed.`) end
 end
 office:SetAttribute("StaffKey",staffKey);office:SetAttribute("StaffCount",#people)
 office:SetAttribute("StaffRev",(tonumber(office:GetAttribute("StaffRev")) or 0)+1)
end
return Assignment
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000037"><Properties><string name="Name">StaffEvents</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- StaffEvents (staffops): visible company flows that are more than one task at one station. Run by
-- StaffService (helpers injected with bind(), like StaffJobs); ANIMATION ONLY - money, output, faults and
-- graduations are decided by CompanyOps / EmpireService, these flows only show them.
--  * First day: a new hire (auto-HR, agency or interview) arrives from the street (or the visitor lounge),
--    checks in at the reception (badge printer) and walks to the new desk.
--  * Rack faults (CompanyOps.faults, user request 23): the faulty data-hall blade gets FxState "broken" plus
--    FaultSlot / FaultUntil (the economy's own repair estimate) for the client (PropFxController: red LEDs,
--    beacon, "Rack R3 · fault · capacity -1"). IT Support (or an engineer where IT may not enter / there is no
--    IT post) walks to the rack with a laptop and repairs it in a pose loop until the ECONOMY clears the fault;
--    someone who arrives after the fix still does a short closing step.
--  * Apprentices (CORE_SPEC 11.1, user request 18): the Training Lead leads a tour group of first-day
--    apprentices past 4-6 rooms (stop in front of the door, "present" pose, Task "Tour:&lt;room id&gt;" for the
--    talk lines), runs one training session a day in a meeting room (apprentices seated, the trainer
--    standing at the head of the table), and coaches apprentices at their desks; apprentices otherwise
--    practise at their own desk or sit next to a senior colleague (shadowing).
-- Cheap: one office pass per second for faults and the academy, no per-frame work, one attribute write per
-- state change. Every walk goes through StaffJobs.moveTo (movers cap, bounded navigation).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Collection = game:GetService("CollectionService")
local Config = require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Layout = require(ReplicatedStorage.Shared.BuildingLayout)
local Ops = require(ReplicatedStorage.Shared.CompanyOps)
local Workstations = require(script.Parent.WorkstationService)
local Nav = require(script.Parent.EmployeeNavigation)
local Jobs = require(script.Parent.StaffJobs)

local Events = {}
type Api = {
	now: () -&gt; number,
	hour: () -&gt; number,
	state: (e: any, name: string) -&gt; (),
	jitter: (e: any, max: number) -&gt; number,
	begin: (e: any, def: any, w: any) -&gt; (),
}
local api: Api = {
	now = function(): number
		return 0
	end,
	hour = function(): number
		return 12
	end,
	state = function(_e: any, _name: string) end,
	jitter = function(_e: any, _max: number): number
		return 0
	end,
	begin = function(_e: any, _def: any, _w: any) end,
}
function Events.bind(a: Api)
	api = a
end

Events.WORK_STATE = { researcher = "RESEARCH", engineer = "WORKING", curator = "DATA_REVIEW", marketer = "MARKETING" }
Events.REPAIR_POSES = {
	{ pose = "inspect", item = "laptop" },
	{ pose = "typeStand", item = "laptop" },
	{ pose = "plug", item = "" },
	{ pose = "reach", item = "blade" },
	{ pose = "typeStand", item = "laptop" },
} :: { { pose: string, item: string } }
Events.CLOSE_SECONDS = 4 -- closing step after the economy cleared a fault (log the fix, close the rack)
Events.REPAIR_RETRY = 20 -- a fault nobody could reach is offered again after this many seconds
Events.GATHER_SECONDS = 45 -- a tour stop / training session starts at the latest this long after the call
Events.BADGE_SECONDS = 5

-- Per office state that must survive a staff rebuild (records are recreated, the office model stays).
type Memory = { toured: { [number]: boolean }, sessionDay: number?, pending: { [number]: any } }
local memory: { [Instance]: Memory } = setmetatable({}, { __mode = "k" }) :: any
local function mem(office: Instance): Memory
	local m = memory[office]
	if not m then
		m = { toured = {}, sessionDay = nil, pending = {} }
		memory[office] = m
	end
	return m
end
Events.memory = mem

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end
local function face(e: any, point: Vector3?)
	if not point or not e.root.Parent or e.humanoid.SeatPart then
		return
	end
	e.root.Anchored = false
	e.humanoid.AutoRotate = false
	local d = Vector3.new(point.X - e.root.Position.X, 0, point.Z - e.root.Position.Z)
	if d.Magnitude &gt; 0.2 then
		e.root.CFrame = CFrame.lookAt(e.root.Position, e.root.Position + d)
	end
	e.root.Anchored = true
end
local function setTask(e: any, id: string, state: string?)
	e.task = { id = id, state = state or e.state }
	e.model:SetAttribute("Task", id)
end
-- Normal life again: StaffService picks the next task (selectTask / StaffJobs.next) on the next tick.
local function done(e: any, delay: number?)
	e.event = nil
	Workstations.setItem(e, nil)
	Workstations.setPose(e, nil)
	if e.root.Parent and not e.humanoid.SeatPart then
		e.root.Anchored = false
	end
	api.state(e, "SELECT_TASK")
	e.next = api.now() + (delay or 1)
end
-- Free for an event: awake, on duty, not walking/eating/talking/riding, not already in an event.
function Events.free(e: any): boolean
	return not e.dead
		and e.root.Parent ~= nil
		and e.lod ~= "sleep"
		and not e.talkHold
		and e.event == nil
		and e.lunch == nil
		and e.onDuty == true
		and e.state ~= "OFF_DUTY"
		and e.state ~= "LEAVING"
		and e.state ~= "ARRIVING"
		and e.state ~= "INACTIVE"
		and not e.forced
		and not Nav.liftBusy(e)
end
local function stop(e: any, c: any)
	-- leaves whatever it was doing (job step, desk, walk) without moving
	Jobs.abort(e, c)
	Nav.cancel(e)
	Workstations.release(e)
	e.pendingWalk = nil
	e.walkTask = nil
	e.next = math.huge
end
local function local_(e: any, p: Vector3): Vector3
	return e.cf:PointToObjectSpace(p)
end
local function floorPoint(e: any, p: Vector3): Vector3?
	-- the same spot at root height on its plan level (building-local Y = level Y + 3)
	local l = local_(e, p)
	local level = Plan.levelAt(e.tier, l.Y)
	if level == nil then
		return nil
	end
	return e.cf * Vector3.new(l.X, Plan.levelY(level) + 3, l.Z)
end

---------------------------------------------------------------------------------------------
-- First day
---------------------------------------------------------------------------------------------
-- Check-in point in front of reception (post 1): beside the receptionist's greeting spot, facing it.
local function checkIn(c: any): (Vector3?, Vector3?, string?)
	if c.tier &lt; 1 then
		return nil, nil, nil
	end
	for _, w in Workstations.scan(c.office).byKind.Service or {} do
		if w.model:GetAttribute("OpsIndex") == 1 then
			local g = w.model:GetAttribute("JobPoint_greet")
			local f = w.model:GetAttribute("JobFace_greet")
			local prop = w.model:GetAttribute("JobProp_printer")
			if typeof(g) == "Vector3" and typeof(f) == "Vector3" then
				local d = Vector3.new(f.X - g.X, 0, f.Z - g.Z)
				if d.Magnitude &gt; 0.1 then
					return g + d.Unit * 2.6, g, if typeof(prop) == "string" then prop else nil
				end
			end
			local facing = w.model:GetAttribute("FacingPosition")
			if typeof(facing) == "Vector3" then
				local d = Vector3.new(facing.X - w.position.X, 0, facing.Z - w.position.Z)
				if d.Magnitude &gt; 0.1 then
					return w.position + d.Unit * 5, w.position, if typeof(prop) == "string" then prop else nil
				end
			end
		end
	end
	return nil, nil, nil
end
-- A new hire arrives (from: where they appear; nil = where they stand). Reception first, then the desk.
function Events.arrive(e: any, c: any, from: CFrame?)
	stop(e, c)
	if from and e.root.Parent then
		e.model:PivotTo(from)
	end
	e.root.Anchored = false
	e.humanoid.EvaluateStateMachine = true
	e.model:SetAttribute("OffDuty", false)
	e.firstDay = true
	setTask(e, "FirstDay", "ARRIVING")
	api.state(e, "ARRIVING")
	local point, receptionist, prop = checkIn(c)
	e.event = { kind = "arrive", phase = "reception", since = api.now() }
	if not point then
		Events.toDesk(e, c)
		return
	end
	local ev = e.event
	Jobs.moveTo(e, c, point, nil, function(ok: boolean)
		if e.event ~= ev then
			return
		end
		if not ok then
			Events.toDesk(e, c)
			return
		end
		face(e, receptionist)
		api.state(e, "ARRIVING")
		Workstations.setPose(e, "reach")
		if prop then
			Workstations.useProp(c.office, prop, 4)
		end
		ev.phase = "badge"
		ev.untilTime = api.now() + Events.BADGE_SECONDS
		ev.itemAt = api.now() + 1.5
	end, true)
end
-- After the badge (or without a reception): the normal walk to the home desk.
function Events.toDesk(e: any, c: any)
	e.event = nil
	Workstations.setItem(e, nil)
	Workstations.setPose(e, nil)
	if e.root.Parent then
		e.root.Anchored = false
	end
	local def = (Config.TASKS[e.role] or Config.TASKS.support)[1]
	local home = Workstations.scan(e.office).byId[e.home] or Workstations.choose(e, def)
	e.next = api.now()
	api.state(e, "SELECT_TASK")
	api.begin(e, def, home)
	if e.task then
		e.model:SetAttribute("Task", e.task.id)
	end
end
-- Interview hire: the new employee takes over from the visitor rig (RecruitingService), or a hire made
-- while the person is off duty arrives through reception at the next shift start. `hold`: the candidate
-- is still walking out to the speed gates; the rig stays hidden until Events.handover (at most HOLD_SECONDS).
local HOLD_SECONDS = 120
function Events.expect(office: Instance, seed: number, from: CFrame?, hold: boolean?)
	mem(office).pending[seed] = { from = from, at = api.now(), hold = if hold then true else nil }
end
-- The visitor rig is gone at `from`: a held arrival starts there (a hire that is off duty by now, or
-- whose hold ran out, is left alone and arrives normally).
function Events.handover(office: Instance, seed: number, from: CFrame?)
	local m = memory[office]
	local p = if m then m.pending[seed] else nil
	if p and p.hold then
		p.hold = nil
		p.from = from
	end
end
function Events.held(office: Instance, seed: number): boolean
	local m = memory[office]
	local p = if m then m.pending[seed] else nil
	return p ~= nil and p.hold == true and api.now() - p.at &lt; HOLD_SECONDS
end
function Events.claim(office: Instance, seed: number): any
	local m = memory[office]
	local p = if m then m.pending[seed] else nil
	if p then
		m.pending[seed] = nil
	end
	return p
end
function Events.pending(office: Instance, seed: number): boolean
	local m = memory[office]
	return m ~= nil and m.pending[seed] ~= nil
end

---------------------------------------------------------------------------------------------
-- Rack faults
---------------------------------------------------------------------------------------------
-- The rack door / LED prop of a blade (PropFx "leds" within a stud of the blade), cached per office.
local function doorOf(c: any, blade: BasePart): Instance?
	c.rackDoors = c.rackDoors or {}
	local cached = c.rackDoors[blade]
	if cached ~= nil then
		return if cached then cached else nil
	end
	local best, dist = nil, 1.2
	for _, root in Collection:GetTagged("PropFx") do
		if root:IsA("BasePart") and root:IsDescendantOf(c.office) then
			local fx = root:GetAttribute("Fx")
			if typeof(fx) == "string" and string.find(fx, "leds", 1, true) then
				local d = (root.Position - blade.Position).Magnitude
				if d &lt; dist then
					best, dist = root, d
				end
			end
		end
	end
	c.rackDoors[blade] = best or false
	return best
end
-- Stand point in front of a blade (racks face their aisle with -Z, StaffAssignment/ArchKit.serverRack).
function Events.rackPoint(e: any, blade: BasePart): (Vector3?, Vector3)
	local look = blade.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z)
	if dir.Magnitude &lt; 0.1 then
		dir = Vector3.new(0, 0, -1)
	end
	local p = floorPoint(e, blade.Position + dir.Unit * 1.7)
	return p, blade.Position
end
local function bladeAt(c: any, slot: number): BasePart?
	local blades = c.office:FindFirstChild("Blades")
	local b = if blades then blades:GetChildren()[slot] else nil
	return if b and b:IsA("BasePart") then b else nil
end
-- Mirrors the economy's fault list onto the blades: FxState "broken" + FaultSlot + FaultUntil (server time
-- of the economy's own repair estimate: remaining work / repair rate, rate = 1/60 s with IT on duty, else
-- 1/300 s). Writes only when something changes (FaultUntil when the estimate moves by more than 3 s).
function Events.syncRacks(c: any, s: any, clock: number): { [number]: any }
	local e = s.data.empire
	local want: { [number]: any } = {}
	for _, f in Ops.faults(e) do
		want[f.slot] = f
	end
	c.brokenBlades = c.brokenBlades or {}
	local rate = if Ops.itOnDuty(e, clock) then 1 / Ops.FAULT.it else 1 / Ops.FAULT.alone
	local now = workspace:GetServerTimeNow()
	local still: { [BasePart]: boolean } = {}
	local doors: { [Instance]: boolean } = {}
	for slot, f in want do
		local blade = bladeAt(c, slot)
		if not blade then
			continue
		end
		still[blade] = true
		if blade:GetAttribute("FxState") ~= "broken" then
			blade:SetAttribute("FaultSlot", slot)
			blade:SetAttribute("FxState", "broken")
		end
		local eta = math.floor(now + math.max(0, tonumber(f.left) or 0) / rate + 0.5)
		local cur = blade:GetAttribute("FaultUntil")
		if typeof(cur) ~= "number" or math.abs(cur - eta) &gt; 3 then
			blade:SetAttribute("FaultUntil", eta)
		end
		local door = doorOf(c, blade)
		if door then
			doors[door] = true
			if door:GetAttribute("FxState") ~= "broken" then
				door:SetAttribute("FaultSlot", slot)
				door:SetAttribute("FxState", "broken")
			end
		end
		c.brokenBlades[blade] = door or false
	end
	for blade, door in c.brokenBlades do
		if not still[blade] then
			c.brokenBlades[blade] = nil
			if blade.Parent then
				blade:SetAttribute("FxState", "idle")
				blade:SetAttribute("FaultSlot", nil)
				blade:SetAttribute("FaultUntil", nil)
			end
			if door and not doors[door] and door.Parent then
				door:SetAttribute("FxState", "idle")
				door:SetAttribute("FaultSlot", nil)
			end
		end
	end
	return want
end
-- Who repairs: IT Support where the rack is inside IT's access classes, else an engineer.
local function canReach(c: any, e: any, blade: BasePart): Vector3?
	local p = Events.rackPoint(e, blade)
	if not p then
		return nil
	end
	if not Plan.employeeAllowed(e.role, c.tier, local_(e, p)) then
		return nil
	end
	return p
end
local function pickWorker(c: any, blade: BasePart): (any, Vector3?)
	local engineer, ep, edist = nil, nil, math.huge
	for _, e in c.all do
		if not Events.free(e) or e.apprentice then
			continue
		end
		if e.role == "support" and e.model:GetAttribute("Role") == "IT Support" then
			local p = canReach(c, e, blade)
			if p then
				return e, p
			end
		elseif e.role == "engineer" then
			local p = canReach(c, e, blade)
			if p then
				local d = flat(e.root.Position, p) + math.abs(e.root.Position.Y - p.Y) * 4
				if d &lt; edist then
					engineer, ep, edist = e, p, d
				end
			end
		end
	end
	return engineer, ep
end
local function startRepair(e: any, c: any, slot: number, blade: BasePart, point: Vector3)
	stop(e, c)
	local ev: any = { kind = "repair", slot = slot, blade = blade, phase = "go", since = api.now(), step = 0, cleared = false }
	e.event = ev
	c.repairs[slot] = e
	setTask(e, "RackRepair", "SERVER_CHECK")
	Workstations.setItem(e, "laptop")
	Workstations.setPose(e, nil)
	api.state(e, "WALKING")
	Jobs.moveTo(e, c, point, nil, function(ok: boolean)
		if e.event ~= ev then
			return
		end
		if not ok then
			c.repairs[slot] = nil
			c.repairRetry[slot] = api.now() + Events.REPAIR_RETRY
			done(e)
			return
		end
		face(e, blade.Position)
		api.state(e, "SERVER_CHECK")
		ev.phase = if ev.cleared then "close" else "repair"
		ev.stepAt = api.now()
		ev.untilTime = if ev.cleared then api.now() + Events.CLOSE_SECONDS else nil
		if ev.cleared then
			Workstations.setPose(e, "typeStand")
			Workstations.setItem(e, "laptop")
		end
	end, true)
end
-- One pass per second: blade states, cleared faults, new repairs.
function Events.rackTick(c: any, s: any, clock: number)
	c.repairs = c.repairs or {}
	c.repairRetry = c.repairRetry or {}
	local want = Events.syncRacks(c, s, clock)
	for slot, e in c.repairs do
		local ev = e.event
		if not ev or ev.kind ~= "repair" or ev.slot ~= slot or not c.recordsSet[e] then
			c.repairs[slot] = nil
		elseif not want[slot] and not ev.cleared then
			-- the ECONOMY fixed it: finish the animation (now, or right after arriving)
			ev.cleared = true
			if ev.phase == "repair" then
				ev.phase = "close"
				ev.untilTime = api.now() + Events.CLOSE_SECONDS
				Workstations.setPose(e, "typeStand")
				Workstations.setItem(e, "laptop")
			end
		end
	end
	for slot in want do
		if c.repairs[slot] or (c.repairRetry[slot] or 0) &gt; api.now() then
			continue
		end
		local blade = bladeAt(c, slot)
		if blade then
			local worker, point = pickWorker(c, blade)
			if worker and point then
				startRepair(worker, c, slot, blade, point)
			end
		end
	end
	for slot in c.repairRetry do
		if not want[slot] then
			c.repairRetry[slot] = nil
		end
	end
end

---------------------------------------------------------------------------------------------
-- Apprentices: tour, training session, shadowing; the Training Lead
---------------------------------------------------------------------------------------------
local TOUR_KINDS: { [string]: number } = {
	-- room kind -&gt; priority (lower first); department rooms of the group come first anyway
	cafe = 2,
	hr = 3,
	datalab = 4,
	architecture = 4,
	control = 4,
	evaluation = 5,
	lab = 5,
	launch = 5,
	studio = 6,
	support = 6,
	platform = 6,
	team = 7,
	showroom = 8,
	gym = 8,
	boardroom = 9,
	datahall = 9,
}
-- Door stop of a room: a point in the corridor in front of its first usable door + the look-in point.
local function doorStop(c: any, roomId: string): (Vector3?, Vector3?)
	for _, d in Layout.doors(c.tier) do
		if d.room == roomId and not d.exterior and not d.hidden then
			local base = Vector3.new(d.x, Plan.levelY(d.level) + 3, d.z)
			local out = base - d.inward * 4
			local into = base + d.inward * 3
			return c.cf * out, c.cf * into
		end
	end
	return nil, nil
end
local function allowedAll(c: any, group: { any }, p: Vector3): boolean
	local l = c.cf:PointToObjectSpace(p)
	for _, e in group do
		if not Plan.employeeAllowed(e.role, c.tier, l) then
			return false
		end
	end
	return true
end
-- 4-6 stops: the group's own departments first, then the café, HR, labs ...; ordered as a walk.
function Events.tourStops(c: any, lead: any, group: { any }): { any }
	local depts: { [string]: boolean } = {}
	local reg = Workstations.scan(c.office)
	for _, e in group do
		local w = reg.byId[e.home]
		if w and typeof(w.department) == "string" then
			depts[w.department] = true
		end
	end
	local everyone = table.clone(group)
	table.insert(everyone, lead)
	local candidates = {}
	for _, r in Plan.rooms(c.tier) do
		if r.hidden or r.outdoor then
			continue
		end
		local prio = TOUR_KINDS[r.kind]
		if r.dept and depts[r.dept] and r.desks and r.desks &gt; 1 then
			prio = 1
		end
		if not prio then
			continue
		end
		if not Plan.roleAllows(lead.role, r.access) then
			continue
		end
		local p, look = doorStop(c, r.id)
		if p and look and allowedAll(c, everyone, p) then
			table.insert(candidates, { room = r, point = p, look = look, prio = prio })
		end
	end
	table.sort(candidates, function(a: any, b: any): boolean
		if a.prio ~= b.prio then
			return a.prio &lt; b.prio
		end
		return tostring(a.room.id) &lt; tostring(b.room.id)
	end)
	local A = Config.APPRENTICE
	local seed = if group[1] then group[1].personality.seed else 0
	local want = A.tourStops[1] + seed % (A.tourStops[2] - A.tourStops[1] + 1)
	local picked = {}
	local kinds: { [string]: boolean } = {}
	for _, cand in candidates do
		if #picked &gt;= want then
			break
		end
		local k = if cand.prio == 1 then "dept:" .. tostring(cand.room.dept) else cand.room.kind
		if not kinds[k] then
			kinds[k] = true
			table.insert(picked, cand)
		end
	end
	-- walking order: nearest next stop from the trainer, a level change counts as 80 studs
	local ordered = {}
	local here = lead.root.Position
	while #picked &gt; 0 do
		local bi, bd = 1, math.huge
		for i, cand in picked do
			local d = flat(here, cand.point) + math.abs(here.Y - cand.point.Y) / Plan.FLOOR_HEIGHT * 80
			if d &lt; bd then
				bi, bd = i, d
			end
		end
		local cand = table.remove(picked, bi) :: any
		table.insert(ordered, cand)
		here = cand.point
	end
	return ordered
end
local function trainer(c: any): any
	for _, e in c.all do
		if e.role == "support" and e.model:GetAttribute("Role") == "Training Lead" and not e.dead then
			return e
		end
	end
	return nil
end
Events.trainer = trainer
-- Group members walk to a point next to the trainer's stop point (behind him, in a short row).
local function memberPoint(c: any, group: { any }, stopPoint: Vector3, look: Vector3, k: number): Vector3
	local dir = Vector3.new(look.X - stopPoint.X, 0, look.Z - stopPoint.Z)
	if dir.Magnitude &lt; 0.1 then
		return stopPoint
	end
	dir = dir.Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local n = #group
	local p = stopPoint - dir * 2.4 + right * ((k - (n + 1) / 2) * 1.9)
	if allowedAll(c, group, p) then
		return p
	end
	return stopPoint - dir * 2.0
end
local function endTour(c: any, completed: boolean)
	local t = c.tour
	if not t then
		return
	end
	c.tour = nil
	local m = mem(c.office)
	for _, e in t.group do
		if e.event == t.ev then
			if completed then
				m.toured[e.personality.seed] = true
			end
			done(e, 1 + api.jitter(e, 3))
		end
	end
	if t.lead and t.lead.event == t.ev then
		done(t.lead, 2)
	end
end
local function tourStop(c: any)
	local t = c.tour
	local stopDef = t.stops[t.index]
	if not stopDef then
		endTour(c, true)
		return
	end
	t.phase = "walk"
	t.arrived = {}
	t.callAt = api.now()
	local ev = t.ev
	setTask(t.lead, "ApprenticeTour", "WALKING")
	Workstations.setPose(t.lead, nil)
	Jobs.moveTo(t.lead, c, stopDef.point, nil, function(ok: boolean)
		if c.tour ~= t or t.lead.event ~= ev then
			return
		end
		t.arrived[t.lead] = true
		if ok then
			face(t.lead, stopDef.look)
		end
		api.state(t.lead, "WORKING")
	end, true)
	for k, e in t.group do
		if e.event ~= ev or e.talkHold then
			continue -- a member in a conversation catches up at the next stop
		end
		local p = memberPoint(c, t.group, stopDef.point, stopDef.look, k)
		setTask(e, "ApprenticeTour", "WALKING")
		Workstations.setPose(e, nil)
		Jobs.moveTo(e, c, p, nil, function(_ok: boolean)
			if c.tour ~= t or e.event ~= ev then
				return
			end
			t.arrived[e] = true
			face(e, stopDef.point)
			api.state(e, "WORKING")
		end, true)
	end
end
local function startTour(c: any, lead: any, group: { any })
	local stops = Events.tourStops(c, lead, group)
	if #stops == 0 then
		local m = mem(c.office)
		for _, e in group do
			m.toured[e.personality.seed] = true -- nothing to show in this building: count it as done
		end
		return
	end
	local ev = { kind = "tour" }
	c.tour = { lead = lead, group = group, stops = stops, index = 1, ev = ev }
	stop(lead, c)
	lead.event = ev
	for _, e in group do
		stop(e, c)
		e.event = ev
	end
	tourStop(c)
end
local function tourTick(c: any)
	local t = c.tour
	if not t then
		return
	end
	local now = api.now()
	if not t.lead.event or t.lead.event ~= t.ev or not c.recordsSet[t.lead] then
		endTour(c, false)
		return
	end
	if t.lead.talkHold then
		-- the founder talks to the trainer: the tour waits (the stop timer is pushed back)
		t.callAt = now
		t.untilTime = if t.untilTime then t.untilTime + 1 else nil
		return
	end
	local members = 0
	for _, e in t.group do
		if e.event == t.ev then
			members += 1
		end
	end
	if members == 0 then
		endTour(c, false)
		return
	end
	if t.phase == "walk" then
		local all = t.arrived[t.lead] == true
		if all then
			for _, e in t.group do
				if e.event == t.ev and not t.arrived[e] then
					all = false
				end
			end
		end
		if all or (t.arrived[t.lead] and now - t.callAt &gt; Events.GATHER_SECONDS) or now - t.callAt &gt; Events.GATHER_SECONDS * 2 then
			local stopDef = t.stops[t.index]
			t.phase = "explain"
			local A = Config.APPRENTICE
			t.untilTime = now + A.stopSeconds[1] + api.jitter(t.lead, A.stopSeconds[2] - A.stopSeconds[1])
			setTask(t.lead, "Tour:" .. tostring(stopDef.room.id), "WORKING")
			Workstations.setPose(t.lead, "present")
			for _, e in t.group do
				if e.event == t.ev then
					setTask(e, "ApprenticeTour", "WORKING")
					Workstations.setPose(e, "scan")
				end
			end
		end
	elseif t.phase == "explain" and now &gt;= (t.untilTime or 0) then
		t.index += 1
		tourStop(c)
	end
end
-- Meeting room for the training session: free seats for the group + the trainer, close to the trainer.
local function sessionRoom(c: any, lead: any, group: { any }): (any, { any })
	local here = lead.root.Position
	local best, seats, score = nil, {}, math.huge
	for _, r in Workstations.scan(c.office).meetings do
		local open = {}
		for _, w in r.seats do
			if w.model.Parent and not w.reserved and not (w.seat and w.seat.Occupant) and Workstations.allowed(w, lead) then
				local ok = true
				for _, e in group do
					if not Workstations.allowed(w, e) then
						ok = false
						break
					end
				end
				if ok then
					table.insert(open, w)
				end
			end
		end
		if #open &lt; #group + 1 or #open == 0 then
			continue
		end
		local p = open[1].position
		local d = flat(here, p) + math.abs(here.Y - p.Y) / Plan.FLOOR_HEIGHT * 80
		if d &lt; score then
			best, seats, score = r, open, d
		end
	end
	return best, seats
end
local function endSession(c: any)
	local t = c.lesson
	if not t then
		return
	end
	c.lesson = nil
	for _, e in t.group do
		if e.event == t.ev then
			Workstations.release(e)
			done(e, 1 + api.jitter(e, 4))
		end
	end
	if t.lead.event == t.ev then
		Workstations.release(t.lead)
		done(t.lead, 2)
	end
	if c.office:GetAttribute("MeetingTopic") == "APPRENTICE TRAINING" then
		c.office:SetAttribute("MeetingUntil", 0)
	end
end
local function seatWalk(e: any, c: any, w: any, ev: any, stand: boolean, onSeat: () -&gt; ())
	if not Workstations.reserve(w, e) then
		return false
	end
	Jobs.moveTo(e, c, w.position, nil, function(ok: boolean)
		if e.event ~= ev then
			return
		end
		if ok and e.station == w and Workstations.perform(e, api.now(), if stand then { stand = true } else nil) then
			onSeat()
		else
			api.state(e, "WAIT_AT_DESK")
		end
	end, true)
	return true
end
local function startSession(c: any, lead: any, group: { any }, untilHour: number)
	local room, seats = sessionRoom(c, lead, group)
	if not room then
		return false
	end
	-- the trainer takes the end seat farthest from the seats' centre ("head of the table")
	local centre = Vector3.zero
	for _, w in seats do
		centre += w.position
	end
	centre /= #seats
	table.sort(seats, function(a: any, b: any): boolean
		return flat(a.position, centre) &gt; flat(b.position, centre)
	end)
	local ev = { kind = "session" }
	local t = { lead = lead, group = group, ev = ev, room = room, untilHour = untilHour, started = api.now(), seated = {} }
	c.lesson = t
	stop(lead, c)
	lead.event = ev
	setTask(lead, "TrainingLead", "MEETING")
	api.state(lead, "WALKING")
	seatWalk(lead, c, seats[1], ev, true, function()
		face(lead, centre)
		api.state(lead, "MEETING")
		setTask(lead, "TrainingLead", "MEETING")
		Workstations.setPose(lead, "present")
		t.seated[lead] = true
	end)
	local k = 2
	for _, e in group do
		stop(e, c)
		e.event = ev
		local w = seats[k]
		k += 1
		setTask(e, "TrainingSession", "MEETING")
		api.state(e, "WALKING")
		if not w or not seatWalk(e, c, w, ev, false, function()
			api.state(e, "MEETING")
			setTask(e, "TrainingSession", "MEETING")
			t.seated[e] = true
		end) then
			done(e)
		end
	end
	Events.showSession(c, t)
	return true
end
-- The room's meeting screen / speakerphone (PropFx gate "Meeting") shows the session while no other
-- meeting holds the office's meeting display; extended in 60 s steps while the session runs.
function Events.showSession(c: any, t: any)
	local now = workspace:GetServerTimeNow()
	local untilTime = tonumber(c.office:GetAttribute("MeetingUntil")) or 0
	local mine = c.office:GetAttribute("MeetingTopic") == "APPRENTICE TRAINING" and c.office:GetAttribute("MeetingRoom") == tostring(t.room.id)
	if mine and untilTime &gt; now then
		if untilTime - now &lt; 20 then
			c.office:SetAttribute("MeetingUntil", now + 60)
		end
	elseif untilTime &lt; now then
		c.office:SetAttribute("MeetingTopic", "APPRENTICE TRAINING")
		c.office:SetAttribute("MeetingRoom", tostring(t.room.id))
		c.office:SetAttribute("MeetingUntil", now + 90)
	end
end
local function sessionTick(c: any, hour: number)
	local t = c.lesson
	if not t then
		return
	end
	if t.lead.event ~= t.ev or not c.recordsSet[t.lead] then
		endSession(c)
		return
	end
	local members = 0
	for _, e in t.group do
		if e.event == t.ev then
			members += 1
		end
	end
	local minimum = api.now() - t.started &gt; 40
	if members == 0 or (minimum and (hour &gt;= t.untilHour or hour &lt; 8)) or api.now() - t.started &gt; 240 then
		endSession(c)
		return
	end
	Events.showSession(c, t)
end
-- Who of the apprentices is available for a group event now.
local function availableApprentices(c: any, filter: (e: any) -&gt; boolean): { any }
	local out = {}
	for _, e in c.all do
		if e.apprentice and Events.free(e) and filter(e) then
			table.insert(out, e)
		end
	end
	table.sort(out, function(a: any, b: any): boolean
		return a.index &lt; b.index
	end)
	return out
end
-- One pass per second: tour / session start and progress.
function Events.academyTick(c: any, hour: number, workday: number)
	tourTick(c)
	sessionTick(c, hour)
	if c.tour or c.lesson then
		return
	end
	local lead = trainer(c)
	if not lead or not Events.free(lead) then
		return
	end
	local A = Config.APPRENTICE
	local m = mem(c.office)
	if hour &gt;= A.tourHours[1] and hour &lt; A.tourHours[2] then
		local group = availableApprentices(c, function(e: any): boolean
			return e.apprentice.age &lt;= 1 and not m.toured[e.personality.seed]
		end)
		if #group &gt; 0 then
			startTour(c, lead, group)
			return
		end
	end
	if hour &gt;= A.trainingHours[1] and hour &lt; A.trainingHours[2] - 0.25 and m.sessionDay ~= workday then
		local group = availableApprentices(c, function(e: any): boolean
			return e.apprentice.age &gt;= 1 or m.toured[e.personality.seed] == true
		end)
		if #group &gt; 0 and startSession(c, lead, group, A.trainingHours[2]) then
			m.sessionDay = workday
		end
	end
end
-- Apprentice task choice (StaffService.selectTask after lunch and breaks): sit next to a senior colleague
-- of the same role every few choices, otherwise practise at the own desk. True = a task was started.
function Events.apprenticeTask(e: any, c: any): boolean
	local A = Config.APPRENTICE
	e.choices = (e.choices or 0) + 1
	local state = Events.WORK_STATE[e.role] or "WORKING"
	local reg = Workstations.scan(e.office)
	local homeW = reg.byId[e.home]
	if e.choices % A.shadowEvery == 0 then
		local here = e.root.Position
		local best, bw, bd = nil, nil, math.huge
		for _, o in c.all do
			if o == e or o.role ~= e.role or o.apprentice or o.dead or not o.station or o.station.kind ~= "Computer" then
				continue
			end
			if (o.skillK or 0) &lt; 3 or Config.productive(o.state) &lt; 1 then
				continue
			end
			-- the free desk nearest to the senior's desk, in the same room
			local sw = o.station
			for _, w in reg.byKind.Computer or {} do
				if w ~= sw and w.room == sw.room and Workstations.available(w, e) and not w.reserved then
					local dd = flat(w.position, sw.position)
					if dd &lt;= 7 then
						local score = dd + flat(here, w.position) * 0.05
						if score &lt; bd then
							best, bw, bd = o, w, score
						end
					end
				end
			end
		end
		if best and bw then
			e.model:SetAttribute("ShadowOf", best.name)
			api.begin(e, { id = "Shadowing", type = "Computer", department = bw.department, seconds = { 50, 90 }, state = state }, bw)
			return true
		end
	end
	e.model:SetAttribute("ShadowOf", nil)
	local def = { id = "Practice", type = "Computer", department = if homeW then homeW.department else nil, seconds = { 60, 140 }, state = state }
	local w = if homeW and Workstations.available(homeW, e) then homeW else Workstations.choose(e, def)
	if not w then
		return false
	end
	api.begin(e, def, w)
	return true
end
-- Training Lead job step "coach" (StaffJobs special): stand beside an apprentice working at a desk.
local function coach(e: any, c: any, step: any, time: number): boolean
	local target, bp = nil, nil
	local here = e.root.Position
	local bd = math.huge
	for _, o in c.all do
		if o.apprentice and not o.dead and o.station and o.station.kind == "Computer" and o.humanoid.SeatPart and not o.event then
			local w = o.station
			local f = w.model:GetAttribute("FacingPosition")
			if typeof(f) ~= "Vector3" then
				continue
			end
			local back = Vector3.new(w.position.X - f.X, 0, w.position.Z - f.Z)
			if back.Magnitude &lt; 0.1 then
				continue
			end
			local p = w.position + back.Unit * 2.2
			if not Plan.employeeAllowed(e.role, e.tier, local_(e, p)) then
				continue
			end
			local d = flat(here, p) + math.abs(here.Y - p.Y) * 6
			if d &lt; bd then
				target, bp, bd = o, p, d
			end
		end
	end
	if not target or not bp then
		return false
	end
	Jobs.abort(e, c)
	Workstations.release(e)
	e.jobStep = { step = step }
	e.next = math.huge
	setTask(e, "Coaching", "WORKING")
	local who = target
	Jobs.moveTo(e, c, bp, nil, function(ok: boolean)
		if ok then
			face(e, who.root.Position)
		end
		Workstations.setPose(e, step.pose)
		api.state(e, "WORKING")
		e.next = api.now() + step.seconds[1] + api.jitter(e, step.seconds[2] - step.seconds[1])
	end, true)
	return true
end
Jobs.handlers.coach = coach

---------------------------------------------------------------------------------------------
-- Per-employee tick and cancel
---------------------------------------------------------------------------------------------
function Events.busy(e: any): boolean
	return e.event ~= nil
end
function Events.tick(e: any, c: any, time: number)
	local ev = e.event
	if not ev or e.talkHold then
		return
	end
	if ev.kind == "arrive" then
		if ev.phase == "badge" then
			if ev.itemAt and time &gt;= ev.itemAt then
				ev.itemAt = nil
				Workstations.setItem(e, "badge")
			end
			if time &gt;= (ev.untilTime or 0) then
				Events.toDesk(e, c)
			end
		elseif time - ev.since &gt; 120 and not e.nav and not e.hop and not e.pendingMove then
			Events.toDesk(e, c) -- never stuck on the way to reception
		end
	elseif ev.kind == "repair" then
		if ev.phase == "repair" and time &gt;= (ev.stepAt or 0) then
			ev.step = ev.step % #Events.REPAIR_POSES + 1
			local p = Events.REPAIR_POSES[ev.step]
			Workstations.setPose(e, p.pose)
			Workstations.setItem(e, if p.item ~= "" then p.item else nil)
			ev.stepAt = time + 4 + api.jitter(e, 2.5)
		elseif ev.phase == "close" and time &gt;= (ev.untilTime or 0) then
			c.repairs[ev.slot] = nil
			done(e, 1)
		end
	end
	-- tour / session members are driven by the office pass (academyTick)
end
-- Ends this employee's part in an event (LOD sleep, shift end, rebuild). No callbacks fire afterwards
-- (every walk callback compares e.event with its own event table).
function Events.abort(e: any, c: any?)
	local ev = e.event
	if not ev then
		return
	end
	e.event = nil
	if c then
		if ev.kind == "repair" and c.repairs and c.repairs[ev.slot] == e then
			c.repairs[ev.slot] = nil
		elseif ev.kind == "tour" and c.tour and c.tour.lead == e then
			endTour(c, false)
		elseif ev.kind == "session" and c.lesson and c.lesson.lead == e then
			endSession(c)
		end
	end
	Workstations.setItem(e, nil)
	Workstations.setPose(e, nil)
	if e.firstDay and ev.kind == "arrive" then
		e.firstDay = nil
	end
end
return Events
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000038"><Properties><string name="Name">StaffJobs</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Visible jobs of the campus staff, run by StaffService (which injects its helpers through bind()):
--  * Operations staff (role "support") loop through EmployeeConfig.JOBS[&lt;job title&gt;] steps at and around
--    their post: short direct hops inside the room (Humanoid:MoveTo, counted as movers), the bounded
--    navigation for other rooms, then the step runs in place on a timer. Each step costs one Pose / Holding
--    write on the rig (only when it changes) and at most one FxUntil write on a prop.
--  * Lunch for employees: queue at the café servery, the kitchen team hands out a plate (else self-service
--    after a short wait), eat at the reserved LunchSeat (meal on the table, client-rendered), return the
--    tray to the trolley by the kitchen door. The whole flow keeps the state LUNCH (WALKING while walking),
--    so the break cap and the economic weights (EmployeeConfig.productive) are unchanged.
--  * Operations staff never leave for coffee; they take a short break in place, one per job title at a time.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Collection = game:GetService("CollectionService")
local Config = require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Plan = require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Workstations = require(script.Parent.WorkstationService)
local Nav = require(script.Parent.EmployeeNavigation)

local Jobs = {}
-- staffops: special job steps handled elsewhere (step.special = name), e.g. the Training Lead's "coach"
-- step (StaffEvents): handler(e, c, step, time) -&gt; started (false = skip the step).
Jobs.handlers = {} :: { [string]: (e: any, c: any, step: any, time: number) -&gt; boolean }
-- the campus day of the ONE visible clock (CORE_SPEC 6): LunchesServed resets with the shown day
local function campusDay(): number
	return math.floor(workspace:GetServerTimeNow() / 1200)
end
type Api = {
	now: () -&gt; number,
	hour: () -&gt; number,
	state: (e: any, name: string) -&gt; (),
	jitter: (e: any, max: number) -&gt; number,
}
local api: Api = {
	now = function(): number
		return 0
	end,
	hour = function(): number
		return 12
	end,
	state = function(_e: any, _name: string) end,
	jitter = function(_e: any, _max: number): number
		return 0
	end,
}
local HOP_REACH = 1.1 -- horizontal distance at which a hop target counts as reached
local SERVE_SECONDS = 2.5
local SELF_SERVE_AFTER = 6
local TRAYS_TO_COLLECT = 3
local PENDING_MAX = 30 -- seconds a cross-room walk may wait for a free slot under the movers cap

function Jobs.bind(a: Api)
	api = a
end

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end
local function span(e: any, range: { number }?): number
	local r = range or { 4, 6 }
	return r[1] + api.jitter(e, r[2] - r[1])
end
local function setState(e: any, name: string)
	if e.state ~= name then
		api.state(e, name)
	end
end

-- Faces `point` (world) and anchors the root: the employee works in place.
local function face(e: any, point: Vector3?)
	if not e.root.Parent then
		return
	end
	e.root.Anchored = false
	e.humanoid.AutoRotate = false
	if point then
		local delta = Vector3.new(point.X - e.root.Position.X, 0, point.Z - e.root.Position.Z)
		if delta.Magnitude &gt; 0.2 then
			e.root.CFrame = CFrame.lookAt(e.root.Position, e.root.Position + delta)
		end
	end
	e.root.Anchored = true
end

local function stand(e: any)
	if e.humanoid.Parent and e.humanoid.Sit then
		e.humanoid.Sit = false
	end
	if e.root.Parent then
		e.root.Anchored = false
	end
	e.humanoid.AutoRotate = true
end

local function roomId(e: any, p: Vector3): string?
	local l = e.cf:PointToObjectSpace(p)
	local room = Plan.roomAt(e.tier, l)
	return if room then room.id else nil
end

-- Same room (or both within 8 studs on the same level): direct hops; otherwise the navigation.
local function sameRoom(e: any, a: Vector3, b: Vector3): boolean
	if math.abs(a.Y - b.Y) &gt; 4 then
		return false
	end
	local ra, rb = roomId(e, a), roomId(e, b)
	if ra and ra == rb then
		return true
	end
	return flat(a, b) &lt; 8
end

---------------------------------------------------------------------------------------------
-- Movement
---------------------------------------------------------------------------------------------
-- Walks to `target` (world, root height) through `via`, then calls done(ok). Same room: direct hops
-- (Humanoid:MoveTo, no path job) - only used for job points whose straight lines were checked on the
-- real geometry (tests/life/test_routes.py); other rooms, or `pathed` (café tables in the way): Nav.go
-- (state WALKING while the route runs). With the office's movers cap reached, a same-room hop is
-- skipped and the step runs where the employee stands.
function Jobs.moveTo(e: any, c: any, target: Vector3, via: { Vector3 }?, done: (boolean) -&gt; (), pathed: boolean?)
	local time = api.now()
	local here = e.root.Position
	local hops: { Vector3 } = via or {}
	if pathed and flat(here, target) &lt; HOP_REACH then
		done(true)
		return
	end
	if not pathed and sameRoom(e, here, target) then
		if flat(here, target) &lt; HOP_REACH and #hops == 0 then
			done(true)
			return
		end
		if c.moving &gt;= Config.moverCap(e.role) then
			done(false)
			return
		end
		local points: { Vector3 } = table.clone(hops)
		table.insert(points, target)
		stand(e)
		c.moving += 1
		e.humanoid.WalkSpeed = e.personality.walkSpeed
		e.hop = { points = points, i = 1, done = done, deadline = time + flat(here, points[1]) / e.personality.walkSpeed + 4 }
		e.humanoid:MoveTo(points[1])
		return
	end
	if c.moving &gt;= Config.moverCap(e.role) then
		-- office movers cap reached: wait in place and start the walk when a slot frees up (Jobs.tick)
		e.pendingMove = { target = target, via = via, done = done, pathed = pathed, since = time }
		return
	end
	stand(e)
	local resume = e.state
	setState(e, "WALKING")
	c.moving += 1
	Nav.go(e, target, time, function(ok: boolean)
		if e.dead or not e.model.Parent then
			return
		end
		if e.state == "WALKING" then
			setState(e, if resume == "WALKING" then "WORKING" else resume)
		end
		done(ok)
	end)
end

-- Starts a walk that waited for the movers cap (gives up after PENDING_MAX seconds: done(false)).
local function pendingTick(e: any, c: any, time: number)
	local m = e.pendingMove
	if c.moving &lt; Config.moverCap(e.role) then
		e.pendingMove = nil
		Jobs.moveTo(e, c, m.target, m.via, m.done, m.pathed)
	elseif time - m.since &gt; PENDING_MAX then
		e.pendingMove = nil
		m.done(false)
	end
end

-- A conversation (TalkService via Staff.hold) pauses a hop in place; resume walks on (fresh deadline).
function Jobs.pause(e: any)
	if e.hop and e.humanoid.Parent and e.root.Parent then
		e.humanoid:MoveTo(e.root.Position)
	end
end
function Jobs.resume(e: any, time: number)
	local h = e.hop
	if h and e.humanoid.Parent and e.root.Parent then
		local p = h.points[h.i]
		h.deadline = time + flat(e.root.Position, p) / e.personality.walkSpeed + 4
		e.humanoid:MoveTo(p)
	end
	if e.pendingMove then
		e.pendingMove.since = time
	end
end

-- Hop progress (called every Staff tick while e.hop is set).
function Jobs.hopTick(e: any, time: number)
	local h = e.hop
	if not h then
		return
	end
	local p = h.points[h.i]
	if flat(e.root.Position, p) &lt; HOP_REACH or time &gt; h.deadline then
		if h.i &lt; #h.points then
			h.i += 1
			h.deadline = time + flat(e.root.Position, h.points[h.i]) / e.personality.walkSpeed + 4
			e.humanoid:MoveTo(h.points[h.i])
		else
			e.hop = nil
			if e.humanoid.Parent then
				e.humanoid:MoveTo(e.root.Position)
			end
			h.done(true)
		end
	end
end

---------------------------------------------------------------------------------------------
-- Operations jobs
---------------------------------------------------------------------------------------------
local function post(e: any): any
	return Workstations.scan(e.office).byId[e.home]
end

-- Job point `name` of the employee's post: stand (world), look-at, PropId, pose override.
function Jobs.point(e: any, name: string?): (Vector3?, Vector3?, string?, string?)
	local w = post(e)
	if not w then
		return nil, nil, nil, nil
	end
	if not name then
		local facing = w.model:GetAttribute("FacingPosition")
		return w.position, if typeof(facing) == "Vector3" then facing else nil, nil, nil
	end
	local m = w.model
	local p = m:GetAttribute("JobPoint_" .. name)
	if typeof(p) ~= "Vector3" then
		return nil, nil, nil, nil
	end
	local f = m:GetAttribute("JobFace_" .. name)
	local prop = m:GetAttribute("JobProp_" .. name)
	local pose = m:GetAttribute("JobPose_" .. name)
	return p, if typeof(f) == "Vector3" then f else nil, if typeof(prop) == "string" then prop else nil, if typeof(pose) == "string" then pose else nil
end

local function lunchService(c: any): boolean
	local h = api.hour()
	return (h &gt;= Config.LUNCH_SERVICE[1] and h &lt; Config.LUNCH_SERVICE[2]) or #(c.lunchQueue or {}) &gt; 0
end

local function title(e: any): string
	local t = e.model:GetAttribute("Role")
	return if typeof(t) == "string" then t else "Campus Operations"
end

-- Keeps (or takes back) the employee's own post reservation without moving anybody.
local function holdPost(e: any): boolean
	local w = post(e)
	if not w then
		return false
	end
	if e.station == w then
		return true
	end
	if e.station then
		Workstations.release(e)
	end
	return Workstations.reserve(w, e)
end

-- Starts the work part of a step where the employee now stands.
local function work(e: any, step: any, faceAt: Vector3?, prop: string?, pose: string?, time: number)
	face(e, faceAt)
	local seconds = span(e, step.seconds)
	Workstations.setPose(e, pose or step.pose)
	if step.item ~= nil then
		Workstations.setItem(e, if step.item then step.item else nil)
	end
	if prop then
		Workstations.useProp(e.office, prop, seconds)
	end
	setState(e, "WORKING")
	e.next = time + seconds
end

local function sitAtPost(e: any, step: any, time: number)
	local w = post(e)
	if not w then
		return
	end
	if w.seat and e.station == w then
		e.humanoid.AutoRotate = false
		e.root.Anchored = false
		w.seat:Sit(e.humanoid)
		e.root.Anchored = true
	else
		local facing = w.model:GetAttribute("FacingPosition")
		face(e, if typeof(facing) == "Vector3" then facing else nil)
	end
	Workstations.setPose(e, step.pose)
	if step.item ~= nil then
		Workstations.setItem(e, if step.item then step.item else nil)
	end
	setState(e, "WORKING")
	e.next = time + span(e, step.seconds)
end

local function stationFor(e: any, kind: string): any
	local list = Workstations.scan(e.office).byKind[kind]
	if not list or #list == 0 then
		return nil
	end
	e.visitCursor = (e.visitCursor or (e.index % #list)) % #list + 1
	for k = 0, #list - 1 do
		local w = list[(e.visitCursor + k - 1) % #list + 1]
		if Workstations.available(w, e) then
			return w
		end
	end
	return nil
end

-- A desk screen goes out of order; IT walks over with a laptop and fixes it (PropFx screen overlay).
local function faultStation(e: any): any
	local here = e.root.Position
	local best, score = nil, math.huge
	for _, w in Workstations.scan(e.office).byKind.Computer or {} do
		if w.reserved or not Workstations.available(w, e) then
			continue
		end
		local d = flat(w.position, here) + math.abs(w.position.Y - here.Y) * 8 + ((w.fixedAt or -1e9) &gt; api.now() - 600 and 1e6 or 0)
		if d &lt; score then
			best, score = w, d
		end
	end
	return best
end
local function setFault(w: any, broken: boolean)
	local screen = w.model:FindFirstChild("DisplayContent")
	if not screen then
		return
	end
	if broken then
		screen:SetAttribute("Fx", "screen")
		Collection:AddTag(screen, "PropFx")
	end
	screen:SetAttribute("FxState", if broken then "broken" else "idle")
end

-- Ends the previous step (releases a visited station, a fault, a serving slot).
local function finishStep(e: any, c: any)
	local job = e.jobStep
	if not job then
		return
	end
	e.jobStep = nil
	if job.fault then
		setFault(job.fault, false)
		job.fault.fixedAt = api.now()
	end
	if job.visit and e.station == job.visit then
		Workstations.release(e)
	end
	if job.serve and c.server == e then
		c.server = nil
	end
	if job.breakJob then
		if c.opsBreak and c.opsBreak[job.breakJob] == e then
			c.opsBreak[job.breakJob] = nil
		end
		Workstations.setItem(e, nil)
		e.nextOpsBreak = api.now() + Config.OPS_BREAK[1] + api.jitter(e, Config.OPS_BREAK[2] - Config.OPS_BREAK[1])
	end
end

-- Next step of an operations employee (called by StaffService when the current one is over).
function Jobs.next(e: any, c: any)
	local time = api.now()
	-- the kitchen team keeps serving while the lunch service runs
	local current = e.jobStep
	if current and current.serve and lunchService(c) and c.server == e then
		e.next = time + 4
		return
	end
	finishStep(e, c)
	local job = Config.JOBS[title(e)]
	if not job then
		-- unknown job: stay at the post
		if holdPost(e) then
			sitAtPost(e, { pose = nil, seconds = { 20, 40 } }, time)
		end
		return
	end
	-- short break in place, covered: never two people with the same job title at once
	c.opsBreak = c.opsBreak or {}
	local jobTitle = title(e)
	e.nextOpsBreak = e.nextOpsBreak or (time + Config.OPS_BREAK[1] + api.jitter(e, Config.OPS_BREAK[2] - Config.OPS_BREAK[1]))
	if time &gt;= e.nextOpsBreak and not c.opsBreak[jobTitle] and not (jobTitle == "Kitchen Team" and lunchService(c)) then
		c.opsBreak[jobTitle] = e
		e.jobStep = { breakJob = jobTitle }
		Workstations.setPose(e, "relax")
		Workstations.setItem(e, "cup")
		face(e, nil)
		setState(e, "SHORT_BREAK")
		e.next = time + span(e, Config.OPS_BREAK_SECONDS)
		return
	end
	local lunch = lunchService(c)
	e.cursor = e.cursor or 1
	for _ = 1, #job do
		local step = job[e.cursor]
		e.cursor = e.cursor % #job + 1
		if (step.when == "lunch" and not lunch) or (step.when == "open" and lunch) then
			continue
		end
		if step.every then
			e.stepCounts = e.stepCounts or {}
			local n = (e.stepCounts[step] or 0) + 1
			e.stepCounts[step] = n
			if n % step.every ~= 0 then
				continue
			end
		end
		if Jobs.run(e, c, step, time) then
			return
		end
	end
	-- nothing runnable right now: wait at the post
	if holdPost(e) then
		sitAtPost(e, { pose = nil, seconds = { 8, 14 } }, time)
	else
		e.next = time + 6
	end
end

-- Runs one step; false = skipped (missing point, nothing to do).
function Jobs.run(e: any, c: any, step: any, time: number): boolean
	if step.special then
		local handler = Jobs.handlers[step.special]
		return handler ~= nil and handler(e, c, step, time)
	end
	if step.trays then
		local trays = Workstations.scan(e.office).byKind.TrayReturn
		local rack = if trays then trays[1] else nil
		if not rack or (c.trays or 0) &lt; TRAYS_TO_COLLECT then
			return false
		end
		e.jobStep = { step = step }
		e.next = math.huge
		Jobs.moveTo(e, c, rack.position, nil, function(ok: boolean)
			if ok then
				c.trays = 0
				local f = rack.model:GetAttribute("FacingPosition")
				work(e, step, if typeof(f) == "Vector3" then f else nil, nil, nil, api.now())
			else
				e.next = api.now() + 3
			end
		end)
		return true
	end
	if step.fault then
		local w = faultStation(e)
		if not w or not Workstations.reserve(w, e) then
			return false
		end
		setFault(w, true)
		e.jobStep = { fault = w, visit = w }
		e.next = math.huge
		if step.item ~= nil then
			Workstations.setItem(e, if step.item then step.item else nil)
		end
		Jobs.moveTo(e, c, w.position, nil, function(ok: boolean)
			if ok and e.station == w and Workstations.perform(e, api.now(), { stand = true }) then
				work(e, step, nil, nil, nil, api.now())
			else
				e.next = api.now() + 2
			end
		end)
		return true
	end
	if step.visit then
		local w = stationFor(e, step.visit)
		if not w or not Workstations.reserve(w, e) then
			return false
		end
		e.jobStep = { visit = w }
		e.next = math.huge
		if step.item ~= nil then
			Workstations.setItem(e, if step.item then step.item else nil)
		end
		Workstations.setPose(e, if step.item == "mopcart" then "push" else nil)
		Jobs.moveTo(e, c, w.position, nil, function(ok: boolean)
			if ok and e.station == w and Workstations.perform(e, api.now(), { stand = true }) then
				Workstations.setPose(e, step.pose)
				setState(e, "WORKING")
				e.next = api.now() + span(e, step.seconds)
			else
				e.next = api.now() + 2
			end
		end)
		return true
	end
	if step.route then
		local list = Workstations.scan(e.office)[if step.route == "Mop" then "mops" else step.route]
		if typeof(list) ~= "table" or #list == 0 then
			return false
		end
		holdPost(e)
		e.jobStep = { route = list, index = 1, step = step }
		e.next = math.huge
		if step.item ~= nil then
			Workstations.setItem(e, if step.item then step.item else nil)
		end
		Jobs.routeNext(e, c)
		return true
	end
	-- point step (or the post itself)
	local target, faceAt, prop, pose = Jobs.point(e, step.at)
	if step.at and not target then
		if step.optional then
			return false
		end
		target, faceAt = Jobs.point(e, nil) -- run in place at the post
	end
	if not target or not holdPost(e) then
		return false
	end
	local via: { Vector3 } = {}
	for _, name in step.via or {} do
		local p = Jobs.point(e, name)
		if p then
			table.insert(via, p)
		end
	end
	e.jobStep = { step = step, serve = step.serve }
	e.next = math.huge
	if step.item == "mopcart" then
		Workstations.setPose(e, "push")
	end
	Jobs.moveTo(e, c, target, via, function(ok: boolean)
		local now = api.now()
		if step.sit then
			sitAtPost(e, step, now)
		else
			work(e, step, faceAt, if step.prop then prop else nil, pose, now)
		end
		if step.serve and ok then
			c.server = e
			e.next = now + 4
		end
	end)
	return true
end

-- Mop route: navigate to the first point, then short hops point to point, mopping at each.
function Jobs.routeNext(e: any, c: any)
	local job = e.jobStep
	if not job or not job.route then
		return
	end
	local w = job.route[job.index]
	if not w then
		e.jobStep = nil
		e.next = api.now() + 1
		return
	end
	Workstations.setPose(e, "push")
	Jobs.moveTo(e, c, w.position, nil, function(_ok: boolean)
		local facing = w.model:GetAttribute("FacingPosition")
		face(e, if typeof(facing) == "Vector3" then facing else nil)
		Workstations.setPose(e, job.step.pose)
		setState(e, "WORKING")
		job.workUntil = api.now() + span(e, job.step.seconds)
	end)
end

---------------------------------------------------------------------------------------------
-- Lunch (employees)
---------------------------------------------------------------------------------------------
-- Plates handed out today: office attribute LunchesServed (TalkService quotes it), reset each campus day.
local function countPlate(c: any, _time: number, add: number)
	local day = campusDay()
	if c.lunchDay ~= day then
		c.lunchDay = day
		c.lunchesServed = 0
		if add == 0 then
			c.office:SetAttribute("LunchesServed", 0)
		end
	end
	if add &gt; 0 then
		c.lunchesServed += add
		c.office:SetAttribute("LunchesServed", c.lunchesServed)
	end
end

local function queuePoint(c: any, slot: number): any
	local q = Workstations.scan(c.office).queue
	return q[math.min(slot, #q)]
end

local function leaveQueue(c: any, e: any)
	local q = c.lunchQueue
	if not q then
		return
	end
	local i = table.find(q, e)
	if i then
		table.remove(q, i)
	end
end

-- Cancels a lunch or job flow (LOD sleep, shift end, rebuild). Releases what the flow holds.
function Jobs.abort(e: any, c: any?)
	if e.hop then
		e.hop = nil
	end
	e.pendingMove = nil
	if e.lunch then
		if c then
			leaveQueue(c, e)
		end
		e.lunch = nil
		e.model:SetAttribute("TablePoint", nil)
		Workstations.setItem(e, nil)
		Workstations.setPose(e, nil)
	end
	if e.jobStep and c then
		finishStep(e, c)
	end
	e.jobStep = nil
	if c and c.server == e then
		c.server = nil
	end
end

local function lunchFail(e: any, c: any, time: number)
	Jobs.abort(e, c)
	Workstations.release(e)
	setState(e, "SELECT_TASK")
	e.lunchRetry = time + 20
	e.next = time + 5
end

-- The employee is done eating at the table: carry the tray to the return trolley (or leave it).
local function toReturn(e: any, c: any, time: number)
	local L = e.lunch
	Workstations.release(e)
	e.model:SetAttribute("TablePoint", nil)
	local racks = Workstations.scan(e.office).byKind.TrayReturn
	local rack = if racks then racks[1] else nil
	if not rack then
		Jobs.finishLunch(e, c, time, false)
		return
	end
	L.phase = "toReturn"
	Workstations.setItem(e, "tray")
	Workstations.setPose(e, "carry")
	Jobs.moveTo(e, c, rack.position, nil, function(ok: boolean)
		if not e.lunch then
			return
		end
		if not ok then
			Jobs.finishLunch(e, c, api.now(), false)
			return
		end
		local f = rack.model:GetAttribute("FacingPosition")
		face(e, if typeof(f) == "Vector3" then f else nil)
		setState(e, "LUNCH")
		Workstations.setPose(e, "reach")
		L.phase = "return"
		L.untilTime = api.now() + 2
	end, true)
end

function Jobs.finishLunch(e: any, c: any, time: number, returned: boolean)
	if returned then
		c.trays = (c.trays or 0) + 1
	end
	e.lunch = nil
	Workstations.setItem(e, nil)
	Workstations.setPose(e, nil)
	e.lastLunch = campusDay()
	if e.root.Parent then
		e.root.Anchored = false
	end
	setState(e, "SELECT_TASK")
	e.next = time + 1
end

local function toSeat(e: any, c: any)
	local L = e.lunch
	L.phase = "toSeat"
	Workstations.setPose(e, "carry")
	Jobs.moveTo(e, c, L.seat.position, nil, function(ok: boolean)
		local now = api.now()
		if not e.lunch then
			return
		end
		if not ok or e.station ~= L.seat or not Workstations.perform(e, now) then
			lunchFail(e, c, now)
			return
		end
		setState(e, "LUNCH")
		L.phase = "eat"
		L.untilTime = now + span(e, { 120, 230 })
		-- meal on the table in front of the seat (TableY = table top; default 3.2 above the floor)
		local seatPos = if L.seat.seat then L.seat.seat.Position else e.root.Position
		local facing = L.seat.model:GetAttribute("FacingPosition")
		local tableY = L.seat.model:GetAttribute("TableY")
		local toward = if typeof(facing) == "Vector3" then Vector3.new(facing.X - seatPos.X, 0, facing.Z - seatPos.Z) else Vector3.zero
		local point = seatPos + (if toward.Magnitude &gt; 0.1 then toward.Unit * math.min(1.5, toward.Magnitude) else Vector3.zero)
		local y = if typeof(tableY) == "number" then tableY + 0.06 elseif typeof(facing) == "Vector3" then facing.Y - 2.8 + 3.21 else seatPos.Y + 1.35
		e.model:SetAttribute("TablePoint", Vector3.new(point.X, y, point.Z))
		Workstations.setItem(e, "meal")
		Workstations.setPose(e, "eat")
	end, true)
end

-- Starts lunch for employee `e` with a free Dining seat `seat` (already chosen). False = try later.
function Jobs.lunch(e: any, c: any, seat: any, def: any): boolean
	local time = api.now()
	c.lunchQueue = c.lunchQueue or {}
	local queue = Workstations.scan(e.office).queue
	if #queue &gt; 0 and #c.lunchQueue &gt;= #queue then
		return false -- the line is full
	end
	Nav.cancel(e)
	Workstations.release(e)
	if not Workstations.reserve(seat, e) then
		return false
	end
	e.task = def
	e.taskStarted = time
	e.model:SetAttribute("Task", def.id)
	e.next = math.huge
	e.lunch = { phase = "toQueue", seat = seat, slot = 0, waitSince = time }
	if #queue == 0 then
		-- no servery in this building: take a tray at the counter and go straight to the seat
		countPlate(c, time, 1)
		Workstations.setItem(e, "tray")
		toSeat(e, c)
		return true
	end
	table.insert(c.lunchQueue, e)
	local slot = #c.lunchQueue
	e.lunch.slot = slot
	local spot = queuePoint(c, slot)
	Jobs.moveTo(e, c, spot.position, nil, function(ok: boolean)
		local now = api.now()
		if not e.lunch then
			return
		end
		if not ok then
			lunchFail(e, c, now)
			return
		end
		local f = spot.model:GetAttribute("FacingPosition")
		face(e, if typeof(f) == "Vector3" then f else nil)
		setState(e, "LUNCH")
		e.lunch.phase = "queue"
		e.lunch.waitSince = now
	end, true)
	return true
end

-- Once per office tick: the line moves up by short hops and the front gets served.
function Jobs.officeTick(c: any)
	local time = api.now()
	if c.lunchDay ~= campusDay() then
		countPlate(c, time, 0)
	end
	local q = c.lunchQueue
	if not q or #q == 0 then
		return
	end
	for i, e in q do
		local L = e.lunch
		if L and L.phase == "queue" and not e.hop and not e.nav and not e.talkHold and L.slot ~= i then
			L.slot = i
			local spot = queuePoint(c, i)
			Jobs.moveTo(e, c, spot.position, nil, function(_ok: boolean)
				local f = spot.model:GetAttribute("FacingPosition")
				face(e, if typeof(f) == "Vector3" then f else nil)
			end)
		end
	end
	local front = q[1]
	local L = front and front.lunch
	if not L or L.phase ~= "queue" or L.slot ~= 1 or front.hop or front.nav or front.talkHold then
		return -- (a guest in conversation keeps the line waiting until the talk ends)
	end
	if not L.servedAt then
		local server = c.server
		if server and server.model.Parent and not server.hop and not server.nav and not server.talkHold and server.jobStep and server.jobStep.serve then
			L.servedAt = time + SERVE_SECONDS
			L.servedBy = server
			Workstations.setPose(server, "plate")
			Workstations.setItem(server, "plate")
			Workstations.useProp(c.office, "Servery", SERVE_SECONDS + 1)
		elseif time - L.waitSince &gt; SELF_SERVE_AFTER then
			L.servedAt = time + 2 -- nobody behind the counter: self-service
			Workstations.setPose(front, "reach")
		end
		return
	end
	if time &gt;= L.servedAt then
		local server = L.servedBy
		if server and server.model.Parent then
			Workstations.setItem(server, nil)
			Workstations.setPose(server, "wipe")
		end
		table.remove(q, 1)
		countPlate(c, time, 1)
		Workstations.setItem(front, "tray")
		toSeat(front, c)
	end
end

---------------------------------------------------------------------------------------------
-- Per-employee tick (hops, lunch phases, mop route, job timers)
---------------------------------------------------------------------------------------------
-- True while a flow of this module owns the employee (StaffService then skips its own task logic).
function Jobs.busy(e: any): boolean
	return e.hop ~= nil or e.pendingMove ~= nil or e.lunch ~= nil or (e.jobStep ~= nil and e.jobStep.route ~= nil)
end

function Jobs.tick(e: any, c: any, time: number)
	if e.hop then
		Jobs.hopTick(e, time)
		return
	end
	if e.pendingMove then
		pendingTick(e, c, time)
		return
	end
	local L = e.lunch
	if L then
		if L.phase == "eat" and time &gt;= L.untilTime then
			toReturn(e, c, time)
		elseif L.phase == "return" and time &gt;= L.untilTime then
			Jobs.finishLunch(e, c, time, true)
		end
		return
	end
	local job = e.jobStep
	if job and job.route and job.workUntil and time &gt;= job.workUntil and not e.nav then
		job.workUntil = nil
		job.index += 1
		if job.index &gt; #job.route then
			e.jobStep = nil
			e.next = time + 0.5
		else
			Jobs.routeNext(e, c)
		end
	end
end

-- Lunch seats: the café chairs carry the table-top height for the meal plate (TableY, world Y).
Jobs.SERVE_SECONDS = SERVE_SECONDS
return Jobs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000039"><Properties><string name="Name">StaffRota</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- StaffRota (staffops): who of a company is on duty right now. Pure functions of the saved company data
-- (data.empire) and the visible server clock hour (CompanyOps.hour), so the building shows exactly the
-- people the economy counts (CORE_SPEC 5.3 / 11.1). StaffService only ANIMATES this; money and output stay
-- in CompanyOps (presence, output, wage) - nothing here is re-derived, it calls CompanyOps.
--   * absences: CompanyOps.presence(e, role)[i] ~= "present" (vacation / sick / unpaid leave / trip)
--   * night crew: the overflow heads beyond the day seats of a role with a night shift work 22:00-06:00
--     (the same heads CompanyOps.wage pays x1.3: the newest paid profiles of that role)
--   * apprentices: CompanyOps.apprentice (skill 1 -&gt; 3, graduation after 9 company days)
--   * operations posts: one day shift that covers the opening hours, security + IT night rota at stage 5
-- Keys are "&lt;role&gt;:&lt;i&gt;" with i = the profile index inside the role (= rig StaffIndex - earlier roles).
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local Ops=require(ReplicatedStorage.Shared.CompanyOps)
local Rota={}
export type Snapshot={day: number,stage: number,away: {[string]:string},night: {[string]:boolean},apprentices: {[string]:{age: number,skill: number,seed: number}},
 apprenticeCount: number,nightCrew: number,securityNight: boolean,itNight: boolean,before: {[string]:number}}

local function count(e: any,role: string): number
 return math.max(0,math.floor(tonumber(e.employees and e.employees[role]) or 0))
end
local function seedOf(p: any,i: number): number
 local s=if typeof(p)=="table" then p.s else nil
 return if typeof(s)=="number" and s==s then math.floor(math.abs(s))%2147483647 else i
end
-- The company day a shift belongs to: the saved calendar day; from 06:00 until the office opens at 08:00
-- (when the server day index - and with it empire.calendar.day - moves on) already the coming day, so the
-- people arriving at 07:45 are the ones who work today.
function Rota.workday(e: any,hour: number): number
 local day=Ops.day(e)
 if hour&gt;=6 and hour&lt;8 then day+=1 end
 return day
end
-- Profile index i of a hired rig from its StaffIndex (StaffAssignment numbers the roles in ROLES order).
function Rota.before(e: any): {[string]:number}
 local out: {[string]:number}={}
 local n=0
 for _,role in EmpireConfig.ROLES do out[role.id]=n;n+=count(e,role.id) end
 return out
end
function Rota.key(role: string,i: number): string return role..":"..tostring(i) end
-- Presence per role on company day `day` (CompanyOps.presence on a view of the data with that day).
function Rota.presence(e: any,day: number,role: string): {string}
 local view=setmetatable({calendar={day=day}},{__index=e})
 return Ops.presence(view,role)
end
-- Night crew heads of a role: CompanyOps.wage pays the newest min(max(0, paid - seats), seats) paid
-- profiles x1.3 while the night shift is on; exactly those work 22:00-06:00.
function Rota.nightRange(e: any,role: string): (number,number)
 if not Ops.nightOn(e,role) then return 0,0 end
 local n=count(e,role)
 local paid=n-((Ops.leaveCounts(e) :: any)[role] or 0)
 local S=Ops.seats(e,role)
 local heads=math.min(math.max(0,paid-S),S)
 return paid-heads+1,paid
end
-- Seeded day shift of an operations post: on duty before 08:00, off after 18:00.
function Rota.opsShift(seed: number): (number,number)
 local s=math.floor(math.abs(seed))
 local a=Config.OPS_SHIFT.start;local b=Config.OPS_SHIFT.finish
 return a[1]+(s%16)/15*(a[2]-a[1]),b[1]+(s%31)/30*(b[2]-b[1])
end
function Rota.nightCrewOnDuty(hour: number): boolean
 return hour&gt;=Config.NIGHT_CREW.start or hour&lt;Config.NIGHT_CREW.finish
end
-- Everything StaffService needs for one office, recomputed every few seconds.
function Rota.compute(e: any,hour: number): Snapshot
 local day=Rota.workday(e,hour)
 local stage=Ops.stageIndex(e)
 local snap: Snapshot={day=day,stage=stage,away={},night={},apprentices={},apprenticeCount=0,nightCrew=0,securityNight=false,itNight=false,before=Rota.before(e)}
 local profiles=if typeof(e.staffProfiles)=="table" then e.staffProfiles else {}
 local apprentices=typeof(e.apprentices)=="table" and next(e.apprentices)~=nil
 for _,role in EmpireConfig.ROLES do
  local id=role.id
  if count(e,id)==0 then continue end
  local list=profiles[id]
  for i,state in Rota.presence(e,day,id) do
   if state~="present" then snap.away[Rota.key(id,i)]=state end
   if apprentices then
    local p=if typeof(list)=="table" then list[i] else nil
    local seed=seedOf(p,i)
    -- apprentices follow the saved calendar day (graduation is CompanyOps.graduate at the day change)
    local today=Ops.day(e)
    local skill=Ops.apprentice(e,seed,today)
    if skill then
     local entry=e.apprentices[tostring(seed)]
     local age=today-(tonumber(entry and entry.day) or today)
     snap.apprentices[Rota.key(id,i)]={age=math.max(0,age),skill=skill,seed=seed}
     snap.apprenticeCount+=1
    end
   end
  end
  local a,b=Rota.nightRange(e,id)
  for i=a,b do
   if i&gt;=1 then snap.night[Rota.key(id,i)]=true;snap.nightCrew+=1 end
  end
 end
 -- the night crew needs a security post on duty; from stage 5 security and IT keep a night rota
 snap.securityNight=stage&gt;=5 or snap.nightCrew&gt;0
 snap.itNight=stage&gt;=5
 return snap
end
-- Hired staff on duty at `hour`: absent people never; the night crew 22-06; everyone else their seeded
-- shift (EmployeeConfig.personalityFromSeed start..finish).
function Rota.hiredOnDuty(hour: number,start: number,finish: number,away: string?,night: boolean?): boolean
 if away then return false end
 if night then return Rota.nightCrewOnDuty(hour) end
 return hour&gt;=start and hour&lt;finish
end
-- Operations posts: the day shift, or around the clock for a night-rota post (security / IT).
function Rota.opsOnDuty(hour: number,start: number,finish: number,nightRota: boolean?): boolean
 if nightRota then return true end
 return hour&gt;=start and hour&lt;finish
end
-- Night rota of operations post `post` (OpsIndex) for this snapshot.
function Rota.nightRota(snap: Snapshot,post: number): boolean
 if not Config.NIGHT_ROTA_POSTS[post] then return false end
 if post==3 then return snap.securityNight end
 return snap.itNight
end
return Rota
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000040"><Properties><string name="Name">TalkService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- TalkService: talk to anyone in the company — employees and operations staff; visitors (other players)
-- may talk to the front-of-house jobs (reception, hotel desk, security, barista, café host, chef).
-- The words come from the pure, AUTHORED ReplicatedStorage.Shared.Dialogue (no language model); this
-- service gathers the real state, enforces the rules and keeps one conversation per NPC.
--
-- Entry: ProximityPrompt "EmployeeTalk" (attribute EmployeeTalk = staff index; only this service handles
-- it) → Notify TALK_OPEN, or TalkAction {action="open", npc=Model} → {ok, talk}. Rules checked on the
-- server: the owner talks with everyone in his company; anyone else only with a front-of-house job whose
-- prompt is Public (EmployeeRigDesign); player within OPEN_DISTANCE studs (KEEP_DISTANCE while talking);
-- the NPC is not off duty / inactive; one conversation per NPC and per player; prompt cooldown, say
-- interval and the TalkAction rate limit.
-- talk payload: {id, npc, name, job, kind, initials, seed, viewer, room, level, greeting, options}.
-- TalkAction {action="say", id, option} answers one OFFERED option → {ok, text, options, close?};
-- {action="close", id} ends it. Idle conversations (IDLE s), vanished NPCs and players who leave end on
-- the server with Notify TALK_CLOSE {id, text?}.
-- The NPC: rig attributes TalkingTo (userId) and TalkFace (Vector3 of the player, written on open and
-- per answer) while talking — the client hides the prompt for everyone else and poses may use them.
-- When StaffService provides hold(model, facePosition) / release(model) the employee's state machine
-- pauses (task + station reservation kept, a walk resumes afterwards); without it a standing, anchored
-- NPC is only turned to face the player and turned back afterwards (seated NPCs keep their pose).
-- Numbers: Dialogue.facts over the owner's session, plus counts measured here: visitors in the building
-- now, distinct visitors today (5 s sampler over the plots, per campus day), conversations per NPC today,
-- open PropFx faults (FxState "broken"), computer desks, desks per plan room and café seats (one scan per
-- office) with the desks in use right now (OccupiedBy), the plan room the NPC stands in (kind,
-- department, access, camera) and its home desk room (HomeWorkstation → HomeRoom), the lunch phase of
-- the live staff record (StaffService.recordOf), guest cards (live.campus.passes), cars, and lunches /
-- hotel guests when the life/hotel packages publish the office attributes LunchesServed / HotelGuests /
-- HotelRooms. Nothing is saved; no session.live fields; no per-frame work (a 1 s sweep ends conversations
-- whose player walked away or that ran too long).
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Prompts=game:GetService("ProximityPromptService")
local Collection=game:GetService("CollectionService")
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local CampusConfig=require(ReplicatedStorage.Shared.Config.CampusConfig)
local EmpireConfig=require(ReplicatedStorage.Shared.Config.EmpireConfig)
local EmployeeConfig=require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Dialogue=require(ReplicatedStorage.Shared.Dialogue)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Session=require(script.Parent.SessionService)
local Plot=require(script.Parent.PlotService)
local Staff=require(script.Parent.StaffService)
local Talk={}
Talk.OPEN_DISTANCE=12 -- studs between the player's root and the NPC to start talking
Talk.KEEP_DISTANCE=16 -- walking further away during the conversation ends it
Talk.IDLE=60 -- seconds without an answer before the NPC goes back to work
Talk.MAX_SECONDS=600 -- hard cap per conversation
Talk.PROMPT_COOLDOWN=.8 -- seconds between prompt triggers per player
Talk.SAY_INTERVAL=.3 -- seconds between answers per conversation
Talk.SAMPLE_EVERY=5 -- seconds between "visitors today" samples
Talk.SWEEP_EVERY=1 -- seconds between walk-away / time-limit checks of open conversations
Talk.clock=function(): number return os.clock() end -- seam: tests drive time
type Info={model: Model,root: BasePart,office: Instance,owner: number,prompt: ProximityPrompt,index: number,roleId: string,job: string,kind: string,name: string}
type Conv={id: string,npc: Model,player: Player,userId: number,owner: number,viewer: string,kind: string,name: string,farewell: string,
 asked: {[string]:boolean},offered: {[string]:boolean},token: number,started: number,last: number,faced: CFrame?,held: boolean,watch: RBXScriptConnection?,closed: boolean}
local conversations: {[Model]:Conv}={}
local byPlayer: {[Player]:Conv}={}
local serial=0
local promptAt: {[Player]:number}=setmetatable({},{__mode="k"}) :: any
local talks: {[Model]:{day: number,n: number}}=setmetatable({},{__mode="k"}) :: any
local seen: {[Instance]:{day: number,ids: {[number]:boolean},n: number}}=setmetatable({},{__mode="k"}) :: any
type Statics={desks: number,dining: number,computers: {Instance},byId: {[string]:Instance},byRoom: {[string]:{Instance}}}
local statics: {[Instance]:Statics}=setmetatable({},{__mode="k"}) :: any
local buildings: {[number]:any}={}
local NOTICE: {[string]:string}={
 NPC_BUSY="{name} is talking to someone else right now.",
 OFF_DUTY="{name} is off duty. Try again during working hours.",
 TOO_FAR="Step a little closer to {name}.",
 UNAVAILABLE="{name} can't talk right now.",
}
local MENU_KINDS={barista=true,chef=true,kitchen=true,host=true}
-- IT faults exist when a job step breaks/fixes desk screens (EmployeeConfig.JOBS, StaffJobs "fault").
local FAULT_SYSTEM=(function(): boolean
 local jobs=(EmployeeConfig :: any).JOBS
 if typeof(jobs)~="table" then return false end
 for _,steps in jobs do
  if typeof(steps)=="table" then for _,step in steps do if typeof(step)=="table" and step.fault then return true end end end
 end
 return false
end)()

-- Helpers -------------------------------------------------------------------------------------------
local function firstName(name: string): string return string.match(name,"^%s*(%S+)") or name end
local function campusDay(): number return math.floor(Staff.now()/Dialogue.DAY_SECONDS) end
local function rootOf(player: Player): BasePart?
 local character=player.Character;if not character then return nil end
 local root=character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
 return if root and root:IsA("BasePart") then root else nil
end
local function ownerSession(userId: number): any
 for _,s in Session.all() do if s.userId==userId and not s.closed then return s end end
 return nil
end
-- A staff rig with a talk prompt inside an office (visitors/assistant rigs have their prompt renamed).
local function info(model: Instance): Info?
 if not model:IsA("Model") then return nil end
 local root=model.PrimaryPart;local head=model:FindFirstChild("Head")
 local prompt=if head then head:FindFirstChild("EmployeeTalk") else nil
 if not root or not prompt or not prompt:IsA("ProximityPrompt") then return nil end
 local index=prompt:GetAttribute("EmployeeTalk");local owner=model:GetAttribute("OwnerUserId")
 if typeof(index)~="number" or typeof(owner)~="number" then return nil end
 local office=model:FindFirstAncestor("Office");if not office then return nil end
 local officeOwner=office:GetAttribute("OwnerUserId");if officeOwner~=nil and officeOwner~=owner then return nil end
 local roleId=model:GetAttribute("RoleId");local job=model:GetAttribute("Role");local name=model:GetAttribute("EmployeeName")
 local r=if typeof(roleId)=="string" then roleId else "support"
 local j=if typeof(job)=="string" then job else "Campus Operations"
 return {model=model,root=root,office=office,owner=owner,prompt=prompt,index=index,roleId=r,job=j,kind=Dialogue.kind(r,j),name=if typeof(name)=="string" then name else "Employee"}
end
local function tierOf(office: Instance,s: any): number
 local t=office:GetAttribute("OfficeTier")
 if typeof(t)=="number" then return t end
 return if s then tonumber(s.data.empire.office) or 1 else 1
end
local function campusFrame(model: Model,office: Instance): CFrame?
 local cf=model:GetAttribute("CampusCFrame")
 if typeof(cf)=="CFrame" then return cf end
 for _,p in Plot.all() do if p.office==office then return p.cframe end end
 return nil
end
local function inside(tier: number,cf: CFrame,player: Player): boolean
 local root=rootOf(player)
 return root~=nil and Plan.inside(tier,cf:PointToObjectSpace(root.Position))
end

-- Measured counts -------------------------------------------------------------------------------------
local function building(tier: number): any
 local b=buildings[tier];if b then return b end
 local rooms,cameras,restrooms=0,0,0;local public={}
 for _,r in Plan.rooms(tier) do
  if not r.hidden then
   rooms+=1
   if r.camera then cameras+=1 end
   if r.kind=="wc" or r.kind=="restrooms" or r.kind=="showers" then restrooms+=1 end
   if r.access=="public" then table.insert(public,r.name) end
  end
 end
 b={floors=Plan.floors(tier),rooms=rooms,cameras=cameras,restrooms=restrooms,stops=#Plan.liftStops(tier),publicRooms=public}
 buildings[tier]=b;return b
end
-- Workstations of a built office, indexed once: computer desks (also per plan room via HomeRoom),
-- café seats and every station by WorkstationId (home desks). Static until the office is rebuilt.
local function officeCounts(office: Instance): Statics
 local cached=statics[office];if cached then return cached end
 local c: Statics={desks=0,dining=0,computers={},byId={},byRoom={}}
 for _,m in office:GetDescendants() do
  if m:IsA("Model") then
   local kind=m:GetAttribute("WorkstationType");local id=m:GetAttribute("WorkstationId")
   if typeof(id)=="string" then c.byId[id]=m end
   if kind=="Computer" then
    c.desks+=1;table.insert(c.computers,m)
    local room=m:GetAttribute("HomeRoom")
    if typeof(room)=="string" then local list=c.byRoom[room] or {};c.byRoom[room]=list;table.insert(list,m) end
   elseif kind=="Dining" then c.dining+=1 end
  end
 end
 statics[office]=c;return c
end
-- Desks of a list that someone works at right now (WorkstationService sets OccupiedBy).
local function busyOf(list: {Instance}?): number?
 if not list then return nil end
 local n=0
 for _,m in list do if m:GetAttribute("OccupiedBy")~=nil then n+=1 end end
 return n
end
-- Open faults of the PropFx contract (screens with FxState "broken"); nil when there is no fault system
-- to report on (no job step breaks screens and no PropFx prop exists in this office).
local function faults(office: Instance,tier: number,cf: CFrame?): any
 local present=FAULT_SYSTEM;local n=0;local rooms: {string}={};local named: {[string]:boolean}={}
 for _,inst in Collection:GetTagged("PropFx") do
  if inst:IsDescendantOf(office) then
   present=true
   if inst:GetAttribute("FxState")=="broken" then
    n+=1
    local pos=if inst:IsA("BasePart") then inst.Position elseif inst:IsA("Model") then inst:GetPivot().Position else nil
    local r=if pos and cf then Plan.roomAt(tier,cf:PointToObjectSpace(pos)) else nil
    if r and not named[r.name] then named[r.name]=true;table.insert(rooms,r.name) end
   end
  end
 end
 return if present then {count=n,rooms=rooms} else nil
end
local function visitorsNow(owner: number,tier: number,cf: CFrame?): number
 if not cf then return 0 end
 local n=0
 for _,s in Session.all() do if not s.closed and s.userId~=owner and inside(tier,cf,s.player) then n+=1 end end
 return n
end
local function markSeen(office: Instance,userId: number)
 local day=campusDay();local old=seen[office]
 local rec=if old and old.day==day then old else {day=day,ids={},n=0}
 seen[office]=rec
 if not rec.ids[userId] then rec.ids[userId]=true;rec.n+=1 end
end
local function visitorsToday(office: Instance): number
 local rec=seen[office]
 return if rec and rec.day==campusDay() then rec.n else 0
end
-- Distinct other players inside each headquarters during the current campus day.
local function sample()
 for _,p in Plot.all() do
  local office=p.office;local owner=p.owner
  if office and owner and p.cframe then
   local tier=tierOf(office,nil)
   for _,s in Session.all() do
    if not s.closed and s.userId~=owner.UserId and inside(tier,p.cframe,s.player) then markSeen(office,s.userId) end
   end
  end
 end
end
local function cars(s: any): any
 local c=s.data.empire.campus
 if typeof(c)~="table" or typeof(c.cars)~="table" then return nil end
 local owned={}
 for _,def in CampusConfig.CARS do if c.cars[def.id] then table.insert(owned,def.name) end end
 local selected=CampusConfig.find(CampusConfig.CARS,c.selectedCar)
 return {owned=owned,ready=if selected and c.cars[selected.id] then selected.name else nil}
end
local function menu(): {any}
 local out={}
 for _,item in CampusConfig.SNACKS do table.insert(out,{name=item.name,price=item.price,seconds=item.seconds}) end
 return out
end

-- Subject + context --------------------------------------------------------------------------------
-- The i-th person of a role is rig index (Σ earlier roles) + i (StaffAssignment); the name confirms it.
local function profileOf(e: any,i: Info,roleId: string): any
 local profiles=e.staffProfiles;local list=if typeof(profiles)=="table" then profiles[roleId] else nil
 if typeof(list)~="table" then return nil end
 local before=0
 for _,role in EmpireConfig.ROLES do if role.id==roleId then break end;before+=tonumber(e.employees[role.id]) or 0 end
 local p=list[i.index-before]
 if typeof(p)=="table" and (p.n==nil or p.n==i.name) then return p end
 for _,q in list do if typeof(q)=="table" and q.n==i.name then return q end end
 return nil
end
-- Home desk of a hired employee: room, department and how many of that room's desks are in use.
local function deskOf(i: Info,st: Statics,tier: number): any
 if i.roleId=="support" then return nil end
 local id=i.model:GetAttribute("HomeWorkstation")
 local w=if typeof(id)=="string" and id~="" then st.byId[id] else nil
 local roomId=if w then w:GetAttribute("HomeRoom") else nil
 local r=if typeof(roomId)=="string" then Plan.room(tier,roomId) else nil
 if not w or not r or r.hidden then return nil end
 local list=st.byRoom[r.id];local dept=w:GetAttribute("Department")
 return {room=r.name,level=Plan.levelLabel(tier,r.level),dept=if typeof(dept)=="string" then dept else r.dept,desks=if list then #list else nil,busy=busyOf(list)}
end
local function subject(i: Info,s: any,tier: number,cf: CFrame?,st: Statics): any
 local m=i.model
 local seed=m:GetAttribute("PersonalitySeed")
 local sub: any={name=i.name,roleId=i.roleId,job=i.job,seed=if typeof(seed)=="number" then seed else EmployeeConfig.seed(i.index,i.owner),index=i.index}
 local activity=m:GetAttribute("Activity");if typeof(activity)=="string" then sub.activity=activity end
 local task=m:GetAttribute("Task");if typeof(task)=="string" then sub.task=task end
 local skill=m:GetAttribute("Skill");if typeof(skill)=="number" then sub.skill=skill end
 local pose=m:GetAttribute("Pose");if typeof(pose)=="string" then sub.pose=pose end
 if cf then
  local lp=cf:PointToObjectSpace(i.root.Position);local r=Plan.roomAt(tier,lp)
  if r then
   sub.room=r.name;sub.level=Plan.levelLabel(tier,r.level);sub.levelNumber=r.level
   if not r.hidden then
    -- "What's this room for?": plan kind, department, door class, camera, desks in use in this room
    sub.roomKind=r.kind;sub.roomDept=r.dept;sub.roomAccess=r.access;sub.roomCamera=r.camera==true
    local list=st.byRoom[r.id]
    if list then sub.roomDesks=#list;sub.roomBusy=busyOf(list) end
   end
  else local level=Plan.levelAt(tier,lp.Y);if level then sub.levelNumber=level;sub.level=Plan.levelLabel(tier,level) end end
 end
 local role=EmpireConfig.find(EmpireConfig.ROLES,i.roleId)
 if role and s then
  local p=profileOf(s.data.empire,i,role.id)
  local w=if p and typeof(p.w)=="number" then p.w else 1
  sub.wage=role.wage*w
  if p and typeof(p.k)=="number" then sub.skill=p.k end
 end
 local a,b=m:GetAttribute("ShiftStart"),m:GetAttribute("ShiftEnd")
 if typeof(a)=="number" and typeof(b)=="number" then sub.shiftStart=a;sub.shiftEnd=b end
 sub.desk=deskOf(i,st,tier)
 -- lunch phase (queue / seat / tray return) of the live record, read only
 local api: any=Staff
 if typeof(api.recordOf)=="function" then
  local ok,rec=pcall(api.recordOf,m)
  if ok and typeof(rec)=="table" and typeof(rec.lunch)=="table" and typeof(rec.lunch.phase)=="string" then sub.lunch=rec.lunch.phase end
 end
 return sub
end
local BUSY_KINDS={reception=true,facilities=true,mailroom=true,ops=true} -- tour / building answers cite desks in use
local function context(viewer: string,player: Player,i: Info,s: any,tier: number,cf: CFrame?,sub: any,st: Statics): any
 local data=s.data
 local c: any={viewer=viewer,viewerName=player.DisplayName,day=campusDay(),hour=EmployeeConfig.hour(Staff.now()),tier=tier,
  facts=Dialogue.facts(data,s.live),company=if data.company then data.company.name else s.player.DisplayName.."'s company",ownerName=s.player.DisplayName}
 local ids=Dialogue.placeIds(viewer,i.kind)
 if #ids&gt;0 then c.places=Dialogue.places(tier,ids,sub.levelNumber) end
 c.building=building(tier)
 c.visitorsNow=visitorsNow(i.owner,tier,cf);c.visitorsToday=visitorsToday(i.office)
 local t=talks[i.model];c.talksToday=if t and t.day==c.day then t.n else 0
 c.desks=st.desks
 if viewer=="owner" and BUSY_KINDS[i.kind] then c.desksBusy=busyOf(st.computers) end
 if MENU_KINDS[i.kind] or sub.roomKind=="cafe" then c.dining=st.dining end
 if MENU_KINDS[i.kind] then c.menu=menu() end
 if i.kind=="it" then c.faults=faults(i.office,tier,cf) end
 if i.kind=="fleet" then c.cars=cars(s) end
 local campus=s.live and s.live.campus
 if typeof(campus)=="table" and typeof(campus.passes)=="table" then c.passes=#campus.passes end
 local lunches=i.office:GetAttribute("LunchesServed");if typeof(lunches)=="number" then c.lunches=lunches end
 local guests=i.office:GetAttribute("HotelGuests")
 if typeof(guests)=="number" then local rooms=i.office:GetAttribute("HotelRooms");c.hotel={guests=guests,rooms=if typeof(rooms)=="number" then rooms else nil} end
 return c
end
local function build(viewer: string,player: Player,i: Info,s: any): (Dialogue.Lines,any)
 local tier=tierOf(i.office,s);local cf=campusFrame(i.model,i.office);local st=officeCounts(i.office)
 local sub=subject(i,s,tier,cf,st)
 return Dialogue.lines(sub,context(viewer,player,i,s,tier,cf,sub,st)),sub
end

-- NPC hold / release ----------------------------------------------------------------------------------
local function face(root: BasePart,target: Vector3)
 local p=root.Position;local d=Vector3.new(target.X-p.X,0,target.Z-p.Z)
 if d.Magnitude&gt;.2 then root.CFrame=CFrame.lookAt(p,p+d) end
end
local function hold(conv: Conv,i: Info,at: Vector3)
 local m=i.model
 m:SetAttribute("TalkingTo",conv.userId);m:SetAttribute("TalkFace",at)
 local api: any=Staff
 if typeof(api.hold)=="function" then
  local ok,res=pcall(api.hold,m,at)
  conv.held=ok and res==true
 end
 local h=m:FindFirstChildOfClass("Humanoid")
 if i.root.Anchored and not (h and h.SeatPart) then conv.faced=i.root.CFrame;face(i.root,at) end
end
local function release(conv: Conv)
 local m=conv.npc
 if m.Parent then m:SetAttribute("TalkingTo",nil);m:SetAttribute("TalkFace",nil) end
 local root=m.PrimaryPart;local faced=conv.faced;conv.faced=nil
 -- turn back only if nobody moved the NPC meanwhile (a new task places it itself)
 if faced and root and root.Parent and root.Anchored and (root.Position-faced.Position).Magnitude&lt;.3 then root.CFrame=faced end
 if conv.held then
  conv.held=false
  local api: any=Staff
  if typeof(api.release)=="function" then pcall(api.release,m) end
 end
end
local function finish(conv: Conv,text: string?,notify: boolean)
 if conv.closed then return end
 conv.closed=true
 if conversations[conv.npc]==conv then conversations[conv.npc]=nil end
 if byPlayer[conv.player]==conv then byPlayer[conv.player]=nil end
 if conv.watch then conv.watch:Disconnect();conv.watch=nil end
 release(conv)
 if notify then Remote.fire(conv.player,"Notify","TALK_CLOSE",{id=conv.id,text=text}) end
end
local function arm(conv: Conv)
 conv.token+=1
 local token=conv.token
 task.delay(Talk.IDLE,function()
  if not conv.closed and conv.token==token then finish(conv,conv.farewell,true) end
 end)
end
local function offer(conv: Conv,options: {Dialogue.Option})
 local set: {[string]:boolean}={}
 for _,o in options do set[o.id]=true end
 conv.offered=set
end

-- Public API ----------------------------------------------------------------------------------------
local function refuse(player: Player,i: Info?,code: string,viaPrompt: boolean?): any
 if viaPrompt and i and NOTICE[code] then
  Remote.fire(player,"Notify","TALK_NOTICE",{text=(string.gsub(NOTICE[code],"{name}",firstName(i.name)))})
 end
 return {ok=false,err=code}
end
function Talk.open(player: Player,model: Instance,viaPrompt: boolean?): any
 local i=info(model);if not i then return {ok=false,err="NPC_GONE"} end
 local own=player.UserId==i.owner
 if not own and not (Dialogue.isPublicKind(i.kind) and i.prompt:GetAttribute("Public")==true) then return refuse(player,i,"NOT_PUBLIC",viaPrompt) end
 local mine=Session.get(player);if not mine or mine.closed then return {ok=false,err="LOADING"} end
 local s=ownerSession(i.owner);if not s or not s.data then return refuse(player,i,"UNAVAILABLE",viaPrompt) end
 local root=rootOf(player)
 if not root or (root.Position-i.root.Position).Magnitude&gt;Talk.OPEN_DISTANCE then return refuse(player,i,"TOO_FAR",viaPrompt) end
 local m=i.model;local activity=m:GetAttribute("Activity")
 if m:GetAttribute("OffDuty")==true or activity=="OFF_DUTY" then return refuse(player,i,"OFF_DUTY",viaPrompt) end
 local h=m:FindFirstChildOfClass("Humanoid")
 if activity=="INACTIVE" or (h and h.Health&lt;=0) then return refuse(player,i,"UNAVAILABLE",viaPrompt) end
 local busy=conversations[m]
 if busy and not busy.closed and busy.player~=player then return refuse(player,i,"NPC_BUSY",viaPrompt) end
 local previous=byPlayer[player];if previous then finish(previous,nil,false) end
 if busy and not busy.closed then finish(busy,nil,false) end
 local viewer=if own then "owner" else "visitor"
 local lines,sub=build(viewer,player,i,s)
 serial+=1
 local t=Talk.clock()
 local conv: Conv={id="talk"..serial,npc=m,player=player,userId=player.UserId,owner=i.owner,viewer=viewer,kind=i.kind,name=i.name,farewell=lines.farewell,
  asked={},offered={},token=0,started=t,last=t,faced=nil,held=false,watch=nil,closed=false}
 conversations[m]=conv;byPlayer[player]=conv
 offer(conv,lines.options)
 local day=campusDay();local old=talks[m]
 local count=if old and old.day==day then old else {day=day,n=0}
 talks[m]=count;count.n+=1
 if not own then markSeen(i.office,player.UserId) end
 hold(conv,i,root.Position)
 conv.watch=m.AncestryChanged:Connect(function()
  if not m:IsDescendantOf(workspace) then finish(conv,nil,true) end
 end)
 arm(conv)
 return {ok=true,talk={id=conv.id,npc=m,name=i.name,job=i.job,kind=i.kind,initials=Dialogue.initials(i.name),seed=sub.seed,viewer=viewer,
  room=sub.room,level=sub.level,greeting=lines.greeting,options=lines.options}}
end
function Talk.say(player: Player,id: any,option: any): any
 local conv=byPlayer[player]
 if not conv or conv.closed or (id~=nil and id~=conv.id) then return {ok=false,err="NO_TALK"} end
 if typeof(option)~="string" or #option&gt;64 or not string.match(option,"^[%w_:%-]+$") or not conv.offered[option] then return {ok=false,err="BAD_INPUT"} end
 local t=Talk.clock()
 if t-conv.last&lt;Talk.SAY_INTERVAL then return {ok=false,err="RATE_LIMIT"} end
 local i=info(conv.npc)
 if not i then finish(conv,nil,false);return {ok=false,err="NPC_GONE"} end
 local root=rootOf(player)
 if not root or (root.Position-i.root.Position).Magnitude&gt;Talk.KEEP_DISTANCE then finish(conv,nil,false);return {ok=false,err="TOO_FAR"} end
 local s=ownerSession(i.owner)
 if not s or t-conv.started&gt;Talk.MAX_SECONDS then finish(conv,nil,false);return {ok=false,err="UNAVAILABLE"} end
 conv.last=t
 local lines=build(conv.viewer,player,i,s) -- fresh numbers for every answer
 local answer,options=Dialogue.step(lines,conv.asked,option)
 if not answer then return {ok=false,err="BAD_INPUT"} end
 if answer.close or #options==0 then
  finish(conv,nil,false)
  return {ok=true,text=answer.text,options={},close=true}
 end
 i.model:SetAttribute("TalkFace",root.Position)
 -- a job step may have turned the NPC back to its desk meanwhile: face the player again (same spot only)
 local faced=conv.faced
 if faced and i.root.Anchored and (i.root.Position-faced.Position).Magnitude&lt;.3 then face(i.root,root.Position) end
 offer(conv,options);arm(conv)
 return {ok=true,text=answer.text,options=options}
end
function Talk.close(player: Player,id: any): any
 local conv=byPlayer[player]
 if conv and (id==nil or id==conv.id) then finish(conv,nil,false) end
 return {ok=true}
end
-- Ends conversations whose player walked away (&gt; KEEP_DISTANCE from the NPC), whose player or NPC is
-- gone, or that ran longer than MAX_SECONDS; the NPC says goodbye (TALK_CLOSE with the farewell).
local function sweep()
 local ended: {Conv}={}
 local t=Talk.clock()
 for npc,conv in conversations do
  local root=rootOf(conv.player);local npcRoot=npc.PrimaryPart
  if not root or not npcRoot or (root.Position-npcRoot.Position).Magnitude&gt;Talk.KEEP_DISTANCE or t-conv.started&gt;Talk.MAX_SECONDS then table.insert(ended,conv) end
 end
 for _,conv in ended do finish(conv,conv.farewell,true) end
end
-- Diagnostics/tests: the conversation an NPC is in (nil when free).
function Talk.conversation(model: Model): any
 local conv=conversations[model]
 return if conv and not conv.closed then {id=conv.id,userId=conv.userId,viewer=conv.viewer,kind=conv.kind} else nil
end
local function act(s: any,p: any): any
 local player: Player=s.player
 local action=p.action
 if action=="open" then
  if typeof(p.npc)~="Instance" then return {ok=false,err="BAD_INPUT"} end
  return Talk.open(player,p.npc,false)
 elseif action=="say" then
  if p.id~=nil and typeof(p.id)~="string" then return {ok=false,err="BAD_INPUT"} end
  return Talk.say(player,p.id,p.option)
 elseif action=="close" then
  return Talk.close(player,if typeof(p.id)=="string" then p.id else nil)
 end
 return {ok=false,err="BAD_INPUT"}
end
local function onPrompt(prompt: ProximityPrompt,player: Player)
 if prompt.Name~="EmployeeTalk" or typeof(prompt:GetAttribute("EmployeeTalk"))~="number" then return end
 local t=Talk.clock()
 if (promptAt[player] or 0)&gt;t then return end
 promptAt[player]=t+Talk.PROMPT_COOLDOWN
 local head=prompt.Parent;local model=if head then head.Parent else nil
 if not model then return end
 local res=Talk.open(player,model,true)
 if res.ok then Remote.fire(player,"Notify","TALK_OPEN",res.talk) end
end
Talk._act=act;Talk._prompt=onPrompt;Talk._sample=sample;Talk._sweep=sweep -- tests
function Talk.init()
 Prompts.PromptTriggered:Connect(onPrompt)
 Remote.bind("TalkAction",{burst=6,perSecond=3},act)
 Players.PlayerRemoving:Connect(function(player: Player)
  local conv=byPlayer[player];if conv then finish(conv,nil,false) end
  promptAt[player]=nil
 end)
 Session.onClosing(function(s: any)
  local list={}
  for _,conv in conversations do if conv.player==s.player or conv.owner==s.userId then table.insert(list,conv) end end
  for _,conv in list do finish(conv,nil,conv.player~=s.player) end
 end)
 task.spawn(function()
  while true do
   task.wait(Talk.SAMPLE_EVERY)
   local ok,err=pcall(sample :: () -&gt; any)
   if not ok then warn("[Talk] visitor sample: "..tostring(err)) end
  end
 end)
 task.spawn(function()
  while true do
   task.wait(Talk.SWEEP_EVERY)
   if next(conversations)~=nil then
    local ok,err=pcall(sweep :: () -&gt; any)
    if not ok then warn("[Talk] sweep: "..tostring(err)) end
   end
  end
 end)
end
return Talk
</ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX00000034"><Properties><string name="Name">Main</string><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">--!strict
-- Server-Einstieg. Reihenfolge ist wichtig:
--   1. Remotes anlegen (Client wartet darauf)
--   2. Speichern prüfen, Welt bauen, Services binden ihre Remotes
--   3. SessionService zuletzt: ab dann werden Spieler geladen
-- Danach ein einziger Heartbeat-Takt für Training, Markt, Autosave und State-Versand.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Server = script.Parent
local Remote = require(Server.Lib.Remote)
local Services = Server.Services
local SaveService = require(Services.SaveService)
local SessionService = require(Services.SessionService)
local PlotService = require(Services.PlotService)
local CompanyService = require(Services.CompanyService)
local DatasetService = require(Services.DatasetService)
local ComputeService = require(Services.ComputeService)
local AIModelService = require(Services.AIModelService)
local MarketService = require(Services.MarketService)
local DebugService = require(Services.DebugService)

local EmpireService = require(Services.EmpireService)
local CampusService = require(Services.CampusService)

local NPCService=require(Services.NPCService)
local StudioService=require(Services.StudioService)
local ArenaService=require(Services.ArenaService)
local LeaderboardService=require(Services.LeaderboardService)

local DoorService=require(Services.DoorService)
local LiftService=require(Services.LiftService)
local FacilityService=require(Services.FacilityService)
local VehicleService=require(Services.VehicleService)
local AdminService=require(Services.AdminService)
local StaffService=require(Services.StaffService)
local BuildingStateService=require(Services.BuildingStateService)
local RecruitingService=require(Services.RecruitingService)
local AssistantService=require(Services.AssistantService)
local TalkService=require(Services.TalkService)
local ShopService=require(Services.ShopService)
local CityService=require(Services.CityService)
local PhoneService=require(Services.PhoneService)

local MAX_STEP = 5 -- nach einem Server-Hänger nicht mehr als 5 s auf einmal simulieren

Remote.setup()
SaveService.init()
PlotService.init()
CompanyService.init()
DatasetService.init()
ComputeService.init()
AIModelService.init()
MarketService.init()
DebugService.init()
EmpireService.init()
CampusService.init()
CityService.init() -- shared business city, airport and the international city (built once per server)
NPCService.init()
StudioService.init()
ArenaService.init()
LeaderboardService.init()
DoorService.init() -- vor FacilityService: Facility setzt den Tür-Authorizer und initialisiert den Lift
FacilityService.init()
VehicleService.init()
AdminService.init()
StaffService.init()
RecruitingService.init() -- Bewerbungen &amp; Gespräche (vor SessionService: onLoaded repariert Staff-Profile)
AssistantService.init()
TalkService.init() -- talk to anyone (employees, ops staff, visitors)
ShopService.init() -- Robux receipts/game passes (before SessionService: receipts wait for the session)
PhoneService.init() -- company phone: calls, messages, calendar, AI chat
SessionService.init()

-- Ein Fehler bei einem Spieler darf den Takt der anderen nicht stoppen
local function safely(label: string, fn: () -&gt; ())
	local ok, err = pcall(fn :: () -&gt; any)
	if not ok then
		warn(`[Tick] {label}: {err}`)
	end
end

local function simulate(step: number)
	safely("NPC companies",function() NPCService.tick(step) end)
	safely("Shared market",function() MarketService.tickGlobal(step) end)
	for _, session in SessionService.all() do
		if not session.closed then
			safely("Training " .. session.player.Name, function()
				AIModelService.tick(session, step)
			end)
			safely("Markt " .. session.player.Name, function()
				MarketService.tick(session, step)
			end)
			safely("Empire " .. session.player.Name, function()
				StudioService.tick(session,step)
				EmpireService.tick(session, step)
				FacilityService.economyTick(session,step)
			end)
			safely("Recruiting " .. session.player.Name, function()
				RecruitingService.tick(session, step)
			end)
		end
	end
	StudioService.refresh()
	LeaderboardService.tick(step)
	CampusService.tick(step)
end

local accumulator = 0
local arenaAccumulator=0
local campusAccumulator=0
RunService.Heartbeat:Connect(function(dt: number)
	accumulator += dt
	campusAccumulator+=dt
	if campusAccumulator&gt;=.05 then
		local campusStep=math.min(campusAccumulator,.25);campusAccumulator=0
		safely("Campus doors",function()DoorService.tick(campusStep)end)
		safely("Campus lift",function()LiftService.tick(campusStep)end)
		safely("Campus access",function()FacilityService.tick(campusStep)end)
		safely("Campus employees",function()StaffService.tick(campusStep)end)
		safely("Campus visitors",function()RecruitingService.campusTick(campusStep)end)
		safely("Founder assistant",function()AssistantService.tick(campusStep)end)
  safely("Company displays",function()BuildingStateService.tick(campusStep)end)
		safely("Company cars",function()VehicleService.tick(campusStep)end)
		safely("World travel",function()CityService.tick(campusStep)end)
	end
	arenaAccumulator+=dt
	if arenaAccumulator&gt;=.1 then
		local arenaStep=math.min(arenaAccumulator,.5);arenaAccumulator=0
		safely("Arena animation",function() ArenaService.tick(arenaStep) end)
	end
	if accumulator &gt;= GameConfig.TICK_SECONDS then
		local step = math.min(accumulator, MAX_STEP)
		accumulator = 0
		simulate(step)
		SessionService.autosave(os.clock())
	end
	SessionService.flush(os.clock())
end)

print(`[AI Empire] Server bereit (Speichern: {if SaveService.enabled then "AN" else "AUS"})`)
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000036"><Properties><string name="Name">StarterPlayer</string><bool name="Archivable">true</bool></Properties><Item class="StarterPlayerScripts" referent="RBX00000037"><Properties><string name="Name">StarterPlayerScripts</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000058"><Properties><string name="Name">Client</string><bool name="Archivable">true</bool></Properties><Item class="Folder" referent="RBX00000041"><Properties><string name="Name">Controllers</string><bool name="Archivable">true</bool></Properties><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">ActionController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Einziger Weg, wie die UI den Server um etwas bittet. Schützt vor Doppelklicks und übersetzt
-- Fehlercodes vom Server in verständliche Meldungen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local HardwareConfig = require(ReplicatedStorage.Shared.Config.HardwareConfig)
local Toast = require(script.Parent.Parent.UI.Toast)

export type Result = { [string]: any }

local ActionController = {}

local MESSAGES: { [string]: string } = {
	ADMIN_ONLY="This admin panel belongs to the Roblox account Nonortrttrt.",
	OWNER_ONLY="Only the owner of this plot has access here.",
	LIFT_BUSY="The lift is on its way. Wait a moment at the landing.",
	LIFT_DISTANCE="Move closer to the lift call button or the cabin panel.",
	LIFT_SEATED="Leave your vehicle before using the lift.",
	LIFT_NOT_PASSENGER="Step inside the lift to choose a floor.",
	LIFT_FLOOR_LOCKED="Your card does not open that floor.",
	LIFT_FULL="The lift is full. Wait for the next cabin.",
	LIFT_NO_LANDING="Walk to a lift landing first.",
	LIFT_OUT_OF_SERVICE="The lift is out of service right now. Use the stairs beside the lift.",
	DOOR_DENIED="Your card does not open this door.",
	DOOR_BUSY="This door is moving. Try again in a moment.",
	OCCUPIED="Someone is already using this.",
	FOUNDER_ONLY="Only the company founder can open this.",
	RESEARCH_ONLY="This room needs research clearance.",
	TECHNICAL_ONLY="This room is for technical staff only.",
	COMPUTE_ONLY="The compute room is for compute engineers only.",
	CARD_REQUIRED="You need a valid card for this company.",
	SNACK_FULL="Your snack bag holds 16 items. Eat a snack first.",
	MAX_RETAIL="Your stores are fully upgraded.",
	CAR_OCCUPIED="Leave your current car before collecting another.",
	PLAYER_OFFLINE="This player is no longer on the server.",
	PROJECT_ACTIVE="A project is already using your compute.",
	PROJECT_LIMIT="Your studio has reached its 30-project limit.",
	PROJECT_NOT_READY="Wait for this project to finish building.",
	PROJECT_QUALITY="This project does not meet the client quality requirement.",
	NO_PROJECT_MODEL="Train a model or buy an active AI subscription first.",
	ARENA_ACTIVE="Your model is already running a test.",
	ARENA_BUSY="All three courier courses are in use. Try again shortly.",
	MAX_COOLING="Your cooling system is fully upgraded.",
	RATE_LIMIT = "Slow down a little.",
	LOADING = "Still loading your company...",
	SERVER_ERROR = "Something went wrong on the server. Try again.",
	NETWORK = "Connection problem. Try again.",
	NO_COMPANY = "Found your company first.",
	ALREADY_FOUNDED = "Your company already exists.",
	NAME_FILTERED = "That name isn't allowed. Try another one.",
	FILTER_DOWN = "Name check is unavailable right now. Try again in a moment.",
	BAD_INPUT = "That didn't work. Check your input.",
	NO_MONEY = "Not enough money.",
	COOLDOWN = "The scraper is cooling down.",
	RACK_FULL = "Your server rack is full. Move to a bigger office or research Distributed Cluster.",
	NEW_DATA = "Add at least 100M new tokens before another refinement run.",
	QUOTE_CHANGED = "The offer changed. Check the new monthly price and try again.",
	SELF_PURCHASE = "This is your own model. Publish it to find customers.",
	ACCESS_ACTIVE = "You already have an active API subscription.",
	SELLER_OFFLINE = "The provider must be on this server to buy or renew access.",
	NOT_OWNED = "You don't own that.",
	TRAINING_ACTIVE = "A training run is already in progress.",
	NO_GPU = "You need a GPU to train.",
	VRAM = "Not enough VRAM for this model size. Open Hardware or choose a smaller model size.",
	NO_DATA = "Not enough training data.",
	NO_EVENT = "There is nothing to decide right now.",
	BAD_MODEL = "That model isn't available.",
	NOT_ALLOWED = "Debug tools only work in Studio.",
	NO_TRAINING = "No training is running.",
	STAFF_FULL = "All desks are filled. Upgrade your office or dismiss an employee.",
	ALREADY_DONE = "This reward has already been collected or this upgrade is complete.",
	RESEARCH_ACTIVE = "One research project is already running.",
	PREREQUISITE = "Finish the required research first.",
	NO_POINTS = "Not enough research points. Hire researchers to generate more.",
	MAX_OFFICE = "You already own the largest office.",
	NOT_READY = "Complete this milestone first.",
	OFFICE_REQUIRED = "This customer requires a larger office.",
	CONTRACT_REQUIREMENTS = "Your live model does not meet this contract's requirements.",
	MODEL_LIMIT = "Your company reached the limit of 80 active models. Retire old models first.",
	-- CORE_SPEC 11.8 (company economy)
	FIRST_CLIENT = "Sign your first business client before you leave the garage.",
	LINE_LIMIT = "All product lines of this office are taken. Release a new version into a live line, or move to a bigger office for another line.",
	REFINE_LIMIT = "This model was already refined 3 times. Train a new version instead.",
	MAX_LEVEL = "The Lab is at its highest level.",
	OWNED = "You already own this.",
	OFFICE = "This needs a bigger office stage. Move up in Company → Office.",
	NO_MEETING = "No meeting with this client is scheduled right now.",
	TOO_FAR = "Go to the client's office to join the meeting.",
	NEEDS_PASS = "This car comes with the Executive Limousine game pass.",
}

local busy: { [string]: boolean } = {}

function ActionController.message(err: string?): string
	if err == "BAD_NAME" then
		return `Company names need {GameConfig.COMPANY_NAME_MIN}-{GameConfig.COMPANY_NAME_MAX} characters, model names {GameConfig.MODEL_NAME_MIN}-{GameConfig.MODEL_NAME_MAX}. No invisible symbols.`
	end
	return if err and MESSAGES[err] then MESSAGES[err] else "Something went wrong."
end

-- Ruft ein Remote auf. Gibt (ok, Antwort) zurück. silent = keine Fehler-Toasts.
function ActionController.call(name: string, payload: { [string]: any }?, silent: boolean?): (boolean, Result)
	if busy[name] then
		return false, { ok = false, err = "BUSY" }
	end
	busy[name] = true
	local remote = Net.getFunction(name)
	local ok, result = pcall(function(): any
		return remote:InvokeServer(payload or {})
	end)
	busy[name] = nil

	if not ok or typeof(result) ~= "table" then
		if not silent then
			Toast.show("error", MESSAGES.NETWORK)
		end
		return false, { ok = false, err = "NETWORK" }
	end
	local response: Result = result
	if response.ok ~= true then
		if not silent then
			Toast.show("error", ActionController.message(response.err))
		end
		return false, response
	end
	return true, response
end

return ActionController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">StateController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Hält den letzten Snapshot vom Server und verteilt Änderungen an die UI.
-- Zwischen zwei Snapshots (0.5-1 s) rechnet der Client Geld und Trainingsfortschritt mit denselben
-- Formeln weiter, damit Zahlen flüssig laufen. Wahrheit bleibt immer der Server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ModelMath = require(ReplicatedStorage.Shared.ModelMath)
local EmpireMath = require(ReplicatedStorage.Shared.EmpireMath)
local Workforce=require(ReplicatedStorage.Shared.WorkforceMath)
local StatePatch = require(ReplicatedStorage.Shared.StatePatch)

local StateController = {}

StateController.snapshot = nil :: Types.Snapshot?
StateController.receivedAt = 0

-- Auswahl im Lab, die auch DATA/COMPUTE für ihre Vorschau nutzen
StateController.ui = {
	sizeId = "s100m",
	focusId = "balanced",
	recipeId = "steady",
}

local changeListeners: { (Types.Snapshot) -&gt; () } = {}
local notifyListeners: { (string, { [string]: any }) -&gt; () } = {}
local uiListeners: { () -&gt; () } = {}

local MAX_EXTRAPOLATE = 3 -- Sekunden; danach lieber stehen bleiben als raten

local function safeCall(label: string, fn: () -&gt; ())
	local ok, err = pcall(fn :: () -&gt; any)
	if not ok then
		warn(`[State] {label}: {err}`)
	end
end

-- State updates (SessionService): the first message and every RequestState answer are FULL
-- snapshots; regular updates are DELTAS (StatePatch) against the snapshot numbered `base`. We rebuild a
-- complete snapshot from them, so StateController.snapshot always looks like a full snapshot.
-- A delta whose base we don't have (missed message, out of order) is kept and the full state is fetched
-- once; buffered deltas that continue the full snapshot's chain are applied afterwards.
local seq: number? = nil -- seq of StateController.snapshot (nil = unknown, e.g. a snapshot without seq)
local pending: { Types.StateDelta } = {}
local MAX_PENDING = 20
local fullPending = false

local function publish(snapshot: Types.Snapshot)
	StateController.snapshot = snapshot
	Workforce.set(snapshot.data.empire, snapshot.live.workforce)
	StateController.receivedAt = os.clock()
	for _, listener in changeListeners do
		safeCall("onChange", function()
			listener(snapshot)
		end)
	end
end

local function patched(current: Types.Snapshot, delta: Types.StateDelta): Types.Snapshot
	local root = StatePatch.apply({ data = current.data, live = current.live }, delta.patch :: any)
	return {
		seq = delta.seq,
		saveEnabled = delta.saveEnabled,
		serverTime = delta.serverTime,
		data = root.data,
		live = root.live,
	}
end

-- Applies buffered deltas that continue the current chain (drops the ones already covered)
local function drain(snapshot: Types.Snapshot): Types.Snapshot
	table.sort(pending, function(a, b)
		return a.seq &lt; b.seq
	end)
	local kept: { Types.StateDelta } = {}
	for _, delta in pending do
		if seq ~= nil and delta.base == seq then
			snapshot = patched(snapshot, delta)
			seq = delta.seq
		elseif seq == nil or delta.seq &gt; seq then
			table.insert(kept, delta)
		end
	end
	pending = kept
	return snapshot
end

local receiveFull: (Types.Snapshot) -&gt; ()

local function requestFull()
	if fullPending then
		return
	end
	fullPending = true
	task.spawn(function()
		local ok, result = pcall(function(): any
			return Net.getFunction("RequestState"):InvokeServer({})
		end)
		fullPending = false
		if ok and typeof(result) == "table" and result.ok == true and typeof(result.state) == "table" then
			receiveFull(result.state :: Types.Snapshot)
		end
	end)
end

receiveFull = function(snapshot: Types.Snapshot)
	local number = snapshot.seq
	if typeof(number) == "number" then
		if seq ~= nil and StateController.snapshot ~= nil and number &lt;= seq then
			return -- older than what we already show
		end
		seq = number
	else
		seq = nil -- snapshot without numbering: deltas cannot continue it
		table.clear(pending)
	end
	publish(drain(snapshot))
	if #pending &gt; 0 then
		requestFull() -- still a gap after this full snapshot
	end
end

local function receiveDelta(delta: Types.StateDelta)
	local current = StateController.snapshot
	if current and seq ~= nil and delta.base == seq then
		local snapshot = patched(current, delta)
		seq = delta.seq
		publish(drain(snapshot))
		return
	end
	if seq ~= nil and delta.seq &lt;= seq then
		return -- already covered (duplicate / older than the last full snapshot)
	end
	table.insert(pending, delta)
	if #pending &gt; MAX_PENDING then
		table.remove(pending, 1)
	end
	requestFull()
end

local function receive(message: any)
	if typeof(message) ~= "table" then
		return
	end
	if typeof(message.patch) == "table" and typeof(message.seq) == "number" and typeof(message.base) == "number" then
		receiveDelta(message :: Types.StateDelta)
	elseif typeof(message.data) == "table" and typeof(message.live) == "table" then
		receiveFull(message :: Types.Snapshot)
	end
end

function StateController.onChange(listener: (Types.Snapshot) -&gt; ())
	table.insert(changeListeners, listener)
	local current = StateController.snapshot
	if current then
		safeCall("onChange", function()
			listener(current)
		end)
	end
end

function StateController.onNotify(listener: (string, { [string]: any }) -&gt; ())
	table.insert(notifyListeners, listener)
end

function StateController.onUiChange(listener: () -&gt; ())
	table.insert(uiListeners, listener)
end

function StateController.setSelection(sizeId: string, focusId: string)
	local ui = StateController.ui
	if ui.sizeId == sizeId and ui.focusId == focusId then
		return
	end
	ui.sizeId = sizeId
	ui.focusId = focusId
	for _, listener in uiListeners do
		safeCall("onUiChange", listener)
	end
end

function StateController.setRecipe(id: string)
	StateController.ui.recipeId=id
	for _,fn in uiListeners do safeCall("UI recipe",fn) end
end

function StateController.elapsed(): number
	return math.min(MAX_EXTRAPOLATE, os.clock() - StateController.receivedAt)
end

-- Geld inkl. laufender Einnahmen seit dem letzten Snapshot
function StateController.money(): number
	local snapshot = StateController.snapshot
	if not snapshot then
		return 0
	end
	return snapshot.data.money + (snapshot.live.revenue - snapshot.live.cost) * StateController.elapsed()
end

-- (erledigte Arbeit, Gesamtarbeit) mit Vorhersage; pausiert bei offener Entscheidung
function StateController.trainingWork(): (number, number)
	local snapshot = StateController.snapshot
	local training = if snapshot then snapshot.data.training else nil
	if not snapshot or not training then
		return 0, 1
	end
	local event = training.event
	if event and event.pending then
		return training.workDone, training.workTotal
	end
	local rate = EmpireMath.trainingRate(snapshot.data.gpus, training.workTotal, snapshot.data.empire)
	return math.min(training.workTotal, training.workDone + rate * StateController.elapsed()), training.workTotal
end

-- Restsekunden des laufenden Trainings
function StateController.trainingEta(): number
	local snapshot = StateController.snapshot
	local training = if snapshot then snapshot.data.training else nil
	if not snapshot or not training then
		return 0
	end
	local done, total = StateController.trainingWork()
	local rate = EmpireMath.trainingRate(snapshot.data.gpus, training.workTotal, snapshot.data.empire)
	return if rate &gt; 0 then (total - done) / rate else 0
end

function StateController.init()
	Net.getEvent("State").OnClientEvent:Connect(receive)
	Net.getEvent("Notify").OnClientEvent:Connect(function(kind: any, payload: any)
		if typeof(kind) ~= "string" then
			return
		end
		local data: { [string]: any } = if typeof(payload) == "table" then payload else {}
		for _, listener in notifyListeners do
			safeCall("onNotify " .. kind, function()
				listener(kind, data)
			end)
		end
	end)

	-- Erster Stand aktiv anfragen (falls das erste State-Event vor unserem Listener kam)
	task.spawn(function()
		local requestState = Net.getFunction("RequestState")
		for attempt = 1, 60 do
			if StateController.snapshot then
				return
			end
			local ok, result = pcall(function(): any
				return requestState:InvokeServer({})
			end)
			if ok and typeof(result) == "table" and result.ok == true and typeof(result.state) == "table" then
				receiveFull(result.state :: Types.Snapshot) -- ignored if a newer State event came first
				return
			end
			task.wait(math.min(2, 0.5 * attempt))
		end
	end)
end

return StateController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">WorldController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Connection to the 3D world:
--   - Owner prompts (OwnerUserId) are shown only to that owner; Public prompts to everyone.
--     A Public prompt marked OwnerOnly is shown only inside the local player's own office.
--   - An owner prompt with an App attribute opens the company computer (optional Section).
--   (GPU blades breathing while the office trains moved to PropFxController: PropFx kind "breathe".)

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local State = require(script.Parent.StateController)

local WorldController = {}

local player = Players.LocalPlayer

local function isOwn(prompt: ProximityPrompt): boolean
	if prompt:GetAttribute("OwnerUserId") == player.UserId then
		return true
	end
	if prompt:GetAttribute("Public") ~= true then
		return false
	end
	if prompt:GetAttribute("OwnerOnly") == true then
		-- The server enforces ownership; locally we only hide the prompt in other companies' buildings.
		local office = prompt:FindFirstAncestor("Office")
		local owner = if office then office:GetAttribute("OwnerUserId") else nil
		return owner == nil or owner == player.UserId
	end
	return true
end

local function setupPrompt(inst: Instance)
	if inst:IsA("ProximityPrompt") then
		inst.Enabled = isOwn(inst)
	end
end

function WorldController.init(openComputer: (string?, string?) -&gt; ())
	State.onNotify(function(kind, payload)
		if kind == "OWNER_COMPUTER" and typeof(payload.app) == "string" then
			openComputer(payload.app, if typeof(payload.section) == "string" then payload.section else nil)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who == player and isOwn(prompt) then
			local app = prompt:GetAttribute("App")
			local section = prompt:GetAttribute("Section")
			if typeof(app) == "string" then
				openComputer(app, if typeof(section) == "string" then section else nil)
			end
		end
	end)

	task.spawn(function()
		for _, inst in workspace:GetDescendants() do
			setupPrompt(inst)
		end
		workspace.DescendantAdded:Connect(setupPrompt)
	end)
end

return WorldController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000001"><Properties><string name="Name">JourneyController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- One small physical marker, only on the owner's current destination. No giant simulator arrows.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Collection=game:GetService("CollectionService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Journey=require(ReplicatedStorage.Shared.JourneyMath)
local State=require(script.Parent.StateController)
local Controller={};local marker: BillboardGui?=nil;local clock=0
function Controller.init()
 RunService.Heartbeat:Connect(function(dt)
  clock+=dt;if clock&lt;1 then return end;clock=0
  local snapshot=State.snapshot;local camera=workspace.CurrentCamera
  if not snapshot or not snapshot.data.company or not camera then return end
  local progress=Journey.progress(snapshot.data,State.ui);local best=nil;local min=math.huge
  if not progress.complete then for _,p in Collection:GetTagged("CompanyScreen") do
   if p:IsA("BasePart") and p:GetAttribute("JourneyStep")==progress.index then
    local office=p:FindFirstAncestor("Office")
    if office and office:GetAttribute("OwnerUserId")==Players.LocalPlayer.UserId then
     local d=(p.Position-camera.CFrame.Position).Magnitude;if d&lt;min then best=p;min=d end
    end
   end
  end end
  if marker and (not best or marker.Adornee~=best) then marker:Destroy();marker=nil end
  if best and not marker then
   local gui=Instance.new("BillboardGui");gui.Name="FirstAIWaypoint";gui.Adornee=best;gui.Size=UDim2.fromOffset(160,26);gui.StudsOffset=Vector3.new(0,3,0);gui.MaxDistance=80;gui.AlwaysOnTop=false;gui.Parent=best
   local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundColor3=Color3.fromRGB(42,55,47);t.BackgroundTransparency=.15;t.TextColor3=Color3.fromRGB(226,235,216);t.TextSize=12;t.Font=Enum.Font.BuilderSansMedium;t.Text=progress.index.." / 7 · "..progress.step.label;t.Parent=gui;marker=gui
  end
 end)
end
return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000005"><Properties><string name="Name">EmployeeController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Local procedural Motor6D poses and held items; never moves an employee's world position.
-- Honest limits: the rigs are R6 with exactly six joints (two shoulders, two hips, Neck, RootJoint).
-- There are NO elbows and NO wrists, so stirring, chopping, wiping or writing read as whole-arm swings
-- and circles from the shoulder; no animation asset ids are used (none may be invented).
-- Pose source, in order: the rig's `Pose` attribute (job steps, written once per step by the server),
-- else a pose derived from Activity / WorkstationType / sitting (no extra network traffic).
-- Held items come from the rig's `Holding` attribute and are client-only parts welded to the right
-- arm (the mop cart to the root); the founder assistant's server cup (EmployeeCup) is left alone.
local RunService = game:GetService("RunService")
local Collection = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config.EmployeeConfig)
local Controller = {}

type Cache = {
	joints: { [string]: Motor6D },
	parts: { BasePart },
	next: number,
	hidden: boolean,
	holding: string?,
	items: { BasePart },
	meal: { BasePart },
	mealAt: Vector3?,
}
local employees: { [Model]: Cache } = {}
local WORK_STATES: { [string]: boolean } = { WORKING = true, DATA_REVIEW = true, MARKETING = true, MONITOR_TRAINING = true, MODEL_REVIEW = true, RESEARCH = true, SERVER_CHECK = true }
-- Standing poses derived from the station kind (no Pose attribute needed).
local STATION_POSE: { [string]: string } = { Whiteboard = "write", LabBench = "inspect", ServerRack = "reach", Pipeline = "scan", Pickup = "reach" }
local SEATED: { [string]: boolean } = { type = true, cycle = true, row = true, relax = true, eat = true }
local LOOK_LIMIT = math.rad(70) -- head turn towards a conversation partner

local function add(m: Instance)
	if not m:IsA("Model") then
		return
	end
	local joints: { [string]: Motor6D } = {}
	local parts: { BasePart } = {}
	for _, p in m:GetDescendants() do
		if p:IsA("Motor6D") then
			joints[p.Name] = p
		elseif p:IsA("BasePart") then
			table.insert(parts, p)
		end
	end
	employees[m] = { joints = joints, parts = parts, next = 0, hidden = false, holding = nil, items = {}, meal = {}, mealAt = nil }
end

local A = CFrame.Angles
-- Arm angles: x &gt; 0 swings the arm forward/up (1.57 = horizontal, 2.7 = above the head); z moves it out
-- to the side (right arm +z, left arm -z). Hips: x = pi/2 is sitting. Neck: x &lt; 0 looks down, y turns.
local function arms(lx: number, rx: number, lz: number?, rz: number?): (CFrame, CFrame)
	return A(lx, 0, -(lz or 0.04)), A(rx, 0, rz or 0.04)
end

-- Joint transforms for one frame. `pose` (optional) overrides the activity-derived posture; `talking`
-- (rig attribute TalkingTo, TalkService) adds the conversation gesture, `lookYaw` (radians, from TalkFace)
-- turns the head towards the player (clamped by the caller).
function Controller.pose(activity: string, sitting: boolean, walking: boolean, time: number, seed: number, holdingCup: boolean?, pose: string?, talking: boolean?, lookYaw: number?): { [string]: CFrame }
	local t = time + seed * 0.013
	local sway = math.sin(t * 5.3)
	local fidget = math.sin(t * 0.67) * math.sin(t * 0.13)
	local swing = if walking then 0.52 * sway else 0
	local typing = WORK_STATES[activity] == true and activity ~= "SERVER_CHECK" and sitting
	local left = if typing then 1.16 + 0.07 * math.sin(t * 8.3) else -swing
	local right = if typing then 1.2 + 0.06 * math.sin(t * 9.1 + 1.2) else swing
	if typing and math.sin(t * 0.31) &gt; 0.83 then
		left = 0.4
		right = 0.7
	end -- short pauses, not a permanent typing loop
	local lz, rz = 0.04, 0.04
	local hipL = if sitting then math.pi / 2 else swing
	local hipR = if sitting then math.pi / 2 else -swing
	local neckX, neckY = if typing then -0.1 else 0.03 * fidget, 0.11 * fidget
	local lean, bob = if typing then 0.045 else 0.012 * fidget, if walking then 0.035 * math.cos(t * 10.6) else 0
	if activity == "COFFEE_BREAK" or activity == "LUNCH" then
		right = if math.sin(t * 0.7) &gt; 0.7 then 1.9 else 1.1
	end
	if holdingCup and math.sin(t * 0.53) &gt; 0.88 then
		right = 1.9
	end
	if activity == "MEETING" or activity == "TALKING" then
		right = 0.6 + 0.35 * math.sin(t * 1.7)
		left = 0.2 + 0.12 * math.sin(t * 1.2)
	end
	if activity == "SERVER_CHECK" and not pose then
		right = 1.05 + 0.15 * math.sin(t * 0.8)
	end
	if activity == "RESEARCH" and not sitting and not pose then
		right = 1.5 + 0.13 * math.sin(t * 2.4)
	end
	if pose then
		-- job poses (walking legs keep their swing; arm poses replace the arm swing)
		local w = math.sin
		if pose == "type" then
			left, right = 1.16 + 0.07 * w(t * 8.3), 1.2 + 0.06 * w(t * 9.1 + 1.2)
			neckX = -0.1
		elseif pose == "typeStand" then
			left, right = 1.3 + 0.05 * w(t * 8.3), 1.35 + 0.05 * w(t * 9.1 + 1.2)
			neckX = -0.18
		elseif pose == "stir" then
			right, rz = 1.15 + 0.15 * w(t * 4.2), 0.04 + 0.16 * math.cos(t * 4.2)
			left = 0.9
			neckX = -0.25
		elseif pose == "pour" then
			right, left = 1.35 + 0.04 * w(t * 1.3), 0.85
			rz = 0.12
			neckX = -0.2
		elseif pose == "plate" or pose == "carry" then
			local dip = if pose == "plate" then 0.12 * w(t * 2.2) else 0
			left, right = 1.4 + dip, 1.4 + dip
			lz, rz = 0.18, 0.18
			neckX = -0.15
		elseif pose == "chop" then
			right = 1.0 + 0.3 * math.abs(w(t * 9))
			left = 0.95
			neckX = -0.3
		elseif pose == "wash" then
			left, right = 1.0 + 0.12 * w(t * 6), 1.0 + 0.12 * w(t * 6 + math.pi)
			lz, rz = 0.1 + 0.1 * math.cos(t * 6), 0.1 + 0.1 * math.cos(t * 6 + math.pi)
			neckX = -0.3
		elseif pose == "wipe" then
			right, rz = 1.05, 0.05 + 0.35 * w(t * 3.1)
			left = 0.3
			lean, neckX = -0.12, -0.25
		elseif pose == "push" then
			left, right = 1.2, 1.2
			lz, rz = 0.12, 0.12
		elseif pose == "write" then
			right, rz = 1.85 + 0.1 * w(t * 5.0), 0.1 + 0.08 * math.cos(t * 5.0)
			left = 0.1
			neckY = 0.05 * w(t * 0.8)
		elseif pose == "reach" or pose == "plug" then
			right = (if pose == "plug" then 1.15 else 1.6) + 0.06 * w(t * 1.6)
			left = 0.25
			lean = if pose == "plug" then -0.15 else 0
			neckX = if pose == "plug" then -0.3 else -0.08
		elseif pose == "inspect" then
			right, left = 0.9 + 0.08 * w(t * 1.1), 0.5
			neckX, neckY = -0.28, 0.25 * w(t * 0.5)
		elseif pose == "scan" then
			left, right = -0.35, -0.35 -- hands behind the back
			lz, rz = -0.2, -0.2
			neckY = 0.6 * w(t * 0.55)
		elseif pose == "greet" then
			right, rz = 2.7, 0.2 + 0.25 * w(t * 7)
			left = 0
			neckX = 0.05
		elseif pose == "sort" then
			right, rz = 1.25 + 0.2 * w(t * 2.6), 0.1 + 0.25 * w(t * 1.3)
			left = 1.0 + 0.15 * w(t * 2.6 + 1.5)
			neckX = -0.12
		elseif pose == "run" then
			local s = w(t * 11)
			left, right = -0.9 * s, 0.9 * s
			hipL, hipR = 0.8 * s, -0.8 * s
			bob = 0.12 * math.abs(math.cos(t * 11))
		elseif pose == "cycle" then
			local s = w(t * 6)
			hipL, hipR = math.pi / 2 - 0.35 + 0.35 * s, math.pi / 2 - 0.35 - 0.35 * s
			left, right = 1.25, 1.25
			lean = -0.15
		elseif pose == "row" then
			local s = 0.5 + 0.5 * w(t * 2.4)
			hipL = math.pi / 2 - 0.45 * s
			hipR = hipL
			left, right = 1.55 - 0.85 * s, 1.55 - 0.85 * s
			lean = 0.18 * s - 0.12
		elseif pose == "lift" then
			left = 0.15 + 1.3 * math.max(0, w(t * 2.2 + math.pi))
			right = 0.15 + 1.3 * math.max(0, w(t * 2.2))
		elseif pose == "relax" then
			left, right = 0.25, 0.25
			lz, rz = 0.15, 0.15
			neckX, bob = -0.05, 0.02 * w(t * 1.2)
		elseif pose == "eat" then
			right = if w(t * 0.9) &gt; 0.6 then 1.9 else 1.05
			left = 0.9
			neckX = -0.12
		elseif pose == "phone" then
			right, rz = 2.6, 0.5
			left = 0.15
			neckY = 0.15 * w(t * 0.4)
		elseif pose == "present" then
			-- staffops: the Training Lead explains a room / presents at the head of the table (open hand
			-- towards the room, the other hand gesturing, the head turning to the listeners)
			right, rz = 1.35 + 0.18 * w(t * 1.6), 0.55 + 0.1 * w(t * 0.9)
			left = 0.45 + 0.25 * math.max(0, w(t * 1.3 + 2))
			neckY = 0.35 * w(t * 0.45)
		elseif pose == "shower" then
			left, right = 2.6 + 0.1 * w(t * 4), 2.6 + 0.1 * w(t * 4 + 1)
			lz, rz = 0.35, 0.35
			neckX = 0.15
		end
		if SEATED[pose] and not sitting and pose ~= "type" then
			-- a seated pose on a standing rig keeps the legs straight
			if pose ~= "cycle" and pose ~= "row" then
				hipL, hipR = 0, 0
			end
		end
		if walking and pose ~= "run" then
			hipL, hipR = swing, -swing
		end
	end
	if talking then
		-- in a conversation: talking gesture (unless typing at a seated desk) and the head turned to the player
		if not (sitting and (typing or pose == "type")) then
			right, left = 0.6 + 0.35 * math.sin(t * 1.7), 0.2 + 0.12 * math.sin(t * 1.2)
			lz, rz = 0.04, 0.04
		end
		if lookYaw then
			neckX, neckY = 0, lookYaw
		end
	end
	local leftArm, rightArm = arms(left, right, lz, rz)
	return {
		["Left Shoulder"] = leftArm,
		["Right Shoulder"] = rightArm,
		["Left Hip"] = A(hipL, 0, 0),
		["Right Hip"] = A(hipR, 0, 0),
		Neck = A(neckX, neckY, 0),
		RootJoint = CFrame.new(0, bob, 0) * A(lean, 0, 0),
	}
end

-- Derived pose when the server sent none: standing at a whiteboard writes, at a lab bench inspects...
function Controller.derive(activity: string, sitting: boolean, stationType: string?, holding: string?): string?
	if sitting then
		if holding == "meal" then
			return "eat"
		end
		return nil
	end
	if WORK_STATES[activity] and stationType and STATION_POSE[stationType] then
		return STATION_POSE[stationType]
	end
	return nil
end

-- Held item recipes: parts in the hand's frame (Right Arm, hand at y = -1) or the root (mop cart).
type Piece = { size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, cylinder: boolean? }
local rgb = Color3.fromRGB
local UPRIGHT = A(0, 0, math.pi / 2) -- cylinder axis (local X) turned to vertical
local ITEMS: { [string]: { Piece } } = {
	cup = { { size = Vector3.new(0.7, 0.5, 0.5), offset = CFrame.new(0, -0.8, -0.55) * UPRIGHT, color = rgb(232, 228, 214), cylinder = true } },
	snack = { { size = Vector3.new(0.8, 0.3, 0.5), offset = CFrame.new(0, -0.95, -0.5), color = rgb(175, 141, 91) } },
	plate = {
		{ size = Vector3.new(0.1, 1.4, 1.4), offset = CFrame.new(0, -1.05, -0.75) * UPRIGHT, color = rgb(246, 246, 240), cylinder = true },
		{ size = Vector3.new(0.6, 0.25, 0.5), offset = CFrame.new(0, -0.9, -0.75), color = rgb(196, 120, 72) },
	},
	tray = {
		{ size = Vector3.new(2.2, 0.12, 1.5), offset = CFrame.new(-0.45, -1.05, -0.95), color = rgb(198, 168, 120), material = Enum.Material.Wood },
		{ size = Vector3.new(0.1, 1.1, 1.1), offset = CFrame.new(-0.45, -0.95, -0.95) * UPRIGHT, color = rgb(246, 246, 240), cylinder = true },
	},
	pan = { { size = Vector3.new(0.25, 1.2, 1.2), offset = CFrame.new(0, -1.05, -0.9) * UPRIGHT, color = rgb(52, 52, 56), material = Enum.Material.Metal, cylinder = true } },
	spatula = { { size = Vector3.new(0.1, 0.1, 1.2), offset = CFrame.new(0, -1.0, -0.6), color = rgb(60, 60, 64) } },
	knife = { { size = Vector3.new(0.06, 0.12, 1.0), offset = CFrame.new(0, -1.0, -0.55), color = rgb(200, 202, 206), material = Enum.Material.Metal } },
	sponge = { { size = Vector3.new(0.5, 0.3, 0.4), offset = CFrame.new(0, -1.08, -0.2), color = rgb(236, 206, 72) } },
	laptop = { { size = Vector3.new(1.6, 0.1, 1.1), offset = CFrame.new(0, -1.0, -0.6), color = rgb(150, 152, 156), material = Enum.Material.Metal } },
	blade = { { size = Vector3.new(0.3, 1.6, 1.2), offset = CFrame.new(0, -1.25, -0.45), color = rgb(40, 44, 50), material = Enum.Material.Metal } },
	parcel = { { size = Vector3.new(1.2, 0.8, 1.0), offset = CFrame.new(0, -1.05, -0.7), color = rgb(196, 160, 112) } },
	marker = { { size = Vector3.new(0.12, 0.5, 0.12), offset = CFrame.new(0, -1.1, -0.15), color = rgb(40, 90, 170) } },
	badge = { { size = Vector3.new(0.6, 0.05, 0.4), offset = CFrame.new(0, -1.05, -0.3), color = rgb(240, 240, 236) } },
	dumbbell = { { size = Vector3.new(1.0, 0.4, 0.4), offset = CFrame.new(0, -1.05, 0), color = rgb(52, 52, 56), material = Enum.Material.Metal, cylinder = true } },
	keys = { { size = Vector3.new(0.3, 0.1, 0.3), offset = CFrame.new(0, -1.05, -0.2), color = rgb(212, 180, 96), material = Enum.Material.Metal } },
	-- company phone (phone request 4): shown while the "phone" pose runs (calls), dark body + lit screen
	phone = {
		{ size = Vector3.new(0.3, 0.6, 0.08), offset = CFrame.new(0, -1.05, -0.42), color = rgb(20, 22, 24) },
		{ size = Vector3.new(0.26, 0.5, 0.01), offset = CFrame.new(0, -1.05, -0.465), color = rgb(96, 176, 232), material = Enum.Material.Neon },
	},
}
-- Mop cart in front of the torso, on the floor (root frame: floor is ~3 studs below the root).
local CART: { Piece } = {
	{ size = Vector3.new(2.0, 0.3, 2.6), offset = CFrame.new(0, -2.4, -2.6), color = rgb(46, 92, 160) },
	{ size = Vector3.new(1.2, 1.1, 1.2), offset = CFrame.new(0, -1.75, -2.9) * UPRIGHT, color = rgb(232, 186, 50), cylinder = true },
	{ size = Vector3.new(0.12, 2.4, 0.12), offset = CFrame.new(0.6, -1.5, -1.5) * A(0.35, 0, 0), color = rgb(150, 152, 156), material = Enum.Material.Metal },
}

local function buildPiece(piece: Piece, base: BasePart, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = "HeldItem"
	if piece.cylinder then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Size = piece.size
	p.Color = piece.color
	p.Material = piece.material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = base.CFrame * piece.offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
	return p
end

local function clearItems(cache: Cache)
	for _, p in cache.items do
		p:Destroy()
	end
	table.clear(cache.items)
end

-- Client-only held item for `holding` (nil / unknown clears).
function Controller.hold(m: Model, cache: Cache, holding: string?)
	if cache.holding == holding then
		return
	end
	cache.holding = holding
	clearItems(cache)
	if not holding then
		return
	end
	if holding == "mopcart" then
		local root = m.PrimaryPart
		if root then
			for _, piece in CART do
				table.insert(cache.items, buildPiece(piece, root, m))
			end
		end
		return
	end
	local recipe = ITEMS[holding]
	local arm = m:FindFirstChild("Right Arm")
	if recipe and arm and arm:IsA("BasePart") then
		for _, piece in recipe do
			table.insert(cache.items, buildPiece(piece, arm, m))
		end
	end
end

-- Meal on the table in front of a seated employee (TablePoint, world space): anchored local parts.
function Controller.meal(cache: Cache, at: Vector3?)
	if cache.mealAt == at then
		return
	end
	cache.mealAt = at
	for _, p in cache.meal do
		p:Destroy()
	end
	table.clear(cache.meal)
	if not at then
		return
	end
	local folder = workspace:FindFirstChild("PropFxLocal")
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "PropFxLocal"
		f.Parent = workspace
		folder = f
	end
	for i, piece in ITEMS.plate do
		local p = Instance.new("Part")
		p.Name = "MealPlate"
		if piece.cylinder then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Size = piece.size
		p.Color = piece.color
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.CFrame = CFrame.new(at + Vector3.new(0, 0.05 + (i - 1) * 0.15, 0)) * (if piece.cylinder then UPRIGHT else CFrame.identity)
		p.Parent = folder
		table.insert(cache.meal, p)
	end
end

local function drop(m: Model, cache: Cache)
	clearItems(cache)
	Controller.meal(cache, nil)
	employees[m] = nil
end

function Controller.init()
	for _, m in Collection:GetTagged("CompanyEmployee") do
		add(m)
	end
	Collection:GetInstanceAddedSignal("CompanyEmployee"):Connect(add)
	Collection:GetInstanceRemovedSignal("CompanyEmployee"):Connect(function(m)
		local cache = employees[m :: Model]
		if cache then
			drop(m :: Model, cache)
		end
	end)
	RunService.PreSimulation:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local time = workspace:GetServerTimeNow()
		for m, cache in employees do
			local root = m.PrimaryPart
			if not m.Parent or not root then
				drop(m, cache)
				continue
			end
			local distance = (camera.CFrame.Position - root.Position).Magnitude
			local hidden = distance &gt; Config.FAR or m:GetAttribute("OffDuty") == true
			if hidden ~= cache.hidden then
				for _, p in cache.parts do
					if p.Parent then
						p.LocalTransparencyModifier = if hidden then 1 else 0
					end
				end
				for _, p in cache.items do
					p.LocalTransparencyModifier = if hidden then 1 else 0
				end
				cache.hidden = hidden
			end
			if hidden or time &lt; cache.next then
				continue
			end
			cache.next = time + (if distance &lt; Config.NEAR then 1 / 30 else 0.2)
			local activityAttr = m:GetAttribute("Activity")
			local activity: string = if typeof(activityAttr) == "string" then activityAttr else "WORKING"
			local h = m:FindFirstChildOfClass("Humanoid")
			local sitting = h ~= nil and h.SeatPart ~= nil
			local velocity = root.AssemblyLinearVelocity
			local walking = Vector3.new(velocity.X, 0, velocity.Z).Magnitude &gt; 0.5
			local holdingAttr = m:GetAttribute("Holding")
			local holding = if typeof(holdingAttr) == "string" and holdingAttr ~= "" then string.lower(holdingAttr) else nil
			-- a call (pose "phone") shows the company phone in the hand when nothing else is held
			if holding == nil and m:GetAttribute("Pose") == "phone" then
				holding = "phone"
			end
			local serverCup = m:FindFirstChild("EmployeeCup") ~= nil
			Controller.hold(m, cache, if serverCup or holding == "meal" then nil else holding)
			local tablePoint = m:GetAttribute("TablePoint")
			Controller.meal(cache, if holding == "meal" and typeof(tablePoint) == "Vector3" then tablePoint else nil)
			local poseAttr = m:GetAttribute("Pose")
			local stationType = m:GetAttribute("WorkstationType")
			local pose = if typeof(poseAttr) == "string" and poseAttr ~= "" then poseAttr else Controller.derive(activity, sitting, if typeof(stationType) == "string" then stationType else nil, holding)
			local cup = m:GetAttribute("HoldingCup") == true or holding == "cup"
			local seedAttr = m:GetAttribute("PersonalitySeed")
			-- conversation (TalkService): look at TalkFace, clamped to +-70 degrees of the body's facing
			local talking = m:GetAttribute("TalkingTo") ~= nil
			local lookYaw: number? = nil
			local faceAttr = m:GetAttribute("TalkFace")
			if talking and typeof(faceAttr) == "Vector3" and distance &lt; Config.NEAR then
				local d = root.CFrame:PointToObjectSpace(faceAttr)
				if d.X * d.X + d.Z * d.Z &gt; 0.01 then
					lookYaw = math.clamp(math.atan2(-d.X, -d.Z), -LOOK_LIMIT, LOOK_LIMIT)
				end
			end
			local transforms = Controller.pose(activity, sitting, walking, time, if typeof(seedAttr) == "number" then seedAttr else 0, cup, pose, talking, lookYaw)
			for name, transform in transforms do
				local joint = cache.joints[name]
				if joint and joint.Parent then
					joint.Transform = transform
				end
			end
		end
	end)
end

return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000006"><Properties><string name="Name">BuildingEffectsController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Calm building feedback on the client:
--   - A pending training decision turns nearby screen headers a steady amber (a status, not an
--     alarm); the header returns to its accent colour as soon as the decision is made.
--   - One quiet local ambience loop chosen from the BuildingPlan room at the camera position.
-- Fans, blades and every other moving prop are animated by PropFxController (PropFx contract).
local Collection=game:GetService("CollectionService")
local RunService=game:GetService("RunService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusAudioConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local Controller={}
local AMBER=Color3.fromRGB(219,171,88)
local SCREEN_RANGE=120;local VOLUME=.08
local screens: {[BasePart]:boolean}={}
local accents: {[TextLabel]:Color3}=setmetatable({},{__mode="k"}) :: any
local clock=0
local ambience: Sound?=nil;local current=""
local KITCHEN={cafe=true,kitchen_boh=true,pantry=true}
local function add(p: Instance) if p:IsA("BasePart") then screens[p]=true end end
local function header(p: BasePart): TextLabel?
	local gui=p:FindFirstChild("Desktop");local label=if gui then gui:FindFirstChild("Header") else nil
	return if label and label:IsA("TextLabel") then label else nil
end
-- Steady status colour; the accent the server built the header with is remembered and restored.
local function paintHeaders(position: Vector3)
	for p in screens do
		if not p.Parent then screens[p]=nil;continue end
		if (position-p.Position).Magnitude&gt;SCREEN_RANGE then continue end
		local label=header(p);if not label then continue end
		if p:GetAttribute("TrainingAlert")==true then
			if not accents[label] then accents[label]=label.TextColor3 end
			if label.TextColor3~=AMBER then label.TextColor3=AMBER end
		else
			local accent=accents[label]
			if accent then label.TextColor3=accent;accents[label]=nil end
		end
	end
end
-- Ambience key of the room around a world position, or "" outside every headquarters.
local function ambienceAt(position: Vector3): string
	local plots=workspace:FindFirstChild("Plots");if not plots then return "" end
	for _,plot in plots:GetChildren() do
		local office=plot:FindFirstChild("Office")
		local cf=if office then office:GetAttribute("CampusCFrame") else nil
		local tier=if office then office:GetAttribute("OfficeTier") else nil
		if typeof(cf)~="CFrame" or typeof(tier)~="number" then continue end
		local v=cf:PointToObjectSpace(position)
		if not Plan.inside(tier,v) then continue end
		local room=Plan.roomAt(tier,v)
		if not room then return "" end
		if room.kind=="compute" or room.kind=="datahall" then return "compute" end
		if KITCHEN[room.kind] then return "kitchen" end
		if room.kind=="garage" or room.level&lt;0 then return "garage" end
		if Plan.WORK_KINDS[room.kind] then return "office" end
		return ""
	end
	return ""
end
local function setAmbience(kind: string,camera: Camera)
	if current==kind then return end
	if ambience then ambience:Destroy();ambience=nil end;current=kind
	local id=Config.AMBIENCE[kind]
	if id and id~="" then
		local s=Instance.new("Sound");s.Name="CampusAmbience";s.SoundId=id;s.Volume=VOLUME;s.Looped=true;s.Parent=camera;s:Play();ambience=s
	end
end
function Controller.init()
	for _,p in Collection:GetTagged("CompanyScreen") do add(p) end
	Collection:GetInstanceAddedSignal("CompanyScreen"):Connect(add)
	Collection:GetInstanceRemovedSignal("CompanyScreen"):Connect(function(p)screens[p]=nil end)
	RunService.Heartbeat:Connect(function(dt)
		clock+=dt;if clock&lt;.5 then return end;clock=0
		local camera=workspace.CurrentCamera;if not camera then return end
		local position=camera.CFrame.Position
		paintHeaders(position)
		setAmbience(ambienceAt(position),camera)
	end)
end
return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000019"><Properties><string name="Name">SecurityController</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- CCTV uses the actual Roblox world camera, so staff, players, doors and cars are live.
-- Channels are grouped by level; the view stays covered by "Loading area…" until the streamed
-- world around the camera has arrived, so the founder never looks into an empty void.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Context=game:GetService("ContextActionService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local State=require(script.Parent.StateController)
local Action=require(script.Parent.ActionController)
local Theme=require(script.Parent.Parent.UI.Theme)
local Kit=require(script.Parent.Parent.UI.Kit)
local Controller={}
local player=Players.LocalPlayer
local LOCK="🔒"
local LOAD_RADIUS=20;local LOAD_TIMEOUT=6
type Channel={id: string,name: string,cframe: CFrame,level: number?,private: boolean}
local gui: ScreenGui?=nil
local old: any=nil
local target: CFrame?=nil
local channels: {Channel}={}
local selected=1
local title: TextLabel?=nil
local loading: Frame?=nil
local currentOwner: number?=nil
local token=0
local deathConn: RBXScriptConnection?=nil
local function tier(): number
	local snapshot=State.snapshot
	-- building tier of the own plot (office index 1 = Garage Lab = plan tier 0, CORE_SPEC 2.4)
	return Plan.tierForOffice(if snapshot then snapshot.data.empire.office else 1)
end
local function levelTitle(level: number?): string
	return if level then Plan.floorTitle(tier(),level) else "Other views"
end
function Controller.close()
	token+=1
	if gui then gui:Destroy();gui=nil end
	if deathConn then deathConn:Disconnect();deathConn=nil end
	title=nil;loading=nil;target=nil;currentOwner=nil;Context:UnbindAction("CampusCameraControls")
	local camera=workspace.CurrentCamera
	if camera and old then
		camera.CameraType=old.kind;camera.CFrame=old.cf;camera.FieldOfView=old.fov
		-- After a respawn the old subject is a dead humanoid; the new one (or the default camera
		-- scripts once it exists) takes over instead.
		local h=if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
		if h then camera.CameraSubject=h end
	end
	old=nil
end
-- True once anything other than the local character exists around the camera position.
local function areaReady(position: Vector3): boolean
	local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.MaxParts=1
	params.FilterDescendantsInstances=if player.Character then {player.Character} else {}
	return #workspace:GetPartBoundsInRadius(position,LOAD_RADIUS,params)&gt;0
end
local function setLoading(visible: boolean)
	if loading then loading.Visible=visible end
end
local function selectChannel(index: number)
	if #channels==0 then return end
	selected=(index-1)%#channels+1
	local def=channels[selected];target=def.cframe;token+=1;local mine=token
	local label=title
	if label then label.Text=string.format("%02d / %02d   %s%s   ·   %s",selected,#channels,if def.private then LOCK.." " else "",def.name,levelTitle(def.level)) end
	local position=def.cframe.Position
	setLoading(not areaReady(position))
	task.spawn(function()
		pcall(function() player:RequestStreamAroundAsync(position,3) end)
		local deadline=os.clock()+LOAD_TIMEOUT
		while mine==token and not areaReady(position) and os.clock()&lt;deadline do task.wait(.25) end
		if mine==token then setLoading(false) end
	end)
end
local function clean(payload: any): {Channel}
	local out: {Channel}={}
	for i,c in payload.channels do
		if typeof(c)~="table" or typeof(c.cframe)~="CFrame" or typeof(c.name)~="string" then continue end
		local level=c.level;if level==nil then level=c.Level end
		local private=c.private;if private==nil then private=c.Private end
		table.insert(out,{id=if typeof(c.id)=="string" then c.id else tostring(i),name=c.name,cframe=c.cframe,level=if typeof(level)=="number" then level else nil,private=private==true})
	end
	-- Top floor first, like a building directory; unknown levels last. Server order within a level.
	local order: {[Channel]:number}={};for i,c in out do order[c]=i end
	table.sort(out,function(a,b)
