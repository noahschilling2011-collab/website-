local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local ModelMath=require(Shared.ModelMath)
local MarketMath=require(Shared.MarketMath)
local ModelConfig=require(Shared.Config.ModelConfig)
local Hardware=require(Shared.Config.HardwareConfig)
local StudioMath=require(Shared.StudioMath)
local Template=require(script.Parent.Parent.Lib.Template)
local Economy=require(script.Parent.EconomyService)
local NPC={sessions={} :: {any},activities={} :: {any}}
-- Server-independent NPC band (CORE_SPEC 3.1): every server meets the same three rival labs.
NPC.NPC_BOOST=1.2
NPC.NPC_CAP=64
NPC.API_FLOOR=1.0
local elapsed=0
local signs: {[number]:TextLabel}={}
local identities={{id=-100000001,name="Morrow Labs",focus="coding",color={126,155,177}},
	{id=-100000002,name="Fern Intelligence",focus="balanced",color={139,166,131}},
	{id=-100000003,name="Kiln Research",focus="reasoning",color={189,141,108}}}
local function note(s: any,text: string)
	s.activity=text
	table.insert(NPC.activities,1,{company=s.data.company.name,text=text,time=workspace:GetServerTimeNow()})
	while #NPC.activities&gt;12 do table.remove(NPC.activities) end
end
local function part(parent: Instance,name: string,size: Vector3,position: Vector3,color: Color3): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;position=Vector3.new(position.X-115,position.Y+24,position.Z-500);p.Position=position;p.CFrame=CFrame.new(position.X,position.Y,position.Z);p.Anchored=true
	p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function office(s: any,index: number)
	local root=workspace:FindFirstChild("RivalQuarter")
	if not root then root=Instance.new("Folder");root.Name="RivalQuarter";root.Parent=workspace end
	local m=Instance.new("Model");m.Name=s.data.company.name;m.Parent=root
	local x=60+(index-1)*55
	local stone=Color3.fromRGB(186,184,169);local dark=Color3.fromRGB(39,51,49);local accent=Color3.fromRGB(unpack(s.rgb))
	part(m,"Foundation",Vector3.new(42,1,34),Vector3.new(x,.6,-148),stone)
	part(m,"Facade",Vector3.new(38,14,1),Vector3.new(x,8,-163),dark)
	part(m,"Roof",Vector3.new(42,1,34),Vector3.new(x,15,-148),stone)
	for _, dx in {-19,19} do part(m,"Column",Vector3.new(1.2,14,32),Vector3.new(x+dx,8,-148),stone) end
	part(m,"SignBand",Vector3.new(36,2,.3),Vector3.new(x,12,-130.5),accent)
	local board=part(m,"CompanyBoard",Vector3.new(30,5,.3),Vector3.new(x,8,-130.3),dark)
	local gui=Instance.new("SurfaceGui");gui.Name="CompanyPrint";gui.Face=Enum.NormalId.Front;gui.PixelsPerStud=28;gui.Parent=board
	local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.TextColor3=Color3.fromRGB(239,235,220);text.Font=Enum.Font.BuilderSansBold;text.TextSize=23;text.TextWrapped=true;text.Text=s.data.company.name;text.Parent=gui;signs[s.userId]=text
	board.CFrame=board.CFrame*CFrame.Angles(0,math.pi,0)
	for unit=1,2 do
		part(m,"RoofVent",Vector3.new(5,.7,4),Vector3.new(x-8+(unit-1)*15,15.9,-152),dark)
		for slat=1,4 do part(m,"VentSlat",Vector3.new(.35,.15,3.5),Vector3.new(x-10+(unit-1)*15+slat*.8,16.3,-152),stone) end
	end
	part(m,"EntryPath",Vector3.new(38,.25,9),Vector3.new(x,.85,-126),Color3.fromRGB(163,172,152))
	for planter=1,2 do
		local px=x-15+(planter-1)*30
		part(m,"Planter",Vector3.new(3,1.4,3),Vector3.new(px,1.5,-126),Color3.fromRGB(147,112,83))
		part(m,"Foliage",Vector3.new(3.8,2.5,3.8),Vector3.new(px,3.2,-126),Color3.fromRGB(99,135,91))
	end
	for slat=1,6 do part(m,"TimberScreen",Vector3.new(.55,5,.5),Vector3.new(x-17+slat,4,-131),Color3.fromRGB(166,128,88)) end
	local light=part(m,"EntryLight",Vector3.new(4,.25,.3),Vector3.new(x,11,-130),Color3.fromRGB(221,199,151));light.Material=Enum.Material.Neon
	local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Inspect rival";prompt.ObjectText=s.data.company.name;prompt.MaxActivationDistance=10;prompt:SetAttribute("Public",true);prompt:SetAttribute("App","arena");prompt.Parent=board
	for desk=1,3 do
		part(m,"Worktable",Vector3.new(8,.5,4),Vector3.new(x-13+(desk-1)*13,3,-151),Color3.fromRGB(162,125,91))
		part(m,"Screen",Vector3.new(3.6,2.3,.25),Vector3.new(x-13+(desk-1)*13,4.5,-152),dark)
		part(m,"Rack",Vector3.new(3,8,3),Vector3.new(x-13+(desk-1)*13,4.8,-159),dark)
		for blade=1,5 do part(m,"ServerFace",Vector3.new(2.5,.5,.25),Vector3.new(x-13+(desk-1)*13,1.5+blade,-157.3),accent) end
	end
end
function NPC.init()
	if #NPC.sessions&gt;0 then return end
	for i,def in identities do
		local d=Template.new();d.company={name=def.name,logo="N",color="mint",spec="general",reputation=15,foundedAt=os.time()}
		d.money=25000+i*5000;d.gpus={workstation=1};d.data={general={tokens=3e9,quality=.7},code={tokens=1e9,quality=.8}}
		d.empire.office=3 -- stage 3 (Startup Campus): 12 GPU slots, thermal 40 (CORE_SPEC 2.4)
		local stats,overall=ModelMath.computeStats("s500m",def.focus,ModelMath.dataSummary(d.data),"general",1,nil)
		-- NPC band (CORE_SPEC 3.1): start at the s500m stats x NPC_BOOST, never above NPC_CAP per stat; never reads players
		for _,st in ModelConfig.STATS do if st.weight&gt;0 and st.id~="reliability" then stats[st.id]=math.min(NPC.NPC_CAP,math.round(stats[st.id]*NPC.NPC_BOOST*10)/10) end end;overall=ModelMath.overall(stats)
		local id="npc"..tostring(i)
		d.models[id]={id=id,name=({"Morrow Code","Fern One","Kiln Logic"})[i],version=1,sizeId="s500m",focusId=def.focus,status="live",createdAt=os.time(),trainedAt=os.time(),stats=stats,overall=overall,trainCost=0,dataUsed=ModelMath.dataSummary(d.data),release={subPrice=10,apiPrice=1.5,marketing=0,target="general",releasedAt=os.time()},market=MarketMath.newMarketState("general",0)}
		d.modelOrder={id};d.stats.bestOverall=overall
		local s={userId=def.id,data=d,player={Name=def.name},closed=false,live={revenue=0,cost=0,users=0,perModel={},npcUsers={}},rgb=def.color,focus=def.focus,index=i,iteration=0,pending=nil,activity="Opened the lab",isNPC=true}
		Economy.spend(s,900)
		s.portfolio={id="npc-site-"..tostring(i),name=def.name,kind="website",style=({"paper","slate","brick"})[i],status="published",quality=StudioMath.quality(stats,{stat="coding"}),content=StudioMath.content(def.name,"website",nil),modelName=d.models[id].name,providerId=s.userId}
		table.insert(NPC.sessions,s);office(s,i);note(s,"Opened a self-funded lab")
	end
end
function NPC.tick(dt: number)
	elapsed+=dt
	for _, s in NPC.sessions do
		local d=s.data;local m=d.models[d.modelOrder[1]]
		local pending=s.pending
		if pending then
			pending.remaining-=dt*ModelMath.fleet(d.gpus).throughput
			if pending.remaining&lt;=0 then
				for _,stat in ModelConfig.STATS do
					if stat.weight&gt;0 and stat.id~="reliability" then m.stats[stat.id]=math.min(NPC.NPC_CAP,m.stats[stat.id]+(2+6*pending.quality)/math.sqrt(1+s.iteration)) end
				end
				m.overall=ModelMath.overall(m.stats);m.version+=1;m.iterations=(m.iterations or 0)+1;s.iteration+=1;s.pending=nil;d.training=nil
				d.stats.bestOverall=m.overall;note(s,"Released "..m.name.." v"..tostring(m.version).." · "..tostring(m.overall).." pts")
			end
		end
		local label=signs[s.userId]
		if label then label.Text=d.company.name.."\n"..string.format("%.1f intelligence pts  /  %s",m.overall,s.activity) end
	end
	if elapsed&lt;45 then return end
	elapsed=0
	for _,s in NPC.sessions do
		local d=s.data;local m=d.models[d.modelOrder[1]]
		if s.pending then continue end
		local fleet=ModelMath.fleet(d.gpus)
		local desired=if fleet.throughput&lt;12 then Hardware.getGPU("accelerator") else Hardware.getGPU("datacenter")
		if Hardware.thermal(d.empire,fleet.throughput)&lt;.8 and d.empire.infrastructure.cooling&lt;8 and d.money&gt;12000 then
			if Economy.spend(s,8000) then d.empire.infrastructure.cooling+=1;note(s,"Invested in cooling for sustained compute") end
		elseif desired and d.money&gt;desired.price*1.5 and fleet.slotsUsed&lt;Hardware.slots(d.empire) then
			if Economy.spend(s,desired.price) then d.gpus[desired.id]=(d.gpus[desired.id] or 0)+1;note(s,"Bought "..desired.label.." from its operating budget") end
		elseif d.money&gt;6000+(s.iteration*700) then
			local cost=math.floor(2500+s.iteration*900)
			if Economy.spend(s,cost) then
				ModelMath.addTokens(d.data,"code",8e8,.72+.02*math.min(s.iteration,8))
				d.training={npc=true}
				s.pending={remaining=140+s.iteration*60,quality=ModelMath.dataSummary(d.data).quality}
				note(s,"Training a new checkpoint with fresh data")
			end
		elseif not s.portfolio and d.money&gt;1600 then
			Economy.spend(s,900)
			s.portfolio={id="npc-site-"..tostring(s.index),name=d.company.name,kind="website",style=({"paper","slate","brick"})[s.index],status="published",quality=StudioMath.quality(m.stats,{stat="coding"}),content=StudioMath.content(d.company.name,"website",nil),modelName=m.name,providerId=s.userId}
			note(s,"Built its own company website")
		else
			m.release.apiPrice=math.max(NPC.API_FLOOR,m.release.apiPrice-.1)
			note(s,"Adjusted API price to attract customers")
		end
	end
end
return NPC
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000033"><Properties><string name="Name">StudioService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage.Shared
local Config=require(Shared.Config.StudioConfig)
local Math=require(Shared.StudioMath)
local ModelMath=require(Shared.ModelMath)
local GameConfig=require(Shared.Config.GameConfig)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Guard=require(script.Parent.Parent.Lib.Guard)
local TextFilter=require(script.Parent.Parent.Lib.TextFilter)
local Session=require(script.Parent.SessionService)
local Economy=require(script.Parent.EconomyService)
local NPC=require(script.Parent.NPCService)
local Service={gallery={} :: {any}}
-- CORE_SPEC 3.4: briefs pay once per brief per game day of play (empire.seconds / 1200), reward x STUDIO_SCALE
Service.STUDIO_SCALE=0.5
Service.DAY=1200
local function reward(brief: any): number return math.floor(brief.reward*Service.STUDIO_SCALE) end
local function source(data: any,modelId: any): (any,string?)
	if modelId=="licensed" then
		local sub=data.empire.subscriptions
		if not sub.expires or sub.expires&lt;=os.time() then return nil,nil end
		return sub.stats or {coding=sub.score,creativity=sub.score,reliability=60,reasoning=sub.score},sub.name
	end
	local id=Guard.id(modelId);local m=if id then data.models[id] else nil
	-- stall fix: a model retired by a new version hands its projects to the live successor (&lt;= 8 hops)
	local hops=0
	while m and m.status=="retired" and m.replacedBy and hops&lt;8 do m=data.models[m.replacedBy];hops+=1 end
	if not m or (m.status~="trained" and m.status~="live") then return nil,nil end
	return m.stats,m.name
end
local function build(s: any,p: any): any
	local e=s.data.empire
	if e.projectJob then return {ok=false,err="PROJECT_ACTIVE"} end
	if #e.projectOrder&gt;=30 then return {ok=false,err="PROJECT_LIMIT"} end
	local kind=Config.find(Config.KINDS,p.kind);local style=Config.find(Config.STYLES,p.style)
	local title=Guard.text(p.name,3,28)
	local brief=if p.briefId then Config.find(Config.BRIEFS,p.briefId) else nil
	if not kind or not style or not title or (p.briefId and not brief) or (brief and brief.kind~=kind.id) then return {ok=false,err="BAD_INPUT"} end
	local stats,modelName=source(s.data,p.modelId)
	if not stats then return {ok=false,err="NO_PROJECT_MODEL"} end
	local filtered=TextFilter.forBroadcast(title,s.userId)
	if filtered==nil then return {ok=false,err="FILTER_DOWN"} end
	if filtered~=title then return {ok=false,err="NAME_FILTERED"} end
	-- Text filtering yields, so re-check every mutable precondition before charging.
	if s.closed then return {ok=false,err="LOADING"} end
	if e.projectJob then return {ok=false,err="PROJECT_ACTIVE"} end
	if #e.projectOrder&gt;=30 then return {ok=false,err="PROJECT_LIMIT"} end
	stats,modelName=source(s.data,p.modelId)
	if not stats then return {ok=false,err="NO_PROJECT_MODEL"} end
	if not Economy.spend(s,kind.cost,"studio") then return {ok=false,err="NO_MONEY"} end
	local id="project-"..game:GetService("HttpService"):GenerateGUID(false)
	local item={id=id,name=title,kind=kind.id,style=style.id,briefId=if brief then brief.id else nil,
		status="building",quality=Math.quality(stats,kind),content=Math.content(title,kind.id,p.briefId),
		modelName=modelName,sourceId=p.modelId,createdAt=os.time(),visitors=0,revenueTotal=0,delivered=false}
	e.projects[id]=item;table.insert(e.projectOrder,id)
	e.projectJob={id=id,total=kind.work,done=0}
	Session.markDirty(s);return {ok=true,projectId=id}
end
local function project(s: any,p: any): any
	local id=Guard.id(p.projectId)
	return if id then s.data.empire.projects[id] else nil
end
local function publish(s: any,p: any): any
	local item=project(s,p)
	if not item or item.status~="ready" then return {ok=false,err="PROJECT_NOT_READY"} end
	item.status="published";Session.markDirty(s);return {ok=true}
end
local function deliver(s: any,p: any): any
	local item=project(s,p)
	if not item or (item.status~="ready" and item.status~="published") then return {ok=false,err="PROJECT_NOT_READY"} end
	local brief=Config.find(Config.BRIEFS,item.briefId)
	if not brief or item.quality&lt;brief.minimum then return {ok=false,err="PROJECT_QUALITY"} end
	local day=math.floor((tonumber(s.data.empire.seconds) or 0)/Service.DAY)
	if item.delivered or s.data.empire.deliveries[brief.id]==day then return {ok=false,err="ALREADY_DONE"} end
	item.delivered=true;s.data.empire.deliveries[brief.id]=day
	Economy.applyFlow(s,reward(brief),0,"studio");s.data.empire.xp+=100
	Session.markDirty(s);return {ok=true,reward=reward(brief)}
end
local function cancel(s: any,_p: any): any
	local e=s.data.empire
	if not e.projectJob then return {ok=false,err="PROJECT_NOT_READY"} end
	local item=e.projects[e.projectJob.id]
	if item then item.status="cancelled" end
	e.projectJob=nil;Session.markDirty(s);return {ok=true}
end
local function archive(s: any,p: any): any
	local item=project(s,p)
	if not item or item.status=="building" then return {ok=false,err="PROJECT_NOT_READY"} end
	local e=s.data.empire;local index=table.find(e.projectOrder,item.id)
	if index then table.remove(e.projectOrder,index) end
	e.projects[item.id]=nil;Session.markDirty(s);return {ok=true}
end
function Service.tick(s: any,dt: number)
	if not s.data.company then return end
	local e=s.data.empire;local job=e.projectJob
	if job then
		local item=e.projects[job.id]
		if not item then e.projectJob=nil
		else
			local stats=source(s.data,item.sourceId)
			if stats then
				local rate=Math.rate(s.data.gpus,e)*(if s.data.training then 1-e.infrastructure.trainingShare else 1)
				job.done=math.min(job.total,job.done+rate*dt)
				if job.done&gt;=job.total then item.status="ready";e.projectJob=nil;Remote.fire(s.player,"Notify","EMPIRE_NOTICE",{text="Project ready: "..item.name}) end
			end
		end
	end
	local revenue=0
	for _,id in e.projectOrder do
		local item=e.projects[id]
		if item and item.status=="published" then
			local rate=math.max(0,item.quality-20)*2/GameConfig.GAME_MONTH_SECONDS
			item.visitors+=item.quality*dt/30;item.revenueTotal+=rate*dt;revenue+=rate
		end
	end
	if revenue&gt;0 then Economy.applyFlow(s,revenue*dt,0,"studio");s.live.revenue+=revenue end
	Session.markDirty(s)
end
function Service.refresh()
	local list={}
	for _, s in Session.all() do
		if not s.closed and s.data.company then
			for _, id in s.data.empire.projectOrder do
				local item=s.data.empire.projects[id]
				if item and item.status=="published" then local copy=table.clone(item);copy.company=s.data.company.name;copy.providerId=s.userId;table.insert(list,copy) end
			end
		end
	end
	for _, s in NPC.sessions do
		if s.portfolio then local copy=table.clone(s.portfolio);copy.company=s.data.company.name;table.insert(list,copy) end
	end
	while #list&gt;36 do table.remove(list) end
	Service.gallery=list
	for _, s in Session.all() do s.live.studio={gallery=list} end
end
function Service.init()
	local limit={burst=2,perSecond=.5,company=true}
	Remote.bind("BuildProject",limit,build);Remote.bind("CancelProject",limit,cancel);Remote.bind("ArchiveProject",limit,archive);Remote.bind("PublishProject",limit,publish);Remote.bind("DeliverProject",limit,deliver)
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000034"><Properties><string name="Name">ArenaService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Math=require(ReplicatedStorage.Shared.ArenaMath)
local Remote=require(script.Parent.Parent.Lib.Remote)
local Guard=require(script.Parent.Parent.Lib.Guard)
local Session=require(script.Parent.SessionService)
local NPC=require(script.Parent.NPCService)
local Arena={runs={} :: {[number]:any}}
local lanes={} :: {any}
local function part(parent: Instance,name: string,size: Vector3,x: number,y: number,z: number,color: Color3): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=CFrame.new(x-840,y+24,z);p.Anchored=true;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function pose(lane: any,cell: any,robot: Model?)
	local x=lane.x+(cell.x-5)*4;local z=lane.z+(cell.z-4)*4
	for _, p in (robot or lane.robot):GetChildren() do
		if p:IsA("BasePart") then local offset=p:GetAttribute("Offset");p.CFrame=CFrame.new(x-840,24,z)*CFrame.Angles(0,cell.yaw or 0,0)*CFrame.new(offset.X,offset.Y,offset.Z) end
	end
end
local function makeRobot(parent: Instance,color: Color3): Model
	local robot=Instance.new("Model");robot.Name="CourierRobot";robot.Parent=parent
	for _,def in {{"Body",2.2,2.4,1.5,0,2.2,0},{"Head",2,1.3,1.4,0,4.1,0},{"EyeL",.3,.25,.08,-.5,4.2,-.73},{"EyeR",.3,.25,.08,.5,4.2,-.73},{"LegL",.7,1.1,.8,-.65,.65,0},{"LegR",.7,1.1,.8,.65,.65,0},{"Package",1.6,1.2,1,0,2,-1.2}} do
		local c=if string.sub(def[1],1,3)=="Eye" then Color3.fromRGB(241,232,208) elseif def[1]=="Package" then Color3.fromRGB(173,128,84) else color
		local p=part(robot,def[1],Vector3.new(def[2],def[3],def[4]),def[5],def[6],def[7],c);p.CanCollide=false;p:SetAttribute("Offset",Vector3.new(def[5],def[6]+.8,def[7]))
	end
	return robot
end
local function run(s: any,p: any): any
	if Arena.runs[s.userId] then return {ok=false,err="ARENA_ACTIVE"} end
	local id=Guard.id(p.modelId);local model=if id then s.data.models[id] else nil
	if not model or (model.status~="trained" and model.status~="live") then return {ok=false,err="BAD_MODEL"} end
	local lane:any=nil
	for _, candidate in lanes do if not candidate.owner then lane=candidate;break end end
	if not lane then return {ok=false,err="ARENA_BUSY"} end
	local plan=Math.route(model.stats,#s.data.empire.arenaHistory+1)
	local peer=NPC.sessions[(#s.data.empire.arenaHistory%math.max(1,#NPC.sessions))+1]
	local rival=if peer then peer.data.models[peer.data.modelOrder[1]] else nil
	local opponent=if rival then {name=peer.data.company.name,score=Math.route(rival.stats,1).score} else {name="House courier",score=130}
	local rivalPlan=Math.route(if rival then rival.stats else {reasoning=35,coding=35,reliability=50,speed=50},1)
	local active={lane=lane,plan=plan,rivalPlan=rivalPlan,duration=math.max(plan.seconds,rivalPlan.seconds),elapsed=0,modelId=model.id,modelName=model.name,opponent=opponent,player=s.player}
	lane.owner=s.userId;Arena.runs[s.userId]=active
	pose(lane,plan.path[1]);pose(lane,rivalPlan.path[1],lane.rivalRobot);Session.markDirty(s)
	return {ok=true,lane=lane.index}
end
function Arena.tick(dt: number)
	for userId,runInfo in Arena.runs do
		local s:any=nil
		for _,candidate in Session.all() do if candidate.userId==userId and not candidate.closed then s=candidate;break end end
		if not s then runInfo.lane.owner=nil;Arena.runs[userId]=nil;continue end
		runInfo.elapsed=math.min(runInfo.duration,runInfo.elapsed+dt)
		local step=math.min(runInfo.elapsed/runInfo.plan.stepSeconds,#runInfo.plan.path-1)
		local index=math.min(#runInfo.plan.path,math.floor(step)+1)
		local a=runInfo.plan.path[index];local b=runInfo.plan.path[math.min(#runInfo.plan.path,index+1)]
		local blend=step%1
		pose(runInfo.lane,{x=a.x+(b.x-a.x)*blend,z=a.z+(b.z-a.z)*blend,yaw=if a~=b then math.atan2(-(b.x-a.x),-(b.z-a.z)) else 0})
		local rivalStep=math.min(runInfo.elapsed/runInfo.rivalPlan.stepSeconds,#runInfo.rivalPlan.path-1)
		local ri=math.min(#runInfo.rivalPlan.path,math.floor(rivalStep)+1)
		local ra=runInfo.rivalPlan.path[ri];local rb=runInfo.rivalPlan.path[math.min(#runInfo.rivalPlan.path,ri+1)]
		pose(runInfo.lane,{x=ra.x+(rb.x-ra.x)*(rivalStep%1),z=ra.z+(rb.z-ra.z)*(rivalStep%1),yaw=if ra~=rb then math.atan2(-(rb.x-ra.x),-(rb.z-ra.z)) else 0},runInfo.lane.rivalRobot)
		if runInfo.elapsed&gt;=runInfo.duration then
			local result={name=runInfo.modelName,score=runInfo.plan.score,moves=runInfo.plan.moves,seconds=math.round(runInfo.plan.seconds*10)/10,
				winner=runInfo.plan.score&gt;=runInfo.opponent.score,opponent=runInfo.opponent.name,opponentScore=runInfo.opponent.score,time=os.time()}
			table.insert(s.data.empire.arenaHistory,1,result)
			while #s.data.empire.arenaHistory&gt;12 do table.remove(s.data.empire.arenaHistory) end
			s.data.empire.arenaBest=math.max(s.data.empire.arenaBest,result.score)
			runInfo.lane.owner=nil;Arena.runs[userId]=nil
			Remote.fire(s.player,"Notify","EMPIRE_NOTICE",{text="Courier test complete: "..tostring(result.score).." points"})
		end
		Session.markDirty(s)
	end
	for _,s in Session.all() do
		local info=Arena.runs[s.userId]
		s.live.arena={active=if info then {model=info.modelName,lane=info.lane.index,progress=info.elapsed/info.duration,moves=info.plan.moves,opponent=info.opponent.name} else nil,
			rivals=NPC.activities}
	end
end
function Arena.init()
	local old=workspace:FindFirstChild("TestGrounds");if old then old:Destroy() end
	local root=Instance.new("Model");root.Name="TestGrounds";root.Parent=workspace
	local cream=Color3.fromRGB(194,192,171);local dark=Color3.fromRGB(44,61,52);local green=Color3.fromRGB(118,155,130)
	part(root,"Walkway",Vector3.new(85,.4,20),-222,.3,-61,cream)
	local terminal=part(root,"ArenaTerminal",Vector3.new(4,4,2),-202,2.5,-59,dark)
	local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Open test arena";prompt.ObjectText="Courier Lab";prompt.MaxActivationDistance=12;prompt:SetAttribute("Public",true);prompt:SetAttribute("App","arena");prompt.Parent=terminal
	for laneIndex=1,3 do
		local lane={index=laneIndex,x=-230,z=-91-(laneIndex-1)*34,owner=nil}
		part(root,"CourseDeck",Vector3.new(42,.5,30),lane.x,.4,lane.z,cream)
		for x=1,Math.WIDTH do for z=1,Math.HEIGHT do
			local px=lane.x+(x-5)*4;local pz=lane.z+(z-4)*4
			if Math.blocked(x,z) then part(root,"MazeBarrier",Vector3.new(3.7,2.6,3.7),px,1.95,pz,dark)
			else part(root,"RouteTile",Vector3.new(3.7,.15,3.7),px,.75,pz,if (x==1 or x==9) and z==4 then green else Color3.fromRGB(166,174,155)) end
		end end
		lane.robot=makeRobot(root,({green,Color3.fromRGB(129,153,172),Color3.fromRGB(182,133,94)})[laneIndex])
		lane.rivalRobot=makeRobot(root,Color3.fromRGB(168,133,102))
		for _, p in lane.rivalRobot:GetChildren() do if p:IsA("BasePart") then local v=p:GetAttribute("Offset");p:SetAttribute("Offset",Vector3.new(v.X+.6,v.Y,v.Z+.6)) end end
		pose(lane,{x=1,z=4});pose(lane,{x=1,z=4},lane.rivalRobot);table.insert(lanes,lane)
	end
	Remote.bind("RunArena",{burst=2,perSecond=.25,company=true},run)
end
return Arena
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000035"><Properties><string name="Name">LeaderboardService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Cached cross-server rankings. All DataStore calls run outside the simulation heartbeat.
local DataStoreService=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local Session=require(script.Parent.SessionService)
local Save=require(script.Parent.SaveService)
local Board={boards={} :: {[string]:any},status="Server preview"}
local modes={"overall","coding","math","reasoning","creativity","arena"}
local stores={} :: {[string]:any}
local profiles:any=nil
local busy=false
local elapsed=170
local sent: {[number]:any}={}
local function values(s: any): any
	local result={overall=s.data.stats.bestOverall,arena=s.data.empire.arenaBest,coding=0,math=0,reasoning=0,creativity=0}
	for _, model in s.data.models do
		if model.trainedAt and model.status~="training" then
			for _,mode in {"coding","math","reasoning","creativity"} do result[mode]=math.max(result[mode],model.stats[mode] or 0) end
		end
	end
	return result
end
local function fallback()
	for _,mode in modes do
		local list={}
		for _,s in Session.all() do
			if not s.closed and s.data.company then table.insert(list,{name=s.data.company.name,userId=s.userId,score=values(s)[mode]}) end
		end
		table.sort(list,function(a,b) if a.score==b.score then return a.userId&lt;b.userId end;return a.score&gt;b.score end)
		while #list&gt;10 do table.remove(list) end
		Board.boards[mode]=list
	end
end
function Board.init()
	if RunService:IsStudio() or not Save.enabled then return end
	local ok=pcall(function()
		profiles=DataStoreService:GetDataStore("AIEmpire_BoardProfiles_v1")
		for _,mode in modes do stores[mode]=DataStoreService:GetOrderedDataStore("AIEmpire_Best_"..mode.."_v1") end
	end)
	if ok then Board.status="Global leaderboard" else stores={};Board.status="Server preview · rankings offline" end
end
local function refresh()
	local ok=pcall(function()
		for _,s in Session.all() do
			if not s.closed and s.data.company then
				local scores=values(s);local previous=sent[s.userId] or {};local changed=false
				for _,mode in modes do
					local value=math.min(9007199254740991,math.floor(scores[mode]*10))
					if value&gt;0 and value&gt;(previous[mode] or 0) then
						stores[mode]:UpdateAsync(tostring(s.userId),function(old) return math.max(tonumber(old) or 0,value) end)
						previous[mode]=value;changed=true
					end
				end
				if changed then profiles:SetAsync(tostring(s.userId),{name=s.data.company.name});sent[s.userId]=previous end
			end
		end
		local newBoards={}
		local profileCache={}
		for _,mode in modes do
			local page=stores[mode]:GetSortedAsync(false,10);local list={}
			for _,row in page:GetCurrentPage() do
				local profile=profileCache[row.key]
				if not profile then local readOk,value=pcall(function() return profiles:GetAsync(row.key) end);profile=if readOk and typeof(value)=="table" then value else {name="Company "..row.key};profileCache[row.key]=profile end
				table.insert(list,{userId=tonumber(row.key) or 0,name=profile.name,score=row.value/10})
			end
			newBoards[mode]=list
		end
		Board.boards=newBoards;Board.status="Global leaderboard"
	end)
	if not ok then fallback();Board.status="Global rankings unavailable · server preview" end
	busy=false
end
function Board.tick(dt: number)
	elapsed+=dt
	if next(stores)==nil then fallback()
	elseif elapsed&gt;=180 and not busy then elapsed=0;busy=true;task.spawn(refresh) end
	for _,s in Session.all() do s.live.rankings={status=Board.status,boards=Board.boards} end
end
return Board
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000039"><Properties><string name="Name">EmpireService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- The company: hiring, research, offices, quests, the daily login, Lab levels, the company jet and the
-- per-second company tick (wages, then CompanyOps.step: B2B pipeline, running costs, calendar, safety
-- rules), plus the automatic HR coordinator and the server racks (CORE_SPEC 3-8).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config.EmpireConfig)
local Math = require(Shared.EmpireMath)
local ModelMath = require(Shared.ModelMath)
local Workforce=require(Shared.WorkforceMath)
local Employee=require(Shared.Config.EmployeeConfig)
local DepartmentConfig=require(Shared.Config.DepartmentConfig)
local Ops=require(Shared.CompanyOps)
local Guard = require(script.Parent.Parent.Lib.Guard)
local Remote = require(script.Parent.Parent.Lib.Remote)
local SessionService = require(script.Parent.SessionService)
local Economy = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local Empire = {}
local function success(session: any): any
	SessionService.markDirty(session)
	return { ok = true }
end
-- payload.apprentice = true (CORE_SPEC 11.1, from the Training Lead's stage): half the agency fee, skill 1
-- rising +1 per 3 company days to 3, 40 % wage, regular staff after 9 days (CompanyOps.apprentice / graduate).
-- Apprentices are kept in empire.apprentices[tostring(seed)] = {day}, never in the profile.
local function hire(session: any, payload: any): any
	local role = Config.find(Config.ROLES, payload.roleId)
	if not role then return {ok=false, err="BAD_INPUT"} end
	local e = session.data.empire
	local count=if payload.count==nil then 1 else payload.count
	if typeof(count)~="number" or count~=math.floor(count) or count&lt;1 or count&gt;10 then return {ok=false,err="BAD_INPUT"} end
	if payload.apprentice~=nil and typeof(payload.apprentice)~="boolean" then return {ok=false,err="BAD_INPUT"} end
	local apprentice=payload.apprentice==true
	if apprentice and Ops.stageIndex(e)&lt;Ops.TRAINING_LEAD.from then return {ok=false,err="OFFICE"} end
	if Math.staff(e)+count &gt; Config.OFFICES[e.office].staff then return {ok=false, err="STAFF_FULL"} end
	local cost=0
	local owned=e.employees[role.id] or 0
	for i=0,count-1 do
		local fee=Math.hireCost({employees={[role.id]=owned+i}},role)
		cost+=if apprentice then math.floor(fee*Ops.APPRENTICE.fee) else fee
	end
	if not Economy.spend(session,cost,"hire") then return {ok=false, err="NO_MONEY"} end
	-- Agency hires (instant, flat fee) are solid but average: skill 2-3, standard wage.
	Math.syncProfiles(e,session.userId)
	local list=e.staffProfiles[role.id]
	local names={}
	if apprentice and typeof(e.apprentices)~="table" then e.apprentices={} end
	for _=1,count do
		local name,seed=Math.nextIdentity(e,session.userId)
		table.insert(list,{n=name,s=seed,k=if apprentice then Ops.APPRENTICE.startSkill else 2+Employee.hash(seed+5)%2,w=1})
		if apprentice then e.apprentices[tostring(seed)]={day=Ops.day(e)} end
		table.insert(names,name)
	end
	e.employees[role.id]=owned+count
	PlotService.refresh(session)
	SessionService.markDirty(session)
	return { ok = true, names = names }
end
-- Dismisses payload.index (1-based position in the role's team list; an optional payload.name must
-- match), otherwise the lowest-skill person of the role (the most recent hire among equals).
-- Counts and profiles stay in sync.
local function fire(session: any, payload: any): any
	local role = Config.find(Config.ROLES, payload.roleId)
	if not role then return {ok=false, err="BAD_INPUT"} end
	local e = session.data.empire
	local n=e.employees[role.id] or 0
	if n &lt; 1 then return {ok=false, err="NOT_OWNED"} end
	if payload.index~=nil and (typeof(payload.index)~="number" or payload.index~=math.floor(payload.index) or payload.index&lt;1 or payload.index&gt;n) then return {ok=false, err="BAD_INPUT"} end
	Math.syncProfiles(e,session.userId)
	local list=e.staffProfiles[role.id]
	local index=payload.index
	-- the team list may have changed since the client rendered it: an optional name must still match
	if index~=nil and typeof(payload.name)=="string" and list[index].n~=payload.name then return {ok=false, err="BAD_INPUT"} end
	if index==nil then
		index=n
		for i=n,1,-1 do if list[i].k&lt;list[index].k then index=i end end
	end
	local gone=table.remove(list,index)
	if typeof(gone)=="table" and typeof(e.apprentices)=="table" then e.apprentices[tostring(gone.s)]=nil end
	e.employees[role.id] = n-1
	e.unpaidLeave=math.clamp(math.floor(tonumber(e.unpaidLeave) or 0),0,Math.staff(e))
	PlotService.refresh(session)
	return success(session)
end
local function research(session: any, payload: any): any
	local def = Config.find(Config.RESEARCH, payload.researchId)
	if not def then return {ok=false, err="BAD_INPUT"} end
	local e = session.data.empire
	if e.research[def.id] then return {ok=false, err="ALREADY_DONE"} end
	if e.researchJob then return {ok=false, err="RESEARCH_ACTIVE"} end
	if def.prereq and not e.research[def.prereq] then return {ok=false, err="PREREQUISITE"} end
	if e.points &lt; def.points then return {ok=false, err="NO_POINTS"} end
	if not Economy.spend(session, def.cost, "research") then return {ok=false, err="NO_MONEY"} end
	e.points -= def.points
	e.researchJob = { id = def.id, elapsed = 0, seconds = def.seconds }
	return success(session)
end
-- Office upgrade (CORE_SPEC 2.1). Leaving the garage needs the first signed client AND the price.
local function upgrade(session: any, _payload: any): any
	local e = session.data.empire
	local def = Config.OFFICES[e.office + 1]
	if not def then return {ok=false, err="MAX_OFFICE"} end
	if e.office == 1 and (tonumber(e.contractsCompleted) or 0) &lt; 1 then return {ok=false, err="FIRST_CLIENT"} end
	if not Economy.spend(session, def.price, "office") then return {ok=false, err="NO_MONEY"} end
	e.office += 1
	e.xp += 100
	PlotService.refresh(session)
	Ops.post(e, "moved into the " .. def.name)
	Remote.fire(session.player, "Notify", "EMPIRE_NOTICE", { text = "New office unlocked: " .. def.name })
	return success(session)
end
local function quest(session: any, payload: any): any
	local def = Config.find(Config.QUESTS, payload.questId)
	if not def then return {ok=false, err="BAD_INPUT"} end
	local data = session.data
	if data.empire.quests[def.id] then return {ok=false, err="ALREADY_DONE"} end
	if Math.progress(data, def) &lt; def.target then return {ok=false, err="NOT_READY"} end
	-- No yields between eligibility and grant: one reward per quest.
	data.empire.quests[def.id] = true
	data.empire.xp += def.xp
	Economy.grant(session, def.reward, "quest")
	return success(session)
end
-- The old daily contract clicks are gone (EmpireConfig.CONTRACTS = {}): their clients are in the B2B
-- pipeline (CompanyOps). The remote stays bound so old clients get a clean answer.
local function deliver(session: any, payload: any): any
	local def = Config.find(Config.CONTRACTS, payload.contractId)
	if not def or typeof(payload.modelId) ~= "string" then return {ok=false, err="BAD_INPUT"} end
	return {ok=false, err="BAD_INPUT"}
end
local function daily(session: any, _payload: any): any
	local e = session.data.empire
	local day = math.floor(os.time() / 86400)
	if e.daily.day &gt;= day then return {ok=false, err="ALREADY_DONE"} end
	local streak = if e.daily.day == day - 1 then math.min(7, e.daily.streak + 1) else 1
	e.daily = {day = day, streak = streak}
	local reward = 1000 + (streak - 1) * 500
	e.points += 15
	e.xp += 50
	Economy.grant(session, reward, "daily")
	return success(session)
end
-- Lab levels (CORE_SPEC 7.5): repeatable researcher sink after the whole research tree.
-- Level L -&gt; L+1 costs floor(200 * 1.35^L) research points and $floor(6000 * 1.6^L); +1 core stat each.
Empire.labCost = Ops.labCost
function Empire.labLevel(session: any): any
	local e = session.data.empire
	local L = math.floor(tonumber(e.labLevel) or 0)
	if L &gt;= Ops.LAB_MAX then return {ok=false, err="MAX_LEVEL"} end
	for _, def in Config.RESEARCH do if not e.research[def.id] then return {ok=false, err="PREREQUISITE"} end end
	local pts, cost = Empire.labCost(L)
	if e.points &lt; pts then return {ok=false, err="NO_POINTS"} end
	if not Economy.spend(session, cost, "lab") then return {ok=false, err="NO_MONEY"} end
	e.points -= pts
	e.labLevel = L + 1
	Ops.post(e, "Lab level " .. e.labLevel .. ": +1 core stat on future models")
	return success(session)
end

-- runtime state per session (never saved): auto-HR clock + trailing income, last office attributes
local runtime: { [any]: any } = setmetatable({}, { __mode = "k" }) :: any
local function stateOf(session: any): any
	local r = runtime[session]
	if not r then r = { hrClock = 0, income = nil }; runtime[session] = r end
	return r
end
Empire.HIRE_GAP = Ops.HIRE_GAP
Empire.SAVE_NEWS_HOLD = 20
-- Automatic HR (CORE_SPEC 8.1): every HIRE_GAP seconds one agency hire into the department with the
-- lowest heads / need below its need, within the wage budget of the 5-minute trailing income, through
-- the normal hire path. Save mode stops it at half the desks; never while broke or anyone is on leave.
local function autoHire(session: any, dt: number, saving: boolean)
	local e = session.data.empire
	local r = stateOf(session)
	r.hrClock += dt
	if r.hrClock &lt; Ops.HIRE_GAP then return end
	local auto = Ops.hrSettings(e)
	if not auto then return end
	local live = false
	for _, id in session.data.modelOrder do local m = session.data.models[id]; if m and m.status == "live" then live = true; break end end
	if not live then return end -- nothing to sell yet: no payroll
	local roleId = Ops.hrPick(e)
	if not roleId then return end
	if not Ops.hrAllowed(e, session.data.money, r.income or 0, saving, roleId) then return end
	local role = Config.find(Config.ROLES, roleId)
	if not role or session.data.money - Ops.reserve(e) * 1.5 &lt; Math.hireCost(e, role) then return end
	local result = hire(session, { roleId = roleId, count = 1 })
	if result.ok then
		r.hrClock = 0
		Ops.post(e, string.format("HR hired %s (%s, fee %s)", tostring(result.names and result.names[1] or "someone"), role.name, Ops.money(Math.hireCost(e, role))))
	end
end
-- The garage stage's site board (CORE_SPEC 2.3): "Future HQ of &lt;company&gt;: first client yes/no, $x / $27,000".
-- Money is shown in whole thousands, so the text (and the office attribute SiteGoal) changes rarely.
function Empire.siteGoal(data: any): string?
	local e = data.empire
	if Ops.stageIndex(e) ~= 1 or not data.company then return nil end
	local nextDef = Config.OFFICES[2]
	local signed = (tonumber(e.contractsCompleted) or 0) &gt;= 1
	local cash = math.max(0, math.floor((tonumber(data.money) or 0) / 1000) * 1000)
	return string.format("Future HQ of %s\nFirst client: %s\n%s / %s saved", data.company.name, if signed then "signed" else "not yet", Ops.money(math.min(cash, nextDef.price)), Ops.money(nextDef.price))
end
-- Office attributes for the building visuals: HotelRooms / HotelGuests (guest house), RackFaults
-- ("3,7" = blade slots of failed GPUs in PlotService blade order), ServerFaults (count), SiteGoal (garage
-- stage: the goal text, also written into the site board's Body label). Written on change.
local function officeAttributes(session: any)
	local p = PlotService.get(session.player)
	local office = if p then p.office else nil
	if not office then return end
	local e = session.data.empire
	local st = Ops.stage(e)
	local function set(name: string, value: any)
		if office:GetAttribute(name) ~= value then office:SetAttribute(name, value) end
	end
	local goal = Empire.siteGoal(session.data)
	if goal and office:GetAttribute("SiteGoal") ~= goal then
		office:SetAttribute("SiteGoal", goal)
		local r = runtime[session]
		local body = if r then r.siteBody else nil
		if not (body and body:IsDescendantOf(office)) then
			body = nil
			local board = office:FindFirstChild("SiteBoard", true) -- tier 0 only (small model), once per rebuild
			if board then
				for _, d in board:GetDescendants() do
					if d.Name == "Body" and d:IsA("TextLabel") then body = d; break end
				end
			end
			if r then r.siteBody = body end
		end
		if body then (body :: TextLabel).Text = goal end
	elseif not goal and office:GetAttribute("SiteGoal") ~= nil then
		office:SetAttribute("SiteGoal", nil)
	end
	if st.guest then
		set("HotelRooms", Ops.GUEST.rooms)
		set("HotelGuests", Ops.hotelGuests(e))
	end
	local slots = {}
	for _, f in Ops.faults(e) do table.insert(slots, tostring(f.slot)) end
	set("RackFaults", table.concat(slots, ","))
	set("ServerFaults", #slots)
end
function Empire.tick(session: any, dt: number)
	local data = session.data
	if not data.company then return end
	local e = data.empire
	local clock = workspace:GetServerTimeNow()
	local b = Math.bonuses(e)
	local duty = Ops.duty(clock) -- stock outputs follow the time sheet (mean 1 per game day): nothing at night
	e.seconds += dt
	e.points = math.min(100000, e.points + b.points * dt * duty * (if data.company.spec == "research" then 1.2 else 1))
	local access = e.subscriptions
	if access.expires and access.expires &gt; os.time() then
		e.points = math.min(100000,e.points + math.min(3,access.score/100) * dt)
	end
	e.lastSeen = os.time()
	local job = e.researchJob
	if job then
		job.elapsed = math.min(job.seconds, job.elapsed + dt)
		if job.elapsed &gt;= job.seconds then
			e.research[job.id] = true
			e.researchJob = nil
			e.xp += 150
			local def = Config.find(Config.RESEARCH, job.id)
			Remote.fire(session.player, "Notify", "EMPIRE_NOTICE", {text = "Research complete: " .. (if def then def.name else job.id)})
		end
	end
	local curators = Workforce.count(e,"curator")
	if curators &gt; 0 then
		local total = ModelMath.dataSummary(data.data).total
		local tokens = math.min(curators * 300000 * dt * duty, math.max(0, 1e12 - total))
		if tokens &gt; 0 then
			local quality = if e.research.cleaning then 0.85 else 0.65
			for _, id in {"general", "code", "math"} do ModelMath.addTokens(data.data, id, tokens / 3, quality) end
		end
	end
	-- MarketService sets the model flow first. Staff costs are added once, then the company runs.
	Economy.applyFlow(session, 0, b.wage * dt, "wages")
	session.live.cost += b.wage
	Ops.step(session, dt, Economy, clock)
	if session.live.ops then session.live.ops.wagesCost = math.floor(b.wage * 60 + 0.5) end
	-- apprentices whose 9 training days are over become regular staff (skill 3, full wage)
	local graduates = Ops.graduate(e)
	if #graduates &gt; 0 then
		for _, name in graduates do Ops.post(e, "apprentice " .. name .. " graduated (skill 3, full wage)", clock) end
		PlotService.refresh(session)
	end
	-- servers: rack faults (deterministic per company and minute of play) and the compute summary
	Ops.faultStep(e, data.gpus, session.userId, dt, clock)
	local fleet = ModelMath.fleet(data.gpus)
	local faults = {}
	for _, f in Ops.faults(e) do table.insert(faults, { slot = f.slot, gpu = f.gpu, since = math.floor(f.since) }) end
	session.live.compute = { units = fleet.throughput, lost = Ops.faultLoss(e), reserved = math.floor(((e.deals and e.deals.reserved) or 0) * 100 + 0.5) / 100,
		slots = fleet.slotsUsed, it = Ops.itOnDuty(e, clock), faults = faults }
	-- trailing income (5-minute average) and Save mode for the HR coordinator
	local r = stateOf(session)
	local revenue = session.live.revenue or 0
	r.income = if r.income == nil then revenue else r.income + (revenue - r.income) * math.min(1, dt / 300)
	local saving = Ops.saveMode(e, data.money, revenue - (session.live.cost or 0))
	if session.live.ops then
		session.live.ops.saveMode = saving
		session.live.ops.income = math.floor(r.income * 60 + 0.5)
	end
	-- Save mode switches write one news line (CORE_SPEC 8.2) once the new state has held SAVE_NEWS_HOLD
	-- seconds (the market cycle swings net profit; no news spam around the threshold)
	if r.saveShown == nil then r.saveShown = saving; r.saveFlip = 0 end
	if saving ~= r.saveShown then
		r.saveFlip += dt
		if r.saveFlip &gt;= Empire.SAVE_NEWS_HOLD then
			r.saveShown = saving
			r.saveFlip = 0
			local nextDef = Config.OFFICES[Ops.stageIndex(e) + 1]
			Ops.post(e, if saving and nextDef then "Save mode on: saving for the " .. nextDef.name else "Save mode off", clock)
		end
	else
		r.saveFlip = 0
	end
	autoHire(session, dt, saving)
	officeAttributes(session)
	e.historyClock += dt
	if e.historyClock &gt;= 10 then
		e.historyClock = 0
		table.insert(e.history, {
			time = workspace:GetServerTimeNow(),
			profit = math.round((session.live.revenue - session.live.cost) * 600) / 10,
			users = math.round(session.live.users),
		})
		while #e.history &gt; 36 do table.remove(e.history, 1) end
	end
	SessionService.markDirty(session)
end

-- Remotes: EmpireAction (company settings and late purchases) and DealAction (B2B clients) -----------------
local function setFlag(session: any): any
	return success(session)
end
local function empireAction(session: any, p: any): any
	local e = session.data.empire
	local action = p.action
	if action == "labLevel" then return Empire.labLevel(session) end
	if action == "buyJet" then
		local result = Ops.buyJet(session, Economy)
		if result.ok then Ops.post(e, "bought the company jet (2 pilots, " .. Ops.money(Ops.JET.pilots * Ops.JET.pilotWage + Ops.JET.upkeep) .. "/day)"); SessionService.markDirty(session) end
		return result
	end
	if action == "hrBudget" then
		local budget = tonumber(p.budget)
		if budget == nil then return {ok=false, err="BAD_INPUT"} end
		for _, allowed in Ops.HR_BUDGETS do
			if math.abs(allowed - budget) &lt; 1e-6 then e.hr = { auto = (e.hr or {}).auto ~= false, budget = allowed }; return setFlag(session) end
		end
		return {ok=false, err="BAD_INPUT"}
	end
	if action == "hrAuto" then
		if typeof(p.on) ~= "boolean" then return {ok=false, err="BAD_INPUT"} end
		local budget = if typeof(e.hr) == "table" then e.hr.budget else 0.40
		e.hr = { auto = p.on, budget = budget or 0.40 }
		return setFlag(session)
	end
	if action == "saveMode" then
		if p.mode ~= "auto" and p.mode ~= "off" then return {ok=false, err="BAD_INPUT"} end
		e.saveMode = p.mode
		return setFlag(session)
	end
	if action == "nightShift" then
		local dept = Guard.id(p.dept)
		if not dept or not DepartmentConfig.DEPARTMENTS[dept] or typeof(p.on) ~= "boolean" then return {ok=false, err="BAD_INPUT"} end
		local known = false
		for _, list in Ops.ROLE_DEPTS :: { [string]: { string } } do if table.find(list, dept) then known = true end end
		if not known then return {ok=false, err="BAD_INPUT"} end
		if Ops.stageIndex(e) &lt; Ops.NIGHT.from then return {ok=false, err="OFFICE"} end
		if typeof(e.nightShift) ~= "table" then e.nightShift = {} end
		e.nightShift[dept] = if p.on then true else nil
		return setFlag(session)
	end
	if action == "autoPrice" then
		-- the rule lives in the models package (AIModelService.setAutoPrice validates, re-prices on the next tick)
		local module = script.Parent:FindFirstChild("AIModelService")
		local models = if module then (require :: any)(module) else nil
		local modelId = if p.model ~= nil then p.model else p.modelId
		if models and typeof(models.setAutoPrice) == "function" then
			local result = models.setAutoPrice(session, modelId, p.on) -- non-boolean `on` -&gt; BAD_INPUT there
			if typeof(result) == "table" and result.ok then SessionService.markDirty(session) end
			return result
		end
		local id = Guard.id(modelId)
		local m = if id then session.data.models[id] else nil
		if not m or not m.release or typeof(p.on) ~= "boolean" then return {ok=false, err="BAD_INPUT"} end
		m.release.auto = p.on
		return setFlag(session)
	end
	return {ok=false, err="BAD_INPUT"}
end
-- The founder joins the pilot meeting of a running visit in person: +0.15 trust on that visit.
local function joinMeeting(session: any, client: any): any
	local d = Ops.ensure(session.data.empire)
	for _, trip in d.tripList do
		if trip.client == client.id and trip.kind == "sign" then
			if trip.joined then return {ok=false, err="ALREADY_DONE"} end
			trip.joined = true
			Ops.post(session.data.empire, "founder joined the " .. client.name .. " meeting (+15% trust)")
			SessionService.markDirty(session)
			return {ok=true}
		end
	end
	return {ok=false, err="NO_MEETING"}
end
Empire.joinMeeting = joinMeeting
local MEETING_RANGE = 40
local function dealAction(session: any, p: any): any
	local client = Ops.client(Guard.id(p.clientId))
	if not client then return {ok=false, err="BAD_INPUT"} end
	local d = Ops.ensure(session.data.empire)
	if p.action == "pin" then
		d.pinned = if d.pinned == client.id then nil else client.id
		if d.pinned then d.skip[client.id] = nil end
		return success(session)
	end
	if p.action == "skip" then
		d.skip[client.id] = if d.skip[client.id] then nil else true
		if d.skip[client.id] and d.pinned == client.id then d.pinned = nil end
		return success(session)
	end
	if p.action == "joinMeeting" then
		-- the founder must stand at that client's office (lobby, reception or meeting room)
		local module = ReplicatedStorage.Shared.Config:FindFirstChild("CityPlan")
		local character = session.player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if not module or not root or not root:IsA("BasePart") then return {ok=false, err="TOO_FAR"} end
		local dest = (require :: any)(module).clientOffice(client.name)
		local near = false
		if dest then
			for _, cf in { dest.lobby, dest.meeting, dest.reception, dest.door } do
				if typeof(cf) == "CFrame" and (cf.Position - root.Position).Magnitude &lt;= MEETING_RANGE then near = true end
			end
		end
		if not near then return {ok=false, err="TOO_FAR"} end
		return joinMeeting(session, client)
	end
	return {ok=false, err="BAD_INPUT"}
end
function Empire.init()
	local limit = {burst=3, perSecond=1, company=true}
	Remote.bind("HireEmployee", limit, hire)
	Remote.bind("FireEmployee", limit, fire)
	Remote.bind("StartResearch", limit, research)
	Remote.bind("UpgradeOffice", limit, upgrade)
	Remote.bind("ClaimQuest", limit, quest)
	Remote.bind("DeliverContract", limit, deliver)
	Remote.bind("ClaimDaily", limit, daily)
	local actions = {burst=4, perSecond=2, company=true}
	Remote.bind("EmpireAction", actions, empireAction)
	Remote.bind("DealAction", actions, dealAction)
	-- CityService "Start meeting" prompts in the client offices (prompt range checked there)
	local city = script.Parent:FindFirstChild("CityService")
	local plan = ReplicatedStorage.Shared.Config:FindFirstChild("CityPlan")
	if city and plan then
		local City = (require :: any)(city)
		local CityPlan = (require :: any)(plan)
		if typeof(City.setMeetingHandler) == "function" then
			City.setMeetingHandler(function(player: Player, clientId: string, _prompt: ProximityPrompt)
				local session = SessionService.get(player)
				if not session or not session.data.company then return end
				local dest = CityPlan.clientOffice(clientId)
				local client = Ops.clientByName(if dest then dest.name else clientId)
				if not client then return end
				local result = joinMeeting(session, client)
				local text = if result.ok then "You joined the " .. client.name .. " meeting: trust +15%."
					elseif result.err == "ALREADY_DONE" then "You are already in the " .. client.name .. " meeting."
					else "No meeting with " .. client.name .. " is scheduled right now."
				Remote.fire(player, "Notify", "CAMPUS_NOTICE", { text = text })
			end)
		end
	end
end
return Empire
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000041"><Properties><string name="Name">CampusService</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- A large drivable tech district on ONE continuous ground plane at street level: the streets, the twelve
-- campus plots and everything between them meet at world y = STREET_Y. Green belts with a footpath, trees
-- and lamps fill the gaps between neighbouring plots and the row ends; calm parkland covers the district
-- beyond the boulevards and ring roads. Plot sites (and the garages under them) are never covered.
-- To the south three corridors stay free for the roads to Business City and the airport (CityPlan.
-- DISTRICT_LINKS): this service builds their supports at street level, CityBuilder lays the roads on top.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage.Shared.Config.CampusConfig)
local Plan=require(ReplicatedStorage.Shared.Config.BuildingPlan)
local CityPlan=require(ReplicatedStorage.Shared.Config.CityPlan)
local SessionService=require(script.Parent.SessionService)
local Campus={board={}}
local boardLabel: TextLabel?=nil
local elapsed=10
type Rect={x1: number,x2: number,z1: number,z2: number}
local GROUND=Config.STREET_Y -- top of every walkable district surface
local BASE=-2 -- top of the deep district foundation
local DISTRICT: Rect={x1=-1150,x2=1150,z1=-800,z2=800}
local function part(root: Instance,name: string,size: Vector3,x: number,y: number,z: number,color: Color3,material: Enum.Material?): Part
	local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=CFrame.new(x,y,z);p.Anchored=true;p.Color=color;p.Material=material or Enum.Material.Concrete;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=root;return p
end
local function block(root: Instance,name: string,r: Rect,y1: number,y2: number,color: Color3,material: Enum.Material?): Part
	return part(root,name,Vector3.new(r.x2-r.x1,y2-y1,r.z2-r.z1),(r.x1+r.x2)/2,(y1+y2)/2,(r.z1+r.z2)/2,color,material)
end
local function detail(p: BasePart): BasePart
	p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;return p
end
-- Rectangle minus holes as few rectangles (grid cells merged greedily).
local function subtract(r: Rect,holes: {Rect}): {Rect}
	local xs,zs={r.x1,r.x2},{r.z1,r.z2};local hs: {Rect}={}
	for _,h in holes do
		local x1,x2,z1,z2=math.max(h.x1,r.x1),math.min(h.x2,r.x2),math.max(h.z1,r.z1),math.min(h.z2,r.z2)
		if x2-x1&gt;1e-3 and z2-z1&gt;1e-3 then table.insert(hs,{x1=x1,x2=x2,z1=z1,z2=z2});table.insert(xs,x1);table.insert(xs,x2);table.insert(zs,z1);table.insert(zs,z2) end
	end
	if #hs==0 then return {r} end
	local function uniq(t: {number}): {number} table.sort(t);local o: {number}={};for _,v in t do if #o==0 or v-o[#o]&gt;1e-4 then table.insert(o,v) end end;return o end
	xs,zs=uniq(xs),uniq(zs)
	local free: {{boolean}}={}
	for i=1,#xs-1 do free[i]={};for j=1,#zs-1 do
		local cx,cz=(xs[i]+xs[i+1])/2,(zs[j]+zs[j+1])/2;local f=true
		for _,h in hs do if cx&gt;h.x1 and cx&lt;h.x2 and cz&gt;h.z1 and cz&lt;h.z2 then f=false;break end end
		free[i][j]=f
	end end
	local out: {Rect}={}
	for j=1,#zs-1 do for i=1,#xs-1 do
		if free[i][j] then
			local i2=i;while i2+1&lt;=#xs-1 and free[i2+1][j] do i2+=1 end
			local j2=j;local grow=true
			while grow and j2+1&lt;=#zs-1 do for k=i,i2 do if not free[k][j2+1] then grow=false;break end end;if grow then j2+=1 end end
			for k=i,i2 do for l=j,j2 do free[k][l]=false end end
			table.insert(out,{x1=xs[i],x2=xs[i2+1],z1=zs[j],z2=zs[j2+1]})
		end
	end end
	return out
end
-- World rectangles of the twelve plot sites, computed exactly like PlotService.init.
local function plotSites(): {{Rect}}
	local rows: {{Rect}}={{},{}}
	local s=Plan.SITE
	for i=1,Config.PLOT_COUNT do
		local row=if i&lt;=6 then -1 else 1;local x=((i-1)%6-2.5)*Config.PITCH
		local cf=CFrame.lookAt(Vector3.new(x,Config.STREET_Y,row*Config.ROW_OFFSET),Vector3.new(x,Config.STREET_Y,0))
		local r: Rect={x1=math.huge,x2=-math.huge,z1=math.huge,z2=-math.huge}
		for _,c in {Vector3.new(s.x1,0,s.z1),Vector3.new(s.x2,0,s.z1),Vector3.new(s.x1,0,s.z2),Vector3.new(s.x2,0,s.z2)} do
			local w=cf:PointToWorldSpace(c)
			r.x1,r.x2,r.z1,r.z2=math.min(r.x1,w.X),math.max(r.x2,w.X),math.min(r.z1,w.Z),math.max(r.z2,w.Z)
		end
		table.insert(rows[if row&lt;0 then 1 else 2],r)
	end
	for _,list in rows do table.sort(list,function(a,b) return a.x1&lt;b.x1 end) end
	return rows
end
local function tree(root: Instance,x: number,z: number,k: number,trunk: Color3,leaf: Color3)
	local h=9+(k%3)*1.5
	part(root,"ParkTree",Vector3.new(1.2,h,1.2),x,GROUND+h/2,z,trunk,Enum.Material.Wood)
	local d=9+(k%4)
	local canopy=part(root,"ParkCanopy",Vector3.new(d,d*0.8,d),x,GROUND+h+d*0.25,z,leaf,Enum.Material.LeafyGrass);canopy.Shape=Enum.PartType.Ball;detail(canopy)
end
local function lamp(root: Instance,x: number,z: number,lit: boolean,ink: Color3,glow: Color3)
	part(root,"PathLamp",Vector3.new(.45,9,.45),x,GROUND+4.5,z,ink,Enum.Material.Metal)
	local head=detail(part(root,"PathLampHead",Vector3.new(1.6,.35,1.6),x,GROUND+9.1,z,glow,Enum.Material.Neon))
	if lit then local point=Instance.new("PointLight");point.Range=20;point.Brightness=.6;point.Color=glow;point.Parent=head end
end
-- Continuous district ground: green belts between plots and at the row ends, parkland everywhere else.
local function districtGround(root: Instance,stone: Color3,green: Color3,wood: Color3,ink: Color3)
	local folder=Instance.new("Model");folder.Name="DistrictGround";folder.Parent=root
	local lawn=Color3.fromRGB(104,134,94);local pave=Color3.fromRGB(184,180,170);local leafA=Color3.fromRGB(80,112,76);local leafB=Color3.fromRGB(112,142,96)
	local glow=Color3.fromRGB(238,220,184)
	local function ground(r: Rect,name: string)
		-- parts are limited to 2048 studs per axis: split long rectangles
		local nx,nz=math.ceil((r.x2-r.x1)/1200),math.ceil((r.z2-r.z1)/1200)
		for i=0,nx-1 do for j=0,nz-1 do
			local piece: Rect={x1=r.x1+(r.x2-r.x1)*i/nx,x2=r.x1+(r.x2-r.x1)*(i+1)/nx,z1=r.z1+(r.z2-r.z1)*j/nz,z2=r.z1+(r.z2-r.z1)*(j+1)/nz}
			block(folder,name,piece,BASE,GROUND,stone)
			block(folder,"Lawn",piece,GROUND,GROUND+.1,lawn,Enum.Material.Grass)
		end end
	end
	-- 1. green belts: every gap between neighbouring plot sites and from the row ends to the ring roads
	local ringInner=1016-26
	local k=0
	for _,sites in plotSites() do
		local z1,z2=sites[1].z1,sites[1].z2
		local edges={-ringInner}
		for _,r in sites do table.insert(edges,r.x1);table.insert(edges,r.x2) end
		table.insert(edges,ringInner)
		for g=1,#edges,2 do
			local x1,x2=edges[g],edges[g+1]
			if x2-x1&gt;0.5 then
				local cx=(x1+x2)/2
				ground({x1=x1,x2=x2,z1=z1,z2=z2},"GreenBelt")
				part(folder,"BeltPath",Vector3.new(6,.12,z2-z1),cx,GROUND+.06,(z1+z2)/2,pave,Enum.Material.Pavement)
				local n=0
				for z=z1+24,z2-20,48 do
					n+=1;k+=1
					local side=if n%2==0 then 1 else -1
					tree(folder,cx+side*math.min(9,(x2-x1)/2-5),z,k,wood,if k%2==0 then leafA else leafB)
				end
				local m=0
				for z=z1+48,z2-40,96 do
					m+=1;lamp(folder,cx+3.8,z,m%2==1,ink,glow)
				end
			end
		end
	end
	-- 2. parkland beyond the back boulevards and the ring roads (around the squares and platforms)
	local holes: {Rect}={
		{x1=-200,x2=200,z1=-714,z2=-586}, -- rival promenade
		{x1=-12,x2=12,z1=-660,z2=-510}, -- rival link
		{x1=1018,x2=1122,z1=-60,z2=60}, -- founder square
		{x1=-1125,x2=-1015,z1=-225,z2=-35}, -- west lab platform (courier test grounds)
		{x1=-1024,x2=1024,z1=-35,z2=35}, -- innovation avenue on its support (2048 long)
		{x1=-1024,x2=1024,z1=480,z2=550},{x1=-1024,x2=1024,z1=-550,z2=-480}, -- back boulevards
		{x1=-1042,x2=-990,z1=-540,z2=540},{x1=990,x2=1042,z1=-540,z2=540}, -- ring roads
		{x1=-990,x2=990,z1=-480,z2=480}, -- plots, green belts and the avenue between the ring roads
	}
	-- road corridors to the south (ring-road extensions, Central Avenue): a support at street level each
	for _,r in CityPlan.DISTRICT_LINKS do
		table.insert(holes,r)
		block(folder,"LinkSupport",r,BASE,GROUND,stone)
	end
	local function inLink(x: number,z: number,margin: number): boolean
		for _,r in CityPlan.DISTRICT_LINKS do if x&gt;r.x1-margin and x&lt;r.x2+margin and z&gt;r.z1-margin and z&lt;r.z2+margin then return true end end
		return false
	end
	for _,r in subtract(DISTRICT,holes) do ground(r,"Parkland") end
	-- promenades, plazas and tree groves in the parkland
	-- promenades parallel to the back boulevards (the southern one meets the rival promenade)
	for _,z in {-610,610} do
		-- the southern promenade stops at the three road corridors (pedestrians cross on the road)
		local spans: {{number}}=if z&lt;0 then {{-1120,-200},{200,1120}} else {{-1120,-1042},{-990,-28},{28,990},{1042,1120}}
		for _,span in spans do
			part(folder,"ParkPromenade",Vector3.new(span[2]-span[1],.12,8),(span[1]+span[2])/2,GROUND+.06,z,pave,Enum.Material.Pavement)
		end
	end
	for _,x in {-480,160,800} do
		block(folder,"ParkPlaza",{x1=x-22,x2=x+22,z1=640,z2=684},GROUND,GROUND+.14,pave,Enum.Material.Pavement)
		part(folder,"ParkPlanter",Vector3.new(10,1.6,10),x,GROUND+.8,662,stone,Enum.Material.Limestone)
		tree(folder,x,662,x,wood,leafA)
	end
	for _,z in {700,760,-660,-700} do
		for x=-1080,1080,120 do
			local inPromenade=z&lt;0 and x&gt;-230 and x&lt;230
			if not inPromenade then
				k+=1
				local tx,tz=x+((k*37)%40)-20,z+((k*23)%30)-15
				if not inLink(tx,tz,8) then tree(folder,tx,tz,k,wood,if k%2==0 then leafA else leafB) end
			end
		end
	end
	for _,x in {-1096,1096} do
		for z=-520,520,80 do
			local blocked=(x&gt;0 and z&gt;-80 and z&lt;80) or (x&lt;0 and z&gt;-245 and z&lt;-15)
			if not blocked then k+=1;tree(folder,x,z,k,wood,if k%2==0 then leafA else leafB) end
		end
	end
end
local function sign(p: BasePart,text: string): TextLabel
	local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Front;g.CanvasSize=Vector2.new(1200,650);g.LightInfluence=.3;g.Parent=p
	local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Size=UDim2.fromScale(1,1);t.Text=text;t.TextScaled=true;t.TextWrapped=true;t.Font=Enum.Font.BuilderSansBold;t.TextColor3=Color3.fromRGB(235,231,216);t.Parent=g;return t
end
function Campus.init()
	local old=workspace:FindFirstChild("TechDistrict");if old then old:Destroy() end
	local root=Instance.new("Model");root.Name="TechDistrict";root.Parent=workspace
	local ink=Color3.fromRGB(43,51,47);local stone=Color3.fromRGB(186,188,169);local green=Color3.fromRGB(88,117,85);local wood=Color3.fromRGB(158,119,78)
	-- parts are limited to 2048 studs per axis (Roblox clamps larger sizes): the deep base is two halves,
	-- the boulevards are 2048 long (x -1024..1024, overlapping the ring roads at x 990..1042)
	for _,x in {-575,575} do part(root,"DistrictFoundation",Vector3.new(1150,2,1600),x,-3,0,stone) end
	for _,z in {0,-515,515} do
		-- the support also carries both sidewalks, so no trench opens beside the street
		part(root,"BoulevardSupport",Vector3.new(2048,26,70),0,11,z,stone)
		part(root,"InnovationAvenue",Vector3.new(2048,.2,50),0,24.12,z,ink,Enum.Material.Asphalt)
		for x=-990,990,44 do
			part(root,"LaneMark",Vector3.new(13,.035,.3),x,24.25,z,Color3.fromRGB(229,223,199))
		end
		for _,side in {-1,1} do
			part(root,"Sidewalk",Vector3.new(2048,.65,8),0,24.15,z+side*31,stone)
			for x=-960,960,160 do
				if z==515 and side==1 and math.abs(x)&lt;30 then continue end -- Central Avenue meets the boulevard here
				part(root,"LightPost",Vector3.new(.65,16,.65),x,32.5,z+side*31,ink,Enum.Material.Metal)
				local light=part(root,"StreetLight",Vector3.new(6,.35,1.2),x,40.5,z+side*29,Color3.fromRGB(238,220,184),Enum.Material.Neon)
				local point=Instance.new("PointLight");point.Range=28;point.Brightness=.7;point.Color=Color3.fromRGB(238,220,184);point.Parent=light
			end
		end
	end
	for _,x in {-1016,1016} do
		part(root,"LoopSupport",Vector3.new(52,24,1080),x,12,0,stone)
		part(root,"RingRoad",Vector3.new(48,.2,1080),x,24.12,0,ink,Enum.Material.Asphalt)
		for z=-480,480,48 do part(root,"RingMark",Vector3.new(.3,.035,14),x,24.25,z,Color3.fromRGB(229,223,199)) end
	end
	-- Street trees and shaded benches along the outer sidewalks of the back boulevards (the old rows at
	-- z = +-76 stood inside the plot forecourts and are gone; the campus sites plant their own frontage).
	for _,z in {-574,574} do
		for x=-880,880,160 do
			part(root,"TreeTrunk",Vector3.new(1.4,12,1.4),x,GROUND+6,z,wood,Enum.Material.Wood)
			detail(part(root,"TreeCanopy",Vector3.new(12,9,12),x,GROUND+14,z,green,Enum.Material.Grass))
			part(root,"Bench",Vector3.new(10,2.2,3),x+22,GROUND+1.1,z,wood,Enum.Material.Wood)
		end
	end
	districtGround(root,stone,green,wood,ink)
	for _,x in {-480,160,800} do for i=-3,3 do part(root,"Crosswalk",Vector3.new(2,.04,50),x+i*3,24.28,0,stone) end end
	part(root,"FounderSquare",Vector3.new(104,24,120),1070,12,0,stone)
	local board=part(root,"FounderBoard",Vector3.new(60,28,1.2),1062,41,33,ink,Enum.Material.Metal)
	boardLabel=sign(board,"AI EMPIRE / FOUNDER DISTRICT\nTrain. Build. Grow.")
	local directory=part(root,"DistrictDirectory",Vector3.new(28,14,.7),1062,32,-38,green)
	sign(directory,"CAMPUS DISTRICT\n01—06  NORTH HEADQUARTERS\n07—12  SOUTH HEADQUARTERS\nWEST  COURIER TEST GROUNDS\nNORTH  RIVAL COMPANIES\nSOUTH: DOWNTOWN · AIRPORT\nRING ROAD  ↔  COMPANY GARAGES")
	for i,def in {{"COMPANY OS","empire"},{"CAMPUS &amp; FLEET","campus"},{"MODEL LAB","lab"}} do
		local terminal=part(root,"PublicTerminal",Vector3.new(7,6,2),1040+(i-1)*16,27.5,-10,ink)
		sign(terminal,def[1]);local q=Instance.new("ProximityPrompt");q.ActionText="Open";q.ObjectText=def[1];q.MaxActivationDistance=12;q.RequiresLineOfSight=false;q:SetAttribute("Public",true);q:SetAttribute("App",def[2]);q.Parent=terminal
	end
	part(root,"WestLabPlatform",Vector3.new(110,24,190),-1070,12,-130,stone)
	part(root,"RivalPromenade",Vector3.new(400,24,128),0,12,-650,stone)
	part(root,"RivalLink",Vector3.new(24,24,150),0,12,-585,stone)
	for _,x in {-48,48} do part(root,"SquarePlanter",Vector3.new(8,2,8),1062+x,25,52,green,Enum.Material.Grass) end
	-- A distant skyline stays clear of the twelve playable campuses.
	for i=1,12 do
		local x=-900+(i-1)*160;local h=44+(i%4)*14
		part(root,"SkylineTower",Vector3.new(48,h,42),x,GROUND+h/2,-750,Color3.fromRGB(112,123,109)) -- based on the district ground
		for y=10,h-5,12 do part(root,"SkylineWindow",Vector3.new(40,3,.2),x,GROUND+y,-728.8,Color3.fromRGB(166,181,169),Enum.Material.Glass).CanCollide=false end
	end
end
function Campus.tick(dt: number)
	elapsed+=dt
	if elapsed&gt;=5 then
		elapsed=0
		local board={}
		for _,session in SessionService.all() do
			local data=session.data;local company=data.company
			if not session.closed and company then
				table.insert(board,{name=company.name,revenue=data.stats.totalRevenue,users=data.stats.peakUsers,best=data.stats.bestOverall,office=data.empire.office,userId=session.userId})
			end
		end
		table.sort(board,function(a,b)
			if a.best==b.best then return a.userId&lt;b.userId end
			return a.best&gt;b.best
		end)
		Campus.board=board
		local label=boardLabel
		if label then
			local lines={"AI EMPIRE  /  STRONGEST TRAINED AI",""}
			for i=1,math.min(8,#board) do
				local entry=board[i]
				table.insert(lines,string.format("%d. %s  |  %s",i,entry.name,string.format("%.1f pts",entry.best)))
			end
			if #board==0 then table.insert(lines,"Your company could be first.") end
			label.Text=table.concat(lines,"\n")
		end
	end
	for _,session in SessionService.all() do
		session.live.empire={board=Campus.board}
	end
end
return Campus
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXHQP00000014"><Properties><string name="Name">AirportBuilder</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- City Airport (CityPlan.AIRPORT), built once per server by CityBuilder.build (package "airport"; the airport
-- part of CityBuilder, split off like MetroBuilder). Same budgets as the rest of the city: real lights through
-- kit.light (per-zone budget), decoration never collides, touches, takes queries or casts shadows, every
-- walkable top sits on the zone ground (no holes).
--   * Terminal: glass hall (mullions, transoms, entrance portals) under a curved overhanging roof with
--     skylights, ribs and tree columns. Landside: check-in islands A-D (the four CheckinCounter prompts that
--     fly abroad: CityAction/FlightTo/CheckinTo unchanged), self check-in kiosks, queue barriers, departure
--     boards, information desk, coffee bar, arrivals with a baggage carousel and the arrivals exit. Security:
--     serpentine queue, three lanes (e-gates, divest tables with trays and instruction screens, X-ray machines,
--     walk-through arches, recompose tables, fast track), lightboxes on the wall. Airside:
--     business lounge (Model "BusinessLounge", tag "BusinessLounge"), crew room (marker part "CrewRoom"),
--     newsagent, bakery cafe, electronics, walk-through duty free, restrooms, food court, restaurant, quiet
--     zone, gate lounges A1-A3 with desks, signs and windows to the apron. Floor zoning (terrazzo grid, island
--     and security zones, door axes, kiosk rugs), luggage and trolleys in the queues and by the seats. Seat rows
--     come from CityPlan.AIRPORT.seatRows (= CityPlan.AIRPORT.seats); CityPlan.AIRPORT.walk is the matching
--     pedestrian graph. The fit-out is ONE Atomic model (TerminalInterior) so it streams in complete.
--   * Outside: forecourt (drop-off lane, taxi rank, buses, crossings, signs), car park, apron (stand
--     markings, lead-in lines, equipment roads, GSE parking on the west apron, a coned holding box, ground
--     vehicles (none in the shuttle's sweep on CityPlan.AIRPORT.shuttleStand),
--     jet bridges whose cab ends at the parked aircraft's boarding
--     door - read from the AircraftModel geometry, so a rebuilt model keeps them aligned), taxiway edge
--     lights, runway markings/lights, control tower with radar, hangar with the company-jet stand (marker
--     "CompanyJetStand", Purpose = "CompanyJet"), perimeter fence and trees, and a Persistent horizon (sea
--     to Port Meridian, coast hills, islands) so no void shows from the terminal or the air.
--   * Placeholder posts "AirportPost" (attribute CityPost = checkin | security | gate | lounge | shop | crew)
--     for a later staff package. Client animation only through the PropFx contract (belts, news ticker; the
--     tower radar and beacon carry FxFar / FxVertical and only animate once PropFxController honours them);
--     the server writes nothing after the build. Flight information shows only the one shuttle (FlightPlan
--     flight numbers, gate A&lt;shuttleStand&gt;, no clock times); boards are tagged "FlightInfoBoard" for live rows.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local City=require(ReplicatedStorage.Shared.Config.CityPlan)
local P=require(ReplicatedStorage.Shared.Config.ArchPalette)
local Aircraft=require(ReplicatedStorage.Shared.AircraftModel)
local FlightPlan=require(ReplicatedStorage.Shared.FlightPlan)
local Airport={}
export type Kit={
	light: (BasePart,number,number,Color3?)-&gt;boolean,
	prompt: (BasePart,string,string,number,number)-&gt;ProximityPrompt,
	kiosk: (Instance,number,number,number,number,string,string)-&gt;(),
	tree: (Instance,number,number,number,number?)-&gt;(),
	lamp: (Instance,number,number,boolean,number?)-&gt;(),
}
local A=City.AIRPORT
local G=City.GROUND
local F=G+.5 -- terminal floor top
local C=P.color
local M=Enum.Material
local SM=M.SmoothPlastic
local rgb=Color3.fromRGB
local PAINT=rgb(236,236,230)
local YELLOW=rgb(222,184,82)
local RED=rgb(190,56,46)
local INK=rgb(242,240,232)
local SIGN_INK=rgb(250,206,80)
local SCREEN_INK=rgb(250,200,110)
local NAVY=rgb(30,44,66)
local SLATE=rgb(52,60,72)
local BRAND=rgb(28,112,132) -- City Airport teal (generic, no real brand)
local FLOOR=rgb(170,167,160) -- polished terrazzo
local SEAT=rgb(58,92,128)
local GLOW=rgb(238,220,184)
local GOODS={rgb(196,62,58),rgb(62,104,170),rgb(238,196,72),rgb(80,150,96),rgb(232,230,224),rgb(150,84,150),rgb(240,140,60),rgb(44,48,54),rgb(120,180,200)}
local BOTTLES={rgb(150,96,40),rgb(60,110,70),rgb(200,170,90),rgb(120,40,50),rgb(200,206,210),rgb(90,60,40)}
local BREAD={rgb(196,146,82),rgb(170,112,60),rgb(222,184,120),rgb(140,90,50)}
local TECH={rgb(36,40,46),rgb(60,64,70),rgb(210,212,214),rgb(30,90,150),rgb(180,60,60),rgb(240,240,236)}
local BOOKS={rgb(170,60,50),rgb(50,90,140),rgb(230,200,90),rgb(60,120,80),rgb(220,220,214),rgb(110,70,130),rgb(230,130,60)}
local kit: Kit

------------------------------------------------------------------------------------------------ helpers
local function mk(parent: Instance,name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?,decor: boolean?): Part
	local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or SM
	p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	if decor then p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false end
	p.Parent=parent;return p
end
local function box(parent: Instance,name: string,x1: number,x2: number,y1: number,y2: number,z1: number,z2: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	return mk(parent,name,Vector3.new(x2-x1,y2-y1,z2-z1),CFrame.new((x1+x2)/2,(y1+y2)/2,(z1+z2)/2),color,material,decor)
end
local function lbox(f: CFrame,parent: Instance,name: string,x1: number,x2: number,y1: number,y2: number,z1: number,z2: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	return mk(parent,name,Vector3.new(x2-x1,y2-y1,z2-z1),f*CFrame.new((x1+x2)/2,(y1+y2)/2,(z1+z2)/2),color,material,decor)
end
local function glass(p: Part,t: number?): Part p.Material=M.Glass;p.Transparency=t or .45;return p end
local function invisible(p: Part): Part p.Transparency=1;p.CastShadow=false;return p end
local function folder(parent: Instance,name: string,mode: Enum.ModelStreamingMode?): Model
	local m=Instance.new("Model");m.Name=name
	if mode then m.ModelStreamingMode=mode end
	m.Parent=parent;return m
end
-- vertical cylinder (Roblox cylinders run along their local X)
local function post(parent: Instance,name: string,x: number,z: number,y1: number,y2: number,d: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	local p=mk(parent,name,Vector3.new(y2-y1,d,d),CFrame.new(x,(y1+y2)/2,z)*CFrame.Angles(0,0,math.pi/2),color,material,decor)
	p.Shape=Enum.PartType.Cylinder;return p
end
-- cylinder along the X axis of cf
local function cylinder(parent: Instance,name: string,cf: CFrame,length: number,d: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	local p=mk(parent,name,Vector3.new(length,d,d),cf,color,material,decor);p.Shape=Enum.PartType.Cylinder;return p
end
local function ball(parent: Instance,name: string,pos: Vector3,d: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	local p=mk(parent,name,Vector3.new(d,d,d),CFrame.new(pos),color,material,decor);p.Shape=Enum.PartType.Ball;return p
end
-- WedgePart: full height at local +Z, slope facing local -Z
local function wedge(parent: Instance,name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?,decor: boolean?): WedgePart
	local w=Instance.new("WedgePart");w.Name=name;w.Anchored=true;w.Size=size;w.CFrame=cf;w.Color=color;w.Material=material or SM
	if decor then w.CanCollide=false;w.CanTouch=false;w.CanQuery=false;w.CastShadow=false end
	w.Parent=parent;return w
end
-- square-section member between two points (local Z along the segment; never vertical)
local function member(parent: Instance,name: string,a: Vector3,b: Vector3,w: number,h: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	return mk(parent,name,Vector3.new(w,h,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),color,material,decor)
end
local function hash(s: string): number
	local h=7
	for i=1,#s do h=(h*31+string.byte(s,i))%2147483647 end
	return h
end
local function pick&lt;T&gt;(list: {T},k: number): T return list[k%#list+1] end
local function fx(inst: Instance,kinds: string,attrs: {[string]: any})
	inst:AddTag("PropFx");inst:SetAttribute("Fx",kinds)
	for k,v in attrs do inst:SetAttribute(k,v) end
end

type LabelOpts={ink: Color3?,font: Enum.Font?,align: Enum.TextXAlignment?,screen: boolean?,far: boolean?}
local function faceDims(p: BasePart,face: Enum.NormalId): Vector2
	local s=p.Size
	if face==Enum.NormalId.Front or face==Enum.NormalId.Back then return Vector2.new(s.X,s.Y) end
	if face==Enum.NormalId.Left or face==Enum.NormalId.Right then return Vector2.new(s.Z,s.Y) end
	return Vector2.new(s.X,s.Z)
end
-- SurfaceGui text on one face. screen = self-lit display; far = no MaxDistance (big exterior signs).
local function label(p: BasePart,text: string,face: Enum.NormalId?,o: LabelOpts?): TextLabel
	local opts: LabelOpts=o or {}
	local fc=face or Enum.NormalId.Front
	local d=faceDims(p,fc)
	local g=Instance.new("SurfaceGui");g.Face=fc
	-- uniform pixels per stud (no squashed text on long signs); low enough that TextScaled (capped at 100 px)
	-- can fill a big sign; canvas &lt;= 2000 x 1200
	local lines=#string.split(text,"\n")
	local pps=math.max(4,math.min(40,2000/d.X,1200/d.Y,100/math.max(.1,d.Y*.84/lines)))
	g.CanvasSize=Vector2.new(d.X*pps,d.Y*pps)
	if opts.screen then g.LightInfluence=0;g.Brightness=1.6 else g.LightInfluence=.3 end
	if not opts.far then g.MaxDistance=280 end
	g.Parent=p
	local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Size=UDim2.fromScale(.94,.84);t.Position=UDim2.fromScale(.03,.08)
	t.Text=text;t.TextScaled=true;t.TextWrapped=true;t.Font=opts.font or Enum.Font.BuilderSansBold
	t.TextColor3=opts.ink or INK;t.TextXAlignment=opts.align or Enum.TextXAlignment.Center;t.Parent=g
	return t
end
-- A sign panel facing `normal` (horizontal), text on its Front face (and optionally on its back).
local function panel(parent: Instance,name: string,center: Vector3,normal: Vector3,w: number,h: number,color: Color3,text: string?,opts: LabelOpts?,back: string?): Part
	local p=mk(parent,name,Vector3.new(w,h,.3),CFrame.lookAt(center,center+normal),color,SM,true)
	if text then label(p,text,Enum.NormalId.Front,opts) end
	if back then label(p,back,Enum.NormalId.Back,opts) end
	return p
end
-- Hanging wayfinding sign (double-sided, yellow on dark), two rods up to the ceiling height `top`.
local function hangingSign(parent: Instance,x: number,z: number,y: number,w: number,front: string,back: string?,top: number,alongZ: boolean?)
	local normal=if alongZ then Vector3.new(1,0,0) else Vector3.new(0,0,-1)
	local p=panel(parent,"WayfindingSign",Vector3.new(x,y,z),normal,w,2.6,rgb(36,40,46),front,{ink=SIGN_INK},back or front)
	for _,s in {-1,1} do
		local o=if alongZ then Vector3.new(0,0,s*(w/2-1)) else Vector3.new(s*(w/2-1),0,0)
		local q=p.Position+o
		box(parent,"SignRod",q.X-.08,q.X+.08,y+1.3,top,q.Z-.08,q.Z+.08,C.metal,M.Metal,true)
	end
end
-- Planter with a shrub ball (or a small indoor tree when tall)
local function planter(parent: Instance,x: number,z: number,w: number,d: number,tall: boolean?,k: number?)
	box(parent,"Planter",x-w/2,x+w/2,F,F+2.2,z-d/2,z+d/2,rgb(70,74,78),M.Slate)
	box(parent,"PlanterSoil",x-w/2+.3,x+w/2-.3,F+2.2,F+2.35,z-d/2+.3,z+d/2-.3,C.soil,M.Ground,true)
	local leaf=if (k or 0)%2==0 then C.foliage else C.foliageLight
	if tall then
		box(parent,"PlanterTrunk",x-.3,x+.3,F+2.3,F+9,z-.3,z+.3,C.oakDark,M.Wood,true)
		ball(parent,"PlanterTree",Vector3.new(x,F+10,z),math.min(w,d)+3,leaf,M.LeafyGrass,true)
	else
		local n=math.clamp(math.floor(w/math.max(d,1)+.5),1,6)
		for i=1,n do
			local cx=x-w/2+(i-.5)*w/n
			ball(parent,"PlanterShrub",Vector3.new(cx,F+3.1,z),math.min(d+.8,w/n+.6),if i%2==0 then C.foliageLight else leaf,M.LeafyGrass,true)
		end
	end
end
-- Wall shelf in frame f (origin = front edge centre on the floor, LookVector = the side customers stand on).
local function shelf(f: CFrame,parent: Instance,w: number,h: number,depth: number,levels: number,seed: number,palette: {Color3})
	lbox(f,parent,"Shelf",-w/2,w/2,0,h,depth-.3,depth,rgb(236,234,228),SM)
	lbox(f,parent,"ShelfPlinth",-w/2,w/2,0,.35,0,depth-.3,rgb(70,74,78),SM,true)
	local step=(h-.6)/levels
	for k=0,levels-1 do
		local y=.35+k*step
		lbox(f,parent,"ShelfBoard",-w/2,w/2,y,y+.12,0,depth-.3,rgb(214,212,206),SM,true)
		local gh=math.min(1.4,step-.4)
		local n=if w&gt;=6 then 3 else 2
		for i=0,n-1 do
			local a=-w/2+.2+i*(w-.4)/n
			local b=a+(w-.4)/n-.25
			local gh2=gh*(.7+.3*((seed+i*7+k*3)%4)/3)
			lbox(f,parent,"Goods",a,b,y+.12,y+.12+gh2,.2,depth-.45,pick(palette,seed+i*5+k*3),SM,true)
		end
	end
end
-- Seat pads of one row side split per seat (small gaps, so single seats read) and thin light-metal armrests
-- between them that stop at the seat edge. z1..z2 = pad depth, n seats over x1..x2.
local function seatPads(parent: Instance,x1: number,x2: number,z1: number,z2: number,n: number,col: Color3)
	local w=(x2-x1)/n
	for i=0,n-1 do
		local a=x1+i*w
		box(parent,"SeatPad",a+.12,a+w-.12,F+1.45,F+1.95,z1,z2,col,M.Fabric)
		if i&gt;0 then box(parent,"Armrest",a-.05,a+.05,F+1.95,F+2.5,z1+.3,z2-.4,rgb(178,184,190),M.Metal,true) end
	end
end
-- Double row of gate seats (back to back) along X, centre z.
local function seatRows(parent: Instance,x1: number,x2: number,z: number)
	box(parent,"SeatBeam",x1,x2,F+1.1,F+1.45,z-.5,z+.5,C.metal,M.Metal)
	for _,x in {x1+1,x2-1} do box(parent,"SeatLeg",x-.2,x+.2,F,F+1.1,z-1.4,z+1.4,C.metal,M.Metal,true) end
	local n=math.max(1,math.floor((x2-x1)/2.6))
	seatPads(parent,x1,x2,z-2.4,z-.4,n,SEAT)
	seatPads(parent,x1,x2,z+.4,z+2.4,n,SEAT)
	box(parent,"SeatBack",x1+.1,x2-.1,F+1.95,F+4.1,z-.35,z+.35,SEAT:Lerp(rgb(30,40,52),.35),M.Fabric)
	box(parent,"SeatBackCap",x1+.1,x2-.1,F+4.1,F+4.25,z-.4,z+.4,C.metalSoft,M.Metal,true)
end
-- Single row of seats facing `facing` (+1 = faces +Z).
local function seatRow(parent: Instance,x1: number,x2: number,z: number,facing: number,color: Color3?)
	local col=color or SEAT
	box(parent,"SeatBeam",x1,x2,F+1.1,F+1.45,z-.5,z+.5,C.metal,M.Metal)
	for _,x in {x1+1,x2-1} do box(parent,"SeatLeg",x-.2,x+.2,F,F+1.1,z-.8,z+.8,C.metal,M.Metal,true) end
	local n=math.max(1,math.floor((x2-x1)/2.6))
	seatPads(parent,x1,x2,z-1.1,z+1.1,n,col)
	local bz=z-facing*1.1
	box(parent,"SeatBack",x1+.1,x2-.1,F+1.95,F+4,bz-.25,bz+.25,col:Lerp(rgb(30,40,52),.35),M.Fabric)
end
-- Seat rows from CityPlan.AIRPORT.seatRows (the same list gives CityPlan.AIRPORT.seats): rows of one gate, or
-- (gate = nil) every landside row.
local function planSeats(parent: Instance,gate: string?,color: Color3?)
	for _,r in A.seatRows do
		if r.gate==gate then
			if r.facing==0 then seatRows(parent,r.x1,r.x2,r.z) else seatRow(parent,r.x1,r.x2,r.z,r.facing,color) end
		end
	end
end
-- Table with chairs (2 or 4): pedestal table; each chair = seat slab on one pedestal post and a thin back.
local function tableSet(parent: Instance,x: number,z: number,chairs: number,top: Color3,chair: Color3,size: number?)
	local s=size or 3
	post(parent,"TablePedestal",x,z,F,F+2.6,.5,C.metal,M.Metal)
	box(parent,"TableTop",x-s/2,x+s/2,F+2.6,F+2.85,z-s/2,z+s/2,top,M.Wood,true)
	local offs={{0,-1},{0,1},{-1,0},{1,0}}
	for i=1,chairs do
		local o=offs[i]
		local cx,cz=x+o[1]*(s/2+1.1),z+o[2]*(s/2+1.1)
		box(parent,"Chair",cx-.85,cx+.85,F+1.4,F+1.7,cz-.85,cz+.85,chair,M.Fabric)
		post(parent,"ChairPost",cx,cz,F,F+1.4,.3,C.metalSoft,M.Metal,true)
		local bx,bz=cx+o[1]*.78,cz+o[2]*.78
		if o[1]==0 then box(parent,"ChairBack",cx-.8,cx+.8,F+1.7,F+3.3,bz-.07,bz+.07,chair,M.Fabric,true)
		else box(parent,"ChairBack",bx-.07,bx+.07,F+1.7,F+3.3,cz-.8,cz+.8,chair,M.Fabric,true) end
	end
end
-- Lounge armchair facing `dir` (unit vector in XZ): recessed dark plinth, leather body, lighter seat cushion,
-- thin low arms and a slightly reclined back.
local function armchair(parent: Instance,x: number,z: number,dir: Vector3,color: Color3,cushion: Color3)
	local f=CFrame.lookAt(Vector3.new(x,F,z),Vector3.new(x,F,z)+dir)
	lbox(f,parent,"ArmchairPlinth",-1.05,1.05,0,.45,-.95,.95,rgb(34,32,32),SM,true)
	lbox(f,parent,"Armchair",-1.4,1.4,.45,1.25,-1.3,1.2,color,M.Leather)
	lbox(f,parent,"ArmchairCushion",-1.05,1.05,1.25,1.6,-1.25,.7,cushion,M.Fabric,true)
	mk(parent,"ArmchairBack",Vector3.new(2.8,2.3,.45),f*CFrame.new(0,2.3,1.02)*CFrame.Angles(math.rad(10),0,0),color,M.Leather,true)
	for _,s in {-1,1} do lbox(f,parent,"ArmchairArm",if s&gt;0 then 1.05 else -1.4,if s&gt;0 then 1.4 else -1.05,1.25,2.05,-1.15,1.0,color:Lerp(rgb(0,0,0),.18),M.Leather,true) end
end
local function stool(parent: Instance,x: number,z: number,h: number,color: Color3)
	post(parent,"StoolPost",x,z,F,F+h-.3,.3,C.metal,M.Metal,true)
	post(parent,"StoolSeat",x,z,F+h-.3,F+h,1.3,color,M.Leather)
end
-- Small screen with text (self-lit).
local function screen(parent: Instance,name: string,center: Vector3,normal: Vector3,w: number,h: number,text: string,ink: Color3?,back: string?): Part
	local p=panel(parent,name,center,normal,w,h,C.screen,text,{ink=ink or SCREEN_INK,screen=true,font=Enum.Font.BuilderSansBold},back)
	return p
end
local function airportPost(parent: Instance,kind: string,pos: Vector3,face: Vector3,extra: string?)
	local p=invisible(mk(parent,"AirportPost",Vector3.new(2,5,1),CFrame.lookAt(pos,pos+face),C.white,SM,true))
	p:SetAttribute("CityPost",kind);p:SetAttribute("BuildingId","airport")
	if extra then p:SetAttribute("Desk",extra) end
end
-- Departure board text (monospace rows)
local function boardText(title: string,rows: {string}): string
	return title.."\n"..table.concat(rows,"\n")
end
-- Flight information: the ONE shuttle aircraft (FlightPlan: PM 101 out from gate A&lt;shuttleStand&gt;, PM 102 back)
-- and no fixed clock times - the live times come from the client (ShuttleController writes the GateBoardHome
-- board; every part tagged "FlightInfoBoard" carries Board / Gate / Flight attributes for the same live rows).
local OUT_NO=FlightPlan.CONFIG.flights.out
local BACK_NO=FlightPlan.CONFIG.flights.back
local SHUTTLE_GATE="A"..A.shuttleStand
local DEPARTURES={
	"FLIGHT   DESTINATION      GATE  REMARK",
	OUT_NO.."   PORT MERIDIAN    "..SHUTTLE_GATE.."    CHECK-IN OPEN",
	"",
	"CHECK-IN A – D  ·  SECURITY LANES 1 – 3",
	"BOARDING TIMES AT GATE "..SHUTTLE_GATE,
}
local ARRIVALS={
	"FLIGHT   FROM             BELT  REMARK",
	BACK_NO.."   PORT MERIDIAN    1     SHUTTLE",
	"",
	"TAXI  ·  BUS  ·  CAR PARK WEST",
}
local MONITOR="DEPARTURES\n"..OUT_NO.."  "..SHUTTLE_GATE.."  PORT MERIDIAN"
local function flightInfo(p: BasePart,kind: string,gate: string?,flight: string?)
	p:AddTag("FlightInfoBoard");p:SetAttribute("Board",kind);p:SetAttribute("Gate",gate or SHUTTLE_GATE)
	p:SetAttribute("Flight",flight or (if kind=="arrivals" then BACK_NO else OUT_NO))
	for _,d in p:GetDescendants() do if d:IsA("TextLabel") then d.Name="FlightText" end end
end
local function board(parent: Instance,name: string,center: Vector3,normal: Vector3,w: number,h: number,title: string,rows: {string}): Part
	local p=mk(parent,name,Vector3.new(w,h,.4),CFrame.lookAt(center,center+normal),rgb(16,20,24),SM,true)
	local t=label(p,boardText(title,rows),Enum.NormalId.Front,{ink=SCREEN_INK,screen=true,font=Enum.Font.RobotoMono,align=Enum.TextXAlignment.Left})
	t.TextYAlignment=Enum.TextYAlignment.Top
	mk(parent,name.."Frame",Vector3.new(w+.5,h+.5,.1),p.CFrame*CFrame.new(0,0,.25),C.metal,M.Metal,true)
	flightInfo(p,if title=="ARRIVALS" then "arrivals" else "departures")
	return p
end

------------------------------------------------------------------------------------------------ roof profile
-- Underside (soffit) of the terminal roof as a function of z: canopy edge over the drop-off lane, crown over
-- the hall, overhang on the apron side. Constant along x.
local RZ={2398,2430,2462,2500,2530,2548}
local RY={G+27.5,G+35,G+40,G+40,G+35,G+31.5}
local function roofY(z: number): number
	if z&lt;=RZ[1] then return RY[1] end
	for i=1,#RZ-1 do
		if z&lt;=RZ[i+1] then return RY[i]+(RY[i+1]-RY[i])*(z-RZ[i])/(RZ[i+1]-RZ[i]) end
	end
	return RY[#RY]
end
-- slab whose bottom face lies `off` above the line (z1,y1)-(z2,y2) (negative off = below), spanning x1..x2
local function slab(parent: Instance,name: string,x1: number,x2: number,z1: number,y1: number,z2: number,y2: number,thick: number,off: number,color: Color3,material: Enum.Material?,decor: boolean?): Part
	local dz,dy=z2-z1,y2-y1
	local len=math.sqrt(dz*dz+dy*dy)
	local a=math.atan2(dy,dz)
	local up=Vector3.new(0,math.cos(a),-math.sin(a))
	local c=Vector3.new((x1+x2)/2,(y1+y2)/2,(z1+z2)/2)+up*(off+thick/2)
	return mk(parent,name,Vector3.new(x2-x1,thick,len),CFrame.new(c)*CFrame.Angles(-a,0,0),color,material,decor)
end

------------------------------------------------------------------------------------------------ terminal shell
local T=A.terminal
local FRONT,BACK=T.z1,T.z2
local SEC=A.security
local DOORS={-150,0,150,A.arrivalsDoor}
local function shell(term: Instance,doorsBack: {number})
	local m=term
	box(m,"HallFloor",T.x1,T.x2,G,F,T.z1,T.z2,FLOOR,M.Limestone)
	-- floor bands (decor): concourse strips landside and airside
	box(m,"FloorBand",T.x1+2,T.x2-2,F,F+.03,2433,2437,rgb(96,102,112),M.Marble,true)
	box(m,"FloorBand",T.x1+2,T.x2-2,F,F+.03,2500,2506,rgb(96,102,112),M.Marble,true)
	for _,z in {2432.4,2437.6,2499.4,2506.6} do box(m,"FloorInlay",T.x1+2,T.x2-2,F,F+.03,z-.15,z+.15,C.brass,M.Metal,true) end
	local fh=roofY(FRONT)
	-- north facade: glass between the door openings, lintels, mullions every 12, two transoms
	local cuts=table.clone(DOORS);table.sort(cuts)
	local x0=T.x1
	for _,x in cuts do
		glass(box(m,"Facade",x0,x-6,F,fh,FRONT,FRONT+.8,C.glass),.55)
		box(m,"EntranceLintel",x-6,x+6,G+12,fh,FRONT,FRONT+.8,C.stoneDeep,M.Limestone)
		x0=x+6
	end
	glass(box(m,"Facade",x0,T.x2,F,fh,FRONT,FRONT+.8,C.glass),.55)
	for x=T.x1+12,T.x2-12,12 do
		local free=true;for _,dx in cuts do if math.abs(x-dx)&lt;7 then free=false end end
		if free then box(m,"Mullion",x-.25,x+.25,F,fh,FRONT-.35,FRONT+1.1,C.metal,M.Metal,true) end
	end
	x0=T.x1
	for _,x in cuts do
		for _,y in {G+12,G+24} do box(m,"Transom",x0,x-6,y-.2,y+.2,FRONT-.3,FRONT+1,C.metal,M.Metal,true) end
		x0=x+6
	end
	for _,y in {G+12,G+24} do box(m,"Transom",x0,T.x2,y-.2,y+.2,FRONT-.3,FRONT+1,C.metal,M.Metal,true) end
	-- entrance portals: framed vestibules with a small canopy and the door function above
	for _,x in cuts do
		box(m,"PortalFrame",x-7,x-6,F,G+12.6,FRONT-3,FRONT+.8,C.metal,M.Metal,true)
		box(m,"PortalFrame",x+6,x+7,F,G+12.6,FRONT-3,FRONT+.8,C.metal,M.Metal,true)
		box(m,"PortalCanopy",x-7.5,x+7.5,G+12.6,G+13.4,FRONT-3.5,FRONT+.8,C.metal,M.Metal,true)
		local s=box(m,"PortalSign",x-6,x+6,G+13.4,G+15.6,FRONT-.4,FRONT-.1,NAVY,SM,true)
		label(s,if x==A.arrivalsDoor then "ARRIVALS" else "DEPARTURES",Enum.NormalId.Front,{ink=INK})
	end
	-- south facade (apron side): glass with the jet-bridge doors, mullions, transoms
	local bh=roofY(BACK)
	local bz=BACK-.8
	local bcuts=table.clone(doorsBack);table.sort(bcuts)
	x0=T.x1
	for _,x in bcuts do
		glass(box(m,"BackGlass",x0,x-3,F,bh,bz,BACK,C.glass),.6)
		box(m,"GateLintel",x-3,x+3,F+9,bh,bz,BACK,C.stoneDeep,M.Limestone)
		box(m,"GateDoorFrame",x-3.4,x-3,F,F+9,bz-.3,BACK+.3,C.metal,M.Metal,true)
		box(m,"GateDoorFrame",x+3,x+3.4,F,F+9,bz-.3,BACK+.3,C.metal,M.Metal,true)
		x0=x+3
	end
	glass(box(m,"BackGlass",x0,T.x2,F,bh,bz,BACK,C.glass),.6)
	for x=T.x1+12,T.x2-12,12 do
		local free=true;for _,dx in bcuts do if math.abs(x-dx)&lt;4 then free=false end end
		if free then box(m,"Mullion",x-.25,x+.25,F,bh,bz-.3,BACK+.35,C.metal,M.Metal,true) end
	end
	for _,y in {G+18} do box(m,"Transom",T.x1,T.x2,y-.2,y+.2,bz-.3,BACK+.3,C.metal,M.Metal,true) end
	-- end walls: stone base, glass gables up to the roof (box + wedge where the roof slopes)
	for _,side in {-1,1} do
		local wx1,wx2=if side&lt;0 then T.x1 else T.x2-1.5,if side&lt;0 then T.x1+1.5 else T.x2
		box(m,"SideWall",wx1,wx2,F,G+16,FRONT+.8,BACK-.8,C.stone,M.Limestone)
		for i=2,4 do
			local z1,z2=RZ[i],RZ[i+1]
			local lo=math.min(RY[i],RY[i+1])
			local zz1,zz2=math.max(z1,FRONT+.8),math.min(z2,BACK-.8)
			glass(box(m,"SideGlass",wx1,wx2,G+16,lo,zz1,zz2,C.glass,nil,true),.55).CanCollide=true
			if RY[i]~=RY[i+1] then
				local h=math.abs(RY[i+1]-RY[i])
				local cf=CFrame.new((wx1+wx2)/2,lo+h/2,(zz1+zz2)/2)*(if RY[i+1]&lt;RY[i] then CFrame.Angles(0,math.pi,0) else CFrame.new())
				local w=wedge(m,"SideGable",Vector3.new(wx2-wx1,h,zz2-zz1),cf,C.glass,M.Glass,true);w.Transparency=.55
			end
		end
		box(m,"SideWallCap",wx1-.3,wx2+.3,G+15.6,G+16.4,FRONT+.8,BACK-.8,C.stoneDeep,M.Limestone,true)
	end
	-- roof: soffit (light wood) + metal skin per profile segment, two skylight bands in the crown
	local rx1,rx2=T.x1-12,T.x2+12
	for i=1,#RZ-1 do
		local z1,y1,z2,y2=RZ[i],RY[i],RZ[i+1],RY[i+1]
		if i==3 then
			-- crown: solid / skylight / solid / skylight / solid
			local cuts2: {{number}}={{2462,2468,0},{2468,2478,1},{2478,2484,0},{2484,2494,1},{2494,2500,0}}
			for _,c in cuts2 do
				local za,zb=c[1],c[2]
				if c[3]==0 then
					slab(m,"RoofSoffit",rx1,rx2,za,y1,zb,y2,.8,0,C.oakLight,M.WoodPlanks)
					slab(m,"RoofSkin",rx1,rx2,za,y1,zb,y2,1,.8,C.metalSoft,M.Metal)
				else
					glass(slab(m,"Skylight",rx1+20,rx2-20,za,y1,zb,y2,1.8,0,C.glass,nil,true),.35)
					slab(m,"SkylightFrame",rx1,rx1+20,za,y1,zb,y2,1.8,0,C.metalSoft,M.Metal)
					slab(m,"SkylightFrame",rx2-20,rx2,za,y1,zb,y2,1.8,0,C.metalSoft,M.Metal)
				end
			end
		else
			slab(m,"RoofSoffit",rx1,rx2,z1,y1,z2,y2,.8,0,C.oakLight,M.WoodPlanks)
			slab(m,"RoofSkin",rx1,rx2,z1,y1,z2,y2,1,.8,C.metalSoft,M.Metal)
		end
		-- white edge fascia along both ends of the roof, following the profile
		for _,x in {rx1-.6,rx2+.6} do slab(m,"RoofFascia",x-.6,x+.6,z1,y1,z2,y2,2.6,-.5,C.white,M.Metal,true) end
	end
	-- front and back edge fascia, standing-seam ribs on the skin (every 40 studs)
	box(m,"RoofEdge",rx1-1.2,rx2+1.2,RY[1]-.8,RY[1]+2.4,RZ[1]-1.2,RZ[1],C.white,M.Metal,true)
	box(m,"RoofEdge",rx1-1.2,rx2+1.2,RY[#RY]-.8,RY[#RY]+2.4,RZ[#RZ],RZ[#RZ]+1.2,C.white,M.Metal,true)
	for x=rx1+20,rx2-20,40 do
		for i=1,#RZ-1 do slab(m,"RoofRib",x-.4,x+.4,RZ[i],RY[i],RZ[i+1],RY[i+1],.9,1.8,C.metal,M.Metal,true) end
	end
	-- the airport name: fascia band over the canopy edge and a rooftop sign (both face the city, north)
	local band=box(m,"AirportFascia",-80,80,RY[1]-.6,RY[1]+2.2,RZ[1]-1.6,RZ[1]-1.25,NAVY,SM,true)
	label(band,"CITY AIRPORT  ·  DEPARTURES  ·  ARRIVALS",Enum.NormalId.Front,{ink=INK,far=true})
	local rs=box(m,"AirportRoofSign",-60,60,roofY(2440)+2,roofY(2440)+9,2439.6,2440.2,NAVY,SM,true)
	label(rs,"CITY AIRPORT",Enum.NormalId.Front,{ink=INK,far=true})
	for _,x in {-50,0,50} do box(m,"RoofSignLeg",x-.3,x+.3,roofY(2440)+1,roofY(2440)+2,2440.2,2441,C.metal,M.Metal,true) end
	-- canopy columns on the curb: tapered posts with two struts to the soffit
	for _,x in {-225,-75,75,225} do
		box(m,"CanopyColumn",x-.7,x+.7,City.WALK_TOP,G+18,2419.3,2420.7,C.white,M.Metal)
		for _,s in {-1,1} do member(m,"CanopyStrut",Vector3.new(x,G+18,2420),Vector3.new(x+s*9,roofY(2410)-.2,2410),.6,.6,C.white,M.Metal,true) end
	end
end

-- Interior structure (part of the shell, visible through the glass): tree columns, roof beams, light strips.
local function structure(term: Instance)
	local m=folder(term,"Structure")
	for x=T.x1+12.5,T.x2-12.5,25 do
		for i=2,4 do slab(m,"RoofBeam",x-.5,x+.5,RZ[i],RY[i],RZ[i+1],RY[i+1],1.6,-1.6,C.white,M.Metal,true) end
	end
	for _,z in {RZ[3],RZ[4]} do box(m,"RoofGirder",T.x1+1.5,T.x2-1.5,RY[3]-2.2,RY[3],z-.6,z+.6,C.white,M.Metal,true) end
	-- continuous light strips under the soffit (neon; real lights hang from fixtures in each zone)
	for _,s in {{2440,2452},{2479,2483},{2508,2520}} do
		local za,zb=s[1],s[2]
		slab(m,"LightStrip",T.x1+3,T.x2-3,za,roofY(za),zb,roofY(zb),.25,-1.85,C.lightNeutral,M.Neon,true)
	end
	-- tree columns on the line z = 2477: white shaft, four branches up to the roof
	for _,x in {-262.5,-187.5,-112.5,-37.5,37.5,112.5,187.5,262.5} do
		box(m,"Column",x-1.2,x+1.2,F,G+24,2475.8,2478.2,C.white,M.Metal)
		box(m,"ColumnBase",x-1.6,x+1.6,F,F+.8,2475.4,2478.6,C.stoneDeep,M.Limestone,true)
		for _,o in {{-1,-1},{1,-1},{-1,1},{1,1}} do
			local tz=2477+o[2]*15
			member(m,"ColumnBranch",Vector3.new(x,G+23,2477),Vector3.new(x+o[1]*9,roofY(tz)-1.8,tz),.8,.8,C.white,M.Metal,true)
		end
	end
	-- security wall: solid up to G+16, glass above (one hall under one roof); lane openings 16 wide
	local lanes=A.lanes
	local x0=T.x1+1.5
	for _,lx in lanes do
		box(m,"SecurityWall",x0,lx-8,F,G+16,SEC-.5,SEC+.5,C.interior,M.Plaster)
		box(m,"SecurityLintel",lx-8,lx+8,G+12,G+16,SEC-.5,SEC+.5,C.interior,M.Plaster)
		x0=lx+8
	end
	box(m,"SecurityWall",x0,T.x2-1.5,F,G+16,SEC-.5,SEC+.5,C.interior,M.Plaster)
	x0=T.x1+1.5
	local segs: {{number}}={}
	for _,lx in lanes do table.insert(segs,{x0,lx-8});x0=lx+8 end
	table.insert(segs,{x0,T.x2-1.5})
	for _,sg in segs do
		box(m,"WallCladding",sg[1],sg[2],F+1.2,G+16,SEC-.62,SEC-.5,C.oakLight,M.WoodPlanks,true)
		box(m,"WallSkirting",sg[1],sg[2],F,F+1.2,SEC-.64,SEC-.5,rgb(70,74,80),M.Slate,true)
	end
	for _,lx in lanes do box(m,"LanePortal",lx-8,lx+8,G+12,G+16,SEC-.64,SEC-.5,NAVY,M.Metal,true) end
	type Ad={x: number,text: string,color: Color3}
	local ads: {Ad}={{x=-262,text="PORT MERIDIAN\nwhere business takes off",color=rgb(28,96,128)},
		{x=-188,text="AI EMPIRE EXPO\nConvention Centre  ·  Business City",color=rgb(150,58,48)},
		{x=-112,text="CITY HOTEL\nstay downtown, meet anywhere",color=rgb(120,92,52)},
		{x=112,text="MERIDIAN GRAND HOTEL\nyour stay abroad",color=rgb(52,72,120)},
		{x=188,text="FLY BUSINESS\nlounge access  ·  fast track lane 3",color=rgb(36,40,46)},
		{x=262,text="BUSINESS CITY\n14 client offices  ·  one avenue",color=rgb(64,110,84)}}
	for _,ad in ads do
		box(m,"AdvertFrame",ad.x-8.4,ad.x+8.4,F+2.6,F+11.4,SEC-.9,SEC-.62,C.metal,M.Metal,true)
		local lb=screen(m,"AdvertLightbox",Vector3.new(ad.x,F+7,SEC-1.05),Vector3.new(0,0,-1),16,8,ad.text,INK)
		lb.Color=ad.color
	end
	glass(box(m,"SecurityGlass",T.x1+1.5,T.x2-1.5,G+16,RY[3],SEC-.2,SEC+.2,C.glass,nil,true),.7)
	box(m,"SecurityWallCap",T.x1+1.5,T.x2-1.5,G+15.8,G+16.3,SEC-.7,SEC+.7,C.metalSoft,M.Metal,true)
end

------------------------------------------------------------------------------------------------ landside
-- Check-in island at x (the prompt counter = the centre desk at CityPlan.AIRPORT.checkin): a row of desks
-- (offsets from x; islands B/C stop short of security lanes 1/3), bag scales between them, the staff corridor
-- (4 studs), the bag belt and the spine with the backlit header and desk screens; serpentine queue in front.
local function checkinIsland(parent: Instance,x: number,letter: string,ticketText: string,offs: {number})
	local m=folder(parent,"CheckIn"..letter)
	local z=A.checkin[1].Z -- 2461: counter line (passengers stand north of it)
	local lo,hi=x+offs[1],x+offs[#offs]
	box(m,"IslandSpine",lo-3,hi+3,F,G+10,2469,2470.6,SLATE,SM) -- ends 3 short: lane 1 passes island B's end
	local header=box(m,"IslandHeader",lo-3.5,hi+3.5,G+10,G+13.6,2468.6,2471,NAVY,M.Metal,true)
	label(header,"CHECK-IN   "..letter,Enum.NormalId.Front,{ink=INK})
	box(m,"HeaderGlow",lo-3,hi+3,G+9.6,G+10,2468.4,2468.8,BRAND,M.Neon,true)
	local duty={"BAG DROP","PORT MERIDIAN","ALL FLIGHTS","PORT MERIDIAN","BUSINESS","FAMILIES","SPECIAL BAGGAGE"}
	for k,dx in offs do
		local cx=x+dx
		local desk=box(m,if dx==0 then "CheckinCounter" else "CheckinDesk",cx-2.5,cx+2.5,F,F+3.6,z-2,z+1.5,C.white,M.Marble)
		if dx==0 then
			local q=kit.prompt(desk,"Check in &amp; fly",ticketText,10,1)
			q:SetAttribute("CityAction","checkin");q:SetAttribute("FlightTo","abroad")
			desk:SetAttribute("CheckinTo","abroad")
		end
		box(m,"DeskFront",cx-2.5,cx+2.5,F+.4,F+3.2,z-2.2,z-2,if dx==offs[#offs] then C.brass else BRAND,SM,true)
		box(m,"DeskTop",cx-2.8,cx+2.8,F+3.6,F+3.9,z-2.4,z+1.7,C.stone,M.Marble,true)
		box(m,"DeskMonitor",cx-1,cx+1,F+3.9,F+5.2,z+.3,z+.5,C.screen,SM,true)
		screen(m,"DeskScreen",Vector3.new(cx,G+7.4,2468.85),Vector3.new(0,0,-1),4.4,2.4,letter..k.."\n"..duty[(k-1)%#duty+1])
		if k&lt;#offs then box(m,"BagScale",cx+2.5,cx+4.5,F,F+.9,z-2,z+1.5,C.metalSoft,M.Metal) end
	end
	box(m,"BagBeltBase",lo-3,hi+3,F,F+.7,z+5.5,z+7.5,C.metalSoft,M.Metal)
	box(m,"BagBelt",lo-3,hi+3,F+.7,F+.85,z+5.6,z+7.4,rgb(30,32,34),M.Rubber,true)
	for i=0,#offs-2 do
		local bx=lo+2+i*7+(hash(letter..i)%4)
		box(m,"Suitcase",bx-1.2,bx+1.2,F+.85,F+2.5+(i%2)*.4,z+5.8,z+7.1,pick(GOODS,hash(letter)+i*2),SM,true)
	end
	-- queue barriers: four rows, openings alternate (serpentine), entry sign at the open end
	for r=0,3 do
		local qz=z-5-r*3.6
		local a,b=if r%2==0 then lo else lo+5,if r%2==0 then hi-5 else hi
		box(m,"QueueBelt",a,b,F+2.6,F+2.85,qz-.05,qz+.05,NAVY,M.Fabric,true)
		local n=math.max(2,math.floor((b-a)/8))
		for j=0,n do post(m,"QueuePost",a+(b-a)*j/n,qz,F,F+3,.32,C.metalSoft,M.Metal,true) end
	end
	-- entry sign beside the queue entrance (west end, CityPlan walk node Q&lt;i&gt;a), clear of the walk lines
	post(m,"QueueSignPost",lo-.8,2446,F,F+5,.3,C.metal,M.Metal,true)
	panel(m,"QueueSign",Vector3.new(lo-.8,F+5.8,2446),Vector3.new(0,0,-1),3.4,1.6,NAVY,"CHECK-IN "..letter.."\nqueue here",{ink=INK},"CHECK-IN "..letter)
	airportPost(m,"checkin",Vector3.new(x,F+3,z+3.5),Vector3.new(0,0,-1),letter)
end

local function kioskGroup(parent: Instance,cx: number,z: number)
	for i=-1,1 do
		local x=cx+i*3.4
		box(parent,"SelfCheckinKiosk",x-.9,x+.9,F,F+4.2,z-.6,z+.6,C.white,SM)
		local head=mk(parent,"SelfCheckinScreen",Vector3.new(1.9,1.5,.25),CFrame.new(x,F+4.6,z-.25)*CFrame.Angles(math.rad(-20),0,0),C.screen,SM,true)
		label(head,"CHECK-IN",Enum.NormalId.Front,{ink=rgb(140,220,230),screen=true})
		box(parent,"KioskBand",x-.95,x+.95,F+3.2,F+3.6,z-.65,z+.65,BRAND,SM,true)
	end
end

-- Nested luggage trolleys along X (handle at the west end): chassis, frame ribs (one per trolley), top rails,
-- a thin red handle bar on two posts.
local function trolleys(parent: Instance,x: number,z: number,n: number)
	local l=n*1.4+2
	local x1,x2=x-l/2,x+l/2
	box(parent,"TrolleyChassis",x1,x2,F+.25,F+.5,z-.8,z+.8,C.metalSoft,M.Metal,true)
	for _,dz in {-.9,.9} do box(parent,"TrolleyRail",x1+.3,x2,F+2.55,F+2.7,z+dz-.06,z+dz+.06,rgb(196,200,204),M.Metal,true) end
	for i=0,n-1 do
		local rx=x1+.6+i*1.4
		box(parent,"TrolleyFrame",rx-.05,rx+.05,F+.5,F+2.7,z-.9,z+.9,rgb(176,182,188),M.Metal,true).Transparency=.3
	end
	for _,dz in {-.85,.85} do box(parent,"TrolleyPost",x1-.05,x1+.07,F+.5,F+3.5,z+dz-.06,z+dz+.06,rgb(196,200,204),M.Metal,true) end
	box(parent,"TrolleyHandle",x1-.12,x1+.1,F+3.45,F+3.65,z-1,z+1,rgb(196,60,50),SM,true)
end
-- One luggage trolley (frame f: origin on the floor, handle at local +Z) loaded with one or two bags.
local function loadedTrolley(parent: Instance,f: CFrame,k: number)
	lbox(f,parent,"TrolleyChassis",-.8,.8,.25,.5,-1.6,1.4,C.metalSoft,M.Metal,true)
	for _,s in {-1,1} do lbox(f,parent,"TrolleyRail",s*.85-.05,s*.85+.05,.5,2.2,1.3,1.4,rgb(196,200,204),M.Metal,true) end
	lbox(f,parent,"TrolleyHandle",-.95,.95,3.2,3.4,1.42,1.6,rgb(196,60,50),SM,true)
	for _,s in {-1,1} do lbox(f,parent,"TrolleyPost",s*.85-.05,s*.85+.05,2.2,3.2,1.45,1.55,rgb(196,200,204),M.Metal,true) end
	lbox(f,parent,"Suitcase",-.75,.75,.5,1.5,-1.5,1.2,pick(GOODS,k),SM,true)
	if k%2==0 then lbox(f,parent,"Suitcase",-.6,.6,1.5,2.3,-1.2,.9,pick(GOODS,k+3),SM,true) end
end
-- Upright suitcase with its pulled-out handle (decor), facing along X.
local function suitcase(parent: Instance,x: number,z: number,k: number)
	local tall=1.6+(k%3)*.5
	box(parent,"Suitcase",x-.7,x+.7,F,F+tall,z-.45,z+.45,pick(GOODS,k),SM,true)
	box(parent,"SuitcaseHandle",x-.35,x+.35,F+tall,F+tall+.8,z-.08,z+.08,rgb(40,42,46),M.Metal,true)
end

-- Floor zoning on the one Limestone hall floor (decor, a few long thin parts; tops staggered F+.02 / .03 / .035
-- / .06 so no two faces are coplanar; shop floors and carpets (F+.04..) cover the grid where they lie):
-- 20-stud terrazzo grid, a darker zone with a brass edge under every check-in island and its queue, a blue-grey
-- zone under the security queue, dark axes from the departure doors, teal rugs at the self check-in kiosks.
local function floorPlan(inside: Instance)
	local m=folder(inside,"FloorPlan")
	local grid=rgb(146,143,137)
	for x=T.x1+20,T.x2-20,20 do box(m,"FloorGrid",x-.15,x+.15,F,F+.02,FRONT+1,BACK-1,grid,M.Marble,true) end
	for _,z in {2450,2470,2490,2515} do box(m,"FloorGrid",T.x1+2,T.x2-2,F,F+.02,z-.15,z+.15,grid,M.Marble,true) end
	local offs: {{number}}={{-21,21},{-28,7},{-7,28},{-21,21}}
	for i,p in A.checkin do
		local o=offs[i] or offs[1]
		local lo,hi=p.X+o[1]-6,p.X+o[2]+6
		box(m,"IslandZone",lo,hi,F,F+.035,2441.5,2472,rgb(124,122,118),M.Marble,true)
		box(m,"IslandZoneEdge",lo,hi,F,F+.045,2441.2,2441.5,C.brass,M.Metal,true)
	end
	-- security approach (lanes 1-2 and lane 3), butting onto the island zones B / C (no overlap, no z-fight)
	for _,r in {{-62,22},{50,62}} do
		box(m,"SecurityZone",r[1],r[2],F,F+.035,2452,2466,rgb(108,116,128),M.Marble,true)
		box(m,"SecurityZoneEdge",r[1],r[2],F,F+.045,2451.7,2452,C.brass,M.Metal,true)
	end
	for _,x in {-150,150} do box(m,"DoorAxis",x-3,x+3,F,F+.03,2437,2472,rgb(96,102,112),M.Marble,true) end
	box(m,"DoorAxis",-3,3,F,F+.03,2437,2451.7,rgb(96,102,112),M.Marble,true)
	for _,cx in {-185,-115,115,185} do box(m,"KioskRug",cx-6.2,cx+6.2,F,F+.06,2456.4,2463.4,rgb(36,86,98),M.Carpet,true) end
end

local function landside(inside: Instance,ticketText: string)
	floorPlan(inside)
	local m=folder(inside,"CheckinHall")
	local letters={"A","B","C","D"}
	-- desk offsets per island: B and C stop short of security lanes 1 and 3 (their walk-through arches)
	local offs: {{number}}={{-21,-14,-7,0,7,14,21},{-28,-21,-14,-7,0,7},{-7,0,7,14,21,28},{-21,-14,-7,0,7,14,21}}
	for i,p in A.checkin do checkinIsland(m,p.X,letters[i] or tostring(i),ticketText,offs[i] or offs[1]) end
	for _,cx in {-185,-115,115,185} do kioskGroup(m,cx,2460) end
	for _,cx in {-185,-115,115,185} do hangingSign(m,cx,2460,G+12,12,"SELF CHECK-IN",nil,roofY(2460)-.2) end
	-- departure boards on the security wall, security sign, lane numbers
	board(m,"DepartureBoard",Vector3.new(-44,G+21.5,SEC-.75),Vector3.new(0,0,-1),32,9,"DEPARTURES",DEPARTURES)
	board(m,"DepartureBoard",Vector3.new(44,G+21.5,SEC-.75),Vector3.new(0,0,-1),32,9,"DEPARTURES",DEPARTURES)
	panel(m,"SecuritySign",Vector3.new(0,G+18.6,SEC-.75),Vector3.new(0,0,-1),40,3.4,NAVY,"SECURITY  ·  GATES A1 – A3",{ink=SIGN_INK})
	for i,lx in A.lanes do
		panel(m,"LaneSign",Vector3.new(lx,G+14,SEC-.7),Vector3.new(0,0,-1),12,2.6,rgb(36,40,46),if i==3 then "LANE 3  ·  FAST TRACK" else "LANE "..i,{ink=SIGN_INK})
	end
	-- hanging overhead screen in the hall centre and departure monitors near the doors
	local ov=board(m,"DepartureBoard",Vector3.new(0,G+21,2446),Vector3.new(0,0,-1),26,7,"DEPARTURES",DEPARTURES)
	for _,s in {-1,1} do box(m,"SignRod",s*11-.08,s*11+.08,G+24.5,roofY(2446)-.2,2445.9,2446.1,C.metal,M.Metal,true) end
	local _=ov
	for _,x in {-150,0,150} do
		local px=x+9
		post(m,"MonitorPost",px,2441,F,F+7.5,.4,C.metal,M.Metal)
		flightInfo(screen(m,"DepartureMonitor",Vector3.new(px,F+8.6,2440.75),Vector3.new(0,0,-1),3.6,2.2,MONITOR),"monitor")
		flightInfo(screen(m,"DepartureMonitor",Vector3.new(px,F+8.6,2441.25),Vector3.new(0,0,1),3.6,2.2,MONITOR),"monitor")
	end
	-- wayfinding inside the doors
	local top=roofY(2444)-.2
	hangingSign(m,-150,2444,G+14,22,"←  CHECK-IN A        CHECK-IN B  →","EXIT  ·  TAXI  ·  CAR PARK",top)
	hangingSign(m,0,2452,G+15,26,"←  A – B     ↑ SECURITY · GATES     C – D  →","EXIT  ·  TAXI  ·  BUS",roofY(2452)-.2)
	hangingSign(m,150,2444,G+14,22,"←  CHECK-IN C        CHECK-IN D  →","EXIT  ·  TAXI  ·  BUS",top)
	hangingSign(m,0,2474,G+14,22,"↑  SECURITY  ·  ALL GATES","←  CHECK-IN  →",roofY(2474)-.2)
	-- trolleys at the doors, planters along the column line, seating near the glass
	for _,x in {-150,0,150} do trolleys(m,x-12,2434.5,4);trolleys(m,x+14,2434.5,3) end
	for i,x in {-187.5,-112.5,112.5,187.5} do
		planter(m,x-5,2477,6,3,false,i);planter(m,x+5,2477,6,3,false,i+1)
	end
	planSeats(m,nil,C.fabricCharcoal) -- by the doors, information desk, seating islands, baggage reclaim
	-- west end: information desk, coffee bar, ATM, restrooms door, seating
	box(m,"InfoDesk",-292,-280,F,F+3.6,2447,2451,C.white,M.Marble)
	box(m,"InfoDeskTop",-292.4,-279.6,F+3.6,F+3.9,2446.6,2451.4,BRAND,SM,true)
	hangingSign(m,-286,2449,G+13,10,"i  INFORMATION",nil,roofY(2449)-.2)
	airportPost(m,"info",Vector3.new(-286,F+3,2453),Vector3.new(0,0,-1))
	box(m,"CoffeeBar",-296,-270,F,F+3.6,2474,2477,C.oakDark,M.Wood)
	box(m,"CoffeeBarTop",-296.3,-269.7,F+3.6,F+3.9,2473.7,2477.3,C.stone,M.Marble,true)
	box(m,"CoffeeBack",-297,-270,F,F+3.4,2480.5,2484.4,C.oak,M.Wood)
	box(m,"CoffeeMachine",-290,-286,F+3.4,F+5.6,2482,2484,C.metalSoft,M.Metal,true)
	box(m,"CoffeeMachine",-283,-279,F+3.4,F+5.6,2482,2484,rgb(170,40,40),SM,true)
	panel(m,"CoffeeMenu",Vector3.new(-283,G+9,SEC-.85),Vector3.new(0,0,-1),24,3,C.screen,"COFFEE  ·  TEA  ·  SNACKS  TO GO",{ink=INK,screen=true})
	for i,x in {-292,-284,-276} do
		post(m,"HighTable",x,2466,F,F+3.6,.4,C.metal,M.Metal)
		post(m,"HighTableTop",x,2466,F+3.6,F+3.8,2.6,C.oak,M.Wood,true)
		stool(m,x-1.8,2466,3.2,C.fabricCharcoal);stool(m,x+1.8,2466,3.2,C.fabricCharcoal)
		local _=i
	end
	box(m,"ATM",-297.6,-296.4,F,F+5,2456,2459,rgb(60,66,74),SM)
	screen(m,"ATMScreen",Vector3.new(-296.3,F+3.6,2457.5),Vector3.new(1,0,0),2,1.2,"CASH")
	box(m,"RestroomDoor",-298.4,-298.3,F,F+8,2436,2442,rgb(40,44,50),SM,true)
	panel(m,"RestroomSign",Vector3.new(-298.2,F+9.5,2439),Vector3.new(1,0,0),7,1.6,rgb(36,40,46),"RESTROOMS",{ink=SIGN_INK})
	planter(m,-262,2440,4,4,true,3)
	-- luggage standing in the queues and next to the seats (decor; deterministic)
	for i=1,24 do
		local h=hash("bag"..i)
		local p=A.checkin[(i-1)%#A.checkin+1]
		local x=if i&lt;=16 then p.X-16+(h%30) else ({-112,-38,38,112})[(i-17)%4+1]+(h%12)-6
		local z=if i&lt;=16 then p.Z-6.8-(math.floor(h/30)%3)*3.6 else 2440.2
		local tall=1.6+(h%3)*.5
		box(m,"Suitcase",x-.7,x+.7,F,F+tall,z-.45,z+.45,pick(GOODS,h),SM,true)
		box(m,"SuitcaseHandle",x-.35,x+.35,F+tall,F+tall+.8,z-.08,z+.08,rgb(40,42,46),M.Metal,true)
	end
	-- loaded trolleys and more bags between the queue belts (people's luggage; decor)
	for i,p in A.checkin do
		for k=0,2 do
			local h=hash("qt"..i..k)
			local o=offs[i] or offs[1]
			local lo,hi=p.X+o[1]+3,p.X+o[#o]-3
			local x=lo+(h%math.max(1,math.floor(hi-lo)))
			local z=if k%2==0 then 2454.2 else 2450.6
			if k==2 then z=2447 end
			loadedTrolley(m,CFrame.new(x,F,z)*CFrame.Angles(0,math.rad(if h%2==0 then 90 else -90),0),h)
			suitcase(m,x+(if h%2==0 then -2.6 else 2.6),z+.2,h+1)
		end
	end
	-- two indoor trees framing the security queue on the centre door axis (clear of the walk line z 2443)
	planter(m,-10,2448.6,4,4,true,1);planter(m,10,2448.6,4,4,true,2)
	-- information pillar with flight monitors between check-in B and the security queue, a traveller's luggage
	post(m,"InfoPillar",-44,2449,F,F+8.4,1.6,rgb(60,64,70),M.Metal)
	for _,sd in {-1,1} do flightInfo(screen(m,"DepartureMonitor",Vector3.new(-44,F+7,2449+sd*.95),Vector3.new(0,0,sd),3.2,2,MONITOR),"monitor") end
	loadedTrolley(m,CFrame.new(-40.5,F,2451)*CFrame.Angles(0,math.rad(160),0),7)
	suitcase(m,-47.5,2452.5,5)
	-- double-sided advertising totems between the doors and the queues
	type Totem={x: number,text: string,color: Color3}
	local totems: {Totem}={{x=-225,text="MERIDIAN GRAND HOTEL\nyour stay abroad",color=rgb(52,72,120)},
		{x=-75,text="BUSINESS LOUNGE\nairside  ·  near gate A1",color=rgb(36,32,28)},
		{x=75,text="AI EMPIRE EXPO\nConvention Centre",color=rgb(150,58,48)},{x=225,text="CITY HOTEL\nstay downtown",color=rgb(120,92,52)}}
	for _,t in totems do
		box(m,"AdTotem",t.x-1.8,t.x+1.8,F,F+1,2439.4,2440.6,rgb(60,64,70),M.Metal)
		local face=screen(m,"AdTotemScreen",Vector3.new(t.x,F+5,2440),Vector3.new(0,0,-1),3.4,8,t.text,INK,t.text)
		face.Color=t.color
	end
	-- seating islands with planters on the door axes in front of the security wall; luggage wrap and a
	-- trolley return in the same band
	for _,x in {-150,150} do
		planter(m,x-12,2479.5,3,4,false,1);planter(m,x+12,2479.5,3,4,false,2)
		suitcase(m,x-4,2483,hash("ss"..x));suitcase(m,x+5.5,2476,hash("st"..x))
		loadedTrolley(m,CFrame.new(x+11.5,F,2475.4)*CFrame.Angles(0,math.rad(90),0),hash("sr"..x))
	end
	box(m,"LuggageWrap",-228,-224,F,F+2.6,2479,2483,rgb(70,110,150),SM)
	post(m,"LuggageWrapDrum",-226,2481,F+2.6,F+4.8,3,rgb(200,204,206),M.Metal,true)
	post(m,"LuggageWrapSignPost",-222.6,2482.8,F,F+5,.3,C.metal,M.Metal,true)
	panel(m,"LuggageWrapSign",Vector3.new(-222.6,F+5.8,2482.8),Vector3.new(0,0,-1),3.6,1.6,rgb(70,110,150),"LUGGAGE\nWRAP",{ink=INK})
	trolleys(m,226,2481.5,6)
	panel(m,"TrolleySign",Vector3.new(226,G+8.6,SEC-.95),Vector3.new(0,0,-1),6,1.4,rgb(36,40,46),"TROLLEYS",{ink=SIGN_INK})
	box(m,"ExchangeBooth",-277,-267,F,F+3.6,2436,2440,C.white,M.Marble)
	glass(box(m,"ExchangeGlass",-277,-267,F+3.6,F+7,2437.8,2438.2,C.glass,nil,true),.5)
	box(m,"ExchangeRoof",-277.4,-266.6,F+7,F+7.6,2435.6,2440.4,rgb(64,140,90),SM,true)
	panel(m,"ExchangeSign",Vector3.new(-272,F+8.6,2435.8),Vector3.new(0,0,-1),10,1.4,rgb(64,140,90),"CURRENCY EXCHANGE",{ink=INK},"CURRENCY EXCHANGE")
	-- end-wall light box over the information desk
	box(m,"MuralFrame",T.x1+1.5,T.x1+1.9,G+9.6,G+15.4,2452,2478,C.metal,M.Metal,true)
	local mural=screen(m,"MuralLightbox",Vector3.new(T.x1+2.05,G+12.5,2465),Vector3.new(1,0,0),25,5.2,"CITY AIRPORT\nshuttle flights to Port Meridian  ·  gate "..SHUTTLE_GATE,INK)
	mural.Color=BRAND
	-- real lights: six fixtures over the check-in hall
	for _,x in {-250,-150,-50,50,150,250} do
		local fixture=post(m,"PendantLight",x,2455,G+21,G+21.6,4,C.lightNeutral,M.Neon,true)
		box(m,"PendantRod",x-.06,x+.06,G+21.6,roofY(2455)-.2,2454.94,2455.06,C.metal,M.Metal,true)
		kit.light(fixture,60,1.1,C.lightNeutral)
	end
end

local function arrivals(inside: Instance)
	local m=folder(inside,"Arrivals")
	-- baggage carousel (racetrack), belt slats move client-side (PropFx belt), suitcases ride on it
	local cx,cz,len,w=276,2466,22,10
	box(m,"CarouselBase",cx-len/2,cx+len/2,F,F+1.6,cz-w/2,cz+w/2,C.metalSoft,M.Metal)
	for _,s in {-1,1} do post(m,"CarouselEnd",cx+s*len/2,cz,F,F+1.6,w,C.metalSoft,M.Metal) end
	box(m,"CarouselBelt",cx-len/2,cx+len/2,F+1.6,F+1.7,cz-w/2+.2,cz+w/2-.2,rgb(34,36,38),M.Rubber,true)
	for _,s in {-1,1} do post(m,"CarouselBeltEnd",cx+s*len/2,cz,F+1.6,F+1.7,w-.4,rgb(34,36,38),M.Rubber,true) end
	box(m,"CarouselSpine",cx-len/2+1,cx+len/2-1,F+1.6,F+3,cz-1.4,cz+1.4,rgb(70,76,82),M.Metal)
	for _,side in {-1,1} do
		local belt=folder(m,"CarouselSlats")
		local z=cz+side*3.4
		for i=0,9 do
			local x=cx-len/2+1+i*2.2
			box(belt,"Slat",x-.08,x+.08,F+1.7,F+1.76,z-1.5,z+1.5,rgb(90,94,98),M.Metal,true)
		end
		belt.WorldPivot=CFrame.new(cx,F+1.7,z)*(if side&gt;0 then CFrame.new() else CFrame.Angles(0,math.pi,0))
		fx(belt,"belt",{FxAxis="x",FxRate=2,FxTravel=2.2,FxIdle="on"})
	end
	for i=0,5 do
		local side=if i%2==0 then 1 else -1
		local x=cx-9+i*3.4
		local hgt=1+(i%3)*.35
		box(m,"Suitcase",x-1,x+1,F+1.76,F+1.76+hgt,cz+side*3.4-.8,cz+side*3.4+.8,pick(GOODS,i*3+1),SM,true)
	end
	post(m,"BeltDisplayPost",cx,cz,F+3,G+8,.5,C.metal,M.Metal,true)
	local _=w
	local beltText="BELT 1\n"..BACK_NO.."  PORT MERIDIAN"
	flightInfo(screen(m,"BeltDisplay",Vector3.new(cx,G+9.5,cz),Vector3.new(0,0,-1),8,3,beltText,nil,beltText),"belt","BELT 1",BACK_NO)
	hangingSign(m,276,2452,G+14,22,"BAGGAGE RECLAIM  ·  BELT 1","ARRIVALS  ·  BELT 1",roofY(2452)-.2)
	panel(m,"ArrivalsSign",Vector3.new(270,G+15.5,FRONT+1.4),Vector3.new(0,0,1),22,2.8,rgb(36,40,46),"EXIT  ·  TAXI  ·  BUS  ·  CAR PARK WEST",{ink=SIGN_INK})
	board(m,"ArrivalBoard",Vector3.new(297.5,G+11,2470),Vector3.new(-1,0,0),20,6,"ARRIVALS",ARRIVALS)
	-- welcome lightbox for arriving passengers, high on the east end wall over baggage reclaim
	box(m,"MuralFrame",T.x2-1.9,T.x2-1.5,G+14.4,G+20.6,2443,2471,C.metal,M.Metal,true)
	local welcome=screen(m,"MuralLightbox",Vector3.new(T.x2-2.05,G+17.5,2457),Vector3.new(-1,0,0),27,5.8,"WELCOME TO\nBUSINESS CITY",INK)
	welcome.Color=rgb(150,58,48)
	-- car rental desks on the east wall, meeting point
	for i,z in {2440,2452} do
		box(m,"RentalDesk",292,297,F,F+3.6,z-3,z+3,C.white,M.Marble)
		panel(m,"RentalSign",Vector3.new(297.6,G+8,z),Vector3.new(-1,0,0),6,1.6,BRAND,"CAR RENTAL "..i,{ink=INK})
	end
	post(m,"MeetingPointPost",262,2446,F,F+9,.4,C.metal,M.Metal,true)
	panel(m,"MeetingPointSign",Vector3.new(262,F+9.8,2446),Vector3.new(0,0,-1),6,2,rgb(64,140,90),"MEETING POINT",{ink=INK},"MEETING POINT")
	trolleys(m,262,2481,5)
	planter(m,250,2480,4,4,true,1)
	local over=post(m,"PendantLight",276,2466,G+20,G+20.6,4,C.lightNeutral,M.Neon,true)
	box(m,"PendantRod",275.94,276.06,G+20.6,roofY(2466)-.2,2465.94,2466.06,C.metal,M.Metal,true)
	kit.light(over,50,1,C.lightNeutral)
	-- GPS kiosk faces the arrival point (south)
	kit.kiosk(m,256,2444,F,1,"home","Route to my HQ")
end

------------------------------------------------------------------------------------------------ security
local function security(inside: Instance)
	local m=folder(inside,"Security")
	for i,lx in A.lanes do
		-- boarding-pass e-gates at the lane entry (pedestals collide, 4-stud passage), glass flaps decor
		for _,px in {lx-6.2,lx-.6} do
			box(m,"EGate",px-.4,px+.4,F,F+3.4,2465.6,2469,rgb(196,200,204),M.Metal)
			box(m,"EGateTop",px-.45,px+.45,F+3.4,F+3.6,2465.6,2469,NAVY,SM,true)
			local inward=if px&lt;lx-3.4 then 1 else -1
			glass(box(m,"EGateFlap",math.min(px,px+inward*1.3),math.max(px,px+inward*1.3),F+1.2,F+3.2,2467.2,2467.4,rgb(150,200,220),nil,true),.5)
		end
		box(m,"EGateReader",lx-6.55,lx-5.85,F+3.6,F+4.2,2465.8,2466.4,rgb(120,220,140),M.Neon,true)
		-- divest (roller) table, X-ray machine through the wall opening, recompose table airside
		-- lane 3's table starts 2 studs further south: check-in island C's spine ends at z 2470.6 right behind it
		local t0=if lx+6&gt;A.checkin[3].X-12 and lx&lt;A.checkin[3].X then 2472 else 2470
		box(m,"DivestTable",lx+1,lx+6,F,F+3,t0,2482,C.metalSoft,M.Metal)
		local slats=folder(m,"XrayRollers")
		for k=0,5 do local z=2471+k*2;if z&gt;t0+.5 then box(slats,"Roller",lx+1.2,lx+5.8,F+3,F+3.08,z-.1,z+.1,rgb(150,154,158),M.Metal,true) end end
		slats.WorldPivot=CFrame.new(lx+3.5,F+3,2476)*CFrame.Angles(0,-math.pi/2,0) -- local x = world +Z (towards the X-ray)
		fx(slats,"belt",{FxAxis="x",FxRate=1.2,FxTravel=2,FxIdle="on"})
		box(m,"XrayMachine",lx+.5,lx+6.5,F,F+6,2482,2488.4,rgb(214,216,214),SM)
		box(m,"XrayCurtain",lx+1,lx+6,F+3,F+5.2,2481.8,2482,rgb(30,32,36),M.Fabric,true)
		box(m,"XrayCurtain",lx+1,lx+6,F+3,F+5.2,2488.4,2488.6,rgb(30,32,36),M.Fabric,true)
		box(m,"XrayStripe",lx+.5,lx+6.5,F+5.2,F+5.6,2482,2488.4,BRAND,SM,true)
		box(m,"RecomposeTable",lx+1,lx+6,F,F+3,2488.4,2498,C.metalSoft,M.Metal)
		box(m,"RecomposeTop",lx+1,lx+6,F+3,F+3.1,2488.4,2498,rgb(150,154,158),M.Metal,true)
		-- walk-through metal detector (decor: players pass through), operator monitor
		box(m,"ScannerArch",lx-6,lx-5.2,F,F+7.6,SEC-1,SEC+1,rgb(200,202,204),SM,true)
		box(m,"ScannerArch",lx-1.8,lx-1,F,F+7.6,SEC-1,SEC+1,rgb(200,202,204),SM,true)
		box(m,"ScannerArchTop",lx-6,lx-1,F+7.6,F+8.6,SEC-1,SEC+1,rgb(200,202,204),SM,true)
		box(m,"ScannerLamp",lx-5.9,lx-1.1,F+8.6,F+8.8,SEC-.3,SEC+.3,rgb(120,220,140),M.Neon,true)
		box(m,"XrayDesk",lx+6.6,lx+7.8,F,F+3.4,2489,2493,rgb(70,74,78),SM)
		box(m,"XrayMonitor",lx+6.8,lx+7.6,F+3.4,F+4.8,2490,2492,C.screen,SM,true)
		-- tray stacks and trays
		local tz=if t0&gt;2470 then 2475 else 2470 -- lane 3: south of its instruction post, clear of island C
		box(m,"TrayStack",lx+6.4,lx+8,F,F+2.6,tz,tz+2.2,rgb(110,116,122),SM)
		box(m,"Tray",lx+1.4,lx+3.4,F+3.08,F+3.4,2473,2475.6,rgb(110,116,122),SM,true)
		box(m,"Tray",lx+3.6,lx+5.6,F+3.1,F+3.42,2492,2494.6,rgb(110,116,122),SM,true)
		airportPost(m,"security",Vector3.new(lx-3.4,F+3,2489.5),Vector3.new(0,0,-1),"lane"..i)
	end
	-- serpentine queue in front of lane 2 (front row open at its e-gates), short funnels for lanes 1 and 3
	local function belt(x1: number,z1: number,x2: number,z2: number,n: number)
		box(m,"QueueBelt",math.min(x1,x2)-.05,math.max(x1,x2)+.05,F+2.6,F+2.85,math.min(z1,z2)-.05,math.max(z1,z2)+.05,NAVY,M.Fabric,true)
		for j=0,n do post(m,"QueuePost",x1+(x2-x1)*j/n,z1+(z2-z1)*j/n,F,F+3,.32,C.metalSoft,M.Metal,true) end
	end
	local e1,e2=A.lanes[2]-6.2,A.lanes[2]-.6 -- lane 2 e-gate pedestals
	belt(-26,2464.6,e1,2464.6,4);belt(e2,2464.6,20,2464.6,4)
	belt(-21,2461,20,2461,6);belt(-26,2457.4,15,2457.4,6);belt(-21,2453.8,20,2453.8,6)
	belt(-26,2457.4,-26,2464.6,1);belt(20,2453.8,20,2464.6,2)
	for k,lx in {A.lanes[1],A.lanes[3]} do
		local fast=k==2
		-- lane 1: the last desk of check-in B is the west side of its funnel
		if fast then belt(lx-6.6,2458,lx-6.6,2465,1) end
		belt(lx-.2,2458,lx-.2,2465,1)
		if fast then box(m,"FastTrackMat",lx-6.4,lx-.4,F,F+.04,2457,2465.4,rgb(150,40,46),M.Carpet,true) end
		post(m,"LaneStandPost",lx+1.6,2457.2,F,F+4.6,.3,C.metal,M.Metal,true)
		panel(m,"LaneStand",Vector3.new(lx+1.6,F+5.4,2457.2),Vector3.new(0,0,-1),3.2,1.8,if fast then rgb(150,40,46) else NAVY,
			if fast then "FAST TRACK\nbusiness · crew" else "LANE 1\nopen",{ink=INK},"PLEASE HAVE YOUR\nBOARDING PASS READY")
	end
	-- lane 2 queue entry sign, instruction screens over the divest tables, trays waiting on the rollers
	post(m,"QueueSignPost",-28.2,2452.2,F,F+5,.3,C.metal,M.Metal,true)
	panel(m,"QueueSign",Vector3.new(-28.2,F+5.8,2452.2),Vector3.new(0,0,-1),3.6,1.8,NAVY,"SECURITY\nqueue here",{ink=INK},"SECURITY")
	for i,lx in A.lanes do
		post(m,"InstructionPost",lx+6.9,2474,F,F+6.4,.3,C.metal,M.Metal,true)
		screen(m,"InstructionScreen",Vector3.new(lx+6.9,F+7.5,2474),Vector3.new(0,0,-1),4,2.4,"LAPTOPS · LIQUIDS\nIN A SEPARATE TRAY",rgb(150,220,240))
		for k,z in {2477.4,2479.6} do
			box(m,"Tray",lx+1.4,lx+5.6,F+3.08,F+3.4,z-1,z+1,rgb(110,116,122),SM,true)
			box(m,"TrayItem",lx+2+k*.6,lx+4.2+k*.4,F+3.4,F+3.9+k*.2,z-.7,z+.6,pick(GOODS,hash("tray"..i..k)),M.Fabric,true)
		end
		box(m,"LaneOpenLight",lx-5.2,lx-2,G+11.4,G+11.9,SEC-.66,SEC-.56,rgb(110,230,140),M.Neon,true)
	end
	-- lightboxes on the wall between the lanes: what to prepare
	for _,x in {-18,30} do
		box(m,"InfoFrame",x-6.4,x+6.4,F+3.6,F+10.4,SEC-.9,SEC-.62,C.metal,M.Metal,true)
		local ib=screen(m,"SecurityInfo",Vector3.new(x,F+7,SEC-1.05),Vector3.new(0,0,-1),12.4,6.4,"BEFORE SECURITY\nliquids max 100 ml · 1 l bag\nlaptops and tablets out\nno sharp objects",INK)
		ib.Color=rgb(28,64,96)
	end
	for _,x in {-50,50} do
		post(m,"InfoStandPost",x,2470,F,F+4.5,.3,C.metal,M.Metal,true)
		panel(m,"InfoStand",Vector3.new(x,F+5.5,2470),Vector3.new(0,0,-1),3,2,C.white,"LIQUIDS\nmax 100 ml",{ink=NAVY},"PLEASE HAVE YOUR\nBOARDING PASS READY")
	end
	local lamp=post(m,"PendantLight",0,2492,G+16,G+16.6,4,C.lightNeutral,M.Neon,true)
	box(m,"PendantRod",-.06,.06,G+16.6,roofY(2492)-.2,2491.94,2492.06,C.metal,M.Metal,true)
	kit.light(lamp,56,1,C.lightNeutral)
end

------------------------------------------------------------------------------------------------ airside
local SHOP_Z1,SHOP_Z2=SEC+.5,2499 -- shop band along the security wall
local function shopUnit(parent: Instance,name: string,x1: number,x2: number,title: string,tint: Color3,lit: boolean?,windows: boolean?): Model
	local m=folder(parent,name)
	box(m,"ShopWall",x2-1,x2,F,G+14,SHOP_Z1,SHOP_Z2,C.interior,M.Plaster)
	box(m,"ShopCeiling",x1,x2,G+14,G+14.6,SHOP_Z1,SHOP_Z2,C.plasterShade,M.Plaster,true)
	local fas=box(m,"ShopFascia",x1,x2,G+11.2,G+14,SHOP_Z2-.6,SHOP_Z2,tint,SM,true)
	label(fas,title,Enum.NormalId.Back,{ink=INK})
	-- coloured portal pilaster at the shop's east edge and a blade sign readable along the concourse
	box(m,"ShopPilaster",x2-1.2,x2,F,G+14,SHOP_Z2-.2,SHOP_Z2+.5,tint:Lerp(rgb(20,20,22),.2),SM,true)
	local blade=mk(m,"ShopBladeSign",Vector3.new(4.6,2,.35),CFrame.lookAt(Vector3.new(x1+3,G+12.6,SHOP_Z2+2.6),Vector3.new(x1+4,G+12.6,SHOP_Z2+2.6)),tint,SM,true)
	label(blade,title,Enum.NormalId.Front,{ink=INK});label(blade,title,Enum.NormalId.Back,{ink=INK})
	box(m,"BladeArm",x1+2.9,x1+3.1,G+13.6,G+13.8,SHOP_Z2,SHOP_Z2+5,C.metal,M.Metal,true)
	box(m,"ShopGlow",x1,x2,G+11,G+11.2,SHOP_Z2-.8,SHOP_Z2-.2,C.lightWarm,M.Neon,true)
	box(m,"ShopFloor",x1,x2-1,F,F+.04,SHOP_Z1,SHOP_Z2,tint:Lerp(rgb(235,232,226),.75),M.Marble,true)
	box(m,"ShopBackWall",x1,x2-1,F,G+14,SHOP_Z1,SHOP_Z1+.12,tint:Lerp(rgb(40,40,44),.25),SM,true)
	for _,z in {SHOP_Z1+3.5,SHOP_Z1+9} do box(m,"ShopLightStrip",x1+1.5,x2-2.5,G+13.7,G+14,z-.3,z+.3,C.lightWarm,M.Neon,true) end
	for _,g in (if windows==false then {} else {{x1+.4,x1+5.5},{x2-6.5,x2-1}}) :: {{number}} do
		glass(box(m,"ShopWindow",g[1],g[2],F,G+11,SHOP_Z2-.5,SHOP_Z2-.3,C.glass),.6)
		box(m,"ShopWindowSill",g[1],g[2],F,F+1,SHOP_Z2-.7,SHOP_Z2-.1,tint:Lerp(rgb(40,40,44),.4),SM,true)
	end
	if lit then
		local l=box(m,"ShopLight",(x1+x2)/2-3,(x1+x2)/2+3,G+13.6,G+14,2490,2494,C.lightWarm,M.Neon,true)
		kit.light(l,40,.9,C.lightWarm)
	end
	return m
end
-- frame on the north wall of the shop band, front facing +Z, centred at x
local function northWall(x: number,depth: number): CFrame
	local o=Vector3.new(x,F,SHOP_Z1+depth)
	return CFrame.lookAt(o,o+Vector3.new(0,0,1))
end
local function sideWall(x: number,z: number,facing: number,depth: number): CFrame
	local o=Vector3.new(x+facing*depth,F,z)
	return CFrame.lookAt(o,o+Vector3.new(facing,0,0))
end

local function lounge(inside: Instance)
	local L=A.lounge
	local m=folder(inside,"BusinessLounge")
	m:AddTag("BusinessLounge");m:SetAttribute("Purpose","BusinessLounge");m:SetAttribute("BuildingId","airport")
	local ex=L.x2 -- east wall (outer face)
	local dz1,dz2=2499,2506
	box(m,"LoungeWall",ex-1.2,ex,F,G+14,L.z1,dz1,C.oakDark,M.Wood)
	box(m,"LoungeLintel",ex-1.2,ex,F+9,G+14,dz1,dz2,C.oakDark,M.Wood)
	box(m,"LoungeWall",ex-1.2,ex,F,G+14,dz2,2512,C.oakDark,M.Wood)
	glass(box(m,"LoungeGlass",ex-.8,ex-.4,F,G+13.4,2512,L.z2,C.glass),.5)
	box(m,"LoungeGlassHead",ex-1.2,ex,G+13.4,G+14,2512,L.z2,C.oakDark,M.Wood)
	box(m,"LoungeCeiling",L.x1+1.5,ex,G+14,G+14.6,L.z1,L.z2,C.oakLight,M.WoodPlanks)
	box(m,"LoungeCarpet",L.x1+1.5,ex-1.2,F,F+.05,L.z1,L.z2-.8,rgb(96,82,72),M.Carpet,true)
	local entry=invisible(box(m,"LoungeEntrance",ex-1.2,ex,F,F+9,dz1,dz2,C.white,SM,true))
	entry:SetAttribute("Purpose","BusinessLounge")
	local sgn=mk(m,"LoungeSign",Vector3.new(11,2.6,.3),CFrame.lookAt(Vector3.new(ex+.2,G+10.5,2492),Vector3.new(ex+1.2,G+10.5,2492)),rgb(36,32,28),SM,true)
	label(sgn,"BUSINESS LOUNGE",Enum.NormalId.Front,{ink=C.brass})
	box(m,"LoungeSignGlow",ex,ex+.15,G+9,G+9.2,2486.5,2497.5,C.brass,M.Neon,true)
	-- reception
	box(m,"LoungeReception",-250,-243,F,F+3.6,2489,2495,C.oakDark,M.Wood)
	box(m,"LoungeReceptionTop",-250.3,-242.7,F+3.6,F+3.9,2488.7,2495.3,C.stone,M.Marble,true)
	panel(m,"LoungeLogo",Vector3.new(-252,G+7.5,L.z1+.3),Vector3.new(0,0,1),14,3,rgb(36,32,28),"BUSINESS LOUNGE",{ink=C.brass})
	airportPost(m,"lounge",Vector3.new(-252.5,F+3,2492),Vector3.new(1,0,0))
	-- bar with back shelves and stools
	shelf(northWall(-280,1.6),m,22,8,1.6,3,5,BOTTLES)
	box(m,"LoungeBar",-292,-268,F,F+3.8,2491,2494,rgb(60,44,34),M.Wood)
	box(m,"LoungeBarTop",-292.3,-267.7,F+3.8,F+4.1,2490.6,2494.3,C.stone,M.Marble,true)
	for x=-289,-271,4.5 do stool(m,x,2496,3.4,rgb(120,86,62)) end
	-- buffet island with food trays under a glass guard
	box(m,"Buffet",-266,-257,F,F+3.4,2492,2496,C.white,M.Marble)
	for i=0,3 do local x=-265.4+i*2.1;box(m,"BuffetTray",x,x+1.8,F+3.4,F+3.8,2492.6,2495.4,pick(BREAD,i),SM,true) end
	glass(box(m,"SneezeGuard",-266,-257,F+5,F+5.2,2492,2496,C.glass,nil,true),.4)
	-- three conversation groups (four teal leather armchairs round a low table, each on its own cream rug, aisles
	-- of 3+ studs between them) and two sofas with round coffee tables; a window bar along the apron glass
	local leather,cushion=rgb(38,98,106),rgb(196,206,200)
	for g,c in {{-284,2517,0},{-270,2517,18},{-256,2517,-12}} do
		local cx,cz=c[1],c[2]
		box(m,"LoungeRug",cx-5.6,cx+5.6,F+.05,F+.09,cz-5.6,cz+5.6,rgb(204,192,168),M.Fabric,true)
		post(m,"LoungeTable",cx,cz,F,F+1.3,.6,C.metal,M.Metal)
		post(m,"LoungeTableTop",cx,cz,F+1.3,F+1.5,3,C.oakDark,M.Wood,true)
		box(m,"TableBook",cx-.5,cx+.4,F+1.5,F+1.65,cz-.3,cz+.4,pick(BOOKS,g),SM,true)
		for k=0,3 do
			local a=math.rad(45+90*k+c[3])
			local o=Vector3.new(math.sin(a),0,math.cos(a))
			armchair(m,cx+o.X*3.8,cz+o.Z*3.8,-o,leather,cushion)
		end
	end
	for _,x in {-284,-262} do
		box(m,"LoungeSofa",x-6,x+6,F,F+1.6,2502,2505,rgb(70,74,80),M.Fabric)
		box(m,"LoungeSofaBack",x-6,x+6,F+1.6,F+3.6,2501.4,2502,rgb(70,74,80),M.Fabric,true)
		for _,dx in {-3,3} do box(m,"SofaCushion",x+dx-2.6,x+dx+2.6,F+1.6,F+1.9,2502.2,2504.8,rgb(96,100,108),M.Fabric,true) end
		post(m,"CoffeeTable",x,2507.4,F,F+1.4,3.4,C.oakDark,M.Wood)
	end
	box(m,"WindowBar",-296,-270,F,F+3.6,2526.5,2528.4,C.oakDark,M.Wood)
	for x=-294,-272,3.6 do stool(m,x,2525.2,3.2,C.fabricCharcoal) end
	planter(m,-296.2,2523.4,3,3,true,1);planter(m,-243,2526,3,3,true,2);planter(m,-243,2508,3,3,false,3)
	-- west feature wall: dark wood panelling, flight information board, two art panels; rug, floor lamps,
	-- magazine rack by the reception
	local wx=L.x1+.3 -- inner face of the end wall
	box(m,"LoungePanelling",L.x1,wx,F,G+14,L.z1+.5,L.z2-1,rgb(74,54,40),M.WoodPlanks,true)
	board(m,"LoungeFlightBoard",Vector3.new(wx+.35,G+8.2,2503),Vector3.new(1,0,0),14,6.5,"DEPARTURES",DEPARTURES)
	for n,z in {2490,2516.5} do
		box(m,"ArtFrame",wx,wx+.25,F+4.6,F+11.4,z-4.4,z+4.4,C.brass,M.Metal,true)
		box(m,"ArtCanvas",wx+.25,wx+.35,F+5,F+11,z-4,z+4,rgb(232,226,212),SM,true)
		for j=0,2 do
			local zz=z-3+j*2.1+(n-1)*.4
			box(m,"ArtBlock",wx+.35,wx+.42,F+5.6+((j+n)%2)*1.6,F+8.4+((j+n)%3)*.8,zz-.8,zz+.8,pick({rgb(176,70,48),rgb(40,90,130),rgb(214,170,70),rgb(70,110,84)},j+n),SM,true)
		end
	end
	for _,p in {{-292,2523.2},{-247,2513}} do
		post(m,"FloorLampStem",p[1],p[2],F,F+6.4,.2,C.brass,M.Metal,true)
		post(m,"FloorLampShade",p[1],p[2],F+6.4,F+7.6,1.6,C.lightWarm,M.Neon,true)
	end
	box(m,"MagazineRack",-249.5,-248.5,F,F+4.2,2496.5,2500.5,C.oakDark,M.Wood,true)
	for j=0,2 do box(m,"Magazine",-248.5,-248.4,F+1+j*1.1,F+1.9+j*1.1,2496.9,2500.1,pick(BOOKS,j+2),SM,true) end
	for _,p in {{-282,2500},{-284,2517},{-270,2517},{-256,2517}} do
		post(m,"LoungePendant",p[1],p[2],G+12.4,G+13,3,C.lightWarm,M.Neon,true)
		box(m,"PendantRod",p[1]-.05,p[1]+.05,G+13,G+14,p[2]-.05,p[2]+.05,C.metal,M.Metal,true)
	end
	kit.light(box(m,"LoungeLight",-276,-270,G+13.6,G+14,2496,2500,C.lightWarm,M.Neon,true),40,.9,C.lightWarm)
	kit.light(box(m,"LoungeLight",-266,-260,G+13.6,G+14,2514,2518,C.lightWarm,M.Neon,true),40,.8,C.lightWarm)
end

local function crewRoom(inside: Instance)
	local m=folder(inside,"CrewRoom")
