 },
 -- the apprentices' trainer between tour and training session: plans at the HR desk, takes calls, coaches
 -- an apprentice at their desk (special step "coach", StaffEvents)
 ["Training Lead"]={
  step{sit=true,pose="type",seconds={18,30}},
  step{special="coach",pose="inspect",seconds={10,14}},
  step{sit=true,pose="type",seconds={14,22}},
  step{pose="phone",seconds={5,8}},
 },
 Mailroom={
  step{at="sort",pose="sort",item="parcel",seconds={6,9}},
  step{at="lockers",via={"west"},pose="reach",item="parcel",prop=true,seconds={3,4}},
  step{at="pigeon",pose="sort",item=false,seconds={4,6}},
  step{at="sort",via={"west"},pose="sort",item="parcel",seconds={5,7}},
 },
}
-- The kitchen serves lunch between these company hours (and while anybody still queues).
Config.LUNCH_SERVICE={11.5,15.7}
-- Operations staff take a short break in place every OPS_BREAK seconds (seeded), one per job at a time.
Config.OPS_BREAK={300,480};Config.OPS_BREAK_SECONDS={18,28}
-- Share of coffee breaks that become a wellness break (gym, sauna, showers): (seed + n) % 10 == 0.
Config.WELLNESS_EVERY=10
-- Optional task fields: departments (set of matching departments), access (required RoomAccess), nearest (pure distance).
Config.TASKS={
 researcher={{id="RunExperiment",type="Computer",department="research",seconds={45,180},state="RESEARCH",priority=30},
 {id="UseWhiteboard",type="Whiteboard",department="research",seconds={30,80},state="RESEARCH",priority=18},
 {id="AnalyzeModel",type="Computer",department="evaluation",seconds={40,100},state="MODEL_REVIEW",priority=20},
 {id="ArchitectureStudy",type="Computer",department="design",seconds={45,120},state="RESEARCH",priority=22},
 {id="RunExperiment",type="LabBench",department="research",departments={research=true,evaluation=true},seconds={35,110},state="RESEARCH",priority=24}},
 engineer={{id="WriteCode",type="Computer",department="engineering",seconds={30,120},state="WORKING",priority=30},
 {id="MonitorTraining",type="Computer",department="training",seconds={45,120},state="MONITOR_TRAINING",priority=26},
 {id="InspectServer",type="ServerRack",department="compute",seconds={20,60},state="SERVER_CHECK",priority=15,via="Pickup"}, -- via: fetch a blade at the server cart (Pickup) in the rack's room first
 {id="ReviewModel",type="Computer",department="evaluation",seconds={40,100},state="MODEL_REVIEW",priority=18},
 {id="InspectHardware",type="LabBench",department="engineering",access="compute",seconds={25,75},state="SERVER_CHECK",priority=16}},
 curator={{id="CleanDataset",type="Computer",department="data",seconds={45,140},state="DATA_REVIEW",priority=35},
 {id="CheckQuality",type="Computer",department="data",seconds={45,100},state="DATA_REVIEW",priority=30},
 {id="MonitorPipeline",type="Pipeline",department="data",seconds={25,70},state="DATA_REVIEW",priority=18}},
 marketer={{id="AnalyzeMarket",type="Computer",department="growth",seconds={45,140},state="MARKETING",priority=35},
 {id="PlanLaunch",type="Computer",department="deployment",seconds={45,100},state="MARKETING",priority=30},
 {id="CheckCustomers",type="Computer",department="growth",seconds={35,110},state="MARKETING",priority=25}},
 support={{id="CampusOperations",type="Service",seconds={80,180},state="WORKING",priority=20}},
}
function Config.seed(index: number,owner: number): number return (index*7919+owner*31)%104729 end
-- 32-bit integer hash (lowbias32); the 16-bit split multiply stays exact in doubles, so every
-- server derives identical identities. Used for looks, presentation and names.
local function mul32(a: number,b: number): number
 local ah,al=a//65536,a%65536;local bh,bl=b//65536,b%65536
 return ((ah*bl+al*bh)%65536*65536+al*bl)%4294967296
end
function Config.hash(x: number): number
 x=math.floor(x)%4294967296
 x=bit32.bxor(x,bit32.rshift(x,16));x=mul32(x,0x7feb352d)
 x=bit32.bxor(x,bit32.rshift(x,15));x=mul32(x,0x846ca68b)
 return bit32.bxor(x,bit32.rshift(x,16))
end
-- Presentation from an appearance seed: about half of all seeds are feminine.
function Config.feminine(seed: number): boolean
 return Config.hash(seed*2+1)%2==0
end
-- Presentation of the generated employee (index, owner). Operations staff 301..312 alternate per
-- company so paired posts (reception, security, kitchen) are never all one gender.
function Config.isFeminine(index: number,owner: number): boolean
 if index&gt;300 and index&lt;=300+#Config.OPERATIONS_JOBS then return (index+Config.hash(owner))%2==0 end
 return Config.feminine(Config.seed(index,owner))
end
function Config.personality(index: number,owner: number): any
 return Config.personalityFromSeed(Config.seed(index,owner))
end
-- Personality from an appearance seed (generated or from a persistent staff profile).
function Config.personalityFromSeed(seed: number): any
 seed=math.floor(math.abs(seed))
 return {seed=seed,walkSpeed=11+(seed%31)/10,social=(seed%100)/100,breakEvery=180+seed%240,
  coffee=seed%3~=0,start=7.75+(seed%76)/60,finish=16.5+(seed%91)/60,lunch=11.75+(seed%106)/60,
  scheduleOffset=seed%91,workStyle=seed%4,meetingFrequency=160+seed%280,
  stairs=((seed//7)%100)/100} -- 0 = always takes the lift, 1 = loves the stairs
end
-- True when a station's department satisfies a task definition.
function Config.departmentMatch(task: any,department: string?): boolean
 if department==nil then return false end
 if task.departments then return task.departments[department]==true end
 return task.department==department
end
-- Workdays are visible in a practical session length; night passes faster than working hours.
function Config.hour(seconds: number): number
 local t=seconds%1200
 return (if t&lt;900 then 8+t/90 else 18+(t-900)*14/300)%24
end
function Config.priority(role: string,task: any,event: any): number
 local p=task.priority
 if event.training then
  if task.id=="MonitorTraining" then p+=50 elseif task.id=="InspectServer" then p+=40 elseif task.id=="InspectHardware" then p+=20 elseif task.id=="AnalyzeModel" then p-=20 end
 end
 if event.research and task.id=="RunExperiment" then p+=60 end
 if event.review and (task.id=="AnalyzeModel" or task.id=="ReviewModel") then p+=65 end
 if event.live and role=="marketer" then p+=45 end
 if event.hardware and (task.id=="InspectServer" or task.id=="InspectHardware") then p+=if task.id=="InspectServer" then 65 else 55 end
 if event.data and role=="curator" then p+=35 end
 return p
end
function Config.productive(state: string): number
 if state=="WORKING" or state=="RESEARCH" or state=="DATA_REVIEW" or state=="MARKETING" or state=="SERVER_CHECK" or state=="MONITOR_TRAINING" or state=="MODEL_REVIEW" then return 1 end
 if state=="MEETING" or state=="TALKING" then return .8 end
 if state=="COFFEE_BREAK" or state=="LUNCH" then return .4 end
 if state=="LEAVING" or state=="OFF_DUTY" then return 0 end
 return .75
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000021"><Properties><string name="Name">CampusConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Campus dimensions, shop catalogues and staff names. Building geometry, rooms and access rules
-- live in BuildingPlan; the values below that describe the building are derived from it.
local Plan = require(script.Parent.BuildingPlan)
local Config = {}
Config.PLOT_COUNT = 12
Config.PITCH = 320
Config.ROW_OFFSET = 252
Config.STREET_Y = 24
Config.FLOOR_HEIGHT = Plan.FLOOR_HEIGHT
Config.WIDTH = Plan.MAIN.x2 - Plan.MAIN.x1
Config.DEPTH = Plan.MAIN.z2 - Plan.MAIN.z1
Config.FLOORS = Plan.TIER_FLOORS -- above-ground storeys per office tier (roof level = FLOORS[tier])
Config.DESKS_PER_FLOOR = 48
Config.CARS = {
	{id="compact",name="Founder's Hatch",price=0,speed=64,reverse=24,acceleration=26,turn=1.8,length=12,width=6.4},
	{id="van",name="Studio Cargo",price=16000,speed=58,reverse=20,acceleration=20,turn=1.5,length=15,width=7.4},
	{id="executive",name="Executive Electric",price=28000,speed=82,reverse=26,acceleration=32,turn=1.65,length=15,width=7},
	{id="sport",name="Circuit GT",price=110000,speed=104,reverse=28,acceleration=40,turn=1.9,length=13.5,width=7.2},
	-- Game-pass car: `pass` names the ShopService pass id. BuyCar/SpawnCar check ShopService.owns(player, pass);
	-- without the pass (or while ShopService has no owns) it is never available. price stays 0 (no in-game sale).
	{id="limo",name="Executive Limousine",pass="limo",price=0,speed=78,reverse=22,acceleration=24,turn=1.3,length=19,width=7.4},
}
Config.SNACKS = {
	{id="coffee",name="House Coffee",price=25,color={113,76,50},speed=20,seconds=90,shape="cup"},
	{id="bar",name="Founder Oat Bar",price=18,color={176,128,73},speed=18,seconds=150,shape="box"},
	{id="juice",name="Orchard Juice",price=30,color={214,155,64},speed=21,seconds=70,shape="cup"},
	{id="lunch",name="Campus Lunch",price=65,color={111,146,85},speed=19,seconds=240,shape="box"},
}
Config.STORES = {
	{id="cafe",name="House Kitchen",subtitle="Coffee, lunch &amp; your own snack label",app="campus"},
	{id="hardware",name="Compute Supply",subtitle="GPUs &amp; cooling equipment",app="compute"},
	{id="studio",name="Company Store",subtitle="Websites, apps &amp; game AI",app="studio"},
	{id="mobility",name="Fleet Desk",subtitle="Collect your company car",app="campus"},
}
Config.RETAIL = {12000,32000,85000}
-- Staff first names by presentation (EmployeeRigDesign/CampusMath.staffName keep name and look
-- consistent). No ambiguous names in either list.
Config.FIRST_NAMES_F = {"Maya","Lea","Sofia","Lina","Ella","Nora","Zoe","Jana","Emma","Yara","Ada","Romy","Nina","Clara","Alma","Amara","Priya","Aiko","Fatima","Ingrid","Lucia","Mei","Nadia","Olivia","Rosa","Sana","Talia","Valentina","Wanjiru","Hana","Leila","Chiara"}
Config.FIRST_NAMES_M = {"Noah","Emil","Amir","Theo","Jonas","Milan","Ben","Luis","Leon","Finn","Luca","Nico","Eli","Tom","Kofi","Arjun","Kenji","Mateo","Omar","Rafael","Sven","Tariq","Hugo","Diego","Hamza","Ivan","Jamal","Kwame","Malik","Oscar","Ravi","Yusuf"}
Config.FIRST_NAMES = table.move(Config.FIRST_NAMES_M, 1, #Config.FIRST_NAMES_M, #Config.FIRST_NAMES_F + 1, table.clone(Config.FIRST_NAMES_F)) -- combined (legacy)
Config.LAST_NAMES = {"Weber","Khan","Meyer","Park","Silva","Chen","Rossi","Schmidt","Diaz","Miller","Kim","Novak","Okafor","Nakamura","Haddad","Johansson","Garcia","Nguyen","Kowalski","Mensah","Patel","Moreau","Costa","Yilmaz"}
function Config.find(list: {any}, id: any): any
	for _,def in list do if def.id == id then return def end end
	return nil
end
-- "2  ·  AI engineering &amp; training" (B1, G, numbered floors, founder floor, R = roof)
function Config.floorName(tier: number, floor: number): string
	return Plan.floorTitle(tier, floor)
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000028"><Properties><string name="Name">EmpireConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
-- Phase 2: all prices and rewards are authoritative on the server.
local Config = {}
-- Office stages (CORE_SPEC 2.1). Stage = office index; the building (plan tier) is stage - 1
-- (BuildingPlan.tierForOffice). 1 = the Garage Lab (new), 2..5 = the HQ buildings of plan tiers 1..4.
-- Leaving the garage also needs the first signed business client (EmpireService.upgrade, "FIRST_CLIENT").
Config.OFFICES = {
	{ name = "Garage Lab", price = 0, staff = 5, points = 0.1, color = {120,154,129} },
	{ name = "Founder Headquarters", price = 27000, staff = 24, points = 0.15, color = {120,154,129} },
	{ name = "Startup Campus", price = 100000, staff = 64, points = 0.3, color = {158,136,106} },
	{ name = "Innovation Campus", price = 380000, staff = 128, points = 0.6, color = {112,143,130} },
	{ name = "Global AI Headquarters", price = 1900000, staff = 240, points = 1, color = {169,149,111} },
}
-- Hired roles. price = flat agency fee (about a third of a day's wage); wage = $ per second (x the
-- profile multiplier w), i.e. per game day (1200 s): researcher 3,600, engineer 4,320, curator 2,700,
-- Growth &amp; Sales 4,320. Wages accrue every second, day and night, incl. paid vacation and sick days.
Config.ROLES = {
	{ id = "researcher", name = "AI Researcher", price = 1000, wage = 3, desc = "+0.6 research points/s per employee. Also stronger future models and Lab levels." },
	{ id = "engineer", name = "ML Engineer", price = 1200, wage = 3.6, desc = "+15% training speed per employee. Also more serving capacity and cheaper serving." },
	{ id = "curator", name = "Data Curator", price = 800, wage = 2.25, desc = "+300k curated tokens/s per employee. Improves with research." },
	{ id = "marketer", name = "Growth &amp; Sales", price = 1200, wage = 3.6, desc = "+1.2% market reach per employee. In the office they lift revenue; field reps with a company car win business clients." },
}
Config.RESEARCH = {
	{ id = "pipeline", name = "Parallel Training", cost = 4000, points = 50, seconds = 35, prereq = nil, desc = "+20% training speed." },
	{ id = "cleaning", name = "Data Cleaning", cost = 6000, points = 75, seconds = 45, prereq = nil, desc = "Curator data quality rises from 65% to 85%." },
	{ id = "architecture", name = "Transformer V2", cost = 12000, points = 140, seconds = 65, prereq = "pipeline", desc = "+4 to every core stat of future models." },
	{ id = "quantization", name = "Smart Quantization", cost = 15000, points = 180, seconds = 75, prereq = "pipeline", desc = "Serving costs -15%." },
	{ id = "alignment", name = "Reliability Lab", cost = 18000, points = 200, seconds = 90, prereq = "cleaning", desc = "+8 reliability on future models." },
	{ id = "distribution", name = "Global Distribution", cost = 28000, points = 260, seconds = 90, prereq = "architecture", desc = "+15% market revenue." },
	{ id = "frontier", name = "Frontier Architecture", cost = 65000, points = 500, seconds = 120, prereq = "architecture", desc = "+6 additional core stats; unlocks 7B training." },
	{ id = "cluster", name = "Distributed Cluster", cost = 45000, points = 360, seconds = 110, prereq = "quantization", desc = "+35% additional training speed; 50% more GPU rack slots." },
} :: { any }
-- The old once-per-day contract clicks are gone: their clients are in the B2B catalogue
-- (CompanyOps.CLIENTS) and pay a pilot fee on signing (CORE_SPEC 3.3).
Config.CONTRACTS = {} :: { any }
Config.QUESTS = {
	{ id = "founder", name = "Open the doors", desc = "Found your company.", kind = "company", target = 1, reward = 1200, xp = 50 },
	{ id = "data", name = "Feed the model", desc = "Collect 1B training tokens.", kind = "tokens", target = 1e9, reward = 1800, xp = 70 },
	{ id = "gpu", name = "Upgrade the rig", desc = "Own a non-starter GPU.", kind = "gpus", target = 1, reward = 1500, xp = 70 },
	{ id = "train", name = "First run", desc = "Complete your first training.", kind = "modelsTrained", target = 1, reward = 2500, xp = 100 },
	{ id = "release", name = "Launch day", desc = "Release your first AI model.", kind = "modelsReleased", target = 1, reward = 3000, xp = 120 },
	{ id = "team", name = "Two pairs of hands", desc = "Hire two employees.", kind = "staff", target = 2, reward = 2500, xp = 100 },
	{ id = "research", name = "Lab breakthrough", desc = "Finish one research project.", kind = "research", target = 1, reward = 3000, xp = 130 },
	{ id = "client", name = "Reliable supplier", desc = "Sign three business clients.", kind = "contractsCompleted", target = 3, reward = 6500, xp = 180 },
	{ id = "office", name = "Out of the garage", desc = "Move from the garage into your first HQ.", kind = "office", target = 2, reward = 5000, xp = 150 },
	{ id = "users", name = "Word gets around", desc = "Reach 5,000 peak users.", kind = "peakUsers", target = 5000, reward = 10000, xp = 250 },
	{ id = "quality", name = "A better model", desc = "Train a model with 65 overall.", kind = "bestOverall", target = 65, reward = 15000, xp = 300 },
	{ id = "million", name = "Seven figures", desc = "Earn 1M in market revenue.", kind = "totalRevenue", target = 1e6, reward = 25000, xp = 500 },
}
Config.CYCLES = {
	{ name = "Stable Market", desc = "Customers are buying at normal rates.", revenue = 1, cost = 1 },
	{ name = "AI Investment Wave", desc = "Demand for AI services is rising. Revenue +20%.", revenue = 1.2, cost = 1 },
	{ name = "Energy Squeeze", desc = "Serving energy costs +15%. Efficient labs have an edge.", revenue = 1, cost = 1.15 },
	{ name = "Enterprise Rush", desc = "Companies are adopting AI. Revenue +12%.", revenue = 1.12, cost = 1 },
}
function Config.find(list: any, id: any): any
	if typeof(id) ~= "string" then return nil end
	for _, def in list do if def.id == id then return def end end
	return nil
end
function Config.cycle(time: number): (any, number)
	local index = math.floor(time / 300) % #Config.CYCLES + 1
	return Config.CYCLES[index], 300 - time % 300
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEMPIRE00000029"><Properties><string name="Name">StudioConfig</string><bool name="Archivable">true</bool><ProtectedString name="Source">--!strict
