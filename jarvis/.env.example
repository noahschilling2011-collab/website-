# ---- API-Zugang zu JARVIS selbst ----
JARVIS_TOKEN=bitte-hier-einen-langen-zufallswert-eintragen
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# ---- LLM-Provider ----
# Leer = FakeLLMProvider: läuft ohne Konto, ohne Netz, ohne Kosten — ruft
# aber nie ein Werkzeug auf. Für einen echten Assistenten eines von beiden:
#
#   groq       kostenlos. console.groq.com, kein Zahlungsmittel nötig.
#              Trainiert laut Services Agreement 4.2 nicht auf deinen
#              Ein- und Ausgaben und hat eine eigene Vertragspartei für
#              den EWR. Gratis-Stufe (openai/gpt-oss-120b): 30 Anfragen/Min,
#              1.000/Tag, 8.000 Token/Min, 200.000 Token/Tag. Ein Aufruf von
#              JARVIS ist grob 2.000 Token — also rund 3 Aufrufe pro Minute
#              und etwa 85 am Tag. Preise leer lassen: es kostet nichts.
#              LLM_MODEL z. B. openai/gpt-oss-120b oder llama-3.3-70b-versatile
#
#   anthropic  kostet Geld, deutlich stärker. console.anthropic.com,
#              Guthaben aufladen. LLM_MODEL z. B. claude-opus-5.
#              Preise unten eintragen, sonst greift BUDGET_MAX_COST_EUR nicht.
#
# Modell-ID NICHT raten. Aus der offiziellen Doku des Anbieters übernehmen.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Preise für die Kostenrechnung, pro 1.000.000 Token.
#
# Aus der Preisseite des Anbieters übernehmen, nicht schätzen.
#
# ACHTUNG Währung: die Felder heißen EUR, Anthropic rechnet aber in USD.
# Trägst du die Preisseite 1:1 ein, sind alle Zahlen in JARVIS in Wirklichkeit
# USD — auch BUDGET_MAX_COST_EUR. Entweder du rechnest beim Eintragen um, oder
# du liest jedes EUR in der Oberfläche als USD. JARVIS holt keinen Wechselkurs.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# ---- Budgets pro Task ----
BUDGET_MAX_STEPS=12
BUDGET_MAX_DEPTH=2
BUDGET_MAX_TOOL_CALLS=20
BUDGET_MAX_TOKENS=60000
BUDGET_MAX_SECONDS=180
BUDGET_MAX_COST_EUR=0.50

# ---- Vault (docs/MIGRATION-VAULT.md) ----
# Der Ordner, den Obsidian oeffnet. Die Markdown-Dateien darin sind die
# Wahrheit; die SQLite-Tabellen sind nur ein abgeleiteter Index.
# Leer lassen = Vault aus, JARVIS bleibt bei der Datenbank.
VAULT_PFAD=

# ---- Wissensquellen (docs/wissensquellen.md) ----
# Lokale Wikipedia ueber kiwix-serve. ZIM von download.kiwix.org holen -
# nimm die "mini"-Variante, die spart rund 95 % Platz und enthaelt genau das,
# was ein Nachschlage-Tool braucht: Einleitung plus Infobox.
WIKI_KIWIX_BASIS=http://127.0.0.1:8080
WIKI_ZIM=

# Pflicht fuer wiki_live und wikidata: eine Kontaktangabe im User-Agent.
# Ohne die faellt man in die niedrigste Limitklasse.
# Beispiel: dein-name@example.org
WIKI_KONTAKT=

# Optional. Ohne Token 500 Anfragen/Stunde, mit Token 5.000/Stunde.
WIKI_API_TOKEN=

# Wie lange ein Nachschlage-Treffer im Cache gilt, in Stunden.
# 0 = nie verfallen. Das war bis zum 30.08.2026 versehentlich das
# einzige Verhalten: die Spalte geholt_am wurde geschrieben und nie
# gelesen - nach dem ersten Nachschlagen eines Begriffs bekam man
# denselben Text bis in alle Ewigkeit, auch von wiki_live.
WISSEN_CACHE_STUNDEN=24

# ---- Ab Phase 2 ----
SEARCH_API_KEY=

# ---- Ab Phase 8 (Satellit) ----
# Nur fuer satellite_search (Bild eines Ortes von oben).
# satellite_passes braucht NICHTS - CelesTrak ist offen.
#
# ACHTUNG, hier fuehrt die Seite in die Irre: es gibt ZWEI Dashboards.
# "OAuth clients" steckt im SENTINEL HUB Dashboard, nicht im Copernicus
# Browser und auch nicht hinter dem Link "Dashboard" in der Fusszeile von
# dataspace.copernicus.eu - der zeigt auf eine reine Infoseite
# (/copernicus-data-space-ecosystem-dashboard, am 29.08.2026 nachgesehen).
#
#   1. Kostenloses Konto auf dataspace.copernicus.eu, E-Mail bestaetigen.
#   2. Einloggen, dann DIESE Adresse aufrufen:
#      https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
#      (oder: Maus aufs Profilsymbol -> "Sentinel Hub")
#   3. Reiter "User Settings" -> Abschnitt "OAuth clients" -> "Create"
#   4. Name vergeben. Das Haekchen fuer "single-page application (SPA)"
#      NICHT setzen - JARVIS ist ein Server, kein Browser-Frontend.
#   5. ID und Secret erscheinen GENAU EINMAL. Beide sofort hier eintragen;
#      das Secret ist nach dem Schliessen nicht mehr abrufbar.
#
# Kontingent laut documentation.dataspace.copernicus.eu/Quotas.html,
# Zeile "Copernicus General Users", Spalte "Sentinel Hub APIs":
# 10.000 Anfragen und 10.000 Processing Units je Monat, je 300 je Minute.
# (Hier stand vorher 50.000 Anfragen - die Zahl gehoert zur Nachbarspalte
# "Direct HTTP access to COGs", einem Weg, den JARVIS nicht benutzt.)
# Ein Bild von JARVIS ist 512x512 Pixel - das reicht fuer sehr viele.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- Lokaler Zugriff: Dateien (FIX-07, docs/FIX-07.md) ----
# Die Ordner, die JARVIS LESEN darf - mehr nicht, nie schreiben.
# Leer lassen = kein Dateizugriff. Das ist die Voreinstellung, und ohne
# diese Zeile sagt datei_suchen ehrlich "nicht eingerichtet" statt
# "nichts gefunden".
# Trennzeichen ist os.pathsep: Semikolon unter Windows, Doppelpunkt unter
# Linux/macOS.
#   Windows: DATEI_WURZELN=C:\Users\Noah\Documents;C:\Users\Noah\JARVIS-Vault
#   Linux:   DATEI_WURZELN=/home/noah/Dokumente:/home/noah/vault
# Ordner, die es nicht gibt, fallen still weg - ein Tippfehler oeffnet also
# nichts Unerwartetes, er nimmt nur den Ordner aus der Liste.
DATEI_WURZELN=

# Groessengrenze je Datei in Kilobyte. Groesseres wird abgelehnt, mit
# Nennung der Grenze. Schuetzt das Kontextfenster und die Rechnung.
DATEI_MAX_KB=512

# ---- Lokaler Zugriff: Kalender (FIX-07) ----
# Entweder ein Pfad zu einer exportierten .ics-Datei, oder eine Abo-URL
# (Google/Apple/Outlook bieten alle eine "geheime Adresse im iCal-Format").
#   KALENDER_QUELLE=C:\Users\Noah\Downloads\kalender.ics
#   KALENDER_QUELLE=https://calendar.google.com/calendar/ical/.../basic.ics
# ACHTUNG: Diese URL IST das Geheimnis - wer sie hat, sieht den Kalender.
# Sie gehoert in die .env und nirgendwo sonst hin. Deshalb folgt JARVIS bei
# dieser Adresse auch keinen Weiterleitungen.
# Leer lassen = kein Kalender. Das Werkzeug sagt dann "nicht eingerichtet"
# und liefert KEINE leere Terminliste - der Unterschied zwischen
# "du hast frei" und "ich weiss es nicht".
KALENDER_QUELLE=
