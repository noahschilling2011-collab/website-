# ---- API-Zugang zu JARVIS selbst ----
JARVIS_TOKEN=bitte-hier-einen-langen-zufallswert-eintragen
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# ---- LLM-Provider ----
# Leer = FakeLLMProvider: läuft ohne Konto, ohne Netz, ohne Kosten — ruft
# aber nie ein Werkzeug auf. Für einen echten Assistenten eines von beiden:
#
#   groq       kostenlos. console.groq.com, kein Zahlungsmittel nötig.
#              Trainiert laut Services Agreement 4.2 nicht auf deinen
#              Ein- und Ausgaben und hat eine eigene Vertragspartei für
#              den EWR. Gratis-Stufe (openai/gpt-oss-120b): 30 Anfragen/Min,
#              1.000/Tag, 8.000 Token/Min, 200.000 Token/Tag. Ein Aufruf von
#              JARVIS ist grob 2.000 Token — also rund 3 Aufrufe pro Minute
#              und etwa 85 am Tag. Preise leer lassen: es kostet nichts.
#              LLM_MODEL z. B. openai/gpt-oss-120b oder llama-3.3-70b-versatile
#
#   anthropic  kostet Geld, deutlich stärker. console.anthropic.com,
#              Guthaben aufladen. LLM_MODEL z. B. claude-opus-5.
#              Preise unten eintragen, sonst greift BUDGET_MAX_COST_EUR nicht.
#
# Modell-ID NICHT raten. Aus der offiziellen Doku des Anbieters übernehmen.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Preise für die Kostenrechnung, pro 1.000.000 Token.
#
# Aus der Preisseite des Anbieters übernehmen, nicht schätzen.
#
# ACHTUNG Währung: die Felder heißen EUR, Anthropic rechnet aber in USD.
# Trägst du die Preisseite 1:1 ein, sind alle Zahlen in JARVIS in Wirklichkeit
# USD — auch BUDGET_MAX_COST_EUR. Entweder du rechnest beim Eintragen um, oder
# du liest jedes EUR in der Oberfläche als USD. JARVIS holt keinen Wechselkurs.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# ---- Budgets pro Task ----
BUDGET_MAX_STEPS=12
BUDGET_MAX_DEPTH=2
BUDGET_MAX_TOOL_CALLS=20
BUDGET_MAX_TOKENS=60000
BUDGET_MAX_SECONDS=180
BUDGET_MAX_COST_EUR=0.50

# ---- Vault (docs/MIGRATION-VAULT.md) ----
# Der Ordner, den Obsidian oeffnet. Die Markdown-Dateien darin sind die
# Wahrheit; die SQLite-Tabellen sind nur ein abgeleiteter Index.
# Leer lassen = Vault aus, JARVIS bleibt bei der Datenbank.
VAULT_PFAD=

# ---- Wissensquellen (docs/wissensquellen.md) ----
# Lokale Wikipedia ueber kiwix-serve. ZIM von download.kiwix.org holen -
# nimm die "mini"-Variante, die spart rund 95 % Platz und enthaelt genau das,
# was ein Nachschlage-Tool braucht: Einleitung plus Infobox.
WIKI_KIWIX_BASIS=http://127.0.0.1:8080
WIKI_ZIM=

# Pflicht fuer wiki_live und wikidata: eine Kontaktangabe im User-Agent.
# Ohne die faellt man in die niedrigste Limitklasse.
# Beispiel: dein-name@example.org
WIKI_KONTAKT=

# Optional. Ohne Token 500 Anfragen/Stunde, mit Token 5.000/Stunde.
WIKI_API_TOKEN=

# ---- Ab Phase 2 ----
SEARCH_API_KEY=

# ---- Ab Phase 8 (Satellit) ----
# Kostenloses Konto auf dataspace.copernicus.eu, dann im Dashboard unter
# "User Settings" -> "OAuth clients" einen Client anlegen. Derselbe Zugang
# gilt fuer den Katalog UND fuer Sentinel Hub, das die Bilder rendert.
#
# Kontingent laut documentation.dataspace.copernicus.eu/Quotas.html:
# 10.000 Processing Units und 50.000 Anfragen im Monat, 300 je Minute.
# Ein Bild von JARVIS ist 512x512 Pixel - das reicht fuer sehr viele.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
