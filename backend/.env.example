# Server
NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# Datenbank & Cache
POSTGRES_URL=postgres://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# KI-Provider (mindestens einen Key setzen)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Media-Generierung (optional)
REPLICATE_API_TOKEN=

# Storage (S3-kompatibel; leer = lokales Dateisystem ./uploads)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Push (Firebase Cloud Messaging, optional)
FCM_SERVICE_ACCOUNT_JSON=
