# --- Meridian Gateway ---
PORT=8090
NODE_ENV=development
LOG_LEVEL=info

# CORS (Komma-getrennt); * für lokale Entwicklung
CORS_ORIGINS=http://localhost:5173

# Upstream-Dienste (leer lassen => deterministische Fallbacks werden genutzt)
VALHALLA_URL=http://valhalla:8002
PHOTON_URL=http://photon:2322
NOMINATIM_URL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_CHARGE_MAP_URL=https://api.openchargemap.io/v3/poi
OPEN_CHARGE_MAP_KEY=

# Karten-/Tile-Endpunkte für den Style-Proxy
TILE_URL=http://localhost:3000            # Martin/PMTiles-Server
SATELLITE_TILE_URL=                       # z.B. Esri/MapTiler Template-URL
MAPILLARY_TOKEN=

# KI: anthropic | local | none
AI_PROVIDER=none
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# Datenbank / Cache (v2+; für v1 nicht zwingend)
POSTGRES_URL=postgres://meridian:meridian@postgres:5432/meridian
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=dev-secret-change-me
