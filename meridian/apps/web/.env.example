# --- Meridian Web-App ---

# Gateway-Basis-URL. Leer lassen => Vite-Proxy leitet /v1 an :8090 (siehe vite.config.ts).
VITE_API_BASE=

# Basiskarte (Vektor + 3D-Gebäude). Standard: OpenFreeMap (kostenlos, kein Key).
# Für Produktion auf den eigenen Style/Tile-Server zeigen:
#   VITE_STREETS_STYLE=/v1/style/streets.json
VITE_STREETS_STYLE=

# Satelliten-Kacheln (Template-URL). Standard: Esri World Imagery (kein Key).
VITE_SATELLITE_TILES=

# Street View (Mapillary) — kostenloser Token unter:
#   https://www.mapillary.com/dashboard/developers
# Ohne Token bleibt die Karte/3D voll nutzbar; Street View zeigt einen Hinweis.
VITE_MAPILLARY_TOKEN=
