# ─────────────────────────────────────────────────────────────────────────────
# HALT backend — copy this file to `.env` and fill in your OWN values.
# NEVER commit `.env`. NEVER paste these secrets into a chat.
# With no values filled in, the backend runs in DRY_RUN: all logic runs, but
# nothing is actually sent — so you can try everything before signing up.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8080

# ── Your alarm destination ───────────────────────────────────────────────────
# Your OWN phone number in E.164 format (e.g. +4915112345678).
# On a Twilio trial this MUST be a Verified Caller ID (see README).
ALERT_PHONE=
# What to send on an alert: sms | call | both
ALERT_CHANNEL=both

# ── Twilio (free trial is enough to text/call your own verified number) ──────
# From: Twilio Console. Starts with "AC..."
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio-provisioned number (NOT your personal number), E.164.
TWILIO_FROM=

# ── GoCardless Bank Account Data (free tier) — real bank connection ──────────
# Create secrets in the GoCardless Bank Account Data portal (User Secrets).
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Test bank with fake data. Keep this for testing; swap for a real bank later.
GOCARDLESS_INSTITUTION_ID=SANDBOXFINANCE_SFIN0000
GOCARDLESS_COUNTRY=DE
# Where the bank sends the user back after consent.
GOCARDLESS_REDIRECT_URL=http://localhost:8080/connect/callback
